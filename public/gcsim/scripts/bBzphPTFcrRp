# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active fischl;

for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  nahida skill, burst;
  furina skill, dash, burst, attack:2;
  nahida attack, charge;
  tighnari skill, aim:3;
  nahida attack:2, charge, dash, attack:2, charge;
  
  fischl attack:2, burst;
  nahida skill, attack:2, charge;
  tighnari aim:2;
  nahida attack:2, charge, dash, attack;
  tighnari skill, aim, burst, aim:2;
  nahida attack:2, charge, dash, attack;
}

