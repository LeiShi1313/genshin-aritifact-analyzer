options swap_delay=12 iteration=1000;

# Build assumptions
varka char lvl=90/90 cons=6 talent=10,10,10;
varka add weapon="gestofthemightywolf" refine=5 lvl=90/90;
varka add set="risingwinds" count=4;
varka add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
varka add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

prune char lvl=90/90 cons=6 talent=10,10,10;
prune add weapon="vividnotions" refine=5 lvl=90/90;
prune add set="vv" count=4;
prune add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
prune add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*12 cd=0.0662*4;

nicole char lvl=90/90 cons=6 talent=10,10,10;
nicole add weapon="angelosheptades" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*8 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

durin char lvl=90/90 cons=6 talent=10,10,10;
durin add weapon="athameartis" refine=5 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active nicole;

let walk_cancel=true; // true for walk and false for no walk
fn walk_or_not() {
  if walk_cancel {
    varka walk;
  }
}

for let i=0; i<6; i=i+1 {
  if i {
    nicole swap;
    wait(24); // hide swap cd warning
  }
  nicole skill;
  durin skill, burst, skill;
  prune burst, skill;
  varka skill;
  varka attack:2, skill;
  varka attack:2, charge;
  varka attack:2, skill;
  varka attack:2, charge;
  varka attack:2, skill;
  varka attack:2, charge;
}
// Nicole E > Durin E Q E > Prune Q E > Varka E 3[N2sE N2sC]
