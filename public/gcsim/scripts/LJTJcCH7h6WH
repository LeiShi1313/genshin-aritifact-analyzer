# Freminet Furina Nahida Dori. ~22s Rot. Freminet Furina Hyperbloom. Dori Does EN2DN1Q just after Furina. Nahida bursts every other rotation after the first.

# Team
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="tidalshadow" refine=5 lvl=90/90;
#freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
freminet add set="mh" count=5;
#freminet add set="pf" count=5;
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # TS + MH/SS + PF
#freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main
#freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # TS + PF
#freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # SS + MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main 
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main 
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ToM

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="favgs" refine=3 lvl=90/90;
dori add set="fopl" count=4;
#dori add set="ohc" count=4;
dori add stats hp=4780 atk=311 em=187 em=187 em=187; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active nahida;
#active freminet; # SS Stacks

for let i=0; i<4; i=i+1 {
  # Burst every other is very close
  nahida skill;
  if i > 0 && .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  
  furina skill, dash, burst;
  
  dori skill, attack:2, dash, attack:1, burst;
  
  freminet skill, burst,
           attack:2, skill, skill,
           attack:2, skill, attack, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
           attack:2, skill, attack, skill,
           attack:2, skill;
}
