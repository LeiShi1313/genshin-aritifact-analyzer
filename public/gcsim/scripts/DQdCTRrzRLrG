options swap_delay=12 iteration=1000;

wrio char lvl=90/90 cons=6 talent=10,10,10;
wrio add weapon="cashflow" refine=5 lvl=90/90;
wrio add set="mh" count=4;
wrio add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
wrio add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

active wrio;

for let i=0; i<4; i=i+1 {
  
  wrio  skill,
        attack:5, charge, jump,
        attack:5, charge, jump,
        attack:5, charge, jump,
        attack:5, charge, jump,
        attack:5, charge;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio dash, burst;
  }
}

