chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="scionoftheblazingsun" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=5;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622 ; 
chasca add stats hp%=0.0992 hp=507.88 atk%=0.3968 atk=33.08 def%=0.124 def=39.36 em=39.64 cr=0.1655 cd=0.7944 er=0.1653 ;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=4;
bennett add stats hp=4780 atk=311 er=0.466 pyro%=0.466 cd=0.622 ; 
bennett add stats hp%=0.0992 hp=507.88 atk%=0.0992 atk=33.08 def%=0.124 def=39.36 em=39.64 cr=0.2979 cd=0.4634 er=0.551 ;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.4660 cd=0.622;
furina add stats hp%=0.1984 hp=507.88 atk%=0.0992 atk=33.08 def%=0.124 def=39.36 em=39.64 cr=0.3972 cd=0.662 er=0.1102 ;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; 
ororon add stats hp%=0.0992 hp=507.88 atk%=0.0992 atk=33.08 def%=0.124 def=39.36 em=39.64 cr=0.2648 cd=0.7944 er=0.3306 ;


options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active ororon;

for let i = 0; i < 6; i = i + 1 {
  ororon skill, attack, burst;
  if is_even(i) {
    furina skill, dash, burst;
  } else {
    furina attack:3;
  }
  bennett skill, dash, burst;
  if .chasca.burst.ready{
    chasca burst, skill, aim:4;
  } else {
    chasca skill, aim:4;
  }
  bennett skill, attack:2;
}
