# AlHaitham Furina Fischl Baizhu. ~26s Rot. AlHaitham Quickbloom. Baizhu skills twice for team energy. Fischl uses burst during Alhaitham's burst window. Good Quicken uptime.

# Team
haitham char lvl=90/90 cons=0 talent=9,9,9;
haitham add weapon="harbinger" refine=5 lvl=90/90;
#haitham add weapon="wolffang" refine=1 lvl=90/90;
#haitham add weapon="umbrella" refine=5 lvl=90/90; 
haitham add set="mh" count=4;
haitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
haitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.2648 cd=0.662; # HoD
#haitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
#haitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.2317 cd=0.662; # WF
#haitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
#haitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # Umbrella

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; 
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;  # ToM
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; 
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # GT

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=59.46 cr=0.2979 cd=0.7944;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="deepwood" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311;
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

#Rotation
active fischl;

for let r=0; r<4; r=r+1 {
  fischl attack, skill;
  
  furina skill, dash, burst;
  
  baizhu skill, attack, burst;
  
  # Room to optimze AlHaitham Spread combos
  haitham skill[hold=1], low_plunge[short=1],
            attack:3, dash,
            attack:4, charge, dash,
            attack:2;
            
  fischl attack:2, burst;
  
  haitham burst;
  
  baizhu skill, attack;
  
  haitham attack:2, dash,
            attack:3, charge, dash,
            attack:4, charge, dash,
            attack:3, charge;
}
