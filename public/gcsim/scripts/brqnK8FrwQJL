options swap_delay=12 iteration=100;

kinich char lvl=80/80 cons=0 talent=8,8,8  +params=[start_energy=0];
kinich add weapon="earthshaker" refine=1 lvl=80/90;
kinich add set="obsidiancodex" count=4;
kinich add stats hp=4780 em=105 cr=0.21 cd=1.041dendro%=0.466 atk=909 ;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="obsidiancodex" count=5;
mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=79.28 cr=0.2648 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9 +params=[start_energy=0];
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9  +params=[start_energy=0];
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fn kinich_combo() {

  kinich skill;

  while .kinich.nightsoul.state {
    switch .kinich.nightsoul.points {
      case 20:
        kinich skill[hold=1];
      default:
        if .kinich.blind_spot {
          kinich attack[direction=.kinich.blind_spot];
        } else {
          kinich attack;
        }
    }
  }
}

active kinich;

target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<2; i=i+1{
  mav attack,skill;
  bennett skill, attack:3;
  furina attack,skill;
  if .furina.burst.ready {
    furina burst;
  }
  bennett skill,burst;
  kinich_combo();

  kinich attack:2;

  mav attack,skill;
  bennett skill, attack:3;
  furina attack,skill;
  if .furina.burst.ready {
    furina burst;
  }
  bennett skill,burst;

  mavuika burst;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  mavuika charge:2, dash;

}
