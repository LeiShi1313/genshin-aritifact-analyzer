# Xiao Furina Bennett Jean. ~23s Rot. Xiao does 12 plunges, 2 unbuffed. Furina gets a few vapes off of Jean Sunfire. 50% Collisions. C4 Jean is worth ~5K DPS.

# Team
xiao char lvl=90/90 cons=0 talent=9,9,9;
xiao add weapon="favlance" refine=3 lvl=90/90;
xiao add set="mh" count=4;
#xiao add set="longnightsoath" count=4;
#xiao add set="vh" count=4;
xiao add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
xiao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # MH
#xiao add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
#xiao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Other

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ToM

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="favsword" refine=3 lvl=90/90;
jean add set="vv" count=4;
#jean add set="sodp" count=4;
#jean add set="scroll" count=4;
jean add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1653 em=158.56 cr=0.331 cd=0.2648;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  if .jean.cons >= 4 {
    bennett skill, burst;
    
    jean skill, burst;
  } else {
    jean skill, burst;
    
    bennett skill, burst;
  }
  
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
  
}
