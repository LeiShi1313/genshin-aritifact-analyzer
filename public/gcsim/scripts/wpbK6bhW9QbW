# Freminet Furina Bennett Xianyun. ~21s Rot. Freminet Vape plunge without VV. Freminet uses skill and Pers damage between plunges to maintain his passives. -3K DPS vs Freeze Immunity. 50% Collisions.

# Team  Options listed by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#freminet add weapon="fruitfulhook" refine=1 lvl=90/90;
