# Clorinde Nahida Ororon Mavuika. ~16s Rot. Whimsy Clorinde Quickburn. Nahida bursts every other rot after the first. Mavuika bursts every other rotation, with 1 CA after the first rotation. Everyone but Clorinde builds full EM.
# Team - Options listed by DPS
clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
#nahida add set="tom" count=4;
#nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
#ororon add set="deepwood" count=4;
ororon add stats hp=4780 atk=311 em=187 em=187 em=187; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=118.92 cr=0.3972 cd=0.4634;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="aquamarine" refine=1 lvl=90/90;
mav add set="deepwood" count=4;
#mav add set="scroll" count=4;
mav add stats hp=4780 atk=311 em=187 em=187 em=187; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=118.92 cr=0.3972 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,3.5 hp=100000000; #behind the 1st

# Rotation
active nahida;
nahida skill;

for let i=0; i<4; i=i+1 {
  # Skip Q on  first rotation, then use as available
  if !is_even(i) {
    nahida skill, attack, burst;
  } else if i > 0 {
    nahida skill, attack, charge;
  }

  # Mavuika after Ororon
  if i == 0 {
    mav skill, burst;
  } else if .mav.burst.ready {
    mav burst, charge:1, skill, dash;
  } else {
    mav skill, attack;
  }

  ororon burst, skill;

  if .clorinde.skill.cd {
    clorinde attack:2;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde burst;
}
