candace add weapon="catch" refine=5 lvl=90/90;
candace add set="scroll" count=2;
candace add set="totm" count=2;
candace add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
candace add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*10 atk=16.54*2 atk%=0.0496*2 er=0.0551*14 em=19.82*2 cr=0.0331*10 cd=0.0662*3;

sucrose char lvl=80/80 cons=0 talent=1,8,8;
sucrose add weapon="sacfrags" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add set="fragmentofharmonicwhimsy" count=1;
sucrose add stats def%=0.649 def=81 hp=5288 hp%=0.27399999999999997 atk=159 er=0.272 em=575.5 cr=0.12400000000000001 cd=0.187;

mavuika char lvl=90/90 cons=0 talent=1,10,10;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="scroll" count=4;
mavuika add set="emblemofseveredfate" count=1;
mavuika add stats def%=0.051 def=93 hp=5019 hp%=0.105 atk=329 atk%=0.903 em=61 cr=0.23600000000000004 cd=1.4369999999999998 pyro%=0.466;

options swap_delay=4 iteration=1000;

active mavuika;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

//three chomps
fn mualani_combo() {
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

for let i=0; i<8; i=i+1 {
  candace skill,burst, attack:2; //catch particles
  sucrose attack, skill, dash;
  if .mavuika.burst.ready { //burst every other rotation
    mavuika burst, skill,dash; //even rotations
    wait(1);//get pyro on enemy
  } else {
    mavuika skill[hold=1], charge,dash, charge,dash; //odd rotations
    wait(1);
  }
  mualani skill;
  mualani_combo();
  mualani skill; //more particles
  if .mualani.burst.ready {
    mualani burst[travel=1]; //enemy near
  }
}
