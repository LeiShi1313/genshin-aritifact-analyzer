# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
#target lvl=100 resist=0.1 radius=2.6 pos=0,3.0 hp=999999999;

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  if i == 0 {
    nahida skill, burst;
  } else {
    nahida burst;
  }

  furina skill, dash, burst;

  dori skill, attack, burst;

  alhaitham burst;

  nahida skill, attack, charge;

  haitham attack:3, dash,
          attack:3;
  haitham skill, attack:3, charge,
          attack:3, charge,
          attack:3, charge;
}
