beidou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.1655 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Beidou 20% Perfect Counter, 20% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.80 {
    counter = 2;
  } else if counter > 0.6 && counter <= 0.80 {
    counter = 1;
  }
  else {
    counter = 0;
  }

  return counter;
}

# Rotation
active fischl;

fischl attack, skill;

for let i=0; i<4; i=i+1 {
  if .chev.burst.ready && .chev.energy == .chev.energymax {
    chev burst, attack, skill[hold=1]:3;
  } else {
    chev attack, skill[hold=1];
  }

  beidou skill[counter=rand_counter()];
  if .beidou.burst.cd {
    beidou attack;
  }
  beidou burst;

  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }

  hutao skill,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:2, charge;
  if i > 0 && .hutao.burst.ready {
    hutao burst;
  } else {
    hutao jump;
  }
}
