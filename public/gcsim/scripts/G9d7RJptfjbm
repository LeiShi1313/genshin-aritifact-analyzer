xianyun add weapon="favcodex" refine=5 lvl=90/90;
xianyun add set="vv" count=5;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.4959 em=39.64 cr=0.3972 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

chevreuse char lvl=90/90 cons=6 talent=9,9,9; 
chevreuse add weapon="favlance" refine=5 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; 
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active diluc; # SS stacks

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  chevreuse attack, skill[hold=1], burst;
  
  xianyun attack, skill, low_plunge, burst, attack;
  
  diluc skill, burst, skill:2;

  delay (15);

  for let h = 0; h < 8; h = h + 1 {
    diluc dash, jump;
    if .airborne { 
      diluc high_plunge[collision=rand()>0.5];
    }
  }
}

