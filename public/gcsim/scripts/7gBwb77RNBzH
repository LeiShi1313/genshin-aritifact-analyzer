# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=3 pos=0,3.4 hp=100000000; # Adjacent

# Rotation
active gaming; #SS Stacks

for let r=0; r<4; r=r+1{
  xingqiu skill, dash, burst, attack;

  nahida skill, attack;

  xianyun skill, high_plunge, attack, burst, attack;

  gaming burst, attack:2;
  for let i=0; i<6; i=i+1 {
    gaming skill, high_plunge, attack;
  }
  gaming skill, high_plunge, dash;
}
