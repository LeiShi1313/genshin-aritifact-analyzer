options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active arle;

for let i = 0; i < 4; i = i + 1 {
  arle skill;
  kazuha skill, high_plunge, burst;
  bennett burst, skill;
  xiangling burst, skill, dash;
  kazuha attack, skill, high_plunge;
  if !.kazuha.mods.favonius-cd {
    kazuha attack;
  }
  arle charge, 
       attack:3, dash,
       attack:3, dash, 
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack;
}
