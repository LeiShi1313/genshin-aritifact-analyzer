# ----  Default Enemy
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active raiden;
raiden skill;
# ----  Next rotations
for let i = 0; i < 4; i = i + 1 {
  kirara burst, skill[short_hold=1];
  while !.kirara.mods.favonius-cd {
    kirara attack;
  }
  nahida skill, burst;
  tighnari skill, aim, burst, aim:2;
  raiden burst, attack:4, dash, attack:4, skill, attack:4, dash, attack:4;
}

