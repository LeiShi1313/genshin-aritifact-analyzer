options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active xingqiu;
for let x=0; x<4; x=x+1 {

  xingqiu attack, skill, dash, burst, attack;
  bennett skill, attack, burst, attack;
  beidou skill, dash, burst, attack;
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  beidou skill, dash, attack:2;
  if .yoimiya.burst.ready {
    yoimiya burst;
  } else {
    bennett skill, attack:2;
  }
}
