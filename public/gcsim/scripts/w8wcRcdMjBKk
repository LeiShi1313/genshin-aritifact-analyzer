# Kazuha Emilie Bennett Xianyun. ~18s Rot. Kazuha Burning Plunge with grouping. Kazuha bookends his field time will skill uses. Kazuha's burst is a small DPS loss. Deepwood is close on Bennett. 100% collisions for E plunges, 50% for starwicker plunges.

# Option - Options listed by DPS
kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="harbinger" refine=5 lvl=90/90; # By far
#kazuha add weapon="wolffang" refine=1 lvl=90/90;
#kazuha add weapon="lionsroar" refine=3 lvl=90/90;
#kazuha add weapon="finale" refine=5 lvl=90/90;
kazuha add set="longnightsoath" count=4;
#kazuha add set="ur" count=4;
#kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Other
#kazuha add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # WF

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
#emilie add set="deepwood" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9;
#bennett add weapon="alleyflash" refine=1 lvl=90/90; # Impossible ER
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=120];
bennett add set="no" count=4;
#bennett add set="deepwood" count=4; # close
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.2755 em=99.1 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active bennett;
bennett skill;

for let i=0; i<4; i=i+1 {
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill;
  }

  xianyun skill, low_plunge, burst;

  bennett skill, burst;

  # 9 PLunges
  kazuha skill, high_plunge[collision=1];
  while .xianyun.status.xianyun-airborne-buff {
    kazuha jump;
    if .airborne {
      kazuha high_plunge[collision=rand()>0.5];
    }
    if .kazuha.status.xianyun-airborne-buff {
      kazuha dash;
    }
  }
  # Small DPS Loss
  #if .kazuha.burst.ready && .kazuha.energy == .kazuha.energymax {
  #  kazuha burst;
  #}
  if .kazuha.skill.ready {
    kazuha skill, high_plunge[collision=1];
  }

  bennett skill;

}
