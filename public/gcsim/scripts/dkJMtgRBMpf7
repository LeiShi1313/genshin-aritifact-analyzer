// crystallize pick up logic:
// 0 = never
// 1 = always
// 2 = only on fischl burst and noelle dash
let crystallize_logic = 2;
let crystallize_delay = 6;

let _pick_up_crystallize = pick_up_crystallize;
fn pick_up_crystallize(element string) {
  let result = _pick_up_crystallize(element);
  if result { delay(crystallize_delay); }
  return result;
}

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  switch crystallize_logic {
    case 1: pick_up_crystallize("any");
    case 2: switch {
      case char_id == .keys.char.fischl && action_id == .action.burst:
        pick_up_crystallize("any");
      case char_id == .keys.char.noelle && action_id == .action.dash:
        pick_up_crystallize("any");
    }
  }
  return _execute_action(char_id, action_id, p);
}

navia char lvl=90/90 cons=0 talent=6,8,6;
navia add weapon="verdict" lvl=90/90 refine=1;
navia add set="shimenawasreminiscence" count=2;
navia add set="gladiatorsfinale" count=2;
navia add stats hp=4780 atk=377.14 atk%=0.7516 def%=0.3207 cr=0.6688 cd=0.9093 em=39.629997 er=0.0648 geo%=0.466;

noelle char lvl=90/90 cons=6 talent=10,9,10;
noelle add weapon="skywardpride" lvl=90/90 refine=1;
noelle add set="huskofopulentdreams" count=4 +params=[stacks=4];
noelle add stats hp=4780 hp%=0.1108 atk=361.57 atk%=0.0933 def=32.4 def%=1.3410001 cr=0.54429996 cd=0.64479995 er=0.24600002 geo%=0.466;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="thestringless" lvl=90/90 refine=5;
fischl add set="goldentroupe" count=4;
fischl add stats hp=5287.88 hp%=0.0408 atk=382.97 atk%=0.466 def=99.54 def%=0.1603 cr=0.6493 cd=0.8158 em=86.25 electro%=0.466;

furina char lvl=90/90 cons=0 talent=6,10,10;
furina add weapon="festeringdesire" lvl=90/90 refine=5;
furina add set="goldentroupe" count=4;
furina add stats hp=5048.88 hp%=0.8740001 atk=347.96002 atk%=0.105 def=16.2 def%=0.1968 cr=0.5404 cd=0.69159997 em=60.61 er=0.1879 hydro%=0.466;

options iteration=1000 swap_delay=12;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=9999999;

active fischl;
for {
  switch {
    case .fischl.skill.ready && .fischl.swap.ready && !.fischl.oz:
      fischl skill, attack;
    case .fischl.burst.ready && .fischl.swap.ready && !.fischl.oz:
      fischl attack:2, burst;

    case .navia.burst.ready && .navia.swap.ready:
      navia burst;
    case .furina.burst.ready && .furina.swap.ready:
      if .furina.skill.ready { furina skill; }
      furina burst;

    case .furina.skill.ready && .furina.swap.ready && !.furina.status.furina-skill:
      furina skill;
    case .navia.skill.ready && .navia.swap.ready && (.navia.shrapnel+.gadgets.crystallizeshard.all >= 6):
      if .navia.shrapnel >= 6 {
        navia skill;
      } else { navia skill[hold=1]; }
      navia attack:3;

    case .noelle.burst.ready && .noelle.swap.ready && !.noelle.status.noelle-burst:
      noelle burst;
    case .noelle.skill.ready && .noelle.onfield:
      noelle skill;
    case .noelle.normal == 4:
      noelle dash;
    case .noelle.status.noelle-burst:
      noelle attack;

    // defaults
    case .navia.onfield:
      navia attack;
    case .noelle.onfield:
      noelle attack;
    case .fischl.onfield:
      fischl attack;
    case .furina.onfield:
      furina attack;
  }
}
