emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622 ; #main
emilie add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972  cd=0.662 ;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="prototypeamber" refine=5 lvl=90/90;
baizhu add set="deepwood" count=5;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359 ; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.2976 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=1000;
#--------------------------------------------
#action list:
active furina;
for let i = 0; i < 6; i = i + 1 {
  furina skill, dash, attack, burst;
  baizhu attack, skill, burst;
  if ( i / 2 ) * 2 != i {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  yoimiya skill,
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          attack:3;
  if ( i / 2 ) * 2 == i {
    yoimiya burst;
  } else {
    yoimiya attack:2, dash, attack;
  }
}
