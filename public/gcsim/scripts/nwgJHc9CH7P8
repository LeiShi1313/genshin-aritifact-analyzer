options swap_delay=1 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active xingqiu;
for let x=0; x<6; x=x+1 {
  xingqiu attack, skill, dash, burst, attack;
  bennett attack, skill, burst, attack;
  if .fischl.skill.ready {
    fischl skill, attack;
  } else {
    fischl attack, burst;
  }
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if .yoimiya.burst.ready && .yoimiya.energy == .yoimiya.energymax {
    yoimiya burst;
    bennett attack:2, skill;
  } else {
    fischl attack:3;
    bennett attack:2, skill;
  }
}

