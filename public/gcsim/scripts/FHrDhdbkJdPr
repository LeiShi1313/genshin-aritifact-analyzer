mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="mailedflower" refine=5 lvl=90/90 +params=[stacks=5];
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active mav;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  fischl skill, attack;
  mav skill, burst;
  mizuki attack, skill, burst;
  while .mizuki.status.dreamdrifter-state > 150 {
    wait(1);
  }
  fischl attack:2, burst;
  mizuki attack, charge, attack, charge;
  mizuki attack:9;

}
