# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

#Rotation
active fischl;
fischl skill;

for let x = 0; x < 4; x = x + 1 {
  xingqiu skill, dash, burst, attack;

  ororon skill, burst, attack;

  bennett burst, skill, attack;

  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }

  bennett attack:1;
  #while .xingqiu.skill.cd > 30 {
  while .status.bennettburst || .bennett.infusion.bennett-fire-weapon {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  bennett attack;
}
