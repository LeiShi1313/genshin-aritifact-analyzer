for let i=0; i<4; i=i+1 {

  xilonen burst;
  furina skill, dash, burst;
  xilonen skill, attack:2;
  navia burst;
  yelan burst, skill, attack;
  navia skill[hold=1], attack:3, dash, attack:2;
  xilonen skill, attack:2;
  navia skill[hold=1], attack:3;
  yelan skill, attack:2;
  if i == 0 || i == 3 {
    navia skill[hold=1];
  }
}
