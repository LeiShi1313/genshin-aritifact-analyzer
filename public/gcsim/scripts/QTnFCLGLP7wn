bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=178.38 cr=0.0662 cd=0.4634;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active yelan;
for let x=0; x<4; x=x+1 {
  yelan attack, skill, attack, burst, attack;
  if !.yelan.mods.favonius-cd {
    yelan attack;
  }
  bennett skill, burst;
  yunjin attack, skill, burst; # N1 to get hydro aura to trigger crystallize for YunJin C4's DEF increase
  yoimiya attack, # N1 to get hydro aura on the enemy to vape first N1 hit
          skill,
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          attack:3;
  yunjin skill, attack:2; # catch her own particles, also to make next rot E is not on cooldown
}
