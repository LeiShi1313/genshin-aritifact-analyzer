# Raiden Columbina Sucrose Ineffa. ~18s Rot. KQMS KurtC. Raiden Lunarcharge. Raiden prefers SMS. Sucrose refreshes VV before and after Raiden's field time, using burst if available.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="favlance" refine=3 lvl=90/90;
raiden add set="sms" count=4;
raiden add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
raiden add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="aubade" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*7 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*7 cd=0.0662*10;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacfrags" refine=5 lvl=90/90;
#sucrose add weapon="evenstar" refine=1 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187; #main
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*6 cr=0.0331*9 cd=0.0662*4;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<5; i=i+1 {
  columbina skill, burst;

  ineffa skill, burst;

  if .sucrose.burst.ready && .sucrose.skill.ready {
    sucrose skill, dash, burst;
  } else if .sucrose.skill.ready {
    sucrose skill, dash, attack;
  } else {
    sucrose attack, charge;
  }

  raiden burst,
         attack:4, skill,
         attack:4, dash,
         attack:4, dash,
         attack:4;

  if .sucrose.burst.ready && .sucrose.skill.ready {
    sucrose skill, dash, burst;
  } else if .sucrose.skill.ready {
    sucrose skill, dash, attack;
  } else {
    sucrose attack, charge;
  }

  columbina attack:1;
}
