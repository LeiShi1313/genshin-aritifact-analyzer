options swap_delay=12 iteration=100;

target lvl=100 hp=3000000 radius=2 pos=0,2.4 particle_threshold=520000 particle_drop_count=3;

active furina;

while 1 {
    switch {
      case .furina.skill.ready:
      furina skill, dash;
      case .furina.burst.ready:
      xilonen burst;
      furina burst;
      case .xilonen.skill.ready:
      xilonen skill, attack:2;
      case .kazuha.skill.ready:
      kazuha skill[hold=1], high_plunge;
      case .kazuha.burst.ready:
      kazuha burst;
      case .travelerhydro.skill.ready:
      travelerhydro skill[hold=1], dash[pickup_droplets=4];
      case .travelerhydro.burst.ready:
      travelerhydro burst;

      default:
      travelerhydro attack;
      if .travelerhydro.normal==2 {
        travelerhydro charge;

      }
    }
  }
