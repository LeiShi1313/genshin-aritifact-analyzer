#raiden add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; # main
#raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.3972 cd=0.2648; # Cpike/MH/CD
