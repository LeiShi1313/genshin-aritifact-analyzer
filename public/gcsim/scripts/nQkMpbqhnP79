mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
#mika add set="sodp" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Raiden Cpike Function
fn RaidenCpike() {
  switch {
  case .raiden.normal > 3 && .stam > 25:
    raiden charge;
  case .raiden.normal > 4 && .stam > 18:
    raiden dash;
  default:
    raiden attack;
  }
}

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  yelan skill, burst, attack;

  mika burst, attack, skill;

  while !.yelan.skill.ready {
    RaidenCpike();
  }

  yelan skill, attack;

  raiden skill;
  while .yelan.skill.cd > 210 {
    RaidenCpike();
  }
}
