chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;																						

options iteration=1000 swap_delay=12;                                                                       
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active sara;

sara skill;

for let i = 0; i < 5; i = i + 1 {
  
  if .chevreuse.burst.ready {
    chevreuse burst, skill[hold=1];
  } else {
    chevreuse attack, skill[hold=1], attack;
  }
  if i {
    clorinde burst; # funnel energy to clorinde 
    sara skill; # not ready first rot due to using it at start for electro app
  }
  if .xl.burst.ready {
    sara burst;
    xiangling burst, skill, dash;
  } else {
    xl attack:2, skill, dash;
  }
  sara aim;
  clorinde_combo();
 
}