# Noelle Furina Xingqiu Xilonen. ~22s Rot. MH > AP Noelle. Crystallize shards are caught with dashes or movement. Noelle Geo DMG > DEF Goblet. Furina's HP remains high through the rotation. AP option in config.

# Team - Options listed by DPS
noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
noelle add set="mh" count=4;
#noelle add set="ap" count=4;
noelle add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #main
noelle add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2317 cd=0.662; # MH; Geo > Def
#noelle add stats hp=4780 atk=311 def%=0.583 def%=0.583 cd=0.622; #main
#noelle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958; # AP; Def > Geo

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Pickup Crystallize Function
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilonen && action_id == .action.skill ) {
    pick_up_crystallize("any");
  }

  return _execute_action(char_id, action_id, p);
}

# Rotation
active noelle; # SS Stacks

for let i = 0; i < 4; i = i + 1 {
  if i > 0 {
    xilonen burst;
  }

  furina skill, dash, burst;

  xq skill, dash, burst, attack;

  xilonen skill, attack:2;

  noelle skill, attack, burst;
  noelle attack:3, dash;
  noelle attack:3, dash;
  noelle attack:3;

  xilonen skill, attack:2;

  noelle attack:4;
}
