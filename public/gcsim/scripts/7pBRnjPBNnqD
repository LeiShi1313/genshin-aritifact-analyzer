#fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
#fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # EM

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Clorinde Combo
fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

#Rotation
active fischl; # SS Stacks

for let i=0; i<4; i=i+1 {
  amy attack;
  if .amy.skill.ready {
    amy skill;
  } else {
    amy attack, burst;
  }
  
  xilonen skill, attack:2;
  
  tighnari skill, aim;
  if i > 0 && .tighnari.burst.ready {
    tighnari burst, aim:2;
  } else {
    tighnari aim:2;
  }
  
  clorinde_combo();
  if .clorinde.burst.ready {
    clorinde burst;
  }
  
  #if is_even(i) {
  #  xilonen burst;
  #}
}
