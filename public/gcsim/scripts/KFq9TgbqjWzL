# Varka Prune Durin Nicole
options swap_delay=12 iteration=1000;

# Build assumptions
varka char lvl=90/90 cons=0 talent=9,9,9;
varka add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
varka add set="risingwinds" count=4;
varka add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
varka add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

prune char lvl=90/90 cons=6 talent=9,9,9;
prune add weapon="oathsworneye" refine=5 lvl=90/90;
prune add set="vv" count=4;
prune add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
prune add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*2 cr=0.0331*10 cd=0.0662*4;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="ttds" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*8 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*12 cd=0.0662*7;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

fn varka_combo(a) {
  switch {
    case a == 1: {
      # N1CW 2[N4sE] N1C
      # 133.6k
      # Too short for TTDS every rotation, so Flowing Purity Nicole is better. Durin needs 1 more ER roll.
      varka skill,
            attack, charge, walk,
            attack:4, skill,
            attack:4, skill,
            attack, charge;
    }
    case a == 2: {
      # N1CW N4sE 3[N1CW] N1sE N1C
      # 140.1k
      varka skill,
            attack, charge, walk,
            attack:4, skill,
            attack, charge, walk,
            attack, charge, walk,
            attack, charge, walk,
            attack, skill,
            attack, charge;
    }
    case a == 3: {
      # 3[N1CW] N2sE 3[N1CW] N1sE N1
      # 140.5k
      varka skill,
            attack, charge, walk,
            attack, charge, walk,
            attack, charge, walk,
            attack:2, skill,
            attack, charge, walk,
            attack, charge, walk,
            attack, charge, walk,
            attack, skill,
            attack;
    }
  }
}

# Rotation assumptions
active varka;
for let i=0; i<6; i=i+1 {
  durin skill:2, burst;
  prune skill, burst;
  nicole skill, burst;
  varka_combo(3);
}
