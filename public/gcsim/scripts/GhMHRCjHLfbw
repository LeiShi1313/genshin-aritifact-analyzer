options swap_delay=12 iteration=1000;

# Build assumptions
alhaitham char lvl=90/90 cons=6 talent=10,10,10;
alhaitham add weapon="lofi" refine=5 lvl=90/90;
alhaitham add set="mh" count=4;
alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622;
alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="key" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.0662 cd=0.7282;

fischl char lvl=90/90 cons=6 talent=10,10,10;
fischl add weapon="elegy" refine=5 lvl=90/90;
fischl add set="deepwood" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=6 talent=10,10,10;
nahida add weapon="tfd" refine=5 lvl=90/90;
nahida add set="gt" count=5;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active fischl;

fischl skill;
for let i=0; i<4; i=i+1 {

  furina skill, dash, burst, attack:2;
  nahida skill, burst, charge;
  alhaitham skill, attack, burst;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  alhaitham attack:3, charge,
            attack:2, dash,
            attack:3, charge,
            attack:3, dash,
            attack:3, charge,
            attack:3;
}
