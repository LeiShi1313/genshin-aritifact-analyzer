charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="ttds" refine=5 lvl=90/90; 
charlotte add set="clam" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 em=187 em=187; 
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.4408 em=158.56 cr=0.0662 cd=0.1324;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

fn freminetCombo(){
  freminet skill, attack, burst,
           attack:2, skill, attack, skill,
           attack:2, skill, attack, skill,
           attack:2, skill, attack, skill,
           attack:3, skill;
}

active freminet;
freminet skill;

for let i=0; i<4; i=i+1{
  furina skill, dash, burst;
  if .fischl.burst.ready{
    fischl attack:2, burst;
  }
  else if .fischl.skill.ready{
    fischl attack, skill;
  }
  charlotte skill, burst;
  # increases damage in first rotation, i have no idea why this works
  if !i{
    freminet attack:4, skill;
    freminetCombo();
  }
  else{
    freminetCombo(); 
  }
}

