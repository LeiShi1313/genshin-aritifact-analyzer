bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="deepwood" count=4;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359 ;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.3306 em=237.84 cr=0.0662 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active emilie;
emilie skill;
for let i = 0; i < 5; i = i + 1{
  bennett skill,burst;
  kazuha skill,high_plunge,burst;
  xiangling burst, skill;
  if .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill,attack;
  }
  bennett attack:2,skill;
  xiangling attack:3;
  kazuha skill,high_plunge;
  emilie attack:3;
  bennett skill,attack:2;
  xiangling attack:3;
  bennett attack:2;
}



