bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

ningguang char lvl=90/90 cons=6 talent=9,9,9;
ningguang add weapon="widsith" refine=3 lvl=90/90;
ningguang add set="nighttimewhispers" count=4;
ningguang add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; #main
ningguang add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active navia;
navia skill; # start with E for energy
for let x=0; x<4; x=x+1 {
  if .navia.burst.ready {
    navia burst;
  } 
  ning skill, dash, attack;
  bennett skill, burst;
  if .fischl.skill.ready{
    fischl attack, skill;
  } else {
    fischl attack:2, burst;    pick_up_crystallize("any"); #with fischl Q
  }
  ningguang burst, walk, skill, dash;
  ningguang attack, charge;
  print(.navia.shrapnel);
  navia skill[hold=1], attack:3, dash, attack:2;
  bennett skill, attack; 
  print(.navia.shrapnel);
  navia skill[hold=1], attack:3;
}

