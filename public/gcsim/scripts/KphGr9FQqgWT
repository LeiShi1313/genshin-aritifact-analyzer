# Freminet Furina Ororon Charlotte. ~21s Rot. Physical Freminet with Ororon. Cryo application from Freminet and Charlotte meaningfully lowers electrocharge frequency. Tidal Shadow + MH and Serpent Spine + PF are similar. 

# Team
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="tidalshadow" refine=5 lvl=90/90;
#freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
freminet add set="mh" count=4;
#freminet add set="pf" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622;
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # MH + PF
#freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622;
#freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # PF + SS

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3641 cd=0.4634;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="ttds" refine=5 lvl=90/90; 
charlotte add set="clam" count=4;
#charlotte add set="no" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 cryo%=0.466 atk%=0.466; 
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.551 em=39.64 cr=0.0662 cd=0.3972;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active ororon;

for let i=0; i<4; i=i+1{
  ororon skill, burst;
  
  furina skill, dash, attack, burst;
  
  charlotte skill, burst;
  
  freminet skill, attack, burst,
           attack:2, skill:2,
           attack:2, skill, attack:1, skill,
           attack:2, skill, attack:1, skill,
           attack:2, skill;
  
}
