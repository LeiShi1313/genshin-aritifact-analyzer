xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*9 atk%=0.0496*8 er=0.0551*9 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Pickup Crystallize Function
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilonen && action_id == .action.skill) {
    pick_up_crystallize("any");
  }

  return _execute_action(char_id, action_id, p);
}

#Rotation
active navia; # SS Stacks

for let i=0; i<4; i=i+1 {
  durin skill:2, burst;

  if i > 0 {
    xilonen burst;
  }
  xilonen skill, attack:2;
  pick_up_crystallize("any");

  navia burst;

  xianyun skill, low_plunge, burst;

  navia skill;
  for let h = 4; h > 0; h = h - 1 {
    navia jump;
    if .airborne {
      navia high_plunge[collision=rand()>0.50];
    }
    if h > 1 {
      navia dash;
    }
  }

  xilonen skill, attack:2;

  navia skill;
  for let h = 4; h > 0; h = h - 1 {
    navia jump;
    if .airborne {
      navia high_plunge[collision=rand()>0.50], dash;
    }
  }
  if .navia.skill.ready {
    navia skill, attack:3;
  }
}
