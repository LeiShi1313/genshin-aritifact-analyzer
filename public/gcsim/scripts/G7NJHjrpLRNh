options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active fischl;
for let i=0; i<4; i=i+1 {
  if i==0 {
    fischl burst;
    sayu skill;
  } else {
    fischl attack:2, burst;
  }
  nahida skill, attack, burst;
  furina skill, dash, burst;
  sayu burst;
  nahida attack, skill, attack:3, charge;
  if i==0 {
    fischl attack:2, skill;
  } else {
    fischl attack:5, skill;
  }
  sayu skill[hold=600];
  print("rotation done");
}
