yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="esf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworneye" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=181.94 atk%=0.2976 er=0.4959 em=39.64 cr=0.0662 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active furina;
for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  arlecchino attack, skill;
  xianyun skill, low_plunge, burst;
  yelan burst, attack, skill;
  arlecchino charge, attack;
  for let p = 8; p > 0; p = p - 1 {
    arlecchino jump;
    if .airborne {
      arlecchino high_plunge[collision=rand()<0.5], attack;
    } else {
      arlecchino attack:3;
      break;
    }
  }
  yelan skill, attack:2;
}
