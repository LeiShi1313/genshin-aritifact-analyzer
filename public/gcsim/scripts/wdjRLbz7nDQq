# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active nahida;
nahida skill;

for let i = 0; i < 4; i = i + 1 {
  if i > 0 {
    nahida skill, burst;
  }
  
  furina skill, dash, burst;
  
  baizhu skill, attack, burst;
  
  keqing skill, burst, skill;
  keqing attack, charge,
         attack, charge,
         attack, charge,
         attack, charge,
         attack, charge;
  
  baizhu skill, attack;
  
  keqing skill:2;
  keqing attack, charge,
         attack, charge,
         attack, charge,
         attack, charge;
