# Kazuha Furina Emilie Bennett. ~20s Rot. Kazuha and Bennett use skills as available to apply Pyro. Bennett builds EM. Emilie on fields during downtime for more Bennett burst buffing. 70% Collisions. Swirling Hydro mutiple times per rotation may be problematic in as targets increase.

# Team
kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favsword" refine=3 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622 ;
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
#bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=140]; # to Kazuha
bennett add set="deepwood" count=4;
bennett add stats hp=4780 atk=311 em=187 em=187 em=187;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.2204 em=118.92 cr=0.0662 cd=0.3972; # AF
#bennett add stats hp=4780 atk=311 em=187 em=187 em=187;
#bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=118.92 cr=0.3972 cd=0.331; # SB
#bennett add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359 ; #main
#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.1984 er=0.2204 em=237.84 cr=0.0662 cd=0.1324; # Heals

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

#Rotation
active furina;

for let i=0; i<4; i=i+1 {
  if i && .emilie.burst.ready { 
    emilie burst;
  } else {
    emilie skill, attack;
  }
  
  furina skill, dash, burst;
  
  kazuha skill, high_plunge[collision=rand()>0.3];
  
  bennett skill, burst;
  
  kazuha burst;
  
  emilie attack:2;
  
  kazuha attack, skill, high_plunge[collision=rand()>0.3];
  
  bennett skill, attack;
  
  emilie attack:5;
  
  kazuha attack, skill, high_plunge[collision=rand()>0.3]; # Bennett Q expires
  
  print("done");
}

