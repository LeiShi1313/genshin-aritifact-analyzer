furinadefontaine add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furinadefontaine add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active furina;
for let i=0; i<3; i=i+1 {
  furinadefontaine skill, dash, burst;

  if !i {
    bennett skill, burst;
  } else {
    bennett burst, skill;
  }
  yelan burst, attack, skill, attack;
  yanfei skill, attack;
  if .yanfei.burst.ready {
    yanfei burst;
  }
  yanfei attack, charge,
         attack, charge,
         attack, charge,
         attack, charge,
         attack, charge, attack;
  yelan skill, attack;
  yanfei skill, attack,
         charge, attack;

}
