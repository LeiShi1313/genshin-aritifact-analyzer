active shenhe;
target lvl=100 resist=0.1 hp=999999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

for let x=0; x<4; x=x+1 {
  shenhe skill[hold=1], attack;
  if .shenhe.burst.ready {
    shenhe burst;
  } else {
    shenhe attack;
  }
  xilonen skill, attack:2;
  yunjin skill, burst;
  if .yunjin.sets.ap >= 4 {
    yunjin dash; pick_up_crystallize("cryo");
  }
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump;
  if .wrio.burst.ready {
    wrio burst;
  } else {
    wrio attack:3;
  }
}
