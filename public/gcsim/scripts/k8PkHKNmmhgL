options swap_delay=12 iteration=1000;

# Build assumptions
neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacjade" refine=1 lvl=90/90;
neuvillette add set="marechausseehunter" count=5;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.4464 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.2317 cd=0.662;

prune char lvl=90/90 cons=6 talent=9,9,9;
prune add weapon="favcodex" refine=3 lvl=90/90;
prune add set="vv" count=4;
prune add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
prune add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=82.7 atk%=0.2976 er=0.2755 em=39.64 cr=0.3972 cd=0.1324;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="cg" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active neuvillette;

for let i=0; i<4; i=i+1 {
  neuvillette skill;
  columbina skill, burst;
  fischl attack, skill, attack;
  prune attack, skill, burst;
  neuvillette charge, burst, skill, charge;
  fischl attack:2, burst;
  prune attack:2;
  if !.prune.mods.favonius-cd {
    prune attack;
  }
  neuvillette charge:2;
}
wait(173);

# Neuvillette E > Columbina E Q > Fischl N1 E N1 > Prune N1 E Q > Neuvillette C Q E C > Fischl N2 Q > Prune N2 > Neuvillette 2[C]
