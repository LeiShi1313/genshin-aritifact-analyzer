# Gaming Chevreuse Mavuika Ororon. ~18s Rot. Gaming Overload with Natlanteans. Does 7 plunges, Juggling Manchai using wait on the ground to catch it while descending.  Mavuika just does EQD. Full EM Ororon. Full Healing Chevreuse. LNO ends up being best here. At lower con gaming you would want to Mavuika to QE to pass particles to Gaming. 

# Team - Options listed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9; 
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="lno" count=4;
#gaming add set="vh" count=4;
#gaming add set="cw" count=4;
#gaming add set="mh" count=4;
gaming add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Other
#gaming add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
#gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # MH

chevreuse char lvl=90/90 cons=6 talent=9,9,9; 
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.1986;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 em=187 em=187 em=187; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.3972 cd=0.2648;

# Options
options iteration=1000; 
options swap_delay=12; # KQMS
energy every interval=480,720 amount=1; # KQMS

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # 1T

# Rotation
active mav; # SS Stacks

for let i=0; i<4; i=i+1 { 
  ororon burst, skill;
  
  chev burst, skill[hold=1]:2;
  
  mav skill, burst, dash;
  
  gaming burst, attack:2,
         skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
  gaming skill, low_plunge;
  gaming skill, low_plunge;
}

