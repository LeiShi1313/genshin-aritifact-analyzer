# - Characters

klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="mh" count=4;
klee add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.2204 em=39.64 cr=0.2979 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hydro%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="no" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="ins" count=4;
bennett add stats hp=3571 atk=232 hp%=0.3495 hp%=0.3495 heal=0.359; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.331;
# 0.84x scalar to account for one 5* artifact

# - Options

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# - Target

target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999;

# - Actions

active furina;

for let r=0; r<5; r=r+1 {
  furina skill, dash, burst;
  xingqiu skill, dash, burst, attack;
  if !r {
    bennett skill, burst;
  } else {
    bennett burst, attack, skill;
  }
  klee attack, burst, walk,
       attack[travel=6], charge,
       attack[travel=6], charge,
       attack, skill[bounce=3, mine=8], jump,
       attack, walk, attack[travel=6], charge;
  if .klee.skill.ready {
    klee attack, skill[bounce=3, mine=8], jump;
  } else {
    klee attack[travel=6], charge;
  }
  klee attack[travel=6], charge,
       attack, walk, attack[travel=6], charge,
       attack, walk, attack[travel=6], charge, attack;
  bennett skill;
}

# Hyperbuffed Klee Double Hydro Vape with Klee, Furina, Xingqiu, Bennett. Klee Vapes ~92% of her CAs and uses a mix of N1Cs and N2Cs. Bennett only heals himself and Klee.
# 1st Rot: Furina E D Q, Xingqiu E D Q N1, Bennett E Q, Klee N1QW 2N1C N1EJ N2C N1EJ N1C 2N2C N1, Bennett E
# Subsequent Rots: Furina E D Q, Xingqiu E D Q N1, Bennett Q N1 E, Klee N1QW 2N1C N1EJ N2C 2N1C 2N2C N1, Bennett E
# Klee strings together her NAs with walk cancels to do repeated N1s in her N2Cs
