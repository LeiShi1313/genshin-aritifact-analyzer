options swap_delay=12 iteration=1000;

# Build assumptions
arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="fjords" refine=1 lvl=90/90;
arle add set="fohw" count=5;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=4 lvl=90/90;
yelan add set="sms" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="fjords" refine=1 lvl=90/90;
ineffa add set="gd" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=237.84 cr=0.0662 cd=0.2648;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active arle;

for let i = 0; i < 4; i = i + 1 {
  arle skill;
  yelan attack, skill, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack; # if its still not triggered try fav.
  }
  bennett skill, burst;
  ineffa attack, skill;
  let eq=0;
  if .ineffa.burst.ready {
    ineffa burst;
    eq=1;
  }
  arle attack, charge,
       attack:3, charge,
       attack:3, charge,
       attack:3, charge,
       attack:3, charge,
       attack:3;
  if eq==0 {
    arle dash, attack:2;
  }
}
