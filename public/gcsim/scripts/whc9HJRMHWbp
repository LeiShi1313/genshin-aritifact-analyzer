# Yae Chevreuse Fischl Mavuika. ~25s Rot. On-field Yae Overload. Yae uses burst every rotation after 3N1CD to regen stamina. After Fischl refreshes her burst, Yae does N2CJ.

# Team - Options listed by DPS
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="flowingpurity" refine=5 lvl=90/90; # Whimsy
#yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="solarpearl" refine=1 lvl=90/90;
yae add set="fohw" count=4; # Purity
#yae add set="gt" count=4;
#yae add set="ts" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # CR
#yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.331;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="aquamarine" refine=1 lvl=90/90;
#mavuika add weapon="mailedflower" refine=5 lvl=90/90;
mavuika add set="scroll" count=4;
#mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 em=187 em=187; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # 3EM
#mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
#mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.2979 cd=0.4634;# EDC

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

for let i = 0; i < 4; i = i + 1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae attack, skill, attack, skill, attack, skill;
  }

  if .chev.burst.ready {
    chev burst, skill[hold=1]:3;
  } else {
    chev skill[hold=1], burst;
  }

  fischl skill, attack;

  if .mav.burst.ready {
    mav burst, skill, dash;
  } else {
    mav dash, skill;
  }

  yae attack, charge, dash;
  yae attack, charge, dash;
  yae attack, charge, dash;
  yae burst, attack, skill:3;

  fischl attack:2, burst;

  yae attack:2, charge, jump;
  yae attack:2, charge, jump;
  yae attack:2, charge, jump;
  yae attack:2;
}
