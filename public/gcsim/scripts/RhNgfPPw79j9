# Diluc Citlali Bennett Xianyun. ~20s Rot. Diluc Plunge Melt with Citlali. 6 Melted plunges, 5 covered by VV, the final 2 plunges are not melted, just used to fill time. Double fav is needed to not encounter ER issues.

# Team - Options Listed by DPS
diluc char lvl=90/90 cons=0 talent=9,9,9;
diluc add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#diluc add weapon="fruitfulhook" refine=1 lvl=90/90;
diluc add set="lno" count=4;
#diluc add set="lno" count=2; diluc add set="cw" count=2;
#diluc add set="cw" count=4;
diluc add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
diluc add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="favcodex" refine=3 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 cr=0.311; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Diluc Plunge Combo
fn DilucPlunge() {
  diluc jump;
  if .airborne {
    diluc high_plunge[collision=rand()>0.5];
  }
}

active diluc; #SS stacks

for let i=0; i<4; i=i+1 {
  #if i == 0 {
  #  diluc burst;
  #} else {
    diluc skill;
  #}
  
  xianyun skill, high_plunge, burst;
  
  bennett skill, burst;
  
  citlali skill, burst, attack; # N1 needed to clear Pyro
  
  DilucPlunge();
  DilucPlunge();
  DilucPlunge();
  DilucPlunge();
  DilucPlunge(); diluc dash; wait(60); # For Pyro Aura.
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); #diluc dash;
  diluc skill;
}
