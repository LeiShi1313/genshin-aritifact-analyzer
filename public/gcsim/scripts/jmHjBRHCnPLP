# Freminet Rosaria Fischl (C5)Bennett. ~19s Rot. Phys Freminet if you didn't C6 Bennett. C6 Bennett is -2K DPS. The final Shattering Pressure combo is unbuffed.

# Team - Options ordered by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
freminet add set="pf" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="emblem" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # VH
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Others

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90;
#bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662; # Sapwood
#bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
#bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # Fav

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active freminet; # SS Stacks

fischl skill, attack;

for let i = 0; i < 4; i = i + 1 {
  bennett skill, burst;

  rosaria skill, burst;

  amy attack;
  if .amy.burst.ready && .amy.energy == .amy.energymax {
    amy attack:1, burst;
  } else {
    amy skill;
  }

  freminet skill, attack, burst,
         attack:2, skill, skill,
         attack:2, skill, attack, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
         attack:2, skill, attack, skill,
         attack:2, skill;

}
