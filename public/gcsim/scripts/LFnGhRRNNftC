# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active klee;

for let i=0; i<4; i=i+1 {
  # [travel=6] is added to make klee's n1 hit before each CA starts -> gameplay accurate
  # bomb/mine explosion delays are not perfect but they try to sort of emulate what would happen in combat
  klee skill[bounce=3, mine=8, mine_delay=700], attack[travel=6], charge;
  if .klee.skill.ready {
    klee attack, skill[bounce=3, mine=8, mine_delay=550], jump;
  }

  kazuha burst;

  kirara skill[short_hold=1], burst[hits=10, mine_delay=250];

  aloy skill[bomblets=6, bomb_delay=50], attack;
  if .aloy.skill.ready {
    aloy skill[bomblets=6, bomb_delay=20];
  }

  # approximately when bombs/mines would explode
  kazuha skill, high_plunge;

  aloy burst;

  kirara skill, attack;

  if .klee.burst.ready {
    klee burst;
  } else {
    klee attack[travel=6], charge;
  }
  klee attack[travel=6], charge, attack[travel=6], charge, attack[travel=6], charge, attack[travel=6], charge;
}

