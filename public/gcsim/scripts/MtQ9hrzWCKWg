mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="sacrificialjade" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=5;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
mualani add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*9 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*7 cr=0.0331*2 cd=0.0662*10;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="evenstar" refine=1 lvl=90/90;
lauma add set="deepwood" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

emilie char lvl=90/90 cons=1 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mavuika add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

options swap_delay=12 iteration=100;

active mav;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo1() {
  #doing 2[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<1; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
  mualani walk;
}

fn mualani_combo3() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
  mualani walk;
}
mualani attack;
for let i=0; i<7; i=i+1 {


  mavuika burst, charge:2, dash, charge:2, dash, charge:2, dash, skill;


  if i > 0 {
    mualani attack, charge; # N1C on Mua is necessary for Hydro Scroll past the first rotation.
  }


  if .verdant-dew > 0 {
    lauma attack;
    lauma skill[hold=1];
  } else {
    lauma skill, attack;
  }

  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  mualani skill;
  if .mualani.burst.ready {
    mualani_combo1();
    mualani walk[f=1], burst[travel=2];
    mualani_combo1();
  }
  else {
    mualani_combo3();
  }

}
