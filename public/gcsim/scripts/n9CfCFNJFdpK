# Razor Rosaria Fischl Zhongli. ~22s Rot. Blast from the past Razor with 80% Phys shred.

# Team
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="pf" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; # main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9; 
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; # main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.4634;

fischl char lvl=90/90 cons=6 talent=9,9,9; 
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" lvl=90/90 refine=3;
zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active razor; # SS Stacks

fischl skill, attack;
  
for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd && i > 0 {
    zhongli attack;
  }
  
  rosaria skill, attack, burst;
  
  fischl attack;
  if .fischl.burst.ready && .fischl.energy == .fischl.energymax {
    fischl attack, burst;
  } else {
    fischl skill;
  }
  
  # Razor out of burst actions; account for energy deficiency
  while !.razor.mods.razor-q {
    if .razor.burst.ready && .razor.skill.ready {
      razor skill, dash, attack, burst;
    } else if .razor.burst.ready && .razor.energy == .razor.energymax {
      razor burst;
    } else if .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  # Razor Main DPS window;
  while .razor.mods.razor-q > 270 { 
    if .razor.normal > 3 && .razor.skill.ready {
        razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}

