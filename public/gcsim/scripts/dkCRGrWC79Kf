options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active zhongli;
for let x = 0; x < 4; x = x + 1 {
  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  navia burst;
  furina skill, dash, burst;
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  xianyun skill, low_plunge, burst;  pick_up_crystallize("any"); 
  navia skill[hold=1];
  for let h = 4; h > 0; h = h - 1 {
    navia jump;
    if .airborne {
      navia high_plunge[collision=rand()>0.5], dash;
    }
  }
  zhongli attack:2, skill;
  for let n=0; n<2; n=n+1 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    }
  }
  navia skill[hold=1];
  for let h = 4; h > 0; h = h - 1 {
    navia jump;
    if .airborne {
      navia high_plunge[collision=rand()>0.5], dash;
    }
  }
}