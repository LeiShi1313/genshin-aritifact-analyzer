# Eula Furina Lisa Mika. ~22s Rot. Eula with EM Lisa providing Superconduct and RES shred. Mika passes Fav particles to Eula at the end of the Rotation.

# Team
eula char lvl=90/90 cons=0 talent=9,9,9; 
eula add weapon="uomms" refine=5 lvl=90/90;
eula add set="mh" count=4;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.4408 em=39.64 cr=0.3972 cd=0.1986;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ToM

lisa char lvl=90/90 cons=0 talent=9,9,9; 
lisa add weapon="fruit" refine=5 lvl=90/90;
lisa add set="gd" count=4;
lisa add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.4959 em=158.56 cr=0.0662 cd=0.1324;

mika char lvl=90/90 cons=6 talent=9,9,9; 
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

#Rotation
active lisa;

for let i=0; i<4; i=i+1 { 
  lisa skill[hold=1], burst; sleep(20);
  
  furina skill, dash, attack, burst;
  if !.furina.mods.favonius-cd {
    furina attack;
  }
  
  mika burst, skill;
  if !.mika.mods.favonius-cd {
    mika attack;
  }
  
  eula skill;
  if !.eula.burst.ready {
    eula attack;
  }
  eula burst, walk, attack:4, skill[hold=1], walk[f=11], attack:4, dash, attack:2;
  
  while !.mika.mods.favonius-cd || .eula.swap.cd {
    mika attack;
  }
  
  eula attack:2;
}

