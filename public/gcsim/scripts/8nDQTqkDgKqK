options swap_delay=12 iteration=1000;

# Build assumptions
xianyun char lvl=90/90 cons=6 talent=1,10,9;
xianyun add weapon="crane" refine=1 lvl=90/90;
xianyun add set="lno" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311 ; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*15 cd=0.0662*5;

faruzan char lvl=90/90 cons=6 talent=1,9,10;
faruzan add weapon="favbow" refine=5 lvl=90/90;
faruzan add set="scroll" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311 ; #main
faruzan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*8 em=19.82*2 cr=0.0331*16 cd=0.0662*2;

durin char lvl=90/90 cons=0 talent=1,10,10;
durin add weapon="lionsroar" refine=5 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*8 cd=0.0662*13;

nicole char lvl=90/90 cons=0 talent=1,10,10;
nicole add weapon="atlas" refine=1 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*9 cd=0.0662*3;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active nicole;
for let i=0; i<4; i=i+1 {
  nicole attack, skill;
  durin skill:2, burst;
  faruzan burst;
  for let j=0; j<2; j=j+1 {
    if !.faruzan.mods.favonius-cd {
      faruzan attack;
    }
  }
  xianyun skill, low_plunge, burst;
  for let h = 6; h > 0; h = h - 1 {
    xianyun skill:3, high_plunge;
  }
}
