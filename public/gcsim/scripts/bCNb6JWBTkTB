kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1653 em=118.92 cr=0.2317 cd=0.1324;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.434 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5958;

options swap_delay=12 iteration=1000;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

active xilonen;

for let i=0; i<3; i=i+1 {
  xilonen burst;
  furina skill, dash, burst;
  xilonen skill, attack:2;
  kazuha skill, high_plunge;
  mualani skill;
  mualani_combo();
  mualani skill; # exit the nightsoul state
  mualani burst;

  kazuha skill, high_plunge; # this buffs mualani Q (hits after kazuha)
  xilonen skill, attack:2;
  kazuha burst;
  mualani skill;
  mualani_combo();
}

# Xilonen Q > Furina EDQ > Xilonen E N2 > Kazuha tEP > Mualani E 3[3-stacked bite] E(cancel) Q >
# Kazuha tEP > Xilonen E N2 > Kazuha Q > Mualani E 3[3-stacked bite] >
