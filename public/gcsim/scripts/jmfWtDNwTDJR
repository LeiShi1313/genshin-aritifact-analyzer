kokomi char lvl=90/90 cons=0 talent=9,9,9;
#Ballad > Proto Amber >= Flowing Purity
kokomi add weapon="prototypeamber" refine=5 lvl=90/90;
kokomi add set="clam" count=4;
kokomi add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 heal=0.359 ; #main
kokomi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.5952 er=0.2204 em=39.64 cr=0.0662 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
#FD > Pipe >= Harbinger
furina add weapon="pipe" refine=5 lvl=90/90;
furina add set="gt" count=4;							
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

xingqiu char lvl=90/90 cons=6 talent=9,9,9; 
xingqiu add weapon="finale" refine=5 lvl=90/90;
xingqiu add set="eosf" count=4;										
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311 ; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2317 cd=0.662;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
#Iron Sting and burst when possible has very slightly higher simulated DPS than Fav r3
#Xiphos r1 is around 1k higher if available
kazuha add weapon="ironsting" refine=5 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5456 er=0.4959 em=118.92 cr=0.0662 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=10000000 radius=1 pos=0,2;
energy every interval=480,720 amount=1;

active kokomi;

let odd = true;
for let i = 0; i < 5; i = i + 1 {
  if (!i) {
    kokomi attack;
  }
  kazuha skill, high_plunge;
  furina burst, skill;
  xingqiu skill, dash, burst, attack;
  kokomi skill, attack:2, dash, attack:2;
  if(odd) {
    kazuha burst;
  } else {
    kazuha skill, high_plunge;
  }
  odd = !odd;
  kokomi attack,burst,
    attack:2, dash,
    attack:2, dash,
    attack:2, walk,
    attack:2, dash,
    attack:2, dash,
    attack:2, walk,
    attack:2, dash,
    attack:2, dash,
    attack:2, walk,
    attack:2, dash,
    attack:2, dash,
    attack:2;
}

