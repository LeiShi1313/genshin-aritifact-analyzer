# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=3.4,0 hp=100000000; # 2T

# Beidou 20% Perfect Counter, 10% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.80 {
    counter = 2;
  } else if counter > 0.7 && counter <= 0.80 {
    counter = 1;
  } 
  else {
    counter = 0;
  }
  
  return counter;
}

#Rotation
active beidou; # SS Stacks

for let i=0; i<4; i=i+1 {
  xingqiu skill, dash, burst, attack;
  
  beidou skill[counter=rand_counter()], attack, burst;
  
  alhaitham attack, burst;
  
  kuki attack, skill;
  
  alhaitham attack:3, dash,
            attack:3, dash,
            attack:2, skill,
            attack:3, dash,
            attack:3,dash,
            attack, charge,
            attack:3, dash,
            attack:3, charge;
}
