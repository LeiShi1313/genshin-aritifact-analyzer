# Ganyu Emilie Mavuika Bennett. ~18s rot. Ganyu Melt. 6 aimed 100% weakspot hits. -4K DPS with Chainbreaker and no weakspot hits. Ganyu uses burst if available. Mauvika uses burst if available and funnels partices to Bennett.

ganyu char lvl=90/90 cons=0 talent=9,9,9; 
ganyu add weapon="prototypecrescent" refine=5 lvl=90/90; # weakspot hit
#ganyu add weapon="chainbreaker" refine=5 lvl=90/90;
#ganyu add weapon="hamayumi" refine=5 lvl=90/90;
ganyu add set="ur" count=5;
ganyu add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311; 
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=5;        
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=0];
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.2648 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=50000000; 
energy every interval=480,720 amount=1;

active ganyu;
for let i=0; i<6; i=i+1 {
  if .ganyu.burst.ready {
    ganyu skill, burst;
  } else {
    ganyu skill;
  }
  
  if i > 1 && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  
  if .mavuika.burst.ready {
    mavuika burst, skill;
  } else {
    mavuika skill, attack;
  }
  
  bennett burst, skill;
  
  if .ganyu.weapon == .keys.weapon.crescent {
    ganyu aim[weakspot=1];
    ganyu aim[weakspot=1]:5;
  } else {
    ganyu aim[weakspot=0]:6;
  }
}
