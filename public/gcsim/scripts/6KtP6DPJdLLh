# Columbina Albedo Zhongli Chiori. ~20s Rot. On field Columbina Lunar Crystallize. Columbina takes the field to drive Lunar Crystallize with Zhongli's Pillar resonances. Zhongli doesn't burst, Chiori bursts when Columbina and Albedo do not.

# Team - Options Listed by DPS
columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="widsith" refine=3 lvl=90/90;
#columbina add weapon="dawningfrost" refine=1 lvl=90/90;
columbina add set="notsu" count=4;
columbina add stats hp=4780 atk=311 em=187 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

albedo char lvl=90/90 cons=0 talent=9,9,9;
albedo add weapon="cinnabar" refine=5 lvl=90/90;
albedo add set="gt" count=4;
#albedo add set="husk" count=4 +params=[stacks=4];
albedo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
albedo add stats def%=0.062*4 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="deathmatch" refine=1 lvl=90/90;
zhongli add set="sms" count=4;
zhongli add stats hp=4780 atk=311 em=187 geo%=0.466 cd=0.622; #main
zhongli add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbinger" refine=5 lvl=90/90;
chiori add set="gt" count=4;
#chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; # main
chiori add stats def%=0.062*4 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active zhongli;

for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash;

  columbina skill;
  if is_even(i) {
    columbina burst;

    albedo skill, burst;

    chiori skill:2;
  } else {
    albedo skill, attack;

    chiori burst:1, skill:2;
  }

  columbina attack:3, dash;
  columbina attack:3, dash;
  columbina attack:3, dash;
  columbina attack:3, dash;
  columbina attack:3, dash;
  columbina attack:3, dash;
  columbina attack:1;
}
