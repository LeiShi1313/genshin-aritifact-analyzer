# Tighnari Furina Raiden Yaoyao. ~25s Rot. Tighari Quickbloom with Yaoyao. Tighnari does ECQ2C twice per rot before and after Full EM Raiden, who on-fields to generate energy for the team. Yaoyao does QN3DN3E every rotation to ensure adequate healing and Dendro coverage.

# Team
tighnari char lvl=90/90 cons=0 talent=9,9,9;
tighnari add weapon="ode" refine=5 lvl=90/90;
#tighnari add weapon="chainbreaker" refine=5 lvl=90/90;
#tighnari add weapon="songofstillness" refine=5 lvl=90/90;
tighnari add set="mh" count=4;
tighnari add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
tighnari add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="favlance" refine=3 lvl=90/90;
raiden add set="fopl" count=4;
raiden add stats hp=4780 atk=311 em=187 em=187 em=187; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.3972 cd=0.2648;

yaoyao char lvl=90/90 cons=6 talent=9,9,9;
yaoyao add weapon="favlance" refine=3 lvl=90/90;
yaoyao add set="deepwood" count=4;
yaoyao add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
yaoyao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
	furina skill, dash, burst;

	yaoyao burst, attack:3, dash, attack:3, skill;

	tighnari skill, aim, burst, aim:2;

	raiden burst, attack:4, skill, attack:4, dash, attack:4;

	tighnari skill, aim, burst, aim:2;
}
