# Hutao Furina Yelan Xianyun. ~20s Rot. Hutao Plunge with 1E Yelan. 6N1CJlP edges out 5N2CJhP, see config. 50% collisions.

# Team
hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="fjords" refine=1 lvl=90/90;
hutao add set="mh" count=4;
#hutao add set="longnightsoath" count=4;
hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.2648 cd=0.662; # MH
#hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
#hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # LNO

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=148.86 atk%=0.3968 er=0.4959 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

let hutao_6N1CJlP = true; # Better vape consistency in later rotations

# Active
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;

  yelan skill;
  if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  xianyun skill, low_plunge, attack, burst;

  if hutao_6N1CJlP {
    hutao attack, skill;
    for let p = 6; p > 0; p = p - 1 {
      hutao attack, charge, jump;
      if .airborne {
        hutao low_plunge[collision=rand()>0.5];
      }
    }
    hutao attack;

    xianyun attack:3;
  } else {
    hutao skill;
    for let j=0; j<5; j=j+1 {
      hutao attack:2, charge, jump;
      if .airborne {
        hutao high_plunge[collision=rand()>0.5];
      }
    }
    hutao attack:2, charge, dash; # Last N1 is Phys

    xianyun attack:2; wait(10); # For sim warning
  }
}
