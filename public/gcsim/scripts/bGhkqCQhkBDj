options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active nahida;

for let i=0; i<6; i=i+1 {
  nahida skill, burst;
  bennett skill, burst;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  clorinde_combo();
  if ( i / 2 ) * 2 == i {
    clorinde burst;
  }
  bennett skill, attack:2; #catch his particles during on-field

}
