mona add stats hp=4780 atk=311 er=0.518 em=187 cr=0.311 ; #main
mona add stats cr=.248 cd=.241 er=.733 hp%=.193 hp=1016 def%=.241 def=77 atk%=.111;

fischl char lvl=90/90 cons=6 talent=9,10,10;
fischl add weapon="skywardharp" refine=1 lvl=90/90;
fischl add set="tenacityofthemillelith" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
fischl add stats cr=0.493 cd=0.685 er=0.227 atk=19 hp%=.221 hp=448 def%=.19 def=21 em=16;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=9999999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active mona;

for let i = 0; i < 6; i = i + 1 {

  yelan skill, burst;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  mona burst,skill, attack:1;
  hutao skill,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:1, charge, jump,
  attack:1, charge, dash;
}
