# Bennett Nahida Emilie Xingqiu. ~21s Rot. Double Dendro Bennett Burgeon. Nahida does not burst, while Emilie builds a bit of ER to burst every rotation after the first. 

# Team
bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="umbrella" refine=5 lvl=90/90;
#bennett add weapon="ironsting" refine=5 lvl=90/90;
#bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="fopl" count=4;
#bennett add set="gd" count=4;
#bennett add set="cw" count=4;
bennett add stats hp=4780 atk=311 em=187 em=187 em=187; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # 3EM
#bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # EDC

nahida char lvl=90/90 cons=0 talent=9,9,9; 
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=59.46 cr=0.3641 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.2755 em=39.64 cr=0.3972 cd=0.5296;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="eosf" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

#Rotation
active xingqiu;

for let i = 0; i < 4; i = i + 1 {
  xingqiu skill, dash, burst, attack;
  
  nahida skill, attack:2;
  
  if i > 0 {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  
  bennett skill, attack, burst;
  while .xingqiu.mods.xingqiuburst {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
}
