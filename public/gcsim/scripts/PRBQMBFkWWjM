fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

# Max Declension Guarantee
fn declensionCombo() {
  switch {
    case .heizou.normal > 1 && .heizou.skill.ready && .heizou.declension == 4:
      heizou skill;
    case .heizou.normal > 1 && .heizou.burst.ready:
      heizou burst;
    case .heizou.normal > 1:
      heizou charge;
    default:
      heizou attack;
  }
}

#Rotation
active yelan;

for let i=0; i<4; i=i+1 {
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  ororon skill, attack, burst;  
  
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  
  while .fischl.oz {
    declensionCombo();
  }

  print("done");
}

