#heizou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2648 cd=0.7282; # Talents

yelan char lvl=90/90 cons=0 talent=9,9,9;
