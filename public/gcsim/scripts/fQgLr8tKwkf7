#"AFK" Archons Hyperbloom team, with random actions. TTK 12-3 Icewind Suite stats.

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="dragonsbane" refine=3 lvl=90/90;
raiden add set="fopl" count=4;
raiden add stats hp=4780 atk=311 em=186.5 em=186.5 em=186.5;
raiden add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 er=0.1101 em=118.89 cr=0.3966 cd=0.5284;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats hp=507.88 hp%=0.1982 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 er=0.1101 em=39.63 cr=0.3305 cd=0.7926;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="totm" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
zhongli add stats hp=507.88 hp%=0.2973 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 er=0.1101 em=39.63 cr=0.3966 cd=0.5284;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="pamber" refine=5 lvl=90/90;
nahida add set="deepwoodmemories" count=4;
nahida add stats hp=4780 atk=311 em=186.5 dendro%=0.466 cr=0.311;
nahida add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 er=0.1101 em=39.63 cr=0.3305 cd=0.7926;

options swap_delay=12 iteration=1000;
target lvl=100 type=icewindsuite radius=1 pos=0,1.5;

active raiden;

while true {
  let a = rand() * 4;
  switch {
    case a < 1:
      print("raiden");
      if .raiden.skill.ready {
        raiden skill;
      }
      if .raiden.burst.ready {
        raiden burst;
      }
      raiden attack;

    case a < 2:
      print("furina");
      if .furina.skill.ready {
        furina skill;
      }
      if .furina.burst.ready {
        furina burst;
      }
      furina attack;

    case a < 3:
      print("zhongli");
      if .zhongli.skill.ready {
        let z = rand();
        if z < 0.25 {
          zhongli skill;
        } else if z < 0.5 {
          zhongli skill[hold=1];
        } else if z < 0.75 {
          zhongli skill[hold_nostele=1];
        } #leaves a 25% chance to do nothing (closest u can get to tap without pillar)
      }
      if .zhongli.burst.ready {
        zhongli burst;
      }
      zhongli attack;

    case a < 4:
      print("nahida");
      if .nahida.skill.ready {
        nahida skill;
      }
      if .nahida.burst.ready {
        nahida burst;
      }
      nahida attack;
  }

  wait(rand()*30+30);
}
