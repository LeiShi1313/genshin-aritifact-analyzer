#team config

chiori char lvl=90/90 cons=6 talent=9,9,9;
chiori add weapon="uraku" refine=5 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; # main
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3310 cd=0.7944;

zhongli char lvl=90/90 cons=6 talent=9,9,9;
zhongli add weapon="favlance" refine=5 lvl=90/90;
zhongli add set="tenacity" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; # main
zhongli add stats def%=0.124 def=39.36 hp=2031.52 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.1324;

shenhe char lvl=90/90 cons=6 talent=9,9,9;
shenhe add weapon="calamity" refine=5 lvl=90/90;
shenhe add set="glad" count=2;shenhe add set="emblem" count=2;
shenhe add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; # main
shenhe add stats atk=165.4 atk%=0.3968 hp=507.88 hp%=0.0992 cr=0.0662 cd=0.1324 em=39.64 er=0.4408 def=39.36 def%=0.124;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon= "favoniusgreatsword" refine=5 lvl=90/90;
chongyun add set= "no"count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; # main
chongyun add stats atk=33.08 atk%=0.0992 hp=507.88 hp%=0.0992 cr=0.331 cd=0.3972 em=39.64 er=0.551 def=39.36 def%=0.124;



#enemy config

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=99999999;
energy every interval=480,720 amount=1;

active chiori;
chiori skill:2;

#action list
for let x=0; x<4; x=x+1 {
  zhongli attack,skill[hold=1],dash;
  if !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  if x == 0 || x == 2 {
      shenhe skill;
  }
  shenhe skill[hold=1], burst;

  chongyun attack,burst;
  if !.chongyun.mods.favonius-cd {
    chongyun attack;
  }
  chongyun skill;

  if .chiori.burst.ready && .chiori.energy == .chiori.energymax {
    chiori burst;
  }
  chiori skill, attack;
  chiori attack:3, dash, attack:3, dash;
  chiori skill, attack;
  chiori attack:3, dash, attack:3, dash;

  chiori skill:2;
}
