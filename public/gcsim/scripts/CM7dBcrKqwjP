# Raiden Furina Fischl Baizhu. ~20s Rot. On-field Raiden Hyperbloom with Baizhu. Fischl uses burst every rotation and skill if available.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="fjords" refine=1 lvl=90/90;
raiden add set="gd" count=4;
#raiden add set="mh" count=4;
raiden add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.3972 cd=0.2648;
#raiden add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.2317 cd=0.5958;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #mainstats
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="ttds" refine=5 lvl=90/90;
baizhu add set="deepwood" count=4;
#baizhu add set="ohc" count=4;
#baizhu add set="scroll" count=4;
#baizhu add set="sodp" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2979 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=100;

# Targets - Fischl Hyperbloom Ownership varies with size
target lvl=100 resist=0.1 radius=3 pos=0,3.3 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    baizhu attack:3, dash, attack:2;
  }

  furina skill, dash, burst;

  baizhu skill, attack, burst;

  fischl attack:2, burst;

  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
}
