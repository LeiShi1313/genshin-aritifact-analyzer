options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active mavuika;
for let i=0; i<4; i=i+1 {
  mavuika skill;
  bennett  burst;
  xilonen skill, attack:2;
  escoffier skill, dash; pick_up_crystallize("pyro");
  escoffier burst;
  mavuika burst;
  delay(62); # wait for cryo app
  mavuika charge:3, charge[hold=6], charge[final=1], dash;
  mavuika charge:3, charge[hold=6], charge[final=1], dash;
  mavuika charge:1, charge[hold=6], charge[final=1];
  delay(20);
}
