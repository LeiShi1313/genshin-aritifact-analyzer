options swap_delay=12 iteration=1000;

# Build assumptions
hutao char lvl=90/90 cons=6 talent=10,10,10;
hutao add weapon="homa" refine=5 lvl=90/90;
hutao add set="mh" count=4;
hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311;
hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=6 talent=10,10,10;
yelan add weapon="aqua" refine=5 lvl=90/90;
yelan add set="emblemofseveredfate" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="key" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972;

citlali char lvl=90/90 cons=6 talent=10,10,10;
citlali add weapon="starcallerswatch" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, burst, attack:2;
  yelan burst, attack, skill, attack:2, skill, attack:2;
  citlali skill, attack;
  hutao skill,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,

        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2;
  if is_even(i) {
    hutao burst;
  } else {
    hutao charge, dash,
          attack:2, charge, dash;
  }
}
