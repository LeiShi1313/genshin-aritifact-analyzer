# Xilonen Gorou Yunjin Zhongli. ~18s Rot. Xilonen mono Geo. Chiori and Zhongli's burst are used to fill time in for CDs in subsequent rotations.

# Team - Options listed by DPS
xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="harbinger" refine=5 lvl=90/90;
xilonen add set="oc" count=4;
#xilonen add set="husk" count=4 +params=[stacks=4];
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mains
xilonen add stats def%=0.558 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2648 cd=0.5958; # OC HoD
#xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
#xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Husk HoD

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbinger" refine=5 lvl=90/90;
chiori add set="gt" count=4;
#chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #main
chiori add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="footprint" refine=5 lvl=90/90;
yunjin add set="husk" count=4;
yunjin add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583; #main
yunjin add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.2648 cd=0.1324;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="deathmatch" refine=1 lvl=90/90;
zhongli add set="ap" count=2;zhongli add set="glad" count=2;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.1655 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active zhongli;

for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash;
  if i > 0 && .zhongli.burst.ready && !.chiori.burst.ready {
    zhongli burst;
  }

  if .chiori.burst.ready {
    chiori burst;
  }
  chiori skill:2;

  yunjin skill[hold=0], burst;

  xilonen skill;
  while .xilonen.nightsoul.state{
    xilonen attack;
    if .xilonen.burst.ready {
      xilonen burst;
    }
  }
}
