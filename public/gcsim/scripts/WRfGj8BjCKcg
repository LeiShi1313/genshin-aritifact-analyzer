options swap_delay=12 iteration=1000;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="eshu" refine=5 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=3 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

charlotte char lvl=90/90 cons=6 talent=9,9,9; 
charlotte add weapon="ttds" refine=5 lvl=90/90;
charlotte add set="totm" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.551 em=39.64 cr=0.331 cd=0.1324;

dahlia char lvl=90/90 cons=6 talent=9,9,9;
dahlia add weapon="favsword" refine=3 lvl=90/90;
dahlia add set="no" count=4;
dahlia add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
dahlia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

let First_Rot_Nuke = true;  # Change this value between true and false.

active dahlia;

for let i=0; i<4; i=i+1 {
  dahlia attack:2, skill;
  if !.dahlia.mods.favonius-cd {
    dahlia attack;
  }
  yelan skill, attack, burst;
  dahlia attack, burst;
  if is_even(i) {
    charlotte attack, burst, skill, attack;
  } else {
    charlotte attack, skill, attack:3;
  }
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack, charge, dash,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack, charge, dash,
          
          attack:5, dash,
          attack:3;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack, charge, dash,
          
          attack:5, dash,
          attack:5, dash;
  }
}

# Skirk Q is First rot only
# Dahlia N2 E > Yelan E N1 Q > Dahlia N1 Q > Charlotte N1 Q E N1 > Skirk Q tE N1CD 3[N5D] N1CD N5D N3
# Dahlia N2 E > Yelan E N1 Q > Dahlia N1 Q > Charlotte N1   E N3 > Skirk   tE N2Q  3[N5D] N1CD 2[N5D]
