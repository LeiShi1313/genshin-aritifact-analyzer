mika add stats def%=0.256 def=39 hp=7947 hp%=1.0430000000000001 atk=338 er=0.41500000000000004 em=21 cr=0.311 cd=0.358 heal=0.359;

target lvl=100 resist=0.1 hp=9999999;
energy every interval=480,720 amount=1;

#sim config
options swap_delay=4 debug=true iteration=1000 workers=30 mode=sl;
active xq;

for let i=0; i<4; i=i+1 {

xq skill, dash, burst, attack;
  mika skill, attack, burst;
   if .amy.skill.ready { 
    amy skill, attack; 
  } else { 
    amy attack:2, burst; 
  }
  freminet skill, burst,
           attack:2, skill, skill,
           attack:2, skill, attack:2, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
           attack:2, skill, attack:2, skill,
           attack:3, skill, attack;
           
  
}

