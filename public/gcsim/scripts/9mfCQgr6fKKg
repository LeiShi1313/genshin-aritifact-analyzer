# Sethos Fischl Xiangling Chevreuse. ~15s Rot. Sethos consistently triggers Overload with his skill for an ER refund. Full EM Xiangling bursts every other rotation. Fischl alternates skill and burst. 

# Team
sethos char lvl=90/90 cons=6 talent=9,9,9;
sethos add weapon="slingshot" refine=5 lvl=90/90;
sethos add set="wt" count=4;
sethos add stats hp=4780 atk=311 em=187 em=187 cd=0.622;
sethos add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=158.56 cr=0.3641 cd=0.3972;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="scroll" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

fischl char lvl=90/90 cons=6 talent=9,9,9; 
fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; 
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9; 
xiangling add weapon="kitain" refine=5 lvl=90/90;
xiangling add set="scroll" count=4;
#xiangling add set="gd" count=5;
xiangling add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=118.92 cr=0.3972 cd=0.331;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
#target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000;

# Rotation
active fischl;
fischl burst;

for let i = 0; i < 5; i = i + 1 {
  chevreuse burst, skill[hold=1]:2;
  
  # xiangling burst every other rotation
  if .xl.burst.ready { 
    xl burst, skill, dash;
  } else {
    xl attack:2, skill, dash;
  }
  
  # fischl burst every other rotation
  if .fischl.skill.ready {
    fischl attack, skill;
  } else if i {
    fischl attack:2, burst;
  }
  
  sethos skill, attack:2;
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack; // Last N1 is phys
  sethos aim[hold=2];
}

