#team config

neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="tomeoftheeternalflow" refine=1 lvl=90/90;
neuvillette add set="marechausseehunter" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
neuvillette add stats def=39.36 def%=0.124 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1655 cd=0.7282;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="goldentroupe" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #mainstats
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphosmoonlight" refine=1 lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kazuha add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.2979 cd=0.1986;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favoniuslance" refine=3 lvl=90/90;
rosaria add set="emblemofseveredfate" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #mainstats
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

#enemy config

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
active neuvillette;

#action list

for let i=0; i<4; i=i+1 {

    neuvillette skill;
    furina skill;
    kazuha skill, high_plunge, burst;
    rosaria skill, burst;

    while !.rosaria.mods.favonius-cd {
      rosaria attack;
    }

    furina burst;

    neuvillette charge, skill, charge, burst;
    kazuha skill, high_plunge;
    neuvillette charge, charge;

}

wait(173); #for the last CA
