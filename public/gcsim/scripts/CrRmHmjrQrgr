# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

# Clorinde Combo
fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

# Beidou 20% Perfect Counter, 10% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.80 {
    counter = 2;
  } else if counter > 0.7 && counter <= 0.80 {
    counter = 1;
  }
  else {
    counter = 0;
  }

  return counter;
}

#Rotation
active beidou; # SS Stacks

for let i=0; i<4; i=i+1 {
  fischl skill, attack;

  nahida skill;
  if i > 0 && .nahida.burst.ready {
    nahida burst;
  } else {
    nahida attack, charge;
  }

  beidou skill[counter=rand_counter()], burst;

  clorinde_combo();

  fischl attack:2, burst;

  beidou skill[counter=rand_counter()], attack;

  clorinde_combo();
  clorinde burst; # can be ommited
}
