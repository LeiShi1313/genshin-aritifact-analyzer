# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=1 pos=0,3.5 hp=100000000; # Rear

# Combos
fn sethosCombo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, skill;
}

# Rotation
#active nahida;

active emilie;
emilie skill;

for let i=0; i<4; i=i+1 {
  # Burst in 2nd Rot onward
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else if .emilie.skill.ready {
    emilie skill, attack;
  }
  
  if .mav.burst.ready && i > 0 {
    mav burst, skill;
    if i > 1 { # Fill time for sethos skill CD
      mav charge:1, dash;
    }
  } else {
    mav skill, attack;
  }
  
  kuki skill, attack;
  if .kuki.burst.ready && i > 0 {
    kuki burst;
  }
  
  sethos skill; #aim[hold=2] # High ping only; dodges energy drain
  sethosCombo();
  sethos aim[hold=2]:1;
}
