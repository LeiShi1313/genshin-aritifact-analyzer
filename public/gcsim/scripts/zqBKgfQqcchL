options iteration=1000 swap_delay=12;

# Build assumptions
ganyu char lvl=90/90 cons=1 talent=9,9,9;
ganyu add weapon="astralvulturescrimsonplumage" refine=1 lvl=90/90;
ganyu add set="ur" count=4;
ganyu add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311; # main
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="prototypeamber" refine=5 lvl=90/90;
nahida add set="gd" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; # main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.1986 cd=0.3972;

dehya char lvl=90/90 cons=0 talent=9,9,9;
dehya add weapon="favgs" refine=3 lvl=90/90;
dehya add set="totm" count=4;
dehya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; # main
dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; # main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # single target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active nahida;

for let i = 0; i < 4; i = i + 1 {
  nahida skill, attack:2, burst;
  bennett skill, burst;
  dehya attack, skill;
  while !.dehya.mods.favonius-cd {
    dehya attack;
  }
  ganyu aim:6;
  if is_even(i) {
    ganyu skill, burst;
  }
  else {
    ganyu aim, skill;
  }
}

# Nahida E Q > Bennett E Q > Dehya E > Ganyu CAx6 (E Q or CA E)

