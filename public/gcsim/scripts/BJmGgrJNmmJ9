# Gaming Chevreuse Fischl Mavuika. ~17s Rot. Gaming Overload. Gaming does 7 skill plunges, waitinng on the ground before juggling Man Chai in the air. Fischl does an aimed shot in the first rotation for Chevreuse A1 RES shred. Chevreuse bursts every other rotation.

# Team - Options listed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9; 
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="vh" count=4;
#gaming add set="mh" count=4;
#gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Other
#gaming add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
#gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # MH

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
#chevreuse add set="scroll" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.4634;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="stillness" refine=5 lvl=90/90;
#fischl add weapon="stringless" refine=1 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="tidalshadow" refine=5 lvl=90/90;
#mav add weapon="earthshaker" refine=5 lvl=90/90;
#mav add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=0];
mav add set="scroll" count=4;
#mav add set="oc" count=4;
mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Scroll
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # OC

# Options
options iteration=1000; 
options swap_delay=12; # Standard
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # ST

# Rotation
active gaming; # SS Stacks

fischl aim; # 1st Rot Snapshot

for let i=0; i<4; i=i+1 {
  if .chev.burst.ready && .chev.energy == .chev.energymax {
    chev burst, skill[hold=1]:1;
  } else {
    chev skill[hold=1], attack;
  }
  
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }

  if .mav.burst.ready {
    mav burst, skill, dash:1;
  } else {
    mav attack, skill;
  }

  gaming burst, attack:2,
         skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
  gaming skill, low_plunge;
  gaming skill, low_plunge;
}

