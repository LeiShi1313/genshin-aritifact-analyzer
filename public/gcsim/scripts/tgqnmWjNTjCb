target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

energy every interval=480,720 amount=1;

active gaming;

for let i = 0; i < 3; i = i + 1 {

  if i {
    gaming dash;
  }
  
  furina skill, dash, burst;

  bennett burst, attack;

  xilonen skill, attack:2;
  
  #bennett skill, dash; pick_up_crystallize("pyro");
  
  gaming burst;
  
  gaming skill;
  sleep(42);
  gaming high_plunge;  
  
  for let j = 0; j < 7; j = j + 1 {

    gaming skill;
    sleep(17);
    gaming high_plunge;

  }
  gaming skill, high_plunge;
  
}
