chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.331;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;


let MAX_NA_COUNT = 18;

active mavuika;

fn clorinde_combo() {
  clorinde skill;
  let na_count = 0;
  while .clorinde.status.clorinde-night-watch && na_count < MAX_NA_COUNT {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
      na_count = na_count + 1;
    }
  }
}

for let i = 0; i < 4; i = i + 1 {

  if i {
    mavuika attack;
  }
  mavuika skill;
  ororon skill, burst;
  chev burst, skill[hold=1];
  mavuika burst, charge:2, dash, charge:2, dash,charge:2, dash, charge:2, dash;
  clorinde_combo();
}
