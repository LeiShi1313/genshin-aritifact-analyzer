# Noelle Nahida Yelan Furina. ~21s Rotation. AP Noelle dashes between NA strings to pick up Crystallize. Hydro application and healing enables pure Bloom Nahida. Deepwood/Husk Noelle is a DPS loss.

# See comments for option notes
noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="favoniusgreatsword" refine=3 lvl=90/90;
#noelle add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5]; #/w Fav Nahida && Yelan
noelle add set="ap" count=4;
#noelle add set="husk" count=4;
#noelle add set="mh" count=4;
#noelle add set="deepwood" count=4; # DPS loss, even without DW Nahida
noelle add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
noelle add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.640 cr=0.331 cd=0.7944; # Fav Noelle
#noelle add stats hp=4780 atk=311 def%=0.583 def%=0.583 cd=0.622;
#noelle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.640 cr=0.3310 cd=0.4634; # SS Noelle

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="sacfrags" refine=3 lvl=90/90;
#nahida add weapon="evenstar" refine=1 lvl=90/90;
#nahida add weapon="magicguide" refine=5 lvl=90/90;
#nahida add weapon="favcodex" refine=3 lvl=90/90; # /w SS Noelle || Slingshot Yelan
nahida add set="deepwood" count=4;
#nahida add set="gd" count=4;
#nahida add set="fopl" count=4;
nahida add stats hp=4780 atk=311 em=186.5 em=186.5 em=186.5; #main
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=118.92 cr=0.332 cd=0.5296;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=3 lvl=90/90;
#yelan add weapon="slingshot" refine=3 lvl=90/90; # /w Fav Nahida && Fav Noelle
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.2204 em=39.640 cr=0.3310 cd=0.6620;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.640 cr=0.3972 cd=0.6620;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active nahida;

for let x=0; x<4; x=x+1 {
  if x==0 {
    nahida skill, burst;
  } else {
    nahida skill, attack;
    if .nahida.burst.ready {
      nahida burst;
    }
  }

  furina skill, dash, burst;

  yelan burst, attack, skill, attack;

  # Noelle burst opening
  noelle skill, attack, burst;
  pick_up_crystallize("hydro");
  # Noelle driving rotation
  while !.yelan.skill.ready {
    if .noelle.normal > 3 {
      if .yelan.mods.archaic-4pc {
        noelle dash;
        pick_up_crystallize("hydro");
      } else {
        noelle dash;
      }
    } else {
      noelle attack;
    }
  }

  # Essential 2nd Yelan E
  yelan skill, attack;

  # Cover cooldowns; increase rot DMG
  noelle attack:4;
  pick_up_crystallize("hydro");

  # Notation
  # Nahida EN1Q > Furina EDQ > Yelan QN1EN1 >
  # Noelle EN1Q 2N3D N3 > Yelan EN1 > Noelle N4D
}
