chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.1324 ;

yanfei char lvl=90/90 cons=6 talent=9,9,9;
yanfei add weapon="ttds" refine=5 lvl=90/90;
yanfei add set="noblesse" count=4;
yanfei add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466 ; #main
yanfei add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2648 cd=0.1324;
                                                                                                                                                                        
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active yae;
for let i=0; i<4; i=i+1 {

  if i==0 || i==2 {
    yae skill:3;
    chevreuse burst, skill[hold=1], attack;
    yanfei skill, attack, burst, attack;
    yae burst, skill:3;
  } else {
    yae skill:3;
    chevreuse burst, skill[hold=1]:3;
    yanfei skill, attack, burst, attack;
  }
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if i==0 || i==2 {
    yae attack:2, charge, dash;
  } else {
    yoimiya burst, attack;
    yae attack:2, charge, dash;
  }
}
