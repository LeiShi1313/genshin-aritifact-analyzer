#Kuki / Mika / Yun Jin / Furina - Physical Kuki - ~22sec Rotation

#Team & Build(s)
kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="uraku" refine=1 lvl=90/90;
kuki add set="mh" count=4;
kuki add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=5 lvl=90/90;
mika add set="clam" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="footprint" refine=5 lvl=90/90;
yunjin add set="husk" count=4;
yunjin add stats hp=4780 atk=311 er=0.518 def%=0.583 def%=0.583; #main
yunjin add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2648 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=5 lvl=90/90;
furina add set="gt" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

active furina;

#Rotation
for let i=0; i<4; i=i+1 {
  furina skill, attack:2, burst;
  mika burst;
  yunjin skill, burst;
  mika skill[hold=1], attack;
  if .kuki.burst.ready {
    kuki burst;
  }
  kuki skill,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:2;
}

#Furina E N2Q > Mika Q > Yun Jin EQ > Mika hE N1 > Kuki E ~8[N3D] N2
