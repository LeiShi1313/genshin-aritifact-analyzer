# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000; # L
target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000; # R

# Lanyan Q for Grouping, then Lanyan E off CD with N1 weaving; Sac & Con Compatible
fn lanyanDrivingCombo() {
  switch {
    case .lanyan.normal > 1 && .lanyan.burst.ready && .lanyan.energy == .lanyan.energymax:
      lanyan burst;
    case .lanyan.normal > 1 && .lanyan.skill.ready:
      set_player_pos(0, 0); # toward
      lanyan skill; set_player_pos(0, -3); # away
      lanyan skill;
    case .lanyan.normal > 1 && .previous-action == .action.skill && .stam > 18:
      lanyan dash; set_player_pos(0, 0); # toward
    case .lanyan.normal > 2 && .stam > 18:
      lanyan dash; set_player_pos(0, 0); # toward
    default:
      lanyan attack;
  }
}

# Beidou 20% Perfect Counter, 10% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.80 {
    counter = 2;
  } else if counter > 0.7 && counter <= 0.80 {
    counter = 1;
  }
  else {
    counter = 0;
  }

  return counter;
}

# Rotation
active beidou; # SS Stacks

for let i=0; i<4; i=i+1 {
  fischl attack, skill;

  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }

  beidou skill[counter=rand_counter()], burst;

  while .fischl.oz {
    lanyanDrivingCombo();
  }

  fischl attack:2, burst;

  nahida skill, attack, charge;

  beidou skill[counter=rand_counter()], attack;

  while .fischl.skill.cd > 30 {
    lanyanDrivingCombo();
  }

}
