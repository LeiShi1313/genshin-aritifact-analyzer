options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active navia; # SS Stacks

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  yelan burst, attack, skill, attack;
  gorou burst, attack, skill, attack;
  if !i { 
    navia skill, attack; 
  }
  navia burst, skill, attack:3, dash, attack:2;
  yelan attack, skill, attack;
  gorou skill, attack;
  navia skill, attack:2, dash, attack:2;
  if .navia.skill.ready {
    navia skill;
  }
}