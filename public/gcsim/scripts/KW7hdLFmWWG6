options swap_delay=12 iteration=1000;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="eshu" refine=5 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
//skirk add set="mh" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;
// skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
// skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

candace char lvl=90/90 cons=6 talent=9,9,9;
candace add weapon="favlance" refine=3 lvl=90/90;
candace add set="scroll" count=4;
candace add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
candace add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.331 cd=0.2648;

rosaria char lvl=90/90 cons=6 talent=9,9,9; 
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="eosf" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

dahlia char lvl=90/90 cons=6 talent=9,9,9;
dahlia add weapon="favsword" refine=3 lvl=90/90;
dahlia add set="no" count=4;
dahlia add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
dahlia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.331 cd=0.2648;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

let First_Rot_Nuke = true;  # Change this value between true and false.

active dahlia;

for let i=0; i<4; i=i+1 {
  dahlia skill, attack:2;
  candace skill, attack, burst; wait(2); # catch particles on-field
  rosaria skill, burst;
  dahlia attack, burst;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5, dash,
          attack:2;
  } else {
    skirk skill,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:2;
  }
  delay(16);    # just waiting cd
}

# First rot only
# Dahlia E N2 > Candace E N1 Q > Rosaria EQ > Dahlia N1 Q > Skirk Q tE 2[N5D] N2CD 2[N5D] N2
# Dahlia E N2 > Candace E N1 Q > Rosaria EQ > Dahlia N1 Q > Skirk   tE 2[N5D] N2Q  2[N5D] N2