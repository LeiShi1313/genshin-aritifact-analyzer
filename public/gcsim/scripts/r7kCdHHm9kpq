options iteration=1000 swap_delay=12;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacfrag" refine=3 lvl=90/90;
sucrose add set="viridescentvenerer" count=5;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187; # main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="kitaincrossspear" refine=5 lvl=90/90;
xiangling add set="cwof" count=5;
xiangling add stats hp=4780 atk=311 em=187 em=187 em=187; # main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.4408 em=118.92 cr=0.0662 cd=0.1324;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favoniussword" refine=3 lvl=90/90;
xingqiu add set="noblesse" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;


active fischl;

target lvl=100 resist=0.1 hp=1000000000 radius=2 pos=0,2.4;
//target lvl=100 resist=0.1 hp=1000000000 radius=1 pos=-2,0;
//target lvl=100 resist=0.1 hp=1000000000 radius=1 pos=2,0;
energy every interval=480,720 amount=1;


for let i = 0; i < 4; i = i + 1 {
  fischl attack, skill;
  xingqiu skill, burst, attack;
  xiangling attack, burst, skill, attack;
  sucrose attack, skill, walk;
  sucrose attack:2;
  if .sucrose.skill.ready {
    sucrose skill, walk;
  } else {
    sucrose charge;
  }
  sucrose attack:2, walk, attack:2, walk, attack:2;
  fischl attack:2, burst;
  xingqiu attack:3;
  sucrose attack:2, walk, attack:2, charge;
  xiangling attack:2, skill, dash;
  sucrose attack;
  if.sucrose.burst.ready && .sucrose.energy == .sucrose.energymax {
    sucrose burst;
  } else {
    sucrose attack, charge;
  }
  sucrose attack:2, walk, attack:2;
  if .sucrose.skill.ready {
    sucrose skill, walk;
  } else {
    sucrose attack, charge;
  }
  sucrose attack:2, walk, attack:2, walk, attack:3, charge;

}
