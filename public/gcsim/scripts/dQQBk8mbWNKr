# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets - Hyperbloom Ownership varies with size
target lvl=100 resist=0.1 radius=2.6 pos=0,3.0 hp=100000000; # Fischl triggers minimal HB - Realistic
#target lvl=100 resist=0.1 radius=2.2 pos=0,2.5 hp=100000000; # Fischl triggers some HB

# Rotation
active razor; # SS Stacks
#razor skill, dash;

for let i=0; i<4; i=i+1 {
  amy skill, attack;

  furina skill, dash, attack, burst;

  baizhu skill, attack, burst;

  amy attack:2, burst;

  razor skill, dash, attack, burst;
  razor attack:1, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:1;
}
