# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  fischl skill, attack;
  xl burst, skill, dash;
  mizuki skill, burst;
  while .mizuki.status.dreamdrifter-state > 150 {
    wait(1);
  }
  fischl attack:2, burst;
  mizuki attack, charge, attack, charge;
  xl attack:2, skill, dash, attack;
  mizuki attack:9;

}

