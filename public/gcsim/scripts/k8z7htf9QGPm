#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ATK/ATK
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2979 cd=0.662; # MH

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwoodmemories" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.2317 cd=0.4634;

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="aquamarine" refine=1 lvl=90/90;
dori add set="fopl" count=4;
dori add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active razor; #SS Stacks

for let i=0; i<3; i=i+1 { 
  furina skill, dash;
  razor skill, dash;
  dori skill, burst, attack;
  nahida skill, burst; # Any Order
  furina burst, attack;
  
  razor skill, dash, attack, burst;
  while .razor.mods.razor-q > 170 {
    if .razor.normal > 3 && .razor.skill.ready {
        razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
  print("done");
}

