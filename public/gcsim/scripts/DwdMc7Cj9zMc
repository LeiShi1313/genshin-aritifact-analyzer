#xiangling add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.6612 em=118.92 cr=0.0662 cd=0.1324; # Catch

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

for let i = 0; i < 4; i = i + 1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae skill, attack, skill, attack, skill;
  }

  # Nahida here is better for quicken uptime.
  nahida skill, attack, burst;

  fischl attack, skill;

  xl burst, skill, dash;

  yae attack:1, charge, dash;
  yae attack:1, charge, dash;
  yae attack:1, charge, dash;
  yae burst, attack, skill:3; # You really need to regen stamina here

  fischl attack:2, burst;

  yae attack:2, charge, jump;

  xl skill; # No Dash cancel for stamina

  yae attack:2, charge, jump;
  yae attack:2, charge, jump;
}
