# Sayu Nahida Yae Fischl. ~25s Rot. Sayu Aggravate with a max duration roll with Fav. Yae bursts every rotation. 

# Team - Options listed by DPS
sayu char lvl=90/90 cons=6 talent=9,9,9;
sayu add weapon="favgs" refine=3 lvl=90/90;
#sayu add weapon="aquamarine" refine=1 lvl=90/90;
sayu add set="vv" count=4;
sayu add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
sayu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # EDC
