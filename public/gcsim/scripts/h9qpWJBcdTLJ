# Raiden Durin Fischl Baizhu. ~20s Rot. Raiden Quickburn. Fischl uses burst every rotation and Baizhu fills time at the end of every rotation if Fischl skill isn't ready.

# Team - Options llisted by DPS
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="fjords" refine=1 lvl=90/90;
raiden add set="emblem" count=4;
#raiden add set="tom" count=4;
raiden add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # Emblem
#raiden add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#raiden add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # ToM

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="lionsroar" refine=3 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="hakushin" refine=5 lvl=90/90;
#baizhu add set="scroll" count=4;
baizhu add set="no" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
baizhu add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*12 cr=0.0331*2 cd=0.0662*4;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<4;i=i+1 {
  baizhu skill, burst;

  durin skill, burst, skill;

  fischl attack:2, burst;

  raiden burst,
         attack:4, skill,
         attack:4, dash,
         attack:4, dash,
         attack:4;

  while .baizhu.burst.cd > 40 {
    if .amy.skill.ready {
      amy attack, skill;
    }
    baizhu attack;
  }
}
