# Freminet Furina Fischl Mika. ~22s Rot. Physical Freminet with Superconduct. MH>=PF Freminet. ToM > GT Furina. OHC ~= NO > SodP Mika. Low ER reqs on everyone but Furina.

# Team - Options ordered by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="tidalshadow" refine=5 lvl=90/90; # MH
#freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
freminet add set="mh" count=4;
#freminet add set="pf" count=4; # SS
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # MH + TS/PF + SS
