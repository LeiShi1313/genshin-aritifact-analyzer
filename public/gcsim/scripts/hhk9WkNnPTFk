# --- Pre action hook setup ---

fn rand_delay(mean, stddev) {
  let del = randnorm() * stddev + mean;
  if del > (mean + mean) {
    del = mean + mean;
  }
  delay(del);
}

let prev_char_id = -1;
let prev_action_id = -1;
let _execute_action = execute_action;

fn execute_action(char_id number, action_id number, p map) {
  if prev_char_id != char_id && action_id != .action.swap {
    execute_action(char_id, .action.swap, []);
  }

  if action_id == .action.swap {
    # add delay before swap
    rand_delay(12, 3);
  }

  prev_char_id = char_id;
  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}

# This causes swap_delay to have a slight random distribution (usually between 9-15f) instead of the fixed swap_delay=12.

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="eosf" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="thewidsith" refine=3 lvl=90/90;
klee add set="echoes" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

options iteration=1000;
energy every interval=480,720 amount=1;

target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.5;

active bennett;

for let r = 0; r < 4; r = r + 1 {

  let src = f();

  bennett skill, burst;

  if .fischl.skill.ready {
    fischl attack, skill;
  } else if .fischl.burst.ready {
    fischl attack:2, burst;
  }

  chevreuse burst, skill[hold=1];

  klee attack, burst, walk;

  while f() - src <= 17 * 60 { # Loop until 17s total rotation time
    if .klee.skill.ready {
      klee attack[travel=6], skill[bounce=3, mine=8], jump;
    } else if .previous-action == .action.attack && ( .stam >= 50 || .klee.status.a1-spark ) {
      klee charge;
    } else if .klee.normal > 1 && .previous-action == .action.attack {
      klee walk;
    } else {
      klee attack[travel=6];
    }
  }

  # Don't end rotation with uncanceled CA
  if .previous-action == .action.charge {
    klee attack[travel=6];
  }
}

# Bennett EQ > Fischl E/Q > Chevreuse q hE > Klee N1 Q [walk] > Klee N1 EJ if able > Klee N1C or N1W spam based on stamina
#                                                             > Loop until 17s total rotation time
