#team config

clorinde char lvl=90/90 cons=6 talent=10,10,10;
clorinde add weapon="absolution" refine=5 lvl=90/90;
clorinde add set="echoes" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

#enemy config


options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=3000000;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}
active clorinde;

#action list

clorinde_combo();
for {
  switch {
    case .clorinde.burst.ready:
      clorinde burst;
    case .clorinde.skill.ready:
      clorinde_combo();
    default:
      clorinde attack;
  }
}
