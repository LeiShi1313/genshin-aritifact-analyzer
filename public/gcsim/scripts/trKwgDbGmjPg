# Xinyan Chevreuse Fischl Bennett. ~16s Rot. On-field Bennett and burst support Xinyan generate energy for burst DPS Chevreuse nukes. Fischl just before Chevreuse in Bennett Q for more Overcharged Balls. Phys and Pyro Xinyan are comparable. Xinyan bursts as available.

# Team- Options roughly listed by DPS
bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="deathmatch" refine=1 lvl=90/90;
chevreuse add set="emblem" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="favgs" refine=3 lvl=90/90;
xinyan add set="emblem" count=4;
#xinyan add set="tom" count=4;
#xinyan add set="scroll" count=4;
#xinyan add set="pf" count=2; xinyan add set="bsc" count=2;
#xinyan add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
#xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Pyro
xinyan add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622 ; #main
xinyan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1653 em=39.64 cr=0.1655 cd=0.662; # Phys

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active bennett;

for let r = 4; r > 0; r = r - 1 {
  if .bennett.skill.ready {
    bennett skill;
  }
  bennett burst;

  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }

  chevreuse burst, skill[hold=1]:3;

  #bennett skill, attack;
  while !.bennett.burst.ready {
    if .xinyan.burst.ready && .xinyan.skill.ready {
      xinyan skill, burst;
    } else if .xinyan.burst.ready {
      xinyan burst;
    } else if .xinyan.skill.ready && .xinyan.onfield {
      xinyan skill;
    } else if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }

  print("done");
}
