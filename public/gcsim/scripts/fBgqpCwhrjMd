# KQMS stats
# Gaming Citlali Bennett Xianyun. Gaming does 7 plunges per rotation, of which 6 are melted. Last plunge is used for energy and ▶is skipped on the very last rotation to display higher DPS.◀ ~20-22s rot length.

gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworneye" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active gaming;
gaming skill, low_plunge; #pyro app for swirl on first rotation + SS stacks

for let i=0; i<4; i=i+1 {
  xianyun skill, low_plunge, burst;
  bennett skill, burst;
  while !.bennett.mods.favonius-cd {
    bennett attack;
  }
  citlali skill, burst;
  gaming burst;
  gaming skill;
  wait(45);
  gaming high_plunge; # plunge 1
  gaming skill;
  wait(18);
  gaming high_plunge; # plunge 2
  gaming skill;
  wait(18);
  gaming high_plunge; # plunge 3 no longer VV buffed
  gaming skill;
  wait(18);
  gaming high_plunge; # plunge 4
  gaming skill;
  wait(18);
  gaming high_plunge; # plunge 5
  gaming skill;
  wait(33); # wait for cryo aura
  gaming high_plunge; # plunge 6 melted but no bennett buff and no TTDS buff
  if i != 3 {
    gaming skill;
    wait(5); # wait for particle icd
    gaming high_plunge; # plunge 7 non-melted
  }
}
