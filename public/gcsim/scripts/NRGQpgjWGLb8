# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=-1.6,1.8 hp=100000000;
target lvl=100 resist=0.1 radius=1.5 pos=1.6,1.8 hp=100000000;

# Kazuha TF Rotation
fn TFCombo() {
  # Keep Kazuha skill on CD
  if .kazuha.skill.ready {
    kazuha attack, skill, high_plunge[collision=rand()>0.3];
  } else if .kazuha.burst.ready && .kazuha.energy == .kazuha.energymax {
    kazuha attack, burst;
  } else {
    kazuha attack;
  }
}

# Rotation
active nahida; #SS Stacks

for let i=0; i<4; i=i+1 {
  # Spend Kuki C4
  kuki skill, attack;
  #kuki skill;

  # Nahida omit burst without energy
  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }
  
  # Fischl burst over skill
  amy attack;
  if .amy.burst.ready && .amy.energy == .amy.energymax {
    amy attack:1, burst;
  } else {
    amy skill;
  }
  
  # Kuki burst, energy permitting
  if .kuki.burst.ready && .kuki.energy == .kuki.energymax {
    kuki burst;
  }
  
  # While OZ is on field
  while .fischl.oz {
    TFCombo();
  }

  print("done");
}

