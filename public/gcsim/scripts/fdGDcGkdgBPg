options swap_delay=12 iteration=1000;

# Build assumptions
neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacjade" refine=1 lvl=90/90;
neuvillette add set="marechausseehunter" count=5;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=3 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="goldentroupe" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="favsword" refine=3 lvl=90/90;
lynette add set="viridescentvenerer" count=4;
lynette add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

active neuvillette;

for let i=0; i<4; i=i+1 {
  neuvillette skill, attack;
  lynette burst;
  ororon skill, burst;
  fischl attack, skill;
  lynette skill, attack;
  neuvillette charge, burst, skill, charge;
  lynette skill, attack;
  fischl attack:2, burst;
  neuvillette charge, charge;
}
wait(173);
