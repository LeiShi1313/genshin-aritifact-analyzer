for let i=0; i<4; i=i+1 {
  neuvillette skill;

  baizhu attack, skill, burst, attack;
  xiangling burst, skill, dash;

  furina skill, burst;
  neuvillette charge, skill,
              charge, burst;

  baizhu skill, attack;
  xiangling skill, dash, attack;
  neuvillette charge,
              charge;
}
wait(173); #for the last CA
