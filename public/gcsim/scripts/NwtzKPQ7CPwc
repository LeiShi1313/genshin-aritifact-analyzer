for let i=0; i<5; i=i+1 {
  bennett burst, skill;
  furina burst, skill, dash; // Must be burst skill. skill burst will cause furina C6 to time out.
  kazuha skill, high_plunge;
  xiangling skill, burst;
  furina charge;
