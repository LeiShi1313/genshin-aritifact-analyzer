# Hutao Furina Lynette Xianyun. ~19s Rot. Huto Vape plunge (5N2CJHP) with Lynette feeding Xianyun Anemo particles if possible, then using dropping her burst after, absorbing Hydro. Inconsistent Vapes.

# Team - Options roughly listed by DPS
hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="fjords" refine=1 lvl=90/90;
hutao add set="mh" count=4;
#hutao add set="longnightsoath" count=4;
hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.4464 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2317 cd=0.662; # MH
#hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
#hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # LNO

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="favsword" refine=3 lvl=90/90;
lynette add set="vv" count=4;
#lynette add set="scroll" count=4;
#lynette add set="no" count=4;
lynette add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311;  #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4; # Miss chance
#xianyun add set="sodp" count=4;
#xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.2204 em=39.64 cr=0.2317 cd=0.1986;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;

  while .lynette.skill.ready {
    lynette skill;
  }
  if .lynette.swap.cd {
    lynette attack;
  }

  xianyun skill, low_plunge, burst;

  while .lynette.skill.ready {
    lynette skill;
  }
  lynette burst;

  hutao skill;
  for let p = 5; p > 0; p = p - 1 {
    hutao attack:2, charge, jump;
    if .airborne {
      hutao high_plunge[collision=rand()>0.5];
    }
  }
  hutao attack:2, charge, dash;
}
