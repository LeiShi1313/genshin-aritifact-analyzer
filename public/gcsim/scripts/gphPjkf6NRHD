raiden skill;
for let i=0; i<5; i=i+1 {
  chevreuse burst, skill[hold=1];
  dehya skill:2;
  lisa burst;
  dehya burst, attack:10;
  raiden burst, attack:4, skill, attack:4, dash, attack:4;
}

