chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.1324;

#options iteration=1000 swap_delay=12;                                                                       
#target lvl=100 resist=0.1 radius=10 pos=0,10.4 hp=999999999; 
options iteration=1000 swap_delay=1;
target lvl=100 resist=0.1 radius=2 pos=0,3.1 hp=999999999;
energy every interval=480,720 amount=1;

active raiden;

raiden skill;

for let r=0; r<5; r=r+1 {
  if r == 0 {
    yae skill:3;
  } else {
    yae attack, skill, attack, skill, attack, skill;
  }
  chevreuse burst;
  if r > 0 {
	  chevreuse attack:2;
  }
  chevreuse skill[hold=1];
  sara skill, aim;
  yae burst, attack, skill, attack, skill, attack, skill;
  sara burst;
  chevreuse skill[hold=1];
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
}

# (First rot) Raiden E > Yae EEE > Chev Q hE > Sara E CA > Yae Q 3[N1E] > Sara Q > Chev hE > Raiden Q N4E 2[N4D] N4
# (Second rot onwards) Yae 3[N1E] > Chev Q hE > Sara E CA > Yae Q 3[N1E] > Sara Q > Chev hE > Raiden Q N4E 2[N4D] N4
# Sara Q > Chev hE > Raiden requires either low ping or a large enemy in order for raiden to get Sara's buff.

