# --- Team
wriothesley char lvl=90/90 cons=0 talent=9,9,9;
wriothesley add weapon="flowingpurity" refine=5 lvl=90/90;
wriothesley add set="mh" count=4;
wriothesley add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622 ; #main				
wriothesley add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662 ;										

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="favoniuscodex" refine=3 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main				
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662 ;																																								

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.2979 cd=0.7944 ;

kuki char lvl=90/90 cons=6 talent=9,9,9 start_hp=2;
kuki add weapon="xiphosmoonlight" refine=1 lvl=90/90;
kuki add set="flowerofparadiselost" count=4;
kuki add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kuki add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324;

# --- Options
options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# --- Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

# --- Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  nahida skill, attack, burst;
  furina skill, attack, burst;
  while !.furina.mods.favonius-cd {
 furina attack;}
  kuki skill, attack;
  wrio skill,
  attack:3, charge,
  attack:3, charge,
  attack:3, charge,
  attack:3, charge,
  attack:3, charge;
 if .wrio.burst.ready {
   wrio burst;
 } else {
   wrio attack:3, charge;
   }
 if .kuki.burst.ready {
   kuki burst;
 }
 print("Rotation Done");
}