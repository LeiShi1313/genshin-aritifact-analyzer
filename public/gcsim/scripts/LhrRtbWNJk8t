options swap_delay=12 iteration=1000;

# Build assumptions
mavuika char lvl=90/90 cons=6 talent=10,10,10;
mavuika add weapon="tbs" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

citlali char lvl=90/90 cons=6 talent=10,10,10;
citlali add weapon="starcallerswatch" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

xilonen char lvl=90/90 cons=6 talent=10,10,10;
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="ap" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;
// xilonen add set="ins" count=4;
// xilonen add stats hp=3571 atk=232 def%=0.583 def%=0.43725 def%=0.43725;
// xilonen add stats def%=0.31248 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.111216;

nicole char lvl=90/90 cons=6 talent=10,10,10;
nicole add weapon="angelosheptades" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.1102 em=39.64 cr=0.2979 cd=0.1986;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  nicole skill, attack;
  xilo skill, attack:2;
  pick_up_crystallize("any");
  if is_even(i) {
    citlali skill, attack;
    mavuika burst;
    mavuika charge:3, charge[hold=6], charge[final=1], dash;
    mavuika charge:3, charge[hold=6], charge[final=1], dash; # the last Final CA is buffed by Mavuika Q.
    mavuika charge:1, charge[hold=6], charge[final=1], dash;
    mavuika charge:1, charge[hold=6], charge[final=1], dash;
    mavuika charge;
  } else {
    citlali skill, burst, attack:2;
    mavuika burst;
    mavuika charge:3, charge[hold=6], charge[final=1], dash;
    mavuika charge:3, charge[hold=6], charge[final=1], dash; # the last Final CA is buffed by Mavuika Q.
    mavuika charge:1, charge[hold=6], charge[final=1], dash;
    mavuika charge:1, charge[hold=6], charge[final=1], dash;
    mavuika charge, dash, attack;
  }
}

