#bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324; # GD

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000; 

#Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  nahida skill;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida attack, charge;
  }
  
  bennett burst, skill;
  while .sayu.skill.cd > 80 {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  
  sayu burst;
  sayu skill[hold=600];
  
  print("done");
}

