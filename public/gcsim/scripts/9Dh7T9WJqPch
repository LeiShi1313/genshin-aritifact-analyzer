# Dori Nahida Yaoyao Sayu. ~21s Rot. The children yearn for the vines.

# Team
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
dori add set="tf" count=4;
#dori add set="gd" count=4;
dori add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=59.46 cr=0.3641 cd=0.7944;

yaoyao char lvl=90/90 cons=6 talent=9,9,9;
yaoyao add weapon="favlance" refine=3 lvl=90/90;
yaoyao add set="deepwood" count=4;
yaoyao add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
yaoyao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

sayu char lvl=90/90 cons=6 talent=9,9,9;
sayu add weapon="favgs" refine=3 lvl=90/90;
sayu add set="vv" count=4;
sayu add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
sayu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.0 pos=0,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1.5 pos=1.6,1.8 hp=100000000;

# Rotation
active dori; # SS Stacks
dori burst;
sayu skill[short_hold=1];

for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }

  yaoyao skill, attack;

  dori skill, attack:2, dash, attack:2;

  sayu skill[short_hold=1];

  dori skill, attack:2, dash, attack:2;

  if .sayu.burst.ready {
    sayu burst;
  } else {
    nahida attack, charge;
  }

  dori skill, attack:2, burst;

  sayu skill[short_hold=1];

  print("done");
}
