arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
arle add set="fohw" count=5;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ;
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="footprintoftherainbow" refine=5 lvl=90/90;
yunjin add set="husk" count=4 +params=[stacks=4];    # 4pc NO is more impactful since the team lacks ATK% buff
yunjin add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583 ; #main
yunjin add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.1986 cd=0.1324;

