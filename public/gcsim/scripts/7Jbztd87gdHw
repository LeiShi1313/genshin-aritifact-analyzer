# Diluc Chongyun Emilie Xianyun. ~16s Rot. Diluc Melt Plunge. Uses Diluc E to (re)establish Burning aura to Melt plunge. Chongyun uses E before Xianyun. 50% Collisions.

# Team - Options listed by DPS
diluc char lvl=90/90 cons=0 talent=9,9,9;
diluc add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
diluc add set="longnightsoath" count=4;
#diluc add set="ur" count=4;
#diluc add set="sr" count=4;
diluc add stats hp=4780 atk=311 em=187 cryo%=0.466 cd=0.622; #main
diluc add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no" count=4;
#chongyun add set="deepwood" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="tom" count=4;
#emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3306 em=79.28 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # deals burning AoE, -SS stacks

# Diluc Plunge Combo
fn DilucPlunge() {
  diluc jump;
  if .airborne {
    diluc high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active diluc; # SS stacks
#diluc burst;

for let r = 0; r < 4; r = r + 1 {
  if r > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }

  chongyun burst, skill;

  xianyun skill, high_plunge, burst;

  diluc skill;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); #diluc dash;
  diluc skill;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  diluc skill;
  DilucPlunge(); diluc dash;
  DilucPlunge(); #diluc dash;
  #if r == 0 {
  #  diluc burst;
  #}
}
