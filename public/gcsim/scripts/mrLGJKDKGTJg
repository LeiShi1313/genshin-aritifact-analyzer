#team config

itto char lvl=90/90 cons=0 talent=9,9,9;
itto add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
itto add set="husk" count=4; #no husk prestack on serpent
itto add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mainstats
itto add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2753 em=39.64 cr=0.3641 cd=0.662;

noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="favoniusgreatsword" refine=3 lvl=90/90;
noelle add set="oceanhuedclam" count=4;
noelle add stats hp=4780 atk=311 def%=0.583 def%=0.583 heal=0.359; #mainstats
noelle add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="goldentroupe" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #mainstats
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2753 em=39.64 cr=0.2979 cd=0.7944;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="cinnabarspindle" refine=5 lvl=90/90;
chiori add set="goldentroupe" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #mainstats
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

#enemy config

options swap_delay=12 iteration=2000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
active furina;

#action list

for let i = 0; i < 4; i = i + 1 {

  furina skill, dash, burst;

  while !.furina.mods.favonius-cd {
    furina attack;
  }

  noelle skill, burst, attack:2;

  if .chiori.burst.ready {
    chiori burst;
  }

  chiori skill:2;

  if i == 0 {
    itto attack, burst[prestack=1],
         attack, skill,
         attack:2, charge:5,
         attack:4, charge:5, skill[travel=0], charge;
         sleep(21); #catch ushi particles

         #"C0 1PS" combo

  } else {
    itto attack, burst[prestack=1],
         attack, skill, charge:4,
         attack:3, charge:4,
         attack:3, skill, charge:4;

         #"C0 2PS" combo

  }

}
