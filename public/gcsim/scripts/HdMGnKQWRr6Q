active navia;
for let x=0; x<4; x=x+1 {
  navia burst;
  bennett burst, skill;
  xiangling burst, skill, dash;
  print(.navia.shrapnel);
  chiori skill:2;
  navia skill[hold=1], attack:3, dash, attack:2;
  bennett skill, attack;
  print(.navia.shrapnel);
  navia skill[hold=1], attack:3, dash, attack:2;
  if .navia.skill.ready {
    navia skill[hold=1];
  }
  bennett skill, attack;
  xiangling attack:2, dash;
}

