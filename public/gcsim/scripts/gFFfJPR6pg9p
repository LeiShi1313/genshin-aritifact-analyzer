mizuki char lvl=90/90 cons=0 talent=9,9,9;
mizuki add weapon="pamber" refine=5 lvl=90/90;
mizuki add set="vv" count=4;
mizuki add stats hp=4780 atk=311 em=187 em=187 em=187; #main
mizuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.663;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=2.1,1.5 hp=3600000;
energy every interval=480,720 amount=1;

active furina;

while 1 {
  switch {
    case .furina.skill.ready:
      furina skill, dash;
    case .furina.burst.ready:
      furina burst;
    case .fischl.skill.ready:
      fischl skill, attack;
    case .fischl.burst.ready && !.fischl.oz:
      fischl attack:2, burst;
    case .esco.skill.ready:
      esco skill;
      if .esco.burst.ready {
        esco burst;
      } else {
        esco attack:2;
      }
    case .mizuki.skill.ready:
      mizuki skill;
      while .mizuki.status.dreamdrifter-state > 190 {
        if .mizuki.burst.ready {
          mizuki burst;
        } else {
          wait(1);
        }
      }
    case .mizuki.normal > 1:
      mizuki charge;
    default:
      mizuki attack;
  }
}
