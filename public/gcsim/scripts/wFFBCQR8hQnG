nicole char lvl=100/100 cons=6 talent=10,10,10;
nicole add weapon="angelosheptades" refine=5 lvl=90/90;
nicole add set="gift" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*5 em=19.82*2 cr=0.0331*10 cd=0.0662*7;

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilonen && action_id == .action.skill ) {
    pick_up_crystallize("any");
  }

  return _execute_action(char_id, action_id, p);
}

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

active chiori;

chiori skill:2;

for let i=0; i<5; i=i+1 {

  durin burst;

  nicole skill;

  xilonen skill, attack:2; # pick_up_crystallize("any");

  chiori skill, attack, burst, attack:3, skill:2;

  durin skill:2;

  nicole burst;

  xilonen skill, attack:2; #pick_up_crystallize("any");

  chiori skill, attack:3, dash, attack:3, dash, attack:3, skill:2;

}
