# Wanderer Faruzan Furina Mika. ~22s Rot. Wanderer Q at the end of FT if available. Wanderer swirls Cryo with E. Easy to overcap CR. SoDP~=OHC Mika.

# Team - Options Listed by DPS
wanderer char lvl=90/90 cons=0 talent=9,9,9;
wanderer add weapon="widsith" refine=3 lvl=90/90;
wanderer add set="mh" count=4;
wanderer add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
wanderer add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90 ;
faruzan add set="scroll" count=4;
#faruzan add set="no" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Fav Mika
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # Sages Mika

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
#mika add weapon="dialogues" refine=5 lvl=90/90;
mika add set="no" count=4;
#mika add set="sodp" count=4;
#mika add set="ohc" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282; # Fav
#mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
#mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.551 em=39.64 cr=0.2979 cd=0.1324; # Sages

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1  {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  faruzan skill, burst;
  while !.faruzan.mods.favonius-cd {
    faruzan attack;
  }

  if .mika.weapon == .keys.weapon.favlance {
    mika burst, attack, skill; # Fav
  } else {
    mika burst, skill; # Sages
  }

  wanderer skill, attack;
  while .wanderer.skydweller-points > 3 {
    switch {
      case .wanderer.normal < 3:
        wanderer attack;
      case .wanderer.mods.wanderer-a4:
        wanderer dash;
      default:
        wanderer charge;
    }
  }
  if .wanderer.burst.ready && .wanderer.energy == .wanderer.energymax {
    wanderer burst, attack:2;
  } else {
    #wanderer skill;
    wanderer low_plunge, dash;
  }
}
