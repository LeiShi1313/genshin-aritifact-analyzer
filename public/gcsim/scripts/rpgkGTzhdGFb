#Sucrose Prune Nicole Durin. Rotations slightly shorter than 18s with Anemo Resonance. Fav VV Sucrose on-field allows Durin and Prune to build full damage while getting enough ER to burst every rotation. Noblesse Prune almost caps out her buff so Rising Winds is unnecessary.

options swap_delay=12 iteration=500;

# Build assumptions
sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="favcodex" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
#sucrose add set="risingwinds" count=4;
sucrose add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311;
#sucrose add stats hp=4780 atk=311 em=186.5 anemo%=0.466 cr=0.311;
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

prune char lvl=90/90 cons=6 talent=9,9,9;
prune add weapon="oathsworneye" refine=5 lvl=90/90;
prune add set="no" count=4;
#prune add set="risingwinds" count=4;
#prune add set="vv" count=4; sucrose VV better
#prune add set="emblem" count=4;
prune add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
#prune add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
#prune add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
#prune add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*6 cd=0.0662*12;
prune add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="flowingpurity" refine=1 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*6 er=0.0551*10 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
#durin add set="no" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active durin;

for let i=0; i<6; i=i+1 {
  let StartFrame = f();
  durin skill, skill, burst;
  prune skill, burst, skill;
  nicole skill, burst;
  while f() - StartFrame < 1020 {
    if .sucrose.skill.ready{
      sucrose skill, jump;
    }
    else{
      if .sucrose.burst.ready{
        sucrose burst;
      }
      else{
        sucrose attack:2, charge;
      }
    }

  }

}
