# Clorinde Nahida Kuki Yelan. ~25s Rot. (TF) Clorinde Quickbloom with Kuki. Clorinde does not burst. Kuki uses burst between Clorinde skill uses. Slingshot Yelan doesn't exceed Fav bow here.

# Team
clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="tf" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=118.92 cr=0.2979 cd=0.5958;

kuki char lvl=90/90 cons=0 talent=9,9,9;
kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="fopl" count=4;
kuki add stats hp=4780 atk=311 em=187 em=187 em=187;
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

# Clorinde Combo
fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

#Rotation
active kuki;

for let i=0; i<4; i=i+1 {
  kuki skill, attack;

  nahida skill;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }

  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  clorinde_combo();

  yelan attack, skill, attack;

  kuki burst, attack;

  clorinde_combo();
}
