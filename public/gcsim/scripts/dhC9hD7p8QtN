# Gaming Furina Yelan Xilonen. ~20s Rot. Gaming Double Hydro with Gaming weaving NAs between plunges. VH > CW. 2E Xilonen only Crystallizes Hydro. Doing a Gaming EhP at the start to get Pyro Scroll in the first rotation is the same DPS.

# Team
gaming char lvl=90/90 cons=6 talent=9,9,9; 
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#gaming add weapon="fruitfulhook" refine=1 lvl=90/90;
gaming add set="vh" count=4;
#gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # VH
#gaming add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
#gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.3972 cd=0.4634; # CW

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ToM
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # GT

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="no" count=4;
#yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=100000000;

# Rotation
active gaming; # SS stacks
#gaming skill, high_plunge;

#yelan aim; # brea

for let i=0; i<4; i=i+1{
  if i > 0 || .previous-action == .action.high_plunge || .previous-action == .action.aim {
    xilonen skill, attack:2;
  }
  xilonen burst;
  
  furina skill, dash, burst;
  
  yelan skill, burst, attack;
  
  xilonen skill, attack:2;
  
  gaming burst, attack:2;
  for let i=0; i<6; i=i+1 {
    gaming skill, high_plunge, attack;
  }
  gaming skill, high_plunge, dash;
}
