# Eula Furina Escoffier Mika. ~22s Rot. Eula Mika with Escoffier. Escoffier and Mika burst in alternate rotations. Mika C6 will expire before the lightfall drop if Eula's burst is not ready immediately.

# Team - Option Listed by DPS
eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="uomms" refine=5 lvl=90/90;
eula add set="mh" count=4;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.4634;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="ohc" count=4;
mika add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  escoffier skill;
  if !is_even(i) {
    esco burst;
  }

  if is_even(i) {
    mika burst;
  }
  mika skill[hold=1];

  eula skill;
  if !.eula.burst.ready {
    eula attack;
  }
  eula burst, attack:4, skill[hold=1], walk[f=11], attack:4, dash, attack:2;

  while !.mika.mods.favonius-cd || .eula.swap.cd {
    mika attack;
  }

  eula attack:2;
}
