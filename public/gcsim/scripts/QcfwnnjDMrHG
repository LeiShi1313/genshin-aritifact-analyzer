gaming char lvl=90/90 cons=6 talent=9,9,9; 
gaming add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.5952 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.1324;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworneye" refine=5 lvl=90/90;
xianyun add set="no" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=198.48 atk%=0.3968 er=0.3306 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=100; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active gaming;
for let i=0; i<4; i=i+1{
  furina skill, dash, burst;
  xianyun skill, low_plunge, burst;
	
	if i == 2 {
		gaming swap;
		sleep(32);
	}
  gaming burst;
	gaming skill;
  sleep(42);
	gaming low_plunge;
  for let j = 0; j < 8; j = j + 1 {
    gaming skill;
    sleep(17);
    gaming high_plunge;
  }
	gaming dash;
}

