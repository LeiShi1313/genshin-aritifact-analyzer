# Razor Durin Fischl Kirara. ~20s Rot. Razor Quickburn with Kirara C4 providing Dendro into Razor's burst uptime while full EM Durin offers off-field Pyro. Fischl alternates skill and burst just before Razor. Kirara doesn't burst at all and builds full HP.

# Team - Options listed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="ur" count=4; # AAC also viable
#razor add set="risingwinds" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # UR
#razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10; # RW

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="xiphos" refine=1 lvl=90/90;
#durin add weapon="lionsroar" refine=3 lvl=90/90;
durin add set="cg" count=4;
#durin add set="scroll" count=4;
#durin add set="deepwood" count=4;
durin add stats hp=4780 atk=311 em=187 em=187 em=187; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*4 em=19.82*6 cr=0.0331*6 cd=0.0662*2; # CG
#durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
#durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*8 em=19.82*2 cr=0.0331*8 cd=0.0662*6; # LR

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=190]; # Razor - Dash
#kirara add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=120]; # Fischl - Burst
kirara add set="ins" count=4;
#kirara add set="scroll" count=4;
kirara add stats hp=3571 atk=232 hp%=0.466 hp%=0.3495 hp%=0.3495; #main
kirara add stats def%=0.05208*2 def=16.5312*2 hp=213.31*2 hp%=0.041664*2 atk=13.8936*2 atk%=0.041664*2 er=0.046284*2 em=16.6488*12 cr=0.027804*4 cd=0.055608*2; # 4*
#kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
#kirara add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*12 cr=0.0331*10 cd=0.0662*4; # 5*

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active razor; # SS Stacks

fischl skill, attack;

for let i=0; i<4; i=i+1 {
  durin skill:2, burst;

  if i == 0 {
    kirara burst;
  }
  kirara skill[short_hold=1];

  if .amy.burst.ready {
    amy attack:2, burst;
  } else {
    amy attack:1, skill;
  }

  razor skill, dash, attack, burst;
  razor attack:1, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3;
}
