tao char lvl=90/90 cons=0 talent=9,9,9;
tao add weapon="ballad" refine=1 lvl=90/90;
tao add set="mh" count=4;
tao add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 cd=0.622; #main
tao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2979 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favsword" refine=5  lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1653 em=118.92 cr=0.3972 cd=0.331;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="sodp" count=4;
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359 ; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.1324;

options swap_delay=12 iteration=100;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active furina;
for let r = 4; r > 0; r = r - 1 {
  furina skill, attack, burst;
  kaz burst;
  chev burst, skill[hold=1];
  kazuha skill, high_plunge;
  tao skill;
  for let i=9; i>0; i = i - 1 {
    tao attack, charge, jump;
  }
  tao attack;
  if .tao.burst.ready {
    tao burst;
  } else {
    tao attack:2;
  }
  kazuha skill, high_plunge;
}
