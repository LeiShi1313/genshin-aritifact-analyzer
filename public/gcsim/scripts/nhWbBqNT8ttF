options swap_delay=12 iteration=1000;

# Build assumptions
flins char lvl=90/90 cons=0 talent=9,9,9;
flins add weapon="deathmatch" refine=1 lvl=90/90;
flins add set="tf" count=4;
flins add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="totm" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

aino char lvl=90/90 cons=6 talent=9,9,9;
aino add weapon="favoniusgreatsword" refine=3 lvl=90/90;
aino add set="silkenmoonsserenade" count=4;
aino add stats hp=4780 atk=311 em=187 em=187 cr=0.311;
aino add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="ttds" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187;
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2317 cd=0.1986;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active aino;
for let i=0; i<6; i=i+1 {
  aino skill, burst;
  if is_even(i) {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  if .sucrose.burst.ready {
    sucrose attack, burst;
  } else {
    sucrose skill, dash, attack;
  }
  flins skill, attack, skill, attack, burst, attack:4, dash, attack:4, dash, attack:2, skill, attack, burst, attack:2;
}
