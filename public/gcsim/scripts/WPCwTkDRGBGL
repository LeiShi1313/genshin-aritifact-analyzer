# Qiqi Furina Fischl Xianyun. ~20s Rot. Qiqi Phys Plunge. Fischl alternates skill and burst. Qiqi fills some time at the end of the rotation with N1C. Unoptimzed. 50% Collisons.

# Team
qiqi char lvl=90/90 cons=0 talent=9,9,9;
qiqi add weapon="harbinger" refine=5 lvl=90/90;
#qiqi add weapon="finale" refine=5 lvl=90/90;
qiqi add set="longnightsoath" count=4;
#qiqi add set="pf" count=4;
#qiqi add set="mh" count=4;
qiqi add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main
qiqi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Other; HoD
#qiqi add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#qiqi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # MH; HoD
#qiqi add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#qiqi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # MH; LR
#qiqi add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main
#qiqi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Other; Finale

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
#furina add set="gt" count=4;
furina add set="tom" count=4;
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.4634; # ToM
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.4634; # GT

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=0]; # Leading party
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4;
#xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active amy;
amy skill;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  xianyun skill, low_plunge, burst;

  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }

  if .qiqi.skill.ready {
    qiqi skill;
  } else if .qiqi.burst.ready {
    qiqi burst;
  }
  while .qiqi.status.xianyun-airborne-buff {
    qiqi jump;
    if .airborne {
      qiqi high_plunge[collision=rand()>0.5];
    }
    if .qiqi.status.xianyun-airborne-buff { # swap > dash for final plunge
      qiqi dash;
    }
  }
  while .furina.skill.cd {
    if .qiqi.normal > 1 && .stam > 25 {
      qiqi charge;
    } else {
      qiqi attack;
    }
  }
}
