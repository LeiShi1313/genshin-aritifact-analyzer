options iteration=1000 swap_delay=12;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=21370000000;

active fischl;
for let i=0; i<6; i=i+1 {
  fischl skill, attack;
  xingqiu skill, dash, burst, attack;
  mona burst, attack, skill, attack;
  fischl attack:2, burst;
  hutao skill,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge;
  if .tao.burst.ready && .tao.energy == .tao.energymax  {
    tao burst;
  } else {
    tao attack:2;
  }
}
