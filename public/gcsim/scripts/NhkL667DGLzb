klee char lvl=90/90 cons=6 talent=9,9,9;
klee add weapon="lostprayertothesacredwinds" refine=1 lvl=90/90;
klee add set="glad" count=2;
klee add set="shim" count=2;

klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=.311;
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000 duration=200;
target lvl=100 resist=.1 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active klee;

klee attack;

while 1 {
  if .previous-action == .action.attack && .klee.burst.ready {
    klee burst, walk;
  } else if .previous-action == .action.attack && .klee.skill.ready {
    klee skill[bounce=3, mine=8], jump;
  } else if .previous-action == .action.attack && ( .stam >=50 || .status.kleespark ) {
    klee charge;
  } else if .previous-action == .action.attack {
    klee walk;
  } else {
    klee attack;
  }
}