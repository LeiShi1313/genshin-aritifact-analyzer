candace add weapon="favlance" refine=5 lvl=90/90;
candace add set="no" count=4;
#candace add set="ins" count=4;
candace add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
candace add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.4634; # NO
#candace add stats hp=3571 atk=232 er=0.518 hydro%=0.466 cr=0.23325;
#candace add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.277704 em=33.2976 cr=0.27804 cd=0.111216; # Ins

