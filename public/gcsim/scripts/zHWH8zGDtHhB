# Dehya Candace Xiangling Xianyun. ~20s Rot. Dehya forward vaporize plunge with Candace's hydro infusion; pyro supplied by both Xiangling's pyronado and Dehya's skill.

# Team
dehya char lvl=90/90 cons=0 talent=9,9,9;
dehya add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#dehya add weapon="fruitfulhook" refine=1 lvl=90/90;
