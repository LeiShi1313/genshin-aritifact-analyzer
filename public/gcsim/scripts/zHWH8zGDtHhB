#xianyun add set="sodp" count=4;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=148.86 atk%=0.2976 er=0.6061 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; 

# Dehya Plunge Combo
fn DehyaPlunge() {
  dehya jump;
  if .airborne {
    dehya high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active dehya; # SS stacks

candace attack, skill;

for let i=0; i<4; i=i+1 {
  xianyun skill, low_plunge, attack, burst;
  
  xiangling skill, attack, burst, dash;
  
  candace skill, burst, attack;
  
  #xianyun attack[travel=0]:3;
  
  dehya attack, skill;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge();
  
  candace attack, skill, attack;
}

