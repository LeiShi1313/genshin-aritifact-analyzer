options swap_delay=12 iteration=1000;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="mh" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; # main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2648 cd=0.5296 ;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662 ;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
mika add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2973 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324 ;

active furina;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

furina skill, dash, burst;
for let i=0; i<4; i=i+1 {
  if i {
    furina attack, burst, skill;
  }

  yelan burst, attack;

  mika burst, attack, skill;

  yelan attack;
  while !.yelan.skill.ready {
    yelan attack;
  }
  yelan skill, attack;

  if .fischl.burst.ready {
    fischl burst;
  } else {
    fischl skill;
  }

  fischl attack:5, dash,
          attack:5, dash,
          attack:5;

  yelan attack;
  while !.yelan.skill.ready {
    yelan attack;
  }
  yelan skill, attack;

  fischl attack:4;
}
