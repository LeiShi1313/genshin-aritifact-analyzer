# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # enables MH through burning AoE, -SS stacks

# Rotation
active razor; # SS Stacks

fischl skill, attack;

for let i=0; i<4; i=i+1 {
  if i > 0 && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack; # Fischl C6
  }
  
  # Fill time
  if i > 0 {
    bennett attack, charge;
  }
  bennett skill, burst;
  
  # Use burst over skill
  amy attack;
  if .amy.burst.ready {
    amy attack, burst; # Catch Sapwood leaf with phased movement
  } else {
    amy skill;
  }
  
  razor skill, dash, attack, burst, attack:1, skill, dash; # Pick up Sapwood leaf during dash if missed
  # Razor main DPS window 
  while .razor.infusion.bennett-fire-weapon { 
    if .razor.normal > 3 {
      if .razor.skill.ready {
        razor skill, dash;
      } else {
        razor dash;
      }
    } else {
      razor attack;
    }
  }
  
  bennett skill;
  print("done");
}
