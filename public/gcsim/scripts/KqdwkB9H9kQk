# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
#active xinyan; # SS stacks
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  bennett skill, burst;

  rosaria skill, burst;

  if .xinyan.skill.cd {
    xinyan attack;
  }
  xinyan skill, burst;
  xinyan attack:2;

  rosaria skill;

  raiden burst, attack:4, dash, attack:4, skill, attack:4;

}
