xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="ttds" refine=5 lvl=90/90;
xianyun add set="ohc" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main 
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.3857 em=39.64 cr=0.3972 cd=0.1986;

# Targets

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

# Options

options swap_delay=12 iteration=100;
energy every interval=480,720 amount=1;
active furina;

# Actions

for let r=0; r<5; r=r+1 {
  furina skill, dash, burst;
  faruzan burst;
  xianyun skill, low_plunge, burst;
  
  lynette burst, skill;
  for let p=0; p<6; p=p+1 {
    lynette jump, high_plunge[collision=1], dash;
  }
  lynette skill;
  for let p=0; p<2; p=p+1 {
    if .lynette.status.xianyun-airborne-buff {
      lynette jump;
    }
    if .airborne {
      lynette high_plunge[collision=1], dash;
    }
  }
  lynette attack, charge, attack, charge;
 if r<4 {
   faruzan skill, attack;
 }
}
# Hyperbuffed plunge Lynette with Furina, Faruzan, Xianyun. Lynette dash-cancels after each plunge. No IR, but has Lynette's taunt. 100% collision rate. 21s rotation.
# Furina E D Q, Faruzan Q, Xianyun E lP Q, Lynette Q E 6JhPD E 2JhpD 2N1C, Faruzan E N1
