# Options

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# Targets

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

# Actions

active furina;
for let i = 0; i < 4; i = i + 1 {
  if !i {
    furina skill, burst; # ensures 3 key stacks on first rotation
  } else {
    furina skill, dash, burst;
  }
  yelan skill, burst, skill, attack;
  xianyun skill, low_plunge, burst;
  klee attack, skill[bounce=3];

  for let p = 4; p > 0; p = p - 1 {
    if p > 1 {
      klee attack, charge;
    } else {
      klee attack;
    }
    klee jump;
    if .airborne {
      klee low_plunge[collision=rand()>0.5];
    }
    if p > 1 {
      klee attack;
    }
    klee jump;
    if .airborne {
      klee low_plunge[collision=rand()>0.5];
    }
  }
}

# C2R1 full team Klee plunge vape with Furina, Yelan, Xianyun. 21s rot.  Klee does not use her burst in order to get 8 buffed plunges. All of Klee's plunges vape unless a C1 proc eats the aura. 50% collision rate.
# Furina E (D) Q > Yelan E Q E N1 > Xianyun E lP Q > Klee N1 E 3(N1CJlP + N1JlP) N1JlP J lP
# Furina dashes after skill in every rotation but the first in order to get 3 key stacks
