options swap_delay=12 iteration=1000;

# Build assumptions
yoimiya char lvl=90/90 cons=6 talent=10,10,10;
yoimiya add weapon="thunderingpulse" refine=5 lvl=90/90;
yoimiya add set="mh" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=6 talent=10,10,10;
yelan add weapon="aqua" refine=5 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="key" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

xilonen char lvl=90/90 cons=6 talent=10,10,10; 
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active furina;

furina skill, dash; # first rot hydro for Xilonen
for let i = 0; i < 4; i = i + 1 {
  xilonen skill, attack:2;
  if i {
    furina skill, dash;
  }
  furina burst, attack;
  if is_even(i) {
    yoimiya burst;
  }
  yelan burst, skill, attack, skill, attack:4;
  xilonen skill, attack:2;
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
}
