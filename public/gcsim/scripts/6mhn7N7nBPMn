#ineffa add set="fopl" count=4;
#ineffa add set="sms" count=4;
ineffa add stats hp=4780 atk=311 em=187 em=187 em=187; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*6 cd=0.0662*12;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active fischl;
fischl skill; # small increase

for let i = 0; i < 4; i = i + 1 {
  xingqiu skill, dash;
  if !.xingqiu.burst.ready {
    xingqiu attack;
  }
  xingqiu burst, attack;

  ineffa skill, attack;
  if i == 0 {
    ineffa burst;
  }

  haitham burst;

  if .amy.skill.ready {
    amy attack, skill;
  } else {
    amy attack:1, burst;
  }

  haitham attack:3, dash,
          attack:3, skill,
          attack:3, charge, dash,
          attack:3, dash,
          attack:3, dash,
          attack:3, dash,
          attack:3, dash,
          attack:3;
}
