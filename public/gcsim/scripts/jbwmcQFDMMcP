# team 
hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="ballad" refine=1 lvl=90/90;
hutao add set="mh" count=4;
hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=59.46 cr=0.2317 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworneye" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
xianyun add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.2976 er=0.6612 em=39.64 cr=0.0662 cd=0.1324;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="esf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="harbinger" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3641 cd=0.5958;

# options
options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# target
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

# actions
active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  xianyun skill, low_plunge, burst;
  yelan burst;
  xianyun attack, jump, low_plunge; # refresh vv
  yelan attack, skill, attack;
  hutao skill;
  for let j=0; j<5; j=j+1 {
    hutao attack:2, charge, jump;
    if .airborne {
      hutao high_plunge[collision=rand()>0.5];
    }
  }
  yelan skill, attack:2;
}

