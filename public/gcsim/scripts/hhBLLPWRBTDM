ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="chainbreaker" refine=5 lvl=90/90;
ororon add set="scroll" count=5;
ororon add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

options swap_delay=12 iteration=100;

active emilie;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill;
  }
  ororon skill, burst;
  mav burst, skill;
  keq skill, burst, skill,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      skill:2,
      attack, charge,
      attack, charge,
      attack;
}
