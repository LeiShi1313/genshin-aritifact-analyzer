# Raiden Furina Yelan Jean. ~21s Rot. Raiden double Hydro. Electro VV is inconsistent past first rotation.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="catch" refine=5 lvl=90/90;
raiden add set="mh" count=4;
raiden add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="favsword" refine=3 lvl=90/90;
jean add set="vv" count=4;
jean add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard Timbe Based

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # ST

# Rotation
active raiden;

raiden skill;
for let i = 0; i < 5; i = i + 1 {
  if i == 0 {
    furina skill, dash, burst;
  } else {
    furina skill, dash, attack, burst;
  }

  jean burst;

  yelan burst, attack;

  jean skill, attack;

  yelan skill, attack;

  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:3;

  yelan skill, attack:1;

  jean attack, skill, attack;
}
