# Keqing Chev Fischl Thoma. ~18s Rot. Keqing Overload. Keqing spams N1C while protected by Thoma's shield. Fischl misses out on snapshotting Chevreuse's ATK buff in the first rotation.

# Team
keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="finale" refine=5 lvl=90/90;
#keqing add weapon="calamityofeshu" refine=5 lvl=90/90;
