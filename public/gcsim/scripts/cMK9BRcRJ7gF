#chev add set="sodp" count=4;
#chev add set="no" count=4;
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # HHC Chev
