#thoma add set="scroll" count=4;
thoma add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=158.56 cr=0.331 cd=0.1324; # Fav Chev
#thoma add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
#thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=79.28 cr=0.331 cd=0.1324; # DotDS Chev

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {  
  if .amy.skill.ready {
    amy attack, skill;
  } else {
    amy attack:2, burst;
  }
  
  thoma skill, attack, burst;
  
  if .chev.burst.ready {
    chev burst, attack, skill[hold=1]:3;
  } else {
    chev skill[hold=1], attack;
  }
  
  keqing skill, burst, skill,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge;
  keqing skill:2,
      attack, charge,
      attack, charge,
      attack, charge;
}

