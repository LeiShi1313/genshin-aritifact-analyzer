mizuki char lvl=90/90 cons=0 talent=9,9,9;
mizuki add weapon="hakushinring" refine=5 lvl=90/90;
mizuki add set="vv" count=4;
mizuki add stats hp=4780 atk=311 em=187 em=187 em=187; # main
mizuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gt" count=4; #check gd later
yae add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main, check atk sands later
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4; # check totm, gd, gt later
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; # main, check mains later
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=118.92 cr=0.331 cd=0.5296;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main, check atk sands later
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active fischl;
for let i=0; i<4; i=i+1{

  nahida skill, attack;
  fischl attack:2, burst;
  if i {
    yae attack, burst;
  }
  yae skill, attack, skill, attack, skill; # drive fischl

  # mizuki burst;
  mizuki skill, burst;
  while .mizuki.status.dreamdrifter-state {
    wait(1);
  }
  fischl attack, skill;
  yae attack, skill, attack, skill, attack, skill;
  nahida skill, attack, burst, charge;
  mizuki attack:3, dash, attack:3;

}
