# ----  Default Enemy
options swap_delay=12 iteration=500;

active yae;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

for let i=0; i<3; i=i+1 {
  yae skill:3;
  zhongli  skill[hold=1], dash;
  nahida skill, attack, burst;
  alhaitham skill[hold=1], low_plunge[short=1], 
            attack:2, charge, dash, 
            attack:3, charge, dash;
  yae skill:2, attack, skill;
  
  alhaitham burst;
  nahida skill, attack, charge;
  alhaitham attack:3, dash,
            attack:3, charge,dash,
            attack:3, dash, attack:3, dash, attack:3;
  #if .yae.burst.ready {yae burst; } #not really worth the fieldtime for sustained st dps
}