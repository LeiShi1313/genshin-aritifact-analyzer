# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active razor; # SS Stacks
#razor skill, dash;

fischl skill, attack;

for let i=0; i<4; i=i+1 {
  xingqiu skill, dash, burst, attack;

  razor skill, dash, attack;

  bennett skill, attack, burst;

  if !.amy.skill.ready {
    amy attack:2, burst;
  } else {
    amy attack, skill;
  }

  razor attack, burst;
  while .xingqiu.mods.xingqiuburst {
  #while .razor.infusion.bennett-fire-weapon {
  #while .xingqiu.skill.cd > 70 {
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }

  bennett skill;
}
