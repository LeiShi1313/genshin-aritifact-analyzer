options swap_delay=12 iteration=1000;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="widsith" refine=5 lvl=90/90;
columbina add set="notsu" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="dbane" refine=5 lvl=90/90;
ineffa add set="deepwood" count=4;
ineffa add stats hp=4780 atk=311 em=187 em=187 em=187; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*2 em=19.82*6 cr=0.0331*2 cd=0.0662*8;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="etherlight" refine=5 lvl=90/90;
lauma add set="sms" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*6 cr=0.0331*8 cd=0.0662*2;

dahlia char lvl=90/90 cons=6 talent=9,9,9;
dahlia add weapon="favsword" refine=5 lvl=90/90;
dahlia add set="ins" count=4;
dahlia add stats hp=3571 atk=232 er=0.359 hp%=0.348 cr=0.311;
dahlia add stats def%=0.052*2 def=16.53*2 hp=213.31*2 hp%=0.0417*6 atk=13.89*2 atk%=0.0417*2 er=0.0463*2 em=16.65*2 cr=0.0278*10 cd=0.0556*2;

active lauma;
# ----  Actions List
target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999;
energy every interval=480,720 amount=1;

lauma attack;
for let i=0; i<6; i=i+1 {

  if .columbina.burst.ready {
    columbina burst;
  }
  columbina skill;

  ineffa skill;

  dahlia attack, skill;

  lauma attack, skill[hold=.dew>0], burst;

  columbina attack, charge, dash, charge, dash;
  columbina attack, charge;

  dahlia attack, burst;

  columbina attack, charge, dash;
  columbina attack, charge, dash;
  columbina attack, charge, dash;
  columbina attack, charge;
}
columbina dash, attack; // give time for the last CA's damage to land
