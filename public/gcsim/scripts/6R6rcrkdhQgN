target lvl=100 resist=0.1 hp=99999999 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

#sim config
options swap_delay=4 iteration=1000;
active freminet;

for let i=0; i<4; i=i+1 {

  furina skill, dash, burst;
  nahida skill, burst;
  if .kuki.burst.ready {
    kuki skill, burst;
  } else {
    kuki skill;
  }
  freminet skill, burst,
           attack:2, skill, skill,
           attack:2, skill, attack, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
           attack:2, skill, attack, skill,
           attack:2, skill, attack;


}

