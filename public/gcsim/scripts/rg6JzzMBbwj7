# Xianyun Nahida Furina Raiden. 26s Rot. Xianyun stapled to Hyperbloom, she doesn't swirl much and builds ADC.

# Team - Options listed by DPS
xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="flowingpurity" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9; 
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3641 cd=0.7282;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="dbane" refine=3 lvl=90/90;
raiden add set="fopl" count=4;
#raiden add set="gd" count=4;
raiden add stats hp=4780 atk=311 em=187 em=187 em=187; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.3306 em=118.92 cr=0.0662 cd=0.2648;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2.2 pos=0,2.5 hp=100000000; # ADC Xianyun; Fischl Triggers some HB

#Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }
  
  furina skill, dash, burst;
  
  while .furina.skill.cd > 180 {
    if .xianyun.skill.ready {
      xianyun skill, low_plunge;
    } else if .xianyun.burst.ready && .xianyun.energy == .xianyun.energymax {
      xianyun burst;
    } else if .xianyun.status.xianyun-airborne-buff {
      xianyun jump;
      if .airborne {
        xianyun low_plunge[collision=rand()>0.5], attack;
      }
    } else {
    # Driving NA Combo
      if .xianyun.normal > 2 {
        xianyun dash;
      } else {
        xianyun attack;
      }
    }
  }
  
  raiden skill, attack;
  
  print("done");
}

