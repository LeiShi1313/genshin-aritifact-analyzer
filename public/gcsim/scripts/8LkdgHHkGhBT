xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=148.86 atk%=0.3968 er=0.4959 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active diluc; # SS stacks

for let r = 0; r < 4; r = r + 1 { 
  furina skill, dash, attack, burst;

  xianyun skill, high_plunge, burst;

  kokomi skill;  
  
  diluc skill:2, burst;
  for let h=0; h<8; h=h+1 {
    diluc jump;
    if .airborne {
      diluc high_plunge[collision=rand()>0.50];
    }
    if .diluc.status.xianyun-airborne-buff {
      diluc dash;
    }
  }
  diluc skill:3;
}
