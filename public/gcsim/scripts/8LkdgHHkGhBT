# Diluc Furina Kokomi Xianyun. ~21s Rot. Diluc Vape Plunge. Kokomi just uses skill right before Diluc. Skill uses bookend Diluc's Field time, needed to meet ER requirements. OHC > SoDP Xianyun. 50% Collisions.

# Team - Options Listed by DPS
diluc char lvl=90/90 cons=0 talent=9,9,9;
diluc add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
diluc add set="lno" count=4;
#diluc add set="cw" count=4;
diluc add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
diluc add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*3 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # ToM
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
#furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*3 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # GT

kokomi char lvl=90/90 cons=0 talent=9,9,9;
kokomi add weapon="ttds" refine=5 lvl=90/90;
#kokomi add set="clam" count=4; # Bubbles may miss
kokomi add set="no" count=4;
kokomi add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359; #main
kokomi add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*12 er=0.0551*2 em=19.82*4 cr=0.0331*2 cd=0.0662*2;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="ohc" count=4; # Bubbles may miss
xianyun add set="sodp" count=4;
#xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*9 atk%=0.0496*8 er=0.0551*9 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Functions
# Diluc Plunge
fn DilucPlunge() {
  diluc jump;
  if .airborne {
    diluc high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active diluc; # SS stacks

for let r = 0; r < 4; r = r + 1 {
  furina skill, dash, attack, burst;

  xianyun skill, high_plunge, burst;

  kokomi skill;

  diluc skill:2, burst;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc skill;
  DilucPlunge(); diluc skill:2;
}
