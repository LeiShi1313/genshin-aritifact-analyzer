xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3306 em=79.28 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Keqing Plunge Combo
fn KeqingPlunge() {
  keq jump;
  if .airborne {
    keq high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active ororon;

for let i = 0; i < 4; i = i + 1 {
  ororon skill, burst;

  furina skill, dash, burst;

  xianyun skill, low_plunge, burst;

  keq skill:2;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq burst;

  xianyun attack:2; sleep(20);

  keq skill:2;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge();
}
