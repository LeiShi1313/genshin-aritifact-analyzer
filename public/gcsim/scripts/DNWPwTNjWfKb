# Navia with Furina and Geo MC. 
# Sim picks up a shard if available on dash. 
# Geo MC and Bennett do 2 Skills each. 
# Geo MC does an additional conditional Skill.
# Note that in-game Geo MC's pillar blocks Furina's pets, so it is kinda scuffed in practice.


let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	  pick_up_crystallize("any");
  }
	
  return _execute_action(char_id, action_id, p);
}

navia char lvl=90/90 cons=0 talent=9,9,9; 
navia add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="nighttime" count=4;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cd=0.622;
navia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

luminegeo char lvl=90/90 cons=6 talent=9,9,9; 
luminegeo add weapon="wolffang" refine=1 lvl=90/90;
luminegeo add set="nighttime" count=4;
luminegeo add stats hp=4780 atk=311 er=0.518 geo%=0.466 cd=0.622;
luminegeo add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2648 cd=0.7282;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=1000;
active furina;

# Rotation:
# Furina ED Q > Navia Q > Bennett QE > GMC Q shE D > Navia hE N3D N2 > Bennett E N1 > GMC shE D > Navia hE N3D N2 (hE N1) > (GMC shE D)
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  navia burst;
  bennett burst, skill;
  luminegeo burst, skill[short_hold=1], dash;
  navia skill[hold=1], attack:3, dash, attack:2;
  bennett skill, attack;
  luminegeo skill[short_hold=1], dash;
  navia skill[hold=1], attack:3, dash, attack:2;
  if .navia.skill.ready {
    navia skill[hold=1], attack;
    luminegeo skill[short_hold=1], dash;
  }
}

