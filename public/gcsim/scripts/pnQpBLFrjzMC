# Escoffier Citlali Bennett Xianyun. ~20s Rot. Escoffier Double Cryo Melt plunge with VV. Escoffier doesn't cancel her plunges. Bennett needs favonius for smooth rotations.

# Team - Options listed by DPS
escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="fjords" refine=1 lvl=90/90;
escoffier add set="lno" count=4;
escoffier add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.2648 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
#citlali add weapon="evenstar" refine=1 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.331 cd=0.7944; # TTDS
#citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
#citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=158.56 cr=0.331 cd=0.4634; # Evenstar

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3857 em=59.46 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active xianyun;

for let i = 0; i < 4; i = i + 1 {
  xianyun skill, low_plunge, burst;

  bennett skill, burst;

  if .xianyun.sets.vv >= 4 {
    xianyun attack:2; wait(20);
  } else {
    bennett attack; # This is for TTDS rotation lenngth
  }

  citlali skill, burst;

  esco skill;
  while .xianyun.status.xianyun-airborne-buff {
    esco jump;
    if .airborne {
      esco low_plunge[collision=rand()>0.5];
    }
  }

  bennett skill;
  while .bennett.weapon == .keys.weapon.favsword && !.bennett.mods.favonius-cd {
    bennett attack;
  }
}
