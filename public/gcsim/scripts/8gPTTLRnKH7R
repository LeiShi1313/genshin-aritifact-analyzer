# Kazuha Furina Nahida Bennett. ~23s Rot. Kazuha Burgeon/Furina Burn-Vape in 2 Target. Kazuha remains on-field in Bennett's burst. P-Amber Nahida counteracts some of Furina's HP drain; fanfare decreases in later rotations. 2E Bennett builds EM. Fragile, don't get vaped.

# Team
kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
#kazuha add set="fopl" count=4;
#kazuha add set="gd" count=4;
#kazuha add set="ur" count=4;
#kazuha add set="mh" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.4634;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="pamber" refine=5 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="ins" count=4;
bennett add set="no" count=1; # (Circlet)
#bennett add stats hp=3571 atk=232 em=140.25 em=140.25 cr=0.311; #main
#bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.331 cd=0.5296;
bennett add stats hp=3571 atk=232 em=140.25 em=140.25 cr=0.311 ; #main
bennett add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.07936 atk=26.464 atk%=0.07936 er=0.08816 em=126.848 cr=0.2648 cd=0.42368 ;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.3,1.4 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=1.3,1.4 hp=100000000; 

active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  nahida skill, burst;
  
  bennett skill, burst;
  
  kazuha skill, high_plunge;
  # Covers Sac Sword
  if .kazuha.skill.ready {
    kazuha skill, high_plunge;
  }
  kazuha burst;
  while .kazuha.infusion.bennett-fire-weapon {
    if .kazuha.skill.ready {
      kazuha skill, high_plunge;
    } else if .kazuha.normal > 1 {
      if .stam > 25 {
        kazuha charge;
      }
    } else {
      kazuha attack;
    }
  }
  
  bennett skill, attack;
}
