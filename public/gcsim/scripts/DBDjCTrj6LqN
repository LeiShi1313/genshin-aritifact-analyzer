options swap_delay=12;

neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
neuvillette add stats def=39.36 def%=0.124 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

charlotte char lvl=90/90 cons=6 talent=9,9,9; 
charlotte add weapon="favoniuscodex" refine=3 lvl=90/90;
charlotte add set="scroll" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311 ; #main
charlotte add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.2204 em=39.64 cr=0.331 cd=0.2648 ;

zhongli char lvl=90/90 cons=0 talent=9,9,9; 
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="archaicpetra" count=5;
zhongli add stats hp=4780 hp%=0 atk%=0.466 atk=311 def%=0 em=0 heal=0 phys%=0 er=0 cr=0.311 geo%=0.466 cd=0;
zhongli add stats def=39.36 def%=0.124 em=39.64 atk=33.08 hp=507.88 hp%= 0.0992 atk%=0.1984 er=0.1102 cr=0.331 cd=0.7944 ;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add set="gt" count=4;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;


active neuvillette;	
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

for let x = 0; x < 4; x = x + 1 {

  neuvillette skill;
  furina skill, dash, burst;
  zhongli skill[hold=1], dash, attack:2;
  
  while !pick_up_crystallize("any") {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  }
  
  while !.zhongli.mods.favonius-cd { 
    zhongli attack;
  }

  charlotte skill[hold=1], burst;
  while !.charlotte.mods.favonius-cd {
    charlotte attack;
  }
  neuvillette charge, skill, charge, burst;
  charlotte attack:2, dash;
  if !.charlotte.mods.favonius-cd {
    charlotte attack;
  }
  neuvillette charge, charge;
  wait(173); #for the last CA
}

#Neuv E > Furina E dash Q > ZL hE dash N2 (N#) > Charlotte hE Q (N#) > Neuv C E C Q > Charlotte N2 dash (N1 if not fav proc) > Neuv 2C
# N# is NAs until fav proc