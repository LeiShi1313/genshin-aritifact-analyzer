for let i=0; i<5; i=i+1 {
  bennett skill, burst;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  chevreuse burst, skill[hold=1], attack;
  gaming burst, attack;
  delay(9);
  gaming skill, low_plunge;
  delay(17);
  gaming skill, low_plunge;
  delay(17);
  gaming skill, low_plunge;
  delay(17);
  gaming skill, low_plunge;
  delay(17);
  gaming skill, low_plunge;
  gaming skill, low_plunge;
