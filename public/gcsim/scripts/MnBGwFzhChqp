options swap_delay=12 iteration=1000;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=0]; # default is 100
skirk add weapon="azurelight" refine=1 lvl=90/90;
//skirk add weapon="finale" refine=5 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.2648 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9 +params=[start_energy=0]; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.5958;

mona char lvl=90/90 cons=4 talent=9,9,9 +params=[start_energy=0];
mona add weapon="ttds" refine=5 lvl=90/90;
mona add set="no" count=4;
mona add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
mona add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.1655 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9 +params=[start_energy=0]; 
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="scroll" count=4;
escoffier add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=1; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

active mona;  # TTDS to Skirk
skirk swap; wait(45);
escoffier skill, attack;
furina skill, dash, attack;
mona skill;
skirk swap;
while .skirk.void_rifts < 2 {
  wait(1);
}
skirk skill[hold=1], burst;   # this hE and Q will cause Stalling soon...
escoffier attack:2, dash, attack:2;   # To catch Cryo Particles from Skirk and to wait for Escoffier E cd.

furina swap;    # Furina catches Mona particles   # If its starting with 0 Energy, Furina cannot use Q before catching it.
while .furina.energy != .furina.energymax {   # Hide Energy deficient warning
  wait(1);
}

print("Loop Starts");


for let i=0; i<3; i=i+1 {
  # 1st half
  print("1st half starts");
  furina burst;
  if !i {   # Due to the setup there is stalling
    skirk swap;
    while .skirk.skill.cd {
      wait(1);
    }
  }
  skirk skill[hold=1];
  while !.escoffier.swap.ready {    # Hide ugly swap cd warning
    wait(1);
  }
  escoffier burst, skill;  
  mona skill, burst;    # TTDS to Skirk
  if !i {   # Due to the setup there is stalling
    skirk swap;
    while .skirk.burst.cd {
      wait(1);
    }
  }
  skirk burst;
  skirk skill,
        attack:5, dash,
        attack:5, dash;   # Check out if the cd is 8s
  furina swap;
  print("Skirk E cd (60 FPS) is ", .skirk.skill.cd);
  print("Skirk Q cd (60 FPS) is ", .skirk.burst.cd);
  
  # 2nd half
  print("2nd half starts");
  furina burst, skill, dash;
  escoffier burst, skill;
  mona skill, burst;    # TTDS is on cd
  skirk skill[hold=1], burst;
  escoffier attack:2, dash, attack:2;   # To catch Cryo Particles from Skirk
  furina swap;    # Furina catches Mona particles
  while !.furina.burst.ready {
    wait(1);
  }
}

# Mona start > Skirk wait > Escoffier E > Furina E > Mona E > Skirk "wait for 2 Void Rifts" hE Q > Escoffier N2D N2 > 

# Loop starts

# Furina Q > Skirk hE > Escoffier Q E N1 > Mona E Q > Skirk Q tE 2[N5D] > 
# Furina Q ED > Escoffier Q E > Mona E Q > Skirk hE Q > Escoffier N2D N2 > Furina "wait for Furina Q" 


