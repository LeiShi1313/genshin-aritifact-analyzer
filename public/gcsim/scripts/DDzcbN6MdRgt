neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;
#rolls: 3 hp%, 7 cr, 10 cd

furina char lvl=90/90 cons=0 talent=9,9,9 ;
