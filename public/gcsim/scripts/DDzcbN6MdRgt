xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.434 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.1324;
#rolls: 7 er, 8 cr, 5 def%

active furina;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  xilonen skill, attack:2, burst;
  while !.xilonen.mods.favonius-cd {
    xilonen attack;
  }
  kazuha skill, high_plunge, burst;
  while !.kazuha.mods.favonius-cd {
    kazuha attack;
  }
  neuvillette skill, burst, charge, charge, charge;
}
wait(173); #for the last CA
