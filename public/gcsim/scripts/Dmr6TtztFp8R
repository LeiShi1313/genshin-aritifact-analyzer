options swap_delay=12 iteration=1000;


beidou char lvl=90/90 cons=6 talent=9,9,9;
beidou add weapon="katsuragikirinagamasa" refine=5 lvl=90/90;
beidou add set="emblemofseveredfate" count=4;
beidou add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311 ; #main
beidou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=237.84 cr=0.1324 cd=0.4634;

kokomi char lvl=90/90 cons=0 talent=9,9,9;
kokomi add weapon="prototypeamber" refine=5 lvl=90/90;
kokomi add set="oceanhuedclam" count=4;
kokomi add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 heal=0.359; # main
kokomi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.6061 em=99.1 cr=0.0662 cd=0.1324; //build more em for increased damage

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="favoniuscodex" refine=5 lvl=90/90;
nahida add set="deepwoodmemories" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=118.92 cr=0.3972 cd=0.1986;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="rightfulreward" refine=5 lvl=90/90; //prefer rightfulreward over kitain as it removes need for extra skill cast
xiangling add set="flowerofparadiselost" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 em=187 em=187 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.3306 em=158.56 cr=0.0662 cd=0.1324;


target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
target lvl=100 resist=0.1 radius=2 pos=2.4,-1 hp=999999999;
energy every interval=480,720 amount=1;


active kokomi;


for let i=0; i<4; i=i+1 {
  nahida skill[hold=2.5], burst;
  kokomi attack, skill, dash;
  xiangling attack, skill, dash;
  beidou swap;
  delay(2); // to simulate holding beidou's skill for a bit
  beidou skill[counter=2]; //counter=2 can be guaranteed by burgeon self damage
  beidou attack:2,burst;
  xiangling burst, attack;
  kokomi attack, burst;
  kokomi attack, charge:3;
  kokomi attack:4, charge:2;
  kokomi attack:4, charge:1;
  kokomi attack; // will trigger last beidou ult proc
  nahida attack:3; // for favonius proc only, move on once particles appear
}
