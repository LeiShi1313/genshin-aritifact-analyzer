# Sethos Emilie Fischl Xiangling. ~15s Rot. Sethos Quickburn. Emilie & Xiangling burst every other rotation; Fischl alternates skill and burst. Sethos prefers Fischl just before himself. Sethos does 8N2W and uses a shadow peicing shot every other rotation for energy reasons.

# Team
sethos char lvl=90/90 cons=6 talent=9,9,9;
#sethos add weapon="hunterspath" refine=1 lvl=90/90;
sethos add weapon="slingshot" refine=5 lvl=90/90;
sethos add set="wt" count=4;
#sethos add set="ur" count=4;
sethos add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
sethos add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.3972 cd=0.3972; # EEC
#sethos add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#sethos add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.3972 cd=0.4634; # EDC

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
#fischl add set="ur" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9; 
xiangling add weapon="kitain" refine=5 lvl=90/90;
xiangling add set="deepwood" count=4;
xiangling add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.6061 em=118.92 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Combos
fn sethosCombo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk, 
         attack;
}

# Rotation
active emilie;

for let i=0; i<5; i=i+1 {
  # Burst in 2nd Rot onward
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  
  if .xiangling.burst.ready {
    xiangling burst, skill, dash;
  } else {
    xiangling attack, skill, dash;
  }
  
  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
  
  sethos skill; #aim[hold=2] # High ping only; dodges energy drain
  sethosCombo();
  if is_even(i) {
    sethos aim[hold=2];
  }
}
