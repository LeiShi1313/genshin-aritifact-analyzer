yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="shimenawasreminiscence" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
yoimiya add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=3 lvl=90/90;
yelan add set="emblemofseveredfate" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.4660 cr=0.311;
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;	

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="tenacityofthemillelith" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; # main
zhongli add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;									
	
chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbinger" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622 ; # main
chiori add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;	

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active zhongli;
for let x=0; x<4; x=x+1 {
  zhongli attack, skill[hold=1], dash;
  while (.zhongli.mods.favonius-cd==0) {
	  zhongli attack;
	}
  yelan burst, attack, skill, attack:2, dash, attack:2;
  chiori skill, skill;
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack:1;
  if .yoimiya.burst.ready && .yoimiya.energy == .yoimiya.energymax {
    yoimiya burst;
  } else {
    yoimiya attack:3;
  }
}