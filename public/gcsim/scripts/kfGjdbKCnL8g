chasca add weapon="hamayumi" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*5 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*9 cd=0.0662*12;

skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="moonweaversdawn" refine=2 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
skirk add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*10 cd=0.0662*6;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

# Cast Skirk's Q when enough Serpent Subtlety
fn skirk_burst() {
  if .skirk.serpents_subtlety >= 5 || .skirk.void_rifts > 0 {
    skirk skill[hold=1];
    wait(3);
    if .skirk.serpents_subtlety >= 50 {
      skirk burst;
    }
  }
}

active furina;

for let i=0; i<2; i=i+1 {
  furina skill, dash, burst;
  bennett skill, burst;
  skirk_burst();
  chasca skill, aim:4, burst;

  furina attack:2;
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  bennett skill, burst;
  skirk_burst();
  chasca skill, aim:4;
}
wait(126); # 126f wait for the last 6bullet CA to hit

# 33s rotations
# Furina ED Q > Bennett EQ > Skirk hE Q > Chasca E 4[C] Q > Furina N2 > Bennett EQ > Skirk hE Q > Chasca E 4[C]
