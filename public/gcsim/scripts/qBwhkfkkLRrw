# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # 2T

# Rotation
active arle;

for let i = 0; i < 4; i = i + 1 {
  arle skill;

  bennett skill, burst;

  rosaria skill, burst, attack:1;

  citlali attack:1, skill, burst;

  arle attack:1, charge[early_cancel=0], dash:0,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:1;
}
