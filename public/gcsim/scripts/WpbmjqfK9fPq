# Gaming Columbina Ineffa Chevreuse. ~20s Rot. Gaming Lunarovervape. Gaming catches Man Chai in midair, doing 7 skill plunges with delay. Chevreuse passes particles to Gaming. Ineffa's low Eletcro application barely disrupts Hydro uptime- Gaming vapes ~91% of plunges and scores Overload on most plunges.

# Team - Options listed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#gaming add set="cw" count=4;
gaming add set="notsu" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*11 er=0.0551*2 em=19.82*2 cr=0.0331*5 cd=0.0662*10; # NOTSU
#gaming add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#gaming add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10; # CW

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*9 cr=0.0331*7 cd=0.0662*10;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
#chevreuse add weapon="dialogues" refine=5 lvl=90/90;
chevreuse add set="scroll" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*8 cr=0.0331*12 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active gaming; # SS Stacks

for let i=0; i<4; i=i+1 {
  if i > 0  && .ineffa.burst.ready {
    ineffa skill, burst;
  } else {
    ineffa skill;
  }

  if i > 0 && .columbina.burst.ready {
    columbina burst, skill;
  } else {
    columbina attack:1, skill; # Better for filling time
  }

  if i == 0 {
    chev burst, skill[hold=1]:3;
  } else {
    chev attack, skill[hold=1];
  }

  gaming burst;
  for let j = 0; j < 7; j = j + 1 {
    sleep(45);
    gaming skill, high_plunge;
  }
}
