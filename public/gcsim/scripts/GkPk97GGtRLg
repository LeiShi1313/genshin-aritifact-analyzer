baizhu char lvl=90/90 cons=6 talent=9,9,9;
baizhu add weapon="kagurasverity" refine=5 lvl=90/90;
baizhu add set="deepwood" count=4;
baizhu add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311 ; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=10,10,10;
fischl add weapon="elegy" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

#enemy config

options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=3000000;
energy every interval=480,720 amount=1;
active baizhu;

#action list

for {
  switch {
  case .fischl.skill.ready && !.fischl.oz:
   fischl attack, skill;
  case .fischl.burst.ready && !.fischl.oz:
   fischl attack, burst;
  case .baizhu.skill.ready:
    baizhu skill;
  case .baizhu.burst.ready && .baizhu.energy == .baizhu.energymax:
    baizhu burst;
  case .baizhu.normal == 2 && .stam > 50:
    baizhu charge;
  case .baizhu.normal == 2:
    baizhu attack;
  default:
    baizhu attack;
}
}
