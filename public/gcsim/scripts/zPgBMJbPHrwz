# Clorinde Nahida Fischl Kuki. ~16s Rot. Clorinde Triple Electro Aggravate. Nahida bursts every other rotation after the first. Kuki attempts to burst every rotation. Fischl aternates skill and burst.

clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="scroll" count=4;
#nahida add set="tom" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

kuki char lvl=90/90 cons=6 talent=9,9,9; # start_hp=1;
kuki add weapon="wolffang" refine=1 lvl=90/90;
#kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="tom" count=4; 
#kuki add set="gt" count=4;
kuki add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.331; # DMG
#kuki add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # Heals

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;

# Clorinde Combo
fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

#Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl attack;
  if .fischl.burst.ready {
    fischl attack:1, burst;
  } else {
    fischl skill;
  }

  nahida skill; 
  if i > 0 && .nahida.burst.ready { # Wanted to fill time
    nahida attack, burst, charge;
  } else if i == 0 {
    nahida attack, charge;
  } else {
    nahida attack, charge, dash, charge;
  }
  
  kuki skill, attack;
  if .kuki.burst.ready {
    kuki burst;
  }
  
  clorinde_combo();
  clorinde burst;
}
