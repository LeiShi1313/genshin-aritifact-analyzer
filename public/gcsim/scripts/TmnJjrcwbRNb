# Itto Furina Bennett Xianyun. ~20s Rot. Itto Vape plunge with VV. Bennett EQN1 Xianyun N2. 50% Collisions.

# Team
itto char lvl=90/90 cons=0 talent=9,9,9;
itto add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#itto add weapon="rainslasher" refine=3 lvl=90/90;
itto add set="longnightsoath" count=4;
itto add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
itto add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # LNO
#itto add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
#itto add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.3641 cd=0.662; # RS, MH
#itto add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
#itto add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.1986 cd=0.662; # SS, MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2317 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Itto Plunge Combo
fn IttoPlunge() {
  itto jump;
  if .airborne {
    itto high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active furina;
#active itto; # SS stacks

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;

  xianyun skill, low_plunge, burst;

  bennett skill, burst, attack;

  xianyun attack:2; sleep(20);

  itto skill;
  IttoPlunge(); itto dash; wait(15);
  IttoPlunge(); itto dash; wait(15);
  IttoPlunge(); itto dash; wait(15);
  IttoPlunge(); itto dash; wait(15);
  IttoPlunge(); itto dash; wait(15);
  IttoPlunge(); itto dash; wait(15);
  IttoPlunge(); itto dash; wait(15);
  IttoPlunge();

  bennett skill, attack:2;
}
