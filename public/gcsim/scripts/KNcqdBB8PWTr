# --- Pre-action hook setup

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	pick_up_crystallize("any"); # Pick up crystallize before every dash
  }
	
  return _execute_action(char_id, action_id, p);
}

options swap_delay=12 iteration=1000;

# --- Team
navia char lvl=90/90 cons=0 talent=9,9,9; 
navia add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="nighttimewhispers" count=5;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311 ; #main
navia add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

zhongli char lvl=90/90 cons=0 talent=9,9,9; 
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311 ; #main
zhongli add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.5510 em=39.64 cr=0.3641 cd=0.331;

charlotte char lvl=90/90 cons=6 talent=9,9,9; 
charlotte add weapon="favoniuscodex" refine=3 lvl=90/90;
charlotte add set="no" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311 ; #main
charlotte add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.5510 em=39.64 cr=0.331 cd=0.1324 ;

target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;
active zhongli;
for let x = 0; x < 4; x = x + 1 {
  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd {
      zhongli attack;
  }
  navia burst; # catch fav particles from zhongli
  furina skill, dash, burst;
  charlotte skill, burst, attack;
  while !.charlotte.mods.favonius-cd {
    charlotte attack;
  }
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2; # catch fav particles from charlotte
  zhongli attack:2, skill;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  charlotte attack:2, dash; # catch fav particles from zhongli
  while !.charlotte.mods.favonius-cd {
    charlotte attack;
  }
  navia skill[hold=1], attack:3, dash, attack:2; # catch fav particles from charlotte
  if .navia.skill.ready {
    navia dash, skill[hold=1];
  }
}

# Zhongli hE dash > Navia Q > Furina E dash Q > Charlotte E Q N1 > 
# Navia hE N2D N2D N2 > Zhongli N2 tE > Charlotte N2D > Navia hE N3D N2(+D hE if available)