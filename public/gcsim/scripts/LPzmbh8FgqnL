# Xinyan Furina Raiden Mika. ~20s Rot. Burst DPS Phys Xinyan with Raiden on-field. Take care to ensure SC is triggered.

# Team
xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="tidalshadow" refine=5 lvl=90/90;
xinyan add set="bsc" count=2;xinyan add set="pf" count=2;
xinyan add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.2204 em=118.92 cr=0.0662 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="catch" refine=5 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311 ; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.3306 em=39.64 cr=0.0662 cd=0.5296;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  mika burst, attack, skill;

  xinyan attack:2, skill, burst, attack:2;

  raiden burst, attack:4, dash, attack:4, skill, attack:4, dash, attack:4;
}
