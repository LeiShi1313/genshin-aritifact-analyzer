# Bennett Emilie Durin Xianyun. ~20s Rot. Bennett Burning plunge with VV Xianyun. Bennett spams his skill between plunges. Xianyun refeshes VV after plunges are spent for a small DPS increase. 50% Collisions.

# Team
bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="harbinger" refine=5 lvl=90/90;
bennett add set="lno" count=4;
#bennett add set="ur" count=4;
#bennett add set="cw" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
#durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*8; # RW
#durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
#durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*10 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*4; # CG

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*7 er=0.0551*7 em=19.82*2 cr=0.0331*12 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000;

# Rotation
active bennett;
bennett skill;

for let i = 0; i < 4; i = i + 1 {
  # Burst after the 1st rot
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  durin skill, skill, burst;

  xianyun skill, high_plunge, burst;

  bennett burst, skill;
  while .bennett.status.xianyun-airborne-buff {
    bennett jump;
    if .airborne {
      bennett high_plunge[collision=rand()>0.4];
    }
    if .bennett.skill.ready {
      bennett skill;
    } else if .xianyun.status.xianyun-airborne-buff {
      bennett dash;
    }
  }

  xianyun attack:2, charge;

  while .status.bennettburst > 60 {
    if .bennett.skill.ready {
      bennett skill;
    } else if .bennett.normal > 2 {
      bennett charge, dash;
    } else {
      bennett attack;
    }
  }
}
