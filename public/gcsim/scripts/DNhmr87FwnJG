# Heizou Furina Fischl Escoffier. ~22s Rot. Heizou Freeze Wheelchair in ST. Heizou uses P-Amber so Escoffier doesn't have to burst every rotation.

# Team - Options listed by DPS
heizou char lvl=90/90 cons=6 talent=9,9,9;
heizou add weapon="pamber" refine=5 lvl=90/90;
heizou add set="vv" count=4;
heizou add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311;
heizou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2979 cd=0.5958;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=100000000;

# Max Declension Guarantee
fn declensionCombo() {
  switch {
    case .heizou.normal > 1 && .heizou.skill.ready && .heizou.declension == 4:
      heizou skill;
    case .heizou.normal > 1 && .heizou.burst.ready:
      heizou burst;
    case .heizou.normal > 1:
      heizou charge;
    default:
      heizou attack;
  }
}

#Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  if .esco.burst.ready && .esco.energy == .esco.energymax  {
    esco burst;
  }
  esco skill;

  yelan skill, burst, attack;

  while .yelan.skill.cd {
    declensionCombo();
  }

  # Yelan lingers to catch her particles
  yelan attack:1, skill, attack:4;

  while .yelan.skill.cd > 280 {
    declensionCombo();
  }
  print("done");
}
