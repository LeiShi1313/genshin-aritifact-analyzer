# Lanyan Nahida Fischl Faruzan. APL. (TF) Lanyan Aggravate with a VV Faruzan Swirling in in 2 Target. Nahida does not burst past the opener.

# Team
lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="sacfrags" refine=5 lvl=90/90;
#lanyan add weapon="hakushin" refine=5 lvl=90/90;
#lanyan add weapon="widsith" refine=3 lvl=90/90;
#lanyan add weapon="evenstar" refine=1 lvl=90/90;
#lanyan add set="gt" count=4; # More damage anyway
#lanyan add set="vv" count=4;
lanyan add set="tf" count=4;
lanyan add stats hp=4780 atk=311 em=187 anemo%=0.466 cr=0.311; #main
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.331 cd=0.5958; # EDC Anemo
#lanyan add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
#lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # EEC
#lanyan add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # 3EM
#lanyan add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
#lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.2648 cd=0.5296;# EDC Electro

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
#nahida add set="deepwood" count=4;
#nahida add set="scroll" count=4;
#nahida add set="tom" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3641 cd=0.7282;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="stringless" refine=3 lvl=90/90;
faruzan add set="vv" count=4;
faruzan add stats hp=4780 atk=311 em=187 em=187 em=187;
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=118.92 cr=0.3972 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
options duration=90;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=-1.6,1.8;
target lvl=100 resist=0.1 radius=1.5 pos=1.6,1.8;

# Rotation
active fischl;
fischl skill;

#nahida skill, attack, charge;
nahida skill, attack, burst;

for {
  switch {
    # Refesh Oz
    case !.fischl.oz && .fischl.burst.ready && .fischl.swap.ready:
      fischl attack:2, burst;
    case !.fischl.oz && .fischl.skill.ready && .fischl.swap.ready:
      fischl attack, skill;
    # VV, expeditiously
    case !.status.vvelectro && (.element.t0.electro || .element.t1.electro) && .faruzan.hurricane-count && .faruzan.swap.ready:
      faruzan aim;
    # Spend Lanyan Q & E as available
    case .lanyan.skill.ready && .lanyan.swap.ready:
      lanyan skill:2;
    case .lanyan.burst.ready && .lanyan.swap.ready && .lanyan.energy == .lanyan.energymax:
      lanyan burst;
    # Fill time with Faruzan E
    case .faruzan.burst.ready && .faruzan.swap.ready:
      faruzan burst;
    case .faruzan.hurricane-count && .faruzan.swap.ready:
      faruzan aim;
    case .faruzan.skill.ready && .faruzan.swap.ready:
      faruzan skill;
    # Refesh Nahdia E & Q
    case .nahida.skill.ready && .nahida.swap.ready && !.debuff.res.t0.nahida-e:
      nahida skill, attack;
    #case .nahida.burst.ready && .nahida.swap.ready:
    #  nahida burst;
    default:
      lanyan attack;
  }
}
