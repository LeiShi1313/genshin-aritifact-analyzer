target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
active furina;

for let r=0; r<4; r=r+1 {
  nicole skill;
  furina skill, dash, attack:2, burst;
  durin skill, attack, burst;
  if r == 0 {
    skirk burst,
        skill,
        attack:2, dash,
        attack:2, charge, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:2, charge, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3;
    furina swap;
    wait(1339-f());
  } else {
    skirk skill,
        attack:2, burst,
        attack:2, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:2, charge, dash,
        attack:3, dash,
        attack:3, dash,
        attack:2;
  }
}
