# Freminet Emilie Rosaria Bennett. ~20s Rot. Physical Freminet restablishes burning with C6 Bennett NAs. SS performance can be inconsistent with Burning. Rosaria melts nearly everything. UR Rosaria > Deepwood.

freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#freminet add weapon="talkingstick" refine=1 lvl=90/90; freminet add stats atk%=0.16; # mock implementation
#freminet add weapon="tidalshadow" refine=5 lvl=90/90;
freminet add set="ur" count=4;
#freminet add set="pf" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="ur" count=4;
#rosaria add set="deepwood" count=4;
rosaria add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311;
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=120]; # to Rosaria
bennett add set="no" count=4;
#bennett add set="deepwood" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # No Burning
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # Burning AoE

#Rotation
active freminet; # SS Stacks

for let x = 0; x < 4; x = x + 1 {
  if x && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  bennett skill, burst;

  rosaria skill, burst;

  freminet skill, burst,
         attack:2, skill, skill,
         attack:2, skill, attack, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
         attack:2, skill, attack, skill,
         attack:2, skill;
}
