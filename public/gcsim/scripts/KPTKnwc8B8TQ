# Skirk Furina Dahlia Escoffier. ~21s rot. tE N2Q 3[N5D] N2CD N5D N5. First rot Nuke included, ~3K DPS loss otherwise. Freeze Immunity loses ~4K DPS.

# Team - Options listed by DPS
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="eshu" refine=5 lvl=90/90;
skirk add set="mh" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # Eshu

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.5296;

dahlia char lvl=90/90 cons=6 talent=9,9,9;
dahlia add weapon="favsword" refine=3 lvl=90/90;
dahlia add set="no" count=4;
dahlia add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
dahlia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.1488 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mika char lvl=90/90 cons=6 talent=9,9,9; 
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="scroll" count=4;
#mika add set="sodp" count=4;
mika add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.1986;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=10000000 freeze_resist=0; # freeze_resist=1 for unfreezable

# Rotation Options
let first_Rot_Nuke = true; # true and false.

# Rotation
active furina;

for let i=0; i<4; i=i+1 { 
  furina skill, dash;
  if i > 0 {
    furina attack;
  }
  furina burst;
  
  mika skill[hold=1], attack, burst;
  
  dahlia attack, skill, burst;
  
  if i == 0 && first_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:4;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5;
  }
}

# First rot only
# Skirk Q tE N5D N2CD 2[N5D] N2CD N5D N4
# Skirk   tE N2Q      3[N5D] N2CD N5D N5
