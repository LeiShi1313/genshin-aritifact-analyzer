# Xiao Furina Fischl Xianyun. ~23s Rot. Xiao Taser. Fischl uses both skill and burst every rotatation. VV/NO vs MH/VV Xiao/Xianyun are interchangable. 50% Collisions. 

# Team - Options listed by DPS
xiao char lvl=90/90 cons=0 talent=9,9,9;
xiao add weapon="favlance" refine=3 lvl=90/90;
xiao add set="longnightsoath" count=4;
#xiao add set="mh" count=4;
#xiao add set="vv" count=4;
xiao add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
xiao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Other
#xiao add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
#xiao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # MH

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festering" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.5296; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.5296; # ToM

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
