mizuki char lvl=90/90 cons=0 talent=9,9,9;
mizuki add weapon="hakushinring" refine=5 lvl=90/90;
mizuki add set="vv" count=4;
mizuki add stats hp=4780 atk=311 em=187 em=187 em=187; # main
mizuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gt" count=4; #check gd later
yae add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main, check atk sands later
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="favsword" refine=3 lvl=90/90 +params=[pickup_delay=90];
kirara add set="scroll" count=4;
kirara add stats hp=4780 atk=311 hp%=0.466 dendro%=0.466 hp%=0.466; #main
kirara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944; # 5*

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main, check atk sands later
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active fischl;
for let i=0; i<4; i=i+1{

  kirara burst, skill[short_hold=1];
  fischl attack:2, burst;
  if i {
    yae attack, burst;
  }
  yae skill, attack, skill, attack, skill; # drive fischl

  # mizuki burst;
  mizuki skill, burst;
  while !.fischl.skill.ready {
    wait(1);
  }
  fischl attack, skill;
  kirara skill[short_hold=1];
  yae attack, skill, attack, skill, attack, skill;
  mizuki attack:3, dash, attack:3;

}
