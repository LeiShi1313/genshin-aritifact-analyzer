# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active raiden;
raiden skill;

for let x =0; x<4; x=x+1 { # Loop rotation 4 times
	jean skill, attack;
	
	sara skill, aim;
	
	lisa burst, skill[hold=1];
	
	jean skill, burst;
	
	sara burst;
	
	raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
}

