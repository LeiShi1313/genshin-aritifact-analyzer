active neuv;
for let i = 0; i < 4; i = i + 1 {
  neuv burst;
  kazuha skill, high_plunge, burst;
  zhongli skill[hold=1], dash, dash, attack;
  // wait for up to 10 frames to pick up hydro crystallize
  for let k=0; k<10; k=k+1 {
     if .gadgets.crystallizeshard.hydro > 0 { pick_up_crystallize("hydro"); break; }
     wait(1);
  }
  shenhe attack, skill[hold=1], attack;
  kazuha skill, high_plunge;
  neuv charge, charge, skill;
  kazuha skill, high_plunge, burst;
  zhongli skill[hold=1], dash, dash, attack;
  // wait for up to 10 frames to pick up hydro crystallize
  for let k=0; k<10; k=k+1 {
     if .gadgets.crystallizeshard.hydro > 0 { pick_up_crystallize("hydro"); break; }
     wait(1);
  }
  shenhe attack, skill[hold=1], attack;
  kazuha skill, high_plunge;
  neuv charge, skill, charge;
}
