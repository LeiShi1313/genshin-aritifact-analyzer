# Rosaria Furina Lisa Mika. ~22s Rotation. Physical Rosaria does N2CD stamina permitting, otherwise does NA spam. Lisa goes just before Furina to avoid taking buff uptime. Rosaria does 3 skills, passing particles from her last skill to Lisa.

# Team - Options Listed by DPS
rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="cpike" refine=5 lvl=90/90;
rosaria add set="mh" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; # main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662; # ATK
#rosaria add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; # main
#rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662; # Phys

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.331; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.331; # ToM

lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="fruit" refine=5 lvl=90/90;
lisa add set="gd" count=4;
lisa add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5456 er=0.3857 em=158.56 cr=0.0662 cd=0.1324;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
#mika add set="no" count=4;
#mika add set="sodp" count=4;
mika add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.3306 em=79.28 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active lisa;

for let i=0; i<4; i=i+1 {
  lisa skill[hold=1], burst; sleep(20);# Catch her own particles

  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  mika burst;
  mika skill[hold=0];

  rosaria skill, burst;

  # Skill as Available for Cpike passive
  while .rosaria.mods.mika-c6 {
    if .rosaria.skill.ready {
      rosaria skill;
    } else if .rosaria.normal > 3 && .stam > 43 {
      rosaria charge, dash;
    } else {
      rosaria attack;
    }
  } # Ends on 3rd Rosaria skill

}
