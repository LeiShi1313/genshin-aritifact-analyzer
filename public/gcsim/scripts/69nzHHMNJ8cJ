# Gaming Rosaria Sucrose Bennett. ~13s Rot. 1 Rotation Gaming Melt simulating low-cost speedrunning. 
# 5 Melted plunges with TTDS VV Sucrose Burst Infusion. 6th plunge is ~10k DPS loss due to buff uptime. Bennett Skill is another ~5k DPS loss. 
# Accounting for subsequent rotations loses significant DPS due to energy requirements and TTDS cooldown. (Steal energy from the top half of abyss)

# Team
gaming char lvl=90/90 cons=6 talent=9,9,9; 
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
#rosaria add set="instructor" count=4;
rosaria add set="scroll" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311 ; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="ttds" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3641 cd=0.5958;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active gaming; # SS Stacks

for let i=0; i<1; i=i+1 {
  bennett burst;
  
  rosaria burst;
  
  sucrose skill, dash, burst;
  
  gaming burst;
  wait(25);
  for let p=0; p<5; p=p+1 {
    gaming skill;
    wait(17);
    gaming low_plunge;
  }

}

