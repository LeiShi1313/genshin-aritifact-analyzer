mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="sacrificialjade" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=4;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
mualani add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*10 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*2 cd=0.0662*10;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacfrag" refine=3 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187; #main
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*12 em=19.82*6 cr=0.0331*2 cd=0.0662*2;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.062*5 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

luminepyro char lvl=90/90 cons=6 talent=9,9,9;
luminepyro add weapon="favsword" refine=3 lvl=90/90;
luminepyro add set="ap" count=4;
luminepyro add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
luminepyro add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mualani;

for let i=0; i<3; i=i+1 {
  mualani attack;
  xilonen skill, attack:2;
  sucrose skill, dash, burst;
  luminepyro burst, dash; pick_up_crystallize("hydro");
  mualani skill;
  if .mualani.burst.ready {
    mualani walk[f=1], burst,
            walk[f=46], attack;
  } else {
    mualani walk[f=91], attack;
  }
  mualani walk[f=91], attack,
          skill;
 
  mualani attack, charge;
  xilonen burst, skill, attack:2;
  sucrose skill, dash, attack;
  luminepyro dash, skill; pick_up_crystallize("hydro");
  mualani skill, walk[f=90], attack,
                 walk[f=90], attack,
                 walk[f=90], attack,
          skill, charge;
}

# ~15s rotations
# Mualani N1  > Xilonen   E N2 > Sucrose EDQ   > Pyro Traveler QD    > Mualani E (Q) 3[3-stacked bite] >
# Mualani N1C > Xilonen Q E N2 > Sucrose ED N1 > Pyro Traveler D tE  > Mualani E     3[3-stacked bite] C