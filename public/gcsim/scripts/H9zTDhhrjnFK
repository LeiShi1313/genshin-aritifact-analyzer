options swap_delay=12 iteration=500;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworneye" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=.3857 em=39.64 cr=0.1655 cd=0.1324 ;

hutao char lvl=90/90 cons=0 talent=9,9,9 +params=[start_hp%=70];
hutao add weapon="fjords" refine=1 lvl=90/90;
hutao add set="mh" count=4;
hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
hutao add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2979 cd=0.662 ;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
#yelan add set="esf" count=4;
yelan add set="no" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ;
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2648 cd=0.7944 ;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=.466 hp%=0.466 cd=0.622 ;
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662 ;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active furina;
for let i = 0; i < 3; i = i + 1 {
  if !i {
    furina skill, dash;
  } else {
    furina burst, skill, dash;
  }
  if !i {
    xianyun skill, low_plunge;
    furina burst;
  }
  xianyun burst;
  if i{
    xianyun attack;
  }
  yelan burst, attack, skill, attack;
  hutao skill;
  for let p = 6; p > 0; p = p - 1 {
    hutao attack, charge, jump;
    if .airborne {
      hutao low_plunge[collision=rand()>0.5];
    }
  }
  hutao attack;
  yelan skill, attack:2;
  xianyun skill, low_plunge, attack:3;
}
