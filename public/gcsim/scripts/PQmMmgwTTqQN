escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*9 em=19.82*2 cr=0.0331*5 cd=0.0662*9;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active furina;
#active freminet; # with SS

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  esco skill, burst;

  columbina attack, skill;

  # EQ N2E 2[EN2E N1] EN2 E
  freminet skill, attack:1, burst,            # Extra N1 for Shatter
           attack:2, skill, attack:1, skill,  # Extra N1 for Shatter
           attack:2, skill, attack:1, skill,  # First skill for 4 stack Pers, 2nd skill starts Pers Time
           attack:2, skill, attack:1, skill,
           attack:3, skill;                   # Burst expires early, so do an extra N1
}
