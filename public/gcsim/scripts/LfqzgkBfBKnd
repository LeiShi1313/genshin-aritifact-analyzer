# Gaming Diona Lynette Xianyun. ~20s Rot. Proof of concept Gaming Melt using solo Cryo Diona. 7/7 Melted plunges by using Lynette's burst infusion. Give up on Ins Diona.

# Team - Options listsed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
gaming add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*12 cd=0.0662*9;

diona char lvl=90/90 cons=6 talent=9,9,9;
diona add weapon="favbow" refine=4 lvl=90/90;
diona add set="sodp" count=4;
#diona add set="ins" count=4; # Get real
diona add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
diona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*10 cd=0.0662*6; # NO
#diona add stats hp=3571 atk=232 er=0.518 hp%=0.3495 cr=0.23325; #main
#diona add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.277704 em=33.2976 cr=0.27804 cd=0.111216; # Ins

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="favsword" refine=3 lvl=90/90;
lynette add set="no" count=4;
#lynette add set="vv" count=4;
lynette add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311; #main
lynette add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*2 cr=0.0331*10 cd=0.0662*7;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*8 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active gaming; # SS Stacks
gaming skill, high_plunge;

for let i = 0; i < 4; i = i + 1 {
  xianyun skill, low_plunge, burst;

  lynette skill, burst;

  diona skill[hold=1], burst;

  gaming burst, attack;
  let plungeCount = 0;
  for let j = 0; j < 5; j = j + 1 {
    sleep(45); # Cacth Manchai during descent
    gaming skill, high_plunge; plungeCount = plungeCount + 1; print(plungeCount);
  }
  sleep(30); # Catch Manchai during descent
  gaming skill, high_plunge; plungeCount = plungeCount + 1; print(plungeCount); # Xianyun Buff expires, Catch Manchai Grounded
  gaming skill, high_plunge; plungeCount = plungeCount + 1; print(plungeCount);
}
