# Bennett Nahida Yelan Xingqiu. ~21s Rot. Simple Double Hydro Bennett Burgeon rotation where Nahida > XQ > Yelan > Bennett. CW and MH are very close. 

# Team
bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="finale" refine=5 lvl=90/90;
#bennett add weapon="umbrella" refine=5 lvl=90/90;
#bennett add weapon="ironsting" refine=5 lvl=90/90;
#bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="cw" count=4;
#bennett add set="mh" count=4;
#bennett add set="gd" count=4;
#bennett add set="fopl" count=4;
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # Em/Py/Cr; CW/GD
#bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
#bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # Em/Py/Cd; MH
#bennett add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # Em/Em/Cr; CW/GD
#bennett add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # Em/Em/Cd; MH

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.1655 cd=0.331;

yelan char lvl=90/90 cons=0 talent=9,9,9; 
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
 
xingqiu char lvl=90/90 cons=6 talent=9,9,9; 
xingqiu add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=350];
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=500; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

#Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  nahida skill;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  
	xingqiu skill, dash, burst, attack;
	
	yelan skill, attack, burst, attack;
	
	# Attack string can likely be optimized
	bennett burst, attack;
  while .xingqiu.mods.xingqiuburst {
  #while .yelan.mods.yelanburst {
  #while .bennett.infusion.bennett-fire-weapon {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }

}

