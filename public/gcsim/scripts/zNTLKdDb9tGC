options swap_delay=12 iteration=1000;

# Build assumptions
ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="aubadeofmorningstarandmoon" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="lionsroar" refine=3 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="silkenmoonsserenade" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.2317 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="sacbow" refine=5 lvl=90/90;
fischl add set="cg" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active fischl;
for let i=0; i<6; i=i+1 {
  fischl swap;
  let StartFrame = f();
  fischl attack, skill;
  if is_even(i) {
    ineffa skill, attack;
    columbina burst, skill;
  } else {
    ineffa skill, burst;
    columbina skill, attack;
  }
  fischl attack:2, burst;
  durin skill, burst, skill;
  durin swap;
  if is_even(i) {
    while f() - StartFrame < 1040 {
      if .durin.normal == 4 && .stam > 20 {
        durin dash;
      }
      durin attack;
      if .durin.normal == 2 && .stam > 50 {
        durin charge, dash;
      }
    }
  } else {
    while f() - StartFrame < 1070 {
      if .durin.normal == 4 && .stam > 20 {
        durin dash;
      }
      durin attack;
      if .durin.normal == 2 && .stam > 50 {
        durin charge, dash;
      }
    }
  }
}
