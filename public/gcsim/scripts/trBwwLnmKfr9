lyney char lvl=90/90 cons=0 talent=9,9,9 +params=[start_hp%=80];
lyney add weapon="prototypecrescent" refine=5 lvl=90/90;
lyney add set="marechausseehunter" count=4;
lyney add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
lyney add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662 ;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="totm" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311 ; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="ap" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662 ;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,3;
energy every interval=480,720 amount=1;

active furina;

let rotations = 5;

for let r = rotations; r > 0; r = r - 1 {

  if r != rotations { #not necessary on the first rotation
    lyney aim;
  }

  if .furina.skill.ready { #furina uses skill and burst every other rotation
    if !.furina.burst.ready {
      bennett skill;
    }
    while !.furina.burst.ready {
      furina attack;
    }
    furina skill, dash;
    delay(2);
    furina burst;
  }

  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }

  bennett burst, skill, dash, walk;

  #if there's a pyro shard, pick it, otherwise, pick a hydro shard
  if .gadgets.crystallizeshard.pyro {
    pick_up_crystallize("pyro");
  } else if .gadgets.crystallizeshard.hydro {
    pick_up_crystallize("hydro");
  }

  lyney aim[weakspot=1], aim, aim, aim[weakspot=1];

  if .lyney.burst.ready {
    lyney burst;
    delay(11); # Just so he doesn't cancel his own burst before it deals damage
    lyney skill;
  }
  else {
    lyney aim;
  }

  lyney skill;

}

#rotation: furina EdQ > Zhongli hEd > Bennett QEd > Lyney 4CA QE E >
#                       Zhongli hEd > Bennett QEd > Lyney 5CA E
