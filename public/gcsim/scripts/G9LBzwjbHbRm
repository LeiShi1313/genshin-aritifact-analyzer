xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="deepwood" count=5;
xiangling add stats hp=4780 atk=311 em=186.5 em=186.5 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=79.28 cr=0.331 cd=0.1324;

options swap_delay=12 iteration=1000;

active neuvillette;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;


for let i=0; i<4; i=i+1 {
  neuvillette skill;
  furina skill, dash, burst;
  emilie attack, skill;
  xiangling burst, skill;
  neuvillette charge, burst, skill, charge;
  emilie burst;
  xiangling attack:3, skill, dash;
  if !.xiangling.mods.favonius-cd {
    xiangling attack;
  }
  neuvillette charge, charge;
}

wait(173);
