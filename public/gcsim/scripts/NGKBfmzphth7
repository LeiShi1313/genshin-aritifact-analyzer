fischl add set="tenacityofthemillelith" count=5;
fischl add stats def%=0.10899999999999999 def=23 hp=4670 atk=344 atk%=0.45799999999999997 electro%=0.466 er=0.36799999999999998 em=42 cr=0.572000000000003 cd=0.614;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="thrillingtalesofdragonslayers" refine=5 lvl=40/40;
mona add set="celestialgift" count=5;
mona add stats def%=0.307 def=139 hp=5467 atk=356 atk%=0.152 er=1.435 cr=0.626 cd=0.21000000000000002 hydro%=0.466;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 radius=3 pos=0,3.4 hp=9999999999999999;
energy every interval=480,720 amount=1;

active arlecchino;

for let i=0; i<7; i=i+1 {
  arlecchino skill; delay(11);
  bennett skill, burst;
  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }
  mona burst, attack:1;
  arlecchino charge, attack:3;
  mona attack:1, skill, attack:1;
  arlecchino attack:3, dash, attack:3, dash, attack:3, dash, attack:3, dash, attack: 2;
}
