bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="finaleofthedeep" refine=5 lvl=90/90;
bennett add set="cw" count=4;
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main for gt
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main for totm
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=3 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  yelan burst, attack , skill;
  bennett burst, attack, skill;
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  bennett attack;
  while .status.bennettburst {
      if .bennett.skill.ready {
        bennett skill;
      } else {
        bennett attack;
      }
  }
  bennett attack:3, skill;
}
