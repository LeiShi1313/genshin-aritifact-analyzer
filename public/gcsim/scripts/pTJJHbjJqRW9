# --- Rotation
active xingqiu;

for let i=0; i<4; i=i+1 {
  xingqiu skill, burst, attack;
  nahida skill, attack, burst, attack;
  kuki skill, attack;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
