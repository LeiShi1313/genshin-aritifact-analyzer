options swap_delay=12 iteration=1000;


hutao char lvl=90/90 cons=0 talent=9,9,9 +params=[start_hp=1];
hutao add weapon="dragonsbane" refine=3 lvl=90/90;
hutao add set="mh" count=4;
hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
hutao add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=4 lvl=90/90;
yelan add set="emblemofseveredfate" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="songofdayspast" count=4;
#bennett add set="ohc" count=4;
bennett add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.5958;

furinadefontaine char lvl=90/90 cons=0 talent=9,9,9;
furinadefontaine add weapon="festeringdesire" refine=5 lvl=90/90;
furinadefontaine add set="gt" count=4;
furinadefontaine add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furinadefontaine add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

active furinadefontaine;
target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<3; i=i+1 {
  furinadefontaine skill, dash, burst;
  if i > 0 {
    furina attack;
  }

  if i == 0 {
    bennett skill, burst;
  }
  else {
    bennett burst, skill;
  } #bennett doesn't need to be healed 1st rotation and also gets to catch his own particles

  while !.yelan.mods.favonius-cd && !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst;
  if i == 0 {
    yelan attack;
  } #not swapping to furina and doing normal attacks first rotation so yelan has to proc her own burst

  if i > 0 {
    furinadefontaine attack:2;
  } #furina doesn't need to be healed 1st rotation

  yelan  skill, attack;

  hutao skill,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:1, charge, jump,
      attack:2, charge, jump, attack;

  yelan skill, attack:2;

  bennett skill;
  if i == 0 {
    bennett attack;
  } # yelan's burst will still be active first rotation only
}
#First rotation: Furina E Q > Bennett E Q > Yelan Q N1 E N1 > Hu Tao 8N1C N2C N1 > Bennett E N1;
#Subsequent rotations: Furina EQ > Bennett QE > Yelan Q > Furina N2 > Yelan N1 E N1 Hu Tao 8N1C N2C N1 > Bennett E;
