# Freminet Furina Chongyun Xianyun. ~20s Rot. Freminet Shatterplunge with FavGS Chongyun. 
# Conistent Cryo Swirl, inconsistent Hydro Swirl. 
# Combo: (2E 7JPD 1JP 2E Q2E/N3). 50% Collisions.

# Team - Options ordered by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#freminet add weapon="fruitfulhook" refine=5 lvl=90/90;
freminet add set="longnightsoath" count=4;
#freminet add set="sr" count=4;
#freminet add set="bs" count=4; 
#freminet add set="mh" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # SR/LNO
#freminet add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
#freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; BS
#freminet add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
#freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=49.62 atk%=0.496 er=0.1102 em=39.64 cr=0.1655 cd=0.662; # MH

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.331;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
