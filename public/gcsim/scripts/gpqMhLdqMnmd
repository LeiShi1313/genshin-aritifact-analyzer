xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Freminet Plunge Combo
fn FreminetPlunge() {
  freminet jump;
  if .airborne {
    freminet high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active freminet; # SS stacks

for let x = 0; x < 4; x = x + 1 {
  furina skill, dash, attack, burst;
  
  chongyun burst, skill;
  
  xianyun skill, low_plunge, burst; # Not worth trying Hydro Swirl
  
  freminet skill:2; 
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash; # Chongyun A4 Drop
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet skill:2;
  # Cryo Shattering Pressure combo
  while .furina.skill.cd {
    if .freminet.skill.ready {
      freminet skill;
    } else if .freminet.burst.ready {
      freminet burst;
    } else {
      xianyun attack;
    }
  }
  # Use final skill
  if .freminet.mods.freminet-pers-time {
    freminet skill;
  }
  
  print("done");
}

