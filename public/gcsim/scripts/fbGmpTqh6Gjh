options swap_delay=12 iteration=2000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active neuvillette;

for let i=0; i<4; i=i+1 {
  neuvillette skill;
  furina attack, skill, dash;
  xilo burst, skill, attack:2; # E Q N2 is similar DPS
  yelan burst, attack, skill; pick_up_crystallize("hydro");
  yelan attack;
  furina burst, attack;
  neuvillette charge, skill, charge, burst;
  xilonen skill, attack:2;
  yelan attack;
  yelan skill; pick_up_crystallize("hydro"); # E N1 is similar DPS
  neuvillette charge, charge;
}
wait(173); #for the last CA

# ~28s rot
