target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active raiden;

raiden skill;
for let i = 0; i < 5; i = i + 1 {
  chevreuse burst, skill[hold=1], dash, attack;
  if i {
    xiangling attack:2, dash;
  }
  sara skill, aim, attack;
  xiangling burst, skill, dash;
  sara burst;
  raiden burst, attack:4, skill;
  while .raiden.mods.raidenburst {
    if .raiden.normal > 4 {
      raiden dash;
    } else {
      raiden attack;
    }
  }
}
