#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # SoS

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=-1.6,1.8 hp=100000000;
#target lvl=100 resist=0.1 radius=1.5 pos=1.6,1.8 hp=100000000;

# Lynette Rotation
fn LynetteCombo() {
  # Keep Lynette skill on CD
  if .lynette.skill.ready {
    lynette attack, skill;
  } else if .lynette.burst.ready && .lynette.energy == .lynette.energymax {
    lynette attack, burst;
  } else if .lynette.normal > 4 && .stam > 25 {
    lynette charge;
  } else {
    lynette attack;
  }
}

# Rotation
active fischl;
fischl skill, attack;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  
  if i > 0 {
    bennett attack;
  }
  bennett skill, burst;
  
  # burst over skill
  amy attack;
  if .amy.burst.ready && .amy.energy == .amy.energymax {
    amy attack:1, burst;
  } else {
    amy skill;
  }
  
  lynette burst, attack;
  # While Oz is on field
  while .fischl.oz { #|| .lynette.mods.bennett-field {
    LynetteCombo();
  }
  
  bennett skill;

  print("done");
}

