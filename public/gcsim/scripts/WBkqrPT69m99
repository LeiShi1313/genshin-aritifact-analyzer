# Lynette Furina Fischl Bennett. ~20s Rot. On-field Lynette Soup in ST Target with C6 Bennett infusion contributing overloads. Fischl snapshots Bennett's buff. Fischl alternates skill and burst.

# Team- Option Listed by DPS
lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="xiphos" refine=1 lvl=90/90;
lynette add set="vv" count=4; # +DMG, -Fun
#lynette add set="tf" count=4;
lynette add stats hp=4780 atk=311 em=187 em=187 em=187; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=118.92 cr=0.3641 cd=0.2648;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.331; # Gt
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.331;# ToM

fischl char lvl=90/90 cons=6 talent=9,9,9;
