clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
clorinde add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 def=39.36 def%=0.124 em=39.64 er=0.1102 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main
fischl add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=79.28 er=0.1102 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; # main
kazuha add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=118.92 er=0.1102 cr=0.331 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="totm" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; # main
nahida add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=118.92 er=0.1102 cr=0.2979 cd=0.7282;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active fischl;

# opening rotation skips clorinde burst
fischl burst;
kazuha burst;
nahida skill, attack;
clorinde skill:1;
for let i=0; i<6; i=i+1 {
  clorinde attack:3, skill;
}
clorinde attack;

for let r=0; r<5; r=r+1 { # 5 rotations (in addition to modified opening rotation)

  kazuha skill, high_plunge; # swirl between clorinde skill combo and burst to refresh VV and kazuha A4
  clorinde burst;
  nahida skill;
  if .fischl.burst.ready { # fischl burst every other rotation
    fischl attack:2, burst;
  } else {
    fischl attack, skill, attack;
  }
  if .kazuha.burst.ready { # kazuha burst every other rotation
    kazuha attack, burst; # normal attack to guarantee electro swirl via fischl C6
  } else {
    kazuha skill, high_plunge;
  }
  clorinde skill:2;
  for let i=0; i<6; i=i+1 {
    clorinde attack:3, skill;
  }
}
