# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # burning AoE damage

# Rotation
active emilie;

for let i=0; i<4; i=i+1 {
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  
  bennett skill, burst;
  
  #if .haitham.burst.ready { # && .haitham.energy == .haitham.energymax {
    haitham burst;
  #}
  
  amy attack;
  if .amy.skill.ready {
    amy skill;
  } else {
    amy attack, burst;
  }
  
  alhaitham attack:3, charge, dash, 
            attack:3, dash,
            attack:3, charge, dash,
            attack:1;
  
  bennett skill;
  
  alhaitham skill[hold=1], low_plunge[short=1],
            attack:4, charge, dash,
            attack:2;
}
