options swap_delay=12 iteration=1000;

# Build assumptions
neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacjade" refine=1 lvl=90/90;
neuvillette add set="marechausseehunter" count=5;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="etherlightspindlelute" refine=5 lvl=90/90;
lauma add set="deepwood" count=5;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187;
// 4pc SMS
//lauma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=79.28 cr=0.3972 cd=0.5296;
// 4pc Deepwood
lauma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.4634;

kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="fopl" count=4;
kuki add stats hp=4780 atk=311 em=187 em=187 em=187;
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active neuv;
for let i=0; i<4; i=i+1 {
  neuvillette skill, attack;
  furina skill, dash, attack;
  kuki skill, attack;
  lauma attack, burst;
  if !i {
    lauma skill, attack;
  } else {
    lauma skill[hold=1];
  }
  furina burst;
  neuvillette attack, charge, skill, charge, burst;
  if .kuki.burst.ready {
    kuki burst;
  }
  lauma attack, skill[hold=1];
  neuvillette attack, charge:2;
}
wait(173);

# Neuvillette E N1 > Furina E > Kuki E N1 > Lauma N1 Q ( tE N1 / hE ) > Furina Q > Neuvillette N1 C E C Q > ( Kuki Q ) > Lauma N1 hE > Neuvillette N1 2[C]
