# Raiden Emilie Fischl Xinyan. ~18s Rot. Raiden Emilie Quickburn, with Emilie using Raiden's energy restoration to burst every rotation. Xinyan's shield uptime is very suspect in practice. ToM Raiden is marginally better.

# Team - Options listed by DPS
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="fjords" refine=1 lvl=90/90;
#raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="emblem" count=4;
#raiden add set="tom" count=4;
raiden add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="aquamarine" refine=1 lvl=90/90;
xinyan add set="deepwood" count=4;
xinyan add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.4408 em=118.92 cr=0.0662 cd=0.3972;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  emilie burst;
  
  fischl attack:2, burst;
  
  while .xinyan.skill.cd {
    xinyan attack;
  }
  xinyan skill, burst;
  while .raiden.burst.cd {
    xinyan attack;
  }
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  
  if .fischl.skill.ready {
    fischl attack, skill;
  }
}
