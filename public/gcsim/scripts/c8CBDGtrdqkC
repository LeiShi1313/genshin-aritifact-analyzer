xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #mainstats
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.6061 em=39.64 cr=0.2979 cd=0.1324;

#enemy config

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
active furina;

#action list 

for let i = 0; i < 4; i = i + 1 {

  furina skill, dash, burst;
  
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  
  xianyun skill, low_plunge, burst;
  
  gorou attack, skill, burst;
  
  while !.gorou.mods.favonius-cd {
    gorou attack;
  }
  
  itto attack, burst[prestack=1], skill;
  
  for let p = 8; p > 0; p = p - 1 {
    itto jump;
    if .airborne {
    itto high_plunge[collision=rand()>0.5], dash;
    }
  }
  
  itto charge:4, skill, charge;
}