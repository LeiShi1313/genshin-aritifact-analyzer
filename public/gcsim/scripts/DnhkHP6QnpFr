#team config

itto char lvl=90/90 cons=0 talent=9,9,9;
itto add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
itto add set="marechausseehunter" count=4;
itto add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mainstats
itto add stats def%=0.434 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.0993 cd=0.662;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="cinnabarspindle" refine=5 lvl=90/90;
chiori add set="goldentroupe" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #mainstats
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3310 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favoniuscodex" refine=3 lvl=90/90;
xianyun add set="oceanhuedclam" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #mainstats
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.4408 em=39.64 cr=0.3972 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="goldentroupe" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #mainstats
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.1324 cd=0.7944;

#enemy config

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
active furina;

#action list

for let i = 0; i < 4; i = i + 1 {

  furina skill, dash, burst;

  while !.furina.mods.favonius-cd {
    furina attack;
  }

  chiori skill, dash, skill; #dash to justify crystallize pickup during xianyun uptime
  xianyun skill, low_plunge, burst;

  pick_up_crystallize("any");

  while !.xianyun.mods.favonius-cd {
    xianyun attack;
  }

  itto attack, burst, skill;

  for let p = 8; p > 0; p = p - 1 {
    itto jump;
    if .airborne {
    itto high_plunge[collision=rand()>0.5], dash;
    }
  }

  itto charge:3, skill, charge;
}
