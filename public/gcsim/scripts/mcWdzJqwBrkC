mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=118.92 cr=0.3972 cd=0.1324; # 3EM
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.1324 cd=0.662; # ADC; SS
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.1324 cd=0.662; # ADC; Other

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active dori; # SS Stacks

for let i=0; i<4; i=i+1 {
  # Burst in 2nd Rot onward
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst, attack;
  } else {
    emilie skill, attack;
  }
  
  if .mav.burst.ready {
    mav burst, skill;
  } else {
    mav skill, attack;
  }
  
  if .fischl.skill.ready {
    fischl attack, skill, attack;
  } else {
    fischl attack:2, burst;
  }
  
  dori skill, attack:2, dash, attack:2, burst;
  dori skill, attack:2, dash, attack:2;
  dori skill, attack:2, dash, attack:2;
}
