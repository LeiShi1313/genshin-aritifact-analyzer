# Dori Emilie Fischl Mavuika. ~20s Rot. Dori Quickburn with long field time Dori & 42% Burning uptime. Emilie bursts every other rotation after the first. Fischl alternates skill and burst, then Dori stays on field for 3 skill uses, as her C6 infusion downtime is near eliminated. Deepwood Fischl narrowly edges out GT for team DPS. 

# Team
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#dori add weapon="mailedflower" refine=5 lvl=90/90;
#dori add weapon="talkingstick" refine=1 lvl=90/90; dori add stats electro%=0.12; # Passive not implemented
dori add set="tf" count=4;
dori add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; #EDCd; SS
