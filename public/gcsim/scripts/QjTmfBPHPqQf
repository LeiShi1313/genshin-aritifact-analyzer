mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="sacrificialjade" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=5;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
mualani add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.0662 cd=0.662;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="finaleofthedeep" refine=5 lvl=90/90;
lynette add set="vv" count=4;
lynette add stats hp=4780 atk=311 anemo%=0.466 atk%=0.466 cr=0.311 ; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; #main
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

xiangling char lvl=90/90 cons=3 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="ap" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.331 cd=0.4634;

options swap_delay=12 iteration=1000;

active mualani;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;


fn mualani_combo2() {
  #doing 2[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<2; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

fn mualani_combo3() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

for let i=0; i<4; i=i+1 {

  mualani attack;

  if .xiangling.burst.ready {

    lynette skill;
    xilonen skill, attack:2;
    #lynette skill;
    xiangling burst, attack, skill, dash, attack;
    pick_up_crystallize("hydro");

    mualani skill;
    mualani_combo2();
    mualani skill, burst[travel=7];

  } else {
    #lynette skill;
    xilonen skill, attack:2;

    lynette skill;

    xiangling skill, dash, attack;
    pick_up_crystallize("hydro");

    mualani skill;
    mualani_combo3();
    mualani skill;
  }
}
