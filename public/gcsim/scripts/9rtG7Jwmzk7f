# Razor Furina Xingqiu Charlotte. ~23s rotation. Razor stays on field until Xingqiu's burst expires; Superconduct covers all of Razor's field time. Xingqiu uses burst after Furina. Charlotte OHC > SODP > NO.
# WIP

# Team- Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="risingwinds" count=4;
#razor add set="mh" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10; # RW
#razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*3 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*7 cd=0.0662*10; # MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*12 cd=0.0662*9; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*12 cd=0.0662*9; # ToM

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="no" count=4;
#xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="favcodex" refine=3 lvl=90/90;
charlotte add set="ohc" count=4;
#charlotte add set="no" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
charlotte add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*10 em=19.82*2 cr=0.0331*10 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active razor; # SS Stacks
razor skill, dash;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  xq skill, dash, burst, attack;

  charlotte skill, attack, burst, attack;

  razor skill[hold=1], dash, attack, burst;
  while .xq.mods.xingqiuburst {
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}
