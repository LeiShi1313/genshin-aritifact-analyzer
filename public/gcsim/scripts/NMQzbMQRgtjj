# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=-1.6,1.8 hp=100000000;
target lvl=100 resist=0.1 radius=1.5 pos=1.6,1.8 hp=100000000;

# Kazuha TF Rotation
fn TFCombo() {
  # Keep Kazuha skill on CD
  if .kazuha.skill.ready {
    kazuha skill, high_plunge[collision=rand()>0.3];
  } else if .kazuha.burst.ready && .kazuha.energy == .kazuha.energymax {
    kazuha burst;
  } else {
    kazuha attack;
  }
}

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  # Don't spend Kuki C4
  kuki skill;
  #kuki skill, attack;

  # Omit burst without energy; small gain
  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }

  # Optimally bursts every rotation
  #if .kuki.burst.ready {
    kuki burst;
  #}

  # Kazuha Field Time
  kazuha attack;
  while .furina.skill.cd {
    TFCombo();
  }

  print("done");
}
