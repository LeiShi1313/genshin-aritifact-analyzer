# Alhaitham Emilie Raiden Xianyun. ~24s Rot. Alhaitham Quicken Plunge. AlHaitham uses skill, spams JlPN1, then bursts, followed by abbreviated Raiden field time. Emilie is delivered enough energy to burst every rotation. OHC > SoDP Xianyun, but Bubbles may miss. 60% Collisions.

# Team - Options ordered by DPS
haitham char lvl=90/90 cons=0 talent=9,9,9;
haitham add weapon="harbinger" refine=5 lvl=90/90;
#haitham add weapon="wolffang" refine=1 lvl=90/90;
haitham add set="longnightsoath" count=4;
#haitham add set="gd" count=4;
#haitham add set="deepwood" count=4;
haitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311;
haitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.331 cd=0.7944; # HoD
#haitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622;
#haitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.3972 cd=0.662; # WF

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="deepwood" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

raiden char lvl=90/90 cons=0 talent=9,9,9; 
raiden add weapon="catch" refine=5 lvl=90/90;
raiden add set="scroll" count=4;
#raiden add set="tom" count=4;
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.3857 em=39.64 cr=0.3972 cd=0.331;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="no" count=4;
#xianyun add set="sodp" count=4;
#xianyun add set="deepwood" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.4959 em=39.64 cr=0.0662 cd=0.1986;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active raiden;
raiden skill;

for let x = 0; x < 4; x = x + 1 {
  if .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill;
  }
  
  xianyun skill, low_plunge, burst;
  
  haitham skill[hold=1], low_plunge[short=1];
  # Plunge Combo w/ skill as available
  while .haitham.status.xianyun-airborne-buff {
    haitham jump;
    if .airborne {
      haitham low_plunge[collision=rand()>0.4];
    } 
    haitham attack:1;
  }
  haitham burst;
  
  raiden burst, attack:4, skill, attack:4;
  
  print("done");
}

