# Arlechinno Nahida Yelan Zhongli. ~18s Rot. Arlechinno with Token Burgeon, with Zhongli Keeping the team alive. Burstless Nahida. Zhongli could technically hold Deepwood.

# Team
arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
#arle add weapon="fjords" refine=1 lvl=90/90;
arle add set="fohw" count=5;
#arle add set="ur" count=5;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; 
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="tom" count=4;
#nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
#zhongli add set="deepwood" count=4;
#zhongli add set="tom" count=4;
zhongli add set="ap" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active arle;

for let i = 0; i < 4; i = i + 1 {
  arle skill;
  
  zhongli skill[hold=1], dash, attack;
  if !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  if .zhongli.sets.ap == 4 {
    zhongli dash; pick_up_crystallize("any"); # Realistically
  }
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  nahida skill, attack;
  
  arle charge, 
       attack:5, dash, 
       attack:5, dash,
       attack:5, dash,
       attack:3;
}
