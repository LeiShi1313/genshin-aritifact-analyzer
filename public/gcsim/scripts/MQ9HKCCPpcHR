# Cyno Chevreuse Fischl Mavuika. ~25s Rot. "King of Hell" Cyno Overload with Fischl using skill & burst every rotation. Glad is within 1% of Echoes and ping independent. NO > SoDP Chevreuse.

cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="deathmatch" refine=1 lvl=90/90;
cyno add set="echoes" count=4; # Ping dependence
#cyno add set="glad" count=4;
cyno add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.662; #main
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="aquamarine" refine=1 lvl=90/90;
#mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=0]; # Not Leading
mavuika add set="scroll" count=4;
#mavuika add set="oc" count=4;
mav add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # Scroll 3EM
#mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # OC ADC

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.2648;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl skill, attack;

  if !is_even(i) {
    mav burst, skill, attack;
  } else {
    mav dash, skill;
  }

  chev skill[hold=1], burst;

  fischl attack:2, burst;

  cyno burst, attack:2, skill;
  while .fischl.skill.cd>30 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}
