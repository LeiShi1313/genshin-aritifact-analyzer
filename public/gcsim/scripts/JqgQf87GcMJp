// Fischl E/Q -> Xilonen E N2 -> Nahida EQ -> Keqing Q EE N1C -> Xilonen E N2 -> Fischl Q -> Keqing N1C Q EE 2(N1C) -> Xilonen E N2 -> Keqing Q EE 2(N1C)
// Xilonen can burst in any of her field times, with Keqing losing one N1C in return. In this sim Xilonen doesn't burst

keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="wolffang" refine=1 lvl=90/90;
//keqing add weapon="pjc" refine=1 lvl=90/90;
keqing add set="tf" count=4;
keqing add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="totm" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
//fischl add weapon="tfgm" refine=1 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=2 talent=9,9,9;
xilonen add weapon="favoniussword" refine=3 lvl=90/90;
//xilonen add weapon="peakpatrolsong" refine=1 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 heal=0.359;
xilonen add stats def%=0.496 def=118.08 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.1324;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

active fischl;
fischl skill;
for let i = 0; i < 4; i = i + 1 {
  xilonen skill, attack:2;
  nahida skill, burst;
  keqing burst, skill, skill, attack, charge;

  xilonen skill, attack:2;
  fischl attack:2, burst;
  keqing attack, charge, burst, skill, skill, attack, charge, attack, charge;

  xilonen skill, attack:2;
  keqing burst, skill, skill, attack, charge, attack, charge;
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack:2, skill;
  }
}
