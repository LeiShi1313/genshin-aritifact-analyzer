# Kaeya Chongyun Chiori Zhongli. ~16s Rot. Chongyun's CDR is used for a denser rotation.

# Team - Options ordered by DPS
kaeya char lvl=90/90 cons=6 talent=9,9,9;
kaeya add weapon="calamityofeshu" refine=5 lvl=90/90;
#kaeya add weapon="wolffang" refine=1 lvl=90/90;
#kaeya add weapon="harbinger" refine=5 lvl=90/90;
kaeya add set="sr" count=2; kaeya add set="bs" count=2;
kaeya add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Esshu
#kaeya add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
#kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662; # WF
#kaeya add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
#kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662; # HoD

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#chongyun add weapon="sacgs" refine=5 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2979 cd=0.4634; # SS
#chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311 ; #main
#chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944; # SacGS

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbinger" refine=5 lvl=90/90;
#chiori add weapon="cinnabar" refine=5 lvl=90/90;
chiori add set="gt" count=4;
#chiori add set="husk" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622 ; #main
chiori add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;
#chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; #main
#chiori add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active chongyun; # SS stacks

for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash;

  chongyun burst, skill;
  # Sac GS extension
  if .chongyun.skill.ready {
    chongyun skill;
  }

  chiori skill:2;

  kaeya skill, dash, burst;
  while .chiori.skill.cd > 120 {
    if .kaeya.skill.ready {
      kaeya skill, dash;
    } else if .kaeya.normal > 3 && .stam > 18 {
      kaeya dash;
    } else {
      kaeya attack;
    }
  }

  print("done");
}
