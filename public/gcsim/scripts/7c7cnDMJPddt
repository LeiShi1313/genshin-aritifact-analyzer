yelan char lvl=90/90 cons=0 talent=9,9,9; 
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
#yelan add set="totm" count=2;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*10 cd=0.0662*9;

chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="chainbreaker" refine=5 lvl=90/90;
chasca add set="oc" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

sara char lvl=90/90 cons=6 talent=9,9,9; 
sara add weapon="chainbreaker" refine=5 lvl=90/90;
sara add set="no" count=4;
sara add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
sara add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*2 cr=0.0331*9 cd=0.0662*5;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="mailedflower" refine=5 lvl=90/90;
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
mavuika add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active yelan;
for let i = 0; i < 4; i = i + 1 {
  let fy = 0;
  while fy < 2 && !.yelan.mods.favonius-cd{
    yelan attack;
    fy = fy+1;
  }
  yelan skill, burst, attack;
  
  sara skill, attack;
  
  mavuika attack, skill, burst, charge, dash;
  
  if .sara.burst.ready{
     sara attack, burst;
  } else{
    sara attack, aim;
  }

  chasca attack, skill, aim:1;
  if .chasca.burst.ready{
    chasca burst,aim:2;
  } else{
    chasca aim:3;
  }
}
wait(125);
