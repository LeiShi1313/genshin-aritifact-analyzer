kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="fopl" count=5;
kuki add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
#substats: 4 EM, 10 CR, 6 CD
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

kokomi char lvl=90/90 cons=0 talent=9,9,9;
#BotBB >= PA
kokomi add weapon="balladoftheboundlessblue" refine=5 lvl=90/90;
kokomi add set="clam" count=4;
kokomi add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 heal=0.359 ; #main
#substats: 10 ATK%, 8 HP%, 2 ER
kokomi add stats def=39.36 def%=0.124 hp=507.88 hp%=0.496 atk=33.08 atk%=0.5952 er=0.2204 em=39.64 cr=0.0662 cd=0.1324;

nahida char lvl=90/90 cons=0 talent=9,9,9;
#Favonius Codex >= PA = FoF
nahida add weapon="favoniuscodex" refine=3 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311 ; #main
#substats: 1 EM, 8 CR, 8 CD, 3ER
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=59.46 cr=0.331 cd=0.662;																																														


furina char lvl=90/90 cons=0 talent=9,9,9;
#FD > Pipe
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;							
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
#substats: 2 HP%, 10 CR, 8 CD
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active nahida;
# ----  Actions List
for let x=0; x<4; x=x+1 {
  nahida skill, burst, attack;
  kokomi attack:2, skill;
  furina skill, burst, attack;
  kuki attack, skill;
  kokomi attack, burst;
  while .kokomi.skill.cd > 165 {
    kokomi attack:2, dash, walk[f=2];
  }
}