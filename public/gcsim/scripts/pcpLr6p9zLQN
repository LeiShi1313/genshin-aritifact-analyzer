chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="hamayumi" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

barbara char lvl=90/90 cons=6 talent=9,9,9;
barbara add weapon="favcodex" refine=3 lvl=90/90;
barbara add set="scroll" count=4;
barbara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359; #main
barbara add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*12;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favlance" refine=3 lvl=90/90;
xiangling add set="totm" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*6 cd=0.0662*10;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

active xiangling;

for let i=0; i<4; i=i+1 {
  bennett skill, burst;

  if .barbara.skill.ready {
    barbara attack:2, skill;
  } else {
    barbara attack:3;
  }
  
  if .xiangling.burst.ready {
    xiangling burst, skill, dash;
  } else {
    xiangling attack:2, skill, dash;
  }
  
  chasca skill;
  set_player_pos(0,-2); # to simulate that Barbara E ring doesn't apply Hydro to the enemy
  chasca aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca skill, burst;
  } else {
    chasca aim[bullets=4];
  }
  set_player_pos(0,0);
}
wait(82); # wait for aim[bullets=4] hits the enemy at the last rot

# ~17s rot
# Bennett EQ > Barbara N2 E / N3 > Xiangling Q/N2 ED > Chasca E 4[C] Q/C_4b