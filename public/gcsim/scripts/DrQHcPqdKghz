mizuki char lvl=90/90 cons=0 talent=9,9,9;
mizuki add weapon="sacfrags" refine=3 lvl=90/90;
mizuki add set="gd" count=4;
mizuki add stats hp=4780 atk=311 em=187 em=187 em=187;
mizuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.6612 em=118.92 cr=0.0662 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.1324 cd=0.7944;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="fruit" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.6612 em=118.92 cr=0.0662 cd=0.1324;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favoniuswarbow" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.burst.ready {
    furina burst;
  }
  ororon skill, burst;
  if .sucrose.skill.ready {
    sucrose skill;
  }
  sucrose attack, burst;
  mizuki skill;
  while .mizuki.status.dreamdrifter-state {
    if .mizuki.burst.ready {
      mizuki burst;
    } else {
      wait(1);
    }
  }
  if .sucrose.skill.ready {
    sucrose skill;
  }
  sucrose attack:2, charge, attack:2, charge;
  # mizuki attack:2, charge, attack:2, charge;
}

