fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main stats: ATK% Electro% CR
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # sub stats: 2 ER, 8 CR, 10 CD

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="favoniuslance" refine=3 lvl=90/90;
