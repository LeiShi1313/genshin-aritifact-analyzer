bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4; # ~2k dps loss
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.5510 em=39.64 cr=0.2648 cd=0.5296;

options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
#target lvl=100 resist=0.1 radius=1 pos=5.4,1 hp=999999999;
energy every interval=480,720 amount=1;
set_particle_delay("candace", 80); # Candace E N1 Q swap will catch her own particles

active mavuika;
  mav skill;
for let i = 0; i<4 ; i=i+1 {
  xilonen skill, attack:2;
  if i {
    candace attack;
  }
  candace skill, attack, burst;
  bennett burst, attack;
  mav burst, charge, dash, attack,
    charge, dash, attack,
    charge, dash, attack,
    charge, dash, attack,
    charge, dash, attack,
    charge, dash, attack,
    charge, dash, attack,
    charge, skill;
  bennett skill, attack;
}