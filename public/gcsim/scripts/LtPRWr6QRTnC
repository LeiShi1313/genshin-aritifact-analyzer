options swap_delay=12 iteration=1000;

# Build assumptions
neuvillette char lvl=90/90 cons=0 talent=9,9,9; 
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; # main
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="favoniussword" refine=3 lvl=90/90;
lynette add set="vv" count=4;
lynette add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="ap" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

#Rotation assumptions
active neuvillette;

neuvillette skill, attack;

for let x=0; x<4; x=x+1 {
  xilonen skill, attack:2;
  lynette skill, attack;
  xiangling burst, skill, dash;
  pick_up_crystallize("hydro");
  neuvillette charge, burst, skill, charge;
  xilonen skill, attack:2;
  lynette burst, skill;
  xiangling attack:2, skill, dash;
  pick_up_crystallize("hydro");
  neuvillette charge, charge, skill, attack:2, dash, attack:2; # to let Lynette's Burst run out and set up Hydro VV
}

# (Neuvillette E N1) > Xilonen E N2 > Lynette E N1 > Xiangling Q ED > Neuvillette C Q E C > Xilonen E N2 > Lynette Q E > Xiangling N2 ED > Neuvillette 2[C] E N2D N2