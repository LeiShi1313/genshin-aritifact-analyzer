# one rot.

faruzan char lvl=90/90 cons=6 talent=2,10,10;
faruzan add weapon="favbow" refine=5 lvl=90/90;
faruzan add set="scroll" count=5;
faruzan add stats def%=0.109 def=100 hp=5288 hp%=0.192 atk=395 atk%=0.19899999999999998 er=0.8999999999999999 em=145 cr=0.35 cd=0.163 anemo%=0.466;

bennett char lvl=90/90 cons=6 talent=1,10,10;
bennett add weapon="aquilafavonia" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats def%=0.284 def=53 hp=6901 hp%=0.524 atk=399 atk%=0.152 er=0.751 em=138 cd=0.21800000000000003;

wanderer char lvl=90/90 cons=0 talent=10,10,10;
wanderer add weapon="thewidsith" refine=5 lvl=90/90;
wanderer add set="dpc" count=5;
wanderer add stats hp=5019 hp%=0.040999999999999995 atk=375 atk%=0.6660000000000001 em=46 cr=0.591 cd=1.539 anemo%=0.466;

mavuika char lvl=90/90 cons=0 talent=6,9,10;
mavuika add weapon="wolfsgravestone" refine=1 lvl=80/80;
mavuika add set="oc" count=5;
mavuika add stats def%=0.183 def=116 hp=4780 hp%=0.105 atk=311 atk%=0.9080000000000001 er=0.11 em=44 cr=0.29500000000000004 cd=1.112 pyro%=0.466;

options iteration=1000 swap_delay=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
active faruzan;

for let i = 0; i < 1; i = i + 1 {
  faruzan burst;

  bennett burst;

  mavuika skill, burst;

  wanderer attack:1, burst;
  wanderer skill, attack, charge;
  while .wanderer.skydweller-points > 3 {
    if .wanderer.normal < 3 {
      wanderer attack;
    } else if .wanderer.mods.wanderer-a4 {
      wanderer dash;
    } else if .wanderer.skydweller-points > 2 {
      wanderer charge;
    } else {
      wanderer attack;
    }
  }
  wanderer skill;
}
