chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="chainbreaker" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
chasca add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662;

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="mouunsmoon" refine=1 lvl=90/90;
sara add set="scroll" count=4;
sara add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.331 cd=0.7282;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.4634;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="dialogues" refine=5 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.331 cd=0.2648;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active furina;

for let i=0; i<2; i=i+1 {
  furina skill, dash, burst;
  sara skill;
  chevreuse skill[hold=1], burst;
  sara aim;
  if .sara.burst.ready && .sara.energy == .sara.energymax {
    sara burst;
  }
  chasca skill, aim:4, aim[bullets=4], burst;

  sara skill;
  chevreuse attack, skill[hold=1];
  sara aim;
  if .sara.burst.ready && .sara.energy == .sara.energymax {
    sara burst;
  }
  chasca skill, aim:4, aim[bullets=4];
}
wait(82); # 82f wait for the last 4bullet CA to hit (DPS Loss)

# ~34s rotations
# Furina ED Q > Sara E > Chevreuse hEQ > Sara C (Q) > Chasca E 4[C] C_4b Q > Sara E > Chevreuse N1 hE > Sara C (Q) > Chasca E 4[C] C_4b
