# Yanfei Nahida Fischl Xingqiu. ~24s Rot. Yanfei OverBurgeonVape. Yanfei uses burst at the start of her field time if available. Fischl uses skill and burst every rotation. Note that Yanfei is in melee range; dont expect her to survive past 2 rotations.

# Team
yanfei char lvl=90/90 cons=6 talent=9,9,9;
yanfei add weapon="evenstar" refine=1 lvl=90/90;
yanfei add set="gd" count=4;
#yanfei add set="fopl" count=4;
#yanfei add set="cw" count=4;
yanfei add stats hp=4780 atk=311 em=187 em=187 em=187; #main
yanfei add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.1324 cd=0.3972; # EDC
#yanfei add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
#yanfei add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=158.56 cr=0.0993 cd=0.662; # EEC
#yanfei add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
#yanfei add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.1986 cd=0.662; # 3DC

nahida char lvl=90/90 cons=0 talent=9,9,9; 
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.2317 cd=0.4634;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=120];
xingqiu add set="eosf" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311 ; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;
options duration=48; # Otherwise
#options duration=100; # If Yanfei doesn't die to Burgeon

# Targets
target lvl=100 resist=0.1 radius=3 pos=0,3.4; # Adjacent
#target lvl=100 resist=0.1 radius=3 pos=0,3.9; # No XQ Rainswords
#target lvl=100 resist=0.1 radius=3 pos=0,8.4; # out of Burgeon range

#Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl attack, skill;

  nahida skill, attack, burst;
  # Far Range
  #nahida skill[hold=1], attack, burst;
  
  xingqiu skill, dash, burst, attack;
  # Far range
  #set_player_pos(0, 5);
  #xingqiu skill, dash; set_player_pos(0, 0);
  #xingqiu burst, attack;
  
  yanfei attack;
  if .yanfei.burst.ready {
    yanfei burst;
  }
  while .fischl.oz {
    if .yanfei.skill.ready && .yanfei.mods.yanfei-a1 && .previous-action == .action.attack {
      yanfei skill;
    } else if .yanfei.mods.yanfei-seal && .stam > 25 && .previous-action == .action.attack {
      yanfei charge;
    } else {
      yanfei attack;
    }
  }
  
  fischl attack:2, burst;
  
  yanfei attack;
  while .xingqiu.mods.xingqiuburst {
  #while .fischl.oz { # Worse
    if .yanfei.skill.ready && .yanfei.mods.yanfei-a1 && .previous-action == .action.attack {
      yanfei skill;
    } else if .yanfei.burst.ready && .previous-action == .action.attack && .yanfei.energy == .yanfei.energymax {
      yanfei burst;
    } else if .yanfei.mods.yanfei-seal && .stam > 25 && .previous-action == .action.attack {
      yanfei charge;
    } else {
      yanfei attack;
    }
  }
  
}
