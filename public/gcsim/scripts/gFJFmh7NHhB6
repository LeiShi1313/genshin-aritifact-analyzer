#|| NA Xiao || Xiao Faruzan YunJin Escoffier || ~22s Rotation || CapnHarland ||

xiao char lvl=90/90 cons=0 talent=9,9,9;
xiao add weapon="deathmatch" refine=1 lvl=90/90;
xiao add set="echoes" count=4;
xiao add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
xiao add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*10 cd=0.0662*6;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favwarbow" refine=4 lvl=90/90;
faruzan add set="totm" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="footprint" refine=5 lvl=90/90;
yunjin add set="no" count=4; #
yunjin add stats hp=4780 atk=311 er=0.518 def%=0.583 def%=0.583; #main
yunjin add stats def%=0.062*8 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*8 cd=0.0662*2;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*4 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active escoffier;

for let i=0; i<4; i=i+1 {
  escoffier skill;
  if .escoffier.burst.ready {
    escoffier burst;
  }

  faruzan skill, burst;

  yunjin skill[hold=2], burst;

  xiao skill:2, burst,
       attack:4, dash,
       attack:4, dash,
       attack:4, dash,
       attack:4, dash,
       attack:5;
}

#Rotation: Escoffier E(Q) > Faruzan EQ > YunJin hE Q > Xiao 2[E] Q 4[N4D] N5
