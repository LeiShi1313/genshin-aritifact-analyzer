chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="songofstillness" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

lisa char lvl=90/90 cons=2 talent=9,9,9;
lisa add weapon="pamber" refine=5 lvl=90/90;
lisa add set="scroll" count=4;
lisa add stats hp=4780 atk=311 er=0.518 em=187 heal=0.359; #main
lisa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*10 em=19.82*10 cr=0.0331*2 cd=0.0662*2;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*10 cd=0.0662*6;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*12 cr=0.0331*2 cd=0.0662*4;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  lisa skill[hold=1], burst;
  bennett skill, burst;
  chasca skill, aim:4, aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  }
  bennett skill;
}

# ~22s rotations (due to high Lisa ER requirements)
# Furina ED Q > Lisa hEQ > Bennett EQ > Chasca E 4[C] C_4b (Q) > Bennett E
