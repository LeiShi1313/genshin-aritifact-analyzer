#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # Other

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
#nicole add weapon="ttds" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*8 cd=0.0662*2; # OE
#nicole add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
#nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*10 em=19.82*2 cr=0.0331*8 cd=0.0662*2; # TTDS

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

# Rotation
active razor; # SS stacks
razor skill, dash; # Sigils, Chev A4, C4

for let i=0; i<4; i=i+1 {
  # Burst in 1st rot, Pass Fav proc to Nicole
  if i == 0 {
    chev burst, skill[hold=1]:2;
  } else {
    chev attack, skill[hold=1];
  }

  nicole skill, burst; # Nicole can catch particles post energy drain

  if .amy.skill.ready {
    amy attack, skill;
  } else {
    amy attack:2, burst;
  }

  razor skill, dash, attack, burst, attack, skill, dash;
  # Razor Main DPS window
  while .razor.mods.razor-q > 200 { # Ends on N3ED with N1ED
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}
