//Rotation by bam2997
active faruzan;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  xianyun skill, low_plunge, burst;
  faruzan burst;

  xiao skill:2, burst;
  for let h = 9; h > 0; h = h - 1 {
      xiao jump, high_plunge[collision=rand()>0.5];
    }
}
