# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

fn mav_dc_cancel(d_travel_f) { # d_travel_f should be 6-24. https://docs.gcsim.app/reference/characters/mavuika#params
  # To prevent Error when Mavuika tries to do D*C without enough NS points, jump instead.
  if d_travel_f < 6 {
    d_travel_f = 6;
  }

  let dash_ns = 10; # 10 consumption on dash use
  let base_cons = 0.9; # 0.9 points
  let base_tick_rate = 6;

  while !.mavuika.dash.ready {
    print("waiting on mavuika dash cd");
    wait(1);
  }

  let d_ticks = d_travel_f / base_tick_rate + 1; # +1 in case you get unlucky with tick timing
  print("Max number of NS ticks during dash: ", d_ticks);
  let ns_consumed = dash_ns + base_cons * d_ticks;
  print("Expected NS consumption: ", ns_consumed);

  if .mavuika.nightsoul.points > ns_consumed || .mavuika.status.mavuika-burst {
    mavuika dash[charge_cancel=1, travel=d_travel_f], charge;
  } else {
    print("current NS points = ", .mavuika.nightsoul.points);
    print("skipping mav d*c, not enough NS points ");
    mavuika jump;
  }
}

active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika skill[hold=1];
  nicole skill, attack;
  xilo skill, attack:2;
  pick_up_crystallize("any");
  citlali swap;
  if is_even(i) {
    wait(15);
    citlali attack, skill;
    mavuika swap;
    if .mavuika.nightsoul.points {  // To prevent Error when Mavuika tries to Recast E when its already expired due to teammate stalling for Q energy
      mavuika skill[recast=1];
      mavuika charge;                                                           // C1     // C
    }
    mavuika burst;                                                              // Q      // Q
    mavuika charge, charge[final=1];                                            // C1F    // cF
    mav_dc_cancel(6); mavuika charge[final=1];                                  // D*C1F  // d*cF
    mav_dc_cancel(6); mavuika charge[final=1];                                  // D*C1F  // d*cF
    mav_dc_cancel(6); mavuika charge[final=1];                                  // D*C1F  // d*cF
    mav_dc_cancel(6); mavuika charge[hold=30], charge[final=1];                 // D*C1F  // d*cF  // No Mavuika Q buff on F
    print("after Q buff end");
    mav_dc_cancel(6); mavuika charge[final=1];                                  // D*C1F  // d*cF
    mav_dc_cancel(6);                                                           // D*C1   // d*c
  } else {
    citlali skill, burst, attack:2, dash;
    mavuika swap;
    if .mavuika.nightsoul.points {  // To prevent Error when Mavuika tries to Recast E when its already expired due to teammate stalling for Q energy
      mavuika skill[recast=1];
      mavuika charge;                                                           // C1     // C
    }
    mavuika burst;                                                              // Q      // Q
    mavuika charge, charge[final=1];                                            // C1F    // cF
    mav_dc_cancel(6); mavuika charge[final=1];                                  // D*C1F  // d*cF
    mav_dc_cancel(6); mavuika charge[final=1];                                  // D*C1F  // d*cF
    mav_dc_cancel(6); mavuika charge[final=1];                                  // D*C1F  // d*cF
    mav_dc_cancel(6); mavuika charge[hold=30], charge[final=1];                 // D*C1F  // d*cF  // No Mavuika Q buff on F
    print("after Q buff end");
    mav_dc_cancel(6); mavuika charge[final=1];                                  // D*C1F  // d*cF
    mav_dc_cancel(6); mavuika charge[final=1];                                  // D*C1F  // d*cF
  }
}

