xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="earthshaker" refine=5 lvl=90/90 ;
mavuika add set="ap" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
mavuika add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

options swap_delay=12 iteration=1000;

active mualani;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;


fn mualani_combo() {
  mualani skill;
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 { # 3 bites
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
  break;
  }
}

fn sucrose_combo() {
  if .sucrose.burst.ready && .sucrose.skill.ready {
    sucrose skill, dash, walk, burst; # if sucrose skill & burst are ready, use both
  } else if .sucrose.burst.ready {
    sucrose attack, burst; # otherwise, use the one that is available
  } else if .sucrose.skill.ready {
    delay(20);
    sucrose skill, dash;
  } else {
    sucrose attack:2, dash; #if neither is available, use normal attacks
  }
}

for let i=0; i<2; i=i+1 {

  if i {
    mualani skill;
  }
  mualani attack;
  sucrose swap;
  sucrose_combo();
  xilonen skill, attack:2;
  mavuika burst, skill, dash;
  pick_up_crystallize("hydro");
  mualani_combo();
  sucrose attack, skill, dash;
  mualani burst[travel=0];


  mualani attack;
  xilonen skill, attack:2;
  sucrose swap;
  sucrose_combo();
  mavuika skill[hold=1], charge, dash;
  pick_up_crystallize("hydro");
  mualani_combo();

}

  mualani skill, attack;
  sucrose swap;
  sucrose_combo();
  xilonen skill, attack:2;
  mavuika burst, skill, dash;
  pick_up_crystallize("hydro");
  mualani_combo();
  sucrose attack, skill, dash;
  mualani burst[travel=0];
