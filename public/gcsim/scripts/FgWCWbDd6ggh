# Lisa Xingqiu Nahida Zhongli. ~21s Rot. Lisa Hyperbloom. Xingqiu Hyperbloom. Lisa uses burst at the end of the rotation; she skips burst entirely if ER deficient. XQ burst continues into the next rotation.

# Team
lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="evenstar" refine=1 lvl=90/90;
lisa add set="fopl" count=4;
lisa add stats hp=4780 atk=311 em=187 em=187 em=187;
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311;
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.2317 cd=0.4634;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=3,0 hp=100000000; # 2nd

# Rotation
active zl;

for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash, attack;

  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }

  xingqiu skill, dash, burst, attack;

  lisa attack:1;
  lisa attack:3, dash, attack:3, dash;
  lisa attack:3, dash, attack:3, dash;
  lisa attack:3, dash, attack:3, dash;
  lisa attack:3, dash, attack:3;
  if .lisa.burst.ready {
    lisa burst, attack;
  } else {
    lisa dash, attack;
  }
}
