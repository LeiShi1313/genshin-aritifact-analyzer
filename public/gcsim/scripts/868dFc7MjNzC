xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="ins" count=4;
xilonen add stats hp=3571 atk=232 er=0.3885 def%=0.43725 cr=0.311;
xilonen add stats def%=0.15624 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.27804;

options swap_delay=12 iteration=1000;

active mavuika;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

for let i=0; i<4; i=i+1 {
  mualani dash, attack:2;
  citlali skill, attack; # leave Cryo with N1
  mavuika burst, skill;
  if i==3 {
    xilonen swap;
    delay(1);
  }
  xilonen skill, attack:2;
  delay(22);
  mualani skill;
  mualani_combo();
  if is_even(i) {
    mualani burst;
  } else {
    xilonen burst;
    mualani attack:2;
  }
}

# Mualani D N2 > Citlali E N1 > Mavuika Q E > Xilonen E N2 > Mualani E 3[3-stacked bite] Q >
# Mualani D N2 > Citlali E N1 > Mavuika Q E > Xilonen E N2 > Mualani E 3[3-stacked bite] > Xilonen Q > Mualani N2
# N2D N2 applies Hydro at the 1st and 4th one
