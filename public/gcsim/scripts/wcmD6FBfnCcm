# Klee Furina Rosaria Xianyun. ~23s Rot. Klee Plunge with VapeMelt. Low Shatter count, Klee, Furina, and Rosaria get some vapes/melts. Hydro VV only. Klee bursts as available and does CAs between plunges, stamina permitting. Freeze immunity is -2K DPS. 50% Collisions.

# Team - Options listed by DPS
klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="longnightsoath" count=4;
#klee add set="mh" count=4;
#klee add set="sr" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Other
#klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
#klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.1655 cd=0.7944; # MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.5958;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
#rosaria add set="scroll" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="scroll" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.2976 er=0.6612 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active klee;
klee skill[bounce=3, mine=8];

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  xianyun skill, low_plunge, attack, burst;
  
  rosaria skill, burst;
  
  while .klee.skill.ready {
    klee skill[bounce=3, mine=8];
  }
  if .klee.burst.ready {
    klee burst;
  }
  while .xianyun.status.xianyun-airborne-buff {
    if .klee.status.xianyun-airborne-buff {
      klee jump;
      if .airborne{
        klee high_plunge[collision=rand()>0.5];
      }
    }
    # Klee CA Optimzation
    if .klee.status.a1-spark {
      klee attack;
      klee charge;
    } else if .stam > 50 {
      #klee attack;
      klee charge;
    } else if .stam > 18 {
      klee dash;
    } else {
      klee attack;
    }
  }
  
  rosaria skill;
  
}
