# Beidou Furina Fischl Mika. ~24 Rot. Phys Beidou does N4D with skill off cd and burst as available. Fischl uses skill and burst every rotation with skill before Furina.

# Team
beidou char lvl=90/90 cons=6 talent=9,9,9;
beidou add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
beidou add set="mh" count=4;
beidou add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
beidou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2979 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=0];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=5 lvl=90/90;
mika add set="clam" count=4;
#mika add set="sodp" count=4;
#mika add set="no" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.1324;

options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 hp=10000000 radius=2 pos=0,2.4;

# Beidou 20% Perfect Counter, 20% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.75 {
    counter = 2;
  } else if counter > 0.75 && counter <= 0.5 {
    counter = 1;
  }
  else {
    counter = 0;
  }

  return counter;
}

# Rotations
active beidou; # SS Stacks

for let i=0; i<4; i=i+1 {
  fischl attack, skill;

  furina skill, dash, burst;

  mika burst, attack, skill[hold=0];

  while .fischl.oz {
    switch {
      case .beidou.skill.ready:
        beidou skill[counter=rand_counter()];
      case .beidou.burst.ready:
        beidou burst;
      case .beidou.normal > 4 && .beidou.dash.ready && .stam > 18:
        beidou dash;
      default:
        beidou attack;
    }
  }

  fischl attack:2, burst;

  while .furina.skill.cd {
  #while .fischl.skill.cd > 30 {
    switch {
      case .beidou.skill.ready:
        beidou skill[counter=rand_counter()];
      case .beidou.burst.ready:
        beidou burst;
      case .beidou.normal > 4 && .beidou.dash.ready && .stam > 18:
        beidou dash;
      default:
        beidou attack;
    }
  }

}
