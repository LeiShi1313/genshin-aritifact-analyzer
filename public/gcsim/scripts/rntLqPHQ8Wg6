#xiangling add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5456 er=0.4959 em=118.92 cr=0.0662 cd=0.1324; # Kitain

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

for let i = 0; i < 4; i = i + 1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae skill, attack, skill, attack, skill;
  }
  
  # Emile here is better for Quicken uptime
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  
  fischl attack, skill;
  
  xl burst, attack, skill, dash;
  
  yae attack:1, charge, dash;
  yae attack:1, charge, dash;
  yae attack:1, charge, dash;
  yae burst, attack, skill:3;
  
  fischl attack:2, burst;
  
  yae attack:2, charge, jump;
  
  xl attack, skill;
  
  yae attack:2, charge, jump;
  yae attack:2, charge, jump;
}
