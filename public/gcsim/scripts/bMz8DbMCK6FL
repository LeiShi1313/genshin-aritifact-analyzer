# Itto Gorou Dori Chiori. ~22 Rot. Ittodori Festival with Chiori bursting every rotation.

# Team - Options listed by DPS
itto char lvl=90/90 cons=0 talent=9,9,9;
itto add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
itto add set="husk" count=4; #no husk prestack on serpent
itto add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #main
itto add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

gorou char lvl=90/90 cons=6 talent=9,9,9;
gorou add weapon="favbow" refine=4 lvl=90/90;
gorou add set="theexile" count=4;
gorou add stats hp=3571 atk=232 er=0.3885 def%=0.43725 cr=0.311; #main
gorou add stats def=31.488 def%=0.3968 hp=406.304 hp%=0.07936 atk=26.464 atk%=0.07936 er=0.13224 em=31.712 cr=0.2648 cd=0.37072;

dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="favgs" refine=3 lvl=90/90;
#dori add set="no" count=4;
dori add set="eosf" count=4;
dori add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbinger" refine=5 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #main
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active dori;

for let i = 0; i < 4; i = i + 1 {
  dori skill, burst;

  gorou skill, burst;

  chiori burst, skill:2;

  if i == 0 {
    #"C0 1PS" combo
    itto attack, burst[prestack=1],
         attack, skill,
         attack:2, charge:5,
         attack:4, charge:5, skill[travel=0], charge;
         sleep(21); #catch ushi particles
  } else {
    #"C0 2PS" combo
    itto attack, burst[prestack=1],
         attack, skill, charge:4,
         attack:3, charge:4,
         attack:3, skill, charge:4;
  }

  print("done");
}
