xiao char lvl=90/90 cons=0 talent=9,9,9;
xiao add weapon="deathmatch" refine=1 lvl=90/90;
//xiao add set="mh" count=4;
//xiao add set="vermillionhereafter" count=4;
xiao add set="longnightsoath" count=4;
xiao add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622 ; #main
xiao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3641 cd=0.662;

// if there is no additional Lan Yan E or there is only Faruzan who holds Fav, increase the ER
//xiao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=3 lvl=90/90 ;
faruzan add set="tom" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311 ; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;

lanyan char lvl=90/90 cons=6 talent=9,9,9;
//lanyan add weapon="ttds" refine=5 lvl=90/90;
//lanyan add weapon="sacfragments" refine=5 lvl=90/90;
lanyan add weapon="favcodex" refine=3 lvl=90/90;
lanyan add set="scroll" count=4;
lanyan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; # main
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

// lanyan add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; # main
// lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
//bennett add weapon="favoniussword" refine=3 lvl=90/90;
bennett add weapon="sapwood" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active faruzan;
for let i=0; i<4; i=i+1 {
  faruzan skill, burst;
  while !.faruzan.mods.favonius-cd {
    faruzan attack;
  }

  bennett skill, burst;
  if .bennett.weapon == .keys.weapon.favoniussword && !.bennett.mods.favonius-cd {
    bennett attack;
  }

  lanyan skill:2;
  if !is_even(i) && .lanyan.skill.ready {
    lanyan skill:2;
  } else {
    lanyan attack; # to make Lan Yan particles are caught before Xiao Burst casting.
    if .lanyan.weapon != .keys.weapon.favoniuscodex {
      lanyan dash;
    }
  }

  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
}
