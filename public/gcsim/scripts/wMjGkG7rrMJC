# ----  Default Enemy
options swap_delay=12 debug=true iteration=1000;
target lvl=100 resist=0.1 hp=100000000 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

active neuv;
for let i = 0; i < 4; i = i + 1 {
  neuv skill, attack:3;
  diona burst, skill;
  while ( !.diona.mods.favonius-cd ) {
  diona attack;
  }
  xiangling burst, skill;
  fischl attack:2, burst;
  neuv charge, burst, skill, charge;
  diona attack:2, skill;
  while ( !.diona.mods.favonius-cd ) {
  diona attack;
  }
  xiangling skill, dash, attack;
  fischl attack, skill;
  neuv charge:2;
}
wait(173);

