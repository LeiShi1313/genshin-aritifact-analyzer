# Target and Energy
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

# Rotation
active xiangling;
for let i = 0; i < 4; i = i + 1 {

  xiangling skill, attack;
  bennett burst, skill;
  ayaka burst;
  lynette skill, burst;
  xiangling burst;
  ayaka skill, dash,
        attack:2, charge,
        attack:2, charge, dash,
        attack:2, charge,
        attack:2, charge, dash,
        attack:2, charge,
        skill, dash, attack;
}

