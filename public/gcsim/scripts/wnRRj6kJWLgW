options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active sara;
sara skill;
for let i=0; i<4; i=i+1 {
  // if .chev.burst.ready {
    chev burst, skill[hold=1], attack;
  // } else {
  //   chev skill[hold=1], attack:2;
  // }
  sara aim;
  xiangling attack:3, burst, skill, dash;
  sara burst;
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  sara skill;
  clorinde burst;
  clorinde attack:2, jump; #phys filling time for 20s cd
}
