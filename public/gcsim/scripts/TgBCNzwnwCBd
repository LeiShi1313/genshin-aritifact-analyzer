options iteration=1000 swap_delay=1; # Swap delay is handled by the pre-action hook above
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=10000000 particle_threshold=624000 particle_drop_count=3; # Energy drops based on 12-3 (300% HP) Icewind Suite; 

active yelan;

yelan aim;

while true {
  
  if .xilonen.status.scroll-4pc-hydro < 120 && .xilonen.skill.ready && .xilonen.swap.ready { # Maintain Xilo buffs every 15s or so
    xilonen skill, attack:2;
  }
  
  else if .aethergeo.skill.ready && .aethergeo.swap.ready {
    aethergeo skill, dash;
    if .xingqiu.status.xingqiuburst {
      aethergeo attack;
    }
  }
  
  else if .aethergeo.burst.ready && .aethergeo.swap.ready {
    aethergeo burst;
    if .xingqiu.status.xingqiuburst {
      aethergeo attack;
    }
  }
  
  else if .xingqiu.burst.ready && .xingqiu.swap.ready {
    xingqiu burst, attack;
  }
  
  else if .xingqiu.skill.ready && .xingqiu.swap.ready {
    xingqiu skill, attack;
  }
  
  else if .yelan.burst.ready && .yelan.swap.ready {
    yelan burst, attack;
  }
  
  else if .yelan.skill.ready && .yelan.swap.ready {
    yelan skill, attack;
  }
  
  else {
    yelan attack;
  }
  
}