# Charlotte Xiangling Mavuika Xianyun. ~20s Rot. Charlotte Melt plunge. Charlotte uses hold skill after plunging, allowing Xianyun to VV Cryo and Mavuika to Melt her burst in the next rotation. Charlotte can N1 cancel more plunges for more melts.

# Team
charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="widsith" refine=3 lvl=90/90;
charlotte add set="longnightsoath" count=4;
#charlotte add set="lw" count=4;
charlotte add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311;
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favlance" refine=3 lvl=90/90;
xiangling add set="emblem" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.4408 em=39.64 cr=0.331 cd=0.4634;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#mav add weapon="tidalshadow" refine=5 lvl=90/90;
mav add set="scroll" count=4;
#mav add set="oc" count=4;
#mav add set="gt" count=4;
mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Other
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # OC; Other
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # OC; SS

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="sodp" count=4;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3857 em=59.46 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active mav;
#mav skill, dash;

for let i=0; i<4; i=i+1 {
  xianyun skill, low_plunge, attack, burst;

  if .mav.burst.ready && i > 0 {
    mav burst, skill, dash;
  } else if .mav.skill.ready {
    mav skill, dash;
  }

  #while .xl.burst.cd { # For sim errors
  #  xl attack;
  #}
  xl burst, skill, dash;

  # More melts for the Pyro units
  if .charlotte.burst.ready && .charlotte.energy == .charlotte.energymax {
    charlotte burst;
  }
  # Tinker with value to avoid overtaking Pyro
  let j=0;
  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.status.xianyun-airborne-buff {
      charlotte jump;
      if .airborne {
        charlotte high_plunge[collision=rand()>0.5];
        j = j + 1;
      }
      if j < 3 { # adjust for more NA cancels
        charlotte attack;
      } else if j == 8 {
        charlotte attack;
      } else {
        charlotte dash;
      }
    }
  }
  charlotte attack, skill[hold=1];
  #if .charlotte.burst.ready && .charlotte.energy == .charlotte.energymax {
  #  charlotte burst;
  #}
}
