let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	  pick_up_crystallize("any"); # Pick up crystallize before every dash
  }
	
  return _execute_action(char_id, action_id, p);
}

options swap_delay=12 iteration=1000;

# Build assumptions
furina char lvl=90/90 cons=6 talent=10,10,10; 
furina add weapon="splendoroftranquilwaters" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

citlali char lvl=90/90 cons=6 talent=10,10,10;
citlali add weapon="starcallerswatch" refine=5 lvl=90/90;
citlali add set="totm" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 em=187; #main
citlali add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*12 cd=0.0662*8;

chiori char lvl=90/90 cons=6 talent=10,10,10;
chiori add weapon="uraku" refine=5 lvl=90/90;
chiori add set="mh" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 def%=0.583 cd=0.622;
chiori add stats def%=0.062*4 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

xilonen char lvl=90/90 cons=6 talent=10,10,10; 
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.062*6 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*8;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst, attack:3;
  chiori skill:2;
  xilo skill, attack:2;
  citlali skill, attack;
  if .chiori.burst.ready {
    chiori burst;
  }
  while .furina.skill.cd  {
    if .chiori.skill.ready {
      if .xilo.skill.ready {
        chiori skill:2;
        xilo skill, attack:2;
        chiori swap;
      } else {
        chiori skill, attack;
      }
    } else if .chiori.normal > 3 {
      chiori dash;
    } else {
      chiori attack;
    }
  }
}

