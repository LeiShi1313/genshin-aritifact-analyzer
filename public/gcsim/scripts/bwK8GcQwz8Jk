kinich char lvl=90/90 cons=0 talent=9,9,9;
kinich add weapon="tidalshadow" refine=5 lvl=90/90;
kinich add set="scroll" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cr=0.311; #main
kinich add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="deepwood" count=4;
escoffier add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.2755 em=39.64 cr=0.1655 cd=0.3972;

# Options
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn kinich_combo() {
  kinich skill;
  while .kinich.nightsoul.state {
    switch .kinich.nightsoul.points {
      case 20:
        kinich skill[hold=1];
      default:
        if .kinich.blind_spot {
          kinich attack[direction=.kinich.blind_spot];
        } else {
          kinich attack;
        }
    }
  }
}

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  escoffier skill, burst;
  
  yelan burst, attack;
  if !.yelan.skill.ready && .yelan.breakthrough {
    yelan aim;
  }
  yelan skill, attack;
  
  kinich_combo(); # 3[N4 shE] N1
  
  yelan skill, attack:2;
  
  if .kinich.burst.ready {
    kinich burst;
  } else {
    yelan attack:2;
  }
}

# ~22s rotations
# Furina ED Q > Escoffier EQ > Yelan Q N1 (C) E N1 > Kinich E 3[N4 shE] N1 > Yelan E N2 > Kinich Q / Yelan N2