# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active dori; # SS Stacks

nahida skill, burst;

for let i=0; i<4; i=i+1 {
  if i > 0 && .nahida.burst.ready {
    nahida burst, charge;
  } else if i > 0 {
    nahida skill, attack, charge;
  }
  
  ororon skill, burst;
  
  if .mav.burst.ready {
    mav burst, skill, dash;
  } else {
    mav attack, skill;
  }
  
  dori skill, attack:2, dash, attack:2, burst;
  dori skill, attack:2, dash, attack:2;
  
  nahida skill, attack, charge;
  
  dori skill, attack:2, dash, attack:2;
}

