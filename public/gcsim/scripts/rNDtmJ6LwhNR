# Mavuika Citlali Sucrose Bennett. Alternating between a ~20-23s rotation and a ~16s rotation. KQMS. 
# Alternates between 2 different rotations: 
# One where Sucrose ults to get double cryo setup, for 5(+1) melts with Mavuika 5[C2D](C), and one without Sucrose ult, for 4 melts with Mavuika C3F D C3F D C.

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=79.28 cr=0.2648 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 cryo%=0.466 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=198.2 cr=0.1986 cd=0.1324;

sucrose char lvl=90/90 cons=6 talent=9,9,9;         
sucrose add weapon="ttds" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 er=0.518 em=187 em=187;
sucrose add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=158.56 cr=0.2648 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; 
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mavuika;

mavuika skill;
for let i=0; i<4; i=i+1 {
  if is_even(i) {
    if .citlali.skill.ready{
      citlali skill, burst;
    } else {
      bennett skill, attack:2;
      citlali attack:3, dash, skill, burst;
    }
    bennett burst, attack;
    if .sucrose.skill.ready {
      sucrose skill, dash;
    } else {
      sucrose attack:2;
    }
    sucrose burst;
    mavuika burst;
    delay(10);
    mav charge:2, dash,
        charge:2, dash,
        charge:2, dash,
        charge:2, dash,
        charge:2, dash, charge, dash, skill;
    bennett skill, attack:2;
    sucrose skill, dash, attack:4;
  } else {
    bennett skill, burst;
    if .sucrose.skill.ready {
      sucrose skill, dash, attack:1;
    } else {
      sucrose attack:2;
    }
    citlali skill, burst, attack;
    mavuika burst;
    delay(18);
    mavuika charge:3, charge[hold=6], charge[final=1], dash;
    mavuika charge:3, charge[hold=6], charge[final=1], dash;
    mavuika charge, dash;
    mavuika skill;
  }
}

# Start: Mavuika E

# Odd rotation: Bennett (E N2)¹ > Citlali (N3 D)¹ E Q > Bennett Q N1 > Sucrose (N2)²/ED Q > Mavuika Q 5[C2D] C D E > Bennett E N2 > Sucrose ED N4

# Even rotation: Bennett E Q > Sucrose (N2)²/ED N1 > Citlali E Q N1 > Mavuika Q C3F D C3F D C E

# ¹: Do if Citlali E is on CD
# ²: Do instead of ED if Sucrose E is on CD

# Mavuika C2D C3D C5 D C on the odd rotation instead of 5[C2D] C may be an option for timing comfort (~1.5k DPS loss)