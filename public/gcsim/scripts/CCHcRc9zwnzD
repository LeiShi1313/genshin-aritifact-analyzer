  fischl attack:2, burst;
  kazuha skill, high_plunge, burst;
  nahida attack, skill, burst, attack;
  sara aim, attack, skill, burst;
  fischl aim, skill;
  kazuha  skill, high_plunge;
  sara  aim:2, skill, aim:4, skill;
