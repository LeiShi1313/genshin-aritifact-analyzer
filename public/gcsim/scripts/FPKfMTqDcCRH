options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 hp=100000000 radius=1 pos=0,2.4;
energy every interval=480,720 amount=1;

active yae;

for let x = 0; x < 3; x = x + 1 {
  if x==0 {
    yae skill:3;
  } else {
    yae  skill, attack, skill, attack, skill;
  }
  
  nahida skill, burst;
  
  fischl skill, attack;

  baizhu skill, burst, attack;
  
  yae attack, burst,
      skill:3,
      attack:1, charge, dash,
      attack:1, charge, jump; 
      
  baizhu  attack, skill;
  
  fischl attack, burst;
 
  yae attack:2, charge, dash,
      attack:2, charge, dash, 
      attack:2, charge, jump, attack;
}