yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="shime" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main 5* set
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9; 
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; 
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="dialoguesofthedesertsages" refine=5 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=1015.76 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.5510 em=39.64 cr=0.1986 cd=0.1324 ;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
mav add set="scroll" count=4;
mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
                                                                                                                                                                        
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active mavuika;
fischl skill;
for let i=0; i<4; i=i+1 {
  chevreuse burst, skill[hold=1];
  if is_even(i) {
    yoimiya attack:3, dash;
  }
  mavuika burst, charge, dash, skill;
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst; 
  }
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if is_even(i) && .yoimiya.burst.ready && .yoimiya.energy == .yoimiya.energymax {
    yoimiya burst;
  }
}

