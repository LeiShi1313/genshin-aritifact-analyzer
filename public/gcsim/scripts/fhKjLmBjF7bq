xiao char lvl=90/90 cons=0 talent=9,9,9;
xiao add weapon="favoniuslance" refine=3 lvl=90/90;
xiao add set="marechausseehunter" count=4;
xiao add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622 ; #main
xiao add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="fadingtwilight" refine=5 lvl=90/90;
faruzan add set="no" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311 ; #main
faruzan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944 ;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.3972;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="sodp" count=4;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.3972 ;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active furina;

for let i=0; i<4; i=i+1 {
  
  if !.furina.burst.ready {
    xiao attack;
  }
  
  furina skill, dash, burst;
  
  if i {
    bennett burst, skill;
  }
  else {
    bennett skill, burst;
  }
  
  faruzan burst;
  
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
  

}