ningguang char lvl=90/90 cons=6 talent=9,9,9;
ningguang add weapon="thewidsith" refine=3 lvl=90/90;
ningguang add set="nighttime" count=4;
ningguang add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; #main
ningguang add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="deepwood" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbingerofdawn" refine=5 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=1000;


let normal_attack_state = 1;
let skill_state = 4;
let c_right = 1;
let _execute_action = execute_action;

fn execute_action(char_id number, action_id number, p map) {

  if action_id == .action.dash {
	pick_up_crystallize("any"); # Pick up crystallize before every dash
  }
  return _execute_action(char_id, action_id, p);

  
}
active bennett;
target lvl=100 resist=0.1 radius=1 pos=0,1.4 type=dummy particle_threshold=520000 particle_drop_count=3;

for let i=0; i<4; i=i+1 {
  if .bennett.burst.ready {
    bennett burst;
  }
  if i==0 || !.emilie.burst.ready {
  emilie skill, attack;
  } else {
  emilie burst;
  }
  bennett skill;
  if .chiori.burst.ready {
    chiori burst;
  }
  chiori skill:2;
  ningguang attack, skill, dash;
  let start = f();
  while f() - start < 700 {
    switch {
    case .ningguang.burst.ready:
      ningguang burst, walk, charge;
    case .ningguang.skill.ready:
      ningguang skill, dash;
    case .state == normal_attack_state:
      switch .ningguang.prevAttack {
    case c_right:
	    ningguang walk;
    default:
	    ningguang charge;
      }
    default:
      ningguang attack;
      if .bennett.skill.ready {
        bennett skill;
      }
    }
  } 
  print("end");
}

