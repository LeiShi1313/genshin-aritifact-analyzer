# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000; # L
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000; # R

# Lanyan Q for Grouping, then Lanyan E off CD with N1 weaving; Sac & Con Compatible
fn lanyanDrivingCombo() {
  switch {
    case .lanyan.normal > 1 && .lanyan.burst.ready && .lanyan.energy == .lanyan.energymax:
      lanyan burst;
    case .lanyan.normal > 1 && .lanyan.skill.ready:
      set_player_pos(0, 0); # toward
      lanyan skill; set_player_pos(0, -3); # away
      lanyan skill; 
    case .lanyan.normal > 1 && .previous-action == .action.skill && .stam > 18:
      lanyan dash; set_player_pos(0, 0); # toward
    case .lanyan.normal > 2 && .stam > 18:
      lanyan dash; set_player_pos(0, 0); # toward
    default:
      lanyan attack;
  }
}

#Rotation
active yae;

for let i=0; i<4; i=i+1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae attack, skill, attack, skill, attack, skill;
  }
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  
  while .status.yae_oldest_totem_expiry {
  #while .fischl.oz {
  #while .yelan.mods.yelanburst {
    lanyanDrivingCombo();
  }
  lanyan attack;
  
  print("done");
}
