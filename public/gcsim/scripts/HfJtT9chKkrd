# Gaming Chevreuse Fischl Yae. ~17s Rot. Gaming does 7 skill plunges, juggling Man Chais in the air. Chevreuse bursts every other rotation. Yae does not burst.

# Team - -Options listed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
#gaming add set="vh" count=4;
#gaming add set="mh" count=4;
gaming add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # CW/VH
#gaming add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
#gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # MH

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="dialogues" refine=5 lvl=90/90;
#chevreuse add weapon="deathmatch" refine=1 lvl=90/90;
chevreuse add set="scroll" count=4;
#chevreuse add set="gt" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.5952 er=0.1102 em=39.64 cr=0.0662 cd=0.4634; # DotDS
#chevreuse add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # DM

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gt" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

for let i=0; i<4; i=i+1 {
  yae skill:3;

  if .chev.burst.ready && .chev.energy == .chev.energymax {
    chev burst, skill[hold=1]:3;
  } else {
    chev attack, skill[hold=1];
  }

  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }

  gaming burst, attack:2,
         skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge;
         wait(40);
  gaming skill, low_plunge,
         skill, low_plunge,
         skill, low_plunge;
}
