options swap_delay=12 iteration=1000;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=0]; # default is 100
skirk add weapon="azurelight" refine=1 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
//skirk add set="mh" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.2648 cd=0.7944;
//skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
//skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 +params=[start_energy=0];
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

shenhe char lvl=90/90 cons=0 talent=9,9,9 +params=[start_energy=0];
shenhe add weapon="favlance" refine=3 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.2204 em=39.64 cr=0.3972 cd=0.2648;

escoffier char lvl=90/90 cons=0 talent=9,9,9 +params=[start_energy=0];
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="scroll" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=1; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active furina;

furina attack, skill, dash; # N1 before ED so that Arkhe attack hits the enemy when Furina is on-field for reliable Favonius proc.
escoffier skill, attack:2;  # E N1 hits swap cooldown anyway. N2 is not a big loss.
shenhe attack, skill[hold=1], attack;
skirk skill,
      attack:5, dash,

      attack:2, burst,

      attack:5, dash,
      attack:5, dash;

furina swap;
print("Skirk E cd (60 FPS) is ", .skirk.skill.cd);
print("Skirk Q cd (60 FPS) is ", .skirk.burst.cd);

for let i=0; i<4; i=i+1 {
  if i {
    furina skill, dash;
  } else {
    furina attack;  # since Furina didn't catch Fav particles at the start, there is a stall for energy here
    while .furina.energy != .furina.energymax {   # Hide Energy deficient warning
      wait(1);
    }
  }
  furina burst;
  escoffier burst, skill;
  shenhe burst, attack, skill[hold=1];
  skirk skill,
        attack:5, dash,

        attack:2, burst,

        attack:5, dash,
        attack:5, dash,

        attack:2, charge, dash,

        attack:5, dash,
        attack:2;
}

# Furina N1 ED > Escoffier E N2 > Shenhe N1 hE N1 > Skirk tE N5D N2Q 2[N5D]
# Furina N1 Q  > Escoffier Q E  > Shenhe Q N1 hE  > Skirk tE N5D N2Q 2[N5D] N2CD N5D N2
# Furina ED Q  > Escoffier Q E  > Shenhe Q N1 hE  > Skirk tE N5D N2Q 2[N5D] N2CD N5D N2 (repeat)
