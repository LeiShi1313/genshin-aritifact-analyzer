# Kauzha Furina Candace Xianyun. ~19s Rot. Kazuha Hydro Plunge. Kazuha bookends Xianyun plunges with skill plunges. Kazuha only uses his burst after spending all plunges. Candace passes particles to Furina in the next rotation. 100% collisions for skill plunges, 70% Starwicker plunges. 

# Team
kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="harbinger" refine=5 lvl=90/90;
kazuha add set="longnightsoath" count=4;
#kazuha add set="vv" count=4; # No VV Xianyun
#kazuha add set="mh" count=4;
#kazuha add set="nymph" count=2;
kazuha add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Other, HoD
#kazuha add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cd=0.622; #main
#kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # MH, HOD

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.4634; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.4634; # ToM

candace char lvl=90/90 cons=6 talent=9,9,9; 
candace add weapon="favlance" refine=3 lvl=90/90;
candace add set="no" count=4;
candace add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
candace add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.2976 er=0.6612 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 hp=100000000 pos=0,1.4;
#target lvl=100 resist=0.1 hp=100000000 pos=2,0;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  xianyun skill, low_plunge, burst;
  
  candace skill, burst;
  
  kazuha skill, high_plunge[collision=1];
  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.status.xianyun-airborne-buff {
      kazuha jump;
      if .airborne {
        kazuha high_plunge[collision=rand()>0.3];
      }
      if .kazuha.status.xianyun-airborne-buff {
        kazuha dash;
        #kazuha attack;
      } else {
        break;
        #kazuha attack;
      }
    }
  }
  kazuha skill, high_plunge[collision=1];
  if .kazuha.burst.ready {
    kazuha burst;
  }
  
  candace attack, skill;
  if .furina.skill.cd { # Infusion still active
    candace attack;
  }
}
