# Rotation assumptions
active fischl;

for let i=0; i<4; i=i+1 {
  fischl skill, attack;
  nahida skill, burst;
  kokomi skill, attack;
  dehya  skill:2;
  nahida attack:2, skill, attack:2, charge;
  fischl attack:2, burst;
  kokomi burst, attack:3, dash, attack:3, dash, attack:3, dash, attack:3;
  nahida skill, attack:2, charge;
}

