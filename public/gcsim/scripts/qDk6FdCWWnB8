# - Characters
kokomi char lvl=90/90 cons=0 talent=9,9,9; 
kokomi add weapon="ttds" refine=5 lvl=90/90;
kokomi add set="clam" count=4;
kokomi add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359 ; #main
kokomi add stats def=39.36 def%=0.124 hp=1523.64 hp%=0.496 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

ningguang char lvl=90/90 cons=6 talent=9,9,9;
ningguang add weapon="widsith" refine=3 lvl=90/90;
ningguang add set="nighttimewhispers" count=4;
ningguang add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; #main
ningguang add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="wolffang" refine=1 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; # main
chiori add stats def%=0.186 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

# - Options
options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	pick_up_crystallize("any"); # Pick up crystallize before every dash
  }
	
  return _execute_action(char_id, action_id, p);
}

# - Targets
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;

# - Actions
active furina;
for let x=0; x<4; x=x+1 {
  furina skill, dash, burst;
  kokomi skill, attack:2, dash;
  ningguang attack, dash, skill;
  chiori skill:2;
  kokomi burst,
  attack:2, dash,
  attack:2, dash,
  attack:2, walk,
  attack:2;
  ningguang burst, skill, charge, 
  attack, charge,
  attack, charge;
  if .chiori.burst.ready {
    chiori burst;
  } else {
    ningguang attack, charge;
  }
}