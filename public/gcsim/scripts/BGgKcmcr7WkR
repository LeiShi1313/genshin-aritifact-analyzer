options swap_delay=12 iteration=1000;

# Build assumptions
varesa char lvl=90/90 cons=0 talent=9,9,9;
varesa add weapon="thewidsith" refine=3 lvl=90/90;
varesa add set="longnightsoath" count=4;
varesa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
varesa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="fjords" refine=1 lvl=90/90;
ineffa add set="aubadeofmorningstarandmoon" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.2317 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
xianyun add set="viridescentvenerer" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.551 em=158.56 cr=0.0662 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    } else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
      varesa jump;
      if .airborne {
        varesa high_plunge[collision=1]; # JP
      }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

active ineffa;

for let i=0; i<4; i=i+1 {
  ineffa skill;
  if !is_even(i) {
    ineffa burst;
    columbina skill, attack:2;
  } else {
    ineffa attack;
    columbina skill, burst;
  }
  xianyun skill, low_plunge, burst;
  varesa_combo(6);
  xianyun attack:2, dash; # Refreshing 4pc VV
}

# 18s rotations
# Ineffa E   > Columbina E Q  > Xianyun EPQ > Varesa 6 Plunge Combos > Xianyun N2D >
# Ineffa E Q > Columbina E N2 > Xianyun EPQ > Varesa 6 Plunge Combos > Xianyun N2D >
