let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.yelan && action_id == .action.skill ) {
    pick_up_crystallize("any"); # Pick up crystallize before every dash and Yelan E
  }

  return _execute_action(char_id, action_id, p);
}

options swap_delay=12 iteration=1000;

navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="nighttime" count=4;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311;
navia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=3 lvl=90/90;
yelan add set="emblemofseveredfate" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

gorou char lvl=90/90 cons=6 talent=9,9,9;
gorou add weapon="favoniuswarbow" refine=3 lvl=90/90;
gorou add set="noblesse" count=4;
gorou add stats hp=4780 atk=311 er=0.518 geo%=0.466 cr=0.311; #mainstats
gorou add stats def%=0.682 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.331;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="cinnabarspindle" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; # main
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active gorou;
for let x=0; x<4; x=x+1 {
  gorou attack:2, skill; # Feed geo particles directly to navia
  while !.gorou.mods.favonius-cd {
    gorou attack;
  }
  navia burst;
  yelan attack, skill, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack;
  }
  gorou burst; # 4pc Noblesse
  chiori skill:2;
  print(.navia.shrapnel);
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  yelan attack:2, skill;
  print(.navia.shrapnel);
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  navia attack; # for yelan E 10s cd lining up
}

