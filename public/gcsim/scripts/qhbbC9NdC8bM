options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,3.4 hp=999999999;
energy every interval=480,720 amount=1;

active raiden;
raiden skill;
for let x = 0; x < 5; x = x + 1 {
  xilonen burst, skill, attack:2;
  chiori skill, burst;
  sara skill, dash, burst;
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
}
