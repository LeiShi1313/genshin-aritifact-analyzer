let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.chiori && action_id == .action.skill ) || ( char_id == .keys.char.xilonen && action_id == .action.skill ) {
    pick_up_crystallize("any"); # Pick up crystallize before every dash
  }
  return _execute_action(char_id, action_id, p);
}


raiden char lvl=90/90 cons=2 talent=9,9,9;
raiden add weapon="engulfinglightning" refine=1 lvl=90/90;
raiden add set="emblemofseveredfate" count=4;
raiden add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311 ; #main
raiden add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

