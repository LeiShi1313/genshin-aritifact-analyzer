sigewinne add stats def%=0.124 def=39.36 hp=2031.52 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.1324;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;


active furina;

for let i=0; i<4; i=i+1 {

  furina skill, attack,burst;
  sigewinne attack,skill;
  citlali skill, burst;
  chasca skill, aim:4;
  chasca aim[bullets=4];
  if .chasca.burst.ready {
    chasca burst;
  }
}

wait(82); # wait for aim[bullets=4] hits the enemy at the last rot
