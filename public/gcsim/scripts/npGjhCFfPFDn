# Yanfei Rosaria Bennett Xianyun. ~20s Rot. Yanfei melts 6 plunges, waiting between Rosaria's cryo application. 

# Team
yanfei char lvl=90/90 cons=6 talent=9,9,9;
yanfei add weapon="widsith" refine=3 lvl=90/90;
yanfei add set="longnightsoath" count=4;
#yanfei add set="cw" count=4;
yanfei add stats hp=4780 atk=311.0 em=187 pyro%=0.4660 cr=0.311;
yanfei add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="emblem" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311 ; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.4634;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Al Haitham Plunge Combo
fn yanfei_plunge() {
  yanfei jump;
  if.airborne{
    yanfei high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active yanfei;
yanfei skill;

for let x = 0; x < 4; x = x + 1 {
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst;
  
  rosaria skill, burst;
  
  # Wait for Rosaria burst ticks
  yanfei_plunge(); yanfei dash;
  yanfei_plunge(); wait(50);
  yanfei_plunge(); wait(65);
  yanfei_plunge(); wait(65);
  yanfei_plunge(); wait(65);
  yanfei_plunge(); yanfei attack;
  yanfei skill;
  
  bennett skill;
  
}

