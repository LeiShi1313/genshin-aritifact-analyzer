yunjin char lvl=90/90 cons=6 talent=9,10,10;
yunjin add weapon="favoniuslance" refine=5 lvl=90/90;
yunjin add set="huskofopulentdreams" count=4;
yunjin add set="gladiatorsfinale" count=1;
yunjin add stats def%=1.924 def=95 hp=5049 hp%=0.047 atk=311 er=1.1400000000000001 em=82 cr=0.24100000000000002 cd=0.195;

amber char lvl=90/90 cons=6 talent=10,10,10;
amber add weapon="thunderingpulse" refine=5 lvl=90/90;
amber add set="echoesofanoffering" count=4;
amber add set="huskofopulentdreams" count=1;
amber add stats def=40 hp=5348 hp%=0.14 atk=348 atk%=0.659 em=63 cr=0.7889999999999999 cd=1.003 phys%=0.583;

kuki char lvl=90/90 cons=6 talent=9,10,8;
kuki add weapon="freedomsworn" refine=1 lvl=90/90;
kuki add set="paleflame" count=1;
kuki add set="tenacityofthemillelith" count=4;
kuki add stats hp=5019 hp%=0.932 atk=389 atk%=0.040999999999999995 er=0.538 em=372.5 cr=0.35300000000000004 cd=0.326;

rosaria char lvl=90/90 cons=6 talent=9,10,10;
rosaria add weapon="favoniuslance" refine=5 lvl=90/90;
rosaria add set="viridescentvenerer" count=1;
rosaria add set="noblesseoblige" count=4;
rosaria add stats def=60 hp=5288 atk=339 atk%=0.29200000000000004 er=1.0939999999999999 em=19 cr=0.7849999999999999 cd=0.194 cryo%=0.466;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active kuki;
for let i=0; i<4; i=i+1 {
  kuki skill;

  rosaria skill, burst;
  
  while !.yunjin.burst.ready && !.yunjin.mods.favonius-cd {
    while !.yunjin.skill.cd {
      yunjin skill;
    }
    yunjin attack;
  }
  yunjin burst;
  

  if .amber.burst.ready {
    amber burst;
  }
  amber skill;
  while .amber.mods.yunjin-c6 {
    amber attack: 5, dash;
  }
}

