# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Freminet Plunge Combo
fn FreminetPlunge() {
  freminet jump;
  if .airborne {
    freminet high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active freminet; # SS Stacks

for let x = 0; x < 4; x = x + 1 {
  furina skill, dash;
  if !.furina.burst.ready {
    furina attack;
  }
  furina burst;

  xianyun skill, low_plunge, burst;

  rosaria skill, burst;

  freminet skill, attack;
    FreminetPlunge(); freminet attack;
    FreminetPlunge(); freminet attack;
    FreminetPlunge(); freminet attack;
    FreminetPlunge(); freminet dash;
    FreminetPlunge(); freminet dash;
    FreminetPlunge(); freminet dash;
    FreminetPlunge(); freminet skill;
    FreminetPlunge(); #freminet dash;

  print("done");
}
