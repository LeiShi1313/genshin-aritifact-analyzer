options swap_delay=12 iteration=1000;

# Build assumptions
neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacjade" refine=1 lvl=90/90;
neuvillette add set="marechausseehunter" count=5;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.4464 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.2317 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="cg" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.3972 cd=0.4634;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active neuvillette;

for let i=0; i<4; i=i+1 {
  neuvillette skill;
  columbina skill, burst;
  fischl skill, attack;
  durin skill, burst, skill;
  neuvillette charge, burst, skill, charge;
  fischl attack:2, burst;
  durin attack, skill, skill;
  neuvillette charge:2;
}
wait(173);

# Neuvillette E > Columbina E Q > Fischl E N1 > Durin E Q E > Neuvillette C Q E C > Fischl N2 Q > Durin N1 2[E] > Neuvillette 2[C]
