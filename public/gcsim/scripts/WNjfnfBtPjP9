# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,3.4 hp=100000000; # No Contact Rainswords
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Contact Rainswords

#target lvl=100 resist=0.1 radius=1 pos=4,3.4 hp=100000000; # Secondary Target

# Rotation
active xq;

for let x=0; x<4; x=x+1 {
  xingqiu skill, dash, burst, attack;
  
  ororon skill, attack, burst;
  
  fischl attack, skill;
  
  yoimiya skill, attack:5, dash, attack:5, dash, attack:3, burst;
  
  fischl attack:2, burst;
  
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5;
}

