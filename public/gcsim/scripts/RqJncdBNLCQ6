chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  if .clorinde.bolratio >= 1 {
    clorinde skill;
    set_player_pos(0, -5); # clorinde uses her skill to lunge into the direction of sara's burst to extend sara's buff duration
    clorinde attack:3, skill;
    set_player_pos(0, 0);
  }
  clorinde attack:3, skill;
  set_player_pos(0, -5); # clorinde uses her skill to lunge into the direction of sara's burst to extend sara's buff duration
  clorinde attack:3, skill;
  set_player_pos(0, 0);
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active thoma;

thoma skill, burst;
sara skill, attack;
chev burst, skill[hold=1];
sara burst;
clorinde_combo();

for let i=0; i<5; i=i+1 { # 5 rotations in additions to modified first rotation

  sara aim;
  chevreuse attack, skill[hold=1], attack;
  clorinde burst;
  thoma skill, burst;
  if .sara.burst.ready { # sara burst when available
    sara skill, burst;
  } else {
    sara attack, skill, attack;
  }
  clorinde_combo();

}
