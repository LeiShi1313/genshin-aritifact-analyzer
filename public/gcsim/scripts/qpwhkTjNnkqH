# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

fn mualani_combo3() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

# Rotation
active mona;

# Mona E
mona skill;

# Mavuika Q + E
mavuika burst;
mavuika skill;

# Mona Q + 1 ataques normales
mona burst;
mona attack;

# Sucrose EDQ
sucrose skill, dash, burst;

# Mualani E + Q
mualani skill;
mualani burst;

# 3 mordiscos de 3 stacks
mualani_combo3();
