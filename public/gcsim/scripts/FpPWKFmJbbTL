mika char lvl=90/90 cons=6 talent=9,9,9; 
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="ohc" count=4;
mika add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359 ; #main
mika add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.1324;	

target lvl=100 resist=0.1 hp=9999999;
energy every interval=480,720 amount=1;

#sim config
options swap_delay=4 debug=true iteration=500 workers=30 mode=sl;
active xq;

for let i=0; i<4; i=i+1 {

  
  xq skill, dash, burst, attack;
  mika skill[hold=1], attack, burst;
  lisa skill[hold=1];
  if .lisa.burst.ready {
   lisa attack, burst;
  }
  freminet skill, burst,
           attack:2, skill, skill,
           attack:2, skill, attack:2, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
           attack:2, skill, attack:2, skill,
           attack:3, skill, attack;
           
  
}
