# Yoimiya Chevreuse Fischl Lisa. ~27s Rot. (TF) Yoimiya Overload. Chevreuse passes particles to Lisa if possible. Hamayumi doesn't justify not using burst.

# Team
yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
#yoimiya add weapon="hamayumi" refine=5 lvl=90/90;
yoimiya add set="tf" count=4;
yoimiya add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311;
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # EDC
#yoimiya add stats hp=4780 atk=311 em=187 em=187 cr=0.311;
#yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1102 em=59.46 cr=0.331 cd=0.7944; # EEC
#yoimiya add stats hp=4780 atk=311 em=187 em=187 em=187;
#yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944; # 3EC

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="scroll" count=4;
#chevreuse add set="no" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.4634;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="widsith" refine=3 lvl=90/90;
#lisa add weapon="ttds" refine=5 lvl=90/90;
lisa add set="no" count=4;
#lisa add set="emblem" count=4;
lisa add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # TTDS
#lisa add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; #main
#lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Widsith

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000; # Not Bad

#Rotation
active lisa;
lisa attack;

chevreuse burst, skill[hold=1];

for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  
  # Not bursting every rotation is better, despite the low ER req, even with NO
  if .chev.burst.ready && i > 1 {
    chev burst, skill[hold=1]:2;
  } else if i > 0 {
    chev skill[hold=1], attack;
  }
  
  lisa burst;
  
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5;
  
  fischl attack:2, burst;
  
  lisa skill[hold=1];
  
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, burst;
}
