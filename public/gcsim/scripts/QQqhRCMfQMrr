# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # deals burning AoE, -SS stacks

# Diluc Plunge Combo
fn DilucPlunge() {
  diluc jump;
  if .airborne {
    diluc high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active diluc; # SS stacks

for let r = 0; r < 4; r = r + 1 { 
  yaoyao skill;
  
  chongyun burst, skill;
  
  xianyun skill, low_plunge, burst;
  
  diluc skill;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); #diluc dash;
  diluc skill;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); #diluc dash;
  diluc skill;
  DilucPlunge(); diluc dash;
  DilucPlunge(); #diluc dash;
  #if r == 0 {
  #  diluc burst;
  #}
}

