wrio char lvl=90/90 cons=1 talent=9,9,9;
wrio add weapon="widsith" refine=3 lvl=90/90;
wrio add set="mh" count=4;
wrio add stats hp=4780 atk=311 atk%=.466 cryo%=0.466 cd=0.622;
wrio add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.3972 cd=0.331;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=3 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

jean char lvl=90/90 cons=0 talent=10,10,10;
jean add weapon="ak" refine=5 lvl=90/90;
jean add set="vv" count=5;
jean add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.6061 em=39.64 cr=0.331 cd=0.1324;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active furina;
for let i=0; i<4; i=i+1 {
 furina skill, attack, burst;
 while !.furina.mods.favonius-cd {
 furina attack;}

 yelan skill, burst, attack;
 while !.yelan.mods.favonius-cd {
 yelan attack;}

 jean skill, burst;

  wrio  skill,
        attack:5, charge, dash,
        attack:5, charge, dash,
        attack:5, charge, dash;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  }
  jean skill, attack:2;
}
