options swap_delay=12 iteration=1000;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="finale" refine=5 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
skirk add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="no" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*3 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

charlotte char lvl=90/90 cons=6 talent=9,9,9; 
charlotte add weapon="ttds" refine=5 lvl=90/90;
charlotte add set="tom" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 cryo%=0.466 atk%=0.466;
charlotte add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*7 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*7;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="scroll" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*7 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*7;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

let First_Rot_Nuke = true;  # Change this value between true and false.

active escoffier;

for let i=0; i<4; i=i+1 { 
  if is_even(i) {
    escoffier skill, attack, burst;
    yelan skill, burst, attack;
    charlotte skill[hold=1], attack;
  } else {
    escoffier skill, attack:2;
    yelan skill, burst, attack;
    charlotte skill[hold=1], burst, attack;
  }
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,
          
          attack:2, charge, dash,
    
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack;
  } else {
    skirk skill,
          attack:2, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:2;
  }
}

#Alternate between  Escoffier E N1 Q -> Yelan E Q N1 -> Charlotte hE N1     and
#                   Escoffier E N2   -> Yealn E Q N1 -> Charlotte hE Q N1

# First Rot Nuke Skirk Rotation: Skirk Q tE N5D N2CD 2[N5D] N2CD N5D N1
# Otherwise:                     Skirk   tE N2Q      3[N5D] N2CD N5D N2

