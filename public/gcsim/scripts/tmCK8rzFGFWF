# Lanyan Faruzan Furina Kokomi. ~20s Rot. Lanyan-Faruzan Quickswap. Sac Frags Lanyan skill/burst twice/once per rot with Faruzan aimed shots in between. Kokomi refreshes her skill with burst. TTDS lands on Lanyan. EM sands Lanyan is very slightly more DPS for a worse shield.

# Team - Options listed by DPS
lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="sacfrags" refine=5 lvl=90/90;
lanyan add set="mh" count=4;
#lanyan add set="vv" count=4;
lanyan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958; # MH
#lanyan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
#lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=99.1 cr=0.3972 cd=0.3972; # Other

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90;
faruzan add set="vv" count=4;
#faruzan add set="mh" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # VV
#faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
#faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296; # MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ToM

kokomi char lvl=90/90 cons=0 talent=9,9,9;
kokomi add weapon="ttds" refine=5 lvl=90/90;
kokomi add set="clam" count=4;
#kokomi add set="sodp" count=4;
#kokomi add set="tom" count=4;
kokomi add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
kokomi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.4464 er=0.3857 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # Right

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;

  faruzan burst, skill;

  kokomi skill, dash;

  lanyan skill:2, burst;

  faruzan aim:2, skill;

  lanyan skill:2;

  kokomi burst, attack:2;

  faruzan aim:2, skill, aim:2;
}
