active raiden;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

raiden skill;
for let i = 0; i < 5; i = i + 1 {
  xilonen skill, attack:2, burst;
  if i==0 {
    furina skill, dash, burst;
  } else {
    furina burst, skill, dash;
  }
  
  yelan burst, attack;
  xilonen skill, attack:2;
  yelan  skill, attack;
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:3;
  yelan skill, attack;
}

# (Raiden E) > Xilonen E N2 Q > Furina ED Q (or Q ED) > Yelan Q N1 > Xilonen E N2 > Yelan E N1 > Raiden Q N4E N4D N4D N3 > Yelan E N1