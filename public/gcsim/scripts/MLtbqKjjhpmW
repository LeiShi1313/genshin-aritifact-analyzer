options swap_delay=12 iteration=1000;

# Build assumptions
lauma char lvl=90/90 cons=6 talent=10,10,10;
lauma add weapon="reliquaryoftruth" refine=5 lvl=90/90;
lauma add set="notsu" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 cd=0.622;
lauma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.2979 cd=0.5958;

columbina char lvl=90/90 cons=6 talent=10,10,10;
columbina add weapon="nocturnescurtaincall" refine=5 lvl=90/90;
columbina add set="deepwood" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

nilou char lvl=90/90 cons=6 talent=10,10,10;
nilou add weapon="key" refine=5 lvl=90/90;
nilou add set="totm" count=2;
nilou add set="vg" count=2;
nilou add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
nilou add stats def%=0.124 def=39.36 hp=2539.4 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.1324;

nahida char lvl=90/90 cons=6 talent=10,10,10;
nahida add weapon="nightweaverslookingglass" refine=5 lvl=90/90;
nahida add set="sms" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.3972 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active lauma;
lauma attack;
for let i=0; i<4; i=i+1 {
  columbina swap;
  let StartFrame=f();
  columbina skill, burst;
  nahida skill, burst;
  if .verdant-dew + .moonridge-dew >= 3 && .lauma.skill.cd < 30 {
    lauma skill[hold=1];
  }
  lauma burst;
  nilou skill, attack:3;
  lauma swap;
  while f()-StartFrame < 1050 {
    lauma attack;
    if .lauma.normal==4 {
      lauma dash;
    }
    print("check");
    print("verdant-dew is ", .verdant-dew);
    print("moonridge-dew is ", .moonridge-dew);
    if .verdant-dew + .moonridge-dew >= 3 && .lauma.skill.cd < 25 {
      lauma skill[hold=1];
    }
  }
}
