# Eula Yae Fischl Xianyun. ~18s Rot. Eula Phys plunge with Superconduct. Eula uses tEQhE if burst is available, other using tEN2, then hE after plunges. OHC > VV Xianyun, but bubbles may miss. 50% Collisions.

# Team - Options ordered by DPS
eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
eula add set="longnightsoath" count=4;
#eula add set="pf" count=4;
#eula add set="pf" count=2;eula add set="bsc" count=2;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="flowingpurity" refine=5 lvl=90/90;
#yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="evenstar" refine=1 lvl=90/90;
yae add set="tom" count=4;
#yae add set="gt" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ADC
#yae add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1102 em=118.92 cr=0.2317 cd=0.7944; # 3EM

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
#fischl add set="tom" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9; 
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="vv" count=4;
#xianyun add set="no" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active eula; # SS Stacks

for let x = 0; x < 4; x = x + 1 {
  yae skill:3;
  
  amy attack;
  if .amy.skill.ready { 
    amy skill; 
  } else { 
    amy attack, burst; 
  }
  
  #eula skill;
  
  xianyun skill, high_plunge, burst;
  
  # Minor burst stacking when available
  if .eula.burst.ready && .eula.energy == .eula.energymax {
    eula skill, burst, skill[hold=1];
    # Plunge spam after RES shred
    while .eula.status.xianyun-airborne-buff {
      eula jump;
      if .airborne {
        eula high_plunge[collision=rand()>0.5];
      }
      if .eula.status.xianyun-airborne-buff { # swap > dash for final plunge
        eula dash;
      }
    }
  } else {
    eula skill, attack:2;
    # Plunge spam after RES shred
    while .eula.status.xianyun-airborne-buff {
      eula jump;
      if .airborne {
        eula high_plunge[collision=rand()>0.5];
      }
      if .eula.skill.ready {
        eula skill[hold=1];
      } if .eula.status.xianyun-airborne-buff { # swap > dash for final plunge
        eula dash;
      }
    }
  }
  
  print("done");
}

