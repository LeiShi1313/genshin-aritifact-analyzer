# Dori Emilie Fischl Xiangling. ~15s Rot. Dori Quickburn. Emilie & Xiangling burst every other rotation; Fischl alternates skill and burst. Xiangling goes after Fischl and bursts every other rotation.

# Team
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="mailedflower" refine=5 lvl=90/90;
#dori add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5]; # Inconsistent
#dori add weapon="aquamarine" refine=1 lvl=90/90;
#dori add weapon="talkingstick" refine=1 lvl=90/90; dori add stats atk%=0.16 electro%=0.12 pyro%=0.12; # Passive not implemented; SS alternative
dori add set="tf" count=4;
dori add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.1986 cd=0.662; #Em/El/Cr; MF
#dori add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
#dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.2317 cd=0.7282; #Em/Em/Cr; Aqua
#dori add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.3972 cd=0.2648; #Em/El/Cd; SS
#dori add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
#dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.3972 cd=0.3972; #Em/Em/Cd

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
#fischl add set="ur" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9; 
xiangling add weapon="kitain" refine=5 lvl=90/90;
xiangling add set="deepwood" count=4;
#xiangling add set="tom" count=4;
xiangling add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.551 em=118.92 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active fischl;
#active dori; # SS Stacks

for let i=0; i<5; i=i+1 {
  # if XL before fischl, No N1 from XL
  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
  
  if .xiangling.burst.ready {
    xiangling burst, attack, skill, dash;
  } else {
    xiangling attack, skill, dash;
  }
  
  # Burst in 2nd Rot onward; Burning triggers first before oz/fischl C6
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  
  while .fischl.oz {
    switch {
      case .dori.skill.ready:
        dori skill;
      case .dori.burst.ready: # && .dori.infusion.dori-c6:
        dori burst;
      case .dori.normal > 2 && .dori.dash.ready && .stam > 18:
        dori dash;
      default:
        dori attack;
    }
  }
  
}
