# Yoimiya Yelan Fischl Ororon. ~18s Rot. Yoimiya Overvape; Yoimiya prefers EEC > 3EM >= EDC. Yoimiya bursts as available. Fischl alternates skill and burst.

# Team
yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
#yoimiya add weapon="hamayumi" refine=5 lvl=90/90;
yoimiya add set="sr" count=4;
#yoimiya add set="echoes" count=4;
yoimiya add stats hp=4780 atk=311 em=187 em=187 cr=0.311;
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=59.46 cr=0.2979 cd=0.7944; # EEC
#yoimiya add stats hp=4780 atk=311 em=187 em=187 em=187;
#yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944; # 3EM
#yoimiya add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311;
#yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.1655 cd=0.7944; # EDC

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
#fischl add set="tom" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; 
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="chainbreaker" refine=5 lvl=90/90;
#ororon add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yelan;

for let x=0; x<4; x=x+1 {
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  ororon burst, attack, skill;
  
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack:2, burst;
  }
  
  yoimiya attack, skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if .yoimiya.burst.ready && .yoimiya.energy == .yoimiya.energymax {
    yoimiya burst; 
  } else {
    yoimiya attack:1;
  }
}
