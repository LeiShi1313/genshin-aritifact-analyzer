chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="hamayumi" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
chasca add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2480 er=0.1102 em=39.64 cr=0.3641 cd=0.662;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favoniuslance" refine=3 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.551 em=39.64 cr=0.331 cd=0.1324;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=3 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=2;
bennett add set="eosf" count=2;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active ororon;

for let i=0; i<4; i=i+1 {
  if .shenhe.burst.ready {
    ororon skill, burst;
    shenhe skill [hold=1], burst;
  } else {
    shenhe skill[hold=1];
    ororon skill, burst;
  }
  bennett skill, burst;
  chasca skill, aim:4, aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  }
}
wait(82); # 82f wait for the last 4bullet CA to hit
