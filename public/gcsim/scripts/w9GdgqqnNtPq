# Hutao Yelan Aino Ineffa. ~18s Rot. KQMS KurtC. Hutao Shielded Lunar Overvape. Hutao E 8N2CJ N1Q/N1CJ. Ineffa bursts every other rotation after the first.

# Team - Options listed by DPS
hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="fjords" refine=1 lvl=90/90;
hutao add set="notsu" count=4;
hutao add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 cd=0.622; #main
hutao add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*5 cr=0.0331*11 cd=0.0662*10;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="sms" count=4;
#yelan add set="no" count=4;
#yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*10 cd=0.0662*11; # SMS
#yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*2 cr=0.0331*10 cd=0.0662*7; # NO

aino char lvl=90/90 cons=6 talent=9,9,9;
aino add weapon="favgs" refine=3 lvl=90/90;
aino add set="no" count=4;
aino add stats hp=4780 atk=311 em=187 em=187 cr=0.311;
aino add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="fjords" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*3 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active ineffa;

for let i=0; i<4; i=i+1 {
  if i > 0 && .ineffa.burst.ready {
    ineffa skill, attack, burst;
  } else if i > 0 {
    ineffa attack, skill;
  } else {
    ineffa skill;
  }

  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  aino skill, burst;

  hutao skill,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump;
  if .hutao.burst.ready {
    hutao attack:1, burst;
  } else {
    hutao attack:1, charge, jump;
  }
}
