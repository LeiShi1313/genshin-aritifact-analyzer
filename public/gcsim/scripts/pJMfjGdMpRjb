# Nilou Bloom with Yelan. Single target. KQMS. 
# VG4 and MH4 can be better than EOSF4 for yelan, but it is inconsistent and depends on Baizhu shield depletion.
# DW Nahida + Clam Baizhu is 1.5% better than GT Nahida + DW Baizhu
# Baizhu Dendro goblet is slightly better for c0 Nahida, while HP% is slightly better for c1+ Nahida.
# Nilou c1(7%), c2(additional 18%), Key(13%), Nahida c1(12%), c2(additional 11%) are key investments.
# Aqua(5%) Floating dreams(3%) Yelan c2(3%) c3(additional 4%) do not provide good value.
# For nahida c0, Aqua has 10% improvement over Stringless r3; Slingshot r5 is about equal with Stringless r3.
# Nahida c1 has high value because it increases bloom production.
# Similarly Yelan c2 has low value because it decreases bloom production.
# For AOE situation, FOPL / EM build can over take crit Yelan.

nahida char lvl=90/90 cons=2 talent=9,9,9;
nahida add weapon="sacfrag" refine=3 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=158.56 cr=0.0993 cd=0.7944;

nilou char lvl=90/90 cons=2 talent=9,9,9;
nilou add weapon="key" refine=1 lvl=90/90;
nilou add set="tom" count=2;
nilou add set="vourukashasglow" count=2;
nilou add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
nilou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.2648 cd=0.1324;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="stringless" refine=3 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="clam" count=4;
baizhu add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.4959 em=39.64 cr=0.331 cd=0.331;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999; 

active nilou;
for let r = 0; r < 5; r = r + 1 {
  nilou skill, attack:2, skill;
  nahida skill, attack, burst;
  baizhu skill, burst;
  while !.baizhu.mods.favonius-cd {
    baizhu attack;
  }
  yelan  burst, attack, skill, attack:4, dash, attack:4, dash, attack:3;
  baizhu attack, skill, attack:2;
  while !.baizhu.mods.favonius-cd {
    baizhu attack;
  }
  yelan attack:4, dash, attack:2, skill;
}

