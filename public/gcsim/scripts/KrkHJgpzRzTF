furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="harbinger" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ;
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5282;												

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active navia;

  furina skill, dash, burst;
  navia skill, burst;
  xianyun skill, low_plunge, burst;
  yelan burst, attack, skill, attack;
  for let n = 2; n > 0; n = n - 1 {
    navia skill[hold=1];
    for let h = 3; h > 0; h = h - 1 {
      navia jump;
      if .airborne {
          navia high_plunge[collision=rand()>0.5], dash;
      }
    }
    navia jump;
    if .airborne {
        navia high_plunge[collision=rand()>0.5], attack;
    }
  }
  
for let i = 0; i < 2; i = i + 1 {
  yelan skill, attack;
  xianyun skill, low_plunge;
  furina skill, dash, burst;
  xianyun burst;
  if !i {
    navia skill[hold=1];
  }
  navia burst;
  yelan burst, attack, skill, attack;
  for let n = 2; n > 0; n = n - 1 {
    navia skill[hold=1];
    for let h = 3; h > 0; h = h - 1 {
      navia jump;
      if .airborne {
          navia high_plunge[collision=rand()>0.5], dash;
      }
    }
    navia jump;
    if .airborne {
        navia high_plunge[collision=rand()>0.5], attack;
    }
  }
}
navia skill[hold=1];