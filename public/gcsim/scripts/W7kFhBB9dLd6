barbara char lvl=90/90 cons=6 talent=9,9,9; 
barbara add weapon="favcodex" refine=3 lvl=90/90;
barbara add set="clam" count=4;
barbara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359 ; #main
barbara add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

target lvl=100 resist=.1 hp=9999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=500;

active furina;
for let x=0; x<4; x=x+1{
  furina skill, dash, burst;
  
  barbara burst;
  if .barbara.skill.ready {
    barbara skill, dash;
  } else {
    barbara attack;
  }
  
  fischl attack:2, skill;
  xiangling burst, skill, dash;
  
  barbara attack:4, dash, attack:4, dash, attack:4, dash, attack:4, dash, attack:4, dash;
  
  fischl attack:2, burst;
  xiangling attack:2, skill, dash;
  furina attack:2;
  
  barbara attack:4, dash, attack:4, dash, attack:4, dash;
}