lynette char lvl=90/90 cons=6 talent=9,9,9; 
lynette add weapon="finale" refine=5 lvl=90/90;
lynette add set="viridescentvenerer" count=4;
lynette add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311 ; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

ororon char lvl=90/90 cons=6 talent=9,9,9; 
ororon add weapon="chainbreaker" refine=5 lvl=90/90 +params=[stacks=10];
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="esf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=100;            
target lvl=100 resist=0.1 radius=2 pos=2.1,1.5 hp=3600000; 
energy every interval=480,720 amount=1;

active fischl;

while 1 {
  switch {
    case .fischl.skill.ready:
      fischl skill, attack, attack;
    case .fischl.burst.ready && !.fischl.oz:
      fischl attack:2, burst;
    case .yelan.burst.ready:
      yelan burst, attack;
    case .yelan.skill.ready:
      yelan attack, skill, attack;
    case .lynette.burst.ready:
      lynette burst, attack;
    case .ororon.skill.ready:
     ororon skill, burst, attack;
    case .lynette.skill.ready:
      lynette skill, attack;
    case .lynette.normal == 2 && .stam > 50:
      lynette charge, dash;
    case .lynette.normal == 4:
      lynette jump;
    default:
      lynette attack;
  }
}