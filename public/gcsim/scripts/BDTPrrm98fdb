options swap_delay=12 iteration=1000  workers=8 ;

navia char lvl=90/90 cons=0 talent=9,9,9; 
navia add weapon="serpentspine" refine=5 lvl=90/90 +params=[stacks=5];
navia add set="nighttime" count=5;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311 ; #main
navia add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944 ;

zhongli char lvl=90/90 cons=0 talent=9,9,9; 
zhongli add weapon="favoniuslance" refine=5 lvl=90/90;
zhongli add set="totm" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311 ; #main
zhongli add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;										

kokomi char lvl=90/90 cons=0 talent=9,9,9; 
kokomi add weapon="ttds" refine=5 lvl=90/90;
kokomi add set="clam" count=5;
kokomi add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359 ; #main
kokomi add stats def=39.36 def%=0.124 hp=1523.64 hp%=0.496 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.0662 cd=0.1324 ;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="goldentroupe" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662 ;

active furina;	
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
	furina skill, dash;
	if !.furina.burst.ready {
	  furina attack;
	} 
	furina burst;
    zhongli skill[hold=1], dash;
    while !.zhongli.mods.favonius-cd { 
        zhongli attack;
        pick_up_crystallize("any");
    }
    navia burst;
    pick_up_crystallize("any");
    kokomi skill, dash, attack:2;
    pick_up_crystallize("any");
    navia attack, skill, attack:3, dash, attack:2;
    kokomi burst, attack:2, dash;delay(2);pick_up_crystallize("any");kokomi attack:2, dash;delay(2);pick_up_crystallize("any"); kokomi attack;
    pick_up_crystallize("any");
    zhongli attack, skill, attack;
    pick_up_crystallize("any");
    navia skill, attack:3, dash, attack;
}
