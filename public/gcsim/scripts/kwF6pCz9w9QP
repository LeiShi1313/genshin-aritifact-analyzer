# Kaeya Furina Chongyun Xianyun. ~20s Rot. Kaeya Freeze Plunge with Chongyun. Chongyun passes particles to Xianyun. Reliable Cryo VV, unreliable Hydro VV. -4K DPS with Freeze immnuity. 50% Collisions.

# Team - Options listed by DPS
kaeya char lvl=90/90 cons=6 talent=9,9,9;
kaeya add weapon="harbinger" refine=5 lvl=90/90;
#kaeya add weapon="finale" refine=5 lvl=90/90;
kaeya add set="lno" count=4;
kaeya add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # HoD
#kaeya add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
#kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Finale

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freeze Immunity

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  chongyun burst, skill;

  xianyun skill, low_plunge, attack, burst; # Attack increases hydro VV chance.

  kaeya skill;
  # Plunge to buff expiration
  while .kaeya.status.xianyun-airborne-buff {
    if .kaeya.burst.ready {
      kaeya burst;
    } else if .kaeya.skill.ready {
      kaeya skill;
    } else {
      kaeya jump;
      if .airborne {
        kaeya high_plunge[collision=rand()>0.5];
      }
      if .kaeya.status.xianyun-airborne-buff { # no dash for final plunge
        kaeya dash;
      }
    }
  }
  # Skill off CD, otherwise N1C to fill Furina skill downtime CD
  while .furina.skill.cd {
    if .kaeya.skill.ready {
      kaeya skill;
    } else if .kaeya.normal > 1 {
      kaeya charge;
    } else {
      kaeya attack;
    }
  }
}
