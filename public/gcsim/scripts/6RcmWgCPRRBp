# Build
neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.1986 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="favcodex" refine=3 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="favcodex" refine=3 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.331 cd=0.1324;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="eosf" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.331 cd=0.4634;

# Options
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

# Rotation
active neuvillette;

for let i=0; i<4; i=i+1 {
  neuvillette skill, attack;
  sucrose swap;
  wait(20);
  sucrose skill, dash;
  citlali skill, burst;
  xiangling skill, dash, burst;
  neuvillette charge, burst, skill, charge;
  sucrose skill, dash, burst;
  xiangling attack:2, skill, dash;
  neuvillette charge, charge;
}
wait(173);

# ~26s rotations
# Neuvillette E N1 > Sucrose ED > Citlali EQ > Xiangling ED Q > Neuvillette C Q E C > Sucrose EDQ > Xiangling N2 ED > Neuvillette 2[C]
