ningguang char lvl=90/90 cons=6 talent=9,9,9;
ningguang add weapon="widsith" refine=3 lvl=90/90;
ningguang add set="nighttime" count=4;
ningguang add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311;
ningguang add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

ayaka char lvl=90/90 cons=0 talent=9,9,9; 
ayaka add weapon="wolffang" refine=1 lvl=90/90;
ayaka add set="esf" count=4;
ayaka add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
ayaka add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1103 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbingerofdawn" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

# Options
options iteration=100; 
options swap_delay=12;
options duration=90;
energy every interval=480,720 amount=1;

let normal_attack_state = 1;
let c_left = 0;
let c_twirl = 2;
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	pick_up_crystallize("any"); # Pick up crystallize before every dash
  }
  return _execute_action(char_id, action_id, p);
}

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0;

# Rotation
active bennett;
for {
  switch {
    case .bennett.burst.ready && .bennett.swap.ready:
      bennett skill, burst;
    case .ayaka.skill.ready && !.ningguang.onfield && .ayaka.swap.ready:
      ayaka dash, skill, attack;
    case .ayaka.burst.ready && .ayaka.swap.ready && .status.bennettburst:
      ayaka burst;
    case .chiori.skill.ready && .chiori.swap.ready:
      chiori skill:2;
    case .ningguang.skill.ready && .ningguang.swap.ready && (!.status.bennettburst || .ningguang.mods.bennett-field):
      ningguang skill, dash, attack;
    case .ningguang.burst.ready && .ningguang.swap.ready:
      ningguang burst, walk, attack;
    case .ningguang.jadeCount == 7 && .ningguang.swap.ready:
      ningguang charge;
    case .ningguang.onfield && .state == normal_attack_state:
      if .ningguang.prevAttack == c_left || .ningguang.prevAttack == c_twirl {
        ningguang charge;
      } else {
        ningguang walk;
      }
    default:
      ningguang attack;
  }
}
