# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active lauma;

for let i = 0; i < 5; i = i + 1 {
  if i > 0 {
    lauma burst, skill[hold=.dew>0];
  } else {
    lauma skill;
  }

  xingqiu burst, attack;

  alhaitham burst, attack;

  ineffa skill;

  alhaitham attack:3, dash,
            attack:3, dash,
            attack:3, dash,
            attack:3;

  xingqiu attack, skill, dash, attack;

  alhaitham skill[hold=1], low_plunge[short=1],
           attack:3, dash,
           attack:3, dash,
           attack:3, dash;
}
