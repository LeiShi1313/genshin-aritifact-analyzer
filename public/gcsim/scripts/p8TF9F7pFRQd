# Clorinde Kirara Fischl Xilonen. ~25s Rot. TF Clorinde Aggravate, shielded. Clorinde, Kirara, and Xilonen do not burst. Kirara builds for shield. Ins Kirara is -3K DPS. Clorinde takes the sapwood leaf.

# Team
clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="calamityofeshu" refine=5 lvl=90/90;
#clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="tf" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
clorinde add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 def=39.36 def%=0.124 em=39.64 er=0.1102 cr=0.3972 cd=0.662;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="sapwood" refine=5 lvl=90/90+params=[pickup_delay=165]; # AP; During Clorinde skill dash
#kirara add weapon="sapwood" refine=5 lvl=90/90+params=[pickup_delay=240]; # Ins; During Clorinde skill dash
kirara add set="ap" count=4;
#kirara add set="ins" count=4;
kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
kirara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.3972 cd=0.331; # AP/Shields
#kirara add stats hp=3571 atk=232 hp%=0.466 hp%=0.3495 hp%=0.3495; #main
#kirara add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.333648 cd=0.222432; # Ins/Shields

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main
fischl add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=79.28 er=0.1102 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
#xilonen add set="ap" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

#Rotation
active fischl;

for let r=0; r<4; r=r+1 {
  fischl attack, skill;

  if .kirara.sets.ap == 4 {
    xilonen skill, attack:2;

    kirara skill[short_hold=1]; pick_up_crystallize("any");
    #kirara burst;
  } else {
    kirara skill[short_hold=1];

    xilonen skill, attack:2;
  }

  clorinde_combo();

  fischl attack:2, burst;

  if .kirara.sets.ap == 4 {
    xilonen skill, attack:2;

    kirara skill[short_hold=1]; pick_up_crystallize("any");
  } else {
    kirara skill[short_hold=1];

    xilonen skill, attack:2;
  }

  clorinde_combo();
  #if .clorinde.burst.ready {
  #  clorinde burst;
  #}
}
