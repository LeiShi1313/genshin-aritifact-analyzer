mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="mailedflower" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
mavuika add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662 ;

options swap_delay=12 iteration=100;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 


active furina;
furina skill, dash, burst;
for let i=0; i<4; i=i+1 {
  ororon skill, attack, burst, attack:2;
  if i {
    furina skill, dash, attack;
  } 
  mav burst, charge:3, skill, charge, dash;
  chasca skill, aim:4;
  chasca aim[bullets=4];
  if .chasca.burst.ready {
    chasca burst;
  }
}

