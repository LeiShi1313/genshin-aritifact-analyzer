# Yae Nahida Fischl Dehya. ~25s Rot. Yae Quickburn. Yae uses burst every rotation after N1CD/N2CDs to regen stamina. Nahida uses burst every rotation.

# Team - Options listed by DPS
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="solarpearl" refine=1 lvl=90/90;
yae add set="ur" count=4;
#yae add set="gd" count=4;
#yae add set="gt" count=4;
yae add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # CR
#yae add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.3641 cd=0.662; # CD

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
#nahida add set="deepwood" count=4;
#nahida add set="tom" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=118.92 cr=0.2979 cd=0.5958;

fischl char lvl=90/90 cons=6 talent=9,9,9; 
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
#fischl add set="ur" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

dehya char lvl=90/90 cons=0 talent=9,9,9;
dehya add weapon="aquamarine" refine=1 lvl=90/90;
#dehya add weapon="regalia" refine=1 lvl=90/90 +params=[pickup_delay=90]; # To Yae
dehya add set="deepwood" count=4;
#dehya add set="tom" count=4;
dehya add stats hp=4780 atk=311 em=187 em=187 em=187; #main
dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

for let i = 0; i < 4; i = i + 1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae attack, skill, attack, skill, attack, skill;
  }
  
  nahida skill, burst;
  
  fischl attack, skill;
  
  dehya skill:2;
  
  yae attack:1, charge, dash,
      attack:2, charge, dash,
      attack:2, charge, dash, 
      burst, attack, skill:3; # You really need to regen stamina here
  
  fischl attack:2, burst;
  
  nahida skill, attack, charge;

  yae attack:2, charge, jump,
      attack:2, charge, jump,
      attack:3; 
}
