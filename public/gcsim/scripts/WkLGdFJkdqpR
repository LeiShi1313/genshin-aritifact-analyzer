# Razor Zhongli Yunjin Rosaria. ~20s Rotation. Razor Double Geo with Rosaria.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="pf" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622;
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9; 
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="favlance" refine=3 lvl=90/90;
yunjin add set="husk" count=4;
yunjin add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; # main
yunjin add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.2648;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311; # main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active razor;

for let i=0; i<4; i=i+1 {
  razor skill, dash;
  
  zhongli skill[hold=1], dash, attack;
  if !.zhongli.mods.favonius-cd && i > 0 {
    zhongli attack;
  }
  
  #Triggers fav every rotation
  yunjin skill;
  if !.yunjin.mods.favonius-cd {
    yunjin attack;
  }
  yunjin burst;

  rosaria skill, burst;
  
  # Razor out of burst actions
  razor attack;
  while !.razor.mods.razor-q {
    if .razor.burst.ready && .razor.skill.ready {
      razor skill, dash, attack, burst;
    } else if .razor.burst.ready {
      razor burst;
    } else if .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  # Razor Main DPS window
  while .razor.mods.yunjin-c6 || .razor.mods.razor-q > 290 {
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
  rosaria skill;
}

