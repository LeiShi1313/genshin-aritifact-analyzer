# Eula Chongyun Escoffier Xianyun. ~17s Rot. Eula Cryo Plunge. Chongyun uses Skill just before Xianyun and the Cryo infusion lasts for all 8 plunges. Xianyun VV also lasts for all 8 plunges. Eula immediately uses hold skill with Grimheart stacks to shred Cryo RES and her skill returns agains before her field time ends thanks to Chongyun's CDR. Escoffier's burst is a slight DPS loss. 50% Collisions.

# Team
eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#eula add weapon="fruitfulhook" refine=1 lvl=90/90;
eula add set="lno" count=4; # Everything else sucks
eula add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # LNO

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3857 em=59.46 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active eula; # SS Stacks
eula skill; # Grimheart stack

for let i = 0; i < 4; i = i + 1 {
  #if i > 0 && .esco.burst.ready && .esco.energy == .esco.energymax {
  #  esco burst;
  #}
  esco skill;
  
  chongyun burst, skill;
  
  xianyun skill, low_plunge, burst;
  
  # Plunge until expiry
  while .eula.status.xianyun-airborne-buff {
    if .eula.skill.ready {
      eula skill[hold=1]; # Consumes Grimheart stack for Cryo RES Shred.
    } else {
      eula jump;
      if .airborne {
        eula high_plunge[collision=rand()>0.5];
      }
      if .eula.status.xianyun-airborne-buff { # no dash for final plunge
        eula dash;
      }
    }
  }
  eula attack, skill;
  
}

