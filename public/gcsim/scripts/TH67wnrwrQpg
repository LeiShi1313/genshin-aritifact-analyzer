yaoyao add stats hp=3571 atk=232 hp%=0.466 hp%=0.348 cr=0.232;
yaoyao add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.333648;

options iteration=100 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active sethos;
sethos aim[hold=1];

for let i=0; i<4; i=i+1 {
  kazuha skill, high_plunge, burst;
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  # Ensure ins proc and fill time for Sethos E cooldown
  yaoyao skill, attack:2;
  kaz skill, high_plunge;
  sethos aim[hold=2],
         skill, burst,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack, skill;
  # Yaoyao can optionally burst for team healing as needed
  # yaoyao burst, attack:2, dash, attack:2;
}
