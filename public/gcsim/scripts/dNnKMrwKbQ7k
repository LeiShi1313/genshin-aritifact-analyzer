#Nahida GT Xingqiu DW has 1% higher simulated DPS than Nahida DW Xingqiu EOSF

nahida char lvl=90/90 cons=0 talent=9,9,9;
#SacJade has marginally higher simulated DPS than Widsith, and 1% higher simulated DPS than SacFrags
nahida add weapon="sacjade" refine=1 lvl=90/90;
nahida add set="gt" count=4;
#em/em/cr has 0.5% higher simulated DPS than em/dendro/cr
nahida add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=138.74 cr=0.2648 cd=0.5958;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="deepwood" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="clam" count=4;
baizhu add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.3972 cd=0.1986;

kuki char lvl=90/90 cons=6 talent=9,9,9;
#Xiphos r1 has 1% higher simulated DPS than Iron Sting r5
kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="fopl" count=4;
kuki add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.3641 cd=0.331;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active kuki;

for let i = 0; i < 5; i = i + 1 {
  nahida skill, burst;
  baizhu burst, skill;
  xingqiu skill, dash, burst, attack;
  kuki
    skill,
    attack:3, dash,
    attack:3, dash,
    attack:3, dash,
    attack:3, dash,
    attack:3;
  baizhu attack, skill;
  while !.baizhu.mods.favonius-cd {
    baizhu attack;
  }
  kuki
    attack:3, dash,
    attack:3, burst,
    attack:2;
}
