# Fischl Furina Rosaria Mika. ~20s Rot. Physchl with more Phys RES shred. Fischl uses an ATK goblet and deals approx. 54% Phys damage.

# Team
fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="rust" refine=3 lvl=90/90;
fischl add set="mh" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; # main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # TATK
#fischl add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; # main
#fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Phys

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ToM

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favspear" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311 ; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="ohc" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;
let AIM_CANCEL=true;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  mika burst, attack, skill;

  rosaria skill, burst;

  fischl attack;
  if .fischl.burst.ready {
    fischl attack, burst;
  } else {
    fischl skill;
  }

  if AIM_CANCEL {
    fischl attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0];
            #attack:2, aim[hold=0];
  } else {
    fischl attack:5, dash,
            attack:5, dash,
            attack:5, dash,
            attack:5, dash,
            attack:2;
            #attack:3;
  }

}
