# Dori Nahida Fischl Jean. ~28s Rotation. Dori Aggravate with Fav GS decreasing ER requirements. Full EM Jean swirls self Electro applied by Dori's lamp.

# Team- Options listsed by DPS
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
dori add set="thunderingfury" count=4;
dori add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; # main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=6,9,9;
nahida add weapon="hakushinring" refine=5 lvl=90/90;
#nahida add weapon="widsith" refine=3 lvl=90/90;
#nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
#nahida add set="gt" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; # main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;
#nahida add stats hp=4780 atk=311 em=186.5 em=186.5 em=186.5;
#nahida add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 em=118.89 er=0.1101 cr=0.3305 cd=0.6605;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="thestringless" refine=3 lvl=90/90;
fischl add set="goldentroupe" count=4;
fischl add stats hp=4780 atk=311 em=186.5 electro%=0.466 cr=0.311;
fischl add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.1487 def=39.35 def%=0.1239 em=59.45 er=0.1101 cr=0.3305 cd=0.7926;

jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="xiphos" refine=1 lvl=90/90;
#jean add weapon="favsword" refine=1 lvl=90/90;
jean add set="vv" count=4;
jean add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
jean add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.331 cd=0.2648; #Crit
#jean add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
#jean add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.4408 em=118.92 cr=0.0662 cd=0.1324; #ATK


# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active dori; #SS Stacks

for let i=0; i<4; i=i+1 {
  dori skill, burst;

  jean attack, burst;

  fischl attack:2, burst;

  nahida skill, burst, attack, charge;

  jean attack, skill;

  dori skill, attack:2, dash, attack:2;

  nahida skill, attack, charge;

  fischl attack:1, skill;

  dori skill, attack:2, dash, attack:2;

  jean attack, skill;

  dori skill, attack:2, dash, attack:2;

  nahida skill, attack, charge;
  print("done");
}
