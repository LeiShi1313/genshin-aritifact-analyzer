chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn naviaskill() {
  if .navia.shrapnel >=3 { # check current shrapnel stacks. if 3-6 stakcs, use tap E, otherwise hold E
    navia skill;
  } else {
    navia skill[hold=1];
  }
}

active navia;
for let i=0; i<4; i=i+1 {
  if is_even(i) {
    escoffier skill, burst;
  } else {
    xilonen burst;
    escoffier skill, attack;
  }
  xilonen skill, attack:2;    pick_up_crystallize("any"); 
  navia burst;
  chongyun burst, skill;
  naviaskill();
  navia attack:3, dash;
  xilonen skill, attack:2;    pick_up_crystallize("any"); 
  naviaskill();
  navia attack:3, dash, attack:2;
  if !is_even(i) {
    naviaskill();
    navia attack:3, dash, attack:2;
  }
}

