citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="favcodex" refine=3 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  mualani skill;
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

active furina;

for let i=0; i<3; i=i+1 {
  furina skill, dash, attack:2, dash, attack:2, dash;
  citlali skill, attack:2;
  furina burst;
  esco skill, burst;
  mualani_combo();
  mualani skill; # exit the nightsoul state to enter E cd earlier
  mualani burst;
  citlali skill, burst;
  esco skill, attack;
  mualani_combo();
}
