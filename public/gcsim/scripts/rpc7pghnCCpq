yoimiya char lvl=90/90 cons=1 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="notsu" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
yoimiya add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="aubade" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*9 cr=0.0331*7 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="sms" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

active fischl;

for let i=0; i < 4; i=i+1 {

  if i > 0 && .ineffa.burst.ready {
    ineffa skill,burst;
  } else if i > 0 {
    ineffa skill,attack;
  } else {
    ineffa skill;
  }

  if .bina.burst.ready {
    bina skill, burst;
  } else {
    bina attack,skill;
  }

  if .fischl.skill.ready {
    fischl skill,attack;
  } else {
    fischl attack:2, burst;
  }
  if i > 0 {
    yoi attack;
  }
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5,dash,attack:3;
  if .yoi.burst.ready {
    yoi burst;
  } else {
    yoi attack:1;
  }

}
