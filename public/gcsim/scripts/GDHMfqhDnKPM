options swap_delay=12 iteration=1000;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active furina;

for let i=0; i<4; i=i+1 {

  if .furina.skill.ready { # xilo burst before furina skill
    xilo burst;
    furina skill, dash, burst;
  } else {
    navia burst; # navia burst if furina skill is still on cooldown
  }
  xilonen skill, attack:2;
  navia skill, attack:2;
  clorinde_combo();
  if .clorinde.burst.ready { # use clorinde's burst if ready
    clorinde burst;
  }
  navia skill;

}
