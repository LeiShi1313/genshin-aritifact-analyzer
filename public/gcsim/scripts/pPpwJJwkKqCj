bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;
											

options swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
active shenhe;
  

for let i=0; i<4; i=i+1 {
  shenhe burst;
  bennett burst, skill;
  xiangling burst, skill;
  shenhe skill[hold=1];         wait(20); # hiding swap cd warning
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge;
  bennett skill;                wait(30); # hiding swap cd warning
  xiangling skill;              wait(40); # hiding swap cd warning
  shenhe attack:4, skill;
  wrio burst;
  wrio attack:2, jump; # for Shenhe E and Xiangling E cd
}
