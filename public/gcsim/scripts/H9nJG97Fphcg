# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i = 0; i < 4; i = i + 1 {
  nicole skill, attack, burst;

  durin attack, skill, burst, skill, attack; # Just filling time

  xiangling burst, skill, dash;

  raiden burst,
         attack:4, skill,
         attack:4, dash,
         attack:4, dash,
         attack:4;
}
