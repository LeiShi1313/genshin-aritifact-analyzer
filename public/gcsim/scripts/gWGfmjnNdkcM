options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active raiden;
raiden skill;
for let i=0; i<3; i=i+1 {
  if i==0 { 
    chevreuse burst, skill[hold=1];
  } else {
    chevreuse skill[hold=1], burst;
  }

  fischl attack:3, dash, skill;

  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, burst;

#  if chevreuse is below C4, use this N2 for waiting E cd at first rot
#  if i==0 { 
#    chevreuse attack:2;
#  }
 
  chevreuse skill[hold=1], burst;

  fischl attack:3, burst;

  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4, 
         dash, attack:4; #waiting for chevreuse cd

}