neuv char lvl=90/90 cons=0 talent=9,9,9;
neuv add weapon="sacrificialjade" refine=1 lvl=90/90;
neuv add set="mh" count=4;
neuv add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
neuv add stats def%=0.124 def=39.36 hp=507.88 hp%=10*0.0496 atk=33.08 atk%=2*0.0496 er=2*0.0551 em=19.82*2 cr=6*0.0331 cd=10*0.0662; 

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="kitain" refine=5 lvl=90/90;
ineffa add set="fopl" count=4;
ineffa add stats hp=4780 atk=311 em=187 em=187 em=187; #main
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=2*0.0496 atk=33.08 atk%=12*0.0496 er=2*0.0551 em=6*19.82 cr=5*0.0331 cd=5*0.0662;

