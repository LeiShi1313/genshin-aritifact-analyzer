# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active shenhe;

for let i=0; i<4; i=i+1 {
  shenhe skill, burst;
  
  xilonen skill, attack:2;
  
  kazuha skill, high_plunge, burst;

  ayaka skill, dash, burst, attack, charge;
  
  shenhe skill, attack;
  
  xilonen skill, attack:2, burst;
  
  kazuha skill, high_plunge;

  ayaka skill, dash, attack:2, charge, attack:2, charge;
}
