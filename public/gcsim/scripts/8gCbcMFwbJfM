#ayaka add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
#ayaka add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.2204 em=39.64 cr=0.2648 cd=0.662; # HoD

