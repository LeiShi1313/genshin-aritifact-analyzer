options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active navia;

for let i=0; i<4; i=i+1 {
  if i {
    bennett skill;
  }
  furina skill, dash, burst; 
  if !i {
    navia skill;
  }
  navia burst;
  bennett burst, skill, dash;
  ning skill, dash, attack;
  navia attack, skill, attack:3, dash, attack;
  ning attack; 
  wait(4);#wait for bennett buff DDDDDDDDDDDDDDDDDDDDDD:
  ning burst, walk, skill, dash, charge;
  navia attack, skill, attack:2;
  if .navia.skill.ready {
    navia skill[hold=1];
  } else {
    navia attack;
  }
}
