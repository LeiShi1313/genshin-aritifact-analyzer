options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

# Pickup Crystallize Function
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.chiori && action_id == .action.skill ) || ( char_id == .keys.char.xilonen && action_id == .action.skill ) || ( char_id == .keys.char.clorinde && action_id == .action.skill && .clorinde.status.clorinde-night-watch) {
    pick_up_crystallize("any");
  }

  return _execute_action(char_id, action_id, p);
}

active xilonen;

for let i = 0; i < 4; i = i + 1 { # 4 rotations

  xilonen burst;
  if i {
    xilonen attack;
  }

  if .furina.skill.ready { # Furina skills every other rotation
    furina skill;
  }

  furina dash, attack, burst; # N1 to trigger fav more consistently
  xilonen skill, attack:2;
  #pick_up_crystallize("any");
  chiori skill:2;
  clorinde_combo();
  if .clorinde.burst.ready { # Clorinde and Chiori alternate bursts
    clorinde burst;
  } else {
    chiori burst;
  }
}

