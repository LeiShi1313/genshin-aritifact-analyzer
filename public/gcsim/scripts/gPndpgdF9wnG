# Characters

klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="mh" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.2648 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="ap" count=4;
#bennett add set="no" count=4; # ~2k dps loss
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# Targets

target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;

# Actions

active furina;
for let i = 0; i < 5; i = i + 1 {
  furina skill, burst;
  xilonen burst;
  bennett burst, skill;
  xilonen skill, attack:2;
  bennett skill, dash; pick_up_crystallize("pyro"); #remove dash and crystal pickup if not using petra bennett

  klee attack, burst, walk,
       attack[travel=6], charge,
       attack[travel=6], charge, 
       attack[travel=6], skill[bounce=3, mine=8], jump,
       attack[travel=6], charge;
  if .klee.skill.ready {
    klee attack, skill[bounce=3, mine=8], jump;
  }
  klee attack[travel=6], charge, 
       attack[travel=6], charge, 
       attack[travel=6], charge,
       attack[travel=6], charge,
       attack;
  
  xilonen skill, attack:2;
}

# Kleerina with Bennett and Xilonen. Xilonen bursts and uses 2 skills every rotation. 22-23s rotation.
# Furina E Q, Xilonen Q, Bennett Q E, Xilonen E N2, Bennett E [D], Klee N1QW 2(N1C) N1EJ N1C {N1EJ} 4(N1C) N1, Xilonen E N2 
# [if using petra], {first rot}

