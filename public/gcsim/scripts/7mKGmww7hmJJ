# Charlotte Furina Shenhe Escoffier. 21s Rot. On field Charlotte. Charlotte uses Hold E. Charlotte uses burst whenever it is available. 2E Shenhe. Escoffier only bursts every other rotation after the first. A more optimized static rotation is probably possible.

# Team
charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="widsith" refine=3 lvl=90/90;
charlotte add set="bs" count=4;
#charlotte add set="mh" count=4;
charlotte add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
#furina add set="gt" count=4;
furina add set="tom" count=4;
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.5958; # ToM
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.5958; # GT

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favlance" refine=3 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.3306 em=39.64 cr=0.331 cd=0.2648;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freezable

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  esco skill;
  if .esco.burst.ready && .esco.energy == .esco.energymax && i > 0 {
    esco burst;
  }

  shenhe skill, burst;

  charlotte skill[hold=1];

  while .shenhe.skill.cd {
    if .charlotte.burst.ready {
      charlotte burst;
    } else if .charlotte.normal > 3 && .stam > 18 {
      charlotte dash;
    } else {
      charlotte attack;
    }
  }

  shenhe skill, attack;

  while .furina.skill.cd {
    if .charlotte.burst.ready {
      charlotte burst;
    } else if .charlotte.normal > 3 && .stam > 18 {
      charlotte dash;
    } else {
      charlotte attack;
    }
  }
}
