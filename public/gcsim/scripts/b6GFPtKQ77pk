fn randy(mean, standardDeviation, min, max, display) {
  let value = randnorm() * standardDeviation + mean;
  if value > max {
    value = max;
  } else if value < min {
    value = min;
  }
  if display {
    print(value);
  }
  return value;
}


let prev_char_id = -1;
let prev_action_id = -1;


let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  #print(prev_char_id, " ", prev_action_id, " ", char_id, " ", action_id);


  # this next if block handles implict swap or otherwise any pre swap delay specified in this function
  # will not work
  if prev_char_id != char_id && action_id != .action.swap {
    execute_action(char_id, .action.swap, []);
  }


  # this following if block handles conditionally adding in delay depending on
  # what the previous and next action is. in this example, delay is not added between attacks
  # and charge attack following an attack
  # modify these conditions as you see fit
  if action_id == .action.swap {
    # add delay before swap
    delay(randy(9.5, 1.5, 5, 17, 0));
  } else if prev_action_id == .action.attack && action_id != .action.attack && action_id != .action.charge {
    # add delay after attack, but only if not followed by another attack or charge
    delay(randy(3, 1, 0, 6, 0));
  } else if prev_action_id != .action.attack {
    # add delay to everything else
    delay(randy(3, 1, 0, 6, 0));
  }


  # this here tracks the previous character id so that it can be used above
  prev_char_id = char_id;
  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}

options swap_delay=1 iteration=1000 ignore_burst_energy=false;

target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999 particle_threshold=520000 particle_drop_count=3; #Energy drops based on 12-3 Icewind Suite

active fischl;

#Fischl N1 E > Kokomi E Dash N1 > Furina E Dash Q > Sayu Q hE (2.5s) > Fischl N2 Q > Kokomi Q [N2Ds] > Sayu hE (0.5s)
for let i=0; i<3; i=i+1 {
  fischl attack, skill;
  kokomi skill, dash, attack;
  furina skill, dash;
  while !.furina.burst.ready {
    furina attack;
  }
  furina burst;
  sayu swap;
  while !.sayu.burst.ready {
    sayu attack;
  }
  sayu burst, skill[hold=150];
  fischl attack:2;
  while !.fischl.burst.ready {
    fischl attack;
  }
  fischl burst;

  kokomi burst;
  while .status.kokomiburst {
    switch {
      case .kokomi.normal < 3:
        kokomi attack;
      #case .stam >= 50: #N2C if stamina allows
        #kokomi charge;
      case .stam >= 18: #N2D if stamina allows
        kokomi dash;
      default:          #N2W
        kokomi walk;
    }
  }

  sayu skill[hold=30];
}
