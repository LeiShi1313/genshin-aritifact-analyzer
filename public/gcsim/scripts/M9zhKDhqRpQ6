# Sayu Nahida Furina Dori. ~23s Rot. Max roll duration for Sayu. Full EM Sayu & Dori. Dori can help Sayu absorb Electro with her windwheel.

# Team
sayu char lvl=90/90 cons=6 talent=9,9,9;
sayu add weapon="favgs" refine=3 lvl=90/90;
sayu add set="vv" count=4;
sayu add stats hp=4780 atk=311 em=187 em=187 em=187;
sayu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
#nahida add weapon="fruit" refine=5 lvl=90/90;
#nahida add weapon="magicguide" refine=5 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=118.92 cr=0.2979 cd=0.5958;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="favgs" refine=3 lvl=90/90;
dori add set="fopl" count=4;
dori add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.0 pos=0,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1.5 pos=1.6,1.8 hp=100000000;

# Rotation
active dori;
dori burst;

for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  
  furina skill, dash, burst;
  
  sayu burst;
  
  dori skill; wait(5); # for no errors
  
  sayu skill[hold=600];
  
  dori skill, attack:2, burst;

  print("done");
}

