#~22s rotation with 2 Skills from Ayaka, Xilonen, and Rosaria. Xilonen's Burst heals everyone except Furina. Xilonen's Scroll procs may be inconsistent in practice; Shatter doesn't trigger Scroll, and underlying Cryo auras to Crystallize can be unreliable with Furina. KurtC w/o limited weapons

ayaka char lvl=90/90 cons=0 talent=9,9,9;
ayaka add weapon="finale" refine=5 lvl=90/90;
ayaka add set="bs" count=4;
ayaka add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
ayaka add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1653 em=39.64 cr=0.2648 cd=0.662; #kqms, distributed subs: 5 atk%, 1 er, 6 cr, 8 cd

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.434 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5958; #5 def%, 8 cr, 7 cd

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; #2 atk%, 8 cr, 10 cd

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="fleuve" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; #2 hp%, 10 cr, 8 cd

active furina;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

for let r=0; r<4; r=r+1 {
  furina skill, dash, burst;
  xilonen burst;
  rosaria skill, burst;
  xilonen skill, attack:2;
  ayaka skill, dash, burst, attack:2, charge, dash, attack:2, charge;
  rosaria attack, skill;
  xilonen skill, attack:2;
  ayaka dash, attack:2, charge, skill, dash, attack:2, charge;
}
