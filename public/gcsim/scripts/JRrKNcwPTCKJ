jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="favsword" refine=3 lvl=90/90;
jean add set="vv" count=4;
jean add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.331 cd=0.5958;

options swap_delay=12 iteration=1000; 

active raiden;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

raiden skill;
for let i=0; i<4; i=i+1 { 
	furina skill, dash, burst;
	
	fischl attack:2, burst;
	
	jean skill, burst;
	
	raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
	
	jean skill;
	
	if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    jean attack:1;
  }
}

