  if i==0 {
    chevreuse burst, attack;
  } else {
    chevreuse burst, attack:3, dash;
  }
  bennett skill, burst;
  sara skill, aim;
  chevreuse attack, dash, skill[hold=1]; # this hE leads to Chev C2's pyro app during sara's field time.
