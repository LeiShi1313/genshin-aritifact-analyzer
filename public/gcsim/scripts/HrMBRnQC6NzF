chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="chainbreaker" refine=5 lvl=90/90;
chasca add set="oc" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*7 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*11 cd=0.0662*5;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="fjords" refine=1 lvl=90/90;
chevreuse add set="scroll" count=4;
chevreuse add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
chevreuse add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*5 em=19.82*2 cr=0.0331*12 cd=0.0662*8;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 freeze_resist=0 radius=2 pos=0,2.4 hp=999999999;

active furina;

for let i=0; i<2; i=i+1 {
  furina skill, dash, burst;
  escoffier skill, attack;
  chevreuse skill[hold=1], burst;
  chasca skill, aim:4, aim[bullets=4], burst;
  
  escoffier attack, skill, attack;
  chevreuse attack, skill[hold=1], attack;
  chasca attack, skill, aim:4, aim[bullets=4];
}
wait(84);

# 32.5s rotations
# Furina ED Q > Escoffier E N1 > Chevreuse hEQ > Chasca E 4[C] C_4b Q > Escoffier N1 E N1 > Chevreuse N1 hE N1 > Chasca N1 E 4[C] C_4b