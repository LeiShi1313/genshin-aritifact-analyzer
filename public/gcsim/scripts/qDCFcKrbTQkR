mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="mailedflower" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mavuika;

for let i = 0; i < 4; i = i + 1 {
  mavuika skill;

  escoffier dash, skill;

  citlali skill, burst;

  mavuika burst;
  #wait(31);
  mavuika charge, dash;

  chasca skill;
  if .chasca.burst.ready {
    chasca burst, aim:4;
  } else {
    chasca aim:4, aim[bullets=4];
  }
}
wait(82);
