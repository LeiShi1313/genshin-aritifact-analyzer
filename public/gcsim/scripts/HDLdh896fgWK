#bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=79.28 cr=0.3972 cd=0.4634;
# 0.84x scalar to account for one 5* artifact

# - Options

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# - Target

target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999;

# - Actions

active furina;

furina skill, dash, burst;
for let i=0; i<3; i=i+1 {
  if i {
    furina skill, dash, attack, burst;
  }
  if !i {
    bennett skill, burst;
  } else {
    bennett burst, skill;
  }
  yelan burst;
  if !i {
    yelan attack;
  } else {
    furina attack:2;
  }
  yelan skill, attack;
  klee attack, burst, walk,
       attack[travel=6], charge, #[travel=6] is added to make klee's n1 hit before each CA starts
       attack[travel=6], charge, #this results in 10% less of her CAs vaping but is more accurate to gameplay
       attack, skill[bounce=3, mine=8], jump,
       attack[travel=6], charge;
  if .klee.skill.ready {
    klee attack, skill[bounce=3, mine=8], jump;
  } else {
    klee attack[travel=6], charge;
  }
  klee attack[travel=6], charge,
       attack[travel=6], charge,
       attack, walk;
  yelan skill, attack:2;
  bennett skill;
  if !i {
    bennett attack;
  } # yelan's burst will still be active first rotation only
}

# Klee Double Hydro Vape with Klee, Furina, Yelan, Bennett. Yelan 2E Rotation. Klee Vapes ~60% of her CAs. The whole team recieves at least 1 tick of bennett healing per rotation after the first rotation.
# 1st Rot: Furina E D Q, Bennett E Q, Yelan Q N1 E N1, Klee N1QW 2N1C N1EJ N1C N1EJ 2N1C N1W, Yelan E N2, Bennett E N1
# Subsequent Rots: Furina E D N1 Q, Bennett Q E, Yelan Q, Furina N2, Yelan E N1, Klee N1QW 2N1C N1EJ 4N1C N1W, Yelan E N2, Bennett E
