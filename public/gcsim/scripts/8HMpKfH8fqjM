chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chevreuse add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
      set_player_pos(0, 0);
    } else {
      clorinde attack;
    }
  }
}

active ororon;

ororon burst, skill;
chevreuse burst, skill[hold=1]:3;
luminepyro skill, burst;
clorinde_combo();
clorinde burst;

for let i=0; i<4; i=i+1 {
  clorinde attack:2, charge;
  ororon skill, burst;
  chevreuse burst, skill[hold=1]:3;
  luminepyro skill, burst;
  clorinde_combo();
  clorinde burst;
}

# ~19s rotations (~16s opener)
# Opener: Ororon Q E > Chevreuse Q 3[hE] > Pyro Traveler tE Q > Clorinde E combo Q
# Ongoing: Clorinde N2C > Ororon E Q > Chevreuse Q 3[hE] > Pyro Traveler tE Q > Clorinde E combo Q
