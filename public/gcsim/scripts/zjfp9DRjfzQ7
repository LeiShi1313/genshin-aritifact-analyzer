#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; 

# Rotation
active raiden; 
raiden skill;

for let i = 0; i < 4; i = i + 1 {
  yae skill:3;
  
  chev burst, skill[hold=1]:2;
  
  xl burst, skill, dash;
  
  yae attack:1, charge, dash;
  yae attack:1, charge, dash;
  yae burst, skill:3;
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:3;
}
