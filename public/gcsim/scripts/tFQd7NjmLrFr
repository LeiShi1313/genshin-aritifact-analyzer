sigewinne add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
sigewinne add stats def%=0.124 def=39.36 hp=2031.52 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2648 cd=0.3972;

options swap_delay=12 iteration=100;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 


active furina;

for let i=0; i<4; i=i+1 {
  if is_even(i) {
    furina skill, dash, burst;
  }
  ororon attack, skill, burst;
  sigewinne skill, dash;
  chasca skill;
  chasca aim:4;
  chasca aim[bullets=4];
  if is_even(i) {
    chasca burst;
  } 
}
