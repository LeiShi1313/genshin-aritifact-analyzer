# Bennett Furina Citlali Escoffier. ~22s Rot. Benentt MeltVape. MH > CW Bennett. -5K DPS with Freeze immunity. Citlali does not use burst within Bennett burst, but can Scroll incidentally. Escoffier only bursts as available from the 2nd rotation onward; building enough energy to burst every rotation is a DPS loss.

# Team - Options listed by DPS
bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="finale" refine=5 lvl=90/90;
#bennett add weapon="alleyflash" refine=1 lvl=90/90;
#bennett add weapon="umbrella" refine=5 lvl=90/90;
bennett add set="mh" count=4;
#bennett add set="cw" count=4;
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # MH
#bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
#bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # CW

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main  # HP goblet is fine too
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.331;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 cr=0.311; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662; # Q as available
#escoffier add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cd=0.622; #main
#escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.2204 em=39.64 cr=0.1655 cd=0.5958; # Q every rot

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  esco skill;
  if i > 0 && .esco.burst.ready && .esco.energy == .esco.energymax {
    esco burst;
  }
  
  citlali skill, burst;
  
  bennett burst, attack, skill;
  while .status.bennettburst {
  #while .furina.skill.cd {
    if .bennett.skill.ready {
      bennett skill;
    } else if .bennett.normal > 1 {
      bennett charge;
    } else {
      bennett attack;
    }
  }
	
}
