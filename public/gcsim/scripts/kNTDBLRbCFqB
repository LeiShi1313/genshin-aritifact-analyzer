mika char lvl=90/90 cons=6 talent=9,9,9;
#mika add weapon="favlance" refine=3 lvl=90/90;
mika add weapon="dialogues" refine=5 lvl=90/90;
mika add set="clam" count=4;
#mika add set="sodp" count=4;
#mika add set="no" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active razor; # SS Stacks
#razor skill, dash; # Not nessesary

for let i=0; i<4; i=i+1 {
  if .amy.skill.ready && .amy.burst.ready {
    amy attack, skill;
  }

  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }

  mika burst, skill;

  if .amy.burst.ready {
    amy attack:2, burst;
  } else {
    amy attack:1, skill;
  }

  # Standard Rotation
  razor skill, dash, attack, burst;
  # Razor main DPS window
  while .razor.mods.razor-q > 210 { # Ends on 3rd Skill, Refresh DEF Shred
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }

  print("done");
}
