# Razor Chevreuse Durin Bennett. ~23s Rot(~20s w/ TF). KQMS KurtC. Razor Overload. There is enough Pyro to use TF and reach Razor's ER requirements in a 20s Rotation, but it performs worse. Razor significantly prefers an Electro goblet.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="risingwinds" count=4;
#razor add set="tf" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="no" count=4; # Not Electro Aura Reliant
#chev add set="scroll" count=4;
chev add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
chev add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*10 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*4;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*8;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="catch" refine=5 lvl=90/90;
xiangling add set="emblem" count=4;
#xiangling add set="tom" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12;
#xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
#xiangling add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*7 cd=0.0662*12; # ToM

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

# Rotation
active razor; # SS stacks
razor skill, dash; # Sigils, Chev A4, C4

for let i=0; i<4; i=i+1 {
  chev burst, skill[hold=1]:1;

  durin skill, burst, skill;

  xl burst, skill[a4_delay=60], dash;

  if .razor.sets.tf != 4 {
    razor skill[hold=0], dash, attack, burst;
    razor attack:0, skill, dash;
    razor attack:3, dash;
    razor attack:3, dash;
    razor attack:3, skill, dash;
    razor attack:3, dash;
    razor attack:3, dash;
    razor attack:3, skill, dash;
  } else {
    razor skill[hold=0], dash, attack, burst;
    razor attack:0, skill, dash;
    razor attack:3, dash;
    razor attack:3, skill, dash;
    razor attack:3, dash;
    razor attack:3, skill, dash;
    razor attack:3;
  }
}
