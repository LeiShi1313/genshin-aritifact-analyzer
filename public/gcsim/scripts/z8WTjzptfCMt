# Razor Furina Ineffa Bennett. ~22s Rot. Lunarcharge Overvape Razor w/ Ineffa using C6 Bennett. EM/EM > EM/ATK > ATK/ATK. Self-Aura Overloads not implemented.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="risingwinds" count=4;
razor add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10; # EM/EM
#razor add stats hp=4780 atk=311 em=187 atk%=0.466 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*5 cr=0.0331*11 cd=0.0662*10; # EM/ATK
#razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*5 cr=0.0331*11 cd=0.0662*10; # ATK/ATK

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
#furina add weapon="festering" refine=3 lvl=90/90;
furina add set="sms" count=4;
#furina add set="tom" count=;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*3 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # SMS
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*10 cd=0.0662*10; # ToM

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="fjords" refine=1 lvl=90/90;
#ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="gd" count=4;
#ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
#bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*12 cr=0.0331*2 cd=0.0662*4;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active razor; # SS stacks
razor skill, dash;

for let i=0; i<4; i=i+1 {
  if i > 0  && .ineffa.burst.ready {
    ineffa skill, burst;
  } else {
    ineffa skill, attack:1;
  }

  furina skill, dash, attack, burst;

  bennett skill, dash, burst;

  if i == 0 {
    razor skill;
  } else {
    razor skill[hold=1];
  }
  razor dash, attack, burst, attack, skill, dash;
  # Razor Main DPS window
  while .razor.infusion.bennett-fire-weapon {
  #while .furina.skill.cd {
    if .razor.normal > 3  && .razor.skill.ready {
       razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}
