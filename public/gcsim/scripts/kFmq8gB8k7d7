# Team
aetheranemo char lvl=90/90 cons=6 talent=9,9,9+params=[base_atk_buff=1];
aetheranemo add weapon="wolffang" refine=1 lvl=90/90;
aetheranemo add set="ur" count=4;
aetheranemo add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
aetheranemo add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.331;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622 ; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="twilight" refine=5 lvl=90/90;
faruzan add set="ur" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active emilie;

for let i = 0; i < 4; i = i + 1 {
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  
  bennett skill, burst;
  faruzan skill, burst;
  aetheranemo skill[hold=1], burst;
  faruzan skill, aim:2;
  aetheranemo attack:2, charge, attack:1, skill[hold=1];
  bennett skill; 
  faruzan skill, aim:2;
}

