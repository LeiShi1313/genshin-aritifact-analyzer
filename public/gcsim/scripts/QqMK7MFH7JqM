active yae;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
for let i = 0; i < 5; i = i + 1 {
  yae skill:3;
  if !.chevreuse.burst.ready{
    chev attack;
  }
  chevreuse burst, skill[hold=1]:2;
  if i==0 || i==2 || i==4 { #give xiangling sara's atk buff when she bursts
    sara skill;
  }
  if i==0 || i==2 || i==4 { #xiangling burst every other rotation
    xiangling burst, skill, dash;
  } else {
    xiangling attack:2, skill, attack:2;
  }
  if i==1 || i==3 || i==5 { #sara burst every other rotation and use skill to buff yae on rotations when xiangling doesn't burst
    sara skill;
  } else {
    sara burst; 
  }
  yae attack, charge, dash,
      attack, charge, jump,
      attack, charge, dash;
  sara aim;
  if i==0 || i==2 || i==4 { #yae burst every other rotation
    yae burst;
  } else {
    yae attack, charge, jump, attack;
  }
}
yae skill:3;#let q do dmg on final rotation