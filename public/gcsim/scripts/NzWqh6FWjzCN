# Lisa Chevreuse Fischl Mavuika. ~20s Rot. Lisa on-field N2C spam with Overload. EM and talent damage Mavuika are similar.

# Team - Options listed by DPS
lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="widsith" refine=3 lvl=90/90;
#lisa add weapon="flowingpurity" refine=5 lvl=90/90;
lisa add set="ts" count=4;
#lisa add set="fohw" count=4;
lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.2648;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="aquamarine" refine=1 lvl=90/90;
#mav add weapon="tidalshadow" refine=5 lvl=90/90;
#mav add weapon="earthshaker" refine=5 lvl=90/90;
mav add set="scroll" count=4;
#mav add set="oc" count=4;
mav add stats hp=4780 atk=311 em=187 em=187 em=187; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1102 em=118.92 cr=0.3972 cd=0.4634; # 3EM
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # Scroll
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # OC

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active lisa;
lisa attack;

for let i = 0; i < 4; i = i + 1 {
  chevreuse burst, skill[hold=1]:2;

  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }

  if .mav.burst.ready {
    mav skill, burst, dash;
  } else {
    mav attack, skill;
  }

  lisa attack, burst, skill[hold=1];
  lisa attack:1, charge;
  lisa attack:2, charge;
  lisa attack:2, charge;
  lisa attack:2, charge;
  lisa attack:2, charge;
}
