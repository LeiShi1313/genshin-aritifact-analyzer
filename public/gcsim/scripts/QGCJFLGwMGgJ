bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=118.92 cr=0.0993 cd=0.662;

arlecchino char lvl=90/90 cons=0 talent=9,9,9;
arlecchino add weapon="deathmatch" refine=1 lvl=90/90;
arlecchino add set="fragmentofharmonicwhimsy" count=4;
arlecchino add stats hp=4780 atk=311 atk%=.466 pyro%=0.466 cd=0.622;
arlecchino add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

rosa char lvl=90/90 cons=6 talent=9,9,9;
rosa add weapon="favlance" refine=3 lvl=90/90;
rosa add set="emblem" count=4;
rosa add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311;
rosa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="favsword" refine=3 lvl=90/90;
lynette add set="vv" count=4;
lynette add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311;
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active arlecchino;

for let i=0; i<4; i=i+1 {
  arlecchino skill;
  rosa skill, attack;
  bennett skill, attack;
  while !.rosa.mods.favonius-cd {
    rosa attack;
  }
  rosa burst;
  lynette skill, attack, burst;
  bennett burst;
  arlecchino charge[early_cancel=1], dash;
  for let j=0; j<5; j=j+1 {
    arlecchino attack:3, dash;
  }
  arlecchino attack:3;
}
