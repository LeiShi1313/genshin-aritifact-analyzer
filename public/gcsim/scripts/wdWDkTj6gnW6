options swap_delay=12 iteration=1000;

neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacjade" refine=1 lvl=90/90;
neuvillette add set="marechausseehunter" count=5;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.1986 cd=0.662;

lisa char lvl=90/90 cons=0 talent=9,9,9;
lisa add weapon="hakushinring" refine=5 lvl=90/90;
lisa add set="scroll" count=4;
lisa add stats hp=4780 atk=311 atk%=0.466 cr=0.311 electro%=0.466;
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=99.1 cr=0.1986 cd=0.5958;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="favsword" refine=5 lvl=90/90;
lynette add set="vv" count=4;
lynette add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311 ; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=138.74 cr=0.331 cd=0.5296;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=5];
fischl add set="goldentroupe" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;


target lvl=100 resist=0.1 hp=10000000 radius=1 pos=0,2;
energy every interval=480,720 amount=1;

active neuvillette;

for let x=0; x<4; x=x+1 {

  neuvillette skill, attack:2;
  lynette burst;
  lisa burst, dash;
  fischl skill;
  lynette skill, attack; # N1 lets her refresh hydro VV at C6, skip pre-C6
  neuvillette charge, burst, skill, charge;
  lynette skill;
  fischl burst;
  neuvillette charge:2;
}
wait(173);

