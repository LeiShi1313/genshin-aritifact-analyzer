# --- Pre-action hook setup

let prev_char_id = -1;
let prev_action_id = -1;
let _execute_action = execute_action;

fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( prev_char_id == .keys.char.rosaria && prev_action_id == .action.skill ) {

    let rngVal = rand();      # 60/30/10 odds of picking up 1/2/3 shards laying on ground
    let shards = 0;
    if rngVal < 0.6 {
      shards = 1;
    } else if rngVal < 0.9 {
      shards = 2;
    } else {
      shards = 3;
    }
    for let i = 0; i < shards; i = i+1 {
      pick_up_crystallize("any"); # Pick up crystallize before every dash and rosaria E
    }
  }
  # this here tracks the previous character id so that it can be used above
  prev_char_id = char_id;
  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}

