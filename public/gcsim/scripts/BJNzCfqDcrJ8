# Xianyun Furina Ororon Fischl. ~20s Rot. Plunge DPS Xianyun. Faruzan and Ororon force Fav Procs. Ororon goes before Furina.

# Team - Options listed by DPS
xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="flowingpurity" refine=5 lvl=90/90;
#xianyun add weapon="widisth" refine=3 lvl=90/90;
#xianyun add weapon="hakushin" refine=5 lvl=90/90;
xianyun add set="mh" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # FP
#xianyun add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
#xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.2204 em=39.64 cr=0.3972 cd=0.3972; # Widsith
#xianyun add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
#xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Hakushin

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90;
faruzan add set="vv" count=4;
#faruzan add set="tom" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311 ; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.331 cd=0.5958;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=3 lvl=90/90;
#ororon add weapon="chainbreaker" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

fn xianyunCombo() {
  if .xianyun.status.xianyun-airborne-buff {
    # Xianyun plunge combo
    xianyun jump;
    if .airborne {
      xianyun low_plunge[collision=rand()>0.5], attack;
    }
  } else {
    # Driving NA combo
    if .xianyun.normal > 2 && .xianyun.dash.ready {
      xianyun dash;
    } else {
      xianyun attack;
    }
  }
}

# Rotation
active ororon;

for let i=0; i<4; i=i+1 {
  ororon skill, burst;
  while !.ororon.mods.favonius-cd {
    ororon attack;
  }

  furina skill, dash, burst;

  faruzan skill, burst;
  while !.faruzan.mods.favonius-cd {
    faruzan attack;
  }

  xianyun skill, low_plunge, burst;

  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.status.xianyun-airborne-buff {
      # Xianyun plunge combo
      xianyun jump;
      if .airborne {
        xianyun low_plunge[collision=rand()>0.5];
      } # N1 cancel all but the last
      if .xianyun.status.xianyun-airborne-buff {
        xianyun attack;
      }
    }
  }

  print("done");
}
