bennett char lvl=90/90 cons=6 talent=10,10,10; 
bennett add weapon="aquila" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282;


options swap_delay=12 iteration=2000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

let UseXilonenDash = false;  # change this value between true and false to make Xilonen use dash or not

active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  bennett skill, burst;
  xilo skill, attack:2;
  if UseXilonenDash == true {
    xilonen dash;   # dash to pick up the shard
  }
  pick_up_crystallize("any");
  if is_even(i) {
    citlali skill, attack;
    mavuika burst;
    mavuika charge:3, charge[hold=6], charge[final=1], dash;
    mavuika charge:3, charge[hold=6], charge[final=1], dash; # the last Final CA is buffed by Mavuika Q.
    mavuika charge:4;
    if UseXilonenDash == false {
      mavuika charge;
    } else {
      mavuika dash;
    }
  } else {
    citlali skill, burst, attack:2;
    mavuika burst;
    mavuika charge:3, charge[hold=6], charge[final=1], dash;
    mavuika charge:3, charge[hold=6], charge[final=1], dash; # the last Final CA is buffed by Mavuika Q.
    mavuika charge:5;
    if UseXilonenDash == false {
      mavuika charge;
    } else {
      mavuika dash;
    }
    delay(11);
  }
}

