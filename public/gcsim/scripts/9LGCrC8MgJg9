# Freminet Furina Ineffa Xianyun. ~20s Rot. Freminet Phys plunge with Superconduct. Executes 1 Shattering Pressure combo while plunging. 50% Collisions. LNO > PF > MH on Freminet;

# Team - Options ordered by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5]; # PF
#freminet add weapon="snowtombed" refine=5 lvl=90/90;
freminet add set="lno" count=4; # LNO > PF > SR
#freminet add set="mh" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
freminet add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # LNO
#freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#freminet add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10; # MH

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="fjords" refine=1 lvl=90/90;
ineffa add set="gd" count=4; # GD > SMS ~= Morningstar
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*2 em=19.82*3 cr=0.0331*12 cd=0.0662*10;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4;# Bubbles may miss
#xianyun add set="vv" count=4;
#xianyun add set="no" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*9 atk%=0.0496*8 er=0.0551*9 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Freminet Plunge Combo
fn FreminetPlunge() {
  freminet jump;
  if .airborne {
    freminet high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if !.furina.burst.ready {
    furina attack;
  }
  furina burst;

  if i > 0  && .ineffa.burst.ready {
    ineffa skill, burst;
  } else {
    ineffa attack, skill;
  }

  xianyun skill, low_plunge, burst;

  freminet skill, attack;
  FreminetPlunge(); freminet attack;
  FreminetPlunge(); freminet attack;
  FreminetPlunge(); freminet attack;
  FreminetPlunge(); freminet skill;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet attack;

  print("done");
}
