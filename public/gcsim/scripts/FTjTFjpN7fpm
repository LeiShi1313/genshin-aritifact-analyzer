# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active escoffier;
for let i=0; i<4; i=i+1 {
  escoffier skill, attack;
  furina skill, dash, burst, attack:2;
  citlali skill, attack;
  yelan burst, attack, skill, attack, skill;

  yelan attack:4, dash;
  yelan attack:4, dash;
  yelan attack:4, dash;

  yelan attack:4, dash;
  yelan attack:4, dash;
  yelan attack:2;
}

