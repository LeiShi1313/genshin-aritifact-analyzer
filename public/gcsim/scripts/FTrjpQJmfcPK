# Ganyu Furina Venti Charlotte. ~21s Rot. On-field Freeze DPS Ganyu in two target does 2 Es per rotation. Assumes freezable enemies and high ability to headshot. Venti always absorbs Cryo.

# Team
ganyu char lvl=90/90 cons=0 talent=9,9,9; 
ganyu add weapon="crescent" refine=5 lvl=90/90;
#ganyu add weapon="songofstillness" refine=5 lvl=90/90;
ganyu add set="bs" count=4;
#ganyu add set="mh" count=4;
ganyu add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.4634;
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.4634; # GT

venti char lvl=90/90 cons=0 talent=9,9,9; 
venti add weapon="favbow" refine=4 lvl=90/90;
venti add set="vv" count=4;
venti add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
venti add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.331 cd=0.2648;

charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="ttds" refine=5 lvl=90/90;
#charlotte add weapon="favcodex" refine=3 lvl=90/90;
charlotte add set="ohc" count=4;
#charlotte add set="no" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1653 em=39.64 cr=0.2979 cd=0.5296;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.0 pos=1.4,2.4 hp=100000000;
target lvl=100 resist=0.1 radius=1.0 pos=-1.4,2.4 hp=100000000;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
	furina skill, dash, burst;
	
	charlotte skill, burst;
	
	ganyu aim[hold=2, weakspot=rand()>0.2], burst, skill;
	
	venti skill, burst;
	
	ganyu aim[hold=2, weakspot=rand()>0.2],
	      aim[hold=2, weakspot=rand()>0.2],
	      aim[hold=2, weakspot=rand()>0.2],
	      aim[hold=2, weakspot=rand()>0.2],
	      skill;
	
	venti skill, attack; # N1 Nessesary for fast swap
}

