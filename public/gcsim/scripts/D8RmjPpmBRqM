# Shenhe Chongyun Rosaria Escoffier. ~18s Rot. Cryo infused on-field Shenhe w/ Chongyun infusion doing mostly N1CD & N4D with skill & burst as available.

# Team - Options listsed by DPS
shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="lamppost" refine=5 lvl=90/90;
shenhe add set="bs" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.3972 cd=0.4634;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="lithicspear" refine=1 lvl=90/90;
#rosaria add weapon="deathmatch" refine=1 lvl=90/90;
rosaria add set="bs" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.3306 em=39.64 cr=0.1324 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freeze Immunity

# Rotation
active shenhe;
#shenhe skill;

for let i=0; i<4; i=i+1 {
  esco skill, burst;

  rosaria skill, burst;

  chongyun burst, skill;

  #shenhe skill;
  while .rosaria.skill.cd {
    switch {
      case .shenhe.skill.ready:
        shenhe skill;
      case .shenhe.burst.ready:
        shenhe burst;
      case .shenhe.normal > 1 && .stam > 43:
        shenhe charge, dash;
      case .shenhe.normal > 4 && .stam > 18:
        shenhe dash;
      default:
        shenhe attack;
    }
  }

  rosaria skill;

  while .status.chongyunfield {
    switch {
      case .shenhe.skill.ready:
        shenhe skill;
      case .shenhe.burst.ready:
        shenhe burst;
      case .shenhe.normal > 1 && .stam > 43:
        shenhe charge, dash;
      case .shenhe.normal > 4 && .stam > 18:
        shenhe dash;
      default:
        shenhe attack;
    }
  }
}
