yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="gd" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main 5* set
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favoniussword" refine=3 lvl=90/90;
xingqiu add set="no" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311 ; #main
xingqiu add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2648 cd=0.662;

beidou char lvl=90/90 cons=6 talent=9,9,9;
beidou add weapon="uomms" refine=5 lvl=90/90;
beidou add set="emblemofseveredfate" count=4;
beidou add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ;
beidou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active xingqiu;
for let x=0; x<4; x=x+1 {

  let counter_chance = rand();

  xingqiu attack, skill, dash, burst, attack;

  if counter_chance <= 0.1 {
    beidou skill[counter=2];
  } else if counter_chance <= 0.3 {
    beidou skill[counter=1];
  } else {
    beidou skill;
  }

  beidou dash, burst, attack;

  if .fischl.skill.ready {
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }

  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;

  if counter_chance <= 0.1 {
    beidou skill[counter=2];
  } else if counter_chance <= 0.3 {
    beidou skill[counter=1];
  } else {
    beidou skill;
  }

  beidou dash, attack:3; #catch her own particles

  if .yoimiya.burst.ready && .yoimiya.energy == .yoimiya.energymax {
    yoimiya burst;
  } else {
    fischl attack:3;
    xingqiu attack;
  }
}

#XQ N1 E dash Q N1 > Beidou E dash Q N1 > Fischl E N1 > Yoimiya E 3[N5D] N1 > Beidou E dash N3 > Yoimiya Q >
#XQ N1 E dash Q N1 > Beidou E dash Q N1 > Fischl N2 Q > Yoimiya E 3[N5D] N1 > Beidou E dash N3 > Fischl N3 > XQ N1 >
