options swap_delay=12 iteration=1000;

#--------------------------------------------

#action list:

active furina;
for let i = 0; i < 5; i = i + 1 {
 if !i {
    furina skill, dash, burst; # first rot
  } else {
    furina burst, skill, dash;
  }
  yelan burst, attack;
  bennett burst, attack, skill;
  yelan attack, skill;
  if i>0 {
    furina attack:2, dash; # 2nd rot onward. get bennett healing
  }
  yoimiya skill, attack:5, dash,
                 attack:5, dash,
                 attack:5, dash,
                 attack:2;
  if !i {
    furina attack:2; # first rot, cuz you didn't push furina on-field
  }
}
