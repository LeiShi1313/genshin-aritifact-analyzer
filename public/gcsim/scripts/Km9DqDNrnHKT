wanderer char lvl=90/90 cons=0 talent=9,9,9;
wanderer add weapon="widsith" refine=3 lvl=90/90;
wanderer add set="mh" count=4;
wanderer add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622 ; #main
wanderer add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662 ;

jean char lvl=90/90 cons=4 talent=9,9,9;
jean add weapon="favoniussword" refine=3 lvl=90/90;
jean add set="sodp" count=5;
jean add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311 ; #main
jean add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90 ;
faruzan add set="noblesse" count=5;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311 ; #main
faruzan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.1986 cd=0.7282 ;

target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999;
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=1000;
active furina;
for let i = 0; i < 4; i = i + 1  {
  furina skill, dash;
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  furina burst;
  faruzan burst;
  while !.faruzan.mods.favonius-cd {
    faruzan attack;
  }
  jean burst, skill;
  if .wanderer.burst.ready {
    wanderer attack, burst;
  }
  wanderer attack, skill, attack, charge;
  while .wanderer.skydweller-points > 3 {
    if .wanderer.normal < 3 {
      wanderer attack;
    } else if .wanderer.mods.wanderer-a4 {
      wanderer dash;
    } else if .wanderer.skydweller-points > 4 {
      wanderer charge;
    } else {
      break;
    }
  }
  wanderer skill;
}
