neuvillette char lvl=90/90 cons=0 talent=9,9,9 +params=[start_hp=35000]; 
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90 ;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
neuvillette add stats hp%=0.496 hp=507.88 atk%=0.0992 atk=33.08 def%=0.124 def=39.36 em=39.64 cr=0.1986 cd=0.662 er=0.1102 ; #subs


zhongli char lvl=90/90 cons=0 talent=9,9,9; 
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="archaicpetra" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311 ; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2972 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphosmoonlight" refine=1 lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kazuha add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.2979 cd=0.1986;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="eosf" count=5;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;

active neuvillette;

target lvl=100 resist=0.1 radius=1 pos=0,3.4 hp=999999999; 
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {

  if i == 0 {
    neuvillette burst;
  }
  else {
    neuvillette burst, attack;
  }
  zhongli skill[hold=1], dash, attack;
  for let j=0; j<30; j=j+1 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    }
    if pick_up_crystallize("hydro") {
      break;
    }
    wait(1);
  } 
  kazuha skill, high_plunge;
  xiangling burst, attack, skill, dash;
  neuvillette charge, charge, skill, attack:4;

  kazuha skill, high_plunge, burst;
  zhongli skill[hold=1], dash, attack;
  for let j=0; j<30; j=j+1 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    }
    if pick_up_crystallize("hydro") {
      break;
    }
    wait(1);
  } 
  xiangling attack, skill, dash;
  neuvillette charge, skill, charge;
}
wait(173);