mualani char lvl=90/90 cons=2 talent=10,10,10;
mualani add weapon="sacjade" refine=5 lvl=90/90;
mualani add set="oc" count=4;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
mualani add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1653 em=99.1 cr=0.0662 cd=0.662;

mavuika char lvl=90/90 cons=0 talent=10,10,10;
mavuika add weapon="serpent" refine=5 lvl=90/90;
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=10,10,10;
xilonen add weapon="favsword" refine=5 lvl=90/90;
xilonen add set="ins" count=4;
xilonen add stats hp=3571 atk=232 def%=0.435 def%=0.435 cr=0.311;
xilonen add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.333648;

sucrose char lvl=90/90 cons=6 talent=10,10,10;
sucrose add weapon="sacfrags" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187;
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

options swap_delay=12 iteration=1000;

active mualani;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

energy every interval=480,720 amount=1;

# set swap icd to be 24 frames to simulate booking 
set_swap_icd(24);


for let i=0; i<5; i=i+1 {
  mualani attack;
  sucrose skill, dash;
  # wait to meet the 5s off-field requirement of sacrificial jade
  wait(50);
  mavuika burst, attack;
  xilonen skill, attack:2;
  mualani skill;
  while .mualani.momentum < 3 {
    mualani walk[f=1];
  }
  mualani attack, skill, attack;
  mavuika skill;
  sucrose skill, dash;
  # Mualani burst hit the target immediately 
  # given Mualani is close enough to the target
  mualani burst[travel=1];
  # xilonen skill in cd, so casting 2 additional attacks
  xilonen attack:2, skill, attack:2;
  mualani skill;
  for let j=0; j<3; j=j+1 {
    while .mualani.momentum < 3 {
      mualani walk[f=1];
    }
    mualani attack;
  }
  mualani skill;
}

