# Razor Furina Yelan Escoffier. ~25s Rot. Hybrid Razor deals 51/49 Electro/Phys Damage;  he prefers an ATK% goblet. Razor should lead with tap skill for energy reasons. 1E Yelan.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#razor add weapon="tidalshadow" refine=5 lvl=90/90;
razor add set="risingwinds" count=4;
#razor add set="mh" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10; # SS, RW
#razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # TS, MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="totm" count=4; # Better w/ Serpent Spine
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*3 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*9; # ToTM
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
#furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*3 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*9; # GT

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="no" count=4;
#yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="gt" count=4;
#escoffier add set="scroll" count=4;
escoffier add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active razor;
razor skill, dash; # Optimal

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  escoffier skill, burst;

  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  # Standard Rotation
  razor skill[hold=1], dash, attack, burst, attack, skill, dash;
  # Razor main DPS window
  while .razor.mods.razor-q > 210 { # Just before 3rd skill is off CD
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}
