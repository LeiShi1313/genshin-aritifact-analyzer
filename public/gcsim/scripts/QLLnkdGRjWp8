#ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="gd" count=4;
#ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

#Rotation
active ineffa;

for let i = 0; i < 4; i = i + 1 {
  if i > 0  && .ineffa.burst.ready {
    ineffa skill, burst;
  } else {
    ineffa skill;
  }

  furina skill, dash, burst;

  bennett burst, skill, dash, attack; # Bennett seeks a lower skill CD

  if .fischl.skill.ready { # Snapshot
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }

  while .status.bennettburst || .bennett.infusion.bennett-fire-weapon {
    if .bennett.skill.ready {
      bennett skill;
    } else if .bennett.normal > 2 {
      bennett charge, dash;
    } else {
      bennett attack;
    }
  }
}
