options swap_delay=12 iteration=1000;

# Build assumptions
arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
arle add set="fohw" count=4;
arle add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active arle;

fn WaitForCryo() {
  if !.element.t0.pyro {
    while !.element.t0.cryo {
      wait(1);
    }
  }
}

for let i=0; i<4; i=i+1 {
  if .arle.weapon == .keys.weapon.crimsonmoonssemblance {
    arle charge;
  }
  arle skill; delay(11);
  bennett skill, burst;
  escoffier skill, attack;
  citlali skill, burst;
  if .arle.cons >= 2 {
    arle charge[early_cancel=1], dash;
    wait(47); # wait for C2 to hit after CA dash cancel before checking the aura for starting NA chain
  } else {
    arle charge;
  }
  WaitForCryo();
  arle attack:3, dash;
  WaitForCryo();
  arle attack:3, dash;
  WaitForCryo();
  arle attack:3, dash;
  WaitForCryo();
  arle attack:3, dash;
  WaitForCryo();
  arle attack:3, dash;
  WaitForCryo();
  arle attack:2;
  if .arle.cons < 2 {
    arle attack; # if Arle is Pre-C2, One more NA to make E off-cd
  }
}

# Arle CA¹ E > Bennett EQ > Escoffier E > Citlai EQ > Arle CD² 6[wait N3D] >
# ¹ If Arle is holding her Sig weapon, use CA for the passive
# ² If Arle is C2+, Dash cancel her CA before it hit the enemy to prevent Pyro app.
