# Yoimiya Chevreuse Fischl Lisa. ~20s Rot. Yoimiya Overload. Chevreuse passes particles to Lisa if possible. Fischl alternates skill and burst. Yoimiya bursts every rotation.

# Team
yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
#yoimiya add weapon="hamayumi" refine=5 lvl=90/90;
yoimiya add set="echoes" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="scroll" count=4;
#chevreuse add set="no" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.4634;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10]; # Leading
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="hakushin" refine=5 lvl=90/90;
#lisa add weapon="widsith" refine=5 lvl=90/90;
lisa add set="no" count=4;
#lisa add set="emblem" count=4;
lisa add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # More ER will still encounter energy delay
#lisa add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; #main
#lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;

#Rotation
active fischl;
fischl skill;

for let i=0; i<4; i=i+1 {
  if .chev.burst.ready && .chev.energy == .chev.energymax {
    chev burst, attack, skill[hold=1]:2;
    if !.chev.mods.favonius-cd {
      chev skill[hold=1];
    }
  } else {
    chev skill[hold=1], attack:2;
  }

  if .lisa.burst.ready {
    lisa burst, skill[hold=1], attack:3;
  } else {
    lisa skill[hold=1], burst; sleep(20);
  }

  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }

  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack:1;
  if .yoimiya.burst.ready {
    yoimiya burst;
  } else {
    yoimiya attack:3;
  }

}
