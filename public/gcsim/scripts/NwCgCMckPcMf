# Razor Furina Rosaria Baizhu. ~26s Rot. Razor does a long rotation, as Phys shred lasts for the duration of his burst.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="tidalshadow" refine=5 lvl=90/90;
#razor add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="mh" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622 ; #main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # TS
#razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622 ; #main
#razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=178.38 cr=0.1986 cd=0.662; # SS

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.5296; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5296; # ToM

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="ohc" count=4;
#baizhu add set="sodp" count=4;
#baizhu add set="scroll" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active razor;

for let i=0; i<4; i=i+1 {

  furina skill, dash, burst;

  baizhu skill, attack, burst;

  rosaria skill, burst;

  # Razor out of burst actions; account for energy deficiency
  while !.razor.mods.razor-q {
    if .razor.burst.ready && .razor.skill.ready {
      razor skill, dash, attack, burst;
    } else if .razor.burst.ready {
      razor burst;
    } else if .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  # Razor Main DPS window; Burst ends 3.5s early
  while .razor.mods.razor-q > 160 {
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }

}
