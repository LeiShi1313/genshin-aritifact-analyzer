# Diluc Furina Yelan Xilonen. ~22s Rot. Yelan skill just before and after Diluc field time. Xilonen uses skill twice and bursts before Furina. Yelan has the highest damage share.

# Team - Options listed by DPS
diluc char lvl=90/90 cons=0 talent=9,9,9;
diluc add weapon="tidalshadow" refine=5 lvl=90/90;
diluc add set="mh" count=4;
#diluc add set="ap" count=4; # AP performs about as well as MH or CW with Serpent Spine.
#diluc add set="cw" count=4;
diluc add stats hp=4780 atk=311 pyro%=0.466 atk%=0.466 cd=0.622; #main
diluc add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # MH + TS
#diluc add stats hp=4780 atk=311 pyro%=0.466 atk%=0.466 cd=0.622; #main
#diluc add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # AP/CW + TS

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2979 cd=0.5958;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.434 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.2648;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,3 hp=100000000;

# Rotation
active xilonen;

for let i = 0; i < 4; i = i + 1 {
  xilonen burst;

  furina skill, dash, burst;

  yelan burst, attack:1;
  if .yelan.breakthrough {
    yelan aim;
  }

  xilonen skill, attack:2;

  yelan skill, attack:2;

  diluc burst;
  pick_up_crystallize("hydro"); # Optimistic
  diluc attack, skill, attack, skill, attack:2, skill, attack:3;

  yelan skill, attack;

  xilonen skill, attack:2;
  if !.xilonen.mods.favonius-cd {
    xilonen attack;
  }
}
