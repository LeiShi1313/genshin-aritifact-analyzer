options iteration=1000 swap_delay=12;

# Build assumptions
dehya char lvl=90/90 cons=6 talent=10,10,10;
dehya add weapon="beaconofthereedsea" refine=5 lvl=90/90;
dehya add set="mh" count=4;
dehya add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; # Main stats: EM Pyro% CD
dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=118.92 cr=0.1655 cd=0.662;

bennett char lvl=90/90 cons=6 talent=10,10,10;
bennett add weapon="mistsplitter" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; # Main stats: ER% Pyro% CR
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5259;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="key" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cd=0.622; # Main stats: ER% HP% CD
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.3972 cd=0.2648;

xilonen char lvl=90/90 cons=6 talent=10,10,10;
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 er=0.518 def%=0.583 def%=0.583; # Main stats: ER% DEF% DEF%
xilonen add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5259;

# Target, Energy and damage taken assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops
hurt every interval=180,300 amount=3500,5500 element=physical; # damage taken assumed every 3-5s

# Rotation assumptions
active dehya;


for let i=0; i<5; i=i+1 {
  dehya skill;
  furina skill, dash, charge, attack, charge, burst;
  bennett skill, burst;
  xilonen skill, attack:2;
  dehya burst, attack:15;
  xilonen skill, attack:2;
  bennett skill, dash;
  dehya skill;
}

# ~20s rotation
# Dehya E > Furina ED C N1 C Q > Bennett EQ > Xilonen E N2 > Dehya Q N15 > Xilonen E N2 > Bennett E D > Dehya E
