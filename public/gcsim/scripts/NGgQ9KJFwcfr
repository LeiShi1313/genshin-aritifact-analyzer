fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3310 cd=0.7944;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="thewidsith" refine=3 lvl=90/90;
yae add set="gt" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active yae;
for let x=0; x<4; x=x+1 {
  yae skill:3;
  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd { 
    zhongli attack; 
  }
  navia burst;
  if .fischl.skill.ready {
    fischl attack, skill, dash;
  } else {
    fischl attack:2, burst; pick_up_crystallize("any");
  }
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2, dash;     print(.navia.shrapnel);
  if x<3 { # until 3rd rot
    navia skill, attack:3, dash, attack:2;
  } else { # 4th rot onwards due to E cd
    navia attack, dash, skill, attack:2, dash, attack:2, dash, attack:2;
  }
}

