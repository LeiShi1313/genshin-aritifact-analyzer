let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if ( char_id == .keys.char.noelle && action_id == .action.attack ) {
    pick_up_crystallize("any");#pick up all the crystals mhm
  }

  return _execute_action(char_id, action_id, p);
}

noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="favgs" refine=3 lvl=90/90;
noelle add set="archaicpetra" count=4;
noelle add stats hp=4780 atk=311 er=0.518 geo%=0.466 cr=0.311;
noelle add stats def%=0.434 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5958;

