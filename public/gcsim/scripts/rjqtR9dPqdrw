options swap_delay=12 iteration=500;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active furina;

for let i=0; i<4; i=i+1 {

furina skill, dash, burst;
xingqiu burst, attack, skill, dash;
yelan  attack, burst, attack, skill, attack;
noelle skill, attack, burst, attack:3, dash, attack:3, dash, attack:3;
