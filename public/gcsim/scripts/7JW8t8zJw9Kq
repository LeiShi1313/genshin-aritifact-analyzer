#enemy config

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
active neuvillette;

#action list

for let i=0; i<4; i=i+1 {

    neuvillette skill;
    navia burst;
    furina skill, dash, burst;
    jean attack, skill, burst;
    navia skill[hold=1];

    neuvillette charge, burst, skill, charge;
    navia skill[hold=1];
    jean attack, skill;
    neuvillette charge, charge;

}

wait(173); #for the last CA
