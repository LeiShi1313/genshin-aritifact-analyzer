options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

fn naviaskill() {
  if .navia.shrapnel >=3 { # check current shrapnel stacks. if 3-6 stakcs, use tap E, otherwise hold E
    navia skill;
  } else {
    navia skill[hold=1];
  }
}

active navia; ## SS Stacks
for let i=0; i<4; i=i+1 {
  xilonen burst;
  furina skill, dash, burst;
  xilonen skill, attack:2;
  navia burst;
  mavuika burst, charge, skill;            print(.navia.shrapnel);
  naviaskill();
  navia attack:3, dash, attack:2;          print(.navia.shrapnel);
  xilonen skill, attack:2;                 print(.navia.shrapnel);
  naviaskill();
  navia attack:3, dash, attack:2;          print(.navia.shrapnel);
  if i == 0 || i == 3 {        # 1st and 4th rot
    naviaskill();
    navia attack:2;
  }
}

