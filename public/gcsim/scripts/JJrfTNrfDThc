
xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ADC;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.5958;

beidou char lvl=90/90 cons=6 talent=9,9,9;
beidou add weapon="uomms" refine=5 lvl=90/90;
beidou add set="noblesse" count=4;
beidou add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
beidou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=100;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=1.1, 1 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=-1.1,1 hp=100000000;

# Beidou 50% Perfect Counter, 50% tap
fn rand_counter() {
  let counter = rand();
  if counter > 0.5 {
    counter = 2;
  } else {
    counter = 0;
  }

  return counter;
}

fn xianyunCombo() {
  if .xianyun.skill.ready {
      xianyun skill, low_plunge;
  } else {
    # Driving NA Combo
    if .xianyun.normal > 1 && .xianyun.jump.ready && .xianyun.mods.xianyun-airborne-buff {
      xianyun jump;
      if .airborne {
        xianyun high_plunge[collision=rand()>0.5];
      }
    } else {
      xianyun attack;
      if .xianyun.normal > 2 && .xianyun.dash.ready {
        xianyun dash;
      } else if .xianyun.normal > 2 && !.xianyun.dash.ready {
        xianyun charge;
      }
    }
  }
}

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }

  furina skill, dash, burst;

  xianyun skill, low_plunge, burst;

  beidou skill[counter=rand_counter()], burst;

  while .fischl.oz {
    xianyunCombo();
  }

  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }

  beidou attack, skill[counter=rand_counter()];

  xianyun attack;
  while .fischl.oz {
    xianyunCombo();
  }

}
