options swap_delay=12 iteration=1000;

# Build assumptions
flins char lvl=90/90 cons=6 talent=10,10,10;
flins add weapon="bloodsoakedruins" refine=5 lvl=90/90;
flins add set="nightoftheskysunveiling" count=4;
flins add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;
//flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

ineffa char lvl=90/90 cons=6 talent=10,10,10;
ineffa add weapon="fracturedhalo" refine=5 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

columbina char lvl=90/90 cons=6 talent=10,10,10;
columbina add weapon="nocturnescurtaincall" refine=5 lvl=90/90;
columbina add set="silkenmoonsserenade" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2979 cd=0.5958;

xilonen char lvl=90/90 cons=6 talent=10,10,10;
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="ins" count=4;
xilonen add stats hp=3571 atk=232 def%=0.583 def%=0.43725 def%=0.43725;
xilonen add stats def%=0.31248 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.111216;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active columbina;

for let i=0; i<6; i=i+1 {
  if !i {
    columbina skill;
  }
  ineffa skill, burst;
  if i {
    columbina skill;
  }
  columbina burst;
  xilonen skill, attack:2;
  flins skill, attack,
        skill, attack, burst,
        attack:3, dash, attack:3,
        skill, attack, burst,
        attack:3, dash, attack:3,
        skill, burst, attack;
  if is_even(i) {
    xilonen skill, attack:2;
    flins burst;
  }
}

# First rot starts with Columbina E
# Ineffa E Q > Columbina E Q > Xilonen E N2 > Flins E N1 2[E N1 Q N3D N3] E Q N1 ( > Xilonen E N2 > Flins Q )
