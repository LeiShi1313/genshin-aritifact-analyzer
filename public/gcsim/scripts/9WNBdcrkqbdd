options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mavuika;

for let i=0; i<4; i=i+1 {
  bennett skill;
  chongyun skill;
  mavuika skill;
  bennett swap;
  wait(44);
  bennett burst;
  citlali skill, burst, attack;
  mavuika burst;
  wait(18); # to wait Cryo app
  if i {
    wait(2);
  }
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  delay(11);       # wait for Cryo app
  mavuika charge;  # this last CA is buffed by Mavuika Q
}

# Bennett E > Chongyun E > Mavuika E > Bennett Q > Citlali EQ N1 > Mavuika Q (wait) 4[C2D] C
