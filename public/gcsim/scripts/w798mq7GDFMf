options swap_delay=12 iteration=100 ignore_burst_energy=false;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active navia; ##SS stacks
emilie skill;
bennett skill;
for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash;
  if i > 0 {
    while .zhongli.mods.favonius-cd == 0 {
      zhongli attack;
      if .zhongli.normal == 4 {
        zhongli dash;
      }
    }
  } else {
    navia skill;
  }
  if .navia.burst.ready && .navia.energy == .navia.energymax {
    navia burst; 
  }
  bennett skill, burst;
  if .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, dash;
  }
  navia skill[hold=1], attack:3, dash, attack:2;
  bennett skill, dash;
  navia skill[hold=1], attack:3, dash, attack:2;
}
