keqing char lvl=90/90 cons=0 talent=10,10,10;
keqing add weapon="harangeppakufutsu" refine=1 lvl=90/90;
keqing add set="thunderingfury" count=5;
keqing add stats def%=0.175 def=16 hp=4780 hp%=0.099 atk=391 atk%=0.7110000000000001 er=0.11 em=42 cr=0.39999999999999997 cd=1.259 electro%=0.466;

zhongli char lvl=90/90 cons=0 talent=1,10,6;
zhongli add weapon="favoniuslance" refine=5 lvl=90/90;
zhongli add set="archaicpetra" count=5;
zhongli add stats def%=0.073 def=127 hp=3870 hp%=1.461 atk=285 atk%=0.09300000000000001 er=0.065 em=121 cr=0.6 cd=0.7;

fischl char lvl=90/90 cons=6 talent=1,10,10;
fischl add weapon="thestringless" refine=5 lvl=90/90;
fischl add set="goldentroupe" count=5;
fischl add stats def%=0.066 def=144 hp=5437 hp%=0.187 atk=311 atk%=0.553 er=0.052000000000000005 em=82 cr=0.544 cd=0.7929999999999999 electro%=0.466;

nahida char lvl=90/90 cons=0 talent=1,10,10;
nahida add weapon="wanderingevenstar" refine=5 lvl=90/90;
nahida add set="instructor" count=5;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; # main
nahida add stats em=0  cr=0.65 cd=0.9375;

options iteration=500 swap_delay=4;

target lvl=100 resist=0.1 hp=999999999 radius=2 pos=0,2.4;

energy every interval=480,720 amount=1; # Generate 1 particle about every 10 seconds

active keqing;

fn zhongli_sequence() {
  zhongli skill[hold=1];
  
  while !pick_up_crystallize("electro") {
    wait(1);
  }
}

fn nahida_sequence() {
  if .nahida.burst.ready {
    nahida burst;
  }
  
  nahida skill;
  
  if !.zhongli.swap.ready {
    nahida attack;
  }
}

for let r = 0; r < 4; r = r + 1 { # 4 rotations

  if .keqing.skill.ready {
    keqing skill, skill;
  }
  

    zhongli_sequence(); # First rotation use Zhongli before Nahida
    nahida_sequence();

  
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl skill, attack;
  }
  
  while .fischl.oz {
    if .keqing.skill.ready {
      keqing skill, skill;
    } else if .keqing.burst.ready {
      keqing attack, burst;
    } else if .keqing.normal == 2 {
      keqing charge;
    } else {
      keqing attack;
    }
  }
}

# Keqing EE > Zhongli Hold E > Nahida Q (if able) E > Fischl Q/E > Keqing EE Q N4C spam until Oz expires