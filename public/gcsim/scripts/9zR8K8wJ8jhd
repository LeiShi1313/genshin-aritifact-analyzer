

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="wolffang" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
#kazuha add set="vv" count=2;
#kazuha add set="vermillion" count=2;
#kazuha add set="emblem" count=4;
kazuha add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311 ; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favoniuswarbow" refine=4 lvl=90/90;
faruzan add set="gt" count=5;
#faruzan add set="vv" count=5;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;



options swap_delay=12 iteration=100;
target lvl=100 resist=.1 radius=3 pos=0,3.4 hp=999999999999;
energy every interval=480,720 amount=1;

active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  bennett burst, skill;
  faruzan skill, burst, aim;
  if .kazuha.burst.ready {
    kazuha burst;
  }
  kazuha skill, high_plunge;
  bennett skill, attack:2;
  faruzan skill, aim:2;
  kazuha skill, high_plunge[collision=1];
  bennett skill, attack:2;
  furina attack:2;
  faruzan skill, aim:2;
  kazuha skill, high_plunge;
}
