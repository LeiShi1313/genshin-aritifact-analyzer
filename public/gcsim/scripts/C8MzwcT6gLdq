options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=10;

active rosaria;

for let i=0; i<4; i=i+1 {

  rosaria skill;
  bennett burst, skill;
  amber attack, skill, dash, burst;
  chongyun burst, skill;
  rosaria skill, burst;
  amber aim[bunny=1], skill, dash, aim[bunny=1], attack:2;
  
  for let x = 0; x< 3; x=x+1 {
    let weak = rand();
    if weak > 0.3 {
      amber aim[weakspot=1], dash;

    }
    else {
      amber aim, dash;
      
    }
  }
}

