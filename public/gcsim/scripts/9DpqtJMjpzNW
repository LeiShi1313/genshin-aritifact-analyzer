xiangling add set="eosf" count=2;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.3857 em=39.64 cr=0.331 cd=0.331;

options swap_delay=12 iteration=1000;

active xilonen;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

for let i=0; i<4; i=i+1 {
  xilonen burst;
  yelan skill, attack, burst, attack;
  xilonen skill, attack:2;
  xiangling burst, skill, dash;
  mualani skill;
  mualani_combo();
  if .mualani.burst.ready && .mualani.energy == .mualani.energymax {
    mualani burst;
    wait(70);   # wait until the Q hits if the sim ends with Mualani Q.
  } else {
    mualani skill; # exit NS state
    mualani attack:4; # trigger Yelan Q twice
    delay(62);  # wait ~1 second due to xiangling 20s cd
  }
}


# Xilonen Q > Yelan E N1 Q N1 > Xilonen E N2 > Xiangling Q ED > Mualani E 3[3-stacked bite] ( Q / E N4) >
