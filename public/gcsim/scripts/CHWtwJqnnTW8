#enemy config
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

#rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  escoffier skill, burst;
  yelan burst, attack, skill, attack;
  ayato skill, attack:16, burst, attack;
  escoffier attack:3; # Proc Fav
  yelan skill, attack;
  ayato skill, attack:11;
}

# ~26s rotation
# Furina ED Q > Escoffier EQ > Yelan Q N1 E N1 > Ayato E N16 Q N1 > Escoffier N3 > Yelan E N1 > Ayato E N11