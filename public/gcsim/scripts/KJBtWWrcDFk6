ningguang char lvl=90/90 cons=6 talent=9,9,9;
ningguang add weapon="widsith" refine=3 lvl=90/90;
ningguang add set="nighttime" count=4;
ningguang add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311;
ningguang add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

albedo char lvl=90/90 cons=0 talent=9,9,9;
albedo add weapon="cinnabarspindle" refine=5 lvl=90/90;
albedo add set="gt" count=4;
#albedo add set="husk" count=4 +params=[stacks=4];
albedo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
albedo add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311 ; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbingerofdawn" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

# Options
options iteration=100;
options swap_delay=12;
options duration=90;
energy every interval=480,720 amount=1;

let normal_attack_state = 1;
let c_left = 0;
let c_twirl = 2;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0;

# Rotation
active zl;
for {
  switch {
    case !.zhongli.tags.shielded && .zhongli.swap.ready:
      zhongli skill[hold=1], dash;
    case .chiori.skill.ready && .chiori.swap.ready:
      chiori skill:2;
    case .albedo.skill.ready && .albedo.swap.ready &&  !.albedo.elevator:
      albedo skill, attack;
    case .ningguang.skill.ready && .ningguang.swap.ready && (!.status.bennettburst || .ningguang.mods.bennett-field):
      ningguang skill, dash;
    case .ningguang.burst.ready && .ningguang.swap.ready:
      ningguang burst, walk;
    case .ningguang.jadeCount == 7 && .ningguang.swap.ready:
      ningguang charge;
    case .ningguang.onfield && .state == normal_attack_state:
      if .ningguang.prevAttack == c_left || .ningguang.prevAttack == c_twirl {
        ningguang charge;
      } else {
        ningguang walk;
      }
    case .chiori.burst.ready && .chiori.swap.ready:
      chiori burst;
    default:
      ningguang attack;
  }
}
