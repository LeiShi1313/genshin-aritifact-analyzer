# PMC Emilie Fischl Bennett. ~20s Rot. PMC Overburn. Near Zero Quicken uptime, 3EM Fischl is more damage. Emilie bursts every other rotation and carries the plurality of team DPS

# Team - Options listed by DPS
aetherpyro char lvl=90/90 cons=6 talent=9,9,9  +params=[base_atk_buff=1, skirk_story_buff=1];
aetherpyro add weapon="harbinger" refine=5 lvl=90/90;
aetherpyro add set="scroll" count=4;
aetherpyro add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
aetherpyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # Scroll

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="deepwood" count=4;
#fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 em=187 em=187; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.2979 cd=0.331;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=140]; # to Fischl
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1655 cd=0.7282;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

#Rotation
active emilie;

for let i=0; i<4; i=i+1 {
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  bennett skill, burst;

  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack:1, skill;
  }

  aetherpyro skill[hold=0];
  while .status.bennettburst || .aetherpyro.mods.bennett-field {
  #while .aetherpyro.mods.nightsoul-blessing {
    switch {
      case .aetherpyro.burst.ready && .aetherpyro.normal > 1:
        aetherpyro burst;
      case .aetherpyro.normal > 3 && .stam > 25: # N3C
        aetherpyro charge;
      case .aetherpyro.normal > 3 && .aetherpyro.dash.ready && .stam > 18: # N3D
        aetherpyro dash;
      default:
        aetherpyro attack;
    }
  }
}
