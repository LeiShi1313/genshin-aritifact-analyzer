xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushinring" refine=5 lvl=90/90;
xianyun add set="viridescentvenerer" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*8 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    } else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
      varesa jump;
      if .airborne {
        varesa high_plunge[collision=1]; # JP
      }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  ororon burst, skill;
  xianyun skill, low_plunge, burst, attack;
  varesa_combo(7);
}

# 20s rotations
# Furina ED N1 Q > Ororon Q E > Xianyun EPQ N1 > Varesa 7 Plunge Combos