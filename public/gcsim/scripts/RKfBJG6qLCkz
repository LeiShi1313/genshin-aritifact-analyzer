nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*3 cr=0.0331*9 cd=0.0662*11;

dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="favgs" refine=3 lvl=90/90;
dori add set="fopl" count=4;
dori add stats hp=4780 atk=311 em=187 em=187 em=187; #main
dori add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*6 cr=0.0331*12 cd=0.0662*5;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;


# Rotation
active nahida;

for let i = 0; i < 4; i = i + 1 {
  nahida skill, burst;
  
  furina skill, dash, burst;
  
  dori skill, attack;
  
  alhaitham burst;
  
  dori burst;
  
  alhaitham attack:3, dash,
            attack:3, dash,
            attack:3;
          
  dori skill, attack;
  
  alhaitham skill[hold=1], low_plunge[short=1], 
            attack:3, dash,
            attack:3, dash,
            attack:2;
}
wait(36); #wait for final hits before sim end



