mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="sacrificialjade" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=5;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
mualani add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=218.02 cr=0.0662 cd=0.662;

candace char lvl=90/90 cons=5 talent=9,9,9;
candace add weapon="favlance" refine=3 lvl=90/90;
candace add set="scroll" count=4;
candace add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
candace add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="fruit" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.551 em=118.92 cr=0.0662 cd=0.1324;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="scroll" count=5;
xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.2204 em=39.64 cr=0.331 cd=0.5296;

options swap_delay=12 iteration=1000;

active mualani;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

mualani attack; # for hydro swirl in the 1st rot
for let i=0; i<2; i=i+1 {
  sucrose skill;
  xiangling burst, skill, dash;  
  candace skill, burst, attack;
  if !.candace.mods.favonius-cd {
    candace attack;
  } else {
    wait(8); #catch her own hydro particles on-field
  }
  mualani burst;
  mualani skill;
  mualani_combo();
  candace skill, attack:2, dash, burst;
  xiangling attack:3;
  if !.xiangling.mods.favonius-cd {
    xiangling attack;
  }
  xiangling skill, dash;
  sucrose skill, dash, attack, burst;
  mualani skill;
  mualani_combo();
  if .mualani.nightsoul.state {
    mualani skill; # exit the nightsoul state
  }
  while !.element.t0.hydro {
    mualani attack;
  }
}

# Mualani N1 >
# Sucrose E > Xiangling QED > Candace EQ N1 >         Mualani Q E 3[3-stacked bite] >
# Candace E N2 Q > Xiangling N3ED > Sucrose ED N1 Q > Mualani   E 3[3-stacked bite] E(cancel) N1(NA till the enemy has hydro arua) >

