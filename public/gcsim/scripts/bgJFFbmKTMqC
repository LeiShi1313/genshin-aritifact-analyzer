# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Raiden Plunge Combo
fn RaidenPlunge() {
  raiden jump;
  if .airborne {
    raiden high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 { 
  
  furina skill, dash, burst;
  
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst;
  
  RaidenPlunge(); raiden dash;
  RaidenPlunge(); raiden dash;
  RaidenPlunge(); raiden dash;
  RaidenPlunge(); raiden dash;
  RaidenPlunge(); raiden dash;
  RaidenPlunge(); raiden dash;
  RaidenPlunge(); raiden dash;
  RaidenPlunge(); raiden attack, skill;
  
  bennett skill, dash;

}
