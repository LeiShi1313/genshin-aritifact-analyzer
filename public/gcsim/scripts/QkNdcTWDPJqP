# Sethos Yelan Ororon Nahida. ~18s Rot. Sethos with an EM Hyperbloom Ororon. Nahida Supplies the only healing with Pamber. Sethos uses dashes to reposition to better hit bloom cores after N2D. Sethos ends the rotation with 2 level 2 aimed shots.

# Team - Options listed by DPS
sethos char lvl=90/90 cons=6 talent=9,9,9;
sethos add weapon="slingshot" refine=5 lvl=90/90;
sethos add set="wt" count=4;
sethos add stats hp=4780 atk=311 em=187 em=187 cd=0.622;
sethos add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # EEC
#sethos add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622;
#sethos add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.3641 cd=0.3972; # EDC

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

ororon char lvl=90/90 cons=6 talent=9,9,9; 
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 em=187 em=187 em=187; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="pamber" refine=5 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.2979 cd=0.4634;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
#target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000;

# Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  if i == 0 {
    nahida skill, burst;
  } else {
    nahida skill, attack, burst;
  }
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  ororon skill, attack, burst, attack;
  
  sethos skill, attack; #aim[hold=2]; # High ping only 
  sethos burst;
  sethos attack:2, dash,
         attack:2, dash,
         attack:2, dash,
         attack:2, dash,
         attack:2, dash,
         attack:2, dash,
         attack:2, dash,
         attack:2, walk,
         skill;
  sethos attack, aim[hold=2]:2, attack;
}
