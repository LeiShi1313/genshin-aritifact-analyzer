# Wanderer Xingqiu Fischl Beidou. ~21s Rot. VV Wander Taser in 2 Target with interuption resistance. Wanderer stays on-field.

# Team
wanderer char lvl=90/90 cons=0 talent=9,9,9; 
wanderer add weapon="widsith" refine=3 lvl=90/90;
wanderer add set="vv" count=4;
wanderer add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
wanderer add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="no" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

beidou char lvl=90/90 cons=6 talent=9,9,9; 
beidou add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
beidou add set="emblem" count=4;
beidou add stats hp=4780 atk=311 er=0.518 electro%=0.466 cd=0.622; #main
beidou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.3857 em=39.64 cr=0.3641 cd=0.1986;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,3.5 hp=100000000; 

# Rotation
active beidou; # SS Stacks

fischl skill;

for let i=0; i<4; i=i+1 {
  xingqiu skill, dash, burst, attack;
  
  beidou skill, attack, burst, attack;
  
  if .amy.burst.ready {
    amy attack:2, burst;
  } else if .amy.skill.ready {
    amy attack:1, skill;
  }
  
  wanderer attack, skill;
  while .wanderer.skydweller-points > 3 {
    switch {
      case .wanderer.normal < 3:
        wanderer attack;
      case .wanderer.mods.wanderer-a4:
        wanderer dash;
      default:
        wanderer attack;
    }
  } 
  if .wanderer.burst.ready && .wanderer.energy == .wanderer.energymax {
    wanderer attack, burst;
  } else {
    #wanderer skill;
    wanderer low_plunge;
  }
  
}
