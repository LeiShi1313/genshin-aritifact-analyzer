xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="thecatch" refine=5 lvl=90/90;
xiangling add set="ap" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=39.64 cr=0.1324 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  mualani skill;
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 { # 3 bites
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    mualani skill; # cancel nightsoul state with skill
  }
}

active mualani;

for let i=0; i<3; i=i+1 {
  mualani attack;
  xilonen skill, attack:2;
  xiangling burst, skill, dash; pick_up_crystallize("hydro");
  candace skill, burst;
  mualani_combo();
  mualani burst;
  wait(45);

  candace skill;
  xilonen skill, attack:2;
  xiangling skill, dash, attack; pick_up_crystallize("hydro");
  mualani_combo();
}
