# TF Faruzan with Yaoyao Kazuha Fischl

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="stringless" refine=3 lvl=90/90;
faruzan add set="tf" count=4;
faruzan add stats hp=4780 atk=311 em=561;
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=118.92 cr=0.3972 cd=0.1324;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=5;
fischl add stats hp=4780 atk=311  em=186.5 electro%=0.466 cr=0.31; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

yaoyao char lvl=90/90 cons=6 talent=9,9,9;
yaoyao add weapon="favlance" refine=3 lvl=90/90;
yaoyao add set="scroll" count=4;
yaoyao add stats hp=4780 atk=311 atk%=0.466 cr=0.311 dendro%=0.466;
yaoyao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.331 cd=0.7282;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=561;
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=118.92 cr=0.3641 cd=0.1324;

options swap_delay=12 iteration=1000 duration=120;
target lvl=100 resist=0.1 radius=1 pos=0,1.5 ; 
target lvl=100 resist=0.1 radius=1 pos=2.5,0.5 ; 
energy every interval=480,720 amount=1;


active faruzan;

for {
  switch {
    case !.fischl.oz && .fischl.burst.ready && .fischl.swap.ready:
      fischl attack:2, burst;
    case !.fischl.oz && .fischl.skill.ready && .fischl.swap.ready:
      fischl attack, skill;
    case .faruzan.hurricane-count && .faruzan.swap.ready:
      faruzan aim;
    case .kazuha.skill.ready && .kazuha.swap.ready:
      kazuha skill, high_plunge;
    case .kazuha.burst.ready && .kazuha.swap.ready:
      kazuha burst;
    case .yaoyao.skill.ready && .yaoyao.swap.ready:
      yaoyao skill, attack;
    case .faruzan.burst.ready && .faruzan.swap.ready:
      faruzan burst;
    case .faruzan.skill.ready && .faruzan.swap.ready:
      faruzan skill;
    default:
      faruzan attack;
  }
}

