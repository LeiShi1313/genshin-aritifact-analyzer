chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*6;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo_opener() {
  clorinde skill, attack:3, skill;
  set_player_pos(0, -5); # clorinde lunge into sara burst
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
      set_player_pos(0, 0);
    } else {
      clorinde attack;
    }
  }
}

fn clorinde_combo_rotation() {
  clorinde skill, attack, skill; # adjustment due to chev healing
  set_player_pos(0, -5); # clorinde lunge into sara burst
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
      set_player_pos(0, 0);
    } else {
      clorinde attack;
    }
  }
}

active sara;

sara skill, attack:2;
luminepyro skill, burst;
chevreuse burst, skill[hold=1];
sara burst;
clorinde_combo_opener();

for let i=0; i<4; i=i+1 {
  sara aim;
  chevreuse skill[hold=1], attack;
  clorinde attack, burst, attack:2;
  luminepyro skill, burst;
  if .sara.burst.ready {
    sara skill, burst;
  } else {
    sara skill, attack;
  }
  clorinde_combo_rotation();
}

# ~18s rotations (~14s opener)
# Opener: Sara E N2 > Pyro Traveler tE Q > Chevreuse Q hE > Sara Q > Clorinde E combo
# Ongoing: Sara C > Chevreuse hE N1 > Clorinde N1 Q N2 > Pyro Traveler tE Q > Sara E Q/N1 > Clorinde E combo