options swap_delay=12 iteration=1000;

# Build assumptions
lyney char lvl=90/90 cons=0 talent=9,9,9;
lyney add weapon="songofstillness" refine=5 lvl=90/90;
lyney add set="mh" count=4;
lyney add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
lyney add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
//fischl add set="gt" count=4;
fischl add set="totm" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="no" count=4;
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active durin;
for let i=0; i<4; i=i+1 {
  durin skill, burst, attack;
  fischl attack, skill;
  chev burst, skill[hold=1], attack;
  lyney aim:2;
  lyney burst;
  delay(11);
  lyney skill;
  lyney aim;
  durin skill:2;
  chev attack, skill[hold=1], attack;
  fischl attack:2, burst;
  lyney aim:3;
  if i<3 {
    lyney skill, aim;
  } else {
    lyney aim, skill;
  }
}
