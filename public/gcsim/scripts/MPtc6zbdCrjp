varesa char lvl=90/90 cons=0 talent=9,9,9;
varesa add weapon="thewidsith" refine=3 lvl=90/90;
varesa add set="obsidiancodex" count=4;
varesa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
varesa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*6 cd=0.0662*10;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90;
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
mavuika add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
chevreuse add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*6;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    //} else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
    //  varesa jump;
    //  if .airborne {
    //    varesa high_plunge[collision=1]; # JP
    //  }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

active varesa;

varesa_combo(1);
chevreuse burst, skill[hold=1];
bennett burst;
mavuika burst, skill, dash;
varesa_combo(5);

for let i=0; i<3; i=i+1 {
  varesa_combo(1);
  chevreuse attack, skill[hold=1];
  if .chevreuse.burst.ready && .chevreuse.energy == .chevreuse.energymax {
    chevreuse burst;
  } else {
    chevreuse attack;
  }
  if !.bennett.burst.ready {
    bennett skill;
  }
  bennett burst;
  mavuika burst, skill, dash;
  varesa_combo(5);
}

# ~18s rotations
# Rotation 1: Varesa 1 Plunge Combo > Chevreuse Q hE > Bennett Q > Mavuika Q ED > Varesa 5 Plunge Combos
# Rotation 2+: Varesa 1 Plunge Combo > Chevreuse N1 hE Q/N1 > Bennett (E)Q > Mavuika Q ED > Varesa 5 Plunge Combos