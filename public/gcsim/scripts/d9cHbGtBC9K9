options swap_delay=12;

xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="uomms" refine=5 lvl=90/90 +params=[melusines=6];
xinyan add set="mh" count=4;
xinyan add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favsword" refine=3 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=118.92 cr=0.3972 cd=0.4634;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9 ;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=59.46 cr=0.2648 cd=0.7944;

target lvl=100 resist=.1 hp=5000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active furina;
for let i=0; i<4; i=i+1 {
    if !i {
        furina skill, dash, attack, burst;
    } else {
        furina burst, skill;
    }
    while !.furina.mods.favonius-cd {
        furina attack;
    }
    bennett burst, attack, skill;
    kazuha burst, skill, high_plunge;
    while !.kazuha.mods.favonius-cd {
        kazuha attack;
    }
    xinyan skill, burst, attack:4, dash, attack:4;
    kazuha skill, high_plunge;
    while !.kazuha.mods.favonius-cd {
        kazuha attack;
    }
    bennett skill;
}
