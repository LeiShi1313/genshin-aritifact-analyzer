ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="footprintoftherainbow" refine=5 lvl=90/90;
// yunjin add set="husk" count=4 +params=[stacks=4];
// yunjin add set="no" count=4;
yunjin add set="scroll" count=2;
yunjin add set="eosf" count=2;
yunjin add stats hp=4780 atk=311 er=0.518 def%=0.583 def%=0.583;
yunjin add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2648 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
#target lvl=100 resist=0.1 radius=2 pos=4,5 hp=999999999; 
energy every interval=480,720 amount=1;

active yelan;
for let i=0; i<4; i=i+1 {
  yelan skill, attack, burst, attack;
  yunjin skill, attack, burst;
  ororon attack, skill, burst;
  if !.ororon.mods.favonius-cd {
    ororon attack;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde burst;
}
