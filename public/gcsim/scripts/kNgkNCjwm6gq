xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2648 cd=0.662;

options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active nahida;
# ----  Actions List

for let x=0; x< 4; x=x+1 {
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  }
  xingqiu skill, dash, burst, attack;
  bennett skill,attack, burst;
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack:5;
  if .yoimiya.burst.ready {
    yoimiya burst;
  }
  bennett skill, attack;
}
