# - Characters

klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="lw" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

albedo char lvl=90/90 cons=0 talent=9,9,9; 
albedo add weapon="cinnabar" refine=5 lvl=90/90;
albedo add set="gt" count=4;
#albedo add set="husk" count=4 +params=[stacks=4];
albedo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
albedo add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="ap" count=4;
#zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# - Options

options swap_delay=12 debug=true iteration=100;
energy every interval=480,720 amount=1;
let waitForCA = 0;

# - Targets

target lvl=100 resist=0.1 hp=100000000 pos=3,0 radius=2;

# - Actions

active klee;

klee attack;
for let x = 0; x < 5; x = x + 1 {
  waitForCA = 0;
  
  albedo skill, attack;
  
  zhongli skill[hold=1], dash, attack;
  while !pick_up_crystallize("pyro") { # Use NAs or wait until pyro crystallize can be picked up
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  }
  
  if !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  
  bennett skill, burst;
  
  if .klee.skill.ready{
    klee attack, skill[bounce=3, mine=8];
    if .klee.burst.ready && .klee.energy == .klee.energymax {
      klee burst, walk;
    } else {
      klee jump;
    }
  } else if .klee.burst.ready && .klee.energy == .klee.energymax {
    klee attack, burst, walk;
  }
  for let n1c = 0; n1c < 3; n1c = n1c + 1 {
    klee attack[travel=6], charge; # [travel=6] is used to ensure the NA hits before starting CA animation
  }
  for let n2c = 0; n2c < 4; n2c = n2c + 1 {
    klee attack, walk, attack[travel=6];
     if .stam >= 50 || .status.kleespark {
       klee charge;
     } else {
       klee walk, attack, walk;
     }
  }
  
  if .previous-action == .action.charge {
    klee attack;
    waitForCA = 1;
  }
}
if waitForCA {
    wait(25); # Lets final CA and burst ticks hit
}

# Klee Mono Double Geo with Albedo: Klee, Albedo, Bennett, Zhongli. Klee bursts every other rotation and only uses her skill when available to shorten the rotation. 16-18s rotation.
# Albedo E N1, Zhongli hE D N1 (pick up pyro shard), Bennett EQ
#   Klee E & Q ready: Klee N1 E Q W
#   Only Klee E ready: Klee N1 E J
#   Only Klee Q ready: Klee N1 Q W
# Klee 3N1C 4(N2C or N3) N1
# Klee either does a CA or another NA after her N2 depending on if she has stamina or a spark.
# Klee strings together her NAs with walk cancels to do repeated N1s in her N2C and N3 combos.

