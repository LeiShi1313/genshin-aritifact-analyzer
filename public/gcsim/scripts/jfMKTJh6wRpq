ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="ballad" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

aino char lvl=90/90 cons=6 talent=9,9,9;
aino add weapon="favoniusgreatsword" refine=3 lvl=90/90;
aino add set="silkenmoonsserenade" count=4;
aino add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
aino add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favoniussword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*6 cr=0.0331*10 cd=0.0662*2;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 


active aino;

for let r = 0; r < 4; r = r + 1 {
  aino skill, burst;
  bennett skill, burst;
  if !.bennett.mods.favonius-cd {
    bennett attack;
  }
  ineffa skill;
  if .ineffa.burst.ready && .ineffa.energy == .ineffa.energymax {
	  ineffa burst;
  } else {
    ineffa attack:2;
  }
  chasca skill, aim:4;
  chasca aim[bullets=4];
}
wait(82); #wait for chasca dmg before sim ends

#Aino EQ -> Bennett EQ (N1 for Fav) -> Ineffa E Q(if ready) -> Chasca 4C[6 bullets] C[4 bullets]

