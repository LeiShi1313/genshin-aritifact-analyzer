cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="balladofthefjords" refine=1 lvl=90/90;
cyno add set="mh" count=4;
cyno add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622 ; #main
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2979 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="goldentroupe" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="goldentroupe" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #mainstats
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="pamber" refine=5 lvl=90/90;
nahida add set="deepwoodmemories" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999;
energy every interval=480,720 amount=1;

active nahida;
nahida skill;
for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  furina skill, dash, burst;
  nahida burst, skill, charge;
  fischl attack:2, burst;
  cyno skill, burst, attack:4, skill;
  while .fischl.skill.cd {
    if .cyno.skill.ready && .cyno.mods.cyno-a1 {
      cyno skill;
    } else if .cyno.normal == 5 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}
