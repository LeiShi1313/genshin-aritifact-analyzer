flins char lvl=90/90 cons=0 talent=9,9,9;
flins add weapon="favlance" refine=5 lvl=90/90;
flins add set="tf" count=4;
flins add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
flins add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="balladofthefjords" refine=1 lvl=90/90;
ineffa add set="silkenmoonsserenade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="evenstar" refine=1 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187;
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*6 cr=0.0331*7 cd=0.0662*3;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

active ineffa;

for let i=0; i<6; i=i+1 {
  let furina_e = false;

  if !.ineffa.burst.ready {
    ineffa skill;
  } else {
    ineffa burst;
  }

  if .furina.skill.ready {
    furina skill, dash, attack;
    furina_e = true;
  } else {
    if .furina.burst.ready {
      furina burst;
    } else {
      furina attack:2;
    }
  }

  sucrose attack;
  if !.furina.skill.ready && furina_e == true {
    sucrose burst;
  } else if .sucrose.skill.ready {
    sucrose skill, dash;
  }

  if .ineffa.status.ineffa-a4 {
    flins skill, attack, skill, attack, burst;
  } else {
    flins skill, attack, skill, burst;
  }

  flins attack:2, charge;
  flins attack:2, charge;
  flins attack, skill;

  if .flins.burst.ready && .flins.energy == .flins.energymax {
    flins burst, attack;
  } else if .flins.energy > 27 {
    flins attack:4, burst, attack:2;
  } else {
    // prevent really shitty RNG
    flins attack:4, dash, attack:4, burst;
  }

  sucrose attack;
  if .sucrose.skill.ready {
    sucrose skill, dash, attack;
  } else {
    sucrose charge;
  }
}

# Rotation
# Ineffa Q > Furina ED N1 > Sucrose N1 Q  > Flins E N1 E    Q 2[N2C] N1 E {NX Q} > Sucrose N1 (ED N1)/C
# Ineffa E > Furina Q/N2  > Sucrose N1 ED > Flins E N1 E N1 Q 2[N2C] N1 E {NX Q} > Sucrose N1 (ED N1)/C
