# Kuki Nahida Xingqiu Bennett. ~22s Rotation. Kuki Hyperburgeon with C6 Bennett. Kuki uses burst & bkill as available in Bennett's burst while Bennett swaps and skills occasionally.

kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="umbrella" refine=5 lvl=90/90;
#kuki add weapon="ironsting" refine=5 lvl=90/90;
#kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="fopl" count=4;
#kuki add set="gd" count=4;
#kuki add set="tf" count=4;
kuki add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311 ; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favsword" refine=3 lvl=90/90;
#bennett add weapon="xiphos" refine=1 lvl=90/90;
bennett add set="instructor" count=4; bennett add set="gd" count=1;
#bennett add set="gd" count=4;
bennett add stats hp=3571 atk=232 em=187 em=140.25 em=140.25 ; #main
bennett add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.07936 atk=26.464 atk%=0.07936 er=0.08816 em=95.136 cr=0.31776 cd=0.42368; # INS
#bennett add stats hp=3571 atk=232 em=140.25 em=140.25 cr=0.311 ; #main
#bennett add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.07936 atk=26.464 atk%=0.07936 er=0.35264 em=126.848 cr=0.2648 cd=0.10592 ; # INS CR
#bennett add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
#bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # GD


# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

#Rotation
active kuki;
kuki attack, skill;

for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  while !.xq.skill.ready {
    if .nahida.normal > 1 && .stam > 50 {
      nahida charge;
    } else {
      nahida attack;
    }
  }
  
  xingqiu skill, dash, burst, attack;
  
  bennett skill, attack, burst;
  
  kuki attack;
  while .xingqiu.mods.xingqiuburst > 150 {
    switch {
      case .kuki.skill.ready:
        kuki skill;
      case .kuki.burst.ready && .previous-action != .action.skill:
        kuki burst;
      case .bennett.skill.ready && .bennett.swap.ready && .previous-action == .action.charge:
        bennett skill, attack:2;
      case .kuki.normal > 1 && .stam > 25:
        kuki charge;
      default:
        kuki attack;
    }
  }
  
  print("done");
}

