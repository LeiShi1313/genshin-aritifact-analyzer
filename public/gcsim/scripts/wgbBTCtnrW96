ningguang add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesseoblige" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 heal=0.359 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.3641 cd=0.331 ;

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.1986 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active navia;

for let i=0; i<4; i=i+1 {
  if !.bennett.burst.ready {
    bennett skill, dash;
  }
  furina skill, dash;
  if !.furina.burst.ready {
    furina attack;
  }
  furina burst; 
  while !.navia.burst.ready {
    navia attack;
    if.navia.dash.ready {
      navia dash;
    }
  }
  navia burst;
  bennett burst, skill, dash;
  ningguang skill, dash, attack;
  navia skill[hold=1], attack:3, dash, attack:2;
  ningguang burst, walk, skill, dash, attack, charge;
  navia attack, skill, attack:2;
  if .navia.skill.ready {
    navia skill[hold=1];
  } else {
    navia dash;
  }
}