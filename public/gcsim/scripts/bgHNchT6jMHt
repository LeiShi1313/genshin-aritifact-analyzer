# Sethos Chevreuse Fischl Thoma. ~16s Rot. Sethos loses a lvl 1 aimed shot at  the start of the chamber. Sethos does 8N2W N1(last N1 is Phys). Chevreuse builds for damage. Fischl alternates skill/burst.

# Team
sethos char lvl=90/90 cons=6 talent=9,9,9;
#sethos add weapon="hunterspath" refine=1 lvl=90/90;
sethos add weapon="slingshot" refine=5 lvl=90/90;
sethos add set="wt" count=4;
sethos add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
sethos add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.3641 cd=0.331;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="gt" count=4;
#chev add set="scroll" count=4;
chev add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="favlance" refine=3 lvl=90/90;
#thoma add set="scroll" count=4;
thoma add set="no" count=4;
thoma add stats hp=4780 atk=311 er=0.518 em=187 cr=0.311; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.331 cd=0.3972;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

# Combos
fn sethosCombo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack;
}

# Rotation
active sethos;
sethos aim[hold=2];

for let i=0; i<4; i=i+1 {
  thoma skill, attack, burst, attack;
  if !.thoma.mods.favonius-cd {
    thoma attack;
  }

  amy attack;
  if !.amy.skill.ready {
    amy attack, burst;
  } else {
    amy skill;
  }

  # Burst+C4 Combo every rotation
  chev burst, attack, skill[hold=1],
              attack, skill[hold=1],
              attack, skill[hold=1];

  sethos skill; # aim[hold=2]; # High ping only; dodges energy drain
  sethosCombo();
  sethos aim[hold=2];
}
