#c6 Furina Yelan dual carry with Instructor c2 Klee flex.
#Kazuha burst every other rotation.
#Klee can be replaced by other options with largely the same rotation.

yelan char lvl=90/90 cons=6 talent=9,9,9;
yelan add weapon="aqua" refine=1 lvl=90/90;
yelan add set="mh" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=6 talent=9,9,9;
furina add weapon="splendor" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

klee char lvl=90/90 cons=2 talent=9,9,9;
klee add weapon="favcodex" refine=5 lvl=90/90;
klee add set="ins" count=4;
klee add stats hp=3571 atk=232 atk%=0.3495 pyro%=0.3495 cr=0.311; #main
klee add stats def%=0.1042 def=33.06 hp=426.62 hp%=0.8393 atk=27.79 atk%=0.2916 er=0.0926 em=33.30 cr=0.2780 cd=0.5005; #x0.84

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active furina;

let odd = true;
for let i = 0; i < 5; i = i + 1 {
  furina burst, skill, dash, attack;
  kazuha skill, high_plunge;
  if !i {
    yelan skill;
  }
  yelan burst;
  klee attack, skill[bounce=3, mine=8], jump;
  while !.klee.mods.favonius-cd {
    klee attack;
  }
  furina attack, charge, attack:2, charge;
  if odd {
    kazuha attack, burst;
  } else {
    kazuha attack, skill, high_plunge;
  }
  yelan attack, skill, attack:4, skill, attack:4, dash, attack:4, dash, attack;
  odd = !odd;
}
