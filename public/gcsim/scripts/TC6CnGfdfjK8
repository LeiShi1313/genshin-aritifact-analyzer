# Keqing Nahida Xianyun Fischl. ~24s Rot. (TF) Keqing Aggravate plunge. Keqing uses skill 3x, with a stilletto over the Fischl and Fianyun freshing uptime. Sensitive Electro aura, steps are taken to ensure VV. Nahida touches the field once. Hold skill aerial plunge not used. 50% Collisons.

# Team
keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="harbinger" refine=5 lvl=90/90;
#keqing add weapon="wolffang" refine=1 lvl=90/90;
#keqing add weapon="lionsroar" refine=3 lvl=90/90;
keqing add set="tf" count=4;
keqing add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; 
keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # CD; HoD
#keqing add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; 
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # CD; WF
#keqing add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; 
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # CR; LR

nahida char lvl=90/90 cons=0 talent=9,9,9; 
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="scroll" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=99.24 atk%=0.2976 er=0.551 em=118.92 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Keqing Plunge Combo
fn KeqingPlunge() {
  keq jump;
  if .airborne {
    keq low_plunge[collision=rand()>0.5];
  }
}

# Rotation
active fischl;

for let i = 0; i < 4; i = i + 1 {
  fischl attack, skill;
  
  nahida skill;
  if i > 0 && .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst; # no other actions for reliable VV
  } else {
    nahida attack, charge;
  }
  
  xianyun attack, skill, low_plunge, burst; # attack first for VV consistency
  
  keq skill:2;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq skill; # Stiletto over the gap
  
  fischl attack:2, burst; # Must be first to swirl reliably
  
  xianyun attack:2; sleep(20); # for sim warnings
  
  keq skill; # Infuse, then plunge as fast as possible
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq skill, burst, skill, attack, charge;
}

