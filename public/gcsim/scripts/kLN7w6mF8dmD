# Itto Furina Albedo Xianyun. Itto Plunge with Albedo, bookended by skill uses. LNO > MH. 50% Collisions.

# Team
itto char lvl=90/90 cons=0 talent=9,9,9;
itto add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
itto add set="longnightsoath" count=4;
#itto add set="mh" count=4;
itto add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mainstats
itto add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958; # LNO
#itto add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mainstats
#itto add stats def%=0.558 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.0662 cd=0.662; # MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #mainstats
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

albedo char lvl=90/90 cons=0 talent=9,9,9; 
albedo add weapon="cinnabar" refine=5 lvl=90/90;
albedo add set="gt" count=4;
albedo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; #main
albedo add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="ohc" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #mainstats
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.4959 em=39.64 cr=0.3972 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Pickup Crystallize Function
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
    pick_up_crystallize("any");
  }
    
  return _execute_action(char_id, action_id, p);
}

# Rotation
active albedo;

#action list 

for let i = 0; i < 4; i = i + 1 {
  albedo skill;
  if i > 0 {
    albedo attack;
  }
  
  furina skill, dash, attack, burst;

  xianyun skill, low_plunge, attack, burst;
  while !.xianyun.mods.favonius-cd {
    xianyun attack;
  }
  
  itto burst, skill, attack;
  while .xianyun.status.xianyun-airborne-buff {
    itto jump;
    if .airborne {
      itto high_plunge[collision=rand()>0.5];
    }
    if .xianyun.status.xianyun-airborne-buff {
      itto dash;
    }
  }
  itto attack, charge:3, skill;
}

