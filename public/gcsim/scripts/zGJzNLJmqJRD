#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.1324 ; #Er/Hp/Hp; Healer

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # deals burning AoE, enables MH, -SS stacks

# Rotation
active razor; # Serpent Spine stacks
#razor skill, dash; # Not needed

for let i=0; i<4; i=i+1 {
  if .amy.skill.ready && .amy.burst.ready {
    amy skill;
  }
  
  # Skip Q on  first rotation, then use as available 
  nahida skill;
  if i > 0 && .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida attack, charge;
  }
  if .bennett.skill.cd {
    nahida attack, charge;
  }
  
  bennett skill, burst;
  
  amy attack;
  if .amy.burst.ready {
    amy attack:1, burst;
  } else {
    amy skill;
  }
  
  razor skill, dash, attack, burst;
  # Razor Main DPS window 
  while .razor.infusion.bennett-fire-weapon { 
    if .razor.normal > 3 && .razor.skill.ready {
        razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
  bennett skill;

  print("done");
}
