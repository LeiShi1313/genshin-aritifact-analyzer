# Characters
lyney char lvl=90/90 cons=0 talent=9,9,9;
lyney add weapon="songofstillness" refine=5 lvl=90/90;
#lyney add weapon="crescent" refine=5 lvl=90/90; # ~2k dps increase with passive, ~7k less without
lyney add set="mh" count=4;
lyney add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
lyney add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4; # ~2k team dps decrease
furina add stats hp=4780 atk=311 hydro%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.1324;

lynette char lvl=90/90 cons=6 talent=9,9,9; 
lynette add weapon="favsword" refine=3 lvl=90/90;
lynette add set="vv" count=4;
lynette add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
#bennett add set="no" count=4; # ~200 less team dps
#bennett add set="sodp" count=4; # ~300 less team dps
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.3972 cd=0.4634;

# Options
options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,3;
energy every interval=480,720 amount=1;

let weak = 0;
if .lyney.weapon == .keys.weapon.crescent { # hits weakspots when using prototype crescent
  weak = 1;
}

# Actions
active furina;

for let r = 0; r < 5; r = r + 1 {  
  if r { # unnecessary 1st rot
    lyney aim:2;
    lynette skill, attack;
  }
  furina skill, dash, burst; 
  bennett burst, skill;
  if !.element.t0.pyro { # use bennett c6 infusion to apply pyro for lynette vv
    bennett attack;
  }
  lynette attack, skill, burst; # rot 1 does not swirl pyro but will ingame due to weapon swirl not being implemented
  lyney aim[weakspot=weak], aim:2, burst;
  delay(15); # wait for initial burst hitmark
  lyney skill, aim[weakspot=weak], skill;
}

// Lyney vape with Lynette. 1st rotation swirls pyro ingame but not in sim because weapon swirl is not implemented. Lyney 6C and Burst every rotation.
// Furina EDQ > Bennett QE [N1] > Lynette N1EQ > Lyney 3C QE CE 2C > Lynette EN1 > repeat from furina
// [only when no pyro aura]
// thanks to cara for help with lynette strings and stats c: