options swap_delay=12 iteration=100 duration =90;

faru char lvl=90/90 cons=6 talent=9,9,9;
faru add weapon="prototypecrescent" refine=5 lvl=90/90;
faru add set="dpc" count=4;
faru add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faru add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

target lvl=100 resist=0.1 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;


active faru;
#-------------------------------------------

faru aim[weakspot=1];
let timer = f();
while 1 {
  if (f() - timer > 7.5*60) {
    faru aim[weakspot=1];
    timer = f();
  } else if .faru.burst.ready {
    faru burst;
  } else if .faru.skill.ready {
    faru skill;
  } else if .faru.skill.cd > 90 {
    faru aim;
  } else if .faru.skill.cd > 20 {
    faru attack;
  } else {
    wait(1);
  }
}
