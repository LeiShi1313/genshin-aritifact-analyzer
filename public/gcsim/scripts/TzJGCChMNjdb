raidenshogun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

sayu char lvl=90/90 cons=6 talent=9,9,9;
sayu add weapon="favoniusgreatsword" refine=3 lvl=90/90;
sayu add set="viridescentvenerer" count=4;
sayu add stats def%=0.124 def=39.36 hp=5287.88 hp%=0.0992 atk=344.08 atk%=1.0312000000000001 er=0.551 em=118.92 cr=0.642 cd=0.1324;

active furina;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  furina skill, burst, attack;
  raiden skill, attack;
  sayu skill, burst;
  eula skill, attack;
  while !.eula.burst.ready {
    if .eula.skill.ready {
      eula skill;
    } else {
      eula attack;
    }
  }
  eula burst, walk, attack:4, skill[hold=1], attack:4;
  sayu skill,attack;
  eula attack:2;
  raiden burst, attack:4, dash, attack:4, dash, attack:4;
}
