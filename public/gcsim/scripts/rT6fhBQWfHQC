# ----  Default Enemy
options debug=true iteration=1000 mode=sl hitlag=true swap_delay=12;
target lvl=100 resist=.1 hp=1800000000000 pos=0, 2.34 radius=2;

energy every interval=480,720 amount=1;

active raiden;
# ----  Actions List

raiden skill;
for let i = 1; i <=6; i = i + 1 {
  nahida skill, burst;
  if .fischl.skill.ready {
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }
  candace burst, attack, skill, attack;
  nahida attack:2, charge;
  raiden attack:2, charge, attack;
  nahida attack, skill, attack, charge;
  raiden attack, skill, attack, charge;
  candace attack, skill, attack;
  nahida attack;
}
