# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
active mavuika;

for let i = 0; i < 4; i = i + 1 {

  mavuika skill, attack;
  xilonen skill, attack:2;
  furina skill, dash, burst, attack:3;
  mavuika burst, charge:2, dash;
  xilonen skill, attack:2;
  itto burst, skill[travel=0];
  while !.itto.skill.ready {
    if .itto.tags.strStack > 0 {
      itto charge;
    } else {
      itto attack;
    }
  } #manage itto C6 until second ushi
  itto skill[travel=0];
  for let x=0; x < 4; x = x+1 {
  if .itto.tags.strStack > 0 {
      itto charge;
    } else {
      x == 4;
    }
  }
}
