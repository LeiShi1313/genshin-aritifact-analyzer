# Mavuika Citlali Layla Bennett. ~18s Rot. Mavuika double Cryo Melt. Mavuika Q 6[C2D], Q 11C D is -7K DPS. No delays. The Cryo aura is a bit messy, but it works. TTDS > Evenstar Citlali.

# Team - Options listed by DPS
mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.1986 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
#citlali add weapon="evenstar" refine=1 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=237.84 cr=0.0662 cd=0.331; # TTDS
#citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
#citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=158.56 cr=0.2979 cd=0.1324; # Evenstar

layla char lvl=90/90 cons=6 talent=9,9,9;
layla add weapon="harbinger" refine=5 lvl=90/90;
layla add set="totm" count=4;
layla add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cd=0.622;
layla add stats def%=0.124 def=39.36 hp=507.88 hp%=0.5456 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.1986;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

let Mav6C2D = true;

# Rotation
active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika skill;

  bennett skill, attack:2, burst;

  layla burst, skill;

  citlali skill, burst;

  mavuika burst;
  if Mav6C2D == true {
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash; # Bennett Q buff ends after 1st dash hit
    mavuika charge:2, dash;
  } else {
    mavuika charge:11, dash;
  }
}
