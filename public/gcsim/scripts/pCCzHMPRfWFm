options swap_delay=12 iteration=1000;

# Build assumptions
durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=79.28 cr=0.2648 cd=0.662;

ganyu char lvl=90/90 cons=0 talent=9,9,9;
ganyu add weapon="chainbreaker" refine=5 lvl=90/90;
ganyu add set="wt" count=4;
ganyu add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="favcodex" refine=3 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=49.62 atk%=0.2976 er=0.3857 em=39.64 cr=0.3972 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active nicole;
for let i=0; i<6; i=i+1 {
  nicole skill, attack, burst;
  for let j=0; j<3; j=j+1 {
    if!.nicole.mods.favonius-cd {
      nicole attack;
    }
  }
  citlali skill, burst, attack;
  durin skill, attack, burst;
  ganyu skill, aim:5;
  if is_even(i) {
    ganyu burst;
  } else {
    ganyu aim;
  }
}
wait(28); # for the last CA hit
