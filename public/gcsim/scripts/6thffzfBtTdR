options swap_delay=12 iteration=1000;

# Build assumptions
yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="solitude" refine=5 lvl=90/90;
yelan add set="mh" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.2317 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622 ; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.2755 em=39.64 cr=0.2317 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="favcodex" refine=3 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 cr=0.311;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  citlali skill, attack;
  escoffier skill, burst;
  yelan burst, attack, skill;
  yelan attack:4, dash;
  yelan attack:4, dash;
  citlali attack:2, dash, attack;
  yelan attack:4, dash;
  yelan attack:4;
  yelan skill, attack:4, attack:3; # catch her own particles on-field
}

# Furina ED Q > Citlali E N1 > Escoffier EQ > Yelan Q N1 E 2[N4D] > Citlali N2D N1 > Yelan N4D N4 E N4 N3
