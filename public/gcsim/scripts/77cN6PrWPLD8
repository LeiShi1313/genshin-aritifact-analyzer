energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freeze Immune

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  
  esco skill, burst;
  
  faruzan skill, burst;
  
  lanyan skill:2, burst;
  
  faruzan aim:2, skill;
  
  lanyan skill:2, attack, charge;
  
  faruzan aim:2, skill;
}

