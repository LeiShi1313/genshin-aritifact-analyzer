options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active navia; #Serpent Spine
fischl skill; # electro scroll and 1 more crystallize shard to the first navia E
for let i=0; i<4; i=i+1 {
  xilonen burst;
  furina skill, dash, burst;
  xilonen skill, attack:2;
  navia burst;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  xilonen skill, attack:2;
  navia skill[hold=1], attack:3, dash, attack:2;
  if .navia.skill.ready {
    navia skill[hold=1], attack;
  }
}
