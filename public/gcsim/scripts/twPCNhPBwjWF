#Furina, Bennett, (C6) Kaeya, Xiangling quickswap, artifacts follow KQMS. Every unit receives healing from Bennett burst. Reactions can change significantly ingame due to Xiangling's and Kaeya's implementation in sim. Here, Xiangling owns most of the reactions but still has significant unreacted damage. Furina gets some vapes and Kaeya gets few melts. Sim is optimized but not too heavily

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;				

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="ins" count=4;
bennett add stats hp=3571 atk=232 er=0.387 pyro%=0.466 cr=0.232; #main
bennett add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.07936 atk=26.464 atk%=0.15872 er=0.08816 em=31.712 cr=0.2648 cd=0.63552;		

kaeya char lvl=90/90 cons=6 talent=9,9,9;
kaeya add weapon="wolffang" refine=1 lvl=90/90; #finale of the deep loses around 1k dps
kaeya add set="no" count=4;
kaeya add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
kaeya add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="thecatch" refine=5 lvl=90/90;
xiangling add set="eosf" count=4;
xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
xiangling add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;																						
									

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

active furina;
for let i=0; i<4; i=i+1 {
  
  furina skill, dash, burst;
  
  bennett burst, skill;
  
  kaeya skill, burst;
  
  bennett skill;
  
  xiangling burst, skill, dash;
  
  furina attack:2;
  
  bennett attack, skill;
  
  furina attack:2;
  
  kaeya attack:2, skill, attack:2;
  
  bennett attack, skill;
  
  xiangling attack:3;
  
}

#rotation: Furina EDQ > Bennett QE > Kaeya EQ > Bennett E > Xiangling QED > Furina N2 > Bennett N1E > Furina N2 > Kaeya N2EN2 > Bennett N1E > Xiangling N3