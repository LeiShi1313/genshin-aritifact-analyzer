arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
arle add set="fohw" count=5;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; 
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9; 
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; 
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
                                
chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3972 cd=0.331;
                                                                
yanfei char lvl=90/90 cons=6 talent=9,9,9;
yanfei add weapon="ttds" refine=5 lvl=90/90;
yanfei add set="noblesse" count=4;
yanfei add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466 ; #main
yanfei add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.331 cd=0.2648;
                                                                                                                                                                                                                                                        
options swap_delay=12 iteration=1000;                                                                        
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active fischl;
fischl skill; # starting with Electro aura in the first rot for chev passive
for let i = 0; i < 4; i = i + 1 {
  arle skill, attack;
  chevreuse burst, skill[hold=1], attack;
  yanfei skill, attack, burst, attack; # catches chev's and her own particles
  arle charge;    # takes TTDS from yanfei.   Be careful not to use it before 5s E sigil mark
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst; # refresh oz with Q in the first rot, for res shred
  }
  arle attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash;
  arle skill, burst;
}
