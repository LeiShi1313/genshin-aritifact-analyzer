# Sethos Furina Yelan Xilonen. 21s Rot. Sethos Taser. Yelan and Xilonen use E 2x with no attempt made to obtain Electro Scroll buff.

# Team
sethos char lvl=90/90 cons=6 talent=9,9,9;
sethos add weapon="slingshot" refine=5 lvl=90/90;
sethos add set="mh" count=4;
sethos add stats hp=4780 atk=311 em=187 em=187 cd=0.622;
sethos add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.2648 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2979 cd=0.5958;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

fn sethosCombo() {
  while .sethos.mods.sethos-burst {
    if .sethos.skill.ready {
      sethos skill;
    } else if .sethos.normal > 2 {
      sethos walk;
    } else {
      sethos attack;
    }
  }
}

# Rotation
active xilonen;

for let i = 0; i < 4; i = i + 1 {
  xilonen burst;
  # For CD Warning
  if i > 0 {
    xilonen attack;
  }

  furina skill, dash, burst;

  if !.yelan.burst.ready && .yelan.breakthrough {
  yelan aim;
  }
  yelan burst, attack:1;

  xilonen skill, attack:2;

  yelan skill, attack;

  sethos skill, attack, burst;
  sethosCombo();
  while .sethos.energy > 30 {
    sethos aim[hold=2];
    if .sethos.skill.ready {
      sethos skill;
    }
  }

  yelan attack, skill, attack;

  xilonen skill, attack:2;

}
