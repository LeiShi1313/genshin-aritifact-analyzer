mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=39.64 cr=0.1324 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2648 cd=0.662;

diona char lvl=90/90 cons=6 talent=9,9,9;
diona add weapon="favbow" refine=4 lvl=90/90;
diona add set="sodp" count=4;
diona add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311;
diona add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

bennett char lvl=90/90 cons=6 talent=9,9,9 ;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika skill;          # Battery Bennett
  bennett attack, skill;
  diona skill[hold=1], burst;
  bennett burst;
  citlali skill, burst, attack:2;
  # Citlali EQ N1 swap to Mavuika, and putting delay(29); also works
  mavuika burst;
  mavuika charge, dash, attack,
          charge, dash, attack,
          charge, dash, attack,
          charge, dash, attack,
          charge, dash, attack,
          charge, dash, attack;         # Mavuika Q expires before the N1

  mavuika charge:2, charge[final=1], dash;
  if .mavuika.cons == 0 {
    mavuika attack;   # Phys N1
  } else {
    mavuika charge, dash, attack;
  }
}

# C0
# Mavuika E > Bennett E > Diona hE Q > Bennett Q > Citlali EQ N2 > Mavuika Q 6[CD N1] C2FD N1

# C1
# Mavuika E > Bennett E > Diona hE Q > Bennett Q > Citlali EQ N2 > Mavuika Q 6[CD N1] C2FD CD N1
