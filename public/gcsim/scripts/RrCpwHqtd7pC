# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Functions
# Pickup Crystallize
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
    pick_up_crystallize("any");
  }

  return _execute_action(char_id, action_id, p);
}

# Rotation
active columbina;

for let i=0; i<4; i=i+1 {
  if i > 0 && (.columbina.burst.ready && .columbina.energy == .columbina.energymax) {
    columbina skill, attack, burst;
  } else if i > 0 {
    columbina skill, attack;
  } else {
    columbina skill;
  }

  furina skill, dash, burst;


  xq burst, attack, skill, dash, attack;

  noelle skill, attack, burst;
  noelle attack:3, dash;
  noelle attack:3, dash;
  noelle attack:3, dash;
  noelle attack:4;
}
