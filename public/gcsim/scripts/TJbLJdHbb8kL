# Faruzan Durin Bennett Nicole. ~20s Rot, Pseudo APL. Faruzan on-field DPS spends Burst and Hurricane Arrows as available within Bennett burst- no field time is offered to other units within Bennett burst.

# Team - Options listed by DPS
faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="sacbow" refine=5 lvl=90/90;
#faruzan add weapon="vhunt" refine=1 lvl=90/90; # this should be Jade Vista
faruzan add set="vv" count=4;
#faruzan add set="gt" count=4;
#faruzan add set="dpc" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # Sac Bow
#faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
#faruzan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # VH

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*8 em=19.82*2 cr=0.0331*7 cd=0.0662*11;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
#nicole add weapon="ttds" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*8 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*2 cd=0.0662*2; # Oathsworn
#nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
#nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*8 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*2 cd=0.0662*2; # TTDS

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

# Rotation
active faruzan;
faruzan skill;

for let i=0; i<4; i=i+1 {
  if .nicole.burst.ready {
    nicole burst;
  } else {
    nicole attack;
  }
  nicole skill;

  durin skill:2, burst;

  bennett skill, dash, burst;

  # Use Faruzan Huricane Arrows when available, otherwise aimed shot
  while .status.bennettburst || .faruzan.hurricane-count {
    switch {
      case .faruzan.skill.ready && .faruzan.swap.ready && !.faruzan.hurricane-count:
        faruzan skill;
      case .faruzan.burst.ready && .faruzan.swap.ready && .faruzan.energy == .faruzan.energymax:
        faruzan burst;
      case .faruzan.hurricane-count && .faruzan.swap.ready || (.faruzan.hurricane-count && .faruzan.onfield):
        faruzan aim[weakspot=rand()>0.3];
      case .faruzan.skill.ready && .faruzan.swap.ready:
        faruzan skill;
      #case .bennett.skill.ready && .bennett.swap.ready:
      #  bennett skill, dash;
      #case .bennett.attack.ready && .bennett.onfield:
      #  bennett attack;
      case .faruzan.onfield:
        faruzan aim;
      default:
        faruzan attack;
    }
  }
  if !.faruzan.mods.faruzan-e && !.faruzan.skill.cd {
    faruzan skill;
  }
}
