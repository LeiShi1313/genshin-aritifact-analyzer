# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2.6 pos=0,3.0 hp=100000000; # Fischl Triggers minimal HB
#target lvl=100 resist=0.1 radius=2.2 pos=0,2.5 hp=100000000; # Fischl Triggers some HB

# Max Declension Guarantee
fn declensionCombo() {
  switch {
    case .heizou.skill.ready && .heizou.declension == 4:
      heizou skill;
    case .heizou.normal > 1 && .heizou.burst.ready:
      heizou burst;
    case .heizou.normal > 1:
      heizou charge;
    default:
      heizou attack;
  }
}

#Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl skill, attack;
  
  nahida skill, attack, burst;
  
  furina skill, dash, burst;
  
  while .fischl.oz {
    declensionCombo();
  }
  
  fischl attack:2, burst;
  
  while .fischl.skill.cd > 30 {
    declensionCombo();
  }
  
  print("done");
}

