mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="sacrificialjade" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=5;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
mualani add stats def%=0.124 def=39.36 hp=507.88 hp%=0.4464 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.0662 cd=0.662;

candace char lvl=90/90 cons=6 talent=9,9,9;
candace add weapon="favlance" refine=3 lvl=90/90;
candace add set="scroll" count=2;
candace add set="totm" count=2;
candace add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
candace add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="fruit" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.551 em=118.92 cr=0.0662 cd=0.1324;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="scroll" count=5;
xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

options swap_delay=12 iteration=1000;

active candace;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

for let i=0; i<2; i=i+1 {
  candace skill, burst, attack;
  if !.candace.mods.favonius-cd && .candace.weapon == .keys.weapon.favlance {
    candace attack;
  } else {
    wait(8); #catch her own hydro particles on-field
  }
  xiangling burst, skill, dash, attack; # N1 applies Hydro (removing Pryo), Candace C6 also applies Hydro
  sucrose skill, dash, attack;          # swap applies Hydro once again.        Side note; [wait(4) and N1 ED] can double swirl, increasing XL's damage.
  mualani skill;
  mualani_combo();
  mualani burst;
  candace attack:2, skill;              # use some Normal Attacks until Mualani Q hits the enemy, and use Candace E.
  if !.candace.mods.favonius-cd && .candace.weapon == .keys.weapon.favlance{
    candace attack;
  }
  xiangling attack:3;                   # You can also swap this order to be [XL E > Candace E > Sucrose], and just give more ER to XL.
  if !.xiangling.mods.favonius-cd && .xiangling.weapon == .keys.weapon.favlance{
    xiangling attack;
  }
  xiangling skill, dash;
  sucrose skill, dash, burst, attack;   # If you think Sucrose can't get Pyro absorption on her Q, try [Candace E > Sucrose > XL E]
  mualani skill;
  mualani_combo();
}

# Candace EQ N1 > Xiangling Q ED N1 > Sucrose ED   > Mualani E 3[3-stacked bite] Q >
# Candace N2 E  > Xiangling N3 ED   > Sucrose ED Q > Mualani E 3[3-stacked bite]
