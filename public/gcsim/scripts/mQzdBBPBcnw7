# Lyney Furina Lanyan Bennett. ~21s Rotation Lyney Vape. Assumes 50% Headshots with Crescent. Healing Bennett Build. NO is equal to SODP. Song of Stillness is less than 1% worse than Crescent.

# Team - Options Listed by DPS
lyney char lvl=90/90 cons=0 talent=9,9,9;
lyney add weapon="crescent" refine=5 lvl=90/90;
#lyney add weapon="stillness" refine=5 lvl=90/90;
lyney add set="mh" count=4;
lyney add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
lyney add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*10 cd=0.0662*9;

lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="ttds" refine=5 lvl=90/90;
lanyan add set="vv" count=4;
lanyan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
lanyan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="sodp" count=4;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*10 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*6 cr=0.0331*2 cd=0.0662*2;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;

# Protoype Crescent Headshot Conditional
fn lyneyAim() {
  if .lyney.weapon == .keys.weapon.crescent { # Attempts headshots (50%) with Crescent
    lyney aim[hold=2, weakspot=rand()>0.5];
  } else { # Non weakspot opponents
    lyney aim[hold=2];
  }
}

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  bennett burst, skill; # QE over EQ for Scroll consistency
  
  lanyan attack, skill, attack;
  
  lyneyAim();
  lyneyAim();
  if .lyney.burst.ready {
    lyney burst; delay(11); # to avoid canceling his burst without dealing damage
    lyney skill;
  } else {
    lyneyAim();
  }
  lyneyAim();
  lyneyAim();
  lyney skill;
  lyneyAim();
  lyneyAim();
}
