# Rosaria Furina Fischl Mika. ~22s Rotation. Physical Rosaria does N2CD stamina permitting, otherwise does NA spam.

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="cpike" refine=5 lvl=90/90;
rosaria add set="mh" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; # main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Phys
#rosaria add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; # main
#rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ATK

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
#mika add weapon="rightfulreward" refine=5 lvl=90/90;
mika add set="clam" count=4;
#mika add set="no" count=4;
#mika add set="sodp" count=4;
mika add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
mika add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.331 cd=0.1324; # Fav
#mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
#mika add stats def=39.36 def%=0.124 hp=2539.4 hp%=0.496 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.0662 cd=0.1324; # RR

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active fischl;
fischl skill, attack;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  mika burst;

  rosaria skill, burst;

  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }

  mika skill, attack;

  # Skill as Available for Cpike passive
  while .rosaria.mods.mika-c6 {
    if .rosaria.skill.ready {
      rosaria skill;
    } else if .rosaria.normal > 3 && .stam > 43 {
      rosaria charge, dash;
    } else {
      rosaria attack;
    }
  }

# Notation
# Furina EDQ > Mika Q > Rosaria EQ > Fischl N2Q/N1E > Mika EN1
# Rosaria N3CD E 2N3CD N3E N3CD N3CD
}
