bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="ins" count=4;
bennett add stats hp=3571 atk=232 er=0.518 pyro%=0.3495 cr=0.23325 ; #main
bennett add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.07936 atk=26.464 atk%=0.07936 er=0.4408 em=31.712 cr=0.15888 cd=0.10592 ;


options swap_delay=12 iteration=1000;

active yelan;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {

  if i {
    hutao attack:2;
    bennett attack, skill;
  }

  yelan skill, burst, attack;

  if .bennett.burst.ready {
    bennett burst, attack, skill;
  } else {
    bennett skill, attack, burst;
  }

  fischl attack;
  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:1, burst;
  }

  hutao skill,
        attack:2, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:2, charge, jump, attack;

}
hutao burst;
