# Sayu Furina Xiangling Bennett. ~20s Rot. 9 Seconds of rolling. Fav R5 to proc twice in one roll. You may rotate around opponents for additonal Pyronado hits in-game.

# Team 
sayu char lvl=90/90 cons=6 talent=9,9,9;
sayu add weapon="favgs" refine=5 lvl=90/90;
sayu add set="vv" count=4;
sayu add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
sayu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.331 cd=0.7944; # AAC

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="thecatch" refine=5 lvl=90/90;
xiangling add set="emblem" count=4;
xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.4634;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
#bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; 

# Rotation
active furina;

for let i=0; i<4; i=i+1 { 
  furina skill, dash, attack, burst;
  sayu burst;
  bennett burst, skill;
  xiangling burst, skill, dash;
  sayu skill[hold=510];
  bennett skill;
}
