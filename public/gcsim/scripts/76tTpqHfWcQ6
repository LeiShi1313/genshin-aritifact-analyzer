# Eula Furina Ororon Xianyun. ~20s Rot. Eula bursts every other rotation; she fills time with NA on non-burst rotations. OHC > SoDP Xianyun, but bubbles may miss. Ororon uses No over Scroll. 50% Collisions.

# Team - Options listed by DPS
eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
eula add set="lno" count=4;
#eula add set="pf" count=2;eula add set="bsc" count=2;
#eula add set="pf" count=4;
#eula add set="mh" count=4;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Other
#eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.5952 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.1324;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="no" count=4;
#ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
#xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3306 em=79.28 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active eula; # SS Stacks

for let x = 0; x < 4; x = x + 1 {
  furina skill, dash;
  if !.furina.mods.favonius-cd {
    furina attack;
  }
  furina burst;

  xianyun skill, low_plunge, burst;

  eula skill, attack;

  ororon skill, burst; # Better here for Furina ER

  # Minor burst stacking when available
  if .eula.burst.ready && .eula.energy == .eula.energymax  {
    eula burst, walk, attack:1, skill[hold=1];
  } else { # Fill time for Furina skill CD
    eula attack:2, skill[hold=1];
  }
  # Plunge spam after RES shred
  while .eula.status.xianyun-airborne-buff {
    eula jump;
    if .airborne {
      eula high_plunge[collision=rand()>0.5];
    }
    if .eula.status.xianyun-airborne-buff { # swap > dash for final plunge
      eula dash;
    }
  }

}
