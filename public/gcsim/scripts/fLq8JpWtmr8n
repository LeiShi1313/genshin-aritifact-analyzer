chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.1324;


options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=3.5,0;
energy every interval=480,720 amount=1;

active fischl;
for let i = 0; i < 4; i = i + 1 {
  if ( i / 2 ) * 2 == i {
    fischl attack, skill;
  } else {
    fischl attack:2, dash;
  }
  chev burst, skill[hold=1], attack;
  xiangling burst, skill, dash;
  beidou skill, burst, dash;
  fischl attack:2, burst;
  xiangling attack:4;
  chev attack:3;
  if !.chev.mods.favonius-cd {
    chev dash, attack;
  }
  beidou skill, attack:2, jump; # catches her own particles
  xiangling attack:4;
  chev attack:3;
}
