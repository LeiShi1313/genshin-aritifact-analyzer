# Target, Energy and damage taken assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops
hurt every interval=180,300 amount=3500,5500 element=physical; # damage taken assumed every 3-5s

# Rotation assumptions
active dehya;

for let i=0; i<6; i=i+1 {
  dehya skill;
  furina attack, skill, dash, burst;
  bennett burst, skill;
  if .escoffier.burst.ready {
    escoffier skill, burst, attack;
  } else {
    escoffier skill, attack;
  }
  bennett skill;
  dehya burst, attack:10;
  bennett skill;
  dehya skill, attack;
}

# ~21s rotation
# Dehya E > Furina N1 ED Q > Bennett Q E > Escoffier E(Q) N1 > Bennett E > Dehya Q N10 > Bennett E > Dehya E N1