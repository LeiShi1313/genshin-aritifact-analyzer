# Lynette Faruzan Furina Escoffier. ~20s Rot. DPS Lynette double Cryo for Resonance and Rosaria for additional CR to the team. Faruzan refreshes Cryo VV between Xianyun skill. 50/50 Cryo/Anemo DPS distribution.
# Team - Options listed by DPS
lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="finale" refine=5 lvl=90/90;
lynette add set="mh" count=4;
lynette add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90;
faruzan add set="vv" count=4;
#faruzan add set="scroll" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=3 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.3857 em=39.64 cr=0.0993 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active rosaria;

for let i = 0; i < 4; i = i + 1 {
  esco skill, burst;

  rosaria skill, burst;

  faruzan skill, burst;

  lynette burst, skill,
          attack:2, charge,
          attack:2, charge,
          attack:1;

  rosaria skill;

  faruzan skill, aim:1;

  lynette skill, attack:2, charge,
          attack:1, charge,
          attack:1, charge;
}
