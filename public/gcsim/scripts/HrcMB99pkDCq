yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;


arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
arle add set="fohw" count=5;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ;
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28cr=0.3972 cd=0.662;2 ;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662 ;

options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active arle;
arle skill;
for let i=0; i<4; i=i+1 {
  if i {
    yelan attack;
  }
  yelan skill, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack;
  }

  bennett skill, attack, burst, attack;

  hutao skill,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, jump,
        attack:2, charge, dash,
        attack:2, charge, dash, attack;

  arle charge, attack:3, dash,
               attack:4, dash,
               attack:4, skill;

}
