# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

active chiori;

chiori skill:2;

for let i=0; i<4; i=i+1 {
  gorou skill, attack;
  
  furina skill, dash, attack, burst, attack;

  xilonen skill, attack:2;
  
  chiori skill:2;
  
  gorou burst;
  
  chiori attack, burst, attack:2, skill:2;
  
  gorou skill, attack;
  
  xilonen skill, attack:2; pick_up_crystallize("any");
  
  chiori attack:2, skill, attack:3, dash, attack:3, dash, attack:3, skill:2;
}

