mizuki char lvl=90/90 cons=0 talent=9,9,9;
mizuki add weapon="hakushinring" refine=5 lvl=90/90;
mizuki add set="vv" count=4;
mizuki add stats hp=4780 atk=311 em=187 em=187 em=187;
mizuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gd" count=4;
yae add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000 duration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4; 
energy every interval=480,720 amount=1;

active yae;

while true {
  
  if .yae.tags.totems == 0 { # Summon 3 totems if there are none
    yae skill, skill, skill;
    
  } else if !.fischl.oz && .fischl.skill.ready { # Maintain Oz with E or Q
    fischl skill, attack;
    
  } else if !.fischl.oz && .fischl.burst.ready {
    fischl attack:2, burst;
    
  } else if !.debuff.res.t0.nahida-e { # Apply Nahida E if not active
    nahida skill, attack:2;
    
  } else if .nahida.burst.ready { # Nahida Q if available
    nahida burst;
    
  } else if .status.yae_oldest_totem_expiry < 4 * 60 && .yae.burst.ready { # Yae burst as first totem approaches 4 seconds remaining. Not strict timing
    yae burst;
      
  } else if .yae.tags.totems < 3 && .yae.skill.ready { # Resummon Yae totem as one expires
    yae skill, attack;
      
  } else if .mizuki.skill.ready && !.mizuki.status.dreamdrifter-state { # Mizuki E if available and not in dreamstate
    mizuki skill;
    
  } else if .mizuki.burst.ready { # Mizuki burst if available
    mizuki burst;
    
  } else if .mizuki.onfield && .mizuki.status.dreamdrifter-state { # Mizuku idle if in dreamstate
    wait(1);
    
  } else { # Yae NA if nothing else to do. You could Mizuki NA instead
    yae attack;
  }
  
}

