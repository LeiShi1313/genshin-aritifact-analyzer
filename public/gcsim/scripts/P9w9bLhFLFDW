mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="ap" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*7 er=0.0551*2 em=19.82*7 cr=0.0331*12 cd=0.0662*2;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn mualani_combo() {
  mualani skill;
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 { # 3 bites
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

active mavuika; # SS Stacks

for let i=0; i<3; i=i+1 {
  mualani attack;
  xilonen skill, attack:2;
  candace skill, burst;
  mavuika burst, charge, skill, dash; pick_up_crystallize("hydro");
  mualani_combo();
  mualani burst;

  mualani attack;
  xilonen skill, attack:2;
  candace skill, attack, burst;
  mavuika burst, charge, skill, dash; pick_up_crystallize("hydro");
  mualani_combo();
  mualani skill;
}

# ~18s rot
# Mualani N1 > Xilonen E N2 > Candace E (N1) Q > Mavuika Q C tED > Mualani E 3[3-stacked bite] (Q)