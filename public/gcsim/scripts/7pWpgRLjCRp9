options swap_delay=12 iteration=1000;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="finale" refine=5 lvl=90/90;
//skirk add set="finaleofthedeepgalleries" count=4;
skirk add set="mh" count=4;
//skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
//skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.4408 em=39.64 cr=0.1986 cd=0.662;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active chongyun;

for let i=0; i<4; i=i+1 {
  chongyun attack:2, skill;
  furina skill, dash, attack, burst;
  escoffier skill, burst;
  if .skirk.sets.finaleofthedeepgalleries >= 4 {
    skirk skill[hold=1], burst;  # Use her Q ASAP with 4pc galleries set
    wait(48);                    # Wait until the Burst hits end before doing NAs (for 4pc effect on Q)
    skirk attack:5, dash;
    chongyun burst;
  } else {
    skirk skill[hold=1], attack:5, dash, attack:3;
    chongyun burst;
    skirk burst;
  }
  skirk skill,
        attack:5, dash,

        attack:2, charge, dash,

        attack:5, dash,
        attack:5, dash;
}

# Other set
# Chongyun N2E > Furina ED N1 Q > Escoffier EQ > Skirk hE wait N5D > Chongyun Q > Skirk Q tE N5D N2CD 2[N5D]
# Skirk Sig set
# Chongyun N2E > Furina ED N1 Q > Escoffier EQ > Skirk hE Q N5D N3 > Chongyun Q > Skirk   tE N5D N2CD 2[N5D]
