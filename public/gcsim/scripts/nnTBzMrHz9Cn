# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active xinyan; # SS Stacks
raiden skill, attack;

#active raiden;
#raiden skill;

for let i = 0; i < 4; i = i + 1 {
  bennett burst, skill;

  chevreuse burst, skill[hold=1]:3;

  xinyan skill, burst;

  bennett skill;

  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
}
