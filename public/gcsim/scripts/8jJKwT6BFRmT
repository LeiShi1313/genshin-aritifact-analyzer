# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Active
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;

  xingqiu skill, dash, burst, attack;

  arle skill, attack;

  xianyun skill, low_plunge, attack, burst, attack;

  arle charge, attack;
  while .arle.status.xianyun-airborne-buff {
    arle jump;
    if .airborne {
      arle high_plunge[collision=rand()<0.5], attack;
    }
  }

  #if !is_even(i) {
  #  arle burst;
  #}
}
