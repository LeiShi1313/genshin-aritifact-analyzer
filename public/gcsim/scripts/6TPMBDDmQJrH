# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Combo
fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

# Rotation
active furina;

for let r=0; r<3; r=r+1 {
  furina skill, dash, burst;
  
  xq skill, dash, burst, attack;
  
  yelan skill, burst, attack;
  
  clorinde_combo();
  
  yelan attack, skill, attack;
  
  clorinde_combo();
  #clorinde burst;
}

