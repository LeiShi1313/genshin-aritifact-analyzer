bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*8 em=19.82*2 cr=0.0331*7 cd=0.0662*11;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

fn KazuPlunge(){
  kazuha jump;
  if .airborne {
    kazuha high_plunge[collision=rand()>0.5];
  }
  wait(45); # wait for cryo aura
}

active bennett;

for let i=0; i<4; i=i+1 {
  bennett skill, attack:2; # needs to catch particles to have enough energy

  xianyun skill, low_plunge, burst;

  bennett skill, dash, burst;

  citlali skill, burst;

  kazuha skill, high_plunge[collision=1];
  KazuPlunge();
  KazuPlunge();
  KazuPlunge();
  kazuha skill, high_plunge[collision=1];
  wait(45); # wait for cryo aura
  KazuPlunge();
  KazuPlunge();
  kazuha attack:2; # fill time for skill to come back
  kazuha skill, high_plunge[collision=1];

}
