# Freminet Furina Escoffier Mika. ~22s Rot. Physical Freminet Shatter with Mika. Mika and Escoffier burst in alternate rotations.

# Team - Options ordered by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="tidalshadow" refine=5 lvl=90/90;
#freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
freminet add set="mh" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # TS
#freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # SS

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2979 cd=0.331;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favspear" refine=3 lvl=90/90;
mika add set="no" count=4;
#mika add set="ohc" count=4;
#mika add set="sodp" count=4;
mika add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active freminet; # SS Stacks

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  
  esco skill;
  if !is_even(i) {
    esco burst;
  }
  
  if is_even(i) {
    mika burst, attack, skill;
  } else {
    mika attack, skill[hold=1];
  }
  
  # EQ N2E 2[EN2E N1] E N2 E
  freminet skill, burst,
           attack:2, skill, skill,
           attack:2, skill, attack:2, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
           attack:2, skill, attack:2, skill,
           attack:3, skill;
}
