# Kokomi Nahida Raiden Thoma. ~20s Rot. Kokomi HyperBurgeon. Kokomi's skill heals over the setup period and is freshed with her burst. Kokomi stays on field until her burst expires before Nahida attempts to trigger fav. Burstless Nahida.

# Team - Options listed by DPS
kokomi char lvl=90/90 cons=0 talent=9,9,9;
kokomi add weapon="boundlessblue" refine=5 lvl=90/90;
#kokomi add weapon="pamber" refine=5 lvl=90/90;
kokomi add set="ohc" count=4;
kokomi add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 heal=0.359; #main
kokomi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.2976 er=0.551 em=39.64 cr=0.0662 cd=0.1324; # BotBB
#kokomi add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 heal=0.359; #main
#kokomi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.1984 er=0.3857 em=138.74 cr=0.0662 cd=0.1324; # PAmber

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="favcodex" refine=3 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.331 cd=0.7282;

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="dragonsbane" refine=3 lvl=90/90;
raiden add set="fopl" count=4;
raiden add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.3641 cd=0.331;

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="kitain" refine=5 lvl=90/90;
thoma add set="fopl" count=4;
#thoma add set="gd" count=4;
thoma add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.551 em=158.56 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # 2nd T

# Rotation
active kokomi;

for let i = 0; i < 4; i = i + 1 {
  kokomi skill;

  raiden skill, attack;

  # No burst, the trigger is off-field
  nahida skill, attack, charge;

  thoma skill, attack:1, burst;

  kokomi attack, burst;
  while .status.kokomiburst {
    if .kokomi.normal > 2 {
      kokomi walk;
    } else {
      kokomi attack;
    }
  }

  # Just attempting to trigger Fav
  nahida attack:2, charge;

  while .kokomi.skill.cd {
    if .kokomi.normal > 2 {
      kokomi walk;
    } else {
      kokomi attack;
    }
  }
  print("done");
}
