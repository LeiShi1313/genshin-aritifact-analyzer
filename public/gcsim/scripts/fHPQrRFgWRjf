# Lanyan Nahida Fischl Yelan. ~25s Rot. Lanyan Salad with Lanyan triggering hyperbloom with Swirl. 2E Yelan; Fischl skill and burst every rotation. Lanyan uses burst first, then spends skill off CD while weaving normal attacks.

# Team- Options listsed by DPS
lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="hakushin" refine=5 lvl=90/90;
#lanyan add weapon="sacfrags" refine=5 lvl=90/90;
#lanyan add weapon="evenstar" refine=1 lvl=90/90;
#lanyan add weapon="widsith" refine=3 lvl=90/90;
#lanyan add weapon="magicguide" refine=5 lvl=90/90;
lanyan add set="vv" count=4;
lanyan add stats hp=4780 atk=311 em=187 em=187 em=187; #main
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; # main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=99.1 cr=0.2979 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
#yelan add set="scroll" count=4;
#yelan add set="no" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; # main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets - Hyperbloom Ownership varies with size
target lvl=100 resist=0.1 radius=2.6 pos=0,3.0 hp=100000000; # Fischl Triggers minimal HB
#target lvl=100 resist=0.1 radius=2.2 pos=0,2.5 hp=100000000; # Fischl Triggers some HB

# Lanyan Q for Grouping, then Lanyan E off CD with N1 weaving; Sac & Con Compatible
fn lanyanDrivingCombo() {
  switch {
    case .lanyan.normal > 1 && .lanyan.burst.ready && .lanyan.energy == .lanyan.energymax:
      lanyan burst;
    case .lanyan.normal > 1 && .lanyan.skill.ready:
      set_player_pos(0, 0); # toward
      lanyan skill; set_player_pos(0, -3); # away
      lanyan skill; 
    case .lanyan.normal > 1 && .previous-action == .action.skill && .stam > 18:
      lanyan dash; set_player_pos(0, 0); # toward
    case .lanyan.normal > 2 && .stam > 18:
      lanyan dash; set_player_pos(0, 0); # toward
    default:
      lanyan attack;
  }
}

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  
  nahida skill, attack, burst;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  while .fischl.oz {
    lanyanDrivingCombo();
  }
  
  fischl attack:2, burst;
  
  yelan attack, skill, attack;
  
  while .fischl.skill.cd > 30 {
    lanyanDrivingCombo();
  }
}
