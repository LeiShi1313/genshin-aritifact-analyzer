options iteration=1000 swap_delay=12;

# Build assumptions
dehya char lvl=90/90 cons=6 talent=9,9,9;
dehya add weapon="uomms" refine=5 lvl=90/90;
dehya add set="vg" count=4;
dehya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main stats: ATK% Pyro% CD
dehya add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gift" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # Main stats: ATK% Electro% CR
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main stats: ATK% Pyro% CD
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main stats: ER HP% HP%
chevreuse add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*6;

# Target, Energy and damage taken assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops
hurt every interval=180,300 amount=3500,5500 element=physical; # damage taken assumed every 3-5s

# Rotation assumptions
active fischl;

fischl skill;
for let i=0; i<4; i=i+1 {
  dehya attack, skill;
  chevreuse burst, skill[hold=1]:3;
  if !i {
    durin skill, burst, attack;
  } else {
    durin skill:2, burst;
  }
  if .fischl.skill.ready {
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }
  dehya burst, attack:15;
  durin attack, charge, dash;
}

# 20s rotation
# (Fischl E) > Dehya N1 E > Chevreuse Q 3[hE] > Durin EEQ > Fischl E N1 / N2 Q > Dehya Q N15 > Durin N1CD
