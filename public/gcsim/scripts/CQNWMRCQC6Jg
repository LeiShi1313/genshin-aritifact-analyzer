shenhe char lvl=90/90 cons=6 talent=9,9,9;
shenhe add weapon="favoniuslance" refine=5 lvl=90/90;
shenhe add set="noblesseoblige" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
shenhe add stats def%=0.1240 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3972 er=0.4408 em=39.64 cr=0.331 cd=0.1324; # sub

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active furina;
for let i = 0; i < 5; i = i + 1{
  furina skill, dash, burst, attack:2;
  kazuha burst;
  shenhe skill, burst;
  kazuha skill, high_plunge;
  ayaka dash, attack:2, skill, attack:2, charge, burst;
  kazuha skill[hold=1], high_plunge, attack;
  shenhe skill;
  # shenhe C1
  if .shenhe.skill.ready {
    shenhe skill;
  } else {
    shenhe attack;
  }
  ayaka dash, attack:2, skill, attack:2, charge;
  print("rotation done");
}


