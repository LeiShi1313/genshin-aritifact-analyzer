# Gaming Citlali Chevreuse Xilonen. ~19s Rot. Gaming Melt Plunge with 7 plunges, 6 melted. Gaming juggles Man Chai, using burst into skill + plunge and waiting on the ground before catching Man Chai mid descent. Chevreuse provides Pyro Buffing without circle impact. Unmelted final plunge is delayed for Gaming's particle ICD. No burst Xilonen. Option for 7 melted plunges included.

# Team - Options listed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.3972 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
#citlali add weapon="evenstar" refine=1 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.331;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
#chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="ap" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Adjacent

let SixthPlungeBuffed = false;
// True uses timing to allow Bennett to buff the 6th plunge. Given RNG, This
// is difficult in practice, especially when reducing delays other than the 5th
// plunge. Citlali swaps in to reapply Cryo, then Gaming swaps back in plunge
// again,  his particle ICD having expired. ER reqs are fairly similar in both.
// Citali prefers TTDS in both rots, though the realistic rotation is <20s

# Rotation
active gaming; #SS Stacks
#gaming skill, low_plunge, dash; # Pyro Scroll 1st Rot

for let i=0; i<4; i=i+1 {
  chev skill[hold=1], burst;

  xilonen skill, attack:2; pick_up_crystallize("pyro");

  citlali skill, burst;

  if SixthPlungeBuffed == false {
    gaming burst;
    let plungeCount = 0;
    for let j = 0; j < 6; j = j + 1 {
      sleep(45); # Cacth Manchai during descent
      gaming skill, high_plunge;
      plungeCount = plungeCount + 1; print(plungeCount);
    }
    sleep(30); # needed for particle ICD.
    gaming skill, high_plunge; print(plungeCount + 1); # Unmelted
  } else {
    gaming burst;
    let plungeCount = 0;
    for let j = 0; j < 5; j = j + 1 {
      sleep(45); # Cacth Manchai during descent
      gaming skill, high_plunge;
      plungeCount = plungeCount + 1; print(plungeCount);
    }
    sleep(30); # Cacth Manchai during descent
    gaming skill, high_plunge; # Bennett expires
    plungeCount = plungeCount + 1; print(plungeCount);

    citlali attack:2;

    gaming skill, high_plunge;
    plungeCount = plungeCount + 1; print(plungeCount); # Melted
  }
}
