options swap_delay=12 iteration=1000;

# Build assumptions
xiao char lvl=90/90 cons=6 talent=10,10,10;
xiao add weapon="homa" refine=5 lvl=90/90;
xiao add set="mh" count=4;
xiao add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
xiao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

faruzan char lvl=90/90 cons=6 talent=10,10,10;
faruzan add weapon="favbow" refine=5 lvl=90/90;
faruzan add set="scroll" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311;
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="favsword" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

venti char lvl=90/90 cons=6 talent=10,10,10;
venti add weapon="elegy" refine=5 lvl=90/90;
venti add set="no" count=4;
venti add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
venti add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Target and Energy assumptions

// Assuming only first target get hit by Xiao E
// target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=999999999;
// target lvl=100 resist=0.1 radius=1 pos=0,3.5 hp=999999999;

// Both of them get hit by Xiao E
target lvl=100 resist=0.1 radius=0.5 pos=0,0.9 hp=999999999;
target lvl=100 resist=0.1 radius=0.5 pos=0,2.0 hp=999999999;
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active faruzan;

for let i=0; i<4; i=i+1 {
  faruzan burst;
  for let j=0; j<2; j=j+1 {
    if !.faruzan.mods.favonius-cd {
      faruzan attack;
    }
  }
  furina skill, dash, burst, attack;
  venti skill, burst;
  xiao skill:2, burst;

  xiao jump, low_plunge[collision=rand()>0.5], skill:3;
  xiao jump, low_plunge[collision=rand()>0.5], skill:3;
  xiao jump, low_plunge[collision=rand()>0.5], skill:4;

  xiao jump, high_plunge[collision=rand()>0.5], skill:4;
  xiao jump, high_plunge[collision=rand()>0.5], skill:4;

}
