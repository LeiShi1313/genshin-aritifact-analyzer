
chevreuse char lvl=90/90 cons=6 talent=9,9,9; 
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="scroll" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 cr=0.311; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; #subs								

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

beidou char lvl=90/90 cons=6 talent=9,9,9;
beidou add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
beidou add set="no" count=4;
beidou add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
beidou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

yanfei char lvl=90/90 cons=6 talent=9,9,9;
yanfei add weapon="evenstar" refine=1 lvl=90/90;
yanfei add set="gd" count=4;
yanfei add stats hp=4780 atk=311 em=187 em=187 em=187;
yanfei add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.2204 em=118.92 cr=0.0662 cd=0.3972;

options iteration=100 swap_delay=12;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.5;
energy every interval=480,720 amount=1;


fn rand_counter() {
  let counter = rand();
  if counter > 0.6 {
    counter = 2;
  } else {
    counter = 0;
  }
  return counter;
}

active beidou; #SS stacks 
for let r = 0; r < 4; r = r + 1 {
  fischl attack, skill;
  chev burst, skill[hold=1];
  beidou skill[counter=rand_counter()], burst;
  yanfei skill, charge, 
         attack:2, burst,
         attack:2, charge,
         attack:2, charge;
  fischl attack:2, burst;
  chev skill[hold=1], attack:2;
  beidou skill[counter=rand_counter()];
  yanfei skill, charge,
         attack:2, charge, 
         attack:2, charge,
         attack:2, charge,
         attack:2, charge,
         attack:2, charge;
  
}
