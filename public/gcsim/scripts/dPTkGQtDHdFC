# Lisa Chevreuse Fischl Xiangling. ~25s Rot. Lisa on-field with Xiangling Overload. Constant Electro uptime from Lisa & Fischl allows Xiangling, who uses skill twice per rotation, to achive high Overload DPS.

# Team - Options listed by DPS
lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="flowingpurity" refine=5 lvl=90/90;
#lisa add weapon="widsith" refine=3 lvl=90/90;
lisa add set="fohw" count=4;
#lisa add set="ts" count=4;
lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.4634;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="kitain" refine=5 lvl=90/90;
#xiangling add weapon="catch" refine=5 lvl=90/90;
xiangling add set="gd" count=4;
#xiangling add set="scroll" count=4;
xiangling add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1102 em=118.92 cr=0.3972 cd=0.4634; # Kitain
#xiangling add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=118.92 cr=0.331 cd=0.4634; # Catch

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active lisa;
lisa attack;

for let i = 0; i < 4; i = i + 1 {
  chevreuse burst, skill[hold=1]:2;

  xl burst, skill, dash;

  fischl attack, skill;

  lisa attack, burst, skill[hold=1];
  lisa attack:1, charge;
  lisa attack:1, charge;
  lisa attack:2, charge;

  xl attack, skill;

  fischl attack:2, burst;

  lisa attack:2, charge;
  lisa attack:2, charge;
  lisa attack:1, charge;
}
