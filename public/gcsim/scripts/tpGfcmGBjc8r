dori add set="tf" count=4; # Higher Overload Damage
#dori add set="ur" count=4; # General
dori add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; #Em/El/Cd; SS
