#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.1324 ; # Heals

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # deals burning AoE, -SS stacks

# Rotation
active dori; # SS Stacks

fischl attack, skill;

for let i=0; i<4; i=i+1 {
  # Forego burst if energy deficient
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  # Fill time
  if i > 0 {
    bennett attack:1, charge;
  }
  bennett skill, burst;

  # Use burst over skill
  amy attack;
  if .amy.burst.ready {
    amy attack, burst; # Easy to catch Sapwood leaf with phased movement
  } else {
    amy skill;
  }

  while .dori.mods.bennett-field || .status.bennettburst {
    switch {
      case .dori.skill.ready:
        dori skill;
      case .dori.burst.ready:
        dori burst;
      case .dori.normal > 2 && .dori.dash.ready && .stam > 18:
        dori dash;
      default:
        dori attack;
    }
  }

  bennett skill, attack; # clear Electro

  print("done");
}
