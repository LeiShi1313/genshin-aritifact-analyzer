# Bennett Emilie Fischl Xiangling. ~20s Rot. Bennett on-field to generates particles, he funnels to Xiangling at the start. Emilie does not catch Bennetts buff. Fischl alternates skill and burst.

# Options ordered by DPS
bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
#bennett add weapon="wolffang" refine=1 lvl=90/90;
bennett add set="no" count=4;
#bennett add set="ur" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ATK/CD
#bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ATK/CD

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="vhunt" refine=1 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
#fischl add set="ur" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # Other
#fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # VH

xiangling char lvl=90/90 cons=6 talent=9,9,9; 
xiangling add weapon="catch" refine=5 lvl=90/90;
#xiangling add weapon="deathmatch" refine=1 lvl=90/90;
xiangling add set="emblem" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # Catch
#xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622; #main
#xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972; # DM

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active amy;
amy skill;

for let i=0; i<4; i=i+1 {
  if i > 0 && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  
  #if .bennett.skill.ready {
  #  bennett skill;
  #}
  bennett burst;
  if .bennett.skill.ready {
    bennett skill;
  }
  
  xiangling burst, skill, dash;
  
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  
  bennett attack:2, skill;
  #bennett skill;
  while .fischl.oz {
    if .bennett.skill.ready && .bennett.swap.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  
}
