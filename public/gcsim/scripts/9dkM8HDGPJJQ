options swap_delay=12 iteration=100;

# Build assumptions
ifa char lvl=90/90 cons=6 talent=9,9,9;
ifa add weapon="widsith" refine=5 lvl=90/90;
ifa add set="vv" count=4;
ifa add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311;
ifa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;


ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="gd" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="rainbowserpent" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
ororon add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="sms" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*6;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active ineffa;
for let i=0; i<4; i=i+1 {
  ineffa skill;
  if i && .ineffa.burst.ready {
    ineffa burst;
  } else {
    ineffa attack;
  }

  if is_even(i){
    furina skill, dash; #, attack, burst;
  } else {
    furina burst;
  }

  ororon skill, burst, attack;

  if .ifa.burst.ready {
    ifa burst;
  }
  ifa attack, skill;
  while .ifa.nightsoul.points > 8 {
    ifa charge;
  }
  if .ifa.burst.ready {
    ifa burst, attack;
  } else {
    ifa attack;
  }
}
