options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
active shenhe;
for let i=0; i<4; i=i+1 {
  shenhe attack:2, skill[hold=1], burst;
  if !.shenhe.mods.favonius-cd {
    shenhe attack;
  }
  bennett skill, burst;
  jean skill, burst, attack;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  } else {
    #do nothing
  }
  jean attack, skill;
  if !.jean.mods.favonius-cd {
    jean attack;
  }
}
