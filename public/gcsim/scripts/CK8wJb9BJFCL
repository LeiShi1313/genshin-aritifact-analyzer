hutao char lvl=90/90 cons=1 talent=9,9,9 +params=[start_hp=1];
hutao add weapon="ballad" refine=1 lvl=90/90;
hutao add set="sr" count=4;
hutao add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 cd=0.622 ; #main
hutao add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
fischl add set="sms" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favoniuscodex" refine=5 lvl=90/90;
mona add set="cg" count=4;
mona add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*8 em=19.82*2 cr=0.0331*10 cd=0.0662*8;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="totm" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*3 cr=0.0331*7 cd=0.0662*10;

options iteration=100 swap_delay=12;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=21370000000;

# Rotation
active ineffa;

for let i=0; i<5; i=i+1 {
  if i > 0 && .ineffa.burst.ready {
    ineffa skill, burst;
  } else {
    ineffa skill, attack;
  }
  mona burst, attack;
  if is_even(i) {
    fischl attack:2, burst;
  } else {
    fischl skill, attack;
  }

  mona attack, skill, attack;
  hutao skill,
        attack:1, charge, dash,
        attack:1, charge, dash,
        attack:1, charge, jump,
        attack:1, charge, dash,
        attack:1, charge, dash,
        attack:1, charge, jump,
        attack:1, charge, dash,
        attack:1, charge, dash,
        attack:1, charge, jump,
        attack:2, charge, dash,
        attack:2, charge, dash;
}
