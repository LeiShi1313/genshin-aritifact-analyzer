chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="chainbreaker" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mavuika add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

ganyu char lvl=90/90 cons=0 talent=9,9,9;
ganyu add weapon="favoniuswarbow" refine=4 lvl=90/90;
ganyu add set="no" count=4;
ganyu add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
ganyu add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*7 er=0.0551*6 em=19.82*2 cr=0.0331*10 cd=0.0662*5;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=2;
bennett add set="eosf" count=2;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*9 cd=0.0662*12;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active mavuika; # SS Stacks

for let i=0; i<4; i=i+1 {
  ganyu skill, attack;
  if i {
    ganyu attack:2;
  }
  ganyu burst;
  bennett burst;
  mavuika burst, charge, skill, dash;
  chasca skill, aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
  bennett skill;
}

# ~20s rotations
# Ganyu E NX Q > Bennett Q > Mavuika Q C tED > Chasca E 4[C] Q/C_4b > Bennett E