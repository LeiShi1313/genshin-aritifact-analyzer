chiori add set="goldentroupe" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mainstats
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;


yelan char lvl=90/90 cons=0 talent=9,9,9 ; 
yelan add weapon="favoniuswarbow" refine=3 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

gorou char lvl=90/90 cons=6 talent=9,9,9;
gorou add weapon="favoniuswarbow" refine=3 lvl=90/90;
gorou add set="no" count=4;
gorou add set="huskofopulentdreams" count=1;
gorou add stats hp=4780 atk=311 er=0.518 geo%=0.466 cr=0.311; #mainstats
gorou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

zhongli char lvl=90/90 cons=0 talent=9,9,9; 
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311 ; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;


target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active zhongli;
for let x=0; x<4; x=x+1 {
  zhongli skill[hold=1], attack;
  chiori skill:2;
  yelan burst,attack,skill,attack:4;
  gorou skill,burst;
  if .chiori.burst.ready {
    chiori burst;
  } else {
    chiori attack:3;
  }
  chiori attack;
  yelan attack:3;
  chiori attack:4;
  yelan skill, attack:2;
  gorou attack, skill, attack:2;
  chiori attack:4;
}

