nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*4;


options swap_delay=12 iteration=100;
energy every interval=480,720 amount=1;
target lvl=100 resist=.1 radius=3 pos=0,3.4 hp=4000000000;

active emilie;
for let i = 0; i < 4; i = i + 1 {
  if !is_even(i) {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  nicole skill, burst;
  mona skill, attack;
  durin skill, skill, burst;
  mona swap; delay(16);
  mona burst;
  mona charge;
  mona charge;
  mona charge; delay(16);
  mona charge; delay(6);
  mona charge; delay(11);
}
