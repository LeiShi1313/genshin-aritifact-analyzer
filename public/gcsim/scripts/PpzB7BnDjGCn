# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active xilonen;

for let i=0; i<4; i=i+1 {
  xilonen burst;
  
	furina skill, dash, burst;
	
	xq skill, dash, burst, attack;
	
	xilonen skill, attack:2;
	
	candace skill, attack, burst, attack;
	
	#xq attack;
	while .candace.mods.candace-q {
	#while .xq.infusion.candace-q-infuse {
	  if .xq.normal > 4 {
	    xq dash;
	  } else {
	    xq attack;
	  }
	}
	
	xilonen skill, attack:2;
	
	print("done");
}
