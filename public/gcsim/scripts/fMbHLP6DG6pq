options swap_delay=12 iteration=1000;

wrio char lvl=90/90 cons=0 talent=9,9,9;
wrio add weapon="widsith" refine=5 lvl=90/90;
wrio add set="mh" count=4;
wrio add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
wrio add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*9 er=0.0551*2 em=19.82*2 cr=0.0331*9 cd=0.0662*8;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="cinnabar" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #main
chiori add stats def%=0.062*4 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

rosaria char lvl=90/90 cons=0 talent=9,9,9;
rosaria add weapon="favoniuslance" refine=5 lvl=90/90;
rosaria add set="ap" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.062*4 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active wrio;

wrio attack;
for let i=0; i<4; i=i+1 {
  xilonen skill, attack:2;

  chiori skill;
  pick_up_crystallize("cryo");
  chiori skill;

  rosaria skill;
  pick_up_crystallize("cryo");
  rosaria burst;

  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge;
  if .wrio.burst.ready {
    wrio burst;
  } else {
    wrio dash, attack:3, charge, dash;
  }
}

# ~16s rotation
# (Wriothesley N1) > Xilonen E N2 > Chiori 2[E] > Rosaria EQ > Wriothesley E 4[N3CJ] > Wriothesley N3C Q / 2[N3CD]
