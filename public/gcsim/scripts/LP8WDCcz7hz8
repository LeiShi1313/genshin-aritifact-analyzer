# Gaming Columbina Ineffa Xianyun. ~20 Rot. Gaming Lunar Overvape. Gaming juggles Man Chai, waiting on the ground between 7 plunges and catching him while descending. Ineffa's light electro application allows 6/7 Vaped plunges per rotation. Xianyun refreshing VV just after Gaming's field time isn't a DPS gain.

# Team - Options listed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
#gaming add set="notsu" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # CW
#gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
#gaming add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*10 er=0.0551*4 em=19.82*2 cr=0.0331*4 cd=0.0662*10; # NotSU

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="sms" count=4;
#columbina add set="aubade" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*9 cr=0.0331*7 cd=0.0662*10;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="sms" count=4;
#xianyun add set="sodp" count=4; # Shite
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*8 atk%=0.0496*8 er=0.0551*10 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active gaming; # SS Stacks

for let i=0; i<4; i=i+1 {
  if i > 0  && .ineffa.burst.ready {
    ineffa skill, burst;
  } else {
    ineffa skill;
  }

  if i > 0 && .columbina.burst.ready {
    columbina skill, burst;
  } else {
    columbina skill, attack:2;
  }

  xianyun skill, low_plunge;
  # For C1
  if !.xianyun.burst.ready && .xianyun.skill.ready {
    xianyun skill, low_plunge;
  }
  xianyun burst;

  gaming burst;
  for let j = 0; j < 6; j = j + 1 {
    sleep(45);
    gaming skill, high_plunge;
  }
  sleep(35); # For Energy ICD
  gaming skill, high_plunge;

  #xianyun attack:2;
}
