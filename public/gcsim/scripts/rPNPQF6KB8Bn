raiden char lvl=90/90 cons=2 talent=9,9,9;
raiden add weapon="engulfing" refine=1 lvl=90/90;
raiden add set="eosf" count=4;
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; # mainstats for kqmc artifact optimization
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="blacktassel" refine=3 lvl=90/90;
chevreuse add set="eosf" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; # mainstats for kqmc artifact optimization
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="sapwood" refine=3 lvl=90/90;
bennett add set="noblesseoblige" count=4;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; # mainstats for kqmc artifact optimization
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=218.02 cr=0.3641 cd=0.2648;

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="sacrificialbow" refine=3 lvl=90/90;
sara add set="eosf" count=4;
sara add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; # mainstats for kqmc artifact optimization
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1653 em=39.64 cr=0.331 cd=0.662;

# My fine build => https://gcsim.app/sh/z7FfJWBdQMr7

options swap_delay=12 iteration=500;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.5;
energy every interval=480,720 amount=1;

active raiden;
raiden skill;
let r = 1;
while r <= 5 {
  while .bennett.skill.cd {
    bennett attack;
  }
  if r > 1 {
    sara skill, aim;
  }
  bennett burst;
  chevreuse skill[hold=1], burst;
  if .sara.skill.ready { sara skill, aim; }
  sara burst;
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  bennett skill;

  print("Rotation ", r, " done");
  r = r + 1;
}
