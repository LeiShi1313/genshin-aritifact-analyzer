# Sayu Furina Yae Fischl. ~25s Rot. Sayu Taser with a max duration roll. Yae bursts every rotation. 

# Team - Options listed by DPS
sayu char lvl=90/90 cons=6 talent=9,9,9;
sayu add weapon="favgs" refine=3 lvl=90/90;
sayu add set="vv" count=4;
sayu add stats hp=4780 atk=311 em=187 em=187 em=187;
sayu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=118.92 cr=0.3972 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="flowingpurity" refine=5 lvl=90/90;
#yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="hakushin" refine=5 lvl=90/90;
yae add set="fohw" count=4;
#yae add set="gt" count=4;
#yae add set="tom" count=4;
#yae add set="ts" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.2204 em=39.64 cr=0.2317 cd=0.7944; # Purity
#yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.2204 em=39.64 cr=0.331 cd=0.662; # Widsith

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active yae;

for let i=0; i<4; i=i+1 {
  yae skill:3;
  
  fischl attack, skill;
  
  furina skill, dash, burst;
  
  sayu burst;
  
  yae attack, charge,
      burst, skill:3;
  
  fischl attack:2, burst;
  
  sayu skill[hold=600];
  
  print("done");
}
