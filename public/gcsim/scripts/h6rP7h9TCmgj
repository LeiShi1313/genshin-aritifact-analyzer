# Xinyan Furina Fischl Mika. ~20s Rot. Physan does NA so her CA isn't used.

# Team
xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="uomms" refine=5 lvl=90/90;
xinyan add set="mh" count=4;
xinyan add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active fischl;
fischl skill, attack;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;

  mika burst, attack, skill;

  fischl attack:1;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }

  while !.furina.skill.ready {
    if .xinyan.skill.ready {
      xinyan skill;
    } else if .xinyan.burst.ready {
      xinyan burst;
    } else if .xinyan.normal == 3 && .stam > 18 {
      xinyan dash;
    } else if .xinyan.normal > 4 && .stam > 18 {
      xinyan dash;
    } else {
      xinyan attack;
    }
  }

}

# Furina EdN1Q > Mika QN1E > Fischl E N1 / N2 Q > xinyan E Q [Xinyan combo]
