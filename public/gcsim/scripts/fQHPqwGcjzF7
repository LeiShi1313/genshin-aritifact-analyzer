options swap_delay=12 iteration=1000;

# Build assumptions
clorinde char lvl=90/90 cons=6 talent=10,10,10;
clorinde add weapon="absolution" refine=5 lvl=90/90;
clorinde add set="fragmentofharmonicwhimsy" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="favsword" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

xilonen char lvl=90/90 cons=6 talent=10,10,10;
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

chiori char lvl=90/90 cons=6 talent=10,10,10;
chiori add weapon="uraku" refine=5 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active furina;

for let i=0; i<3; i=i+1 {
  if !i {   # 1st rot
    furina skill, dash, burst, attack;
    xilonen skill, attack:2;        pick_up_crystallize("any");
  } else {  # 2nd rot onwards
    xilonen skill, attack:2;        pick_up_crystallize("any");
    furina skill, dash, burst, attack:2;
  }
  chiori skill:2;                   pick_up_crystallize("any");
  clorinde_combo();
  chiori skill:2;                   pick_up_crystallize("any");
  clorinde burst;

  xilonen skill, attack:2;          pick_up_crystallize("any");
  furina burst, attack;
  chiori skill:2;                   pick_up_crystallize("any");
  clorinde_combo();
  clorinde burst;
}
