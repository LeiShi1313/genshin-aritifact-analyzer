navia char lvl=90/90 cons=0 talent=9,10,9;
navia add weapon="verdict" lvl=90/90 refine=1;
navia add set="nighttimewhispersintheechoingwoods" count=4;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cd=0.622;
navia add stats hp%=0.1108 atk=52.52 atk%=0.2566 def=60.18 def%=0.4082 cr=0.42380002 cd=0.47399998 er=0.1101;

xianyun char lvl=90/90 cons=1 talent=9,9,9;
xianyun add weapon="oathsworneye" lvl=90/90 refine=5;
xianyun add set="viridescentvenerer" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311;
xianyun add stats hp=1045.63 hp%=0.0408 atk=31.130001 atk%=0.2098 def=62.5 cr=0.24880001 cd=0.52849996 em=20.98 er=0.62160003;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="thestringless" lvl=90/90 refine=5;
fischl add set="goldentroupe" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats hp%=0.18650001 atk=66.14 atk%=0.087400004 def=62.5 def%=0.1093 cr=0.24499999 cd=0.8858 em=86.25 er=0.15540001;

furina char lvl=90/90 cons=0 talent=9,10,10;
furina add weapon="festeringdesire" lvl=90/90 refine=5;
furina add set="goldentroupe" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
furina add stats hp=866.38 hp%=0.5188 atk%=0.1923 def=16.2 cr=0.2333 cd=0.73039997 em=44.29 er=0.1749;

options iteration=1000 swap_delay=12;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=9999999;

active fischl;
for {
	switch {
		case .navia.mods.navia-a1-dmg && .navia.swap.ready && .navia.mods.xianyun-airborne-buff > 120:
			navia dash, jump; 
			if .airborne { navia high_plunge; }

		case .fischl.skill.ready && .fischl.swap.ready && !.fischl.oz:
			fischl skill, attack;
		case .fischl.burst.ready && .fischl.swap.ready && !.fischl.oz:
			fischl attack:2, burst;
		case .furina.burst.ready && .furina.swap.ready:
			if .furina.skill.ready { furina skill; }
			furina burst;
		case .furina.skill.ready && .furina.swap.ready && !.furina.status.furina-skill:
			furina skill;

		case .navia.burst.ready && .navia.swap.ready:
			navia burst;

		case .xianyun.burst.ready && .xianyun.swap.ready:
			xianyun burst;
		case .xianyun.skill.ready && .xianyun.swap.ready:
			xianyun skill, high_plunge;

		case .navia.skill.ready && .navia.swap.ready:
			navia skill[hold=!(.navia.shrapnel>=6)];

		// defaults
		case .navia.onfield:
			navia attack;
		case .xianyun.onfield:
			xianyun attack;
		case .fischl.onfield:
			fischl attack;
		case .furina.onfield:
			furina attack;
	}
}