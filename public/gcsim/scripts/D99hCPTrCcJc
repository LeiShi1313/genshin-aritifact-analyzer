options iteration=1000 swap_delay=12;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=21370000000;

active diluc; # SS Stacks

for let i=0; i<4; i=i+1 {
  durin burst;
  fischl skill, attack;
  mona burst, attack;
  diluc burst, attack, skill;
  fischl attack:2, burst;
  mona attack:2, charge;
  diluc skill, attack, skill;
  mona attack, skill, attack:2;
  durin skill:2;
  diluc attack, skill, skill, skill;
}

