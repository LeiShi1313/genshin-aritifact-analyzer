kazuha add stats def%=0.1240 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3964 er=0.6612 em=118.92 cr=0.0662 cd=0.1324; # sub										
									


options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

active furina;
for let i=0; i<4; i=i+1 {
 furina skill, walk, burst;
 if .charlotte.burst.ready && i != 0 {
   if .charlotte.skill.ready {
     charlotte skill;
   }
   charlotte burst;
 }
 kazuha skill, high_plunge;
 if .kazuha.burst.ready {
   kazuha burst;
 }
 shenhe skill, burst, skill[hold=1];
 for let j = 0; j < 12; j = j + 1 {
   charlotte attack:3;
   if j != 12 {
     if .charlotte.skill.ready {
       charlotte skill;
     } else {
       charlotte dash;
     }
   }
 }
}

