# Raiden Xiangling Fischl Baizhu. ~20s Rot. Raiden Quickburn. Fischl uses skill after Raiden burst if available, otherwise Baizhu fills time with NA for burst CDs. Xiangling prefers full EM.

# Team - Options listed by DPS
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="fjords" refine=1 lvl=90/90;
#raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=59.46 cr=0.3972 cd=0.5296;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="kitain" refine=5 lvl=90/90;
xiangling add set="gd" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.4959 em=158.56 cr=0.0662 cd=0.1324;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="ohc" count=4;
#baizhu add set="no" count=4;
baizhu add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.331 cd=0.2648;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  baizhu skill, burst;

  xl burst, skill, dash;

  fischl attack:2, burst;

  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;

  while .baizhu.burst.cd > 40 {
    if .amy.skill.ready {
      amy attack, skill;
    } else {
      baizhu attack;
    }
  }
}
