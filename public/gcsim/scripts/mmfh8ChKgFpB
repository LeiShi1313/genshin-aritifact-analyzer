# Yae Furina Lisa Xianyun. ~22s Rot. KQMS KurtC. Yae Taser Plunge. Xianyun refeshes VV mid rotation. Yae uses bust every other rotation immediately after all plunges spent. Lisa uses hold skill for Team ER, but could theoretically do no skill with a gargantuan ER investment. 50% Collisons.

# Team - Options Listed by DPS
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="lno" count=4;
#yae add set="mh" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # LNO
#yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#yae add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10; # MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*7 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*11 cd=0.0662*4;

lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="favcodex" refine=3 lvl=90/90;
lisa add set="scroll" count=4;
#lisa add set="no" count=4;
lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
lisa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*6 cr=0.0331*10 cd=0.0662*2;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*8 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Front

# Functions
# Yae Plunge Combo
fn YaePlunge() {
  yae jump;
  if .airborne {
    yae high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active yae;

for let x=0; x<4; x=x+1 {
  yae skill:3;

  lisa skill[hold=1], burst;
  # This is for furina, Lisa doesn't need to catch this
  if !.lisa.mods.favonius-cd {
    lisa attack;
  }

  furina skill, dash, burst;

  xianyun skill, low_plunge, burst;

  # 3 High plunges into skill refresh
  YaePlunge(); yae dash;
  YaePlunge(); yae dash;
  YaePlunge(); yae dash;
  YaePlunge(); yae skill;

  xianyun attack:2; sleep(20); # for CD warning

  # Spend Remaining High Plunges
  YaePlunge(); yae dash;
  YaePlunge(); yae dash;
  YaePlunge(); yae dash;
  YaePlunge();
  if .yae.burst.ready && .yae.energy == .yae.energymax {
    yae burst;
  }
}
