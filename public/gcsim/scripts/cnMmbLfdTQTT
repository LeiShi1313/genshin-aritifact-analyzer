# Artifact Set
furina add set="goldentroupe" count=4;
# Main stats
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
# Sub stats
furina add stats hp=507.88 hp%=0.1982 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 em=39.63 er=0.1101 cr=0.3305 cd=0.7926;

# Character
xilonen char lvl=90/90 cons=6 talent=10,10,10;
# Weapon
