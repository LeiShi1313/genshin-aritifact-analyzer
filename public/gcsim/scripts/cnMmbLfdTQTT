# Main stats
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #AP mstats
# Sub stats
xilonen add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=39.35 def%=0.2478 em=39.63 er=0.1101 cr=0.3305 cd=0.7926; #AP substats

# Character
citlali char lvl=90/90 cons=6 talent=10,10,10;
# Weapon
citlali add weapon="starcallerswatch" refine=5 lvl=90/90;
# Artifact Set
citlali add set="scrolloftheheroofcindercity" count=4;
# Main stats
citlali add stats hp=4780 atk=311 em=186.5 em=186.5 em=186.5; #Scroll mstats
# Sub stats
citlali add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 em=118.89 er=0.1101 cr=0.3966 cd=0.5284; #Scroll substats

options swap_delay=12 iteration=1000;

energy every interval=480,720 amount=1;
target lvl=100 hp=99999999 resist=0.1 radius=2 pos=0,2.4;

active cyno;

cyno skill;
for let i=0; i<4; i=i+1 {
  xilonen skill, attack:2, skill;
  //  pick_up_crystallize("electro"); #realist scenario for Xilo AP
  furina skill, dash, attack, burst, attack:2;
  citlali skill, burst;
  xilonen skill, attack:2;
  pick_up_crystallize("electro"); #perfect scenario for Xilo AP
  cyno skill, burst;
   while .cyno.burst.cd> 430 {
   if .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 5 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}
