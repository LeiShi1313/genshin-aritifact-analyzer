# Character
cyno char lvl=90/90 cons=6 talent=10,10,10;
# Weapon
cyno add weapon="staffofthescarletsands" refine=5 lvl=90/90;
# Artifact Set
cyno add set="marechausseehunter" count=4;
# Main stats
cyno add stats hp=4780 atk=311 em=186.5 em=186.5 cd=0.622;
# Sub stats
cyno add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.2477 def=39.35 def%=0.1239 em=158.52 er=0.1101 cr=0.1652 cd=0.6605;

# Character
furina char lvl=90/90 cons=6 talent=10,10,10;
