varesa char lvl=90/90 cons=0 talent=9,9,9;
varesa add weapon="thewidsith" refine=3 lvl=90/90;
varesa add set="longnightsoath" count=4;
varesa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
varesa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="favoniuswarbow" refine=4 lvl=90/90;
sara add set="scroll" count=4;
sara add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; #main
sara add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*12 cr=0.0331*2 cd=0.0662*4;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushinring" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*8 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1];
    } else if .xianyun.status.xianyun-airborne-buff {
      varesa jump;
      if .airborne {
        varesa high_plunge[collision=1];
      }
    } else {
      varesa charge, high_plunge[collision=1];
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
       varesa burst;
    }
  }
}

active sara;

for let i=0; i<4; i=i+1 {
  sara skill, aim;
  if !i {
    wait(12); # Wait for buff to apply to Sara
  } else {
    sara attack;
  }
  xianyun skill, low_plunge, burst;
  bennett skill, burst;
  sara burst;
  varesa_combo(3);
  xianyun attack:2;
  sara skill, aim;
  varesa_combo(4);
}

# ~24s rotations
# Sara E C (N1) > Xianyun EPQ > Bennett EQ > Sara Q > Varesa 3 Plunge Combos > Xianyun N2 > Sara E C > Varesa 4 Plunge Combos