# Navia Rosaria Shenhe Xilonen. ~20s Rot. Navia Double Cryo. Slight buffs from crit rate and Shenhe A4. Navia uses a 3rd skill when available. Xilonen burts every other rotation. Crystallize shards are picked up with dashes and character movement skills.

# Team - Options listed by DPS
navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="nighttime" count=4;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cd=0.622;
navia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="deathmatch" refine=1 lvl=90/90;
rosaria add set="emblem" count=4;
#rosaria add set="bs" count=2; rosaria add set="no" count=2;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favlance" refine=3 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1653 em=39.64 cr=0.3972 cd=0.331;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Pickup Crystallize Function
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilonen && action_id == .action.skill ) || ( char_id == .keys.char.shenhe && action_id == .action.skill ) || ( char_id == .keys.char.rosaria && action_id == .action.skill ) {
    pick_up_crystallize("any");
  }

  return _execute_action(char_id, action_id, p);
}

# Rotation
active navia; # SS Stacks

rosaria skill;

for let i = 0; i < 4; i = i + 1 {
  if !is_even(i) {
    xilonen burst;
  }
  xilonen skill, attack:2;

  navia burst;

  shenhe skill, burst;

  rosaria skill, burst;

  if i == 0 {
    navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  } else {
    navia skill[hold=0], attack:2, dash, attack:2, dash, attack:2;
  }

  if i == 0 {
    shenhe skill, attack;
  } else {
    shenhe attack, skill, attack;
  }

  rosaria skill;

  if i == 0 {
    navia skill[hold=0], attack:2, dash, attack:2, skill;
  } else if i == 3 {
    navia skill[hold=0], attack:2, dash, attack:2, skill;
  } else {
    navia skill[hold=0], attack:2, dash, attack:2, dash, attack:2;
  }

}
