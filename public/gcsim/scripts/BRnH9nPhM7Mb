noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="favgs" refine=3 lvl=90/90;
noelle add set="mh" count=4;
noelle add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
noelle add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active furina;

for let i=0; i<4; i=i+1 {
  furina skill, burst;
  xiangling burst, skill, dash;
  if .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  noelle skill, burst, attack:3, dash, attack:3, dash, attack:3;
  xiangling attack, skill, dash, attack;
  noelle attack:3, dash, attack:4;
}
