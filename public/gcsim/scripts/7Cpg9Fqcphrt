kazuha attack, jump, high_plunge;

kazuha attack, skill, high_plunge;
kazuha attack, jump, high_plunge;
kazuha attack, jump, high_plunge;

#for energy recovery: xianyun particles into kazuha
xianyun skill, low_plunge;
kazuha skill, high_plunge;
bennett skill, attack:2;

}
