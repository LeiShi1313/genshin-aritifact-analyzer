rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="catch" refine=5 lvl=90/90;
rosaria add set="emblemofseveredfate" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311 ; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active diona;
for let i = 0; i <4; i = i + 1 {
  diona skill[hold=1], burst;
  if .diona.skill.ready {
   diona skill[hold=1];
  }
  bennett burst, skill;
  if .amber.skill.ready {
   amber attack:2, skill, dash;
  }
  else {amber aim, dash, skill;}
   amber burst;
  rosaria skill, burst;
  amber aim[bunny=1];
  if .amber.skill.ready {
   amber skill, aim[bunny=1];
  }
  else {
   amber attack,skill, aim[bunny=1];
  }
  for let x = 0; x< 5; x=x+1 {
    let weak = rand();
    if weak > 0.3 {
      amber aim[weakspot=1];
    }
    else {
      amber aim;
    }
  }
  if i!=3 {
   rosaria skill;
  }
  print("end");
}

