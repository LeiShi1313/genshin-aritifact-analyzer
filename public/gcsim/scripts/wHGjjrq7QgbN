# Noelle Columbina Ineffa Xilonen. 20s Rot. Noelle Lunar Crystallize with Ineffa. 2E Xilonen feeds particles to Noelle. Ineffa and Columbina burst in alternate rotations. Morningstar is a bit more DMG on Columbina than Ineffa.

# Team - Options ordered by DPS
noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
noelle add set="notsu" count=4;
#noelle add set="husk" count=4;
noelle add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #main
noelle add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*11 cd=0.0662*10; # NOTSU
#noelle add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
#noelle add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # Husk

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="aubade" count=4;
#columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*9 cr=0.0331*7 cd=0.0662*10;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="sms" count=4;
#ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
#xilonen add set="sms" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.062*8 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*8;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active noelle; # SS Stacks

for let i=0; i<4; i=i+1 {
  if is_even(i) {
    ineffa skill, attack;

    columbina skill, burst;
  } else {
    ineffa skill, burst;

    columbina attack:1, skill;
  }

  xilonen skill, attack:2;

  noelle skill, burst, attack:3, dash, attack:3, dash, attack:2;

  xilonen skill, attack:2;

  noelle attack:3, dash, attack:2;
  if is_even(i) {
    noelle attack;
  }
}
