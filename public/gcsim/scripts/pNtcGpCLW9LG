# Sucrose Faruzan Furina Xianyun. ~19s Rot. Sucrose plunge. Sucrose spends skills and burst before plunging. 50% Collisions.

# Team
sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="widsith" refine=3 lvl=90/90;
#sucrose add weapon="flowingpurity" refine=5 lvl=90/90;
#sucrose add set="mh" count=4;
sucrose add set="longnightsoath" count=4;
#sucrose add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311;
#sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2317 cd=0.7944; # MH
sucrose add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311;
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # LNO

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90;
faruzan add set="scroll" count=4;
#faruzan add set="no" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311;
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
#xianyun add set="no" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.2755 em=39.64 cr=0.2317 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  
  xianyun skill, low_plunge, burst;
  
  faruzan skill, burst;
  
  if .sucrose.burst.ready {
    sucrose burst;
  }
  if .sucrose.skill.ready {
    sucrose skill, dash;
  }
  while .xianyun.status.xianyun-airborne-buff {
    sucrose jump;
    if .airborne {
      sucrose high_plunge[collision=rand()>0.5];
    }
    if .sucrose.status.xianyun-airborne-buff {
      if .sucrose.skill.ready {
        sucrose skill;
      } else {
        sucrose dash;
      }
    }
  }
  
}

