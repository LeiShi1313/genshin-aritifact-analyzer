mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="ap" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  mualani skill,
          walk[f=90], attack,
          walk[f=90], attack,
          walk[f=90], attack;
}

active mavuika; # SS Stacks

mualani swap;
wait(49); # To help Mavuika Vaporize her Burst first rotation
for let i=0; i<6; i=i+1 {
  mualani attack;
  xilonen skill, attack:2;
  mavuika burst, charge, skill, dash;
  pick_up_crystallize("hydro");
  zhongli skill[hold_nostele=1], dash;
  mualani_combo();
  if .mualani.burst.ready {
    mualani burst, attack;
  } else {
    mualani skill, attack, charge, attack:2;
  }
}

