# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

# Rotation
active razor; # SS stacks
if .chongyun.sets.scroll > 4 { # Scroll 1st rot
  razor skill, dash;
}

for let i=0; i<4; i=i+1 {
  chongyun burst, skill;

  nicole skill, burst; # Nicole can catch particles post energy drain

  #if .amy.skill.ready { # Fischl wants to recieve Nicole's buff every time
    amy attack, skill;
  #} else {
  #  amy attack:2, burst;
  #}

  razor skill[hold=0], dash, attack, burst;
  razor attack:1, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
}
