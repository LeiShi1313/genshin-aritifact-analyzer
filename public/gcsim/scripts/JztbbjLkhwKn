options swap_delay=12 iteration=1000;

# Build assumptions
clorinde char lvl=90/90 cons=6 talent=10,10,10;
clorinde add weapon="absolution" refine=5 lvl=90/90;
clorinde add set="echoes" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

ororon char lvl=90/90 cons=6 talent=10,10,10;
ororon add weapon="elegy" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mavuika char lvl=90/90 cons=6 talent=10,10,10;
mavuika add weapon="tbs" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=10,10,10;
chevreuse add weapon="symphonistofscents" refine=5 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active mavuika;

for let i = 0; i < 4; i = i + 1 {
  if !i {
    mavuika skill;    # First rotation only
  }
  ororon skill, burst;
  chevreuse skill[hold=1], attack;
  if i {
    mavuika skill;
  }
  mavuika burst, charge:2, dash, charge:2, dash, charge:2, dash, charge, dash;
  clorinde skill;
  if .clorinde.bolratio >= 1 && .clorinde.status.clorinde-night-watch {
    clorinde skill;
  }
  for let i=0; i<6; i=i+1 {
    clorinde attack:3;
    if .clorinde.bolratio >= 1 && .clorinde.status.clorinde-night-watch {
      clorinde skill;
    }
  }
  if .clorinde.status.clorinde-night-watch {
    clorinde attack;
  }
  if .clorinde.burst.ready {
    clorinde burst;
  }

}
