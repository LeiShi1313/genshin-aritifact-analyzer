# Kazuha Faruzan Bennett Xianyun. ~19s Rot. Kazuha does Anemo and Pyro plunges and bursts every rotation. 70% Collisions. 

# Team
kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="harbinger" refine=5 lvl=90/90;
#kazuha add weapon="wolffang" refine=1 lvl=90/90;
kazuha add set="longnightsoath" count=4;
#kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90;
faruzan add set="tom" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311 ; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="ohc" count=4; # Bubbles may miss while airborne
xianyun add set="sodp" count=4; 
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.2204 em=39.64 cr=0.3972 cd=0.3972;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active faruzan;

for let i=0; i<4; i=i+1 {
  faruzan skill, burst;
  
  xianyun skill:3, high_plunge, burst;
  
  bennett skill, burst;
  
  kazuha skill[hold=1], high_plunge[collision=1], burst;
  while .kazuha.status.xianyun-airborne-buff {
    if .kazuha.skill.ready {
      kazuha skill, high_plunge[collision=1];
    } else { 
      kazuha jump;
      if .airborne {
        kazuha high_plunge[collision=rand()>0.3], dash;
      }
    }
  }
  
  bennett skill;
}

