xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="favcodex" refine=3 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="ap" count=5;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

active neuvillette;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
options swap_delay=12 iteration=100;
energy every interval=480,720 amount=1;

neuvillette skill, attack;
for let x=0; x<4; x=x+1 {
  xilonen attack, skill, attack:2;
  sucrose skill, dash;
  if x && .sucrose.skill.ready {
    sucrose skill, dash, attack;
  } else {
    sucrose attack;
  }
  xiangling attack, burst, skill, dash;
  pick_up_crystallize("hydro");
  neuvillette charge, burst, skill, charge;
  xilonen skill, attack:2;
  sucrose skill, dash, burst;
  xiangling attack:2, skill, dash;
  pick_up_crystallize("hydro");
  neuvillette charge, charge, skill, attack;
}