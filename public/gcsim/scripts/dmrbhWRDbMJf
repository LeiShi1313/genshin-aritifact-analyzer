# Razor Nahida Xingqiu Diona. ~24s Rotation. Hyperbloom Razor with Diona. Few Shatter occurences. NO > Ins Diona, as she has issues owning reactions in this rotation. DW > NO Diona with GT Nahida.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="flameforgedinsight" refine=5 lvl=90/90;
razor add set="fopl" count=4;
#razor add set="gd" count=4;
razor add stats hp=4780 atk=311 em=187 em=187 em=187; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*7 er=0.0551*2 em=19.82*6 cr=0.0331*12 cd=0.0662*3;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4; # With DW Diona
#nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*10 cd=0.0662*10;
#nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
#nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.331 cd=0.4634; # EDC

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

diona char lvl=90/90 cons=6 talent=9,9,9;
diona add weapon="favbow" refine=4 lvl=90/90;
diona add set="deepwood" count=4; # Better than NO w/ GT Nahida
#diona add set="no" count=4;
diona add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
diona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*6 cr=0.0331*10 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active nahida;
#active razor;
#razor skill, dash; # Max sigils in 1st rot

for let i=0; i<4; i=i + 1 {
  # Forego Nahida burst if energy deficient
  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  }  else {
    nahida charge;
  }

  xingqiu skill, dash, burst, attack;

  diona skill[hold=1], burst;

  razor skill, dash, attack, burst;
  # Razor Main DPS window; Burst ends 3.5s early
  while .xingqiu.mods.xingqiuburst {
    if .razor.normal > 3 && .razor.skill.ready {
        razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }

}
# Notation
# Razor ED (1st Rot) >
# Nahida EN1Q/EN1 > Xingqiu EDQN1 > Diona hEQ >
# Razor N1EDN1Q N3ED N3D N3D N3ED N3D N3D N2ED
