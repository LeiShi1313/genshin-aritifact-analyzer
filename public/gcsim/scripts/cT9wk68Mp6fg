xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.551 em=138.74 cr=0.1655 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311  er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  yelan burst, attack, skill, attack;
  
  xianyun skill, low_plunge, attack, burst, attack;
  
  bennett skill, burst, attack;
  for let p=0; p<3; p=p+1 {
    furina jump;
    if .airborne {
      furina high_plunge[collision=1];
      if p < 2 {
        furina dash;
      }
    }
  }
  
  yelan attack, skill, attack;
  
  for let p=0; p<5; p=p+1 {
    if .furina.status.xianyun-airborne-buff {
      furina jump;
      if .airborne {
        furina high_plunge[collision=1];
        if p < 4 {
          furina dash;
        }
      }
    }
  }
}
