# Kinich Ororon Nahida Kirara. ~18s Rot. Triple Dendro Spread. Kinich seeks blindspots. No Kinich Short Hold E is -2K DPS. Kinich bursts every other rotation; Nahida bursts in the other rotations for Kinich skill cd. 

# Team
kinich char lvl=90/90 cons=0 talent=9,9,9;
kinich add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
kinich add set="oc" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
kinich add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

ororon char lvl=90/90 cons=6 talent=9,9,9; 
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
#nahida add set="gt" count=4;
#ahida add set="tom" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=59.46 cr=0.3641 cd=0.7944;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="favsword" refine=3 lvl=90/90;
kirara add set="no" count=4;
#kirara add set="deepwood" count=4;
kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
kirara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

fn kinich_combo() {
  kinich skill;
  while .kinich.nightsoul.state {
    switch .kinich.nightsoul.points {
      case 20:
        kinich skill[hold=1];
      default:
        if .kinich.blind_spot {
          kinich attack[direction=.kinich.blind_spot];
        } else {
          kinich attack;
        }
    }
  }
}

#Rotation
active kinich; # SS stacks

for let i = 0; i < 4; i = i + 1 {
  nahida skill;
  if is_even(i) {
    nahida burst;
  } else {
    nahida attack, charge;
  }
  
  kirara skill[short_hold=1];
  if .kirara.burst.ready {
    kirara burst;
  } else {
    if !.kirara.mods.favonius-cd {
      kirara attack;
    }
  }
  
  ororon skill, burst, attack;
  
  kinich_combo();
  if .kinich.burst.ready {
    kinich burst;
  }
  
}
