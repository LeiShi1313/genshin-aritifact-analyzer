# Cyno Yelan Furina Mika. ~22s Rot. Physical Cyno N3CD spam, skilling off CD. ATK Substats strongly preferred by Crescent Pike. 2E Yelan.

cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="cpike" refine=5 lvl=90/90;
#cyno add weapon="deathmatch" refine=5 lvl=90/90;
cyno add set="mh" count=4;
cyno add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; # main
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2648 cd=0.5958; # Cpike/MH/CR
#cyno add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; # main
#cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.3972 cd=0.2648; # Cpike/MH/CD

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2979 cd=0.5296;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
#mika add set="sodp" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Cyno Cpike Function
fn CynoCpike() {
  switch {
  case .cyno.skill.ready:
    cyno skill;
  case .cyno.normal > 3 && .stam > 43:
    cyno charge, dash;
  case .cyno.normal > 3 && .stam > 18:
    cyno dash;
  default:
    cyno attack;
  }
}

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, burst;

  yelan skill, burst, attack;

  mika burst, attack, skill;

  cyno attack:2, skill;
  while !.yelan.skill.ready {
    CynoCpike();
  }

  yelan skill, attack;

  while .yelan.skill.cd > 210 {
    CynoCpike();
  }

}
