ayaka char lvl=90/90 cons=0 talent=9,9,9;
ayaka add weapon="mistsplitterreforged" refine=1 lvl=90/90;
ayaka add set="blizzardstrayer" count=4;
ayaka add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
ayaka add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662 ;										

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5297;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="ttds" refine=5 lvl=90/90;
xianyun add set="viridescentvenerer" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 er=0.518; #main
xianyun add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.4408 em=39.64 cr=0.331 cd=0.1324 ;										

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favoniuslance" refine=3 lvl=90/90;
shenhe add set="noblesseoblige" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
shenhe add stats def%=0.1240 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.6612 em=39.64 cr=0.331 cd=0.1324; # sub

options swap_delay=12 iteration=200;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4 freeze_resist=0;
energy every interval=480,720 amount=1;

active furina;
for let i = 0; i < 4; i = i + 1{
  furina burst, skill;
  shenhe burst, skill;
  xianyun skill, low_plunge, burst;
  ayaka dash, skill, attack, burst, jump;
  if .airborne {
    ayaka low_plunge[collision=1];
  }
  xianyun attack, jump;
  if .airborne {
    xianyun low_plunge;
  }
  shenhe attack, skill;
  ayaka dash, jump;
  if .airborne {
    ayaka low_plunge[collision=1];
  } else {
    ayaka attack;
  }
  ayaka attack, charge, skill, attack:2, charge;
  print("rotation done");
}