fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="kitain" refine=5 lvl=90/90;
thoma add set="no" count=4;
thoma add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=158.56 cr=0.1986 cd=0.3972;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="totm" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3986 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

options iteration=100 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
    clorinde skill;
    while .clorinde.status.clorinde-night-watch {
        if .clorinde.bolratio >= 1 {
            clorinde skill;
        } else {
            clorinde attack;
        }
    }
}

active fischl;

fischl burst; # open with fischl burst for initial electro application

for let i = 0; i <4 ; i = i + 1 {

  thoma burst, attack, skill;
   if .fischl.skill.ready { # fischl burst every other rotation
    fischl attack, skill;
  } else if i {
    fischl attack:2, burst;
  }
  if .chev.burst.ready { # chev burst when available
    chev burst, skill[hold=1];
  } else {
    chev attack, skill[hold=1], attack;
  }
  clorinde_combo();
  clorinde attack; # clorinde NA for additional trigger of thoma burst
  clorinde burst;

}
