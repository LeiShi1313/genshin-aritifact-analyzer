# Razor Furina Baizhu Nahida. 17s field time Razor Furina Quickbloom w/ ~65% Quicken Uptime.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="mailedflower" refine=5 lvl=90/90;
#razor add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=1];
razor add set="mh" count=4;
#razor add set="gd" count=4;
razor add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; # main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # EM Sands
#razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2979 cd=0.662; # ATK Sands

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.2979 cd=0.7944 ;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="ohc" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=.359; #main
baizhu add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.3972 cd=0.1324;																														

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

active razor;
razor skill, dash; #Max Sigils for first rotation

for let i=0; i<3; i=i+1 { 
  # Forego Nahida burst if energy deficient
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  }
  
  furina skill, dash, burst;
  
  baizhu skill, burst;
  
  # Razor out of burst actions; account for energy deficiency
  while !.razor.mods.razor-q {
    # When burst is ready
    if .razor.burst.ready {
      if .razor.skill.ready {
        razor skill, dash, attack, burst;
      } else {
        razor burst;
      }
    } else {
    # When burst is not ready
      if .razor.skill.ready {
        razor skill, dash, attack;
      } else {
      # When neither burst or skill is ready
        if .razor.normal > 3 {
          if .razor.skill.ready {
            razor skill, dash;
          } else {
            razor dash;
          }
        } else {
          razor attack;
        }
      }
    }
  }
  # Razor Main DPS window 
  while .razor.mods.razor-q > 160 {
	  if .razor.normal > 3 {
	    if .razor.skill.ready {
	      razor skill, dash;
	    } else {
	      razor dash;
	    }
	  } else {
      razor attack;
    }
  }
  
  # Notation
  # Razor ED (1st Rot) > 
  # Nahida EN1Q/EN1 > Furina EDQ > Baizhu EQ >
  # Razor EDN1Q N3ED 2N3D N3ED 2N3D N3ED
}