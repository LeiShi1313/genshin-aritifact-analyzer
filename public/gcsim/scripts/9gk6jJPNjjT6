# Razor Furina Baizhu Nahida. ~25s Rot. Razor Quickbloom w/ ~58% Quicken Uptime.
# Note - A case to be made for Flame Forged Insight allowing the removal of hE?

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=1];
razor add set="risingwinds" count=4;
#razor add set="mh" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10; # ATK/Electro
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*10 er=0.0551*2 em=19.82*2 cr=0.0331*6 cd=0.0662*10; # MH
#razor add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10; # EM/Electro
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*10 er=0.0551*2 em=19.82*2 cr=0.0331*6 cd=0.0662*10; # MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # ToM
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
#furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # GT

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="ohc" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
baizhu add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*12 cd=0.0662*5;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*3 cr=0.0331*10 cd=0.0662*11;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

active razor;
razor skill, dash; # Max Sigils for first rot

for let i=0; i<4; i=i+1 {
  # Forego Nahida burst if energy deficient
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  }

  furina skill, dash, burst;

  baizhu skill, burst;

  # Intuitive combo, Razor hEDN1Q N1tED 2N3D N3tED 2N3D N3tED
  razor skill[hold=1], dash, attack, burst, attack, skill, dash;
  let razorSkills = 1;
  while razorSkills < 3 {
    # N3ED
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
      razorSkills = razorSkills + 1;
    # N3D
    } else if .razor.normal > 3 {
      razor dash;
    # NA
    } else {
      razor attack;
    }
  }
}
