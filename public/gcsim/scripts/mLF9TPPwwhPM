# Eula Shenhe Chongyun Xianyun. ~20s Rot. Eula Mono Cryo Plunge. Eula's uses skill at the opening to so Xianyun can swirl Cryo, while Eula gains a Grimheart stack. Eula immediately uses hold skill with Grimheart stacks to shred Cryo RES. After plunging, Eula uses burst/skill and NAs while Chongyun's field is active. 50% Collisions.

# Team
eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#eula add weapon="fruitfulhook" refine=1 lvl=90/90;
eula add set="lno" count=4;
#eula add set="sr" count=4;
eula add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favlance" refine=3 lvl=90/90;
shenhe add set="glad" count=2; shenhe add set="sr" count=2;
#shenhe add set="emblem" count=4;
shenhe add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.3857 em=39.64 cr=0.331 cd=0.1324;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="ohc" count=4; # Bubbles may miss
xianyun add set="vv" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3306 em=79.28 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active eula; # SS Stacks
eula skill; # Grimheart stacks; A1

for let x = 0; x < 4; x = x + 1 {
  shenhe skill[hold=1], burst;
  
  chongyun burst, skill;
  
  xianyun skill, low_plunge, burst;
  
  # Plunge until expiry
  while .eula.status.xianyun-airborne-buff {
    if .eula.skill.ready {
      eula skill[hold=1]; # Consumes Grimheart stack for Cryo RES Shred
    } else {
      eula jump;
      if .airborne {
        eula high_plunge[collision=rand()>0.5];
      }
      eula dash;
    }
  }
  eula attack;
  # Always fit one skill after plunging
  while .shenhe.burst.cd > 90 {
    if .eula.skill.ready {
      eula skill;
    } else if .eula.burst.ready && .eula.energy == .eula.energymax {
      eula burst, skill;
    } else {
      eula attack;
    }
  }
}

