kokomi char lvl=90/90 cons=6 talent=10,10,10;
kokomi add weapon="everlastingmoonglow" refine=1 lvl=90/90;
kokomi add set="oceanhuedclam" count=4;
kokomi add set="blizzardstrayer" count=1;
kokomi add stats def%=0.262 def=60 hp=6573 hp%=1.347 atk=349 atk%=0.14 er=0.24 cr=0.07 cd=0.078 hydro%=0.466;

yelan char lvl=90/90 cons=0 talent=6,8,9;
yelan add weapon="favoniuswarbow" refine=5 lvl=90/90;
yelan add set="emblemofseveredfate" count=4;
yelan add set="blizzardstrayer" count=1;
yelan add stats def%=0.073 def=84 hp=5766 hp%=0.827 atk=311 er=0.259 em=40 cr=0.373 cd=1.166 hydro%=0.466;

options swap_delay=12 iteration=1000 duration=110;

target lvl=100 resist=.1 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active kokomi;

let third = .kokomi.cons >= 1;
let last = f();

for let x = 5; x || f() < last + 11*60 {
  switch {
    case .status.kokomiburst && .kokomi.normal < 3:
      kokomi attack;
    case .status.kokomiburst && .kokomi.normal == 3 && third:
      kokomi attack;
      if .kokomi.dash.ready {
        kokomi dash;
      }
    case .status.kokomiburst && .kokomi.normal == 3:
      kokomi walk;
    case .kokomi.skill.ready && !.status.kokomiskill:
      #if .yelan.status.yelanburst {
        #kokomi attack;
      #}
      kokomi skill;
    case .yelan.skill.ready:
      #if .yelan.status.yelanburst {
        #yelan attack;
      #}
      yelan skill;
      if .yelan.energy < 70 - 4*2 {
        yelan attack:4;
      }
    case .yelan.burst.ready && .status.kokomiskill:
      yelan burst, attack;
    case .yelan.weapon == .keys.weapon.favoniuswarbow && !.yelan.mods.favonius-cd:
      yelan attack;
    case .kokomi.burst.ready && .status.kokomiskill > 0 && .status.kokomiskill < 180 && .yelan.status.yelanburst:
      if .yelan.status.yelanburst {
        kokomi attack;
      }
      kokomi burst;
      last = f();
      x = x - 1;
    case .kokomi.onfield:
      kokomi attack;
    case .yelan.onfield:
      yelan attack;
    default:
      wait(1);
  }
}
