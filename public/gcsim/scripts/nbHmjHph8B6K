xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.4959 em=39.64 cr=0.331 cd=0.1324;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="catch" refine=5 lvl=90/90;
chev add set="lw" count=4;
chev add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=2000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=5000000; 
energy every interval=480,720 amount=1;

active bennett;
for let i=0; i<4; i=i+1 {
  bennett burst, skill;
  chev burst, skill[hold=1]:3;
  xianyun skill, low_plunge, attack, burst;
  while !.xianyun.mods.favonius-cd {
    xianyun attack;
  }
  hutao skill;
  for let j=0; j<6; j=j+1 {
    hutao attack, charge, jump;
    if .airborne {
      hutao high_plunge[collision=rand()>0.5];
    }
  }
}

