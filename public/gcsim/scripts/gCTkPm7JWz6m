options swap_delay=12 iteration=1000;

gaming char lvl=90/90 cons=6 talent=9,9,9; 
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=5;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;


kaeya char lvl=90/90 cons=6 talent=9,9,9; 
kaeya add weapon="favoniussword" refine=5 lvl=90/90;
kaeya add set="no" count=4;
kaeya add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.3972 cd=0.2648;


lynette char lvl=90/90 cons=6 talent=9,9,9; # C2+ Lynette is preferred but C0 works
lynette add weapon="favsword" refine=5 lvl=90/90;
lynette add set="vv" count=4;
lynette add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311 ; #main; anemo and cryo perform similar
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;


bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="ins" count=4;
bennett add stats hp=3571 atk=232 er=0.518 pyro%=0.348 cr=0.23325; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2979 cd=0.662;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active kaeya;

for let i=0; i<4; i=i+1 {
  
  kaeya attack, burst;
  lynette skill, attack, burst;
  bennett burst;
  gaming burst;
  wait(65);
  for let p=0; p<6; p=p+1 {
    print(p);
    gaming skill;
    wait(20);
    gaming low_plunge;
  }
  kaeya attack, skill;
  bennett skill;
  gaming skill, low_plunge;
  
}

# Kaeya N1 Q > Lynette E N1 Q > Bennett Q > Gaming Q [combo] > Kaeya N1 E > Bennett E > Gaming E LP
