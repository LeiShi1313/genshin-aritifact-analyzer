mika char lvl=90/90 cons=6 talent=9,9,9; 
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
#mika add set="sodp" count=4;
#mika add set="no" count=4;
mika add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=1523.64 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active ororon;

for let i=0; i<4; i=i+1 {
  ororon skill, burst;
  
  furina skill, dash, burst;
  
  mika burst, skill[hold=1];
  
  freminet skill, attack, burst,
           attack:2, skill, skill,
           attack:2, skill, attack:2, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
           attack:2, skill, attack:2, skill,
           attack:3, skill;
}
