active yae;

#single target
target lvl=100 resist=0.1 hp=9999999999 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
    if !i {
      yae skill:3;
    } else {
      yae skill, attack, skill, attack, skill; 
    }
    if i {
      nahida attack;
    }
    nahida skill, burst;
    bennett skill, burst;
    fischl attack, skill;
    yae attack, charge, dash, burst, skill, attack, skill, attack, skill;
    bennett attack, skill;
    yae attack:2, charge, dash, attack:2, charge, dash;
    fischl attack:2, burst;
    bennett skill;
    yae attack:2, charge, dash, attack:2, charge, dash;
}
yae attack;
