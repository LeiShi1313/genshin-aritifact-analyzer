# Charlotte Jean Bennett Xianyun. ~20s Rot. Charlotte Melt plunge with Sunfire to maintain Pyro Aura for Melt. Charlotte uses hold skill after plunging, allowing Xianyun to VV Cryo. Charlotte can N1 cancel the first 2 plunges.

# Team
charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="widsith" refine=3 lvl=90/90;
charlotte add set="lno" count=4;
#charlotte add set="lw" count=4;
charlotte add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311;
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="favsword" refine=3 lvl=90/90;
jean add set="vv" count=4;
jean add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=158.56 cr=0.331 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.2204 em=118.92 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active charlotte;
charlotte attack;

for let i=0; i<4; i=i+1 {
  xianyun skill, low_plunge, burst;

  bennett skill, burst;

  jean skill, burst;

  # Tinker with value to avoid overtaking Pyro
  let j=0;
  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.status.xianyun-airborne-buff {
      charlotte jump;
      if .airborne {
        charlotte high_plunge[collision=rand()>0.5];
        j = j + 1;
      }
      if j < 2 { # adjust for more NA cancels
        charlotte attack;
      } else if j == 8 {
        charlotte attack;
      } else {
        charlotte dash;
      }
    }
  }
  charlotte charge, dash, skill[hold=1];

  jean skill;
}
