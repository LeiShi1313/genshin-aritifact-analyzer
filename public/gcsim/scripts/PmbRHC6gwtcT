lyney char lvl=90/90 cons=0 talent=9,9,9 +params=[start_hp%=60];
lyney add weapon="prototypecrescent" refine=5 lvl=90/90;
lyney add set="marechausseehunter" count=4;
lyney add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
lyney add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662 ;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; #main
xilonen add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="sodp" count=5;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662 ;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active furina;

let rotations = 5;

for let r = rotations; r > 0; r = r - 1 {

  if r != rotations { #not necessary on the first rotation
    lyney aim[weakspot=1];
  }

  if .furina.skill.ready { #furina uses skill and burst every other rotation
    if !.furina.burst.ready {
      bennett skill;
    }
    if !.furina.burst.ready {
      furina attack;
    }
    furina skill, walk;
    delay(13);
    furina burst;
  }

  bennett skill, dash, burst;

  xilonen skill, attack:2;

  lyney aim[weakspot=1], aim, aim, aim;

  if .lyney.burst.ready {
    lyney burst;
    delay(12); # Just so he doesn't cancel his own burst before it deals damage
    lyney skill;
  } 
  else {
    lyney aim;
  }

  lyney skill;

}