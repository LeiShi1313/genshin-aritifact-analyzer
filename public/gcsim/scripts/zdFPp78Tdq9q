klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="mh" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
klee add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1653 em=39.64 cr=0.2979 cd=0.7944; # sub

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; #sub

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favsword" refine=3 lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.1240 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324; # sub

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;	#sub

options swap_delay=12 iteration=10000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

fn klee_combo(x) {
  klee attack, burst, walk, attack[travel=6]; # Klee NQw N1
  while .stam>50 && .klee.burst.cd>160 && x<8 { # While you have enough stamina, and the burst is active
    if .klee.normal == 2 {   # always start with N1
      if .klee.skill.ready && .stam<190 {
        klee skill[bounce=3, mine=8], jump; # Use skill after the first time you use stamina
        if .klee.skill.ready { # If you have the second skill, use it too
          klee attack[travel=6], skill[bounce=3, mine=8], jump;
        }
      } else {
        klee charge; x=x+1; # Use CA otherwise
        if .klee.status.a1-spark && x<8 { # If you have the spark, use the CdC combo
          klee dash, charge; x=x+1;
        }
      }
    } else {
      klee attack[travel=6];
    }
  }
  if .klee.normal == 1 {
    klee attack;
  }
  print(x); # X is the number of CAs in the combo, usually 7-8.
}


active furina;
let rot = 5; #Number of rotations, you can adjust this.
let i=rot; for rot > 0; rot = rot - 1 {
  if rot < i {
    while .kazuha.weapon == .keys.weapon.favsword && !.kazuha.mods.favonius-cd {
      kazuha attack; # NAs until fav proc
    }
  }
  furina skill, dash, burst; # Furina EdQ
  bennett burst; # Bennett burst
  if rot < i {
    bennett skill; # Bennett skill. All rots but first.
  }
  kazuha burst, skill, high_plunge; # Kazuha QEhP
  if rot < i {
    bennett skill; # Bennett skill. All rots but first.
  }
  klee_combo(0); # Klee combo listed above
  klee walk, attack; # End with Klee N1wN1
  kazuha skill, high_plunge; # Kazuha EhP
}


