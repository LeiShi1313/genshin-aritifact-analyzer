  furina skill, dash, burst;
  while !.furina.mods.favonius-cd {
    furina attack;
  }

  kazuha burst;

  bennett burst, skill;
  if !.element.t0.pyro {
    bennett attack; # if the enemy doesn't have pyro aura, do 1 pyro NA
  }

  kazuha skill, high_plunge;

  yoimiya skill,
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          attack;

  kazuha skill, high_plunge;
  while !.kazuha.mods.favonius-cd {
    kazuha attack;
  }
}
