# Bennett Emilie Fischl Lisa. ~18s Rot. On-Field Bennett Burning w/ Overload; 59/51% Burning/Quicken uptime. All characters Q/E catch Bennett's buff. Lisa Burst as every rotation as available. Deepwood on Bennett vs Lisa is the same.

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
#bennett add weapon="wolffang" refine=1 lvl=90/90; # At the expense of team DPS
#bennett add weapon="umbrella" refine=5 lvl=90/90;
bennett add set="deepwood" count=4;
#bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # ATK/CR
#bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; #ATK/CD

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="fruit" refine=5 lvl=90/90;
#lisa add set="deepwood" count=4;
lisa add set="no" count=4;
lisa add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.3972 cd=0.3972; # Er/Em/Em
#lisa add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311;
#lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.1655 cd=0.5958; # Er/Dmg/Cr


# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

#Rotation
active bennett;

for let x = 0; x < 4; x = x + 1 {
  if .bennett.skill.ready {
    bennett skill;
  }
  bennett burst;

  if x && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  if .lisa.burst.ready && .lisa.energy == .lisa.energymax {
    lisa burst;
  }

  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }

  while !.bennett.burst.ready {
    if .lisa.burst.ready && .lisa.energy == .lisa.energymax {
      lisa burst;
    } else if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
}
