# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active fischl;
fischl skill; # small increase

#active yelan;

for let r=0; r<4; r=r+1 {
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  dori skill, burst; # No N1 after burst
  
  haitham burst;
  
  amy attack;
  if .amy.skill.ready {
    amy skill;
  } else {
    amy attack, burst;
  }
  
  haitham attack:3, dash,
          attack:3;
  haitham skill, attack:3, charge, dash,
          attack:3, dash,
          attack:3, charge, dash,
          attack:3, charge;
}
