chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="chainbreaker" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
citlali add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*8 cr=0.0331*12 cd=0.0662*6;

travelerpyro char lvl=90/90 cons=6 talent=9,9,9;
travelerpyro add weapon="favsword" refine=3 lvl=90/90;
travelerpyro add set="totm" count=4;
travelerpyro add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
travelerpyro add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
chevreuse add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*10 cd=0.0662*9;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active travelerpyro;

for let i=0; i<4; i=i+1 {
  travelerpyro skill, burst;
  chevreuse burst, skill[hold=1];
  citlali skill, burst;
  chasca skill;
  set_player_pos(0,-3);  # to simulate that Traveler E ring doesn't apply Pyro to the enemy.
  chasca aim:4, aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  }
  set_player_pos(0,0);
}
wait(82); # wait for aim[bullets=4] hits the enemy at the last rot

# ~18s rotations
# Pyro Traveler tE Q > Chevreuse Q hE > Citlali EQ > Chasca E 4[C] C_4b (Q)