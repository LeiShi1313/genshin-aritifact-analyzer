# Barbara Jean Bennett Xianyun. ~20s Rot. Barbara Vape plunge with no Hydro VV. Barbara can N1 cancel plunges at the start of the rotation without flipping the aura. 8 vaped plunges.

# Team - Options listed by DPS
barbara char lvl=90/90 cons=6 talent=9,9,9;
barbara add weapon="widsith" refine=3 lvl=90/90;
barbara add set="lno" count=4;
#barbara add set="lw" count=4;
barbara add stats hp=4780 atk=311 em=187 hydro%=0.466 cr=0.311;
barbara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

jean char lvl=90/90 cons=0 talent=9,9,9; 
jean add weapon="favsword" refine=3 lvl=90/90;
jean add set="vv" count=4;
jean add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.331 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="ohc" count=4; # Bubbles may miss
xianyun add set="sodp" count=4;
#xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=148.86 atk%=0.2976 er=0.6061 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active xianyun;

for let i=0; i<4; i=i+1 {
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst;
  
  jean skill, burst;
  
  # N1 cancel after plunge for the first 4 plunges, then dash cancel
  let j=0;
  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.status.xianyun-airborne-buff {
      barbara jump;
      if .airborne {
        barbara high_plunge[collision=rand()>0.5];
        j = j + 1;
      }
      if j < 4 {
        barbara attack;
      } else if j == 8 {
        barbara attack;
      } else {
        barbara dash;
      }
    }
  }
  
  bennett attack, skill;
  
  jean skill;
}
