neuvillette char lvl=90/90 cons=0 talent=9,9,9 +params=[start_hp=35000]; 
neuvillette add weapon="tomeoftheeternalflow" refine=1 lvl=90/90 ;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
neuvillette add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;																											
																						
							
# ----  Default Enemy
options swap_delay=12 debug=true iteration=500;
target lvl=100 resist=0.1 hp=2000000 pos=2.4,2.4 radius=2;
energy every interval=480,720 amount=1;

active neuv;

let n = 120;
while 1 {

  if .neuv.skill.ready {
    neuv skill;
  }
  
  if .neuv.burst.ready {
    neuv burst;
  }
  
  if .neuv.skill.cd > n {
      neuv charge;
  }else {
    sleep(n);
  }
}
