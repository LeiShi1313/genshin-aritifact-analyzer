options swap_delay=12 iteration=1000;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=0]; # default is 100
skirk add weapon="azurelight" refine=1 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
//skirk add set="mh" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.2648 cd=0.7944;
//skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
//skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 +params=[start_energy=0];
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

mualani char lvl=90/90 cons=0 talent=9,9,9 +params=[start_energy=0];
mualani add weapon="ttds" refine=5 lvl=90/90;
mualani add set="scroll" count=5;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
mualani add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

escoffier char lvl=90/90 cons=0 talent=9,9,9 +params=[start_energy=0];
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="no" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.4959 em=39.64 cr=0.3972 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=1; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

active escoffier;
escoffier skill, attack:3;  # Catch her own particles
furina attack, skill, dash;
mualani skill, attack, skill;
skirk skill,
      attack:5, burst,

      attack:5, dash,
      attack:5, dash,

      attack:2, charge, dash,

      attack:5, dash;

mualani swap;
print("Skirk E cd (60 FPS) is ", .skirk.skill.cd);
print("Skirk Q cd (60 FPS) is ", .skirk.burst.cd);
mualani skill, attack, skill;

for let i=0; i<4; i=i+1 {
  if i {
    furina skill, dash;
  } else {
    furina attack:2, dash;  # for TTDS cd
  }
  furina burst;
  escoffier skill, attack, burst;
  mualani skill, attack, skill;
  skirk skill,
        attack:2, burst,

        attack:5, dash,
        attack:5, dash,
        attack:5, dash,

        attack:2, charge, dash,

        attack:5, dash,
        attack:2;
  mualani skill, attack, skill; # Exit NS state by using E, this makes E cd start earlier
}

# Escoffier E N3 > Furina N1 ED > Mualani E N1 E > Skirk tE N5Q 2[N5D] N2CD N5D > Mualani E N1 E >
# Furina N2D Q > Escoffier E N1 Q > Mualani E N1 E > Skirk tE N2Q 3[N5D] N2CD N5D N2 > Mualani E N1 E >
# Furina  ED Q > Escoffier E N1 Q > Mualani E N1 E > Skirk tE N2Q 3[N5D] N2CD N5D N2 > Mualani E N1 E > (repeat)
