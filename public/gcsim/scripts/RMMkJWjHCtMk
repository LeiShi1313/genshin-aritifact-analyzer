// Rotation
// (Wrio N1)* > Zhongli hED > Chiori EE > Shenhe hE (Q) > Wrio E 5[N3CJ] (Q or N2C)
// * First rotation, for petra
wrio attack;
for let rot=0; rot<4; rot=rot+1 {
  zhongli skill[hold=1], dash;
  chiori skill:2;

  shenhe skill[hold=1]; pick_up_crystallize("cryo");
  if .shenhe.energy == .shenhe.energymax {
    shenhe burst;
  }

  wrio skill;
  for let n3cj=0; n3cj<5; n3cj=n3cj+1 {
    wrio attack:3, charge, jump;
  }
  if .wrio.energy == .wrio.energymax {
    wrio burst;
  } else {
    wrio attack:2, charge;
  }
}