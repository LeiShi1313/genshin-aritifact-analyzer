options swap_delay=12 iteration=1000;

active mualani;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

for let i=0; i<4; i=i+1 {
  mualani attack;
  xilonen skill, attack:2, burst, attack;
  citlali attack:2, skill;
  xiangling burst, skill, dash, attack:2;
  xilonen skill, attack:2;
  mualani skill;
  mualani_combo();
  if .mualani.burst.ready && .mualani.energy == .mualani.energymax {
    mualani burst;
  } else {
    mualani skill;
    mualani attack:3, charge;     # waiting for Xiangling 20s cd, removing Pyro
  }
}

