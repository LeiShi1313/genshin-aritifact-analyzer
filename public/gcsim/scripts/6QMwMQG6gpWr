gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*3 cr=0.0331*11 cd=0.0662*10;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=5 lvl=90/90;
rosaria add set="scroll" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311 ; #main
rosaria add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*10 cd=0.0662*9;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="ttds" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187; #main
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*12 cd=0.0662*8;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; # main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

# Options
options iteration=2000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Adjacent

# Rotation
active gaming;

for let i=0; i<4; i=i+1 {

  bennett skill, burst;

  rosaria burst;

  sucrose skill, dash;
  if .sucrose.burst.ready {
    sucrose burst;

    gaming burst;
    wait(25);
    for let p=0; p<5; p=p+1 {
      gaming skill;
      wait(17); # Catches Manchai after, but on practice catch it during descent for better results.
      gaming low_plunge;
    }
    gaming skill;
    wait(21);
    gaming low_plunge;
  }
  else {
    sucrose attack;
    while .sucrose.swap.cd > 0 {
      wait(1);
    }

    gaming burst;
    wait(25);
    for let j = 0; j < 4; j = j + 1 {
      wait(50); # Catch Manchai during descent
      gaming skill, low_plunge;
    }
    wait(50);
    gaming skill;
    wait(11);
    gaming low_plunge, skill, low_plunge;
  }

  if i<3 {
    if !.element.t0.pyro {
      bennett skill;
    }

    if is_even(i) {
      sucrose skill, dash, attack;
    }
    else {
      sucrose attack, dash;
    }

    rosaria skill;
    while !.rosaria.mods.favonius-cd {
      rosaria attack;
    }
    if .rosaria.energy != .rosaria.energymax {
      wait(89); #Rosaria catches her own particles
    }

    gaming skill, low_plunge;
  }
}


# Bennett EQ > Rosaria Q > Sucrose ED Q/N1 > Gaming Q 6[EP] > (Bennett E)¹ > Sucrose EDN1/N1D² > Rosaria E N# > Gaming EP
# ¹Skip if enemy already has leftover pyro aura.
# ²Use skill every other rotation, C1 Sucrose required.
