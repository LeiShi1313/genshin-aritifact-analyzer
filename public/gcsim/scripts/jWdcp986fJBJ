# Arlechinno Yelan Cadance Bennett. ~19s Rot. Arlechinno Vape with 7N2C. Double Hydro to increase Vape consistency. 1E Yelan & Candace. ER req is still high on Candace.

# Team
arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
arle add set="fohw" count=4;
arle add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

candace char lvl=90/90 cons=6 talent=9,9,9;
candace add weapon="favlance" refine=3 lvl=90/90;
candace add set="no" count=4; # Eye-watering ER Req with 1 E
#candace add set="emblem" count=4;
candace add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
candace add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
#bennett add set="no" count=4;
bennett add set="scroll" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active arle;

for let i = 0; i < 4; i = i + 1 {
  arle skill;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  candace skill, burst, attack:2; # needs to catch her own particles
  #if .candace.mods.favonius-cd {
  #  candace attack;
  #}
  
  bennett skill, burst;
  
  arle attack, charge,
       attack:2, charge, 
       attack:2, charge, 
       attack:2, charge, 
       attack:2, charge,
       attack:2, charge, 
       attack:2, charge, 
       attack:2, charge; # Yelan burst expires just before CA
}

