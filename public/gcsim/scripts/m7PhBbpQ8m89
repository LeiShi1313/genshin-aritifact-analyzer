xianyun char lvl=90/90 cons=0 talent=9,9,9; 
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="sodp" count=5;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=198.48 atk%=0.3968 er=0.3306 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=100000000;

# Rotation
active gaming; # SS stacks
for let r=0; r<4; r=r+1{
  furina skill, dash, burst;
  xianyun skill, high_plunge, burst;
  yelan skill, burst, attack;
  gaming burst, attack:2;
  for let i=0; i<6; i=i+1 {
    gaming skill, high_plunge, attack;
  }
  gaming skill, high_plunge, dash;
}

