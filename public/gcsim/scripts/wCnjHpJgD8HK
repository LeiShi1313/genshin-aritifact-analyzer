    sara burst;
  }
  yae attack, charge, dash,
      attack, charge, dash,
      attack, charge, dash;
  bennett skill, attack;
  sara aim;
  if.yae.burst.ready{
    yae burst;
  } else {
    yae attack, charge, jump;
  }
}
