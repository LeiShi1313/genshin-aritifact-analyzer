zhongli char lvl=90/90 cons=0 talent=9,9,9; 
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active freminet; # SS stacks

for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash;
  # Guarantee Fav
  #while !.zhongli.mods.favonius-cd {
  #  zhongli attack;
  #}
  
  chiori skill:2;
  
  if .amy.skill.ready {
    amy attack:1, skill;
  } else {
    amy attack:2, burst;
  }
  
  #Burst Combo
  freminet skill, burst,
         attack:2, skill, skill,
         attack:2, skill, attack, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
         attack:2, skill, attack, skill,
         attack:2, skill;
         
  print("done");
}
