xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296; # CR


# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,3  hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3,0 hp=100000000;

# Rotation
active sigewinne;

for let i = 0; i < 5; i = i + 1 {

sigewinne skill; #res shred
yelan burst; #casted here to fit sigewinne burst in furina burst
xilonen skill, attack:2; #res shred, %dmg buff, IR buff
furina skill, dash, burst, charge, attack:4, dash, charge; #dash cancel her skill
yelan attack, skill, attack, skill, attack:3; #combo from kqm that maximizes burst procs and she gets all her particles
xilonen skill, attack:2; #refresh her stuff
sigewinne burst; #sigewinne burst also triggers her res shred
}
wait(320); #for sigewinne burst duration before the end of iteration
