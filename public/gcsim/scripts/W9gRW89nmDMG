xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworneye" refine=5 lvl=90/90;
xianyun add set="clam" count=5;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=181.94 atk%=0.2976 er=0.4959 em=39.64 cr=0.0662 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

fn navia_combo(last_rotation) {
  navia skill;
  if last_rotation {
    for let h = 0; h < 4; h = h + 1 {
      navia jump;
      if .airborne {
        navia high_plunge[collision=rand()>0.5];
      }
      if h == 3 { # on the last plunge, do a skill instead of dashing
        navia skill;
      } else {
        navia dash;
      }
    }
  } else {
    for let h = 0; h < 4; h = h + 1 {
      navia jump;
      if .airborne {
        navia high_plunge[collision=rand()>0.5], dash;
      }
    }
  }
}

active navia;
for let x = 0; x < 4; x = x + 1 {

  furina skill, dash, burst;
  while !.furina.mods.favonius-cd {
    furina attack;
  }

  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }


  if x == 0 {
    navia skill;
  }
  navia burst;

  xianyun skill, low_plunge; pick_up_crystallize("any");
  xianyun burst;

  navia_combo(0); # the 0 in brackets just means to not do another E at the end of the combo

  furina attack:2;
  zhongli attack:3;

  if x == 3 { # on the last rotation of the chamber
    navia_combo(1); # the 1 in brackets means do another E after 4 plunges are done
  } else {
    navia_combo(0); # the 0 in brackets just means to not do another E at the end of the combo
  }
}
