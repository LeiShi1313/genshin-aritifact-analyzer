# Alhaitham Furina Fischl Dori. ~21s Rot. Long field time Alhaitham with Dori supplying energy. Deploys Oz during Alhaitham's burst window.

# Team
alhaitham char lvl=90/90 cons=0 talent=9,9,9;
alhaitham add weapon="harbinger" refine=5 lvl=90/90;
alhaitham add set="mh" count=4;
alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.2648 cd=0.5958; # HoD
#alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
#alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # Umbrella
#alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
#alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.2317 cd=0.662; # WF

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
#furina add set="gt" count=4;
furina add set="tom" count=4;
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.331 cd=0.2648; # GT
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.331 cd=0.2648; # ToM

fischl char lvl=90/90 cons=6 talent=9,9,9 +params=[start_hp%=70];
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=186.5 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="favgs" refine=3 lvl=90/90;
dori add set="deepwood" count=4;
dori add stats hp=4780 atk=311 em=187 em=187 em=187; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=118.92 cr=0.3972 cd=0.1986;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # Fischl Triggers some HB
#target lvl=100 resist=0.1 radius=2.6 pos=0,3.0 hp=999999999; # Fischl Triggers minimal HB

# Rotation
active furina;
fischl skill, attack;

for let r = 0; r < 4; r = r + 1 {
  furina skill, dash, burst;

  dori skill, burst;
  #dori skill, attack:2, burst; # More Healing

  alhaitham burst;

  # Use burst over skill
  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }

  alhaitham attack:3, dash,
            attack:3, charge, dash,
            attack:3, charge, dash,
            attack:1, skill[hold=1], low_plunge[short=1];
  alhaitham attack:4, charge, dash,
            attack:4;

}
