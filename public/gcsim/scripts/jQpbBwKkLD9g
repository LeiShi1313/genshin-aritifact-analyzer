bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=160]; # Pick up during Razor 1st dash
bennett add set="ins" count=4;
#bennett add set="no" count=4;
bennett add stats hp=3571 atk=232 em=140 em=140 em=187; #main
bennett add stats def%=0.05208*2 def=16.5312*2 hp=213.31*2 hp%=0.041664*2 atk=13.8936*2 atk%=0.041664*2 er=0.046284*12 em=16.6488*4 cr=0.027804*2 cd=0.055608*2; # 4*
#bennett add stats hp=3571 atk=232 em=187 em=187 em=187; #main
#bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*10 er=0.0551*10 em=19.82*6 cr=0.0331*2 cd=0.0662*2; # 5*

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

active razor;
razor skill, dash; # Max Sigils for first rotation

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd && !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  nahida skill, burst, charge; # CA clears Hydro, allows burning

  bennett skill, dash, burst;

  razor skill[hold=1], dash, attack, burst; # hE needed for Energy.
  razor attack:1, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:3;

  bennett skill;
}
