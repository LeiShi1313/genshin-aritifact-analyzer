# Razor Furina Nahida Bennett. ~23s. Razor Hyperburgeon with C6 Bennett infusion. Nahida runs P-Amber to counteract Furina's HP drain, fanfare decreases in later rotations. 2E Bennett builds Full EM.  Self-Aura Overloads not implemented.
# Note - Hydro uptime is too terrible for Flame Forged Insight.

# Team - Options listed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="talkingstick" refine=1 lvl=90/90; razor add stats atk%=0.16 electro%=0.12 pyro%=0.12; # Passive not implented; Self-Damage SS Alternative
#razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5]; # Burgeon/Burning damage impacts passive
razor add set="ur" count=4; # No, RW isn't better; Yes, the team has high Burning uptime
#razor add set="gd" count=4; # Reaction damage
razor add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # Em/El/Cd
#razor add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # Em/Em/Cd
