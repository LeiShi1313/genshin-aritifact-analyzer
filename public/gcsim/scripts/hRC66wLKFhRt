# Rotation assumptions
active dehya;

for let i=0; i<5; i=i+1 {
  dehya skill;
  furina skill, dash, burst;
  bennett burst;
  kazuha skill[hold=1], high_plunge;
  bennett skill;
  dehya burst, attack:10;
  kazuha burst, skill, high_plunge;
  bennett skill;
  dehya skill;
}

