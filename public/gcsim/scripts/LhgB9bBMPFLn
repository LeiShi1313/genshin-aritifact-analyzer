wrio char lvl=90/90 cons=0 talent=9,9,9;
wrio add weapon="widsith" refine=3 lvl=90/90;
wrio add set="mh" count=4;
wrio add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
wrio add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.2648 cd=0.7944;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favoniuslance" refine=3 lvl=90/90;
shenhe add set="noblesseoblige" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.3972 cd=0.3972;					

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="favoniuslance" refine=3 lvl=90/90;
thoma add set="deepwood" count=4;
thoma add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.331 cd=0.1324;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622 ; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;    

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=50000000; 
energy every interval=480,720 amount=1;

active emilie;
for let r=0; r<4; r=r+1 {
  if r && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  if ( r / 2 ) * 2 == r {
    shenhe skill[hold=1], burst;
  } else {
    shenhe attack:2, skill[hold=1];
  }
  thoma skill, attack, burst;
  while !.thoma.mods.favonius-cd {
    thoma attack;
  }
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4, charge;
}