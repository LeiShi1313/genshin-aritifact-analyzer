neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.1986 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="favcodex" refine=3 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="favoniuscodex" refine=3 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 cr=0.311 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.331 cd=0.5958;

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="dragonsbane" refine=3 lvl=90/90;
raiden add set="fopl" count=5;
raiden add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.3641 cd=0.331;

options swap_delay=12 iteration=1000;

active neuvillette;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;


for let i=0; i<4; i=i+1 {
  neuvillette skill, attack;
  citlali skill, attack;
  if !.citlali.mods.favonius-cd {
    citlali attack;
  }
  nahida skill, attack;
  if !.nahida.mods.favonius-cd {
    nahida attack;
  }
  raiden skill, attack;
  citlali burst;
  neuvillette charge, burst, skill, charge;
  nahida attack:2, dash, attack;
  if !.nahida.mods.favonius-cd {
    nahida attack;
  }
  neuvillette charge, charge;
}

wait(173);
