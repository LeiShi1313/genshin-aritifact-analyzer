clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="blacksword" refine=1 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main 5* set
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1986 er=0.3306 em=39.64 cr=0.2648 cd=0.662;

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="mouun" refine=1 lvl=90/90;
sara add set="scroll" count=5;
sara add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466 ; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.1324;

xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="favgs" refine=3 lvl=90/90;
xinyan add set="no" count=4;
xinyan add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583 ;
xinyan add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active sara;
sara skill;
for let i=0; i<4; i=i+1 {
  chev burst, skill[hold=1], attack;
  xinyan skill, burst;
  if !.xinyan.mods.favonius-cd {
    xinyan dash;
  }
  sara aim;
  if .sara.burst.ready {
    sara burst;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  sara skill;
  clorinde burst;
}
