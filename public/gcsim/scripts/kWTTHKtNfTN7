yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="marechausseehunter" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ;
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tenacityofthemillelith" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="ttds" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
#bennett add set="no" count=4;
bennett add set="songofdayspast" count=4;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.4408 em=158.56 cr=0.0662 cd=0.1324;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=1000;

active furina;
for let i=0; i<6; i=i+1 {
  furina attack, skill, dash, burst;
  bennett burst, skill;
  if !.element.t0.pyro {
    bennett attack;
  }
  sucrose attack, skill, dash, attack; # first N1 will swirl pyro
  if .sucrose.burst.ready {
    sucrose burst;
  } else {
    sucrose attack:2; # las N3 hit can swirl hydro
  }
  yoimiya skill, attack:5, dash,
                 attack:5, dash,
                 attack:5, dash,
                 attack;
  if .yoimiya.burst.ready {
    yoimiya burst;
  } else {
    yoimiya attack:3;
    bennett attack;
  }
  bennett skill, attack;
}
