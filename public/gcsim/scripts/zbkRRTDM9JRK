# Lisa Kazuha Nahida Bennett. ~20s Rot. Lisa Overload in 2 Target, with Bennett & Kazuha on-field maintaining Pyro Aura. UR Bennett is better than support sets. Lesser performance in ST.

# Options ordered by DPS
lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="fruit" refine=5 lvl=90/90;
lisa add set="gd" count=4;
#lisa add set="scroll" count=4;
lisa add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.2204 em=158.56 cr=0.0662 cd=0.2648;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favsword" refine=3 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="ur" count=4;
#bennett add set="no" count=4;
#bennett add set="ins" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # 5*
#bennett add stats hp=3571 atk=232 atk%=0.3495 pyro%=0.466 cr=0.23325; #main
#bennett add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.194628 cd=0.500472; # 4*

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

# Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  nahida skill;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida attack, charge;
  }

  if i > 0 {
    lisa attack;
  }
  lisa skill[hold=1], burst; sleep(20); # Waiting for partcles is similar

  bennett skill, burst;

  kazuha skill, high_plunge, burst;

  bennett attack:2;
  while .bennett.burst.cd {
    if .kazuha.skill.ready {
      kazuha skill, high_plunge;
    } else if .bennett.skill.ready && .bennett.swap.ready {
      bennett skill;
    } else if .kazuha.onfield {
      kazuha attack;
    } else {
      bennett attack;
    }
  }

}
