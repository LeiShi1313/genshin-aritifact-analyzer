# Team
mizuki char lvl=90/90 cons=0 talent=9,9,9;
mizuki add weapon="evenstar" refine=1 lvl=90/90;
mizuki add set="vv" count=4;
mizuki add stats hp=4780 atk=311 em=187 em=187 em=187; # main
mizuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.4408 em=118.92 cr=0.2648 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.62 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.3972;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active xilo;

for let i=0; i<4; i=i+1 {
  xilo burst;
  furina skill, dash, burst;
  xilonen skill, attack:2;
  fischl skill, attack;

  mizuki attack, skill, burst;
  while .mizuki.status.dreamdrifter-state > 120 {
    wait(1);
  }
  xilonen attack, skill, attack:2;

  fischl attack:2, burst;

  mizuki attack:2, charge,
         attack:2, charge,
         attack:2, charge,
         attack:2, charge;
}
