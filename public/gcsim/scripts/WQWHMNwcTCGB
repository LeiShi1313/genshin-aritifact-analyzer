chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="dialoguesofthedesertsages" refine=5 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359;
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.5952 er=0.1102 em=39.64 cr=0.0662 cd=0.3972;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;


active mavuika;

for let i=0; i<4; i=i+1 {
  chev skill[hold=1], attack, dash;
  furina skill, dash, attack, burst;
  mavuika burst, charge:2, dash, charge, skill, dash;
  chasca skill;
  chasca aim:4;
  chasca aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    //
  }
}
wait(82); # 82f wait for the last 4bullet CA to hit

