# Razor Nahida Xingqiu Baizhu. ~24s Rot. Razor Double Dendro Hyperbloom. Deepwood Nahida w/ OHC Baizhu is nearly the same.

# Team
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="mailedflower" refine=5 lvl=90/90;
#razor add weapon="aquamarine" refine=1 lvl=90/90;
razor add set="fopl" count=4;
razor add stats hp=4780 atk=311 em=187 em=187 em=187; #main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.2979 cd=0.1986;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="favcodex" refine=3 lvl=90/90;
#nahida add set="deepwood" count=4;
nahida add set="gt" count=4; # DW Baizhu
nahida add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="deepwood" count=4;
#baizhu add set="ohc" count=4; # DW Nahida
baizhu add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active nahida;
#active razor;
#razor skill, dash;

for let i=0; i<4; i=i + 1 {
  nahida skill, burst;
  while !.nahida.mods.favonius-cd && !.xingqiu.burst.ready {
    nahida attack;
  }

  xingqiu skill, dash, burst, attack;
  while !.xingqiu.mods.favonius-cd && !.baizhu.burst.ready {
    xingqiu attack;
  }

  baizhu skill, burst;

  razor skill, dash, attack, burst;
  # razor EDN1 Q N3ED 2N3 N3ED 2N3 N2ED
  while .xingqiu.mods.xingqiuburst > 40 {
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  razor attack, skill, dash;
}
