# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freeze Immunity

# Ayaka Plunge Combo
fn AyakaPlunge() {
  ayaka jump;
  if .airborne {
    ayaka high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  if is_even(i) {
    esco burst;
  }
  esco skill;
  
  xianyun skill, low_plunge, burst;
  
  ayaka skill, dash; # It isn't worth waiting for Finale BOL to clear
  if !.ayaka.burst.ready {
    ayaka attack;
  }
  ayaka burst; 
  AyakaPlunge(); ayaka attack, dash;
  AyakaPlunge(); ayaka attack;
  AyakaPlunge(); ayaka attack;
  AyakaPlunge(); ayaka attack, charge;  # Cryo VV expires, removing Ayaka N1C for Xianyun N2 is a DPS loss
  ayaka dash, skill;
  AyakaPlunge(); ayaka attack;
  AyakaPlunge(); ayaka attack;
  AyakaPlunge();
}
