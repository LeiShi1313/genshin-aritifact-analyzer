for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  dori burst;
  kazuha skill, high_plunge, burst;
  yelan burst, attack, skill;
  kazuha attack, skill, high_plunge, attack;
  dori skill, attack:2, dash, attack:2;
  kazuha skill, high_plunge, attack;
  dori attack, skill, attack:2, dash, attack;
  yelan skill, attack, aim;
}

