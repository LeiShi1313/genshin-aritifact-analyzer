bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=140]; # to Fischl
bennett add set="no" count=4;
#bennett add set="deepwood" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2317 cd=0.662; # ATK
#bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.1324; # Heals

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active fischl;
fischl skill;

#active emilie;

#active aetherelectro;
#aetherelectro skill;

for let i=0; i<4; i=i+1 {
  # Forego burst if energy deficient
  if i > 0 && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  
  # Fill time
  if i > 0 {
    bennett attack:1, charge;
  }
  bennett skill, burst;
  
  # Use burst over skill
  amy attack;
  if .amy.burst.ready {
    amy attack, burst; # Easy to catch Sapwood leaf with phased movement
  } else {
    amy skill;
  }
  
  while .aetherelectro.mods.bennett-field || .status.bennettburst { 
    switch {
      case .aetherelectro.skill.ready:
        aetherelectro skill[hits=3, amulet_delay=107];
      case .aetherelectro.burst.ready:
        aetherelectro burst;
      #case .aetherelectro.normal > 4 && .stam > 25:
      #  aetherelectro charge;
      case .aetherelectro.normal > 3 && .aetherelectro.dash.ready && .stam > 18:
        aetherelectro dash;
      default:
        aetherelectro attack;
    }
  }
  
  bennett skill, attack; # clear Electro
  
  print("done");
}
