# Yoimiya Emilie Mavuika Bennett. ~19s Rot. Yoimiya burning. Yoimiya does a few extra normal attacks when she doesn't burst just for fighting spirit generation. Emilie & Yoimiya burst every other rot in alternate rotations. Mavuika bursts every rotation. Deepwood Mavuika, Mavuika cannot scroll reliably. 

# Team - Options listed by DPS
yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="slingshot" refine=5 lvl=90/90;
yoimiya add set="ur" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="earthshaker" refine=5 lvl=90/90;
mav add set="deepwood" count=4;
#mav add set="oc" count=4;
#mav add set="ur" count=4;
#mav add set="scroll" count=4; # Bad
mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Other
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # OC

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active emilie;
emilie skill;

for let i = 0; i < 4; i = i + 1 {
  bennett skill, burst;
  
  if i > 0 && .emilie.burst.ready {
    emilie burst;
  } else if .emilie.skill.ready {
    emilie skill, attack;
  }
  
  if .mav.burst.ready {
    mav burst, skill, charge:1, dash;
  } else {
    mav attack, skill;
  }
  
  bennett skill;
  
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack:1;
  if .yoimiya.burst.ready && i > 0 {
    yoimiya burst;
  } else {
    yoimiya attack:3; # Needed for fighting spirit generation
  }
}
