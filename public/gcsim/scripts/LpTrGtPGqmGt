# Raiden Emilie Xianyan Bennett. ~18s Rot. Raiden Emilie with Xinyan providing Pyro through her C2 burst. Emilie only uses burst.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="catch" refine=5 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 er=0.518 cr=0.311 electro%=0.466; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5]; # Leading Slot
#xinyan add weapon="akuoumaru" refine=1 lvl=90/90;
xinyan add set="no" count=4;
#xinyan add set="deepwood" count=4;
xinyan add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2648 cd=0.662; # SS
#xinyan add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
#xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.1986 cd=0.7944; # Akoumaru

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="deepwood" count=4;
#bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2648 cd=0.7282;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active xinyan; # SS Stacks

raiden skill, attack;

for let i=0; i<4; i=i+1 {
  bennett burst, skill;
  
  xinyan burst, skill;
  
  emilie burst;
  
  bennett skill;
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
}
