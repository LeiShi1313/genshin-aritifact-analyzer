charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="favcodex" refine=3 lvl=90/90;
charlotte add set="no" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.331 cd=0.4634;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active furina;
for let i=0; i<4; i=i+1 {
  furina attack, skill, burst;
  charlotte skill, burst, attack;
  kazuha skill, high_plunge;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax {
    wrio burst;
  } else {
    wrio charge;
  }
  kazuha skill, high_plunge;
}
