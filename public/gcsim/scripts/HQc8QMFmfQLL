options swap_delay=12 iteration=1000;

# Build assumptions
arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="fjords" refine=1 lvl=90/90;
arle add set="fohw" count=5;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="no" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="ttds" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187;
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworneye" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active yelan;
for let i = 0; i < 4; i = i + 1 {
  yelan attack, skill, burst, attack;
  arle skill;
  nicole skill, burst;
  sucrose skill, dash, attack;
  arle attack:3, charge,
       attack:3, charge,
       attack:3, charge,
       attack:3, charge,
       attack:3, dash,
       attack:3;
}
