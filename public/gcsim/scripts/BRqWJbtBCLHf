tighnari char lvl=90/90 cons=0 talent=9,9,9;
tighnari add weapon="slingshot" refine=5 lvl=90/90;
tighnari add set="wt" count=4;
tighnari add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
tighnari add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="sacjade" refine=1 lvl=90/90;
nahida add set="gt" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.2979 cd=0.4634;

lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="hakushinring" refine=5 lvl=90/90;
lisa add set="scroll" count=4;
lisa add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.331 cd=0.7944;

kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="favsword" refine=3 lvl=90/90;
kuki add set="deepwood" count=4;
kuki add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active tighnari;

for let i=0; i<4; i=i+1 {
  tighnari skill;
  kuki skill, attack;
  nahida skill, burst, charge;
  lisa attack:2, burst;
  tighnari aim:2, burst, aim:2;

  tighnari skill, attack;
  kuki burst;
  nahida attack, skill, attack, charge;
  lisa skill[hold=1];
  tighnari aim:5, attack;
}

# ~24s rotations
# Tighnari E > Kuki E N1 > Nahida E Q C > Lisa N2 Q > Tighnari 2[C] Q 2[C] E N1 > Kuki Q > Nahida N1 E N1C > Lisa hE > Tighnari 5[C] N1
