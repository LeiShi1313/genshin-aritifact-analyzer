bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 heal=0.359; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2979 cd=0.1324;															

# - Options

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# - Target

target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999; 

# - Actions

active furina;

for let i=0; i<5; i=i+1 {
  furina skill, dash, burst;
  if !i {
    bennett skill, burst;
  } else {
    bennett burst, skill;
  }
  if .fischl.burst.ready  {
    fischl attack:2, burst;
  } else {
    fischl attack:2, skill;
  }
  if i {
    furina attack:2;
  }
  klee attack, burst, walk,
       attack[travel=6], charge, #[travel=6] is added to make klee's n1 hit before each CA starts
       attack[travel=6], charge, #this is more accurate to gameplay, 
       attack, skill[bounce=3, mine=8], jump, #normal attacks only hit the enemy after the CA starts if the enemy is very far
       attack, walk, attack[travel=6], charge;
  if .klee.skill.ready {
    klee attack, skill[bounce=3, mine=8], jump;
    klee attack[travel=6], charge;
  } else {
    klee attack[travel=6], charge;
  }
  klee attack[travel=6], charge, 
       attack, walk, attack[travel=6], charge,
       attack[travel=6], charge,
       attack, walk;
}

# Klee "Overvape", but she barely does any reaction damage: Klee, Fischl, Furina, Bennett. The whole team recieves at least 1 tick of bennett healing per rotation after the first rotation.
# First Rotation: Furina E D Q, Bennett E Q, Fischl N2 Q, Klee N1QW 2N1C N1EJ N2C N1EJ N1C N2C N1C N1W
# Subsequent Rotations: Furina E D Q, Bennett Q E, Fischl N2 E/Q, Klee N1QW 2N1C N1EJ N2C 2N1C N2C N1C N1W
# Klee strings together her NAs with walk cancels to do repeated N1s in her N2Cs
