#chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.4634;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=1000;

#-------------------------------------------- 

active furina;
furina skill, dash, burst;
for let i=0; i<4; i=i+1 {
  if i {
    furina burst, skill, attack;
  }
  kaz burst;
  chev burst, skill[hold=1];
  kaz skill, high_plunge;
  klee attack, walk, attack, burst, walk, attack[travel=6], charge; #[travel=6] is added to make klee's n1 hit before each CA starts
  if !i {
    klee  attack, skill[bounce=3, mine=8], jump; #this is more accurate to gameplay, 
  } else {
    klee attack[travel=6], charge; #normal attacks only hit the enemy after the CA starts if the enemy is very far
  }
  klee attack, skill[bounce=3, mine=8], jump;
 
  for let r = 5; r> 0; r = r - 1 {
    klee attack[travel=6], charge; # 5N1C
  }  
  klee attack;
  kaz skill, high_plunge;
}




