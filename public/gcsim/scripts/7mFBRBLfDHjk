# Hutao Fischl Yae Yelan. ~16s Rot. Hutao Overvape. 6N3CJ N2CD Hutao. No burst Yae. 1E Yelan.

# Team
hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="fjords" refine=1 lvl=90/90;
#hutao add weapon="dbane" refine=3 lvl=90/90;
hutao add set="sr" count=4;
#hutao add set="cw" count=4;
#hutao add set="gd" count=4;
hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
#yae add set="gt" count=4;
yae add set="tom" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=0,1.8 hp=100000000;

# Rotation
active yae;

for let i=0; i<4; i=i+1 {
  yae skill:3;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl skill, attack;
  }
  
  if .previous-action == .action.burst {
    hutao attack;
  }
  hutao skill,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:2, charge, dash;
    
  print("done");
}
