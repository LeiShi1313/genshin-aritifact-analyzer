# Dori Furina Nahida Tighnari. ~25s Rot. Thundering Fury Dori uses skill 3x per rotation while her lamp triggers hyperbloom while she is off-field. Tighnari uses skill/burst just twice/once per rotation. Nahida omits burst in the first rotation.

# Team - Options listed by DPS
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="aquamarine" refine=1 lvl=90/90;
#dori add weapon="mailedflower" refine=5 lvl=90/90;
dori add set="tf" count=4;
dori add stats hp=4780 atk=311 em=187 em=187 em=187; # main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.3641 cd=0.331; # 3EM
#dori add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main
#dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=198.2 cr=0.1324 cd=0.5296; # EDC

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.3641 cd=0.331;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3641 cd=0.7282;

tighnari char lvl=90/90 cons=0 talent=9,9,9;
tighnari add weapon="stillness" refine=5 lvl=90/90;
tighnari add set="mh" count=4;
tighnari add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
tighnari add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active nahida;

for let i=0; i<4; i=i+1 {
	nahida skill;
	if i > 0 {
	  nahida burst;
	}
	
	furina skill, dash, burst;
	
	dori skill, attack:2, dash, attack:2, burst;
	
	tighnari skill, aim, burst:1, aim:2;
	
	dori skill, attack:2, dash, attack:2;
	
	nahida skill, attack, charge;
	
	dori skill, attack:2;
	
	tighnari skill, aim:3;
}
