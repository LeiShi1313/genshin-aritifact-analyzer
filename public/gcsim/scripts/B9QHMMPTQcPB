arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="fjords" refine=1 lvl=90/90;
arle add set="fohw" count=5;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; 
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
        
yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=4 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311 ;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="ttds" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active yelan;

for let i = 0; i < 4; i = i + 1 { # total 4rots, 2 TTDS rots
  yelan attack, skill, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack;
  }
  arle skill;
  bennett skill, burst;
  sucrose attack:3, skill, dash;
  if .sucrose.burst.ready {  # every 3rots, this burst is only ~1.5k increase over not using it
    sucrose burst;
  }
  arle attack:3, charge, 
       attack:5, dash,
       attack:5, dash, 
       attack:3, dash;
       
  #N3C 2[N5D] N3
  #N3C 6[N3D] also works. more Arle damage and less Yelan damage
}
