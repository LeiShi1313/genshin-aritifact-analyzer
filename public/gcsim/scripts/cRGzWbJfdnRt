#configuration                                                                                                                                                                                                                                                        
options swap_delay=12 iteration=1000;                                                                        
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

#rotation
active raiden;
raiden skill;
for let i = 0; i < 4; i = i + 1 {
  sara skill, aim; #Sara buffs herself first for better Bennett uptime and better personal damage
  bennett burst; #if low ping, you can swap to Chevreuse fast enough to get Sara's buff, hence Bennett's skill is skipped
  chevreuse burst, attack, skill[hold=1]:3;
  sara burst;
  raiden burst, 
    attack:3, charge, dash, 
    attack:3, charge, dash, 
    attack:2, charge, dash, 
    attack, charge, dash, 
    skill;
  bennett skill, attack;
  chevreuse attack:3; # funnel Pyro particles to Chev
}

