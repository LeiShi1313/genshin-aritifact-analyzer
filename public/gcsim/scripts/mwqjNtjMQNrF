options swap_delay=12 iteration=1000;

active mualani;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

mualani attack; # for hydro swirl in the 1st rot
for let i=0; i<2; i=i+1 {
  kazuha skill, high_plunge;
  xiangling burst, skill, dash;
  candace skill, burst, attack;
  #if !.candace.mods.favonius-cd { # if candace is holding 4star artifact set, enable if condition
  #  candace attack;
  #} else {
    wait(8); #catch her own hydro particles on-field
  #}
  mualani burst;
  mualani skill;
  mualani_combo();
  if .mualani.nightsoul.state {
    mualani skill; # exit the nightsoul state
  }
  while !.element.t0.hydro {
    mualani attack;
  }

  kazuha skill, high_plunge;
  xiangling attack:3;
  if !.xiangling.mods.favonius-cd {
    xiangling attack;
  }
  xiangling skill, dash;
  kazuha burst;
  candace skill, burst, attack;
  #if !.candace.mods.favonius-cd { # if candace is holding 4star artifact set, enable if condition
  #  candace attack;
  #} else {
    wait(8); #catch her own hydro particles on-field
  #}
  mualani skill;
  mualani_combo();
  if .mualani.nightsoul.state {
    mualani skill; # exit the nightsoul state
  }
  while !.element.t0.hydro {
    mualani attack;
  }
}

