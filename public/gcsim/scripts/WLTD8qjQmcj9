# Ganyu Escoffier Zhongli Chiori. ~18s Rot. Ganyu double Geo with Escoffier. Attempts 50% weakspot hits with Protoype Crescent; FWF without headshots is -2K DPS. Ganyu & Escoffier only bursts when available & Chiori bursts to fill time for her skill CD. With full uptime, ToM Zhongli is less than 1K behind AP.

# Team - Options Listed by DPS
ganyu char lvl=90/90 cons=0 talent=9,9,9;
ganyu add weapon="crescent" refine=5 lvl=90/90;
#ganyu add weapon="flowerwreathedfeathers" refine=1 lvl=90/90;
#ganyu add weapon="scion" refine=1 lvl=90/90;
ganyu add set="bs" count=4;
ganyu add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Other
#ganyu add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
#ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # Scion

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="ap" count=4;
#zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="cinnabar" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
chiori add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2648 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# --- Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=1000000000;

# Protoype Crescent Headshot Conditional
fn ganyuAim() {
  if .ganyu.weapon == .keys.weapon.crescent { # Attempts headshots (50%) with Crescent
    ganyu aim[hold=2, weakspot=rand()>0.5];
  } else { # Non weakspot opponents
    ganyu aim[hold=2];
  }
}

# Rotation
active chiori;

for let i=0; i<4; i=i+1 {
  if i > 0 && .esco.burst.ready {
    esco burst;
  }
  esco skill;

  if i == 0 && .zl.sets.ap >= 4 { # Needed for initial crystallize shard pickup
    zl skill[hold=1], dash, attack:2, dash; pick_up_crystallize("any");
  } else {
    zl attack, skill[hold=1], dash; pick_up_crystallize("any");
  }

  if .chiori.skill.cd && .chiori.burst.ready {
    chiori burst;
  }
  chiori skill:2;

  ganyu skill;
  if .ganyu.burst.ready {
    ganyu burst;
  } else {
    ganyuAim();
  }
  ganyuAim();
  ganyuAim();
  ganyuAim();
  ganyuAim();
  ganyuAim();
  if i > 0 && .chiori.burst.cd {
    ganyu aim;
  }
}
