# --- Pre-action hook setup

let _execute_action = execute_action;

fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.yelan && action_id == .action.skill ) {
    pick_up_crystallize("any"); # Pick up crystallize before every dash and Yelan E
  }

  return _execute_action(char_id, action_id, p);
}

chongyun char lvl=90/90 cons=6 talent=9,9,9;
#chongyun add weapon= "lithicblade" refine=1 lvl=90/90;
chongyun add weapon= "serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
