options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=1 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active yelan;

yelan aim;

for let i=0; i<4; i=i+1 {
  navia burst;
  if !i {
    zhongli skill[hold=1], dash;
  } else {
    zhongli skill[hold=1], dash, attack;
  }
  yelan burst, attack, skill, attack;
  chongyun burst, attack, skill;
  navia attack, skill, attack:3, dash, attack:3; #in-game can fit n3 within CY infusion
  navia skill[hold=1];
  yelan attack, skill, attack;
  navia attack:2, skill[hold=1], attack:3, dash, attack:2;
}
