#dori add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
#dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.3972 cd=0.2648; # Nahida Fav


# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active nahida;
#active razor;
#razor skill, dash; # Max sigils in 1st rot

for let i=0; i<4; i=i + 1 {
  # Forego Nahida burst if energy deficient
  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  }  else {
    nahida charge;
  }
  
  xingqiu skill, dash, burst, attack;
  
  dori skill, attack, burst;
  
  razor attack;
  # Razor out of burst actions; account for energy deficiency
  while !.razor.mods.razor-q {
    if .razor.burst.ready && .razor.skill.ready && .razor.energy == .razor.energymax {
      razor skill, dash, attack, burst;
    } else if .razor.burst.ready {
      razor burst;
    } else if .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  # Razor Main DPS window; Burst ends 3.5s early
  while .xingqiu.mods.xingqiuburst { 
    if .razor.normal > 3 && .razor.skill.ready {
        razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  #razor skill, dash;
  
  # Notation
  # Razor ED (1st Rot) > 
  # Nahida EN1Q/EN1 > Xingqiu EDQN1 > Dori EN1Q >
  # Razor N1EDN1Q N3ED N3D N3D N3ED N3D N3D N2ED
}
