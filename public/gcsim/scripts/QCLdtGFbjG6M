xingqiu add weapon="favsword" refine=3 lvl=90/90;
#xingqiu add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=130]; # to Dori
#xingqiu add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=270]; # to Razor
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Fav
