# Mavuika Rosaria Kaeya Bennett. ~19s Rot. Mavuika double Cryo Melt without Natlan. Mavuika Q 6[C2D], Q 11C D is -6K DPS.

# Team - Options listed by DPS
mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=39.64 cr=0.1324 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favspear" refine=3 lvl=90/90;
rosaria add set="scroll" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

kaeya char lvl=90/90 cons=6 talent=9,9,9;
kaeya add weapon="favsword" refine=3 lvl=90/90;
kaeya add set="ins" count=4;
kaeya add stats hp=3571 atk=232 er=0.3885 cryo%=0.3495 cr=0.311;
kaeya add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.333648;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

let Mav6C2D = true;

# Rotation
active mavuika; # SS Stacks

for let i=0; i<4; i=i+1 {
  mavuika skill;

  bennett burst, skill;

  rosaria skill, attack, burst;

  kaeya skill, attack, burst;

  while !.mavuika.burst.ready {
    mav attack;
  }
  mavuika burst;
  if Mav6C2D == true {
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
  } else {
    mavuika charge:11, dash;
  }
}
