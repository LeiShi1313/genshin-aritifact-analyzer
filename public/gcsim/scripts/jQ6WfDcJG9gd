#team config

itto char lvl=90/90 cons=0 talent=9,9,9;
itto add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
itto add set="husk" count=4; #no husk prestack on serpent
itto add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mainstats
itto add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

gorou char lvl=90/90 cons=6 talent=9,9,9;
gorou add weapon="favoniuswarbow" refine=4 lvl=90/90;
gorou add set="theexile" count=4;
gorou add stats hp=3571 atk=232 er=0.387 def%=0.435 cr=0.311; #mainstats
gorou add stats def%=0.124 def=31.48 hp=406.3 hp%=0.0794 atk=26.46 atk%=0.0794 er=0.3086 em=31.72 cr=0.265 cd=0.1324;

kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="favoniussword" refine=3 lvl=90/90;
kuki add set="totm" count=4;
kuki add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbingerofdawn" refine=5 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mainstats
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

#enemy config

options swap_delay=12 iteration=2000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
active kuki;

#action list

for let i = 0; i < 4; i = i + 1 {

  kuki skill;

  while !.kuki.mods.favonius-cd {
    kuki attack;
  }


  gorou skill, burst;
  chiori burst, skill:2;

  if i == 0 {
    itto attack, burst[prestack=1],
         attack, skill,
         attack:2, charge:5,
         attack:4, charge:5, skill[travel=0], charge;
         sleep(21); #catch ushi particles

         #"C0 1PS" combo

  } else {
    itto attack, burst[prestack=1],
         attack, skill, charge:4,
         attack:3, charge:4,
         attack:3, skill, charge:4;

         #"C0 2PS" combo

  }

}
