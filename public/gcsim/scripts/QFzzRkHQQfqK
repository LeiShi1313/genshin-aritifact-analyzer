
mualani char lvl=90/90 cons=0 talent=2,10,10;
mualani add weapon="sacrificialjade" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=4;
mualani add stats def%=0.073 hp=5049 hp%=0.8280000000000001 atk=368 atk%=0.192 em=266 cr=0.035 cd=1.29 hydro%=0.466;

candace char lvl=90/90 cons=5 talent=1,1,1;
candace add weapon="favoniuslance" refine=5 lvl=90/90;
candace add set="scrolloftheheroofcindercity" count=4;
candace add stats def%=0.19 def=63 hp=5079 hp%=0.717 atk=379 atk%=0.105 er=1.102 em=105 cr=0.423 cd=0.186;

mavuika char lvl=90/90 cons=0 talent=1,10,10;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="scrolloftheheroofcindercity" count=4;
mavuika add stats def=53 hp=5079 hp%=0.233 atk=311 atk%=0.676 er=0.057999999999999996 em=118 cr=0.392 cd=1.213 pyro%=0.466;

sucrose char lvl=90/90 cons=6 talent=1,1,1;
sucrose add weapon="sacrificialfragments" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats def=58 hp=5497 hp%=0.45399999999999996 atk=389 atk%=0.164 er=0.17500000000000002 em=667.5 cr=0.132 cd=0.45;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active candace;

fn mualani_combo() {
  mualani skill;
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 { # 3 bites
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
  break;
  }
}

for let i=0; i<5; i=i+1 {
  wait(100);
  candace skill, burst, attack:2;
  sucrose skill;
  mavuika skill[hold=1], burst, attack;
  mualani_combo();
  if .mualani.burst.ready && .mualani.energy == .mualani.energymax {
    mualani burst;
    wait(70);
  }
}