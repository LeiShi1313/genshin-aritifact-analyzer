# Yae Nahida Xianyun Fischl. ~24s Rot. Yae Aggravate plunge. Yae bursts every rotation after her first plunge. Xianyun refeshes VV mid rotation. 50% Collisons.

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="thewidsith" refine=3 lvl=90/90;
yae add set="ts" count=5;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="tom" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.2648 cd=0.5296;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.551 em=198.2 cr=0.0662 cd=0.1324;

options iteration=1000;  options swap_delay=12;

energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

active yae;

for let x=0; x<4; x=x+1 {
  if x==0 {
    yae skill:3;
  } else {
    yae attack, skill, attack, skill, attack, skill, attack;
  }
  nahida skill, burst, attack;
  fischl attack, skill;
  xianyun attack, skill, low_plunge, burst;
  yae attack, jump, low_plunge[collision=rand()>0.5], burst, skill:2, attack, skill;

  for let i=0;i<2;i=i+1 {
    yae jump;
    if .airborne {
      yae low_plunge[collision=rand()>0.5], dash;
    }
  }

  xianyun attack:2;
  fischl attack:2, burst;

  yae attack;
  for let i=0;i<5;i=i+1 {
    yae jump;
    if .airborne {
      yae low_plunge[collision=rand()>0.5], dash;
    }
  }
}
