# Target and Energy
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

# Rotation
active arle;
for let i=0; i<4; i=i+1 {
  
  arle skill;
  bennett skill, burst;
  lynette attack, skill;
  kaeya skill, burst;
  arle  charge, 
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3;
}

