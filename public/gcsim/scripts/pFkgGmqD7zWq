// aino add weapon="aquamarine" refine=1 lvl=90/90;
// aino add set="silkenmoonsserenade" count=4;
// aino add stats hp=4780 atk=311 er=0.518 em=187 em=187;
// aino add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=158.56 cr=0.2648 cd=0.1324;

aino char lvl=90/90 cons=6 talent=9,9,9;
aino add weapon="favoniusgreatsword" refine=3 lvl=90/90;
aino add set="silkenmoonsserenade" count=4;
aino add stats hp=4780 atk=311 em=187 em=187 cr=0.311;
aino add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active bennett;

for let i = 0; i < 6; i = i + 1 {
  bennett skill[hold_c4=1], burst;
  ineffa swap;
  if i && .ineffa.burst.ready && .ineffa.energy == .ineffa.energymax {
    ineffa burst, skill;
  } else {
    ineffa attack, dash, skill;
  }
  aino skill, burst;
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if is_even(i) {
    yoimiya burst;
  } else {
    yoimiya attack:2, dash; // wait for 18s cd
  }
}
