# Bennett Columbina Fischl Ineffa. ~20s Rot. Lunar Overvape Bennett with Furina. Bennett spams N2C and tE off CD. Fischl alternates skill and burst in Bennett field. EDC > EEC > 3EM Bennett, reverse if using Thundering Fury (-2k DPS).
# Upcoming: Bennet: Exaiphanes Blade? Heretic's Molten Blade? Emberwell? Fischl: Jade Vista?

# Team - Options ordered by DPS
bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="umbrella" refine=5 lvl=90/90;
#bennett add weapon="umbrella" refine=5 lvl=90/90; # Umbrella > Alleyflash
#bennett add weapon="wolffang" refine=1 lvl=90/90; # WF > Eshu
bennett add set="cw" count=4;
#bennett add set="tf" count=4;
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*5 cr=0.0331*9 cd=0.0662*12; # EDC/Umbrella
