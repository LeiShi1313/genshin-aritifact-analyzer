#bennett add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*2 em=19.82*6 cr=0.0331*12 cd=0.0662*7; # 3EM/TF

