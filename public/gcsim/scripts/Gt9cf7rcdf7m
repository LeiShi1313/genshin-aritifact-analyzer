# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000; # Rear

# Combos
fn sethosCombo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk, 
         skill;
}

# Rotation
#active nahida;

active sethos;
sethos aim[hold=2];

for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  if i > 0 && .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }
  
  if .mav.burst.ready {
    mav burst, skill;
  } else {
    mav attack, skill;
  }
  
  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
  
  if .sethos.skill.cd {
    nahida attack:2, skill, charge;
  }
  
  sethos skill; #aim[hold=2] # High ping only; dodges energy drain
  sethosCombo();
  sethos aim[hold=2]:2;
}
