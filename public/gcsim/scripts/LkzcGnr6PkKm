hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="balladofthefjords" refine=1 lvl=90/90;
hutao add set="mh" count=4;
hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
hutao add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2979 cd=0.662 ;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=4 lvl=90/90;
yelan add set="emblemofseveredfate" count=4;
yelan add stats def%=0.124 def=39.36 hp=5287.88 hp%=0.6644 atk=344.08 atk%=0.0992 er=0.1104 em=39.64 cr=0.642 cd=0.7944 hydro%=0.466;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="pamber" refine=5 lvl=90/90;
baizhu add set="sodp" count=5;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466 ; #main
baizhu add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2648 cd=0.1324 ;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=500 ;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=10000000;
energy every interval=480,720 amount=1;

active furina;

for let i = 0; i<4; i=i+1 {
  furina skill, dash, burst;
  baizhu skill, burst;
  yelan burst, attack;
  if i && .hutao.burst.ready{  #fill time for Yelan e cooldown, Hutao's nas do the most dmg w/o a c6 yelan or furina, can also just Yelan n5
    hutao burst;
  } else {
    hutao attack:4;
  }
  yelan attack, skill, attack;
  hutao skill,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:2, charge, jump, attack;
  yelan skill, attack:2;
  if !i {
    furina attack:1; #fill downtime on first rotation
  }
}
