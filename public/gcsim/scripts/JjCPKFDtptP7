# ----  Default Enemy
options swap_delay=12 debug=true iteration=1000;

#target lvl=100 resist=0.1 hp=100000000 pos=0,2 radius=1.5;
#target lvl=100 resist=0.1 hp=100000000 pos=0,5.5 radius=1.5;

target lvl=100 resist=0.1 hp=100000000 pos=-2.4,2.4 radius=2;
energy every interval=480,720 amount=1;

active neuv;
for let i = 0; i < 4; i = i + 1 {
  neuv skill;
  kazuha skill,high_plunge,burst;
  zhongli skill[hold=1], dash, attack;
  for let j=0; j<30; j=j+1 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    }
    if pick_up_crystallize("hydro") {
      break;
    }
    wait(1);
  }
  dori skill,attack,burst;
  neuv charge, burst, skill,charge;
  kazuha skill,high_plunge;
  zhongli attack, skill, dash;
  for let j=0; j<30; j=j+1 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    }
    if pick_up_crystallize("hydro") {
      break;
    }
    wait(1);
  }
  neuv charge:2;
}
wait(173);
