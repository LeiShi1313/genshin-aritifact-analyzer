kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favoniussword" refine=3 lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kazuha add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324 ;
																											            
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active yoimiya;
for let x=0; x<2; x=x+1 {
  yoimiya burst;
  kazuha skill, high_plunge, burst;  # pyro burst
  yelan skill, attack, burst, attack;
  fischl attack:2, burst;            # use fischl Q's 2U. with unlucky timing, Yoimiya Q may remove electro aura.
  kazuha attack, skill, high_plunge; # Hydro and Electro Double swirl
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash;
  
  yoimiya aim[hold=2];           # aimed shot removes remaining aura. kindling arrow applies pyro to swirl
  kazuha skill, high_plunge, burst;  # need 2nd enemy for pyro burst
  yelan skill, attack, burst, attack;
  fischl attack:2, skill;            # trigger yelan Q for hydro
  kazuha skill, high_plunge;         # Hydro and Electro Double swirl
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
}