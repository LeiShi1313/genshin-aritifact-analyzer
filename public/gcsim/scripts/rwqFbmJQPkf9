arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
arle add set="ur" count=4;
#arle add set="fohw" count=4;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622;
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90; #+params=[stacks=10];
fischl add set="gt" count=4;
#fischl add set="deepwood" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2648 cd=0.7282;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
#bennett add set="deepwood" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active arle;

active arle;
for let i = 0; i < 4; i = i + 1 {
  arlecchino skill;
  bennett swap; delay(12);  # wait for Arle E particles before Q cast
  bennett skill, burst;
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }
  if ( i / 2 ) * 2 != i {
    emilie attack, burst;
  } else {
    emilie attack:2, skill;
  }
  arlecchino charge,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack;
  
  print("done");
}
