# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

fn mav_dc_cancel(d_travel_f) { # d_travel_f should be 6-24. https://docs.gcsim.app/reference/characters/mavuika#params
  # To prevent Error when Mavuika tries to do D*C without enough NS points, jump instead.
  if d_travel_f < 6 {
    d_travel_f = 6;
  }

  let dash_ns = 10; # 10 consumption on dash use
  let base_cons = 0.9; # 0.9 points
  let base_tick_rate = 6;

  while !.mavuika.dash.ready {
    print("waiting on mavuika dash cd");
    wait(1);
  }

  let d_ticks = d_travel_f / base_tick_rate + 1; # +1 in case you get unlucky with tick timing
  print("Max number of NS ticks during dash: ", d_ticks);
  let ns_consumed = dash_ns + base_cons * d_ticks;
  print("Expected NS consumption: ", ns_consumed);

  if .mavuika.nightsoul.points > ns_consumed || .mavuika.status.mavuika-burst {
    mavuika dash[charge_cancel=1, travel=d_travel_f], charge;
  } else {
    print("current NS points = ", .mavuika.nightsoul.points);
    print("skipping mav d*c, not enough NS points ");
    mavuika jump;
  }
}

let UseXilonenDash = false;  # change this value between true and false to make Xilonen use dash or not

active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  bennett skill, burst;
  xilonen skill, attack:2;
  if UseXilonenDash == true {
    xilonen dash;   # dash to pick up the shard
  }
  pick_up_crystallize("pyro");
  citlali skill, burst, attack:2;   // Citlali E -> Mav E tick -> Q(remove Pyro) N1(Cryo on the enemy). Pyro app shouldn't happen after Citlali Q
  mavuika burst;                                                              // Q      // Q
  mavuika charge:3, charge[hold=6], charge[final=1];                          // C3F    // CccF
  mav_dc_cancel(6); mavuika charge[hold=6], charge[final=1];                  // D*C1F  // d*cF
  mav_dc_cancel(6); mavuika charge[hold=6], charge[final=1];                  // D*C1F  // d*cF
  mav_dc_cancel(6); mavuika charge[hold=40], charge[final=1];                 // D*C1F  // d*cF  // No Mavuika Q buff on F

  if UseXilonenDash == false {   # if you didn't use Xilonen's dash, you need to do extra action to make it 18s rot length
    delay(14);
  }
}

# D* means charge cancel dash

# Mavuika E N1 > Bennett EQ > Xilonen E N2  > Citlali EQ N2 > Mavuika Q C3F 2[D*C1F] D C1F > repeat

# Mavuika upper case for Melt
# Mavuika E N1 > Bennett EQ > Xilonen E N2  > Citlali EQ N2 > Mavuika Q CccF 2[d*cF] d cF > repeat
