options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active tartaglia;

for let i = 0; i < 4; i = i + 1 {
  tartaglia aim;
  citlali attack, skill, attack, burst;
  bennett burst, skill;
  xiangling burst, skill, dash;
  tartaglia walk, burst, walk[f=11], skill,
    attack:2, charge, jump,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge;
  bennett attack, skill;
  xiangling attack, skill, dash;
  childe aim;
  bennett skill;
}

# ~25s rotations
# Tartaglia C > Citlali N1 E N1 Q > Bennett Q E > Xiangling Q ED > Tartaglia W QW E N2CJ 4[N2CD] N2C > Bennett N1 E > Xiangling N1 ED > Childe C > Bennett E