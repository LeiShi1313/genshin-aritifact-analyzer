lauma add weapon="ttds" refine=5 lvl=90/90;
lauma add set="ap" count=4;
lauma add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*10 cr=0.0331*6 cd=0.0662*10;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scrolloftheheroofcindercity" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.062*5 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mavuika;

for let i = 0; i < 4; i = i + 1 {
  mavuika skill;
  xilonen skill, attack:2;
  bennett skill, burst;
  lauma skill, dash;
  pick_up_crystallize("pyro");
  if !.mavuika.burst.ready {
    mavuika swap, charge; # Bennett infused CA
  }
  mavuika burst, charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:2, charge[final=1];
}

