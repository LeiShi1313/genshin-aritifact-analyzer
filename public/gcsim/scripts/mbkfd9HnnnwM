# Varesa Furina Columbina Xianyun. ~20s Rot. KQMS KurtC. Varesa Lunarcharge with Xianyun. Varesa swaps in to do a normal attack before Xianyun to ensure Electro VV. Columbina bursts if available.

# Team
varesa char lvl=90/90 cons=0 talent=9,9,9;
varesa add weapon="widsith" refine=3 lvl=90/90;
varesa add set="lno" count=4;
varesa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
varesa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="sms" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="tom" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*9 cr=0.0331*7 cd=0.0662*10;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*8 er=0.0551*8 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # Right

# Funtion
# Varesa Plunge
fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    } else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
      varesa jump;
      if .airborne {
        varesa high_plunge[collision=1]; # JP
      }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

# Rotation
active columbina;
columbina skill;

for let i=0; i<4; i=i+1 {
  if !is_even(i) {
    columbina skill, burst;
  } else if i > 0 {
    columbina skill, attack;
  }

  if is_even(i) && i > 0 {
    furina skill, dash, attack, burst;
  } else {
    furina skill, dash, burst;
  }

  if !.element.t0.electro {
    varesa attack:2;
  }

  xianyun skill, low_plunge, burst;

  varesa_combo(6);

  xianyun attack:2; # Refreshing 4pc VV
}
