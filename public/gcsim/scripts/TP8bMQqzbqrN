//C0 rotation
//mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.2317 cd=0.662;
//C1 rotation
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

options swap_delay=12 iteration=1000;

active mavuika;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

for let i=0; i<4; i=i+1 {
  mualani attack;
  if i {
    mualani charge;
  }
  if .mavuika.cons == 0 {
    xilonen skill, attack:2;
    kazuha skill, high_plunge;
  } else {
    kazuha skill, high_plunge;
    xilonen skill, attack:2;
  }
  mavuika burst, skill;
  mualani skill;
  mualani_combo();
  if is_even(i) {
    mualani burst;
  } else {
    xilonen burst, jump:2;
  }
}

# C1 Mavuika rotation
# Mualani N1C > Kazuha tEP > Xilonen E N2 > Mavuika Q E > Mualani E 3[3-stacked bite] Q >
# Mualani N1C > Kazuha tEP > Xilonen E N2 > Mavuika Q E > Mualani E 3[3-stacked bite] > Xilonen Q
