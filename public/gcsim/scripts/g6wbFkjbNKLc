#team config

itto char lvl=90/90 cons=6 talent=9,9,9;
itto add weapon="redhorn" refine=5 lvl=90/90;
itto add set="marechausseehunter" count=5;
itto add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mainstats
itto add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

albedo char lvl=90/90 cons=0 talent=9,9,9;
albedo add weapon="cinnabarspindle" refine=5 lvl=90/90;
albedo add set="goldentroupe" count=5;
albedo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #mainstats
albedo add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
albedo add stats geo%=0.125; #albedo A1

gorou char lvl=90/90 cons=6 talent=9,9,9;
gorou add weapon="favoniuswarbow" refine=5 lvl=90/90;
gorou add set="noblesse" count=5;
gorou add stats hp=4780 atk=311 er=0.518 geo%=0.466 cr=0.311; #mainstats
gorou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=3 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="goldentroupe" count=5;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cd=0.622; #mainstats
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662 ;

#enemy config
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

#sim config
options swap_delay=12 iteration=1000;
active furina;

#action list

   for let i=0; i<4; i=i+1 {

   furina skill, dash, burst;
   gorou attack, skill, burst;
   albedo attack, skill;

   itto attack, burst, skill[travel=0];

       while !.itto.skill.ready {
       if .itto.tags.strStack > 0 { itto charge; }
       else { itto attack; }
       } #manage itto C6 until second ushi

       itto skill[travel=0];

       while .itto.mods.itto-q {
       if .itto.tags.strStack > 0 { itto charge; }
       else { itto attack; }
       } #manage itto C6 until Q expires

   }
