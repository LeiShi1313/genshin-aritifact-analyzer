#Options, target and energy
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

#function to wait for cryo
fn WaitForCryo() {
  let StartFrame = f();
  if !.element.t0.pyro {      # If the enemy aura is not Pyro, wait for Cryo aura (so if its already Pyro you don't wait)
    while !.element.t0.cryo && f() - StartFrame < 120 {   # wait but up to 120f(2s), so you don't wait forever
      wait(1);
    }
  }
}

active arlecchino;

for let i=0; i<4; i=i+1{
  arle skill;
  bennett skill, dash, burst;
  escoffier skill, attack;
  citlali skill, burst;
  arle charge;
  sleep(30);
  WaitForCryo();
  arle attack:2, walk,
       attack:2;
  citlali attack:2; #swap in citlali to reapply cryo
  arle attack:2, walk,
       attack:2, walk,
       attack:4;
  WaitForCryo();
  arle attack:1;
  WaitForCryo();
  arle attack:1,
       attack:1;
}


