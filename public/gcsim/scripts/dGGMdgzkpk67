# Dori Nahida Fischl Xingqiu. ~24s Rotation. Dori Hyperbloom with Xingqiu. Low ER XQ has multiple viable weapon option; see config.

# Team- Options listsed by DPS
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="aquamarine" refine=1 lvl=90/90;
#dori add weapon="mailedflower" refine=5 lvl=90/90;
#dori add weapon="rainslasher" refine=3 lvl=90/90;
#dori add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
dori add set="tf" count=4;
dori add stats hp=4780 atk=311 em=187 em=187 em=187; #main
dori add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # EM Weps
#dori add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; # main
#dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # SS

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="wanderingevenstar" refine=1 lvl=90/90;
#nahida add weapon="hakushinring" refine=5 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=118.92 cr=0.1324 cd=0.5958;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # EM/Cr
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ATK/Cr

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=150]; # Leaf to Fischl
#xingqiu add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=190]; # Leaf to Nahida
#xingqiu add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=260]; # Leaf to Nahida
#xingqiu add weapon="festering" refine=5 lvl=90/90;
#xingqiu add weapon="amenoma" refine=5 lvl=90/90;
#xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
#xingqiu add set="no" count=4; # Fav, FD
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

# Rotation
active fischl;
#active dori; #SS Stacks

for let i=0; i<4; i=i+1 {
  fischl skill, attack;

  nahida skill, attack, charge, burst;

  dori skill, attack:2, dash, attack:2, burst;

  xingqiu skill, dash, burst, attack;

  fischl attack:2, burst;

  nahida skill, attack, charge;

  dori skill, attack:2, dash, attack:2;

  nahida skill, attack, charge;

  dori skill, attack:2, dash, attack:2;
  print("done");
}
