# Razor Chevreuse Yae Bennett. ~20s Rot. Pyro Infused Razor deals slightly more Pyro DMG; Yae after Chevreuse, before Bennett. Razor monopolizes Bennett field time. Self-Overloads not implemented. 

# Team- Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#razor add weapon="talkingstick" refine=1 lvl=90/90; razor add stats atk%=0.16 pyro%=0.12; # mock implementation
razor add set="echoes" count=4; 
#razor add set="glad" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD + Pyro; Echoes
#razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD + ATK; TS
#razor add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # CR + Pyro; TS

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
#chev add weapon="dialogues" refine=5 lvl=90/90;
chev add set="scroll" count=4;
#chev add set="sodp" count=4;
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296; # Hp/Hp/Cr
#chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
#chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3972 cd=0.3972; # Hp/Hp/Hp
#chev add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
#chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ADC

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="flowingpurity" refine=5 lvl=90/90;
#yae add weapon="evenstar" refine=1 lvl=90/90;
yae add set="gt" count=4;
#yae add set="totm" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # ATK%/DMG/CR
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # GT
#yae add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
#yae add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662; # Support

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
#bennett add weapon="sapwood" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active razor; # SS stacks
razor skill, dash; # Sigils, Chev A4, C4

for let i=0; i<4; i=i+1 {
  # Burst as available
  if .chev.burst.ready {
    chev burst, skill[hold=1]:2;
    if !.chev.mods.favonius-cd {
      chev skill[hold=1];
    }
  } else {
    chev attack:1, skill[hold=1], attack:1;
  }
  
  # Yae before Chev is slightly worse
  yae skill:3;
  
  bennett skill, burst;

  # Razor out of burst actions; account for CD
  while !.razor.mods.razor-q {
    if .razor.burst.ready && .razor.skill.ready {
      razor skill, dash, attack, burst;
    } else if .razor.burst.ready {
      razor burst;
    } else if .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  # Razor Main DPS window 
  #while .razor.infusion.bennett-fire-weapon { 
  while .razor.mods.razor-q > 240 { # Fixed Rot
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
}
