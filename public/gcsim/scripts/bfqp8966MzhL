# Lisa Furina Ororon Xianyun. ~24s Rot. Lisa Taser Plunge. Lisa uses hold skill immediately after all plunges are spent to catch furina's burst buff. 50% Collisons.

# Team
lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="widsith" refine=3 lvl=90/90;
lisa add set="mh" count=4;
#lisa add set="ts" count=4;
#lisa add set="longnightsoath" count=4;
lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2317 cd=0.7944; # MH
#lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
#lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958; # Other

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3641 cd=0.2648;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#ororon add weapon="chainbreaker" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.2755 em=99.1 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active ororon;

for let x=0; x<4; x=x+1 {
  ororon burst, skill;
  
  furina skill, dash, burst;
  
  while !.lisa.burst.ready {
    lisa attack;
  }
  lisa burst;
  
  xianyun skill, low_plunge, burst; # attack for the Swirl
  
  for let i=0;i<4;i=i+1 {
  #while .fischl.oz {
    if .xianyun.status.xianyun-airborne-buff {
      lisa jump;
      if .airborne {
        lisa high_plunge[collision=rand()>0.5], dash;
      }
    } else if .lisa.normal > 2 {
      lisa dash;
    } else {
      lisa attack;
    }
  }
  
  xianyun attack:2; sleep(20); # for CD warning
  
  while .furina.skill.cd > 60 || .lisa.energy < 65 {
    if .xianyun.status.xianyun-airborne-buff {
      lisa jump;
      if .airborne {
        lisa high_plunge[collision=rand()>0.5], dash;
      }
    } else if .lisa.skill.ready {
      lisa skill[hold=1];
    } else if .lisa.normal > 3 {
      lisa dash;
    } else {
      lisa attack;
    }
  }
}

