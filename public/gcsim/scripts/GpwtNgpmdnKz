options swap_delay=12 iteration=1000;

# Build assumptions
neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
neuvillette add stats def%=0.124 def=39.36 hp=761.82 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1655 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100];
skirk add weapon="moonweaversdawn" refine=2 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="scroll" count=4;
escoffier add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5456 er=0.1653 em=39.64 cr=0.3972 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active neuvillette;

for let i=0; i<4; i=i+1 {
  neuv skill, attack;
  furina skill, dash, attack, burst;
  escoffier skill, burst;
  neuv charge;
  skirk skill[hold=1], burst;
  neuv skill, charge, burst;
  furina burst;
  escoffier skill, burst;
  neuv charge;
  skirk skill[hold=1], burst;
  neuv charge;
}
wait(173); #for the last CA

# Neuv E > Furina ED Q > Escoffier EQ > Neuv C > Skirk hE Q > Neuv E C Q > Furina Q > Escoffier EQ > Neuv C > Skirk hE Q > Neuv C
