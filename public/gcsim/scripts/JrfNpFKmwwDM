durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="lionsroar" refine=5 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*12;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="sacbow" refine=5 lvl=90/90;
fischl add set="cg" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=5 lvl=90/90;
mona add set="sms" count=4;
mona add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="totm" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*2 cr=0.0331*4 cd=0.0662*10;

options iteration=1000 swap_delay=12;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=21370000000;

active bina;

for let i=0; i<6; i=i+1 {
  bina skill;
  if .bina.burst.ready {
    bina burst;
  } else {
    bina attack;
  }
  fischl skill, attack;
  mona burst, attack;
  if !i {
    durin skill, burst, attack;
  } else {
    durin skill:2, burst;
  }
  fischl attack:2, burst;
  mona attack, skill, attack;
  durin attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge;
  mona attack, charge;
  durin attack:2, charge;
}

# ~20s rotations
# Columbina E Q/N1 > Fischl E N1 > Mona Q N1 > Durin EEQ > Fischl N2 Q > Mona N1 E N1 > Durin 2[N2CD] N2C > Mona N1C > Durin N2C
# Durin EQ N1 first rotation is ~1.5k more DPS
