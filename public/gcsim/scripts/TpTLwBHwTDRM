# Barbara Furina Yelan Xianyun. ~20s Rot. Barbara Hydro Plunge. 2E Yelan. 50% Collisions. Not very optimized.

# Team: Options listed by DPS
barbara char lvl=90/90 cons=6 talent=9,9,9;
barbara add weapon="widsith" refine=3 lvl=90/90;
barbara add set="lno" count=4;
#barbara add set="nymph" count=4;
barbara add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311;
barbara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="no" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3306 em=79.28 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Active
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;

  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  xianyun skill, low_plunge, attack, burst;
  
  barbara attack;
  if .barbara.skill.ready {
    barb skill;
  }
  while .xianyun.status.xianyun-airborne-buff && .yelan.skill.cd {
    if .xianyun.status.xianyun-airborne-buff {
      barbara jump;
      if .airborne {
        barbara high_plunge[collision=rand()>0.5];
        barbara attack;
      }
    }
  }
  
  yelan skill, attack;
  
  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.status.xianyun-airborne-buff {
      barbara jump;
      if .airborne {
        barbara high_plunge[collision=rand()>0.5];
        barbara attack;
      }
    }
  }
  
  barb attack:2, charge;
  
}

