# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active nahida;
nahida skill, attack, burst;

for let i=0; i<4; i=i+1 {
  if .nahida.burst.ready {
    nahida burst;
  } else {
    if i > 0 {
      nahida attack, charge;
    }
  }
    
  furina skill, dash, burst;
  
  jean skill, attack;
  
  dori skill, attack:2, dash, attack:2, burst;
  
  jean skill, burst;
  
  nahida skill, attack:2, charge;

  dori skill, attack:2, dash, attack:2;
  
  jean skill, attack;
  
  nahida skill, attack:2, charge;
  
  print("done");
}
