# Charlotte Furina Shenhe Kazuha. 21s Rot. DPS Charlotte. Charlotte uses Hold E. 2E Shenhe. Hydro swirls are inconsistent. A more optimized rotation is probably possible.

# Team
charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="widsith" refine=3 lvl=90/90; 
charlotte add set="bs" count=4;
#charlotte add set="mh" count=4;
charlotte add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favlance" refine=3 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.4408 em=39.64 cr=0.331 cd=0.1324;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favsword" refine=3 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  shenhe skill, burst;
  
  kazuha skill, high_plunge[collision=rand()>0.2];
  
  charlotte burst, skill[hold=1];

  kazuha burst, skill, high_plunge[collision=rand()>0.2];
  
  shenhe attack, skill;
  
  charlotte attack:3, dash, attack:3, dash, attack:2;
  
  kazuha skill, high_plunge[collision=rand()>0.2];
  
  charlotte attack:2, dash, attack;
}

