# Freminet Furina Rosaria Xilonen. ~24s Rot. Phys Freminet Shatter. SS is better with PF, TS with MH. Xilonen Crystallizes Hydro. 1E Xilonen.

# Team- Options listsed by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#freminet add weapon="tidalshadow" refine=5 lvl=90/90;
freminet add set="pf" count=4; # SS
#freminet add set="mh" count=4; # TS
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2979 cd=0.662; # PF;SS
#freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2979 cd=0.662; # TS;MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favspear" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active freminet; # with SS
#active furina;

for let i=0; i<4; i=i+1 {
  xilonen burst;

  furina skill, dash, burst;

  xilonen skill, attack:2;

  rosaria skill, burst;

  freminet skill, attack, burst,
           attack:2, skill, skill,
           attack:2, skill, attack:1, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
           attack:2, skill, attack:1, skill,
           attack:2, skill;
}
