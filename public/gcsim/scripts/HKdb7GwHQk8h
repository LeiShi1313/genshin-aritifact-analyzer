target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active chiori;
for let i=0; i<4; i=i+1 {
  if i && .chiori.burst.ready {
    chiori burst;
  }
  chiori skill:2;
  zhongli skill[hold=1], dash, attack;
  if .alhaitham.burst.ready {
    alhaitham burst;
  }
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  # if .alhaitham.burst.ready {
  #   alhaitham burst;
  #  }
  alhaitham attack:3, dash,
            attack:3, skill,
            attack:3, dash,
            attack:3, charge, dash,
            attack:3, dash,
            attack:3, dash,
            attack:3;
}
