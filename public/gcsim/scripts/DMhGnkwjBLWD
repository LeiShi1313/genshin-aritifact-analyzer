# Team:
alhaitham char lvl=90/90 cons=0 talent=9,9,9;
alhaitham add weapon="harbingerofdawn" refine=5 lvl=90/90;
alhaitham add set="gilded" count=4;
alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311 ;
alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="wanderingevenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=5;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 em=187 ; #main
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2979 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=4 lvl=90/90;
yelan add set="emblemofseveredfate" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2979 cd=0.7944 ;

kuki char lvl=90/90 cons=6 talent=9,9,9 +params=[start_hp=5000];
kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="fopl" count=5;
kuki add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.6612 em=118.92 cr=0.1655 cd=0.2648;	
								
# Options:
options swap_delay=8 iteration=500;
energy every interval=480,720 amount=1;

# Single Target:
target lvl=100 resist=0.1 hp=10000000 radius=2 pos=0,2.4;

# 2 Targets:
#target lvl=100 resist=0.1 hp=10000000 pos=0,2 radius=1;
#target lvl=100 resist=0.1 hp=10000000 pos=2,0 radius=1;

# Rotation:
active nahida;

for let r = 0; r < 3; r = r + 1 {
  
  nahida skill, burst;
  yelan burst, attack, skill;
  while !.yelan.mods.favonius-cd {yelan attack;}
  kuki skill, attack;
  alhaitham burst;
  if .kuki.burst.ready {
  kuki attack,burst;
  } else {
  nahida attack, skill, attack;
  }
  alhaitham attack:3,jump,
            attack:3,jump,
            attack:3,dash,
            attack:3;
  yelan skill, attack:2;
  alhaitham skill[hold=1], low_plunge[short=1], 
            attack:2, charge, dash, 
            attack:3, charge;
  
}