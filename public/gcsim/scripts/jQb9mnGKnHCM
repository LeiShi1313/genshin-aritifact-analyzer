# Raiden Chevreuse Xiangling Mavuika. ~20s Rot. Raiden Overload with double Pyro providing good AoE. Mavuika passes particles to Xiangling. Xiangling fills time for her burst CD with C2 when Mavuika cant fill time on Flamestrider. Healer Chevreuse.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="deathmatch" refine=1 lvl=90/90;
xiangling add set="emblem" count=4;
xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#mavuika add weapon="tidalshadow" refine=5 lvl=90/90;
mavuika add set="scroll" count=4;
#mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Other
#mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # OC; SS
#mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # OC; TS

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active mav; # SS Stacks

raiden skill, attack;

for let i = 0; i < 4; i = i + 1 {
  chevreuse burst, skill[hold=1];

  if .mav.burst.ready && i > 0 {
    mav burst,
        charge:2, charge[final=1], dash,
        charge:2, charge[final=1], dash,
        skill, dash;
  } else {
    mav attack, skill;
  }

  xl burst, skill, dash;

  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;

  if i > 0 && !is_even(i) {
    xl attack:5, dash, attack:1, charge, dash;
  }
}
