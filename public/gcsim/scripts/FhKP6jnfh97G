options iteration=1000 swap_delay=12;

# Build assumptions
dehya char lvl=90/90 cons=6 talent=10,10,10;
dehya add weapon="beaconofthereedsea" refine=5 lvl=90/90;
dehya add set="mh" count=4;
dehya add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; # Main stats: EM Pyro% CD
dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=79.28 cr=0.1655 cd=0.662;

bennett char lvl=90/90 cons=6 talent=10,10,10;
bennett add weapon="mistsplitter" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; # Main stats: ER Pyro% CR
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="splendor" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; # Main stats: ER HP% CR
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=6 talent=10,10,10;
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 er=0.518 def%=0.583 def%=0.583; # Main stats: ER DEF% DEF%
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.331;

# Target, Energy and damage taken assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops
hurt every interval=180,300 amount=3500,5500 element=physical; # damage taken assumed every 3-5s

# Rotation assumptions
active dehya;

for let i=0; i<5; i=i+1 {
  dehya skill;
  if i {
    furina skill, dash, burst, charge, attack:4, dash, charge;
    xilonen burst;
  } else {
    furina skill, dash;
    xilonen skill, attack:2, burst;
    furina burst, charge, attack:4, dash, charge;
  }
  bennett skill, burst;
  xilonen skill, attack:2;
  dehya burst, attack:15;
  xilonen skill, attack:2;
  bennett skill, dash, attack;
  dehya skill;
}

# ~25s rot
# First rotation: Dehya E > Furina ED > Xilonen E N2 Q > Furina Q C N4D C > Bennett EQ > Xilonen E N2 > Dehya Q N15 > Xilonen E N2 > Bennett ED N1 > Dehya E
# Second rotation onwards: Dehya E > Furina ED Q C N4D C > Xilonen Q > Bennett EQ > Xilonen E N2 > Dehya Q N15 > Xilonen E N2 > Bennett ED N1 > Dehya E
