# Emilie Durin Nicole Lauma. ~20s Rot. Emilie on-field. Emilie does N1C, stamina permitting, and N4D otherwise, comprising ~15% of her DPS. Deepwood Lauma refreshes RES shred after Emilie's Field. Nicole passes particles to Durin.

# Team - Options ordered by DPS
emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622;
emilie add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*2 cr=0.0331*12 cd=0.0662*5;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
#durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*7 em=19.82*2 cr=0.0331*12 cd=0.0662*6; # RW
#durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
#durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # Other

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="ttds" refine=5 lvl=90/90;
lauma add set="deepwood" count=4;
lauma add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*6 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active emilie; # SS Stacks
emilie skill;

for let i=0; i<4; i=i+1 {
  durin skill:2, burst;

  bennett skill, dash, burst;

  lauma attack, skill[hold=0];

  while .status.bennettburst {
    if .emilie.normal > 1 && .emilie.skill.ready {
      emilie skill;
    } else if .emilie.burst.ready {
      emilie burst;
    } else if .emilie.normal > 1 && .stam > 25 {
      emilie charge;
    } else if .emilie.normal > 3 && .stam > 18 {
      emilie attack, dash;
    } else {
      emilie attack;
    }
  }

  bennett skill, dash;
}
