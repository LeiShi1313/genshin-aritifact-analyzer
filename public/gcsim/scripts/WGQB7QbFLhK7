xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.2976 er=0.3857 em=138.74 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Dori Plunge Combo
fn DoriPlunge() {
  dori jump;
  if .airborne {
    dori high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active dori; #SS Stacks
dori burst;

for let i=0; i<4; i=i+1 {
  nahida skill, attack, charge, burst;
  
  amy attack:2, burst; # No ER concern to obstruct plunges
  #amy attack, skill; # lower DPS
  
  xianyun skill, low_plunge, attack, burst;
  
  dori skill;
  dori attack;
  DoriPlunge(); dori dash;
  DoriPlunge(); dori dash;
  DoriPlunge(); dori dash;
  dori skill;
  dori attack;
  DoriPlunge(); dori dash;
  DoriPlunge(); dori dash;
  DoriPlunge();
  
  amy attack, skill; # See above
  #amy attack:2, burst; # See above
  
  xianyun attack:2; sleep(20); # Refresh VV
  
  # Plunge earlier or low plunge if timing concerns
  dori skill;
  dori attack;
  DoriPlunge(); dori dash;
  DoriPlunge();
  dori attack, burst;
  
  nahida attack, charge, dash;
  
  print("done");
}

