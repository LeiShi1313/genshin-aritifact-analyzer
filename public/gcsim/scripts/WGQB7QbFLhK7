# Dori Nahida Fischl Xianyun. ~26s Rot. Dori Aggravate with Xianyun plunge support. The CD on Dori's skill/infusion is nearly eliminated by Aggravate on no ICD plunges. EM and ATK are similar on Dori. 50% Collisions.

# Team- Options listsed by DPS
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#dori add weapon="rainslasher" refine=3 lvl=90/90; # Much Worse
dori add set="tf" count=4;
dori add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
