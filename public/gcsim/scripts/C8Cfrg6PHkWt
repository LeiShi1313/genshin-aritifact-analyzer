options swap_delay=12 iteration=1000 ignore_burst_energy=false;

# --- Targets
target lvl=100 resist=0.1 hp=999999999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active yae;

for let x = 0; x < 3; x = x + 1 {
#  if x==0 {
    yae skill:3;
#  } else {
#    yae attack, skill, attack, skill, attack, skill, attack;
#  }

  nahida skill, burst, attack;
  furina skill, dash, burst;
  xianyun attack, skill, low_plunge, burst;
  yae attack, jump, high_plunge[collision=1];
  if .yae.burst.ready {
    yae burst;
  }
  yae skill:2, attack ,skill,
      jump, low_plunge[collision=1], dash,
      jump, low_plunge[collision=1], attack;
  xianyun attack:2;
  nahida skill, attack, charge;
  yae attack, jump, low_plunge[collision=1], dash,
      jump, low_plunge[collision=1], dash,
      jump, low_plunge[collision=1], dash,
      jump, low_plunge[collision=1], attack,
      jump, low_plunge[collision=1];

}
