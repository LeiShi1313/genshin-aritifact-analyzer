lanyan add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.1986 cd=0.5296;


active xingqiu;
target lvl=100 resist=0.1 hp=999999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

for let x=0; x<4; x=x+1 {
  xingqiu skill, burst, attack:2;
  rosaria skill, attack, burst;
  lanyan attack, skill:2, attack; # double swirl
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if .wrio.burst.ready {
    wrio burst;
  } else {
    wrio charge;
  }
}
