hutao char lvl=90/90 cons=1 talent=10,10,10 +params=[start_hp=1];
hutao add weapon="dbane" refine=5 lvl=90/90;
hutao add set="notsu" count=4;
hutao add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 cd=0.622; #main
hutao add stats def%=0.051 def=16 hp=657 hp%=0.198 atk=33 atk%=0.111 em=63 cr=0.525 cd=0.761;

furina char lvl=90/90 cons=1 talent=7,10,10;
furina add weapon="favoniussword" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats hp=1285 hp%=0.152 atk=51 atk%=0.105 em=44 cr=0.436 cd=0.528 er=0.395;

columbina char lvl=90/90 cons=0 talent=6,10,10;
columbina add weapon="pamber" refine=5 lvl=90/90;
columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
columbina add stats def=44 hp=508 hp%=0.157 atk=14 atk%=0.047 er=0.447 em=44 cr=0.268 cd=1.01;

ineffa char lvl=90/90 cons=0 talent=1,10,7;
ineffa add weapon="prospectorsshovel" refine=5 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.255 def=37 hp=239 atk=76 atk%=0.157 em=58 cr=0.533 cd=0.661;

# Options
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

# Rotation
active furina;

for let i=0; i<6; i=i+1 {

  furina skill, burst;

  if i && .ineffa.burst.ready {
    ineffa skill, burst;
  } else {
    ineffa attack, skill;
  }

  bina skill;
  if .bina.burst.ready {
    bina burst;
  }

  hutao skill,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash,
        attack:2, charge, dash;
  if .hutao.burst.ready {
    hutao attack, burst;
  } else {
    hutao attack:2, charge, dash;
  }

}
