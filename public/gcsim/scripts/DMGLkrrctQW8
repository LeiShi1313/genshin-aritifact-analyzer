# Dehya Chongyun Nahida Xianyun. ~16s Rot. Dehya Melt Plunge. Uses Dehya just before plunging for Burning aura. Nahida bursts every other rotation. Chongyun uses E before Xianyun. 50% Collisions.

# Team - Options listed by DPS
dehya char lvl=90/90 cons=0 talent=9,9,9;
dehya add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#dehya add weapon="fruitfulhook" refine=1 lvl=90/90;
dehya add set="longnightsoath" count=4;
#dehya add set="sr" count=4;
dehya add stats hp=4780 atk=311 em=187 cryo%=0.466 cd=0.622; #main
dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="totm" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.2755 em=39.64 cr=0.0662 cd=0.331;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # deals burning AoE, -SS stacks

# Dehya Plunge Combo
fn DehyaPlunge() {
  dehya jump;
  if .airborne {
    dehya high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active dehya; # SS stacks

for let i = 0; i < 4; i = i + 1 {
  if is_even(i) {
    nahida skill, burst;
  } else {
    nahida skill, attack, charge;
  }

  chongyun burst, skill;

  xianyun skill, high_plunge, burst;

  dehya attack, skill;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya skill;
  DehyaPlunge();
}
