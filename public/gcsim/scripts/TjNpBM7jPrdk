# Kazuha Emilie Faruzan Bennett. ~20s Rot. Kazuha Faruzan Burning Quickswap. Kazuha skills off CD with Faruzan aimed shots in between. UR on Faruzan exceeds Deepwood. Emilie bursts every other rot. Kazuha's Na/CA should be Pyro in practice. Bennett uses skill a 2nd time after his burst expires.

# Team
kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="wolffang" refine=1 lvl=90/90;
#kazuha add weapon="finale" refine=5 lvl=90/90;
#kazuha add weapon="isshin" refine=5 lvl=90/90;
kazuha add set="ur" count=4;
#kazuha add set="longnightsoath" count=4;
kazuha add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # WF
#kazuha add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
#kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # Finale

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622 ; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="twilight" refine=5 lvl=90/90;
faruzan add set="ur" count=4;
#faruzan add set="deepwood" count=4;
#faruzan add set="gt" count=4;
#faruzan add set="vv" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
#bennett add set="deepwood" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2317 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active emilie;

for let i = 0; i < 4; i = i + 1 {
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }

  bennett skill, burst;

  faruzan skill, burst;

  kazuha skill, high_plunge[collision=1], burst;

  faruzan aim:2, skill;

  kazuha skill, high_plunge[collision=1], attack, charge, attack;

  faruzan aim:2, skill; # Bennett Q expiry

  kazuha skill, high_plunge[collision=1]; # Bennett catches particles to meet ER req

  bennett skill;

  faruzan aim:2;
}
