# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

# Max Declension Guarantee
fn declensionCombo() {
  switch {
    case .heizou.normal > 1 && .heizou.skill.ready && .heizou.declension == 4:
      heizou skill;
    case .heizou.normal > 1 && .heizou.burst.ready:
      heizou burst;
    case .heizou.normal > 1:
      heizou charge;
    default:
      heizou attack;
  }
}

#Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl skill, attack;

  yae skill:3;

  furina skill, dash, burst;

  while .fischl.oz {
    declensionCombo();
  }

  fischl attack:2, burst;

  yae skill:3;

  while .fischl.skill.cd {
    declensionCombo();
  }

  print("done");
}
