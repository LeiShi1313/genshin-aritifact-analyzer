chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="chainbreaker" refine=5 lvl=90/90;
chasca add set="oc" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="pamber" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 heal=0.359; #main
citlali add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*12 cd=0.0662*7;

albedo char lvl=90/90 cons=0 talent=9,9,9;
albedo add weapon="xiphos" refine=1 lvl=90/90;
albedo add set="totm" count=5;
albedo add stats hp=4780 atk=311 em=187 em=187 em=187; #mainstats
albedo add stats def%=0.062*12 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*8 cd=0.0662*2;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*6;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active furina;
for let i=0; i<4; i=i+1 {
  if is_even(i){
    furina skill, dash; #, attack, burst;
    albedo skill, attack;
  } else {
    furina burst;
  }

  if i > 0 && .albedo.burst.ready {
    #albedo burst;
  } else {
    #albedo attack;
  }

  citlali skill, burst; #, attack;

  chasca skill, aim:4;
  #chasca aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
}
wait(82); # wait for aim[bullets=4] hits the enemy at the last rot
