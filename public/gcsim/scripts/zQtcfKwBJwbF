# Emilie Bennett Furina Xianyun. ~24s Rot. On-field Emilie Burning plunge. Burstless Emilie. Pyro > ATK > Dendro Goblet. 8 plunges; Final plunge is unbuffed.

# Team - Listed by DPS
emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
#emilie add weapon="fjords" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; #
#emilie add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622 ; #main
#emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;
#emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
#emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; #

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
#bennett add set="deepwood" count=4;
bennett add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=158.56 cr=0.2979 cd=0.1986;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958; #

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="ohc" count=4; # Bubbles may miss
xianyun add set="deepwood" count=4;
#xianyun add set="vv" count=4;
#xianyun add set="no" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=82.7 atk%=0.3968 er=0.4408 em=138.74 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, attack, burst;

  xianyun skill, low_plunge, burst;

  bennett skill, burst;

  # Skill over burst;
  if .emilie.skill.ready {
    emilie skill;
  } else {
    emilie attack, burst;
  }
  # Skill over burst;
  # Plunge Combo
  let plunges = 0;
  while .emilie.status.xianyun-airborne-buff {
    emilie jump;
    if .airborne {
      emilie high_plunge[collision=rand()>0.5];
      plunges = plunges + 1; print(plunges);
      if .emilie.infusion.bennett-fire-weapon {
        emilie attack;
      }
    }
  }

  bennett attack, skill;
}
