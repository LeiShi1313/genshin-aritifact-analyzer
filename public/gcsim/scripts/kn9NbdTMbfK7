# Yanfei Xingqiu Yelan Bennett. ~21s Rot. A less dank Yanfei Double Hydro rotation. 1E Yelan. Yanfei does N1C, mostly. The opponent is out of XQ orbital range.

# Team
yanfei char lvl=90/90 cons=6 talent=9,9,9;
yanfei add weapon="widsith" refine=3 lvl=90/90;
yanfei add set="cw" count=4;
yanfei add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
yanfei add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.2979 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Melee range; XQ orbitals
target lvl=100 resist=0.1 radius=2 pos=0,3.9 hp=100000000; # Ranged range; no orbitals

#Rotation
active xingqiu;

for let x = 0; x < 4; x = x + 1 {
  xingqiu skill, dash, burst, attack;

  yelan skill, attack, burst, attack;

  bennett skill, burst, attack;

  yanfei attack, skill, attack;
  if .yanfei.burst.ready {
    yanfei burst;
  }
  #while !.xingqiu.skill.ready {
  while .xingqiu.mods.xingqiuburst {
    if .yanfei.skill.ready && .yanfei.mods.yanfei-a1 && .previous-action == .action.attack {
      yanfei skill;
    } else if .yanfei.mods.yanfei-seal && .stam > 25 && .previous-action == .action.attack {
      yanfei charge;
    } else {
      yanfei attack;
    }
  }

  bennett skill;
}
