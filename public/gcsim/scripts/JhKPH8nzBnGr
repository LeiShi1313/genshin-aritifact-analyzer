nahida add stats hp=4780 atk=311 em=187 em=187 em=187; # main
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.2648 cd=0.5296;

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="favoniuslance" refine=3 lvl=90/90;
thoma add set="noblesseoblige" count=4;
thoma add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; # main
thoma add stats def=39.36 def%=0.124 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwoodblade" refine=5 lvl=90/90;
bennett add set="theexile" count=4;
bennett add stats hp=3824 atk=248.8 er=0.518 pyro%=0.348 cr=0.232; # main
bennett add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.07936 atk=26.464 atk%=0.15872 er=0.08816 em=31.712 cr=0.2648 cd=0.63552;

options swap_delay=12 iteration=1000;

target lvl=100 resist=.1 hp=999999999;
energy every interval=480,720 amount=1;

active bennett;

fn wrio_combo() {
  wrio attack:3;
  if .wrio.charge.ready {
    wrio charge;
  } else {
    wrio attack:2;
  }
}

for let i = 0; i < 4; i = i + 1 {
  bennett skill;
  thoma skill, burst, attack;
  nahida burst, attack, skill;
  bennett skill, dash, burst;
  wrio skill;
  for let x = 0; x < 5; x = x + 1 {
    wrio_combo();
  }
  if .wrio.burst.ready {
    wrio burst;
  } else {
    wrio_combo();
  }
}
