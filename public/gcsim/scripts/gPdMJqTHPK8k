# Razor Nahida Fischl Jean. ~25 Rot. Razor Aggravate, with EM Jean Swirling Razor's Electro self-application. Razor Self-Aura not implemented.

# Team - Options Listed By DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="ts" count=4;
#razor add set="pf" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
#nahida add weapon="magicguide" refine=5 lvl=90/90;
nahida add set="gt" count=4;
#nahida add set="deepwood" count=4;
#nahida add set="totm" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.2317 cd=0.5958;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="favsword" refine=3 lvl=90/90;
#jean add weapon="xiphos" refine=1 lvl=90/90;
jean add set="vv" count=4;
jean add stats hp=4780 atk=311 em=187 em=187 em=187; #main
jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.4959 em=39.64 cr=0.3972 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active razor; # SS Stacks
#razor skill, dash; # Not nessesary

for let i=0; i<4; i=i+1 {
	fischl attack, skill;
	
	jean skill;
	
  nahida attack:2, skill, attack, burst, attack, charge;
  
	fischl attack:2, burst;
	
	jean skill, burst;
	
	razor skill, dash, burst, attack, skill, dash; # Skip NA before burst for more Flashfire uptime.
  while .fischl.skill.cd > 30 {
	  if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
}
