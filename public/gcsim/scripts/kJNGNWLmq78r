yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=6 talent=9,9,9;
furina add weapon="sacrificialsword" refine=5 lvl=90/90;
furina add set="mh" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="esf" count=5;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311;
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active furina;

for let i = 0; i < 4; i = i + 1 {
  if .furina.skill.ready {
    furina skill, dash, attack, burst;
    kazuha skill, high_plunge;
    yelan skill,  burst, attack;
    xingqiu burst, attack;
    furina attack, charge, attack:2, charge, attack:4; 
  } else {
    furina burst;
    xingqiu burst, attack;
    kazuha skill, high_plunge;
    yelan skill, burst, attack:4, dash, attack:4;
  }
  if .kazuha.burst.ready {
    kazuha burst;
    xingqiu skill, dash, attack:2;
  } else {
    kazuha skill, high_plunge, attack;
    xingqiu skill, dash, attack;
  }
  if .furina.skill.ready {
    furina skill, dash, attack;
    yelan skill, attack;
    furina attack, charge, attack:2, charge, attack:4;
  } else {
    yelan skill, attack;
    kazuha skill, high_plunge;
    yelan attack:4, dash, attack:4;
  }
}
