bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2979 cd=0.4623;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,3;
energy every interval=480,720 amount=1;

active bennett;

let rotations = 4;

for let r = rotations; r > 0; r = r - 1 {

  bennett skill, burst;

  fischl attack:1;
    if .fischl.skill.ready {
        fischl skill;
    } else {
        fischl attack, burst;
    }

  chevreuse burst, skill[hold=1]:3;
  while !.chev.mods.favonius-cd {
  chev attack;}
  diluc attack, skill,
    attack:3, skill,
    attack:3, skill, attack, burst;
    

}
