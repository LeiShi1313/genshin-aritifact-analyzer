varesa char lvl=90/90 cons=0 talent=9,9,9;
varesa add weapon="thewidsith" refine=3 lvl=90/90;
varesa add set="longnightsoath" count=4;
varesa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
varesa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="tenacityofthemillelith" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="aquamarine" refine=1 lvl=90/90;
mavuika add set="scrolloftheheroofcindercity" count=4;
mavuika add stats hp=4780 atk=311 em=187 em=187 em=187;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="songofdayspast" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.4634;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    //} else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
    //  varesa jump;
    //  if .airborne {
    //    varesa high_plunge[collision=1]; # JP
    //  }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

active varesa;

varesa_combo(1);

for let i=0; i<4; i=i+1 {
  if .chevreuse.burst.ready && .chevreuse.energy == .chevreuse.energymax {
    chevreuse burst;
  } else {
    chevreuse attack;
  }
  chevreuse skill[hold=1];
  if .fischl.skill.ready {
    fischl attack, skill, attack;
  } else {
    fischl attack:2, burst;
  }
  mavuika burst, charge, skill, dash;
  varesa_combo(6);
}

# ~18s rotations
# (Varesa 1 Plunge Combo) > Chevreuse Q/N1 hE > Fischl N1 E N1 / N2 Q > Mavuika Q C ED > Varesa 6 Plunge Combos