# Cyno Furina Ororon Escoffier. ~25s Rot. Cyno Taser with Token superconduct. Ororon uses QE before Furina to reduce her energy requirements.

# Team - Options Listed by DPS
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="missive" refine=5 lvl=90/90;
#cyno add weapon="fjords" refine=1 lvl=90/90;
cyno add set="mh" count=4;
cyno add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # Missive
#cyno add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1653 em=39.64 cr=0.2648 cd=0.662; # Fjords

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.3306 em=39.64 cr=0.1655 cd=0.4634;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active ororon;

for let i=0; i<4; i=i+1 {
  ororon burst, skill;

  furina skill, dash, burst;

  esco skill, burst;

  cyno skill, burst, attack:4, skill;
  while .cyno.burst.cd > 180 {
    if .cyno.skill.ready && .cyno.mods.cyno-a1 {
      cyno skill;
    } else if .cyno.normal == 5 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}
