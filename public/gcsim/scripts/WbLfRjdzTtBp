baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="no" count=4;
baizhu add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cr=0.311; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.1 hp=21370000000; 
fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active nahida;
for let i=0; i<4; i=i+1 {
  nahida skill, burst;
  furina skill, dash, burst;
  baizhu skill, burst, attack;
  clorinde_combo();
  if .clorinde.burst.ready {
    clorinde burst;
  } 
  baizhu skill, attack;
  clorinde_combo();
}