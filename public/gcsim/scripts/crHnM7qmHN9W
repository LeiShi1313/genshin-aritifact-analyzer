klee char lvl=90/90 cons=0 talent=9,9,9; #+params=[start_hp=10000];
klee add weapon="thewidsith" refine=3 lvl=90/90;
klee add set="mh" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9; #+params=[start_hp=10000];
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622 ; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9; #+params=[start_hp=10000];
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.4959 em=237.84 cr=0.0662 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active furina;

furina skill, dash, burst;
bennett skill, burst;
emilie skill, attack;
klee attack, burst, walk, attack[travel=6], charge;
klee attack[travel=6], charge, attack, skill[bounce=3, mine=8];
klee jump, attack, skill[bounce=3, mine=8], jump;
for let x = 4; x > 0; x = x - 1 {
  klee attack[travel=6], charge;
}
klee attack, walk, attack;
bennett skill, attack;
furina attack; # spending time waiting for E cd

for let x = 3; x > 0; x = x - 1 {
  furina skill, dash, burst;
  bennett burst, skill;
  if .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  bennett skill;
  klee attack, burst, walk, attack[travel=6], charge;
  klee attack[travel=6], charge, attack, skill[bounce=3, mine=8], jump;
  for let r = 5; r> 0; r = r - 1 {
    klee attack[travel=6], charge;
  }
  klee attack, walk, attack, walk, attack;
}
