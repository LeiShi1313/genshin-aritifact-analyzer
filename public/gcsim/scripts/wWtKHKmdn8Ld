lynette char lvl=90/90 cons=0 talent=9,9,9;
lynette add weapon="favoniussword" refine=3 lvl=90/90;
lynette add set="viridescentvenerer" count=4;
lynette add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
lynette add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.1982 def=39.35 def%=0.1239 em=39.63 er=0.1101 cr=0.3305 cd=0.7926;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favoniussword" refine=3 lvl=90/90;
xilonen add set="scrolloftheheroofcindercity" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=39.35 def%=0.6195 em=39.63 er=0.2202 cr=0.1652 cd=0.5945;

lyney char lvl=90/90 cons=0 talent=9,9,9;
lyney add weapon="songofstillness" refine=5 lvl=90/90;
lyney add set="marechausseehunter" count=4;
lyney add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
lyney add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.1982 def=39.35 def%=0.1239 em=39.63 er=0.1101 cr=0.3966 cd=0.6605;

dehya char lvl=90/90 cons=0 talent=9,9,9;
dehya add weapon="favoniusgreatsword" refine=3 lvl=90/90;
dehya add set="totm" count=4;
dehya add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
dehya add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.4460 def=39.35 def%=0.1239 em=39.63 er=0.1101 cr=0.2313 cd=0.6605;

options swap_delay=12 iteration=500;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;


active lyney;

for let i=0; i<3; i=i+1 {
  lyney aim, aim;
  xilonen burst, skill, attack:2;
  lynette skill, attack;
  if !.lynette.mods.favonius-cd  {
    lynette attack;
  }
  dehya skill;
  pick_up_crystallize("any");
  if !.dehya.mods.favonius-cd  {
    dehya attack;
  }
  lyney aim, aim;
  xilonen skill, attack:2;
  lynette burst, attack;
  lyney burst;
  delay(13);
  lyney skill, aim, aim, skill;
}
