options swap_delay=12 iteration=1000;

# Build assumptions
mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90; # No Serpent Spine Pre-stack due to active Varesa
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

varesa char lvl=90/90 cons=0 talent=9,9,9;
varesa add weapon="widsith" refine=3 lvl=90/90;
varesa add set="lno" count=4;
varesa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
varesa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="chainbreaker" refine=5 lvl=90/90;
ororon add set="scroll" count=5;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="dialogues" refine=5 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466;
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3641 cd=0.331;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    //} else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
    //  varesa jump;
    //  if .airborne {
    //    varesa high_plunge[collision=1]; # JP
    //  }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

fn mav_dc_cancel(d_travel_f) { # d_travel_f should be 6-24. https://docs.gcsim.app/reference/characters/mavuika#params
  # To prevent Error when Mavuika tries to do D*C without enough NS points, jump instead.
  if d_travel_f < 6 {
    d_travel_f = 6;
  }

  let dash_ns = 10; # 10 consumption on dash use
  let base_cons = 0.9; # 0.9 points
  let base_tick_rate = 6;

  while !.mavuika.dash.ready {
    print("waiting on mavuika dash cd");
    wait(1);
  }

  let d_ticks = d_travel_f / base_tick_rate + 1; # +1 in case you get unlucky with tick timing
  print("Max number of NS ticks during dash: ", d_ticks);
  let ns_consumed = dash_ns + base_cons * d_ticks;
  print("Expected NS consumption: ", ns_consumed);

  if .mavuika.nightsoul.points > ns_consumed || .mavuika.status.mavuika-burst {
    mavuika dash[charge_cancel=1, travel=d_travel_f], charge;
  } else {
    print("current NS points = ", .mavuika.nightsoul.points);
    print("skipping mav d*c, not enough NS points ");
    mavuika jump;
  }
}

active varesa;  # For Widsith uptime on her damage window

varesa skill, attack, high_plunge[collision=1];
for let i=0; i<4; i=i+1 {
  if !i {
    chevreuse burst, skill[hold=1];
    ororon skill, burst;
  } else {
    ororon skill, burst;
    chevreuse skill[hold=1], burst;
  }
  mavuika skill, burst;
  mavuika charge;
  mav_dc_cancel(6);
  mav_dc_cancel(6);
  mavuika charge, charge[final=1];
  mav_dc_cancel(6);
  mav_dc_cancel(6);
  mavuika charge;
  if !i {
    mavuika charge[final=1];
    varesa_combo(1);
  }
  varesa_combo(4);
}

# 1st rotation starting with ECP
# Varesa ECP >
# Chev Q hE > Ororon E Q > Mavuika tE Q C D*C1 D*C2F D*C1 D*C2F > Varesa 5[Plunge Combos]

# 2nd rotation onwards
# Ororon E Q > Chev hE Q > Mavuika tE Q C D*C1 D*C2F D*C1 D*C2  > Varesa 4[Plunge Combos]
