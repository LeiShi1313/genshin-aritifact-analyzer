arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="fjords" refine=1 lvl=90/90;
arle add set="fohw" count=5;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; 
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;
        
yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=4 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311 ;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.4634;

lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="ttds" refine=5 lvl=90/90;
lanyan add set="vv" count=4;
lanyan add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active arle;

for let i = 0; i < 4; i = i + 1 { # total 4rots, 2 TTDS rots
  arle skill; 
  bennett skill, attack;
  yelan skill, attack, burst, attack;
  bennett burst;
  if .lanyan.burst.ready && .lanyan.cons >= 4 {   # if Lanyan is C4+, her Q is DPS increase
    lanyan burst;
  }
  lanyan skill:2;
  if .lanyan.cons == 0 {
    //if .lanyan.burst.ready {
    //  lanyan burst;          # Burst can be used instead of N1
    //} else {
      lanyan attack, dash;   # using dash after N1; C0 swapping to early right after Lan Yan N1 makes Arle N1 fail to trigger Yelan Q due to cd
    //}
  }
  arle attack:3, charge, 
       attack:3, charge, 
       attack:3, charge, 
       attack:3, charge,
       attack:3, charge,
       attack;
}

# Arle E > Bennett E > Yelan E N1 Q N1 > Bennett Q > Lan Yan (Q) 2[E] (N1 if C0) > Arle 5[N3C] N1