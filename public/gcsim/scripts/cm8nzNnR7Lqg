clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="blacksword" refine=1 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main 5* set
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2979 cd=0.662;

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="mouun" refine=1 lvl=90/90;
sara add set="scroll" count=5;
sara add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311;
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="esf" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;


options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active sara;
for let i=0; i<4; i=i+1 {
  if ( i / 2 ) * 2 == i {
    sara skill, aim, attack; # self buff by waiting or doing N1
  }
  bennett skill, burst;
  chev skill[hold=1], burst, attack, dash; # catch her own E particles
  if ( i / 2 ) * 2 == i {
    sara burst;
  } else {
    sara skill, aim;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  if .clorinde.burst.ready {
    clorinde burst;
  }
}

# Sara E C N1 > Bennett EQ > Chev hE Q N1 > Sara Q > Clorinde E combo Q >
#               Bennett EQ > Chev hE Q N1 > Sara E C > Clorinde E combo
