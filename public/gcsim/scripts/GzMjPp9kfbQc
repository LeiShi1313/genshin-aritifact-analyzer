# Cyno Chevreuse Beidou Thoma. ~25s Rot. Cyno Beidou Overload in 2 Target. HP build Chevreuse bursts every other rotation.

# Team
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="deathmatch" refine=1 lvl=90/90;
cyno add set="echoes" count=4;
#cyno add set="glad" count=4;
cyno add stats hp=4780 atk=311 er=0.518 electro%=0.466 cd=0.622;
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
#chev add weapon="dialogues" refine=5 lvl=90/90;
chev add set="sodp" count=4;
#chev add set="gt" count=4;
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
chev add stats def%=0.124 def=39.36 hp=2031.52 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.1324; # HHC
#chev add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
#chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ADC

beidou char lvl=90/90 cons=6 talent=9,9,9;
beidou add weapon="uomms" refine=5 lvl=90/90;
beidou add set="eosf" count=4;
beidou add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311;
beidou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="favlance" refine=3 lvl=90/90;
thoma add set="scroll" count=4;
#thoma add set="no" count=4;
thoma add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=158.56 cr=0.331 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000; # Beidou


# Beidou 20% Perfect Counter, 20% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.80 {
    counter = 2;
  } else if counter > 0.6 && counter <= 0.80 {
    counter = 1;
  } else {
    counter = 0;
  }
  
  return counter;
}

# rotation
active cyno;
cyno skill;

for let i = 0; i < 4; i = i + 1 {
  if .chev.burst.ready && .chev.energy == .chev.energymax {
    chev burst, skill[hold=1]:2;
    if !.chev.mods.favonius-cd {
      chev skill[hold=1];
    }
  } else {
    chev attack, skill[hold=1];
  }
  
  thoma skill, burst;
  if !.thoma.mods.favonius-cd {
    thoma attack;
  }
  
  beidou skill[counter=rand_counter()], burst;
  
  cyno skill, attack, burst, attack:3, skill;
  while .cyno.mods.cyno-q > 270 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}

