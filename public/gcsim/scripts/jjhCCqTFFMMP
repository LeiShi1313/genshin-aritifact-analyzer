target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active rosaria;

for let i=0; i<4; i=i+1 {

  rosaria skill, burst;
  lynette burst;
  bennett burst;
  lynette skill;
  gaming burst;
  wait(65);
  for let p=0; p<6; p=p+1 {
    print(p);
    gaming skill;
    wait(20);
    gaming low_plunge;
  }
  bennett skill;
  gaming skill, low_plunge;
  lynette skill;
}

