# Alhaitham Furina Yelan Dori. ~22s Rot. AlHaitham Double Hydro Hyperbloom. Dori just before AlHaitham to maximize energy gained, then Yelan uses her 2nd E in Alhaitham's burst window. Harbinger of Dawn nearly matches WF. Low Quicken uptime.

# Team
alhaitham char lvl=90/90 cons=0 talent=9,9,9;
alhaitham add weapon="wolffang" refine=1 lvl=90/90;
#alhaitham add weapon="harbinger" refine=5 lvl=90/90;
#alhaitham add weapon="umbrella" refine=5 lvl=90/90;
alhaitham add set="mh" count=4;
alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662; # WF
#alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
#alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662; # HoD
#alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
#alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;# Umbrella

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
#furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
#furina add set="deepwood" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296; # FD
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2979 cd=0.5296; # WF

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="deepwood" count=4;
#yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="favgs" refine=3 lvl=90/90;
dori add set="fopl" count=4;
#dori add set="scroll" count=4;
#dori add set="deepwood" count=4;
dori add stats hp=4780 atk=311 em=187 em=187 em=187; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=100000000;

#Rotation
active furina;

for let r=0; r<4; r=r+1 {
  furina skill, dash, burst;

  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  dori skill, attack, burst, attack;

  haitham skill,
          attack:3, dash,
          attack:3;
  haitham burst;

  yelan skill, attack;

  haitham attack:3, charge, # Gain mirror
          attack:3, dash,
          attack:3, dash, # Yelan burst expires
          attack:2, charge;
}
