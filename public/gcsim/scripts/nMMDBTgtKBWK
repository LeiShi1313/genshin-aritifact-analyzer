# Yae Tighnari Fischl Lanyan. ~25s Rot. Yae Tighnari Aggravate with a shield. Yae bursts every rotatation. Not optimzed.

# Team
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gt" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

tighnari char lvl=90/90 cons=0 talent=9,9,9;
tighnari add weapon="slingshot" refine=5 lvl=90/90;
tighnari add set="scroll" count=4;
tighnari add stats hp=4780 atk=311 er=0.518 dendro%=0.466 cr=0.311; #main
tighnari add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=218.02 cr=0.0662 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="sacfrags" refine=5 lvl=90/90;
lanyan add set="vv" count=4;
lanyan add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

for let i=0; i<4; i=i+1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae skill, attack, skill, attack, skill;
  }

  lanyan attack, skill:2;

  fischl attack, skill;

  tighnari skill;
  while .tighnari.mods.vijnanasuffusion {
    tighnari aim;
    if .tighnari.burst.ready {
      tighnari burst;
    }
  }

  yae attack, burst;
  yae skill, attack, skill, attack, skill;

  lanyan attack, skill:2;

  fischl attack:2, burst;

  tighnari skill;
  while .tighnari.mods.vijnanasuffusion {
    tighnari aim;
    if .tighnari.burst.ready {
      tighnari burst;
    }
  }

  yae attack:2, charge, dash;
  yae attack:1, charge, dash;
}
