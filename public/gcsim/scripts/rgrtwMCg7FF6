flins char lvl=90/90 cons=0 talent=9,9,9;
flins add weapon="deathmatch" refine=1 lvl=90/90;
flins add set="notsu" count=4;
flins add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
flins add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="aubade" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*5 cr=0.0331*7 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="sacbow" refine=5 lvl=90/90;
fischl add set="sms" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="lionsroar" refine=5 lvl=90/90;
durin add set="celestialgift" count=4;
durin add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*2 em=19.82*10 cr=0.0331*4 cd=0.0662*2;

options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=99999999999;
energy every interval=480,720 amount=1;

active fischl;

for let i=0; i<5; i=i+1 {
  if i && .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl skill;
  }

  columbina skill;
  if is_even(i) {
    columbina burst;
  } else {
    columbina attack:2;
  }

  if i != 0 && 5 {
    durin skill:2, burst;
  } else {
    durin skill, burst, skill;
  }

  fischl attack:2, burst;

  flins skill, attack, skill, burst,
               attack:4, dash, attack:4, dash, attack:4, skill, burst,
               attack:4, dash, attack:4;
}
