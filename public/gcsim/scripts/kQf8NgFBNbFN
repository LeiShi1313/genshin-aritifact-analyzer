# one rot. 

faruzan char lvl=90/90 cons=6 talent=2,10,10;
faruzan add weapon="favbow" refine=5 lvl=90/90;
faruzan add set="scroll" count=4; faruzan add set="lno" count=1;
faruzan add stats def%=0.109 def=100 hp=5288 hp%=0.192 atk=395 atk%=0.19899999999999998 er=0.8999999999999999 em=145 cr=0.35 cd=0.163 anemo%=0.466;

wanderer char lvl=90/90 cons=0 talent=10,10,10;
wanderer add weapon="widsith" refine=5 lvl=90/90;
wanderer add set="dpc" count=4; wanderer add set="gt" count=1;
wanderer add stats hp=5019 hp%=0.040999999999999995 atk=375 atk%=0.6660000000000001 em=46 cr=0.591 cd=1.539 anemo%=0.466;

furina char lvl=90/90 cons=0 talent=5,10,10;
furina add weapon="fleuvecendreferryman" refine=5 lvl=90/90;
furina add set="gt" count=5;
furina add stats def%=0.057999999999999996 hp=6363 hp%=1.235 atk=348 atk%=0.09300000000000001 er=0.136 em=101 cr=0.20900000000000002 cd=1.299;

escoffier char lvl=80/80 cons=0 talent=1,8,8;
escoffier add weapon="favlance" refine=1 lvl=80/80;
escoffier add set="gt" count=4; escoffier add set="mh" count=1;
escoffier add stats def%=0.131 def=107 hp=4780 hp%=0.09300000000000001 atk=325 atk%=0.5770000000000001 er=0.34299999999999997 em=68 cr=0.41600000000000004 cd=1.135 cryo%=0.466;

options iteration=1000 swap_delay=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1; 
active furina;

for let i = 0; i < 1; i = i + 1 {
  furina skill, dash, burst;
  
  escoffier skill, burst;
  
  faruzan burst;
  
  wanderer attack:2, burst;
  wanderer attack:1, skill, attack, charge;	
  while .wanderer.skydweller-points > 3 {
    if .wanderer.normal < 3 {
      wanderer attack;
    } else if .wanderer.mods.wanderer-a4 {
      wanderer dash;
    } else if .wanderer.skydweller-points > 2 {
      wanderer charge;
    } else {
      wanderer attack;
    }
  } 
  wanderer skill;
}
