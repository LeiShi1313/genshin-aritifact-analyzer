# Ayato Yelan Ororon Xilonen. ~25s Rot. Ayato Taser with Yelan. Ayato & Ororon burst and Yelan Xilonen second skill happen in-between Ayato skill uses. Xilonen uses burst every roation.

# Team
ayato char lvl=90/90 cons=0 talent=9,9,9;
ayato add weapon="finale" refine=5 lvl=90/90;
#ayato add weapon="blacksword" refine=1 lvl=90/90;
#ayato add weapon="sturdybone" refine=1 lvl=90/90;
ayato add set="echoes" count=4;
#ayato add set="nymph" count=4;
#ayato add set="glad" count=4;
ayato add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
ayato add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

ororon char lvl=90/90 cons=6 talent=9,9,9; 
ororon add weapon="chainbreaker" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="ap" count=4;
#xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7282;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=0,1.8 hp=100000000;

# Xilonen AP Crystallize Function
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if ( char_id == .keys.char.xilonen && action_id == .action.skill ) {
    pick_up_crystallize("any");
  }
    
  return _execute_action(char_id, action_id, p);
}

# Rotation
active yelan;
yelan aim[hold=1];

for let i = 0; i < 4; i = i + 1 {
  xilonen burst;
  xilonen skill, attack:2;
  
  yelan skill, burst, attack;
  
  ayato skill, attack:15, burst;
  
  ororon attack, skill, burst;
  
  yelan attack, skill, attack;
  
  xilonen skill, attack:2;
  
  ayato skill, attack:15;
}
