furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main 
furina add stats  def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.6620;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="prototypeamber" refine=5 lvl=90/90;
nahida add set="deepwood" count=5;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;
#nahida add stats hp=4780 atk=311 em=187 em=187 heal=0.359; #main
#nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=118.92 cr=0.2648 cd=0.662; # More Healing

kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="fopl" count=5;
kuki add stats hp=4780 atk=311 em=561;
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

active furina;

for let i=0; i<4; i=i+1 {

  furina skill, dash, burst;
  
  nahida skill, burst;
  
  if .kuki.burst.ready { 
    kuki skill, burst; 
  } else { 
    kuki skill; 
  }
  
  # Skill as Available, for CPike Passive
  rosaria skill, burst,
          attack:3, charge, dash,
          attack:3, charge, dash, skill,
          attack:3, charge, dash,
          attack:3, charge, dash,
          attack:3, skill;
  
# Notation
# Furina EDQ > Nahida EQ > Kuki E(Q) > 
# Rosaria EQ 2N3CD E 2N3CD N3E
}
