chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;

active mavuika;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

for let i=0; i<4; i=i+1 {
  mualani dash, attack;
  mavuika burst;                          pick_up_crystallize("any"); # CA animation shard picking up for Geo Resonance
  mavuika charge:2, dash, skill, dash;    pick_up_crystallize("any");
  xilonen skill, attack:2;                pick_up_crystallize("any");
  chiori skill:2;
  mualani skill;
  mualani_combo();                        pick_up_crystallize("any"); # just during her field time
  if is_even(i) {
    mualani burst;
  } else {
    chiori burst;  # Xilonen Q can be used instead for ~5k lower DPS
  }
}
