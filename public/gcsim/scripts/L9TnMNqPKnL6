# Bennett Yelan Fischl Ororon. ~18s Rot. Thundering Fury Bennett with Yelan. Ororon uses skill and burst in Bennett's burst; No Pyro scroll. Fischl alternates skill and burst in Bennett's burst.  

# Team - Options ordered by DPS
bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="umbrella" refine=5 lvl=90/90;
#bennett add weapon="alleyflash" refine=1 lvl=90/90;
#bennett add weapon="wolffang" refine=1 lvl=90/90;
bennett add set="tf" count=4;
#bennett add set="cw" count=4; # The ideal substats and YL ER look different anyway
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.2317 cd=0.7282; # EEDr
