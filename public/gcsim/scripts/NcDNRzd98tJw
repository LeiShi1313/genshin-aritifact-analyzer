#team config

chiori char lvl=90/90 cons=6 talent=10,10,10;
chiori add weapon="uraku" refine=5 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311 ; # main
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3310 cd=0.7944;

#enemy config

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=3000000; 
energy every interval=480,720 amount=1;
active chiori;

#action list 

for { 
  switch {
    case .chiori.burst.ready:
      chiori burst;
    case .chiori.skill.ready:
      chiori skill:2;
    case .chiori.normal > 3:
      chiori dash;
    default:
      chiori attack;
  }
}