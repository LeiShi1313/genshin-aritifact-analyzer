bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
bennett add stats hp%=0.0992 hp=507.88 atk%=0.0992 atk=33.08 def%=0.124 def=39.36 er=0.1653 em=59.46 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
fischl add stats hp%=0.0992 hp=507.88 atk%=0.1488 atk=33.08 def%=0.124 def=39.36 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

options iteration=100 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active furina;
for let i=0; i<4; i=i+1 {
  furina attack, skill, dash, burst;
  bennett skill, burst;
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  if .yanfei.burst.ready {
    yanfei burst, attack, charge, attack;
  } else {
    yanfei attack:2;
  }
  yanfei skill,
         attack, charge,
         attack:2, charge,
         attack:2, charge,
         attack:2, charge,
         attack, charge,
         attack:2, skill, charge;
  bennett skill;
}
