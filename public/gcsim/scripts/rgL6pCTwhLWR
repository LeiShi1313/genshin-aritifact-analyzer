chev add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl  add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl  add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" lvl=90/90 refine=4;
yelan add set="noblesse" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311 ; #main 
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662 ;										

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="instructor" count=4;
bennett add stats hp=3571 atk=232 er=0.518 pyro%=0.3495 cr=0.23325; #main
bennett add stats def=33.0624 def%=0.10416 hp=426.6192 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.46284 em=33.2976 cr=0.166824 cd=0.55608; # 0.84x modifier																																							


options swap_delay=12 iteration=100;

active yelan;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  yelan skill, attack, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack;
  }
  bennett burst, attack, skill;
  if .fischl.burst.ready {
    fischl attack:2, burst; 
  } else {
    fischl attack:1, skill; 
  }
  chev attack, burst, attack, skill[hold=1],
     attack, charge, dash,
     attack, skill [hold=1],
     attack, skill[hold=1],
     attack, charge, dash,
     attack, charge, dash,
     attack, charge, dash,
     attack, charge, dash;
  bennett skill, attack:2;
}


