furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="goldentroupe" count=5;							
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ;
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662 ;	

mona char lvl=90/90 cons=0 talent=9,9,9;
mona add weapon="pamber" refine=5 lvl=90/90;
mona add set="clam" count=5;
mona add stats hp=4780 atk=311 atk%=.466 hydro%=0.466 heal=0.359 ; #main
mona add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944 ;																																																						

hutao char lvl=90/90 cons=0 talent=9,9,9 +params=[start_hp%=70];
hutao add weapon="dragonsbane" refine=3 lvl=90/90;
hutao add set="mh" count=4;
hutao add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 cd=0.622 ; #main
hutao add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662 ;																																																																																															


yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=4 lvl=90/90;
yelan add set="emblemofseveredfate" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662 ;											

options swap_delay=12 iteration=500; 

target lvl=100 resist=0.1 hp=10000000 radius=1 pos=0,2;
energy every interval=480,720 amount=1;

active furina;
for let x=0; x<3; x=x+1 {
    furina skill,attack,burst;
    yelan burst,attack;
    if x == 0 {yelan skill,attack;}
    mona skill,attack,burst,attack;
    hutao skill,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge,jump,
    attack:2,charge,jump,attack;
    if .hutao.burst.ready {
    hutao burst;
  } 
  yelan skill,attack;
  while !.yelan.mods.favonius-cd {
  yelan attack;}
}
