# Xilonen Columbina Yunjin Zhongli. ~18s Rot. KQMS KurtC. Xilonen Lunar-Crystallize. Xilonen uses her burst whenever available during her Nightsoul state. Columbina & Zhongli's bursts are used when available. Yunjin does a level 1 hold skill hold.

# Team - Options listed by DPS
xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="harbinger" refine=5 lvl=90/90;
xilonen add set="oc" count=4;
#xilonen add set="scroll" count=4 +params=[stacks=4];
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #main
xilonen add stats def%=0.062*8 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10; # OC
#xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
#xilonen add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # Scroll

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="aubade" count=4;
#columbina add set="gt" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*9 cr=0.0331*7 cd=0.0662*10;

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="footprint" refine=5 lvl=90/90;
yunjin add set="scroll" count=4;
#yunjin add set="husk" count=4;
yunjin add stats hp=4780 atk=311 er=0.518 def%=0.583 def%=0.583; #main
yunjin add stats def%=0.062*8 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*7 cd=0.0662*3;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="deathmatch" refine=1 lvl=90/90;
zhongli add set="sms" count=4;
zhongli add stats hp=4780 atk=311 em=187 geo%=0.466 cd=0.622; #main
zhongli add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active zhongli;

for let i=0; i<5; i=i+1 {
  zhongli skill[hold=1], dash;
  if i > 0 && .zhongli.burst.ready {
    zhongli burst;
  }

  if .columbina.skill.cd { # Nessesary filler
    columbina attack;
  }
  if i > 0 && .columbina.burst.ready {
    columbina skill, burst;
  } else {
    columbina skill, attack;
  }

  yunjin skill[hold=1], burst;

  xilonen skill;
  while .xilonen.nightsoul.state{
    xilonen attack;
    if .xilonen.burst.ready { # For OC
      xilonen burst;
    }
  }
}
