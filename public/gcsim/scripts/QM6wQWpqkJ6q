options swap_delay=12 iteration=1000;

# Build assumptions
mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="favcodex" refine=3 lvl=90/90;
mualani add set="scroll" count=4;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
mualani add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*5 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*9;

skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="moonweaversdawn" refine=1 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
skirk add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="tom" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*11 em=19.82*2 cr=0.0331*10 cd=0.0662*5;

mona char lvl=90/90 cons=0 talent=9,9,9;
mona add weapon="ttds" refine=5 lvl=90/90;
mona add set="no" count=4;
mona add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*4 cd=0.0662*12;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active escoffier;
for let i=0; i<4; i=i+1 {
  escoffier skill, burst;
  mona skill, burst;
  skirk skill[hold=1], burst;
  mualani skill,
          walk[f=1], burst,
          walk[f=46], attack,
          walk[f=90], attack,
          skill;
}

