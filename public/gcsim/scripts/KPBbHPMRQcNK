xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  mualani skill,
          walk[f=90], attack,
          walk[f=90], attack,
          walk[f=90], attack;
}

fn mualani_combo2() {
  mualani skill,
          walk[f=13], burst,
          walk[f=69], attack,
          walk[f=90], attack;
}

active mavuika; # SS Stacks

for let i=0; i<3; i=i+1 {
  mualani attack;
  xilonen skill, attack:2;
  lanyan skill:2;
  mavuika burst, charge, skill, dash;
  pick_up_crystallize("hydro");
  mualani_combo2();
  mualani attack, charge;

  xilonen skill, attack:2;
  lanyan skill:2, attack, burst;
  mavuika skill[hold=1], charge, dash;
  pick_up_crystallize("hydro");
  mualani_combo();
  mualani skill;
}

