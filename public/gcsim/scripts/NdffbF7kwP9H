alhaitham char lvl=90/90 cons=0 talent=9,9,9;
alhaitham add weapon="wolffang" refine=1 lvl=90/90;
alhaitham add set="gildeddreams" count=4;
alhaitham add stats hp=4780 atk=311 em=186.5 dendro%=0.466 cd=0.622; # main
alhaitham add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 em=39.63 er=0.3303 cr=0.3966 cd=0.5284;

nilou char lvl=90/90 cons=0 talent=9,9,9;
nilou add weapon="thedockhandsassistant" refine=1 lvl=90/90;
nilou add set="tenacityofthemillelith" count=2;
nilou add set="vourukashasglow" count=2;
nilou add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; # main
nilou add stats hp=2539.40 hp%=0.2973 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 em=198.15 er=0.1101 cr=0.0661 cd=0.1321;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="xiphosmoonlight" refine=1 lvl=90/90;
xingqiu add set="flowerofparadiselost" count=4;
xingqiu add stats hp=4780 atk=311 em=186.5 em=186.5 em=186.5; # main
xingqiu add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.3964 def=39.35 def%=0.1239 em=118.89 er=0.6606 cr=0.0661 cd=0.1321;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="sapwoodblade" refine=5 lvl=90/90 +params=[pickup_delay=210]; # alhaitham picks up the leaf
kirara add set="deepwoodmemories" count=4;
kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; # main
kirara add stats hp=2539.40 hp%=0.2973 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 em=79.26 er=0.3303 cr=0.1322 cd=0.1321;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999; 
target lvl=100 resist=0.1 radius=1 pos=1.5,0 hp=999999999;

energy every interval=480,720 amount=1;

active nilou;

for let i = 0; i < 5; i = i + 1 { # 5 rotations
  
  nilou skill, attack:2, skill;
  kirara skill[short_hold=1], burst;
  xingqiu skill, dash, burst, attack;
  alhaitham skill,
            attack:3, dash,
            attack, charge,
            attack:3;
  kirara attack, skill[short_hold=1], attack;
  alhaitham burst, attack;
  xingqiu attack:2;
  wait(17); # swap delay
  alhaitham attack:3, dash,
            attack:3, dash,
            attack:1, charge,
            attack:3, dash;
  print(.stam);
}

# Nilou E N2 E > Kirara shE Q > Xingqiu E d Q N1 > Alhaitham E N3d N1C N3 > 
# Kirara N1 shE N1 > Alhaitham Q N1 > Xingqiu N2 >
# Alhaitham N3d N3d N1C N3d