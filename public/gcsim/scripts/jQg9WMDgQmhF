# Gaming Citlali Kazuha Bennett. ~20s Rot. Gaming Melt Plunge with 7 plunges, 6 melted, 5 buffed by Bennett. Gaming juggles Man Chai, using burst into skill + plunge and waiting on the ground before catching Man Chai mid descent. The final plunge is not melted, but is delayed for Gaming's particle ICD. Burstless Kazuha uses E in Bennett Q.

# Team - Options listed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
#citlali add weapon="evenstar" refine=1 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.3641 cd=0.331;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; # main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Adjacent

let SeventhPlungeMelt = false;

# Rotation
active gaming; #SS Stacks
#gaming skill, low_plunge, dash; # Pyro VV 1st Rot

for let i=0; i<4; i=i+1 {
  bennett skill, burst;
  
  kazuha skill, high_plunge;
  
  citlali skill, burst;
  
  if SeventhPlungeMelt == false {
    gaming burst;
    let plungeCount = 0;
    for let j = 0; j < 6; j = j + 1 {
      sleep(45); # Cacth Manchai during descent
      gaming skill, high_plunge;
      plungeCount = plungeCount + 1; print(plungeCount);
    }
    sleep(30); # needed for particle ICD.
    gaming skill, high_plunge; print(plungeCount + 1); # Unmelted
  } else {
    gaming burst;
    let plungeCount = 0;
    for let j = 0; j < 5; j = j + 1 {
      sleep(45); # Cacth Manchai during descent
      gaming skill, high_plunge;
      plungeCount = plungeCount + 1; print(plungeCount);
    }
    sleep(30); # Cacth Manchai during descent
    gaming skill, high_plunge;
    plungeCount = plungeCount + 1; print(plungeCount);
    
    citlali attack:2;
    
    gaming skill, high_plunge; 
    plungeCount = plungeCount + 1; print(plungeCount); # Melted
  }
}
