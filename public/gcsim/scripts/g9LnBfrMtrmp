let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilonen && action_id == .action.skill) {
    pick_up_crystallize("any"); # Pick up crystallize before every dash
  }

  return _execute_action(char_id, action_id, p);
}

navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="mh" count=5;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cd=0.622 ; #main
navia add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662 ;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311 ; #main
xilonen add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

