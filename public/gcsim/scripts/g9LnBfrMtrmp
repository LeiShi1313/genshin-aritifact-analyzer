furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.16503 em=39.64 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active navia; ## SS Stacks

for let i=0; i<4; i=i+1 {

  xilonen burst;

  furina skill, dash, burst;

  xilonen skill, attack:2;
  pick_up_crystallize("any");

  sigewinne skill, dash;

  navia burst;

  navia skill[hold=1], attack:3, dash, attack:2;

  xilonen skill, attack:2;
  pick_up_crystallize("any");

  navia skill[hold=1], attack:3, dash, attack:2;
  if i == 0 || i == 3 {
    navia skill[hold=1], attack;
  }
}
