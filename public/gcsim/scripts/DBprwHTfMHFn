options swap_delay=12 iteration=1000;

neuvillette char lvl=90/90 cons=0 talent=9,9,9 ;
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90 ;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="harbinger" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="ap" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9 ;
xianyun add weapon="favoniuscodex" refine=3 lvl=90/90;
xianyun add set="viridescentvenerer" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

active neuvillette;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {

  neuvillette skill;
  furina skill, dash, burst;
  zhongli skill[hold=1], dash;

  for let j=0; j<60; j=j+1 { // Wait up to 60f for hydro crystallize
    if pick_up_crystallize("hydro") {
      break;
    }
    wait(1);
  }

  xianyun skill, high_plunge, burst;
  neuvillette charge, burst, skill, charge;
  zhongli skill[hold=1], dash;

  for let j=0; j<60; j=j+1 { // Wait up to 60f for hydro crystallize
    if pick_up_crystallize("hydro") {
      break;
    }
    wait(1);
  }

  xianyun skill, high_plunge;
  neuvillette charge, charge;

}
wait(173); #for the last CA
