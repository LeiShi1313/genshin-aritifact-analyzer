# Kaveh Fischl Raiden Xianyun. ~24s Rot. Kaveh-Raiden Quicken Plunge. Kaveh spends plunges in the first half of the rotation, Raiden on-fields in the second. Quicken lingers until the last N3 of Raiden's burst. Kaveh skills off cooldown to meet ER needs. Kaveh C6 introduces Swirl issues. 50% Collisions.

# Team - Options ordered by DPS
kaveh char lvl=90/90 cons=5 talent=9,9,9;
kaveh add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];# Kaveh slot 1
#kaveh add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=0]; # Kaveh not Leading
#kaveh add weapon="fruitfulhook" refine=1 lvl=90/90; # Kaveh not Leading
kaveh add set="longnightsoath" count=4;
#kaveh add set="deepwood" count=4;
kaveh add stats hp=4780 atk=311 er=0.518 dendro%=0.466 cd=0.622; #main
kaveh add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
#raiden add weapon="fjords" refine=1 lvl=90/90;
raiden add set="tom" count=4;
#raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296; # ToM
#raiden add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958; # Emblem

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=115.78 atk%=0.2976 er=0.1653 em=237.84 cr=0.0662 cd=0.1324; # ToM Raiden
#xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
#xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=99.24 atk%=0.2976 er=0.2204 em=237.84 cr=0.0662 cd=0.1324; # Emblem Raiden

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active kaveh; # SS stacks
raiden attack, skill;

#active raiden;
#raiden skill;

for let x = 0; x < 4; x = x + 1 {
  xianyun skill, low_plunge, attack, burst;

  fischl attack, skill;

  kaveh skill, burst;
  # Plunge Combo w/ skill as available
  while .kaveh.status.xianyun-airborne-buff {
    kaveh jump;
    if .airborne {
      kaveh low_plunge[collision=rand()>0.5];
    }
    if .kaveh.skill.ready {
      kaveh skill;
    } else {
      kaveh dash;
    }
  }

  xianyun attack:2; sleep(20); # Kaveh C6 introduces swirl issues

  fischl attack:2, burst;

  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:3;

  print("done");
}
