zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;																	
																						
							
# ----  Default Enemy
options swap_delay=12 debug=true iteration=1000;
target lvl=100 resist=0.1 hp=100000000 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

active neuv;
for let i = 0; i < 4; i = i + 1 {
  neuv skill, attack:3;
  zhongli skill[hold=1], dash, attack;
  for let k=0; k<25; k=k+1 {
    if .gadgets.crystallizeshard.hydro > 0 { 
      pick_up_crystallize("hydro"); 
      break; 
    } else if .gadgets.crystallizeshard.electro > 0 { 
      pick_up_crystallize("electro"); 
      break; 
    }
    wait(1);
  } 
  yae skill:3;
  fischl attack, skill;
  neuv charge, burst, skill, charge;
  zhongli skill[hold=1], dash, attack;
  for let k=0; k<25; k=k+1 {
    if .gadgets.crystallizeshard.hydro > 0 { 
      pick_up_crystallize("hydro"); 
      break; 
    } else if .gadgets.crystallizeshard.electro > 0 { 
      pick_up_crystallize("electro"); 
      break; 
    }
    wait(1);
  } 
  yae skill:3;
  fischl attack:2, burst;
  neuv charge:2;
}
wait(173);

