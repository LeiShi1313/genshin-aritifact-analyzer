chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no"  count=4;
chongyun add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favoniussword" refine=3 lvl=90/90;
xingqiu add set="emblemofseveredfate" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="deathmatch" refine=1 lvl=90/90;
xiangling add set="emblemofseveredfate" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.4634;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="cw" count=4;
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.5510 em=39.64 cr=0.1986 cd=0.662;


options swap_delay=12 iteration=1000;

active chongyun;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  chongyun attack, skill;
  bennett burst, skill;                 # melt, apply pyro
  chongyun burst, dash;                 # Triple melt, trigger 4pc noblesse, leave cyro with c6
  xiangling burst, dash;
  set_player_pos (0,-1);                # move away not to apply hydro with orbital
  xingqiu burst, dash;
  set_player_pos (0,0);
  xingqiu skill, dash, attack:2;        # vaporizing his E skill, catching his own particles
  xiangling skill, dash, attack:2;
  bennett skill, attack;
  xiangling attack:3, dash, attack:3;   # XL catches bennett particles
  bennett skill, attack;
  xingqiu attack:3;
}

# Chongyun N1 E > Bennett QE > Chongyun Q > XL Q > Xingqiu Q E dash N2 > XL E dash N2 > Bennett E N1 > XL N3D N3 > Bennett E N1 > Xingqiu N3
