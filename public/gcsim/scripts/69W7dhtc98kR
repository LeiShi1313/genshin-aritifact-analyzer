klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="mh" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
klee add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

sigewinne char lvl=90/90 cons=0 talent=9,9,9;
sigewinne add weapon="favoniuswarbow" refine=5 lvl=90/90;
sigewinne add set="ohc" count=4;
sigewinne add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
sigewinne add stats def=39.36 def%=0.124 hp=2539.4 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="goldentroupe" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 heal=0.359; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active furina;
for let i=0; i<3; i=i+1 {
  furina skill, dash, burst;
  sigewinne attack, skill, attack;
  bennett burst, skill;

  klee attack[travel=6], burst, walk,
       attack[travel=6], charge,
       attack[travel=6], charge,
       attack[travel=6], skill[bounce=3, mine=8],
       attack[travel=6];
  if .klee.skill.ready {
    klee skill[bounce=3, mine=8], attack[travel=6],
         charge, attack[travel=6];
  }
  klee charge,
       attack[travel=6], charge,
       attack[travel=6], charge,
       attack[travel=6], charge;
  if i {
    klee attack[travel=6], walk, attack[travel=6], walk, attack[travel=6], charge;
  } else {
    klee attack[travel=6], charge;
  }
  klee attack[travel=6];

  bennett skill, attack;
}
