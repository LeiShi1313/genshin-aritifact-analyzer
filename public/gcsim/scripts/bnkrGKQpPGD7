options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active mavuika;
for let i=0; i<4; i=i+1 {
  mavuika skill;
  xilonen skill, burst, attack:2;
  bennett skill, burst;
  rosaria skill, dash;
  pick_up_crystallize("pyro");
  rosaria burst;
  mavuika burst;
  wait(65);
  mavuika charge:4, dash;
  wait(79);
  mavuika charge:3;
  while .mavuika.burst.cd != 480 {
    wait(1);
  }
}
