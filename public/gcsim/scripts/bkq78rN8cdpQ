target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active navia; # SS Stacks

furina skill, dash;
for let i=0; i<5; i=i+1 {

  xilonen skill, attack, burst, attack;

  furina burst;

  if i {
    furina skill, dash;
  }

  navia burst;

  yelan burst, attack, skill, attack;

  xilonen skill, attack:2;

  navia skill, attack:3, dash, attack:2,
        skill, attack:3, dash, attack:2;

  yelan attack, skill, attack:2;

  if is_even(i) {
    navia attack, skill;
  }
}

