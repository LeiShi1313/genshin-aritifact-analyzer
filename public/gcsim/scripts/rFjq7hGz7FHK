fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9 +params=[breakthrough=1];
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

options iteration=1000 duration=200 swap_delay=12;
target lvl=100 resist=0.1 pos=2.4,0 radius=2;
energy every interval=480,720 amount=1;

active furina;

while true {

  if !.furina.status.furina-skill && .furina.swap.ready { # Maintain Furina EQ
    furina skill, dash;

  } else if .furina.burst.ready && .furina.swap.ready {
    furina burst;

  } else if !.fischl.oz && .fischl.skill.ready && .fischl.swap.ready { # Maintain Oz
    fischl attack, skill, attack;

  } else if !.fischl.oz && .fischl.burst.ready && .fischl.swap.ready {
    fischl attack:2, burst;

  } else if .xilonen.skill.ready && ( !.xilonen.status.scroll-4pc-electro || !.xilonen.status.scroll-4pc-hydro ) && .xilonen.swap.ready { # Maintain Xilo buffs
    xilonen skill, attack:2;

  } else if .xilonen.burst.ready && .xilonen.swap.ready { # Xilo burst for healing
    xilonen burst;

  } else if .yelan.burst.ready && .yelan.swap.ready { # Maintain Yelan Q
    yelan burst, attack;

  } else if .yelan.skill.ready && .yelan.swap.ready { # Yelan E on cooldown
    yelan skill, attack;

  } else if .furina.onfield && !.yelan.swap.ready { # Catches swap warning when Furina E and Q desync
    furina attack;

  } else { # Default to Yelan onfield NA spam
    yelan attack;
  }

}
