# Sayu Nahida Fischl Yae. ~25s Rot. Rolling Aggravte Sayu and Yae share the rotation. 6.5s Roll Sayu. Burstless Yae.

sayu char lvl=90/90 cons=6 talent=9,9,9;
sayu add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#sayu add weapon="rainslasher" refine=3 lvl=90/90;
#sayu add weapon="bloodtainted" refine=5 lvl=90/90;
sayu add set="vv" count=4;
sayu add stats hp=4780 atk=311 er=0.518 em=187 em=187; # ER/EM/EM
sayu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2648 cd=0.7282;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
#nahida add set="tom" count=4;
#nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=118.92 cr=0.2979 cd=0.5296;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # ATK%/DMG/CR
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gt" count=4;
#yae add set="gd" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # ATK%/DMG/CR
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active yae;
yae skill:3;

for let i=0; i<4; i=i+1 {
  nahida skill, burst;
  fischl attack, skill;
  sayu skill[hold=390];
  yaemiko skill:2, attack, skill;
  fischl attack:2, burst;
  nahida skill, attack, charge;
  sayu burst;
  yae attack, charge,
      attack, charge, jump,
      attack, charge, dash;
  yae attack, skill,
      attack, skill,
      attack, skill;

  print("Done");
}
