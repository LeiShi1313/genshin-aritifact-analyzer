# Razor Yelan Fischl Rosaria. ~25s Rot. Defenseless Phys Razor. Rosaria C6 and SC debuffs linger for the duration of Razor's Field time. Fischl uses skill and burst every rotation.

# Team
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="pf" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main 
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=3 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main 
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main 
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main 
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=99.1 cr=0.331 cd=0.3972;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active razor; # SS stacks
#razor skill, dash;

for let i=0; i<4; i=i+1 {
  fischl skill, attack;
  
  rosaria skill;
  if !.rosaria.mods.favonius-cd {
    rosaria attack;
  }
  rosaria burst;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  fischl attack:2, burst;
  
  razor attack, skill, dash, attack, burst;
  while .razor.mods.razor-q > 160 {
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
}
