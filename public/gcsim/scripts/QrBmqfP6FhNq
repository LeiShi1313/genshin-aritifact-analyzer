# Options

options swap_delay=12 iteration=500;
energy every interval=480,720 amount=1;

# Targets

target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4; #1T

# 2T
# target lvl=100 resist=0.1 radius=2 pos=2.1,2.4 hp=999999999; 
# target lvl=100 resist=0.1 radius=2 pos=-2.1,2.4 hp=999999999; 

# Actions

active furina;
for let x=0; x<4; x=x+1 {
  furina attack, skill, dash, burst;
  xianyun skill, low_plunge;
  #xianyun skill, low_plunge; #for C1
  bennett burst, skill, attack;
  xianyun attack, burst;
  klee attack, skill[bounce=3, mine=8];
  if .klee.burst.ready {
    klee burst;
  }
  for let x=0; x<6; x=x+1 {
    let col = rand();
    klee attack, charge;
    if .klee.status.xianyun-airborne-buff {
      klee jump;
      if .airborne{
        if col > 0.5 {
          klee high_plunge[collision=1];
        }
        else {
          klee high_plunge;
        }
      }
    }
  }
}

# Kleerina with Bennett and Xianyun. Double swirl rotation makes Xianyun struggle with ER. Klee bursts every other rotation and has a 50% collision rate. Rotation is difficult to pull off in-game because of lack of interrupt resistance and quickly switching aura. 21/22s rotation.
# Furina N1 E d Q, Xianyun E lP, Bennett Q E N1, Xianyun N1 Q, Klee N1E(Q) 6N1CJhP