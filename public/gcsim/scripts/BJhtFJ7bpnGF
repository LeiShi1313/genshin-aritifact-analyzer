# Hutao Citlali Escoffier Xianyun. ~18s Rot. Hutao Melt Plunge. 6 High plunges > 7 low plunges. OHC over SoDP but bubbles may miss.

# Team - Options listed by DPS
hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="ballad" refine=1 lvl=90/90;
hutao add set="sr" count=4;
hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311;
hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.1655 cd=0.7944;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.0993 cd=0.7282;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="tom" count=4;
#escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9; 
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="ohc" count=4; # Bubbles may miss
xianyun add set="sodp" count=4;
#xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Adjacent

let hutaoHighPlunge = true; # Better vape consistency in later rotations

# Rotation
active esco; #SS Stacks

for let i=0; i<4; i=i+1 {
  esco skill;

  xianyun skill, low_plunge, burst;
  
  citlali skill, burst;
  
  if hutaoHighPlunge {
    hutao skill, attack:1;
    for let p = 6; p > 0; p = p - 1 {
      hutao jump;
      if .airborne {
        hutao high_plunge[collision=rand()>0.5];
      }
    }
    hutao attack:1;
  } else {
    hutao skill, attack:1;
    for let p = 7; p > 0; p = p - 1 {
      hutao jump;
      if .airborne {
        hutao low_plunge[collision=rand()>0.5];
      }
    }
  }
  if .hutao.burst.ready && .hutao.energy == .hutao.energymax  {
    hutao burst;
  } else if .esco.burst.ready && .esco.energy == .esco.energymax {
    esco burst;
  }
}

