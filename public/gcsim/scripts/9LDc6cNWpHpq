lyney char lvl=90/90 cons=0 talent=9,9,9 ;
lyney add weapon="prototypecrescent" refine=5 lvl=90/90;
lyney add set="marechausseehunter" count=4;
lyney add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
lyney add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=9,9,9; 
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="eosf" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944 ;

yae char lvl=90/90 cons=0 talent=9,9,9; 
yae add weapon="wanderingevenstar" refine=1 lvl=90/90;
yae add set="totm" count=5;
yae add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
yae add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662 ;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662 ;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.5;
energy every interval=480,720 amount=1;

active lyney;

let rotations = 5;

for let r = rotations; r > 0; r = r - 1 {

  lyney aim[weakspot=1];  

  yae skill, skill, skill;

  bennett skill, burst;

  chevreuse skill[hold=1];
  while !.chevreuse.burst.ready {
    chevreuse attack;
  }
  chevreuse burst;

  lyney aim[weakspot=1], aim;

  if .lyney.burst.ready {
    lyney burst;
    delay(11);
    lyney skill;
  } else {
    lyney aim;
  }

  lyney aim, skill;

}