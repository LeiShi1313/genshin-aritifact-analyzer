active mavuika; # SS Stacks

for let i=0; i<3; i=i+1 {
  mona skill;
  
  xilonen skill, attack:2; 
 
  mona dash; pick_up_crystallize("hydro");
  mona burst;
 
  mavuika skill, burst, charge;
 
  mualani skill,
          walk[f=91], attack,
          walk[f=91], attack,
          walk[f=91], attack;

  if .mualani.burst.ready {
    mualani burst;
  } 
}
mavuika charge:2;