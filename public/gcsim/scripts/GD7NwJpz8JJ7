kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=5 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187;
kazuha add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 em=118.92 er=0.551 cr=0.331 cd=0.1324;

# Config - - - -

options iteration=100 duration=100 swap_delay=12;
target lvl=100 hp=9999999 resist=0.1 particle_threshold=460000 particle_drop_count=3;
# 12-3 Maguu Kenki Particles

# Rotations - - - -

active neuv;

for let i=0;i<4;i=i+1 {
  neuv skill;
  furina skill, dash, burst;
  barbara burst;
  while !.barbara.mods.favonius-cd {
    barbara attack;
  }
  kazuha skill, high_plunge, burst;
  neuv charge, skill, charge, burst;
  kazuha skill, high_plunge;
  neuv charge:2;
  }
wait(173);
# Neuv E > Furina EQ > Barbara Q (#NA) > Kazuha EQ > Neuv CA E CA Q > Kazuha E > Neuv 2CA > Repeat
