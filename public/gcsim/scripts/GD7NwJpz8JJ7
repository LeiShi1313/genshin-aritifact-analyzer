neuv add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
neuv add stats def=39.36 def%=0.124 atk=33.08 atk%=0.0992 hp=507.88 hp%=0.2976 em=39.64 er=0.1102 cr=0.2648 cd=0.7944;

