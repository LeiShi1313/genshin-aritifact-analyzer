faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="goldentroupe" count=5;							
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;																							

kokomi char lvl=90/90 cons=0 talent=9,9,9; 
kokomi add weapon="thrillingtalesofdragonslayers" refine=5 lvl=90/90;
kokomi add set="songofdayspast" count=5;
kokomi add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359 ; #main
kokomi add stats def=39.36 def%=0.124 hp=1523.64 hp%=0.3968 atk=33.08 atk%=0.5952 er=0.1102 em=39.64 cr=0.0662 cd=0.1324;

options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active furina;
for let i=0; i<2; i=i+1 {
  furina skill, dash;
	if !.furina.burst.ready {
	  furina attack;
	} 
	furina burst;
	
  faruzan burst;
  
  kokomi skill;
  
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
  print("end");
}
