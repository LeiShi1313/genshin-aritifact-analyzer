# Varesa Chevreuse Ororon Durin. ~20s Rot. KQMS KurtC. Varesa Overload w/ Ororon. 7 plunges. Chevreuse SoDP + Burst in 1st rot only > NO + Burst every rot.

# Team - Options listed by DPS
varesa char lvl=90/90 cons=0 talent=9,9,9;
varesa add weapon="widsith" refine=3 lvl=90/90;
varesa add set="oc" count=4;
varesa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
varesa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
#chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*3 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*7; # SoDP
#chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
#chevreuse add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*12 cd=0.0662*2; # NO

ororon char lvl=60/60 cons=6 talent=9,9,9;
ororon add weapon="rainbowserpent" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
ororon add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Funtions
# Varesa Plunge
fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

# Rotation
active varesa;
varesa attack; # Chev RES Shred 1st Rot

for let i=0; i<4; i=i+1 {
  if .chev.sets.emblem >= 4 || .chev.sets.gt >= 4 {
    chev burst, skill[hold=1]:3; # DPS
  } else if .chev.sets.no >=4 {
    chev burst, skill[hold=1]:2;
  } else {
    if i == 0 {
      chev burst, skill[hold=1]:1;
    } else {
      chev skill[hold=1], attack;
    }
  }

  durin skill, skill, burst;

  ororon skill, burst;

  varesa_combo(7);
}
