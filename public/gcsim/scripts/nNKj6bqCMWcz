# Sethos Fischl Mona Nahida. KQMS. ~17 second rotation. Sethos uses 1 fully charged shot and 8n2w n1. ~13% and ~22% dps loss for c2 and c0 mona, respectively.

sethos char lvl=90/90 cons=6 talent=9,9,9;
sethos add weapon="slingshot" refine=5 lvl=90/90;
sethos add set="dpc" count=4;
sethos add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
sethos add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=5 lvl=90/90;
mona add set="cg" count=4;
mona add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="wanderingevenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*12 cd=0.0662*8;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets - Hyperbloom Ownership varies with size
target lvl=100 resist=0.1 radius=3 pos=0,3.3 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000;

# Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  nahida skill, burst;
  mona attack, skill, burst, attack;
  fischl skill, attack;
  mona attack:3;
  sethos aim[hold=2], skill, burst,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack,
         skill;
  nahida skill, attack;
  mona skill, burst, attack;
  fischl attack:2, burst;
  mona attack:3;
  sethos aim[hold=2], skill, burst,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack,
         skill;
}
