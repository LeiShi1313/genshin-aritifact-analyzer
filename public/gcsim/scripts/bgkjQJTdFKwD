kamisatoayato char lvl=90/90 cons=0 talent=9,9,9;
kamisatoayato add weapon="finale" refine=5 lvl=90/90;
kamisatoayato add set="mh" count=4;
kamisatoayato add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cd=0.622;
kamisatoayato add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="goldentroupe" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="ap" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.3972;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

let Xilo_Use_Dash = false; # change between true and false to make Xilonen use Dash

active xilonen;

for let i=0; i<4; i=i+1{
  xilonen burst;
  furina skill, dash, burst;
  xilonen skill, attack:2;
  if .xilonen.sets.ap >=4 {
    if Xilo_Use_Dash {
      xilonen dash;
    }
    pick_up_crystallize("hydro");
  }
  citlali skill, attack;
  ayato skill, attack:15, burst;
  xilonen skill, attack:2;
  if .xilonen.sets.ap >=4 {
    if Xilo_Use_Dash {
      xilonen dash;
    }
    pick_up_crystallize("hydro");
  }
  citlali burst;
  ayato skill, attack:15;
}

# Xilonen Q > Furina ED Q > Xilonen E N2D > Citlali E N1 > Ayato E N15 Q > Xilonen E N2D > Citlali Q > Ayato E N15
