xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="thecatch" refine=5 lvl=90/90;
xiangling add set="eosf" count=4;
xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=79.28 cr=0.2648 cd=0.7944;

options swap_delay=12 iteration=1000 duration=90;
target lvl=100 resist=0.1 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active emilie;

# Emilie E/Q > Bennett QE > Xiangling Q ED > Childe Q E 5[N2D] N4D >
# Bennett E > Xiangling N1 E > Childe C > Bennett N1 E > Xiangling N2 > Childe C
for let i=0; i<4; i=i+1 {
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  bennett burst, skill;
  xiangling burst, skill, dash;
  tartaglia burst, walk, skill,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:2, charge, dash,
    attack:4, charge, dash;
  bennett skill;
  xiangling attack, skill;
  tartaglia aim;
  bennett attack, skill;
  xiangling attack:2;
  tartaglia aim;
}
