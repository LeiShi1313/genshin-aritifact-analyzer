neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90;
neuvillette add set="mh" count=5;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
neuvillette add stats hp%=0.3968 hp=507.88 atk%=0.0992 atk=33.08 def%=0.124 def=39.36 em=39.64 cr=0.2648 cd=0.662 er=0.1102 ; #subs			

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="favlance" refine=3 lvl=90/90;
raiden add set="gd" count=4;
raiden add stats hp=4780 atk=311 em=187 em=187 em=187;
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="favoniuscodex" refine=3 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 cr=0.311 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="gd" count=5;
xiangling add stats hp=4780 atk=311 er=0.518 em=186.5 em=186.5; #main
xiangling add stats hp%=0.0992 hp=507.88 atk%=0.0992 atk=33.08 def%=0.124 def=39.36 em=158.56 cr=0.3972 cd=0.1324 er=0.3306 ; #subs

options swap_delay=12 iteration=1000;

active neuvillette;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;


for let i=0; i<4; i=i+1 {
    if i == 0 {
      neuvillette skill;      
    } else {
      # When not on the first rotation, we need to wait for Nahida E
      # to expire so that when we apply hydro to clear the dendro we
      # don't proc her E again. E N1 will clear remaining dendro and
      # apply hydro for EC, to get an EC A1 stack from Raiden later.
      delay(135); 
      neuv skill, attack:2;
      
      #Ensure Neuv catches his own E particles
      delay(21);
    }
    raiden skill, attack;
    nahida skill, burst;
    xiangling skill, burst;
    neuvillette charge;
    #delay(30); #Delaying burst by 30f allows the 2nd CA here to vape once extra. Probably due to ICD timings
    wait(203); #This is equivalent to delay(30) when there are no energy issues.
    neuvillette burst,skill,charge;
    xiangling skill,attack:2;
    neuvillette charge, charge;
}
wait(173); #need wait for the last CA to finish before exiting the sim
