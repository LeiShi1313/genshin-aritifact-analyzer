#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD + ATK; TS
#razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD + Elec 
razor add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD + Pyro; Echoes
#razor add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # CR + Pyro; TS/WGS

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
#chev add weapon="dialogues" refine=5 lvl=90/90;
#chev add weapon="rightfulreward" refine=5 lvl=90/90;
chev add set="scroll" count=4;
#chev add set="sodp" count=4;
#chev add set="tom" count=4; # Snapshot Oz
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296; # Hp/Hp/Cr
#chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
