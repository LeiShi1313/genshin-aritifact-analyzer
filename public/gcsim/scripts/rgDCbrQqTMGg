# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets, Freezable, In front & Adjacent
target lvl=100 resist=0.1 radius=1.5 pos=1.9,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=1.5 pos=-1.9,2.4 hp=100000000 freeze_resist=0;

# Protoype Crescent Headshot Conditional
fn ganyuAim() {
  if .ganyu.weapon == .keys.weapon.crescent { # Attempts headshots (70%) with Crescent
    ganyu aim[hold=2, weakspot=rand()>0.3];
  } else { # Non weakspot opponents
    ganyu aim[hold=2];
  }
}

# Rotation
active mavuika; # SS Stacks

for let i = 0; i < 4; i = i + 1 {
  if is_even(i) {
    esco burst;
  }
  esco skill;

  ganyu skill;
  if .ganyu.burst.ready {
    ganyu burst;
  } else {
    ganyuAim();
  }
  
  if .mav.burst.ready {
    mav burst, skill, dash;
  } else {
    mav skill, dash;
  }
  
  xl burst, skill, dash;
  
  ganyuAim();
  ganyuAim();
  ganyu skill;
  ganyuAim();
  ganyuAim();
  ganyuAim();
  ganyuAim();
  if is_even(i) {
    ganyu aim;
  }
}
