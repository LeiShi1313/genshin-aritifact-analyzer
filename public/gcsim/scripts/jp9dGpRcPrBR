fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="risingwinds" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=9999999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active mona;

for let i = 0; i < 6; i = i + 1 {

  mona skill, attack;
  yelan skill, burst, attack;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  mona burst, attack;
  hutao skill,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:1, charge, jump,
  attack:1, charge, dash;
}
