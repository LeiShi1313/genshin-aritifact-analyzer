jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="favoniussword" refine=3 lvl=90/90;
jean add set="vv" count=4;
jean add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311 ; #main
jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;


options swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
active furina;
  

for let i=0; i<4; i=i+1 {
  
  furina skill, burst;
        
  jean burst, skill;
  
  faruzan skill, attack;
  
  bennett skill, burst;
  
  faruzan burst, aim[weakspot=1], aim, skill, aim:2;
  
  bennett attack, skill;
    
  jean attack:2, skill;
    
  faruzan attack, skill, aim, aim[weakspot=1];
    
}
