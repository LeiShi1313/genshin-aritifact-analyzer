# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

#Rotation
active raiden;
raiden skill;
#nahida attack;

for let x = 0; x < 4; x = x + 1 {
  nahida skill;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  
  xingqiu skill, dash, burst, attack;
  
  bennett burst, attack, skill;
  
  while .xingqiu.mods.xingqiuburst > 60 {
  #while .bennett.infusion.bennett-fire-weapon {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  
  raiden attack, skill;
}

