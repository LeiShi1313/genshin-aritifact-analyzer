mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="sacrificialjade" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=5;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
mualani add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.0662 cd=0.662;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="scroll" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311 ; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphosmoonlight" refine=1 lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="ap" count=5;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.2204 em=39.64 cr=0.331 cd=0.3972;

options swap_delay=12 iteration=1000;

active mualani;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

mualani attack; # for hydro swirl & crystallize in the 1st rot
for let i=0; i<2; i=i+1 {
  zhongli skill[hold=1], dash, attack;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  kazuha skill, high_plunge;
  xiangling burst, skill, dash;
  pick_up_crystallize("hydro");

  mualani skill;
  mualani_combo();
  mualani burst;
  delay(8); # to prevent the normal N1 hitting before Q
  while !.element.t0.hydro {
    mualani attack;
  }



  zhongli skill[hold=1], dash, attack;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  kazuha skill, high_plunge;
  xiangling attack:2;
  if !.xiangling.mods.favonius-cd {
    xiangling attack;
  }
  xiangling skill, dash;
  pick_up_crystallize("hydro");
  kazuha burst;

  mualani skill;
  mualani_combo();
  if .mualani.nightsoul.state {
    mualani skill; # exit the nightsoul state
  }
  while !.element.t0.hydro {
    mualani attack;
  }
}

# Mualani N1 >
# Zhongli hED N1 > Kazuha tEP > Xiangling QED >             Mualani E 3[3-stacked bite] Q         N1(NA till the enemy has hydro arua) >
# Zhongli hED N1 > Kazuha tEP > Xiangling N2ED > Kazuha Q > Mualani E 3[3-stacked bite] E(cancel) N1(NA till the enemy has hydro arua)>
