# Gaming Lynette Rosaria Bennett. ~18s Rot. Gaming Melt. 6 plunges, 5 melted plunes, or 6 with a slight delay for the final Vivid shot. Lynette spends her skills all at once. Lynette's burst absorbs Cryo. Weapon swirl not implemented; In-game you should obtain an easy Pyro VV from Lynette's C6 with Bennett C6.

# Team
gaming char lvl=90/90 cons=6 talent=9,9,9; 
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=5;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favoniuslance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="favsword" refine=3 lvl=90/90;
lynette add set="vv" count=4;
lynette add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="ins" count=4;
bennett add stats hp=3571 atk=232 er=0.518 pyro%=0.348 cr=0.23325; #main
bennett add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.277704 em=33.2976 cr=0.13902 cd=0.389256;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active gaming; # SS Stacks

for let i=0; i<4; i=i+1 {
  bennett skill, burst;
  
  rosaria skill, burst;
  
  while .lynette.skill.ready {
    lynette skill;
  }
  if .lynette.burst.cd {
    lynette attack;
  }
  lynette burst;
  
  gaming burst;
  #wait(45);
  gaming attack:2;
  for let p=1; p<5; p=p+1 { # 4 plunges
    gaming skill, low_plunge; print(p);
    wait(40);
  }
  gaming skill, low_plunge; print("5");
  #wait(40); # Final Vivid Shot
  gaming skill, low_plunge; print("6");
}

