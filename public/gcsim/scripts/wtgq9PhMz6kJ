# Nilou Furina Yelan Escoffier. ~21s Rot. Hydro DPS MH HDC Nilou onfield in Escoffier Freeze. Nilou does EN2QN1 to funnel her burst. Yelan Catches her own particles. Not heavily optimized.

# Team- Option Listed by DPS
nilou char lvl=90/90 cons=0 talent=9,9,9;
nilou add weapon="harbinger" refine=5 lvl=90/90;
#nilou add weapon="wolffang" refine=1 lvl=90/90;
nilou add set="mh" count=4;
nilou add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
nilou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.2648 cd=0.662; # HoD
#nilou add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#nilou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.2317 cd=0.662; # WF

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="scroll" count=4;
#escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.3306 em=39.64 cr=0.1324 cd=0.3972;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;

  esco skill, burst;

  yelan burst, attack;
  if !.yelan.skill.ready && .yelan.breakthrough {
    yelan aim;
  }
  yelan skill, attack;

  nilou skill, attack:2, burst, attack:1, attack:3, attack:3, attack:3, attack:3;

  yelan skill, attack:4;
}
