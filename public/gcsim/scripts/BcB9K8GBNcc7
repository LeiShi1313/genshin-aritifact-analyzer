# Kaveh Nahida Fischl Kirara. ~22s Rot. Kaveh Spread with Kaveh using skill off CD during his burst time. Fischl alternates skill and burst. Kirara and Nahida burst as available.

# Team - Options listed by DPS
kaveh char lvl=90/90 cons=6 talent=9,9,9;
kaveh add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
kaveh add set="glad" count=4;
kaveh add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
kaveh add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.4634;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="sacjade" refine=1 lvl=90/90;
#nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.2648 cd=0.7944; # Sac Jade
#nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
#nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944; # Evenstar

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="gt" count=4;
#fischl add set="scroll" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="favsword" refine=3 lvl=90/90;
kirara add set="deepwood" count=4;
kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
kirara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
  
# Rotation
active kaveh; # SS Stacks

fischl attack, skill;

for let i = 0; i < 4; i = i + 1 {
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  kirara skill[short_hold=1];
  if .kirara.burst.ready {
    kirara burst;
  }

  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  
  kaveh skill, burst;
  while .kaveh.mods.kaveh-q > 120 { 
    if .kaveh.skill.ready {
      kaveh skill;
    } else if .kaveh.normal > 3 {
      kaveh walk;
    } else {
      kaveh attack;
    }
  }
}
