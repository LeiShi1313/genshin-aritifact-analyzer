diluc char lvl=90/90 cons=0 talent=9,9,9;
diluc add weapon="rainslasher" refine=3 lvl=90/90 +params=[stacks=5];
diluc add set="mh" count=4;
diluc add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
diluc add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.2976 er=0.6612 em=39.64 cr=0.0662 cd=0.1324;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 type=dummy radius=2 pos=0,2.4 particle_threshold=520000 particle_drop_count=3;
active diluc; # SS Stacks

for let r = 0; r < 3; r = r + 1 {
  furina skill, dash, burst;

  xianyun skill, low_plunge, burst;

  xilonen skill, attack:2;

  xianyun attack:2; sleep(20);

  diluc skill, burst;
  for let h=0; h<8; h=h+1 { # 7 plunges -- 66% collision rate
    diluc dash, jump;
    if !.element.t0.hydro {
      wait(7);
    }
    if .airborne {
      diluc high_plunge[collision=rand()>0.3333];
    }

  }
  diluc skill:2;

}
