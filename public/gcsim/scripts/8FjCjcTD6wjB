arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
arle add set="fohw" count=5;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ;
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=3 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.5958;

yanfei char lvl=90/90 cons=6 talent=9,9,9;
yanfei add weapon="prototypeamber" refine=5 lvl=90/90; # her ER is really bad. couldn't hold TTDS
yanfei add set="scroll" count=4;
yanfei add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466 ; #main
yanfei add stats def%=0.124 def=39.36 hp=2031.52 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2648 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active arle;

for let i = 0; i < 4; i = i + 1 {
  arle skill;
  yelan attack, skill, attack, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack; # if its still not triggered try fav.
  }
  yanfei skill, attack, burst, attack; # catches her own pyro particles
  bennett skill, burst, attack:3; # N3 to leave hydro aura on the enemy, trigger yelan Q
  arle charge,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack;
}
