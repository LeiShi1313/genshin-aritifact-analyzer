# Cyno Nahida Fischl Kirara. ~25s Rot. Cyno Aggravate. Fischl skill + burst every rotation, covering Nahida + Kirara Setup time. Kirara C4 Provides adequate quicken uptime in multiwave.

# Team
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="deathmatch" refine=1 lvl=90/90;
cyno add set="tf" count=4;
cyno add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.2648 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
#nahida add set="scroll" count=4;
#nahida add set="deepwood" count=4;
#nahida add set="tom" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3641 cd=0.7282;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

kirara char lvl=90/90 cons=6 talent=9,9,9;
#kirara add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=210]; # To Fischl (burst)
kirara add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=250]; # To Cyno (skill)
kirara add set="deepwood" count=4;
#kirara add set="scroll" count=4;
#kirara add set="no" count=4;
kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
kirara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst, attack:1, charge;
  } else {
    nahida attack, charge;
  }
  
  if .kirara.burst.ready {
    kirara skill[short_hold=1], burst, attack;
  } else {
    kirara skill[hold=14];
  }
  
  fischl attack:2, burst;
  
  cyno skill, burst, attack:2, skill;
  while .fischl.skill.cd > 30 {
    if .cyno.skill.ready && .cyno.mods.cyno-a1 {
      cyno skill;
    } else if .cyno.normal == 5 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
  
}
