emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622 ; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=50000000; 
energy every interval=480,720 amount=1;

active wrio;
wrio attack;
for let r=0; r<4; r=r+1 {
  if r && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  mavuika burst, skill;
  bennett attack, skill, burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:4;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  } else {
    wrio charge, jump, attack:2;
  }
  //bennett skill, attack:2; #catches his own particles
}
