# Heizou Nahida Faruzan Fischl. ~24s Rot. Full EM TF & Faruzan in 2 Target. Heizou spams N1C/N1Q until E available. Faruzan spends Hurricane Arrows after Heizou's time as available. 

# Team
heizou char lvl=90/90 cons=6 talent=9,9,9;
#heizou add weapon="hakushin" refine=5 lvl=90/90;
heizou add weapon="favcodex" refine=3 lvl=90/90;
heizou add set="tf" count=4;
heizou add stats hp=4780 atk=311 em=187 em=187 em=187;
heizou add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662 ;	

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
#nahida add weapon="magicguide" refine=5 lvl=90/90;
#nahida add weapon="favcodex" refine=3 lvl=90/90;
nahida add set="tom" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=79.28 cr=0.331 cd=0.662;

faruzan char lvl=90/90 cons=6 talent=9,9,9; 
faruzan add weapon="stringless" refine=3 lvl=90/90;
faruzan add set="vv" count=4;
faruzan add stats hp=4780 atk=311 em=187 em=187 cr=0.311;
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="twilight" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 hp=100000000 pos=0,2;
target lvl=100 resist=0.1 hp=100000000 pos=2,0;

# Max Declesion Guarantee
fn declensionCombo() {
  switch {
    case .heizou.skill.ready && .heizou.declension == 4:
      heizou skill;
    case .heizou.normal > 1 && .heizou.burst.ready && .heizou.declension != 4:
      heizou burst;
    case .heizou.normal > 1:
      heizou charge;
    default:
      heizou attack;
  }
}

# Spend maximum Hurrricane Arrows
fn hurricaneCombo() {
  switch {
    case .faruzan.hurricane-count:
      faruzan aim[weakspot=rand()>0.7];
    case .faruzan.skill.ready:
      faruzan skill;
    default:
      faruzan aim;
  }
}

# Rotation
active fischl;

for let i = 4; i > 0; i = i - 1 { 

  fischl skill, attack;
  
  faruzan skill, burst;
  
  nahida skill, attack, burst;
  
  while .previous-action != .action.skill {
    declensionCombo();
  }
  
  while .faruzan.hurricane-count || !.faruzan.skill.cd {
    hurricaneCombo();
  }
  
  fischl attack, burst;
  
  while .previous-action != .action.skill {
    declensionCombo();
  }
  
  while .faruzan.hurricane-count || !.faruzan.skill.cd {
    hurricaneCombo();
  }

  while .fischl.skill.cd {
    declensionCombo();
  }
  
  print("done");
}
