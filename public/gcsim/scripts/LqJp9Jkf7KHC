#Character Builds:

target lvl=100 resist=.1 hp=99999999999 radius=2 pos=0,2.4;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
active emilie;
emilie skill;
for let x=0; x<5; x=x+1 {
  bennett burst, skill;
  xiangling burst, skill;
  kirara burst,skill;
  emilie burst;

  bennett attack,skill,attack;
  xiangling attack:3;
  emilie attack:3;

  kirara skill[hold=20],attack;
  emilie attack:3;

  bennett skill,attack;
  xiangling attack:3;
