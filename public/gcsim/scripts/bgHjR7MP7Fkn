//flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=59.46 cr=0.2317 cd=0.662;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="evenstar" refine=1 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187;
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active ineffa;
for let i=0; i<6; i=i+1 {
  ineffa skill;
  if !is_even(i) {
    ineffa burst;
  } else {
    ineffa attack;
  }
  columbina skill;
  if is_even(i) {
    columbina burst;
  } else {
    columbina attack;
  }
  if .sucrose.burst.ready {
    sucrose burst, attack, skill, dash;
  } else {
    sucrose attack, skill, dash;
  }
  flins skill,
        skill, attack, burst,
        attack:3, dash, attack:3, dash, attack:3, dash, attack,
        skill, burst,
        attack:3, dash, attack:3, dash, attack:3, dash, attack;
  // for the worst energy scenario
  if .flins.status.manifest-flame {   // Check if Flins is still in the E state, it means Special E can be used
    flins skill;
    if .flins.energy >= 30 {
      flins burst;
    }
  }
}

# Ineffa E  > Columbina E Q  > Sucrose setup > Flins E E N1 Q 2{ 3[N3D] N1 E Q }
# Ineffa EQ > Columbina E N1 > Sucrose setup > Flins E E N1 Q 2{ 3[N3D] N1 E Q }




