mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mavuika add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

options swap_delay=12 iteration=1000;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mavuika; # SS Stacks

for let i=0; i<4; i=i+1 {
  mona skill, burst, attack;
  xilonen skill, attack:2; pick_up_crystallize("hydro");
  mavuika skill, burst, charge;
  mualani skill,
          walk[f=90], attack,
          walk[f=90], attack,
          walk[f=90], attack;
  if .mualani.burst.ready {
    mualani burst;
  } else {
    if i != 3 {
      mualani walk[f=1];
      xilonen burst; # Wasting time for Mavuika Burst CD to come back off CD
    }
  }
}
