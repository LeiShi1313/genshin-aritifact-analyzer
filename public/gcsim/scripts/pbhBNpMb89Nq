# Mavuika Mona Bennett Xilonen. ~18s Rot. Mavuika reliably Vapes her burst, then does 6C2D 1CF. Mona bursts every other rotation. EM sands manages to be slightly prefered.

# Team - Options listed by DPS
mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

mona char lvl=90/90 cons=0 talent=9,9,9;
mona add weapon="ttds" refine=5 lvl=90/90;
mona add set="tom" count=4;
mona add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
mona add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2648 cd=0.7282;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active mavuika; # Serpent Spine Stacks

for let i = 0; i < 4; i = i + 1 {
  mavuika skill;
  
  xilonen skill, attack:2;
  
  bennett skill, burst;
  
  mona skill[hold=1]; # hE has better frame timing than tE
  if .mona.burst.ready {
    mona burst;
  } else {
    mona attack:2; 
  }
  
  if .mavuika.burst.cd {
    mav attack:1;
  }
  mavuika burst, charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:2, dash,
                 charge:1, charge[final=1];
}
