mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="sacrificialjade" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=5;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
mualani add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.0662 cd=0.662;

barbara char lvl=90/90 cons=6 talent=9,9,9;
barbara add weapon="favcodex" refine=3 lvl=90/90;
barbara add set="berserker" count=4;
barbara add stats hp=3571 atk=232 hp%=0.3495 hp%=0.3495 cr=0.311 ; #main
barbara add stats def=33.0624 def%=0.10416 hp=426.6192 hp%=0.249984 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.111216;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="fruit" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.551 em=118.92 cr=0.0662 cd=0.1324;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="scroll" count=5;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.331 cd=0.4634;

options swap_delay=12 iteration=1000;

active barbara;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

barbara skill;
for let i=0; i<2; i=i+1 {
  sucrose skill, dash; wait(45); # removing swap cd warning
  xiangling burst, skill, dash;
  mualani burst;
  mualani skill;
  mualani_combo();
  if .mualani.nightsoul.state {
    mualani skill; # exit the nightsoul state
  }
  barbara attack:4, dash, attack:3;

  xiangling attack:2;
  if !.xiangling.mods.favonius-cd {
    xiangling attack;
  }
  xiangling skill, dash;
  sucrose skill, dash, burst;
  mualani skill;
  mualani_combo();
  barbara skill, attack;
  if !.barbara.mods.favonius-cd {
    barbara attack;
  }
}

# Barbara E >
# Sucrose ED    > Xiangling QED > Mualani Q E 3[3-stacked bite] E(cancel) > Barbara N4D N3 >
# Xiangling N2ED > Sucrose ED Q > Mualani   E 3[3-stacked bite]           > Barbara E N1   >
