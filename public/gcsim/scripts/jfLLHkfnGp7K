# - Characters

lyney char lvl=90/90 cons=0 talent=9,9,9 ;
lyney add weapon="songofstillness" refine=5 lvl=90/90;
#lyney add weapon="crescent" refine=5 lvl=90/90; # ~5k more dps with weakspots, ~5k less without
lyney add set="marechausseehunter" count=4;
lyney add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
lyney add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
#zhongli add set="ap" count=4; # if bennett is using NO
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="ap" count=4;
#bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# - Options

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

let weak = 0; #replace with 1 if using crescent

# - Target

target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;

# - Actions

active lyney;

for let i=0; i<5; i=i+1 {

  lyney aim[weakspot=weak];

  xilonen skill, attack:2;
  while !.xilonen.mods.favonius-cd {
    xilonen attack;
  }
  
  bennett skill, burst, dash;
  pick_up_crystallize("pyro");
  
  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }

  lyney aim[weakspot=weak], aim:2;
  if .lyney.burst.ready {
    lyney burst;
    delay(11); # wait for initial burst hit
    lyney skill;
  } else {
    lyney aim;
  }
  lyney skill;
}

# Lyney "Mono" with Zhongli shield and geo resonance. Xilo and Zhongli force a fav proc each rotation. Lyney bursts every other rotation. 16s 4/5CA rotation
# Rotation: Lyney C, Xilonen E N2 [N until fav], Bennett EQD [pick up shard], Zhongli hED [N until fav], Lyney 3C QE/C E