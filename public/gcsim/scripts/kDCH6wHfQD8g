bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active fischl;
#active xinyan;

fischl skill; # attack;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  bennett skill, burst;
  
  amy attack;
  if .amy.skill.ready { 
    amy skill; 
  } else { 
    amy attack, burst; 
  }
  
  # In real gameplay, E > CA > Q on shield break > CA
  while .xinyan.infusion.bennett-fire-weapon || .status.bennettburst { 
    if .xinyan.skill.ready {
      xinyan skill;
    } else if .xinyan.burst.ready {
      xinyan burst;
    } else if .xinyan.normal == 3 && .stam > 18 {
      xinyan dash;
    } else if .xinyan.normal > 4 && .stam > 18 {
      xinyan dash;
    } else {
      xinyan attack;
    }
  }
  
  bennett skill;
}
