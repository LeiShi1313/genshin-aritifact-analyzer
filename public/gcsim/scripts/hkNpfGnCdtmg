tighnari char lvl=90/90 cons=0 talent=9,9,9;
tighnari add weapon="slingshot" refine=5 lvl=90/90;
tighnari add set="gildeddreams" count=5;
tighnari add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622 ; #main
tighnari add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="goldentroupe" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2979 cd=0.7282;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="sacrificialjade" refine=1 lvl=90/90;
nahida add set="deepwoodmemories" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 em=187 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.2648 cd=0.7944;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favoniuslance" refine=3 lvl=90/90 ;
zhongli add set="tenacityofthemillelith" count=5;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311 ; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;

#--------------------------------------------

active zhongli;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash, attack:2;
  if !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  fischl attack:2, burst;
  nahida attack:2, charge, dash, skill, burst, attack:2, charge;
  tighnari skill, aim, burst, aim:2;

  zhongli skill[hold=1], dash, attack:2;
  if !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  fischl attack, skill;
  nahida attack:3, skill,
         attack:2, charge, dash,
         attack:2, charge;
  tighnari skill, aim;
  if .tighnari.burst.ready && .tighnari.energy == .tighnari.energymax {
    tighnari burst, aim:2, dash;
  } else {
    tighnari aim:2;
    nahida attack:2, dash,
           attack:2, charge, dash;
  }
}

#Zhongli hED N2 > Fischl N2Q > Nahida N2CD E Q N2C > Tighnari E CA Q 2CA >
#Zhongli hED N2 > Fischl N1E > Nahida N3E N2CD N2C > Tighnari E CA [ Q 2CA ] or [ Nahida N2D N2CD ] (if Q not available) >
