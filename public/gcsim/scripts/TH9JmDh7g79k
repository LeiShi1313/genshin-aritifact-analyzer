# EMC Nahida Xingqiu Bennett. ~22s Rotation. EMC Hyperburgeon with C6 Bennett. EMC does N4C. Nahida bursts (nearly) every rotation.

aetherelectro char lvl=90/90 cons=6 talent=9,9,9 +params=[base_atk_buff=3];
aetherelectro add weapon="favsword" refine=5 lvl=90/90;
aetherelectro add set="fopl" count=4;
#aetherelectro add set="gd" count=4;
#aetherelectro add set="cw" count=4;
#aetherelectro add set="tf" count=4;
aetherelectro add stats hp=4780 atk=311 em=187 em=187 em=187; #main
aetherelectro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.1655 cd=0.331;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311 ; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=160];
bennett add set="ins" count=4;
bennett add stats hp=3571 atk=232 er=0.518 em=139 em=139; #main
bennett add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.249984 er=0.185136 em=133.19 cr=0.055608 cd=0.111216;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

#Rotation
active aetherelectro;
#aetherelectro skill;

for let i=0; i<4; i=i+1 {
  nahida skill;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida attack, charge;
  }
  
  xingqiu skill, dash, burst, attack;
  
  bennett skill, attack, burst;
  
  while .aetherelectro.mods.bennett-field || .status.bennettburst { 
    switch {
      case .aetherelectro.skill.ready:
        aetherelectro skill[hits=3, amulet_delay=107];
      case .aetherelectro.burst.ready:
        aetherelectro burst;
      case .aetherelectro.normal > 4 && .stam > 25:
        aetherelectro charge;
      case .aetherelectro.normal > 4 && .aetherelectro.dash.ready && .stam > 18:
        aetherelectro dash;
      default:
        aetherelectro attack;
    }
  }
  
  print("done");
}
