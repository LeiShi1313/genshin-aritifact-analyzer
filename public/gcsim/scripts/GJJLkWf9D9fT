# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

fn naviaskill() {
  if .navia.shrapnel >=3 { # check current shrapnel stacks. if 3-6 stakcs, use tap E, otherwise hold E
    navia skill;
  } else {
    navia skill[hold=1];
  }
}

active navia;
for let i=0; i<4; i=i+1 {

  mona attack, skill;   # If your gameplay is fast enough, Mona will catch her Hydro Particles
  durin skill, skill, burst;
  xilonen skill, attack:2;
  navia burst;
  mona burst, attack:3;                    print(.navia.shrapnel);
  naviaskill();
  navia attack:3, dash, attack:2;          print(.navia.shrapnel);
  delay(4);
  xilonen skill, attack:2;                 print(.navia.shrapnel);
  naviaskill();
  navia attack:3, dash, attack:2;          print(.navia.shrapnel);
  if ( i / 3 ) * 3 == i {
    naviaskill();
    //navia attack;
  }
}
