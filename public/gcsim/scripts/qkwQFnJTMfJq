let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
  pick_up_crystallize("any"); # Pick up crystallize before every dash
  }

  return _execute_action(char_id, action_id, p);
}

options swap_delay=12 iteration=1000;

navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="nighttime" count=4;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311;
navia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

gorou char lvl=90/90 cons=6 talent=9,9,9;
gorou add weapon="favoniuswarbow" refine=4 lvl=90/90;
gorou add set="exile" count=4;
gorou add stats hp=3571 atk=232 er=0.3885 def%=0.43725 cr=0.311 ;
gorou add stats er=0.2204; #4ER from 5star circlet
gorou add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.07936 atk=26.464 atk%=0.07936 er=0.08816 em=31.712 cr=0.2648 cd=0.10592; #8CR and 20fixed from 4star

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2648 cd=0.7282;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active furina;
for let x=0; x<4; x=x+1 {
  furina skill, dash, attack, burst;
  if !.furina.mods.favonius-cd {
    furina attack;
  }
  navia burst;
  bennett burst, skill;
  print(.navia.shrapnel);
  gorou burst, attack, skill;
  for let n=1; n<2; n=n+1 {
    if !.gorou.mods.favonius-cd {
      gorou attack;
    }
  }
  navia skill[hold=1], attack:3, dash, attack:2;
  bennett skill, attack;
  print(.navia.shrapnel);
  navia skill[hold=1], attack:3, dash, attack:2;
  if .navia.skill.ready {
    navia skill[hold=1], attack;
  }
  bennett skill, attack;
}

