# Diluc Emilie Durin Xianyun. ~22s Rot. Diluc Burning plunge with VV Xianyun. Diluc E Q E and then uses skill between plunges. 50% Collisions.

# Team
diluc char lvl=90/90 cons=0 talent=9,9,9;
diluc add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
diluc add set="ur" count=4;
#diluc add set="longnightsoath" count=4;
diluc add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
diluc add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*9;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
#durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*7; # RW
#durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
#durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*10 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*4; # CG

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*9 em=19.82*2 cr=0.0331*12 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # deals burning AoE, -SS stacks

# Diluc Plunge Combo
fn DulicPlunge() {
  diluc jump;
  if .airborne {
    diluc high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active diluc; # SS stacks
#diluc skill;

for let i = 0; i < 4; i = i + 1 {
  # Burst after the 1st rot
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  durin skill, skill, burst;

  xianyun skill, high_plunge, attack, burst;

  diluc skill, burst, skill;
  DulicPlunge(); diluc skill;
  DulicPlunge(); diluc dash;
  DulicPlunge(); diluc dash;
  DulicPlunge(); diluc dash;
  DulicPlunge(); diluc dash;
  DulicPlunge(); diluc dash;
  DulicPlunge(); diluc skill;
  DulicPlunge(); diluc skill;
}
