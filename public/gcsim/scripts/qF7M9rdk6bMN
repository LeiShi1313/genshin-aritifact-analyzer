options swap_delay=12 iteration=1000;

neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacjade" refine=1 lvl=90/90;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
neuvillette add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*10 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*6 cd=0.0662*10;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; # main
kazuha add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*3 em=19.82*6 cr=0.0331*4 cd=0.0662*5;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="favcodex" refine=3 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311; #main
citlali add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="ap" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.062*4 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

active neuvillette;

#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
target lvl=100 resist=0.1 radius=2 pos=0,6.5 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  neuvillette skill, attack;
  xilonen skill, attack:2; pick_up_crystallize("hydro");
  kazuha skill, high_plunge, burst;
  citlali skill;
  while !.citlali.mods.favonius-cd {
    citlali attack;
  }
  while .citlali.swap.cd > 0 {
    wait(1);
  }
  neuvillette charge, burst, skill, charge;
  kazuha skill, high_plunge;
  xilonen skill, attack:2; pick_up_crystallize("hydro");
  neuvillette charge, charge;
}
wait(173); #for the last CA
