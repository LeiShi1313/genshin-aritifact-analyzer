# Hutao Yelan Fischl Xilonen. ~18s Rot. Hutao Overvape with 9N2CJ Hutao. No burst Hutao or Xilonen.

# Team
hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="fjords" refine=1 lvl=90/90;
#hutao add weapon="dbane" refine=3 lvl=90/90;
hutao add set="sr" count=4;
#hutao add set="gd" count=4;
#hutao add set="mh" count=4;
hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # SR; EM > HP Sands
#hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
#hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2979 cd=0.662; # MH; EM > HP Sands

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=0,1.8 hp=100000000;

# Rotation
active yelan;

for let i=0; i<4; i=i+1 {
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } 
  while !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  xilonen skill, attack:2;
  #xilonen burst;
  
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack:2, skill;
  }
  
  hutao attack, skill,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:3;
	
  print("done");
}

