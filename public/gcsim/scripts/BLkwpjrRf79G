klee char lvl=90/90 cons=0 talent=9,9,9; 
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="sr" count=4;
klee add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311 ; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;
# klee add set="cw" count=4;	
										
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 pos=3,0 radius=2;
energy every interval=480,720 amount=1;

active xingqiu;

for let x = 0; x < 5; x = x + 1 {
xingqiu burst, attack;
yelan burst, attack:2;
bennett burst, attack, skill;
yelan attack, skill;
klee attack, skill[bounce=3, mine=8];
for let r = 0; r < 6; r = r + 1 {
  klee attack[travel=6], charge;
}
klee attack:2;
yelan attack, skill;
xingqiu attack, skill, dash, attack:2;
bennett attack, skill;
}

