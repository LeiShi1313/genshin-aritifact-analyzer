yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gt" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
yae add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="mouun" refine=1 lvl=90/90;
#sara add weapon="fadingtwilight" refine=5 lvl=90/90;
sara add set="no" count=4;
sara add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311;
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466 ; #main
chevreuse add stats def%=0.124 def=39.36 hp=1015.76 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.5510 em=39.64 cr=0.1986 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active yae;
for let i = 0; i < 4; i = i + 1 {
  yae skill:3;
  chevreuse burst;
  if i==0 {
    chevreuse skill[hold=1];
  } else {
    chevreuse attack:2;
  }
  if .sara.skill.ready {
    sara skill, aim; # buffs both fischl and yae
  } else if .sara.burst.ready && .sara.energy == .sara.energymax {
    sara burst;
  }
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  yae attack:2, charge, dash,
      attack:2, charge, dash,
      attack:2;
  chevreuse skill[hold=1], attack:3; # catches her own particles for solo pyro ER needs
  if .sara.burst.ready && .sara.energy == .sara.energymax {
    sara burst;
  } else if .sara.skill.ready {
    sara skill, aim;
  }
  if .yae.burst.ready {
    yae burst;
  } else {
    yae attack:2, charge, dash;
  }
}
