nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworneye" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.1102 em=39.64 cr=0.2979 cd=0.1986;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  delay(7); // Mavuika E off-field Pyro app should be Citlali E > Tick > Tick > Citlali Q N1
  nicole skill, attack;
  sucrose swap;
  wait(20);
  sucrose skill, dash;
  citlali skill, burst, attack;
  mavuika swap;
  mavuika skill[recast=1], charge, dash, attack, charge;  // Both CA hits are melted
  mavuika burst;
  delay(24); # to wait Cryo app
  mavuika charge:3, charge[hold=6], charge[final=1], dash;
  mavuika charge:3, charge[hold=6], charge[final=1], dash; # the last Final CA is buffed by Mavuika Q.

  mavuika charge, dash;

}

