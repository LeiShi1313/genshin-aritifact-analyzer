xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583; #main
xilonen add stats def%=0.062*6 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*8;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="splendor" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*3 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=1000;

active navia;

for let i=0; i<4; i=i+1 {

  navia burst;

  furina skill, dash, attack, burst, attack;

  xilonen skill, attack:2;
  pick_up_crystallize("any");

  chiori skill;
  pick_up_crystallize("any");
  chiori skill;

  navia skill, attack;

  chiori attack, burst, attack:2, skill;
  pick_up_crystallize("any");
  chiori skill;

  navia skill[hold=1], attack;

  xilonen skill, attack:2;
  pick_up_crystallize("any");

  chiori attack, skill;
  pick_up_crystallize("any");
  chiori attack:3, dash, attack:3, skill;
  pick_up_crystallize("any");
  chiori skill;

  if is_even(i) {
    navia skill, attack;
  }

}
