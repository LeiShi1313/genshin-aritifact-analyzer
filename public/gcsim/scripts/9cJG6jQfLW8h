skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="eshu" refine=5 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
skirk add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbinger" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #main
chiori add stats def%=0.062*6 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*8;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=3 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="tenacityofthemillelith" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; #main
zhongli add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*12 cr=0.0331*10 cd=0.0662*4;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active zhongli;

for let i = 0; i < 4; i = i + 1 {
  zhongli skill[hold=1], dash, attack;
  if !.zhongli.mods.favnoius-cd {
    zhongli attack;
  }
  if is_even(i) {
    chiori burst;
  }
  chiori skill:2;
  yelan skill, burst, attack:3;
  if !is_even(i) {
    yelan attack:2;
  }
  skirk skill,
        attack:2, burst,

        attack:5, dash,
        attack:5, dash,
        attack:5, dash,

        attack:2, charge, dash,

        attack:5, dash,
        attack:2;
}
