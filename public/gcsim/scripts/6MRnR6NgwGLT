# Xiao Yelan Furina Xianyun. ~22s Rot. VV Xiao weaves NAs inbetween 8 low plunges. You may N0 ingame. 50% collisions.

# Team - Options listed by DPS
xiao char lvl=90/90 cons=0 talent=9,9,9;
xiao add weapon="deathmatch" refine=1 lvl=90/90;
xiao add set="vv" count=4;
#xiao add set="longnightsoath" count=4;
#xiao add set="vh" count=4;
xiao add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cd=0.622 ; #main 
xiao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1653 em=39.64 cr=0.331 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main 
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="clam" count=4; # Bubbles may miss
xianyun add set="sodp" count=4;
#xianyun add set="vv" count=4; # No VV Xiao
#xianyun add set="no" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.3857 em=39.64 cr=0.1655 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; 

# Rotation
active furina;

active furina;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  xianyun skill, low_plunge, burst;
  
  yelan skill;
  if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  xiao skill:2, burst;
  for let h = 8; h > 0; h = h - 1 {
    xiao attack, jump, low_plunge[collision=rand()>0.5];
  }
  xiao attack;
}
