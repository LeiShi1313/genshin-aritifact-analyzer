# Eula Furina Raiden Charlotte. ~22s Rot. Eula with Charlotte. Charlotte uses Hold E and particles are caught by Eula. Raiden does Q N4D N4.

# Team: Options listed by DPS
eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="uomms" refine=5 lvl=90/90;
eula add set="mh" count=4;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.2204 em=39.64 cr=0.1324 cd=0.7944; # UOMMS
#eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main
#eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1324 cd=0.7944; # TS

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="favlance" refine=3 lvl=90/90;
raiden add set="totm" count=4;
raiden add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="ttds" refine=5 lvl=90/90; 
charlotte add set="clam" count=4;
#charlotte add set="no" count=4;
#charlotte add set="sodp" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; 
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.2755 em=39.64 cr=0.2979 cd=0.3972;

# Options
options iteration=1000; 
options swap_delay=12; # Standard
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # ST

# Rotation
active raiden;
raiden skill;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  
  charlotte skill[hold=1], burst; # Particles caught by Eula
  
  eula skill, attack, burst, walk, attack:4, skill[hold=1], walk[f=10], attack:4;
  
  raiden burst, attack:4, skill, dash, attack:4;
}
