# Chongyun Furina Rosaria Escoffier. ~20s Rot. Chongyun onfield uses his burst whenever it is ready. 3E Rosaria. 

# Team - Options listed by DPS
chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="tidalshadow" refine=5 lvl=90/90;
#chongyun add weapon="mailedflower" refine=5 lvl=90/90;
#chongyun add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
chongyun add set="mh" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662; # TS
#chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
#chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2979 cd=0.662; # MF vs Freezable
#chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
#chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=118.92 cr=0.0662 cd=0.662; # SS

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favspear" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.2755 em=39.64 cr=0.1324 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active chongyun; # SS Stacks

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  esco skill, burst;
  
  rosaria skill, burst;
  
  while.chongyun.skill.ready {
    chongyun skill;
  }
  while .rosaria.skill.cd { 
    if .chongyun.burst.ready {
      chongyun burst;
    } else if .chongyun.normal > 3 {
      chongyun attack, dash;
    } else {
      chongyun attack;
    }
  }
  
  rosaria skill;
  
  while .status.chongyunfield {
    if .chongyun.burst.ready {
      chongyun burst;
    } else if .chongyun.normal > 2 {
      chongyun dash;
    } else {
      chongyun attack;
    }
  }
  
  rosaria skill;
}

