chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
chongyun add set="ur" count=4;
chongyun add stats hp=4780 atk=311 em=187 cryo%=0.466 cd=0.622; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;



options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 hp=100000000 pos=0,1.35;
energy every interval=480,720 amount=1;

active emilie;
    
for let x = 0; x<5; x=x+1 {
  if x && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill;
  }
  chongyun skill;
  bennett skill, burst;
  rosaria skill, burst;
  bennett attack, skill;
  chongyun burst;
  bennett skill;
  rosaria attack, skill, attack;
  bennett attack, skill;
}