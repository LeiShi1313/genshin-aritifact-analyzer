xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="ap" count=4;
xilonen add stats hp=4780 atk=311 er=0.518 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.62 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.3972;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    //} else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
    //  varesa jump;
    //  if .airborne {
    //    varesa high_plunge[collision=1]; # JP
    //  }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

active xilonen;

for let i=0; i<4; i=i+1 {
  xilonen burst;
  furina skill, dash, burst;
  ororon attack, skill;
  xilonen skill, attack:2; pick_up_crystallize("electro");
  varesa_combo(4);
  ororon burst;
  xilonen skill, attack:2; pick_up_crystallize("electro");
  varesa_combo(4);
}

# ~25s rotations
# Xilonen Q > Furina ED Q > Ororon N1 E > Xilonen E N2 > Varesa 4 Plunge Combos > Ororon Q > Xilonen E N2 > Varesa 4 Plunge Combos