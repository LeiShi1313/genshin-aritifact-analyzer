# Kazuha Furina Bennett Xianyun. ~19s Rot. Kazaha Vapeplunge, VV-less. Kazuha uses tap skill off CD and bursts if available at the end of the rotation to vape during the downtime. 100% collisions for E plunges, 70% for starwicker plunges. OHC > SoDP > Scroll Xianyun, but Bubbles may miss.

# Option - Options listed by DPS
kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="harbinger" refine=5 lvl=90/90; # Uptime concerns vs aggressive opponents
#kazuha add weapon="wolffang" refine=1 lvl=90/90;
#kazuha add weapon="umbrella" refine=5 lvl=90/90;
#kazuha add weapon="ironsting" refine=5 lvl=90/90;
#kazuha add weapon="finale" refine=5 lvl=90/90;
kazuha add set="longnightsoath" count=4;
#kazuha add set="mh" count=4;
#kazuha add set="sr" count=4;
#kazuha add set="vv" count=4;
#kazuha add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
#kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.2648 cd=0.662; # Harbinger
kazuha add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
kazuha add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; #Em/Py/Cd
#kazuha add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
#kazuha add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; #Em/Py/Cr

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="ohc" count=4; # Bubbles may miss while airborne
xianyun add set="sodp" count=4;
#xianyun add set="scroll" count=4;
#xianyun add set="vv" count=4; # Furina DMG
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=148.86 atk%=0.2976 er=0.6061 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active furina;

for let r = 4; r > 0; r = r - 1 {
  furina skill, dash, burst;
  if !.furina.mods.favonius-cd {
    furina attack;
  }

  xianyun skill, low_plunge, attack, burst;

  bennett skill, burst;

  while .xianyun.status.xianyun-airborne-buff {
    if .kazuha.skill.ready {
      kazuha skill, high_plunge[collision=1];
    #} else if .kazuha.burst.ready {
    #  kazuha burst;
    } else {
      kazuha jump;
      if .airborne {
        kazuha high_plunge[collision=rand()>0.3];
      }
      if .kazuha.status.xianyun-airborne-buff {
        kazuha dash;
      } else {
        kazuha attack:1;
      }
    }
  }
  if .kazuha.burst.ready {
    kazuha burst;
  }

  bennett skill;
}
