amber char lvl=90/90 cons=6 talent=9,9,9;
amber add weapon="hamayumi" refine=5 lvl=90/90;
amber add set="notsu" count=4;
amber add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
amber add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="sacbow" refine=5 lvl=90/90;
fischl add set="cg" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=5 lvl=90/90;
mona add set="sms" count=4;
mona add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="totm" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*12 cr=0.0331*4 cd=0.0662*10;

options iteration=1000 swap_delay=12;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=21370000000;

active fischl;

for let i=0; i<6; i=i+1 {
  fischl skill, attack;
  bina skill;
  if .bina.burst.ready {
    bina burst;
  } else {
    bina attack;
  }
  mona burst, attack;
  fischl attack:2, burst;
  amber aim, burst;
  mona attack, skill, attack;
  amber aim;
  mona attack:3;
  amber skill, aim[bunny=1], aim:2;
}

# ~20s rotations
# Fischl E N1 > Columbina E Q/N1 > Mona Q N1 > Fischl N2 Q > Amber C Q > Mona N1 E N1 > Amber C > Mona N3 > Amber E C_Bunny 2[C]
