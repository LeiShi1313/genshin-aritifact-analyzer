# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;


# Rotation assumptions

active furina;
for let i=0; i<4; i=i+1 {

  furina skill, dash, attack, burst, attack;

  xilonen skill, attack:2; pick_up_crystallize("any");

  chiori skill:2;

  yelan burst, attack;

  chiori burst, attack:2, skill:2;

  yelan skill;  pick_up_crystallize("any");

  yelan attack:3;

  xilonen skill, attack:2;

  chiori attack, skill, attack:3, dash, attack:3, skill:2;

  yelan attack, skill; pick_up_crystallize("any");

  yelan attack;
}
