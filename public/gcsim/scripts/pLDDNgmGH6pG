mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="ringofyaxche" refine=5 lvl=90/90;
mualani add set="obsidiancodex" count=4;
mualani add stats hp=4780 atk=311 hp%=.466 hydro%=.466 cd=.622 ; #main
mualani add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=79.28 cr=0.331 cd=0.662;

sucrose char lvl=90/90 cons=2 talent=9,9,9;
sucrose add weapon="prototypeamber" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 heal=.359 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.4959 em=158.56 cr=0.1986 cd=0.1324;

candace char lvl=90/90 cons=6 talent=9,9,9;
candace add weapon="favlance" refine=3 lvl=90/90;
candace add set="totm" count=2;
candace add set="vg" count=2;
candace add stats hp=4780 atk=311 hp%=.466 atk%=.466 cr=.311 ; #main
candace add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.4959 em=39.64 cr=0.331 cd=0.331;

xiangling char lvl=90/90 cons=4 talent=9,9,9;
xiangling add weapon="thecatch" refine=5 lvl=90/90;
xiangling add set="scroll" count=4;
xiangling add stats hp=4780 atk=311 er=.518 pyro%=.466 cr=.311 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.2204 em=39.64 cr=0.331 cd=0.662;

options swap_delay=12 iteration=1000;

active candace;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn mualani_combo() {
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}


for let i=0; i<2; i=i+1 {
  candace burst,skill;
  sucrose attack,skill;
  xiangling burst,skill;
  
  mualani skill;
  mualani_combo();
  mualani burst;
  
  candace attack:2,skill;
  xiangling skill;
  sucrose attack,skill,burst;

  mualani skill;
  mualani_combo();

}

