options swap_delay=12 iteration=1000;

# Build assumptions
cyno char lvl=90/90 cons=6 talent=10,10,10;
cyno add weapon="staffofthescarletsands" refine=5 lvl=90/90;
cyno add set="mh" count=4;
cyno add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622;
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=158.56 cr=0.1324 cd=0.662;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="key" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=6 talent=10,10,10;
nahida add weapon="tfd" refine=5 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 cd=0.622;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;

fischl char lvl=90/90 cons=6 talent=10,10,10;
fischl add weapon="elegy" refine=5 lvl=90/90;
fischl add set="scroll" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active cyno;

cyno skill;
for let i=0; i<4; i=i+1 {
  let Startframe = f();
  furina skill, dash, burst, attack;
  nahida skill, burst, attack, charge;
  if is_even(i) {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  cyno skill, burst;
  while f() - Startframe < 1260 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 5 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }

}
