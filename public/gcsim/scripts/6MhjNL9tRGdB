# Rosaria Furina Fischl Xianyun. ~20s Rot. Rosaria Phys plunge with Superconduct. Rosaaria NAs between plunges. OHC > SoDP Xianyun, but bubbles may miss. 50% Collisions. 

# Team - Options listed by DPS
rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="deathmatch" refine=1 lvl=90/90;
rosaria add set="lno" count=4;
#rosaria add set="pf" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9; 
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="stillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 cr=0.311 electro%=0.466; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="vv" count=4;
xianyun add set="ohc" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3857 em=59.46 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freeze Immunity

# Rotation
active fischl;
fischl skill;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  xianyun skill, low_plunge, burst;
  
  rosaria skill, burst;
  
  if .fischl.skill.ready {
    fischl attack:2, skill; 
  } else {
    fischl attack:2, burst;
  }
  
  while .rosaria.status.xianyun-airborne-buff {
    if .rosaria.skill.ready {
      rosaria skill;
    } else {  
      rosaria jump;
      if .airborne {
        rosaria high_plunge[collision=rand()>0.5];
      }
    }
    if .rosaria.status.xianyun-airborne-buff {
      rosaria attack;
    }
  }
}
