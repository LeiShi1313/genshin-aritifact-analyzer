# Xinyan Furina Rosaria Bennett. ~21s Rot. Phys Xinyan Furina without Superconduct. Rosaria Es thrice.

# Team
xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
xinyan add set="pf" count=2;
xinyan add set="bsc" count=2;
xinyan add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622;
xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.3972;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="emblem" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Xinyan Combo
fn XinyanCombo() {
  # Xinyan N4D, Burst when ready
  if .xinyan.burst.ready && .xinyan.energy == .xinyan.energymax {
    xinyan burst;
  } else if .xinyan.normal > 4 && .stam > 18 {
    xinyan dash;
  } else {
    xinyan attack;
  }
}

# Rotation
active xinyan;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  if i > 0 {
    furina attack;
  }
  bennett skill, burst;

  rosaria skill, burst;

  xinyan skill;
  while .rosaria.skill.cd {
    XinyanCombo();
  }

  rosaria skill;

  while .rosaria.skill.cd {
    XinyanCombo();
  }

  rosaria skill;
  bennett skill, dash;
}
