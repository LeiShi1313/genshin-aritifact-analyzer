# Chongyun Furina Yelan Escoffier. ~21s Rot. Chongyun onfield uses his burst whenever it is ready. 2E Yelan.

# Team - Options listed by DPS
chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="tidalshadow" refine=5 lvl=90/90 +params=[stacks=5];
#chongyun add weapon="sacgs" refine=5 lvl=90/90 +params=[stacks=5];
chongyun add set="mh" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90; # over Slingshot + Furina ER
yelan add set="emblem" count=4;
#yelan add set="no" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2317 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  esco skill, burst;

  yelan burst, attack;
  if !.yelan.skill.ready && .yelan.breakthrough {
    yelan aim;
  }
  yelan skill, attack;

  while .yelan.skill.cd {
    if .chongyun.skill.ready {
      chongyun skill, attack;
    } else if .chongyun.burst.ready {
      chongyun burst;
    } else if .chongyun.normal > 3 {
      chongyun attack, dash;
    } else {
      chongyun attack;
    }
  }

  yelan skill, attack;

  while .furina.skill.cd {
    if .chongyun.burst.ready {
      chongyun burst;
    } else if .chongyun.normal > 2 {
      chongyun dash;
    } else {
      chongyun attack;
    }
  }
}
