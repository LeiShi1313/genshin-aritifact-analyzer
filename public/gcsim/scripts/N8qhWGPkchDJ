# Amber Furina Bennett Xilonen. ~20s Rot. Amber Furina Vape with bunny shots. No delays for Hydro aura. 20% aimed weakspot hits.

# Team
amber char lvl=90/90 cons=6 talent=9,9,9;
amber add weapon="scion" refine=1 lvl=90/90;
#amber add weapon="songofstillness" refine=5 lvl=90/90;
amber add set="mh" count=4;
amber add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
amber add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # ATK Sands
#amber add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
#amber add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # EM Sands

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3641 cd=0.331;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active bennett;
bennett skill;

#active xilonen;

for let i = 0; i < 4; i = i + 1 {
  xilonen skill, attack:2, burst;

  furina skill, dash, burst;

  bennett skill, burst;

  amber burst;

  xilonen skill, attack:2;

  while .status.bennettburst || .amber.mods.bennettfield {
    switch {
      case .amber.skill.ready:
        amber skill;
      case .previous-action == .action.skill:
        amber aim[bunny=1];
      default:
        amber aim[weakspot=rand()>0.8];
    }
  }
}
