# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 hp=100000000 pos=0,2;
#target lvl=100 resist=0.1 hp=100000000 pos=2,0;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  
  xl burst, skill, dash;
  
  bennett skill, burst;
  
  xianyun skill, low_plunge, burst;
  
  # Plunge
  while .bennett.status.xianyun-airborne-buff {
    bennett jump;
    if .airborne {
      bennett high_plunge[collision=rand()>0.5];
    }
    if .bennett.skill.ready {
      bennett skill;
    } else if .bennett.dash.ready {
      bennett dash;
    } else {
      bennett attack;
    }
  }
  # Fill time
  while .furina.skill.cd {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  
}
