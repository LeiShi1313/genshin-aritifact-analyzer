# Razor Nahida Fischl Bennett. ~20s Rot. Full EM Razor Overload in 2T. 2E Sapwood Bennett. Self-Overloads not implemented (~15 per rot).

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="aquamarine" refine=1 lvl=90/90;
#razor add weapon="mailedflower" refine=5 lvl=90/90;
#razor add weapon="bloodtainted" refine=5 lvl=90/90;
razor add set="gd" count=4; # Reaction damage
razor add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; #ATK/Cr

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=220]; # Leaf to Razor
#bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=140]; # Leaf to Fischl
bennett add set="ins" count=4;
bennett add stats hp=4780 atk=311 er=0.518 em=139 em=139; #main
bennett add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.46284 em=99.8928 cr=0.055608 cd=0.111216;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  # Forego Nahida burst if energy deficient
  nahida skill;
  if i > 0 && .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida attack, charge;
  }
  if .bennett.skill.cd {
    nahida attack, charge;
  }

  bennett skill, burst;

  if .amy.burst.ready {
    amy attack:2, burst; # Easy to pick up Sapwood leaf with phased movement
  } else {
    amy attack:1, skill;
  }

  razor skill, dash, attack, burst; #Pick up Sapwood leaf here if missed
  # Razor main DPS window
  while .razor.infusion.bennett-fire-weapon {
    if .razor.normal > 3 {
      if .razor.skill.ready {
        razor skill, dash;
      } else {
        razor dash;
      }
    } else {
      razor attack;
    }
  }

  bennett skill;
}
