# Childe Fischl Ororon Bennett. ~16s Rot. Childe Taser. Ororon and fischl use skill and burst in Bennett burst. Childe ends melee as bennett burst ends.

# Team
childe char lvl=90/90 cons=0 talent=9,9,9;
childe add weapon="vhunt" refine=1 lvl=90/90;
childe add set="nymph" count=4;
childe add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cd=0.622;
childe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
#fischl add weapon="stillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # VHunt
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # SoS

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="chainbreaker" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=237.84 cr=0.0662 cd=0.2648;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

#Rotation
active bennett;

for let i=0; i<4; i=i+1 {
  bennett skill, burst, attack;
  
  if .childe.burst.ready {
    childe burst;
  }
  
  ororon skill, burst;
  
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack:2, burst;
  }
  
  bennett skill, attack:2;
  
  if .childe.skill.cd {
    childe aim;
  }
  childe skill;
  while .status.bennettburst {
    if .previous-action == .action.charge && .stam > 18 {
      childe dash;
    } else if .childe.normal == 3 && .stam > 25 {
      childe charge;
    } else if .childe.normal > 4 && .stam > 25 {
      childe charge;
    } else {
      childe attack;
    }
  }
  childe skill, attack, aim[hold=1];
  
  

  print("end");
}

