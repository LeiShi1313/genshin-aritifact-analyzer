options swap_delay=12 iteration=1000;

active mualani;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

mualani attack;
for let i=0; i<4; i=i+1 {
  nahida attack, skill, attack, burst, attack;
  if !.nahida.mods.favonius-cd {
    nahida attack;
  }
  yelan skill, attack, burst, attack;
  xiangling burst, skill, jump;
  let mq=0;
  if .mualani.burst.ready && .mualani.energy == .mualani.energymax {
    mualani burst;
    mq=1;
  }
  mualani skill;
  mualani_combo();
  if .mualani.nightsoul.state {
    mualani skill; # exit the nightsoul state
  }
  if mq==0 {
    mualani attack:3;
  }
}

# Mualani N1 >
# Nahida N1 E N1 Q N1 > Yelan E N1 Q N1 > Xiangling QE >Mualani (Q if available) E 3[3-stacked bite] > (Mualani N3 if Mualani didn't use her Q in the current rot) >
