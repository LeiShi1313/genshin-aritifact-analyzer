# Lisa Nahida Fischl Xianyun. ~25s Rot. Lisa Aggravate Plunge. Xianyun refeshes VV after Fischl uses burst. Lisa uses hold skill after all plunges are spent for er.

# Team
lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="widsith" refine=3 lvl=90/90;
lisa add set="ts" count=4;
#lisa add set="longnightsoath" count=4;
#lisa add set="gd" count=4;
#lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
#lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # ATK
lisa add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # EM

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
#nahida add weapon="magicguide" refine=5 lvl=90/90;
nahida add set="scroll" count=4;
#nahida add set="tom" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.6612 em=158.56 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active amy;

for let x=0; x<4; x=x+1 {
  fischl attack, skill;

  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }

  while !.lisa.burst.ready {
  lisa attack;
  }
  lisa burst;

  xianyun skill, low_plunge, attack, burst; # attack for the Swirl

  # High plunges
  #while .fischl.oz {
  for let i=0;i<3;i=i+1 {
    if .xianyun.status.xianyun-airborne-buff {
      lisa jump;
      if .airborne {
        lisa high_plunge[collision=rand()>0.5], dash;
      }
    } else if .lisa.normal > 2 {
      lisa dash;
    } else {
      lisa attack;
    }
  }

  fischl attack:2, burst;

  xianyun attack:2; sleep(20); # for CD warning

  # Low plunges
  while .fischl.skill.cd > 30 || .lisa.energy < 65 {
  #while .fischl.oz {
    if .xianyun.status.xianyun-airborne-buff {
      lisa jump;
      if .airborne {
        lisa low_plunge[collision=rand()>0.5], attack;
      }
    } else if .lisa.skill.ready {
      lisa skill[hold=1];
    } else if .lisa.normal > 2 {
      lisa dash;
    } else {
      lisa attack;
    }
  }
}
