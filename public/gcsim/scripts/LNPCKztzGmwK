xiangling add weapon="kitain" refine=5 lvl=90/90;
xiangling add set="deepwood" count=4;
xiangling add stats hp=4780 atk=311 atk%=0.466 cr=0.311 pyro%=0.466; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;                        
target lvl=100 resist=.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;
active emilie;
for let i=0; i<4; i=i+1 {
  emilie attack, skill;
  bennett burst, skill;
  xiangling burst, skill, dash;
  ayato attack, skill, attack:15;
  if .emilie.burst.ready {
    emilie burst;
  } else {
    ayato burst;
  }
  bennett skill, attack;
  xiangling attack:3, skill, dash;
  ayato skill, attack:15;
}
