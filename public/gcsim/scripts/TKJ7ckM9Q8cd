yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="mh" count=4;
yoimiya add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main 
yoimiya add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main 
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*10 cd=0.0662*6;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main 
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*7 cr=0.0331*8 cd=0.0662*11;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active furina;

for let i=0; i<4; i=i+1 {
  if !i {
    furina skill, dash, burst;
  } else {
    furina attack, burst, skill, dash, attack;
  }
  
  bennett burst, skill;
  
  if i && .fischl.skill.ready {
    fischl attack:2, skill;
  } else {
    fischl attack:2, burst;
  }
  
  yoimiya skill, attack:5, dash, 
                 attack:5, dash, 
                 attack:5, dash,
                 attack;
  if .yoimiya.burst.ready {
    yoimiya burst;
  }
  
  bennett attack, skill;
}

# ~19s rotations
# Furina ED Q / N1 Q ED N1 > Bennett Q E > Fischl N2 Q/E > Yoimiya E 3[N5D] N1 (Q) > Bennett N1 E