#Whale Eula Furina Shenhe Escoffier. ~22s Rot. KQMS. Phys Eula with Escoffier. Eula does Eula EQhE N2D N3 tE N2 for superior energy an better utilization of Shenhe quils. Shenhe passes skill & fav particles to Eula before & after Eula's burst. Eula has 133% ER in this team.

# Team - Option Listed by DPS
eula char lvl=90/90 cons=6 talent=10,10,10;
eula add weapon="sobp" refine=5 lvl=90/90;
eula add set="mh" count=4;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622 ; #main
eula add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="splendoroftranquilwaters" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 er=0.518 cr=0.311; #main  hydro%=0.466
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

shenhe char lvl=90/90 cons=6 talent=10,10,10; 
shenhe add weapon="favlance" refine=5 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.331 cd=0.3972;

escoffier char lvl=90/90 cons=6 talent=10,10,10; 
escoffier add weapon="symphonistofscents" refine=5 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311 ; #main
escoffier add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active furina;

for let i=0; i<4; i=i+1 { 
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  escoffier skill, burst;
  
  shenhe burst, skill;
  eula skill;
    if !.eula.burst.ready {
      eula attack;
    } 
  if !i {
    eula burst, skill, attack:4, dash, attack:2, skill[hold=1], walk[f=11], attack:3;
  } else {
    eula burst, skill[hold=1], walk[f=11], attack:2, dash, attack:3, skill, attack:2;
  }
  
  shenhe skill, attack:2;
  if .shenhe.skill.ready {
    shenhe skill;
  }
  
  eula attack, skill;
}

