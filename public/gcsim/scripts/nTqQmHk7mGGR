options swap_delay=12 iteration=1000;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="widsith" refine=5 lvl=90/90;
columbina add set="notsu" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*5 cr=0.0331*5 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=5 lvl=90/90;
fischl add set="deepwood" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="etherlight" refine=5 lvl=90/90;
lauma add set="gd" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*6 cr=0.0331*9 cd=0.0662*3;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=5 lvl=90/90;
mona add set="sms" count=4;
mona add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

active lauma;
# ----  Actions List
target lvl=100 resist=0.1 radius=4 pos=0,4.4 hp=999999999;
energy every interval=480,720 amount=1;

lauma attack;
for let i=0; i<5; i=i+1 {
  if i == 0 {
    columbina attack, skill;
  } else {
    columbina skill, charge;
  }

  if .columbina.burst.ready {
    columbina burst;
  }

  if .fischl.skill.ready{
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }

  mona skill, burst, attack;

  lauma attack, skill[hold=1], burst;
  columbina attack, charge, dash, charge, dash, charge;
  mona attack:4;
  columbina attack, charge, dash, charge;

}
columbina attack; // give time for the last CA's damage to land
