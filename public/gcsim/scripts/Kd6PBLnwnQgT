# Yoimiya Chiori Yunjin Zhongli. ~17s Rot. Yoimiya Mono Geo with Chiori and Yunjin.

# Team- Options listsed by DPS
yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="slingshot" refine=5 lvl=90/90;
#yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="sr" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbinger" refine=5 lvl=90/90;
#chiori add weapon="cinnabar" refine=5 lvl=90/90;
chiori add set="gt" count=4;
#chiori add set="husk" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622 ; # main
chiori add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;
#chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; #main
#chiori add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Spindle

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="footprintoftherainbow" refine=5 lvl=90/90;
yunjin add set="husk" count=4;
yunjin add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583; #main
yunjin add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.2648 cd=0.1324;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; # main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active zhongli;

for let x=0; x<4; x=x+1 {
  zhongli attack, skill[hold=1], dash;
  while (!.zhongli.mods.favonius-cd) { # Guarantee Fav
	  zhongli attack;
	}
	
	chiori skill:2;

  yunjin skill, burst;
  
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack:5;
  
  if .yoimiya.burst.ready {
    yoimiya burst;
  } else if .chiori.burst.ready {
    chiori burst;
  } else {
    yoimiya attack:3;
  }
  
  print("done");
}

