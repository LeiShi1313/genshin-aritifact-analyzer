# Razor Nahida Furina Escoffier. ~25s Rot. Hybrid Razor's damage is split between Dendro, Electro, and Phys. Razor prefers two ATK% mainstats at KQMS.

# Team- Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="risingwinds" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*4 cr=0.0331*11 cd=0.0662*10; # ATK/ATK
