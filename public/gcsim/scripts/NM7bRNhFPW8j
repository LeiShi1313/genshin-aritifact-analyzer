baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="deepwood" count=5;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.4959 em=39.64 cr=0.331 cd=0.331;

options swap_delay=12 iteration=1000;

active furina;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn kinich_combo() {
  kinich skill;
  kinich attack;
  while .kinich.nightsoul.state {
    if .kinich.nightsoul.points == 20 {
      kinich skill[hold=1];
      continue;
    }
    kinich attack;
  }
}


for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  baizhu skill, attack, burst, attack;
  xiangling burst, skill, dash, attack:2;
  kinich_combo();
  if .kinich.burst.ready && .kinich.energy == .kinich.energymax {
    kinich burst;
  }
}
