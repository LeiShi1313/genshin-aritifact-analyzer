# Diluc vape 4lno version, realistic vapes and 50% collision rate.

# --- Team
diluc char lvl=90/90 cons=0 talent=9,9,9;
diluc add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
diluc add set="longnightsoath" count=4;
#diluc add set="shime" count=4;
diluc add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
diluc add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90;
bennett add set="scroll" count=4;
#bennett add set="instructor" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282; # Scroll
#bennett add stats hp=3571 atk=232 er=0.518 pyro%=0.3495 cr=0.23325; #main
#bennett add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.46284 em=33.2976 cr=0.083412 cd=0.27804; # Ins

# --- Options
options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# --- Targets
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,3;

# --- Rotation
active furina;

for let r = 0; r < 4; r = r + 1 { # Loop rotation 4 times
  furina skill, dash, burst;

  xianyun skill, low_plunge, burst;

  bennett burst, skill, attack;

  xianyun attack:3;

  diluc skill:2;
  for let h = 0; h < 8; h = h + 1 { # 8 plunges -- 50% collision rate -- very inconsistent vape
    diluc jump;
    if .airborne {
      diluc high_plunge[collision=rand()>0.5], dash;
    }
  }
  diluc attack:2;

  bennett skill;
}
