lyney char lvl=90/90 cons=0 talent=9,9,9 ;
lyney add weapon="prototypecrescent" refine=5 lvl=90/90;
lyney add set="marechausseehunter" count=4;
lyney add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
lyney add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=9,9,9; 
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972 ;

raiden char lvl=90/90 cons=0 talent=9,9,9; 
raiden add weapon="dragonsbane" refine=3 lvl=90/90;
raiden add set="totm" count=5;
raiden add stats hp=4780 atk=311 em=187 em=187 em=187; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.3641 cd=0.331;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662 ;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.5;
energy every interval=480,720 amount=1;

active raiden;
for let r = 6; r > 0; r = r - 1 {
  raiden skill, attack;
  
  if !.bennett.burst.ready {
    bennett skill;
  }
  bennett burst;

  chevreuse skill[hold=1], burst;

  lyney aim[weakspot=1], aim;
  if .lyney.burst.ready {
    lyney burst;
    delay(11);   // wait 11f or else burst cancels before hitting the collision damage
    lyney skill; // cancel burst
  } else {
    lyney aim;
  }
  
  if r == 1 {
    // Last rot we do aim, aim, skill since we don't have time to wait for Hat to detonate by itself
    lyney aim, aim[weakspot=1], skill;
  } else {
    // Otherwise we want to do aim skill aim so that lyney can catch his own particles
    lyney aim, skill, aim[weakspot=1];
  }
}

#rotation: raiden E N1, bennett E Q > chevreuse hE Q > lyney 2CA Q E CA E CA