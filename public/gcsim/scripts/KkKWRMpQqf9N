options swap_delay=12 iteration=1000;

# Build assumptions
columbina char lvl=90/90 cons=6 talent=10,10,10;
columbina add weapon="nocturnescurtaincall" refine=5 lvl=90/90;
columbina add set="notsu" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.1324 cd=0.662;

nilou char lvl=90/90 cons=6 talent=10,10,10;
nilou add weapon="key" refine=5 lvl=90/90;
nilou add set="sms" count=4;
nilou add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
nilou add stats def%=0.124 def=39.36 hp=2539.4 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.0662 cd=0.1324;

nahida char lvl=90/90 cons=6 talent=10,10,10;
nahida add weapon="tfd" refine=5 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

lauma char lvl=90/90 cons=6 talent=10,10,10;
lauma add weapon="nightweaverslookingglass" refine=5 lvl=90/90;
lauma add set="gd" count=2;
lauma add set="wt" count=2;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187;
lauma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.331 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active lauma;
lauma attack;
columbina swap;
for let i=0; i<4; i=i+1 {
  let StartFrame=f();
  columbina skill, burst;
  nahida skill, charge;
  nilou skill, attack:2, skill;
  lauma skill[hold=1], burst;   # hE before Q to allow more Dews on Columbina
  columbina swap;
  columbina attack;
  //while .columbina.skill.cd > 0 {
  while f()-StartFrame < 1060 {
    print("check");
    print("verdant-dew is ", .verdant-dew);
    print("moonridge-dew is ", .moonridge-dew);
    if .verdant-dew + .moonridge-dew > 0 {
      columbina charge;
      //if .stam > 50 {
      columbina dash;
      //}
      wait(9);  # Dew check should happen after CA's Dew consumption
    } else {
      if .columbina.normal != 2 {
        print("Not enough Dew, use N1");
        columbina attack;
      } else {
        print("Still not enough Dew, wait");
        wait(1);
      }
    }
  }
}
