#gear
alhaitham char lvl=90/90 cons=0 talent=9,9,9;
alhaitham add weapon="xiphos" refine=1 lvl=90/90;
alhaitham add set="gd" count=4; #mh, fopl and gd all perform similarly
alhaitham add stats hp=4780 atk=311 em=187 em=187 em=187;  #full EM, Damage/Crit or hybrid perform similarly
alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; #6 em, 12 cr, 8 cd

nilou char lvl=90/90 cons=0 talent=9,9,9;
nilou add weapon="thedockhandsassistant" refine=1 lvl=90/90;
nilou add set="tenacityofthemillelith" count=2;
nilou add set="vourukashasglow" count=2;
nilou add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
nilou add stats def=39.36 def%=0.124 hp=2031.52 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.0662 cd=0.1324; #6 hp%, 8 hp, 12 em

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="xiphos" refine=1 lvl=90/90;
furina add set="deepwood" count=5;
furina add stats hp=4780 atk=311 em=187 em=187 em=187;
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.5952 atk=33.08 atk%=0.0992 er=.1102 em=118.92 cr=0.1655 cd=0.331; #6 em, 12 hp, 6 cr, 4 cd

kokomi char lvl=90/90 cons=0 talent=9,9,9; 
kokomi add weapon="fruitoffulfillment" refine=5 lvl=90/90;
kokomi add set="ohc" count=4; #ohc and fopl are interchangable 
kokomi add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kokomi add stats def=39.36 def%=0.124 hp=2031.52 hp%=0.5952 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.0662 cd=0.1324; #6 em, 12 hp, 8 hp

#configuration
options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999; 
target lvl=100 resist=0.1 radius=1 pos=1.5,0 hp=999999999; 

#rotation
active furina;
for let r = 0; r < 4; r = r + 1 {
  furina skill, burst;
  nilou skill, attack:2, skill;
  alhaitham burst;
  kokomi attack, skill;
  alhaitham attack:3, dash, 
    attack:3, dash, 
    attack:3, charge, 
    attack:2, charge, 
    attack:3;
  kokomi burst,attack;
  alhaitham skill[hold=1], low_plunge[short=1], 
     attack:3,dash,
     attack, charge,
     attack:3, dash;

}