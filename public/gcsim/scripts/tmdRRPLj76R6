# itto double pyro with xilonen. both on sig. xilonen helps alot with itto er. 1 rotation. Not kqms stats.

itto char lvl=90/90 cons=0 talent=10,10,10;
itto add weapon="redhornstonethresher" refine=1 lvl=90/90;
itto add set="huskofopulentdreams" count=4 +params=[stacks=4];
itto add set="wandererstroupe" count=1;
itto add stats def%=0.634 def=32 hp=5079 hp%=0.14600000000000002 atk=327 er=0.305 em=103 cr=0.5980000000000001 cd=1.065 geo%=0.466;

xilonen char lvl=90/90 cons=0 talent=8,10,10;
xilonen add weapon="peakpatrolsong" refine=1 lvl=90/90;
xilonen add set="scrolloftheheroofcindercity" count=4;
xilonen add set="obsidiancodex" count=1;
xilonen add stats def%=1.166 def=42 hp=5019 atk=330 atk%=0.326 er=0.602 em=166 cr=0.528 cd=0.272;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="thecatch" refine=5 lvl=90/90;
xiangling add set="emblemofseveredfate" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesseoblige" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active bennett;
bennett burst, skill;
xiangling burst, skill;
xilonen skill, attack:2;
  #"C0 1PS" combo

  itto attack, burst[prestack=1],
       attack, skill,
       attack:2, charge:5,
       attack:4, charge:5, skill[travel=0], charge;
       sleep(21); #catch ushi particles
