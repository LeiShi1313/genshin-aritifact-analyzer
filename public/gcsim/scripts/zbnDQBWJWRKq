# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

#Rotation
active furina;

for let i = 0; i<4; i=i+1 { 
  furina skill, dash;
  if i > 0 { # Yelan burst wave
    furina attack;
  }
  furina burst;
  
  esco skill, burst;
  
  yelan burst, attack, skill, attack;
  
  yoimiya skill,
  attack:5, dash,
  attack:5, dash,
  attack:5, dash,
  attack:1;
  
  yelan skill, attack:4;
}
