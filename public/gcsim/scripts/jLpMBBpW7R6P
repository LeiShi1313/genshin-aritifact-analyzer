# Yoimiya Yae Fischl Xingqui. ~24s Rot. TF (Yoimiya) is able to use her skill twice per rotation, with her burst capping the rotation end.  Similar performance between 3EM Evenstar & ADC Widsith Yae. Burstless Yae. 

# Team
yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="tf" count=4;
yoimiya add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311;
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.1324 cd=0.7944;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="evenstar" refine=1 lvl=90/90;
yae add set="tom" count=4;
#yae add set="gt" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # ADC
#yae add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1102 em=118.92 cr=0.2317 cd=0.7944; # 3EM

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
#fischl add set="tom" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; 
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="no" count=4;
#xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311 ; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,4.4 hp=100000000; # No Contact Rainswords
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Contact Rainswords

# Rotation
active yae;

for let x=0; x<4; x=x+1 {
  yae skill:3;
  
  xingqiu skill, dash, burst, attack;
  
  fischl skill, attack;
  
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5;
  
  yae skill, attack, skill, attack, skill;
  
  fischl attack:2, burst;
  
  yoimiya skill, attack:5, dash, attack:5;
  if .yoimiya.burst.ready {
    yoimiya burst;
  }
}
