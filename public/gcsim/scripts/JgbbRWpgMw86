xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets - Hyperbloom Ownership varies with size
target lvl=100 resist=0.1 radius=2.6 pos=0,3.0 hp=100000000; # Fischl triggers minimal HB
#target lvl=100 resist=0.1 radius=2.2 pos=0,2.5 hp=100000000; # Fischl triggers some HB

# Max Declension Guarantee
fn declensionCombo() {
  switch {
    case .heizou.normal > 1 && .heizou.skill.ready && .heizou.declension == 4:
      heizou skill;
    case .heizou.normal > 1 && .heizou.burst.ready:
      heizou burst;
    case .heizou.normal > 1 && .stam > 25: # will encounter eventually
      heizou charge;
    default:
      heizou attack;
  }
}

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl attack, skill;

  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }

  xq skill, dash, burst, attack;

  while .fischl.oz {
    declensionCombo();
  }

  fischl attack:2, burst;

  while .fischl.skill.cd {
    declensionCombo();
  }
}
