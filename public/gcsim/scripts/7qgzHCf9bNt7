// mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;

active mualani;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

for let i=0; i<2; i=i+1 {
  mualani attack;
  xilonen skill, attack:2;
  sucrose swap; wait(23);
  sucrose skill, dash;
  mavuika burst, charge;
  if .mavuika.sets.ap >= 4 {
    pick_up_crystallize("hydro");
  }
  mavuika skill;
  mualani skill;
  mualani_combo();
  sucrose swap; wait(23);  # immediate Sucrose E happens before Mavuika E pyro app, so need to wait
  sucrose skill, dash;     # EM buff to Mualani
  mualani burst;

  mualani attack;
  xilonen skill, attack:2;
  sucrose swap; wait(23);
  sucrose skill, dash;
  mavuika skill[hold=1];
  if .mavuika.sets.ap >= 4 {
    pick_up_crystallize("hydro");
  }
  mavuika charge, dash;
  mualani skill;
  mualani_combo();
  mualani skill;
}

# Mualani N1 > Xilonen E N2 > Sucrose E > Mavuika Q C E > Mualani E 3[3-stacked bite] > Sucrose E > Mualani Q >
# Mualani N1 > Xilonen E N2 > Sucrose E > Mavuika hE CD > Mualani E 3[3-stacked bite]
