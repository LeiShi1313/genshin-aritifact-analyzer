# Kaeya Citlali Bennett Xianyun. ~19s Rot. Kaeya Melt Plunge with Citlali. Swapping Xianyun back in for VV is a DPS loss. Evenstar and TTDS Citlali are neck and neck. 50% Collisions.

# Team - Options listed by DPS
kaeya char lvl=90/90 cons=6 talent=9,9,9;
kaeya add weapon="harbinger" refine=5 lvl=90/90;
#kaeya add weapon="umbrella" refine=5 lvl=90/90;
kaeya add set="lno" count=4;
kaeya add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;
#kaeya add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
#kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
#citlali add weapon="evenstar" refine=1 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.1655 cd=0.5958; # TTDS
#citlali add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324; # Evenstar

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4;
xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3306 em=39.64 cr=0.0662 cd=0.2648;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active xianyun;

for let i = 0; i < 4; i = i + 1 {
  xianyun skill, low_plunge, burst;

  bennett skill, burst;

  # VV action - not worthwhile
  #if .xianyun.sets.vv >= 4 && i == 0 {
  #  xianyun attack:2;
  #}

  citlali skill, burst;

  kaeya attack, skill;
  while .kaeya.status.xianyun-airborne-buff {
    if .kaeya.burst.ready {
      kaeya burst;
    } else if .kaeya.skill.ready {
      kaeya skill;
    } else {
      kaeya jump;
      if .airborne {
        kaeya high_plunge[collision=rand()>0.5];
      }
      if .kaeya.status.xianyun-airborne-buff { # no dash for final plunge
        kaeya dash;
      }
    }
  }

  bennett skill;
  while !.bennett.mods.favonius-cd && .bennett.weapon == .keys.weapon.favsword{ # Better for energy
    bennett attack;
  }
}
