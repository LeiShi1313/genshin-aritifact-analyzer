options swap_delay=12 iteration=1000;

# Build assumptions
mavuika char lvl=90/90 cons=6 talent=10,10,10;
mavuika add weapon="tbs" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

ororon char lvl=90/90 cons=6 talent=10,10,10;
ororon add weapon="elegy" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 er=0.518 em=187 cr=0.311;
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2648 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=10,10,10;
chevreuse add weapon="symphonistofscents" refine=5 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=10,10,10;
bennett add weapon="pps" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
bennett add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.2648 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  ororon burst, skill;
  chev skill[hold=1];
  bennett attack:2, skill, burst;
  mavuika burst;
  mavuika charge:2, dash,
          charge:2, dash,
          charge:2, dash,
          charge:2, dash,
          charge:2, dash,
          charge:2, dash,
          charge:2, dash;
}



