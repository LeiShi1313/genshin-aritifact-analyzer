# PMC Yelan Fischl Xilonen. ~19s Rot. PMC Overvape DPS. 1E Yelan, 1E Xilonen. PMC uses hold skill and bursts as available between weaving NAs. Xilonen bursts every rotation at the end. OC/Scroll PMC/Xilonen is better than Scroll/AP. Fischl runs full EM.

# Team - Options Listed by DPS
aetherpyro char lvl=90/90 cons=6 talent=9,9,9  +params=[base_atk_buff=1, skirk_story_buff=1];
aetherpyro add weapon="finale" refine=5 lvl=90/90;
aetherpyro add set="oc" count=4;
#aetherpyro add set="scroll" count=4;
aetherpyro add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
aetherpyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.3641 cd=0.331; # OC
#aetherpyro add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
#aetherpyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.331 cd=0.7282; # Scroll

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
#fischl add set="ap" count=4;
#fischl add set="tom" count=4;
fischl add stats hp=4780 atk=311 em=187 em=187 em=187; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
#xilonen add set="ap" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.331 cd=0.331; # Scroll
#xilonen add stats hp=4780 atk=311 er=0.518 geo%=0.466 cr=0.311; #main
#xilonen add stats def%=0.434 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.1324; # AP

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # Right

# Rotation
active yelan;

for let i=0; i<4; i=i+1 {
  xilonen burst;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  xilonen skill, attack:2;
  if .xilonen.sets.ap >= 4 {
    pick_up_crystallize("any");
  }
  
  if .fischl.skill.ready {
    fischl attack, skill;
    if .fischl.sets.ap >= 4{
      fischl dash; pick_up_crystallize("any");
    }
  } else {
    fischl attack:2, burst;
    if .fischl.sets.ap >= 4 {
      pick_up_crystallize("any");
    }
  }
  
  aetherpyro attack, skill[hold=1];
  while .yelan.mods.yelanburst {
  #while .aetherpyro.mods.nightsoul-blessing {
    switch {
      case .aetherpyro.burst.ready && .aetherpyro.normal > 1:
        aetherpyro burst;
      case .aetherpyro.normal > 3 && .stam > 25: # N3C
        aetherpyro charge;
      case .aetherpyro.normal > 3 && .aetherpyro.dash.ready && .stam > 18: # N3D
        aetherpyro dash;
      default:
        aetherpyro attack;
    }
  }
}
