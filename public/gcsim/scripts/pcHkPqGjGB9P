# PMC Furina Yelan Xilonen. ~21s Rot. PMC double Hydro Vape with OC. 1E Yelan, 2E Xilonen. PMC does E N1 Q 5ND N3.

# Team - Options Listed by DPS
aetherpyro char lvl=90/90 cons=6 talent=9,9,9  +params=[base_atk_buff=1, skirk_story_buff=1];
aetherpyro add weapon="finale" refine=5 lvl=90/90;
#aetherpyro add weapon="umbrella" refine=5 lvl=90/90;
aetherpyro add set="oc" count=4;
aetherpyro add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
aetherpyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.331; # Finale
#aetherpyro add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#aetherpyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.331; # Umbrella

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # STD

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # Right adjacent

# Rotation
active xilonen;

for let i=0; i<4; i=i+1 {
  xilonen burst;

  furina skill, dash, burst;

  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  xilonen skill, attack:2; pick_up_crystallize("any");

  aetherpyro skill[hold=1], attack, burst;
  aetherpyro attack:3, dash;
  aetherpyro attack:3, dash;
  aetherpyro attack:3, dash;
  aetherpyro attack:3, dash;
  aetherpyro attack:3, dash;
  aetherpyro attack:3;

  xilonen skill, attack:2;
}
