# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active fischl;
fischl skill;

for let i=0; i<4; i=i+1 {
  # Burst every other is very close
  nahida skill;
  #if i > 0 && .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida attack, burst;
  #} else {
  #  nahida attack, charge;
  #}
  
  dori skill, burst;
  
  haitham burst;
  
  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
  
  # Optimized-ish combo for 20s rot
  alhaitham attack:3, dash, 
            attack:3, charge, dash,
            attack:3, charge, dash,
            attack:1, skill[hold=1], low_plunge[short=1];
  alhaitham attack:4, charge, dash,
            attack:4;
}
