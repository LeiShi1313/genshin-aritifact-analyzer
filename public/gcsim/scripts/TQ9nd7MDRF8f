dehya char lvl=90/90 cons=6 talent=9,9,9;
dehya add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
dehya add set="eosf" count=4;
dehya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
dehya add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="sacbow" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*9 cd=0.0662*12;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=3 lvl=90/90;
mona add set="no" count=4;
mona add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
nicole add set="gift" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*6 er=0.0551*10 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

options iteration=1000 swap_delay=12;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active dehya;

for let i=0; i<4; i=i+1 {
  dehya skill;
  fischl skill, attack;
  if .nicole.burst.ready {
    nicole burst;
  }
  nicole skill;
  mona burst, attack;
  fischl attack:2, burst;
  mona attack, skill, attack;
  dehya burst, attack:15;
  mona attack:3;
  dehya skill;
}

# 20s rotation (Fischl Sac Bow)
# Dehya E > Fischl E N1 > Nicole (Q) E > Mona Q N1 > Fischl N2 Q > Mona N1 E N1 > Dehya Q N15 > Mona N3 > Dehya E
