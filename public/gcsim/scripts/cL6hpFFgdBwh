# Mavuika Chevreuse Ororon Yae. ~18s Rot. Mavuika Double Electro Overload. Mav Q 4C2FD 1CF; C13 is -7K DPS. Healer Chevreuse. Evenstar ToM 3EM Yae > Widsith GT ADC Yae by 3K DPS.

# Team
mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#mavuika add weapon="tidalshadow" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # SS
