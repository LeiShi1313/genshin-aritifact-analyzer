#yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # GT

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

let C2F = true;

# Rotation
active mavuika; # SS Stacks

for let i=0; i<4; i=i+1 {
  mavuika skill;

  yae skill:3;
  
  ororon skill, burst;
  
  if .chev.burst.ready {
    chev burst, skill[hold=1]:3;
  } else {
    chev skill[hold=1], burst;
  }

  if C2F == true { # 4C2FD 1CF
    mavuika burst, 
      charge:2, charge[final=1], dash, 
      charge:2, charge[final=1], dash,
      charge:2, charge[final=1], dash, 
      charge:2, charge[final=1], dash,
      charge:1, charge[final=1];
  } else { # C13FD
    # Easy combo, just book and hold CA, 4 CA after burst expiry
    mavuika burst, 
      charge:14, dash; 
  }
  
}
