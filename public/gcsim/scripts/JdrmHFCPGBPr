kazuha add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=118.92 er=0.4408 cr=0.2317 cd=0.4634;

nahida char lvl=90/90 cons=0 talent=9,9,9; 
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="totm" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; # main
nahida add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=118.92 er=0.1102 cr=0.2979 cd=0.7282;		

options iteration=100 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
      if .clorinde.bolratio >= 1 {
          clorinde skill;
      } else {
          clorinde attack;
      }
  }
}

active fischl; 

for let r=0; r<4; r=r+1 { # 4 rotations 

  if r>0 {
  kazuha skill, high_plunge; # swirl to refresh VV and kazuha A4 for fischl/oz snapshot  
  fischl attack;
  }
  fischl burst;
  nahida skill, burst;
  kazuha burst; # kazuha burst for first clorinde combo ensures fischl/oz snapshot of his A4 for second clorinde combo
  clorinde_combo();
  fischl attack, skill;
  kazuha skill, high_plunge;
  clorinde_combo();
}