wriothesley char lvl=90/90 cons=0 talent=9,9,9;
wriothesley add weapon="thewidsith" refine=3 lvl=90/90;
wriothesley add set="marechausseehunter" count=4;
wriothesley add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
wriothesley add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favoniuslance" refine=3 lvl=90/90;
shenhe add set="scroll" count=4;
shenhe add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.551 em=39.64 cr=0.3972 cd=0.1324;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="favoniussword" refine=3 lvl=90/90;
lynette add set="vv" count=5;
lynette add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311 ; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=138.74 cr=0.0662 cd=0.5958;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
active shenhe;
for let i=0; i<4; i=i+1 {
  shenhe skill[hold=1], attack, burst;
  while !.shenhe.mods.favonius-cd {
    shenhe attack;
  }
  lynette skill, attack, burst;
  bennett skill, burst;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump, 
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  } else {
    wrio attack;
  }
  bennett skill;
}
