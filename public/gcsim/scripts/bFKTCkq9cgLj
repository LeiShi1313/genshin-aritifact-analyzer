zhongli add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.23808 atk=26.464 atk%=0.07936 er=0.08816 em=31.712 cr=0.2648 cd=0.10592 ;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="ap" count=4;
xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.4634 ;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

options swap_delay=12 iteration=1000;

active mualani;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo2() {
  #doing 2[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<2; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

fn mualani_combo3() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}


for let i=0; i<2; i=i+1 {

  if i {
    mualani skill;
  }
  mualani attack;

  xilonen skill, attack:2;

  zhongli skill[hold=1], dash;

  xl burst, skill, dash, attack;
  pick_up_crystallize("hydro");

  mualani skill;
  mualani_combo2();
  mualani skill, burst[travel=10], attack;

  xilonen skill, attack:2;

  zhongli skill[hold=1], dash;

  xl attack, skill, dash;
  pick_up_crystallize("hydro");

  mualani skill;
  mualani_combo3();

}
