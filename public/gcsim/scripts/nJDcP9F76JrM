# Chevreuse Raiden Fischl Bennett. ~16s Rot. CW Chevreuse on-field DPS. Fischl snapshots Bennett's buff. Raiden bursts at the tail of Bennett's burst if available. ToM > GT/Emblem Raiden. Lower stamina rotation in config.

# Options ordered by DPS
chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="deathmatch" refine=1 lvl=90/90;
chev add set="cw" count=4;
chev add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622; #main
chev add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
#raiden add set="gt" count=4; # Skill DPS
raiden add set="tom" count=4; #
#raiden add set="emblem" count=4; #B urst DPS
#raiden add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
#raiden add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ; # Skill DPS
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Burst DPS

fischl char lvl=90/90 cons=6 talent=9,9,9;
#fischl add weapon="viridescenthunt" refine=1 lvl=90/90;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=5;
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # w/ VH
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;	# w/ others

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  bennett skill, burst;

  if .fischl.skill.ready {
    fischl attack:2, skill;
  } else {
    fischl attack:2, burst;
  }

  chev burst, attack, skill[hold=1],
    attack, skill[hold=1], # Overcharged ball is inconsistent here
    attack, skill[hold=1],
    attack, charge, dash,
    attack, charge, dash,
    attack, charge, dash,
    attack, charge, dash;

  if .raiden.burst.ready {
    #raiden burst, attack:4, skill, attack; # Less Stamina
    raiden burst, attack:1, charge, attack, skill; # More stamina
  } else {
    #bennett skill, attack:4; # Less stamina
    bennett skill, attack:2, dash, attack:2; # More Stamina
    #bennett skill, attack:2, charge, attack:1; # More Stamina

    raiden skill;
  }
}
