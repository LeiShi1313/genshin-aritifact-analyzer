# Freminet Furina Rosaria Bennett. ~21s Rot. Phys Freminet. CR Cap issue with MH. ToTM >= GT Furina. 2 Shattering Pressure hits miss Bennett's buff. Bennett C6 is -4K DPS.

# Ordered by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5]; # PF
#freminet add weapon="tidalshadow" refine=5 lvl=90/90;
freminet add set="pf" count=4; # SSr1
#freminet add set="mh" count=4; # Bad, CR Cap
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # PF
#freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958; # ToM
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958; # GT

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favspear" refine=3 lvl=90/90;
rosaria add set="eosf" count=4;
#rosaria add set="no" count=4;
#rosaria add set="scroll" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311 ; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
#bennett add set="sodp" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282; # Other
#bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
#bennett add stats def%=0.124 def=39.36 hp=1777.58 hp%=0.496 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.0662 cd=0.1324; # SoDP

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  while !.furina.burst.ready {
    furina attack;
  }
  furina burst;
  
  bennett skill, burst;
  
  rosaria skill, burst;
  
  freminet skill, burst,
           attack:2, skill, skill,
           attack:2, skill, attack:1, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
           attack:2, skill, attack:1, skill,
           attack:2, skill;
}
