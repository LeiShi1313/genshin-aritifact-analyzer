furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662 ;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gd" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

sigewinne char lvl=90/90 cons=0 talent=9,9,9;
sigewinne add weapon="sacbow" refine=5 lvl=90/90;
sigewinne add set="ohc" count=4;
sigewinne add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
sigewinne add stats def%=0.124 def=39.36 hp=2031.52 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.1324;


options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active yae;

for let x = 0; x < 3; x = x + 1 {
  if x==0 {
    yae skill:3;
  } else {
    yae skill, attack, skill, attack, skill;
  }

  furina skill, dash, attack;

  kazuha skill, high_plunge, burst;

  sigewinne skill, dash;

  furina burst;

  kazuha skill, high_plunge;

  sigewinne skill, dash;

  yae attack;

  if .yae.burst.ready {
    yae burst;
  } else {
    yae charge, dash;
  }
  yae skill:2, attack, skill, attack, charge, jump;

  kazuha skill, high_plunge;

  sigewinne burst;

  yae attack, charge, dash;

}
