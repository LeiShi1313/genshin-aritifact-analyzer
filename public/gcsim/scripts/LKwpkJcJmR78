# Ayaka Durin Rosaria Escoffier. ~20s Rot. Ayaka Freeze with Dark Durin Melt from off field. Rosaria does 3Es.

# Team - Options listed by DPS
ayaka char lvl=90/90 cons=0 talent=9,9,9;
ayaka add weapon="finale" refine=5 lvl=90/90;
ayaka add set="bs" count=4;
#ayaka add set="emblem" count=4;
ayaka add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
ayaka add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*12 cd=0.0662*7; # BS
#ayaka add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
#ayaka add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # Emblem

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="moonweaversdawn" refine=2 lvl=90/90;
