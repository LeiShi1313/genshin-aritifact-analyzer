# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active durin;

for let i=0; i<4; i=i+1 {
  durin skill, attack, burst;

  esco skill, burst;

  rosaria skill, burst;

  ayaka skill, dash, attack, burst,
        attack, charge;

  rosaria skill;

  ayaka dash, attack:2, charge,
        attack:2, charge, skill;

  rosaria skill;
}
