chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="jadevista" refine=1 lvl=90/90;
chasca add set="vv" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

yae char lvl=90/90 cons=1 talent=9,9,9;
yae add weapon="echoesoftheheart" refine=5 lvl=90/90;
yae add set="deepshadow" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
yae add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

odette char lvl=90/90 cons=0 talent=9,9,9;
odette add weapon="exaiphanesblade" refine=5 lvl=90/90;
odette add set="heartofthefurnace" count=4;
odette add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
odette add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*9;

qiqi char lvl=90/90 cons=4 talent=9,9,9;
qiqi add weapon="finale" refine=5 lvl=90/90;
qiqi add set="totm" count=4;
qiqi add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
qiqi add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*9 cd=0.0662*12;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active yae;

for let i = 0; i < 6; i = i + 1 {
  yae skill:3;

  qiqi skill;
  if i && .qiqi.burst.ready {
    qiqi burst;
  }

  if .odette.burst.ready {
    odette burst, skill;
  } else {
    odette skill, skill;
  }

  chasca skill, aim:4;
  if .chasca.burst.ready {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
}

# ~17s rotations
# Yae 3[E] > Qiqi E (Q) > Odette QE/EE > Chasca E 4[C] Q/C_4b
