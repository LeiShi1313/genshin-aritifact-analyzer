#overload kequeen | 41s rotation

keq char lvl=90/90 cons=6 talent=9,9,9;
keq add weapon="finale" refine=5 lvl=90/90;
keq add set="fohw" count=4;
keq add stats hp=4780 atk=311 atk%=.466 electro%=0.466 cr=0.311; #main
keq add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

amy char lvl=90/90 cons=6 talent=9,9,9;
amy add weapon="alleyhunter" refine=1 lvl=90/90;
amy add set="gt" count=4;
amy add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
amy add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="lionsroar" refine=5 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=5 lvl=90/90;
chev add set="no" count=4;
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chev add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*5 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*2 cr=0.0331*9 cd=0.0662*2;


options iteration=10000 swap_delay=12;
energy every interval=480,720 amount=1;

target lvl=100 resist=.1 hp=21370000000 radius=2 pos=0,2.5;

active amy;
for let i = 0; i < 6; i = i + 1 { # 6 rotations
  if .amy.skill.ready {
    fischl skill, attack;
  } else if .amy.burst.ready {
    amy attack:2, burst;
  }
  durin skill, burst, skill;
  chev skill[hold=1], burst;
  keq skill, burst, skill, dash,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      skill;
  if .amy.skill.ready {
    amy skill, attack;
  } else if .amy.burst.ready {
    amy attack:2, burst;
  }
  durin skill:2;
  keq skill, dash,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      skill,
      attack, charge;
  durin burst;
  chev burst, skill[hold=1]:3;
  if .amy.skill.ready {
    amy skill, attack;
  } else if .amy.burst.ready {
    amy attack:2, burst;
  }
  durin skill:2;
  keq skill, burst, skill, dash,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      skill, skill,
      attack, charge,
      attack, charge;
}

