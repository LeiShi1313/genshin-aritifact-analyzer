# Characters - - - -

neuv char lvl=90/90 cons=0 talent=9,9,9;
neuv add weapon="prototypeamber" refine=5 lvl=90/90;
neuv add set="mh" count=4;
neuv add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
neuv add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="fleuve" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="tidalshadow" refine=5 lvl=90/90;
navia add set="gt" count=4;
navia add stats hp=4780 atk=311 atk%=.466 geo%=0.466 cr=0.311;
navia add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=5 lvl=90/90;
zhongli add set="ap" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311;
zhongli add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Config - - - -

options iteration=500 swap_delay=12;
target lvl=100 hp=99999999 resist=0.1 particle_threshold=460000 particle_drop_count=3 radius=2 pos=0,2.4;
# 12-3 Maguu Kenki Particles

# Rotation - - - -

active neuv;

for let i=0;i<4;i=i+1 {
  neuv attack, skill;
  furina skill, dash, burst;
  zhongli skill[hold=1], dash;
  # Wait up to 60 frames to pick up crystallize
  for let x=0; x<60; x=x+1 {
    if pick_up_crystallize("hydro") {
      break;
    }
    wait(1);
  }
  navia skill, burst;
  neuv charge, burst, skill, charge;
  navia skill, attack, skill;
  neuv charge:2;
}
wait(172);

# Neuv N1E > Furina EQ > Zhongli hE > Navia EQ > Neuv CA QE CA > Navia E N1 E > Neuv 2CA > Repeat
