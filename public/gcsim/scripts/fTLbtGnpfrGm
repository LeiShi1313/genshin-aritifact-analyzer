# Lisa Furina Fischl Xianyun. ~24s Rot. Lisa Taser Plunge. Xianyun refeshes VV after Fischl uses burst. Lisa uses hold skill immediately after all plunges are spent to catch furina's burst. 50% Collisons.

# Team
lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="widsith" refine=3 lvl=90/90;
#lisa add weapon="flowingpurity" refine=5 lvl=90/90;
lisa add set="mh" count=4;
#lisa add set="longnightsoath" count=4;
#lisa add set="ts" count=4;
lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.2648 cd=0.7944; # MH
#lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
#lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # TS

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3641 cd=0.331; # ToM
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.331; # GT

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=0]; # Leading
#fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=148.86 atk%=0.2976 er=0.6061 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active fischl;

for let x=0; x<4; x=x+1 {
  fischl attack, skill;
  
  furina skill, dash, burst;
  
  while !.lisa.burst.ready {
    lisa attack;
  }
  lisa burst;
  
  xianyun skill, low_plunge, burst; # attack for the Swirl
  
  for let i=0;i<3;i=i+1 {
  #while .fischl.oz {
    if .xianyun.status.xianyun-airborne-buff {
      lisa jump;
      if .airborne {
        lisa high_plunge[collision=rand()>0.5], dash;
      }
    } else if .lisa.normal > 2 {
      lisa dash;
    } else {
      lisa attack;
    }
  }
  
  fischl attack:2, burst;
  
  xianyun attack:2; sleep(20); # for CD warning
  
  while .fischl.oz {
  #while .fischl.skill.cd > 30 || .lisa.energy < 65 {
    if .xianyun.status.xianyun-airborne-buff {
      lisa jump;
      if .airborne {
        lisa high_plunge[collision=rand()>0.5], dash;
      }
    } else if .lisa.skill.ready {
      lisa skill[hold=1];
    } else if .lisa.normal > 3 {
      lisa dash;
    } else {
      lisa attack;
    }
  }
}

