# Raiden Xiangling Lisa Chevreuse. ~20s rot. Lisa w/o using hold E. but there is time to use it if you want to, Lisa provides DEF Shred and TTDS.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cd=0.622 ; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

lisa char lvl=90/90 cons=2 talent=9,9,9;
lisa add weapon="ttds" refine=5 lvl=90/90;
lisa add set="scroll" count=4;
#lisa add set="no" count=4;
lisa add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311 ; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="catch" refine=5 lvl=90/90;
#xiangling add set="no" count=4;
xiangling add set="emblem" count=4;
#xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
#xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=99.1 cr=0.2317 cd=0.7944; # Emblem
xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # NO

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="scroll" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.3972;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active raiden;
raiden skill;

for let i = 0; i < 4; i = i + 1 {
  chevreuse burst, skill[hold=1]:3;
  xiangling attack:5, burst, skill, dash;
  lisa attack, burst;
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  lisa attack:2; # spending some time for 20s rot length
}
