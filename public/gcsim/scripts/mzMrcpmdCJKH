# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

fn kinich_combo() {
  kinich skill;
  for let c=0; c<5; c=c+1 {
    kinich attack[direction=1]:2;
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.state {
      kinich skill[hold=1];
    }
  }
  if .kinich.burst.ready {
    kinich burst;
  }
}

active kinich; # SS Stacks

for let i=0; i<4; i=i+1 {
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  if is_even(i) {
    nicole burst, skill;
  } else {
    nicole attack, skill;
  }
  durin skill:2, burst;
  kinich_combo();
}

# 18s rotations
# Emilie E > Nicole Q E > Durin 2[E]Q > Kinich E 5[N2 shE] Q >
# Emilie Q > Nicole   E > Durin 2[E]Q > Kinich E 5[N2 shE]   >
