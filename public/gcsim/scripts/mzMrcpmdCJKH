options swap_delay=12 iteration=1000;

# Build assumptions
kinich char lvl=90/90 cons=0 talent=9,9,9;
kinich add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
kinich add set="obsidiancodex" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622;
kinich add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

