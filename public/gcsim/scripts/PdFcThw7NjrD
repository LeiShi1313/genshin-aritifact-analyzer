options iteration=1000 swap_delay=12;

# Build assumptions
eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="tidalshadow" refine=5 lvl=90/90;
eula add set="mh" count=4;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.2204 em=39.64 cr=0.2648 cd=0.7944;

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="favlance" refine=3 lvl=90/90;
raiden add set="totm" count=4;
raiden add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="no" count=4;
mika add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.331 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # single target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active raiden;
raiden skill;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  mika burst, skill;
  while !.mika.mods.favonius-cd {
    mika attack;
  }
  eula skill;
  if i != 0 {
    eula attack:2; # wait energy from mika
  }
  eula burst, walk, attack:4, skill[hold=1], walk[f=10], attack:4, dash, attack:2;
  raiden burst, attack:4, skill, dash, attack:4, dash, attack:2;
}

# (Raiden E) > Furina E Q > Mika Q E > Eula E Q N4 hE N4dN2 > Raiden Q N4 E N4dN2
