baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="deepwood" count=4;
baizhu add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359 ; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=118.92 cr=0.3972 cd=0.3972;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

active raiden;

for let i=0; i<6; i=i+1 {
  raiden skill, attack;

  furina skill, dash;
  while !.furina.burst.ready {
    furina attack;
  }
  furina burst;

  nahida skill;
  while !.nahida.burst.ready {
    nahida attack;
  }
  nahida burst, attack;

  baizhu skill;
  while !.baizhu.burst.ready {
    baizhu attack;
  }
  baizhu burst;

  nahida attack:2, charge, jump;
  nahida attack:3, dash;
  nahida attack:3, dash;

  nahida attack:2, charge, jump;
  nahida attack:3, dash;

  baizhu skill, attack:2;

  nahida attack:2, charge, jump;
  nahida attack:3, dash;
  nahida attack:3, dash;
}
