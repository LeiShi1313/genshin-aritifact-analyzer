# Razor Chevreuse Fischl Mavuika. ~20s Rot. Razor Overload. As the sole healing, Chevreuse builds for HP. Mauvika bursts every rotation. Mauvika prefers to build Full EM.

# Team
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5]; # Leading
razor add set="echoes" count=4; # Ping
#razor add set="ts" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ATK Gob
#razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Electro Gob

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="dialogues" refine=5 lvl=90/90;
chev add set="no" count=4;
#chev add set="sodp" count=4;
chev add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.331; # NO
#chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
#chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3972 cd=0.3972; # SoDP

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="aquamarine" refine=1 lvl=90/90;
#mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=0]; # Not Leading
mavuika add set="scroll" count=4;
#mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 em=187 em=187; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=118.92 cr=0.3972 cd=0.3972; # Scroll
#mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # OC ADC

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active razor; # SS Stacks
razor skill, dash;

for let i = 0; i < 4; i = i + 1 {
  # Burst as available
  if .chev.sets.no > 4 {
    chev burst, skill[hold=1];
  } else {
    if .chev.burst.ready {
      chev burst, skill[hold=1];
    } else {
      chev attack:1, skill[hold=1];
    }
  }

  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }

  if .mav.burst.ready {
    mav burst, skill;
  } else {
    mav skill, attack;
  }

  razor skill, dash, attack, burst;
  # Razor Main DPS window
  while .razor.mods.razor-q > 240 { # Fixed Rot
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}
