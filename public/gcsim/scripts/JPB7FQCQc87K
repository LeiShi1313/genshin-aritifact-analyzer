# Kuki Chevreuse Fischl Bennett. Kuki on-field DPS. 8x CA leaves little stamina to dodge.

# Team - Options listsed by DPS
kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="finaleofthedeep" refine=5 lvl=90/90;
#kuki add weapon="blacksword" refine=1 lvl=90/90;
#kuki add weapon="harbingerofdawn" refine=5 lvl=90/90;
#kuki add weapon="lionsroar" refine=3 lvl=90/90;
#kuki add weapon="wolffang" refine=1 lvl=90/90;
kuki add set="mh" count=4; # Finale
#kuki add set="sr" count=4;
kuki  add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main 5* set
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD Circlet
#kuki  add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main 5* set
#kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # CR Circlet

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="eosf" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2317 cd=0.5958;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 +params=[stacks=10] lvl=90/90;
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="twilight" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
#bennett add weapon="sapwood" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

active bennett;

# Rotation
for let r = 0; r < 4; r = r + 1 {

  bennett skill, burst;

  # Use Available Oz
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else if .fischl.skill.ready {
    fischl attack, skill;
  }

  # Guarantee Favonious procs
  chevreuse skill[hold=1], burst, attack;
  while !.chev.mods.favonius-cd {
    chev attack;
  }

  # Kuku is left with little stamina
  kuki skill,
  attack, charge,
  attack, charge,
  attack, charge,
  attack, charge,
  attack, charge,
  attack, charge,
  attack, charge,
  attack, charge;

  # Notation
  # Bennett EQ > Fischl N2Q/N2E > Chevreuse EN1Q[N1] >
  # Kuki E8N1C
}
