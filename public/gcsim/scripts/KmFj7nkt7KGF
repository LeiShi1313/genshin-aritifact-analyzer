options iteration=1000 swap_delay=12;

# Build assumptions
arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="fjords" refine=1 lvl=90/90;
arle add set="fohw" count=4;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; 
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=5 lvl=90/90;
yelan add set="ap" count=4;
#yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.5958; # AP
#yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
#yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7282; # EoSF

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="ins" count=4;
bennett add stats hp=3571 atk=232 er=0.518 pyro%=0.3495 cr=0.23325 ; #main
bennett add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.277704 em=33.2976 cr=0.13902 cd=0.389256;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active arle;

for let i = 0; i < 4; i = i + 1 {
  arle skill;
  
  if i > 0 {
    bennett skill;
  }
  
  xilonen skill, attack:2;

  yelan skill;
  pick_up_crystallize("pyro");
  yelan burst;
  
  if i == 0 {
    bennett burst, skill;
  } else {
    bennett burst, attack;
  }
  
  arle attack:3, charge;
  if i > 0 {
    wait(30);
  }
  arle attack:3, charge;
  if i > 0 {
    wait(20);
  }
  arle attack:3, charge,
       attack:3, charge,
       attack:3, charge,
       attack:2;
  if i == 0 {
    arle attack, dash, attack;
  }
}