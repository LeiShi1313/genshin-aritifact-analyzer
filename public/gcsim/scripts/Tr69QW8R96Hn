mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="scroll" count=5;
mavuika add stats hp=4780 atk=311 em=187 cr=0.311 pyro%=0.466; #main									
mavuika add stats def=39.36 def%=0.124 em=79.28 atk=33.08 hp=507.88 hp%= 0.0992 atk%=0.0992 er=0.1102 cr=0.331 cd=0.7944 ;	

ganyu char lvl=90/90 cons=0 talent=9,9,9; 
ganyu add weapon="hamayumi" refine=5 lvl=90/90;
ganyu add set="wandererstroupe" count=4;
ganyu add stats hp=4780 atk=311 em=187 cr=0.311 cryo%=0.466; #main											
ganyu add stats def=39.36 def%=0.124 em=79.28 atk=33.08 hp=507.88 hp%= 0.0992 atk%=0.0992 er=0.1102 cr=0.331 cd=0.7944 ; 

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active mavuika; # SS stacks

for let i=0; i<5; i=i+1 {
  
  ganyu skill;
  
	zhongli skill[hold_nostele=1], dash, attack:2;
	
	if .zhongli.sets.ap >= 4 {
	  zhongli dash; pick_up_crystallize("cryo");
	}
	
  mavuika skill, dash;
  
  bennett skill, burst;
  
  while .mavuika.nightsoul.state {
    ganyu aim;
  }
	if .mavuika.burst.ready {
	  mavuika burst;
	}
	
}