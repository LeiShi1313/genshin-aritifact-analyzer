# Razor Emilie Lisa Bennett. ~22s Rotation. Razor Quickload w/ 70/46% Quicken/Burning uptime. SS may be inconsistent. Self-Overloads not implemented.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5]; # Inconsistent
#razor add weapon="talkingstick" refine=1 lvl=90/90; # Passive not implemented; SS alt
#razor add weapon="mailedflower" refine=5 lvl=90/90;
razor add set="ur" count=4;
#razor add set="gd" count=4; # Higher Overload Damage
razor add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622 ; #main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;
#razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # ATK/El
#razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # ATK/ATK
