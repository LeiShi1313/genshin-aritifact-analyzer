# Razor Emilie Lisa Bennett. ~22s Rotation. Razor Quickload w/ 66/49% Burning/Quicken uptime. Serpent Spine is edged out by Talking Stick when assuming Burning damage. Lisa needs to hold E to meet energy requirements. Self-Aura Overloads not implemented.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5]; # Inconsistent
#razor add weapon="talkingstick" refine=1 lvl=90/90; razor add stats atk%=0.16 electro%=0.12 pyro%=0.12; # Passive not implented; Self-Damage SS Alternative
razor add set="ur" count=4; # RW is worse
razor add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10; # EM/Electro
#razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10; # ATK/Electro
#razor add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # EM/EM

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="etherlightspindlelute" refine=5 lvl=90/90;
#lisa add weapon="fruit" refine=5 lvl=90/90;
#lisa add weapon="hakushin" refine=5 lvl=90/90; # Needs Emblem
lisa add set="deepwood" count=4;
#lisa add set="emblem" count=4;
lisa add stats hp=4780 atk=311 er=0.518 electro%=0.466 em=187; #main
lisa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*10 cr=0.0331*6 cd=0.0662*2; # Er/El/Em
#lisa add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
#lisa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*8 cr=0.0331*8 cd=0.0662*2; # Er/Em/Em

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=155]; # 1st Razor Dash
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*6 cd=0.0662*10; # ATK
#bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
#bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*10 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*6 cd=0.0662*2; # Heals

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Most elite opponents are too large for you to actually take Burning damage
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # deals burning AoE, enables MH, -SS stacks

# Rotation - Standard Start
active razor; # SS Stacks
#razor skill, dash; # Minor DPS Loss

# Rotation start with Burning Damage & Talking Stick
#active bennett; # SS Stacks
#bennett skill; # Minor DPS Loss

for let i=0; i<4; i=i+1 {
  # Skip in first rotation, burst as available after
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  lisa skill[hold=1], burst; # hE required for Energy

  bennett skill, dash, burst;

  razor skill, dash, attack, burst;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:2;

  bennett skill;

  print("done");
}
