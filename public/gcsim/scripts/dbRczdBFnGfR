# Dori Furina Sara Xianyun. ~21s Rot. Dori Taser Plunge. 3 Dori skill per rotation for ER reasons. Just 6 plunges are spent. Dori uses burst before Xianyun for reliable VV. 50% Collisons. 

# Team
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#dori add weapon="tidalshadow" refine=5 lvl=90/90; # Much Worse
dori add set="tf" count=4;
dori add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD
#dori add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Cr

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.331 cd=0.2648; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.331 cd=0.2648; # ToM

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="favbow" refine=4 lvl=90/90;
sara add set="emblem" count=4;
sara add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; #main
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.331 cd=0.5958;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.551 em=198.2 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Dori Plunge Combo
fn DoriPlunge() {
  if .dori.mods.xianyun-airborne-buff {
    dori jump;
    if .airborne {
      dori high_plunge[collision=rand()>0.5];
    }
  }
}

# Rotation
active dori; # SS Stacks

for let x=0; x<4; x=x+1 {
  furina skill, dash, burst;
  
  dori skill, burst;
  
  xianyun skill, low_plunge, burst;
  
  sara skill, aim;
  sara attack;
  #wait(15); # Sara self buffs
  
  dori skill, attack;
  DoriPlunge(); dori dash;
  DoriPlunge(); dori dash;
  DoriPlunge();
  
  xianyun attack:2, charge;
  
  sara burst;
  
  dori skill, attack;
  DoriPlunge(); dori dash;
  DoriPlunge(); dori dash;
  DoriPlunge();
}
