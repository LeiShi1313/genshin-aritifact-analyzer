#Random frame delays
fn randy(mean, standardDeviation, min, max, display) {
  let value = randnorm() * standardDeviation + mean;
  if value > max {
    value = max;
  } else if value < min {
    value = min;
  }
  if display {
    print(value);
  }
  return value;
}

let prev_char_id = -1;
switch {
  case .alhaitham.onfield:
    prev_char_id = .keys.char.alhaitham;
  case .xiangling.onfield:
    prev_char_id = .keys.char.xiangling;
  case .xingqiu.onfield:
    prev_char_id = .keys.char.xingqiu;
  default:
    prev_char_id = .keys.char.bennett;
} #this switch statement prevents "swap delay" from being added at the start of each iteration when the first action is not actually a swap
let prev_action_id = -1;

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {

  if prev_char_id != char_id && action_id != .action.swap {
    execute_action(char_id, .action.swap, []);
  }

  if action_id == .action.swap {
    delay(randy(9.5, 1.5, 8, 17, 0)); #SWAP DELAY (frames, including 1f base): mean 10.5 stddev 1.5, bounds: 9-18f
                                                     #corresponding ping (ms): mean 87.5 stddev 12.5, bounds: 75-150ms

  } else if prev_action_id == .action.attack && action_id != .action.attack && action_id != .action.charge {
    delay(randy(3, 1, 0, 6, 0)); #NA DELAY (except if next action is NA/CA): mean 3 stddev 1, bounds: 0-6f

  } else if prev_action_id != .action.attack {
    delay(randy(3, 1, 0, 6, 0)); #OTHER ACTION DELAY: mean 3 stddev 1, bounds: 0-6f
  }

  prev_char_id = char_id;
  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}

fn burningMaint() { #essentially 50% chance for each burning tick to do self dmg
  if rand() < 0.5 {
    set_player_pos(0,0.3); #can take burning dmg
  } else {
    set_player_pos(0,0); #out of burning range (xq orbitals are in range either way)
  }
  switch {
    case .alhaitham.onfield:
      print("Alhaitham HP:", .alhaitham.hpratio * 100, "%");
    case .xiangling.onfield:
      print("Xiangling HP:", .xiangling.hpratio * 100, "%");
    case .xingqiu.onfield:
      print("Xingqiu HP:", .xingqiu.hpratio * 100, "%");
    default:
      print("Bennett HP:", .bennett.hpratio * 100, "%");
  }
}

options swap_delay=1 iteration=1000 ignore_burst_energy=false;
target lvl=100 hp=99999999 resist=0.1 radius=1 pos=0,1.5 particle_threshold=520000 particle_drop_count=3; #Energy drops based on 12-3 Icewind Suite

active xingqiu;
set_on_tick(burningMaint);
let LeaveCircleImpact = false;
let BurstSwap = false;

#Base: Xingqiu E Dash Q N1 > Bennett Q N1 E > Xiangling N1 Q N1 E Dash > Alhaitham N1 Q N1D N4D N3 E N3D N3CD N3C
for let r=0; r<4; r=r+1 {
  xingqiu skill, dash;
  while !.xingqiu.burst.ready {
    if .xingqiu.skill.ready {
      xingqiu skill, dash;
    } else {
      xingqiu attack;
    }
  }
  xingqiu burst, attack;
  if .xingqiu.skill.ready {
    xingqiu skill, dash, attack;
  }
  while !.xingqiu.mods.favonius-cd && (.xingqiu.normal < 4) && (.xingqiu.weapon == .keys.weapon.favsword) {
    xingqiu attack;
  }

  bennett swap;
  while !.bennett.burst.ready {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  bennett burst, attack;
  if .bennett.skill.ready {
    bennett skill;
  }

  xiangling attack;
  while !.xiangling.burst.ready {
    if .bennett.skill.ready {
      bennett attack, skill;
      xiangling attack;
    // } else if .xiangling.skill.ready {
    //   xiangling skill;
    } else {
      xiangling attack;
    }
  }
  xiangling burst, attack;
  if .xiangling.skill.ready {
    xiangling skill;
  }
  while !.xiangling.mods.favonius-cd && (.xiangling.normal < 3) && (.xiangling.weapon == .keys.weapon.favlance) {
    xiangling attack;
  }

  alhaitham attack;
  while !.alhaitham.burst.ready {
    alhaitham attack;
  }
  alhaitham burst;
  if LeaveCircleImpact {
    set_player_pos(0, 7); #causes some other issues bc of reduced energy drops so it's more scuffed than it should be unless u readjust ER
    set_target_pos(0, 5.5); #also can leave dendro cores behind
  }
  if BurstSwap {
    bennett attack, skill; #lowers er and can refresh instructor but still doesn't really seem worth
    alhaitham attack:3, dash;
  } else {
    alhaitham attack:1, dash, #has c6 bennett pyro infusion before getting mirrors
              attack:4, dash;
  }
  alhaitham attack:3, skill,
            attack:3, dash,
            attack:3, charge, dash,
            attack:3, charge;

  if LeaveCircleImpact {
    set_player_pos(0, 0);
    set_target_pos(0, 1.5);
  }
}
