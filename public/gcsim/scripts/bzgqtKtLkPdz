energy every interval=480,720 amount=1;

active diona;
for let i=0; i<4; i=i+1 {
  diona skill[hold=1], burst;
  rosaria skill, burst;
  bennett burst;
  gaming burst;
  wait(65);
  for let p=0; p<6; p=p+1 {
    print(p);
    gaming skill;
    wait(20);
    gaming low_plunge;
  }
  rosaria skill;
  gaming skill, low_plunge;
  bennett attack, skill;
}

