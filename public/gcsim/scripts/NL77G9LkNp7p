xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="flowingpurity" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add weapon="ttds" refine=5 lvl=90/90;
#xianyun add set="ohc" count=4; # Bubbles may miss
xianyun add set="sodp" count=4;
#xianyun add set="no" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  faruzan burst;

  xianyun skill, low_plunge, burst;

  xiao skill:2, burst;
  if .xiao.sets.dpc >= 4 { # || .xiao.sets.longnightsoath >= 4 {
    xiao attack, charge;
  }
  for let h = 11; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }

  raiden burst, attack:4, skill, attack:2;
}
