options iteration=1000 swap_delay=1; # Swap delay is handled by the pre-action hook above

target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.5;

energy every interval=480,720 amount=1;

active lyney;

lyney aim;

while true {
  
  print(.emilie.tags.lumidouce-level);
  print(.emilie.status.lumidouce-case);
  
  if .emilie.burst.ready && .emilie.tags.lumidouce-level >= 2 && !.status.bennettburst { # Prioritize Emilie Q over E if case level is max
    emilie burst;
  }
  
  else if .emilie.skill.ready && !.status.bennettburst && !.emilie.burst.cd { # Emilie E when Q can't be used to maintain case
    emilie skill, attack;
  }
  
  else if .zhongli.skill.ready && !.status.bennettburst {
    zhongli skill[hold=1], dash, attack;
  }
  
  else if .bennett.burst.ready || !.bennett.burst.cd && .bennett.energy >= 55 {
    bennett skill, burst;
  }
  
  else if .lyney.status.mh-4pc && .lyney.burst.ready && .status.bennettburst { # Condition could be more refined. Ideally you build 2 MH stacks before Lyney Q.
    lyney burst;
    delay(11);   # Don't detonate burst before collision damage
    lyney skill; # Detonate burst
  }
  
  else if .lyney.skill.ready && ( .status.bennettburst && .lyney.energy < 55 && .lyney.propSurplusStacks == 5 || !.status.bennettburst && .lyney.status.bennett-field < 120 ) {
    lyney skill; # Lyney E at 5 prop stacks unless Bennett Q will expire soon, and not if Q is ready very soon
  }
  
  else {
    lyney aim;
  }
  
}