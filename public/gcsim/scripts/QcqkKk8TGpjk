neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="favgs" refine=3 lvl=90/90;
xinyan add set="ap" count=4;
xinyan add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favoniussword" refine=3 lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active neuvillette;

for let i=0; i<3; i=i+1 {
  neuvillette skill;
  if i {
    xilonen burst;
  }
  xilonen skill, attack:2;
  kazuha skill, high_plunge;
  xinyan dash, skill, burst; pick_up_crystallize("hydro");
  kazuha burst;
  neuvillette charge, dash;
  kazuha skill[glide_cancel=1];
  wait(46);
  neuvillette skill, charge, burst;
  
  xilonen skill, attack:2;
  kazuha skill, high_plunge;
  xinyan dash, skill, burst; pick_up_crystallize("hydro");
  kazuha burst;
  neuvillette charge, dash;
  kazuha skill, high_plunge;
  wait(20);
  neuvillette charge;
}
wait(173); # Wait for last CA hit to land

# ~37s rotations (4 CA per rotation)
# Neuvillette E > Xilonen (Q) E N2 > Kazuha tEP > Xinyan D EQ > Kazuha Q > Neuvillette C D > Kazuha tE  > Neuvillette E C Q
#                 Xilonen     E N2 > Kazuha tEP > Xinyan D EQ > Kazuha Q > Neuvillette C D > Kazuha tEP > Neuvillette C