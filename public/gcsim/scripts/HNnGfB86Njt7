#furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.0662 cd=0.662 ;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favoniuslance" refine=3 lvl=90/90;
mika add set="clam" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
mika add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324 ;

active furina;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

let AIM_CANCEL=true;
for let i=0; i<4; i=i+1 {
  
  furina skill, dash;
  while !.furina.burst.ready && !.furina.mods.favonius-cd {
    furina attack;
  }
  furina burst;
 
  mika skill;
  while !.mika.burst.ready && !.mika.mods.favonius-cd {
    mika attack;
  }
  mika burst;
  
  fischl attack;
  if .fischl.burst.ready {
    fischl attack, burst;
  } else {
    fischl skill;
  }
  
  bennett skill, burst;
  
  if AIM_CANCEL {
    fischl attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0],
            attack:2, aim[hold=0];
  } else {
    fischl attack:5, dash,
            attack:5, dash,
            attack:5, dash,
            attack:5, dash,
            attack:3;
  }
          
  bennett skill;
}

