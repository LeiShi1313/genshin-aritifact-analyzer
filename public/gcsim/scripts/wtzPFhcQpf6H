# Sayu Nahida Furina Deyha. ~20s Rot. Sayu Burngeon in 2 Target. Max length rolls on Sayu. Deyha provdes crucial IR, damage reduction, and Pyro without NAs. Furina provides Hydro without NAs while and Vapes off of Burning aura.

# Team
sayu char lvl=90/90 cons=6 talent=9,9,9;
sayu add weapon="favgs" refine=3 lvl=90/90;
sayu add set="vv" count=4;
sayu add stats hp=4780 atk=311 em=187 em=187 em=187;
sayu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=118.92 cr=0.3972 cd=0.1324;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.5958;

dehya char lvl=90/90 cons=0 talent=9,9,9;
dehya add weapon="favgs" refine=3 lvl=90/90;
#dehya add set="fopl" count=4;
#dehya add set="gd" count=4;
dehya add set="ins" count=4;
dehya add stats hp=3571 atk=232 em=140.25 em=187 cr=0.23325; #main
dehya add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.07936 atk=26.464 atk%=0.07936 er=0.08816 em=126.848 cr=0.2648 cd=0.42368; # Ins
#dehya add stats hp=4780 atk=311 em=187 em=187 cr=0.311 ; #main
#dehya add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.331 cd=0.5296; # 5*

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

#Rotation
active dehya;

for let i=0; i<4; i=i+1 {
  dehya skill;

  nahida skill;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida attack, charge;
  }

  furina skill, dash, burst;

  sayu burst;

  dehya skill;
  if .sayu.skill.cd > 80 && .dehya.burst.ready && .dehya.energy == .dehya.energymax {
    dehya burst;
    while .sayu.skill.cd > 50 {
      dehya skill;
    }
  }

  sayu skill[hold=600];
  print("done");
}
