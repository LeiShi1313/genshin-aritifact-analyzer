# Rotation assumptions
active nahida;
for let i=0; i<4; i=i+1 {
  nahida skill, charge;
  kokomi attack, skill;
  nilou skill, attack:2, skill;
  lauma attack, skill[hold=1], burst;
  nahida burst;
  kokomi burst;
  
  kokomi attack:3, dash;
  kokomi attack:3, dash;
  kokomi attack:3, dash;
  kokomi attack:3, dash;
  kokomi attack:3, dash;
  
  kokomi attack:2, dash;  # Kokomi Burst expired
  kokomi charge;
}

