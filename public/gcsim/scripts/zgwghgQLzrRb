options swap_delay=12;

neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

charlotte char lvl=90/90 cons=6 talent=9,9,9; 
charlotte add weapon="favoniuscodex" refine=3 lvl=90/90;
charlotte add set="scroll" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311 ; #main
charlotte add stats hp%=0.0992 hp=507.88 atk%=0.2976 atk=33.08 def%=0.124 def=39.36 em=39.64 cr=0.331 cd=0.1324 er=0.551 ; #subs

kazuha char lvl=90/90 cons=0 talent=9,9,9; 
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=5;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.551 em=118.92 cr=0.0662 cd=0.1324;


furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add set="gt" count=4;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3641 cd=0.662;


active neuvillette;	

target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;

energy every interval=480,720 amount=1;

for let x = 0; x < 4; x = x + 1 {
  neuvillette skill;
  furina skill, dash, burst;
  kazuha skill, high_plunge, burst;
  charlotte skill, burst, attack; #catching her own particles
  while !.charlotte.mods.favonius-cd {
    charlotte attack;
  }
  neuvillette charge, burst, skill, charge;
  kazuha attack, skill, high_plunge;
  neuvillette charge, charge;
}
wait(173); #for the last CA