kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; # main
kazuha add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=118.92 er=0.4408 cr=0.2317 cd=0.4634;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="hakushin" refine=5 lvl=90/90;
baizhu add set="scroll" count=4;
baizhu add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466 ; #main
baizhu add stats def=39.36 def%=0.124 hp=2031.52 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=198.2 cr=0.0662 cd=0.1324 ;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active fischl; 

for let r=0; r<3; r=r+1 { # 3 rotations 

  if r { 
    kazuha skill, high_plunge; # refresh VV and Kazuha A4
    fischl attack:2;
  }
  fischl burst;
  kazuha burst; 
  baizhu skill, burst;
  clorinde_combo();
  fischl skill, attack;
  kazuha skill, high_plunge;
  baizhu skill, attack;
  clorinde_combo();
  
}