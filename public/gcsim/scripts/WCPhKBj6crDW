for let r = 6; r > 0; r = r - 1 {
  arle skill;
  yelan attack, skill, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack; # if its still not triggered try fav.
  }
  thoma skill, burst, attack;
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack, burst;
  }
  arle attack,
       charge,
       attack:5, dash,
       attack:5, dash,
       attack:5;
  // N13 is similar to 3[N5D]
}
