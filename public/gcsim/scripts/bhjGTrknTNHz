# YaoYao Emilie Furina Bennett. ~20s. Pyro Yaoyao Burning with Furina Vape. Emilie uses burst in Bennett burst. 2E Bennett.

# Team - Options listsed by DPS
yaoyao char lvl=90/90 cons=6 talent=9,9,9;
yaoyao add weapon="deathmatch" refine=1 lvl=90/90;
#yaoyao add weapon="fjords" refine=1 lvl=90/90;
yaoyao add set="deepwood" count=4;
yaoyao add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
yaoyao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.331 cd=0.331;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=300];
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.551 em=39.64 cr=0.331 cd=0.2648; # EM

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # deals burning AoE
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active emilie;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  bennett skill, burst;

  # Forego burst if energy deficient
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  yaoyao skill, burst;
  while .yaoyao.infusion.bennett-fire-weapon {
    if .yaoyao.normal > 3 {
      yaoyao dash;
    } else {
      yaoyao attack;
    }
  }

  bennett skill;

  print("done");
}
