tighnari char lvl=90/90 cons=0 talent=9,9,9;
tighnari add weapon="slingshot" refine=5 lvl=90/90;
tighnari add set="gd" count=4;
tighnari add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
tighnari add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gt" count=4;
yae add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="sacrificialjade" refine=1 lvl=90/90;
nahida add set="deepwoodmemories" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 em=187 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2317 cd=0.7944;

zhongli char lvl=90/90 cons=0 talent=9,9,9 start_hp=1;
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="totm" count=4;
zhongli add stats hp=4780 atk=311 atk=0.466 geo%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;


# ----  Default Enemy
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active zhongli;

# ----  Next rotations
for let i = 0; i < 4; i = i + 1 {
  zhongli skill[hold=1], dash, attack:2;
  if !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  yae attack, skill:3;
  nahida attack, charge, jump, skill, burst, attack, charge;
  tighnari skill,aim,burst,aim:2;

  zhongli skill[hold=1], dash, attack:2;
  if !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  yae attack, skill:3;
  nahida attack:2, skill,
       attack:2, charge, jump,
         attack, charge;
  tighnari skill, aim;
  if .tighnari.burst.ready && .tighnari.energy == .tighnari.energymax {
    tighnari burst, aim:2;
  } else {
    tighnari aim:2;
    nahida attack:2, skill,
           attack:2, charge;
  }
}

