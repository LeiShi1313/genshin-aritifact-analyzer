# Raiden Nahida Fischl Lanyan. ~18s Rot. Shielded Raiden Aggravate with Lanyan. Swirling Electro reliably is pretty easy even without Fischl C6. Fischl uses skill after Raiden burst if available.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
#raiden add weapon="fjords" refine=1 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
#nahida add set="scroll" count=4;
#nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=99.1 cr=0.2979 cd=0.5958;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.331 cd=0.7944;

lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="hakushin" refine=5 lvl=90/90;
#lanyan add weapon="widsith" refine=3 lvl=90/90;
#lanyan add weapon="evenstar" refine=1 lvl=90/90;
#lanyan add weapon="ttds" refine=5 lvl=90/90;
lanyan add set="vv" count=4;
lanyan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; # main 
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # Hakushin
#lanyan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; # main 
#lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296; # Widsith
#lanyan add stats hp=4780 atk=311 em=187 em=187 em=187; # main 
#lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.331; # Evenstar
#lanyan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; # main 
#lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2317 cd=0.662; # TTDS

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active raiden;
raiden skill;

lanyan attack:1; # VV, Hakushin

for let i=0; i<4; i=i+1 {
  nahida skill, attack, burst;
  
  fischl attack:2, burst;
  
  lanyan attack, skill:2, burst;
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:2;
  
  if .fischl.skill.ready {
    lanyan attack:2;
    fischl attack, skill;
  } else {
    raiden attack:2; # Rotation time
  }
}
