options swap_delay=12 iteration=500;

# Build assumptions
durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.0551*4 em=39.64 cr=0.0331*12 cd=0.0662*10;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="tom" count=4;
#columbina add set="gt" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.0551*5 em=19.82*6 cr=0.0331*7 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="sacbow" refine=5 lvl=90/90;
fischl add set="cg" count=4;
fischl add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworneye" refine=5 lvl=90/90;
nicole add set="sms" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.4408 em=79.28 cr=0.0662 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

active fischl;
for let i=0; i<8; i=i+1 {
  fischl attack, skill;

  if is_even(i) {
    columbina skill, burst;
  } else {
    columbina skill, attack;
  }
  nicole skill, burst;
  fischl attack, burst;
  let StartFrame = f();
  durin skill, attack, burst;
  while f() - StartFrame < 680 {
    if .durin.normal == 4 {
      durin dash;
    }
    durin attack;
    if .durin.normal == 2 && .stam > 50 {
      durin charge, dash;
    }
  }
}
