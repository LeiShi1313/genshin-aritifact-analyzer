prune add weapon="pamber" refine=5 lvl=90/90;
prune add set="vv" count=4;
prune add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
prune add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.2755 em=39.64 cr=0.2317 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active neuv;
for let i=0; i<4; i=i+1 {
  neuvillette skill;
  furina attack, skill, dash, attack;
  fischl attack, burst, attack; // No swap cancelling Q animation. spend time for Neuv E cd
  prune burst, attack;
  furina burst;
  neuvillette charge, skill, charge, burst;
  fischl attack, skill;
  prune attack, skill;
  neuvillette charge:2;
}
wait(173); #for the last CA

