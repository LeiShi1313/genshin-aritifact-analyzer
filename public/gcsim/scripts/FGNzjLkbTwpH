# Gaming Citlali Bennett Xianyun. ~20s Rot. Gaming Melt Plunge with 7 plunges, 6 melted. Gaming juggles Man Chai, using burst into skill + plunge and waiting on the ground before catching Man Chai mid descent. The final plunge is not melted, but is delayed for Gaming's particle ICD. Missing Bennett buff on the 6th plunge is -4K DPS. 

# Team - Options listed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.3972 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
#citlali add weapon="evenstar" refine=1 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9; 
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="scroll" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Adjacent

# Rotation
active gaming; #SS Stacks
gaming skill, low_plunge, dash; # Pyro VV 1st Rot

for let i=0; i<4; i=i+1 {
  chev burst, skill[hold=1]:3; # Just to take the rotation over 20s for TTDS
  
  bennett skill, burst;
  
  citlali skill, burst;
  
  gaming burst;
  let plungeCount = 0;
  for let j = 0; j < 6; j = j + 1 {
    # Change to 45 for non buffed 6th plunge, realistic
    sleep(42); # Catch Manchai during descent;
    gaming skill, high_plunge;
    plungeCount = plungeCount + 1; print(plungeCount);
  }
  sleep(30); # needed for particle ICD.
  gaming skill, high_plunge; print(plungeCount + 1); # Unmelted
  #gaming dash; # avoid dash cancel for TTDS purposes
}
