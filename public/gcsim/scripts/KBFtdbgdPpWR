options iteration=1000 swap_delay=12;

# Build assumptions
eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
eula add set="pf" count=4;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=5 lvl=90/90;
rosaria add set="noblesse" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="exile" count=4;
bennett add stats hp=3571 atk=232 er=0.387 pyro%=0.466 cr=0.232; #main
bennett add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.185136 em=199.786 cr=0.055608 cd=0.111216;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # single target
energy every interval=480,720 amount=1; # standard Energy drops
hurt every interval=120,360 amount=3000,5000 element=physical; # get hit every 2 to 6 seconds to account for serpent spine w/o a shield

# Rotation assumptions
active eula; # prestack serpent spine

for let i = 0; i < 4; i = i + 1 { 
  rosaria skill;
  while !.rosaria.mods.favonius-cd {
    rosaria attack;
  }
  eula skill, attack;
  bennett skill, burst;
  fischl attack, skill;
  rosaria burst;
  eula burst, walk, attack:4, skill[hold=1], walk[f=10], attack:4;
  fischl attack:2, burst;
  rosaria skill;
  while !.rosaria.mods.favonius-cd {
    rosaria attack;
  }
  eula attack:4, dash, attack:3;
}

# Rosaria E > Eula E > Bennett E Q > Fischl E > Rosaria Q > Eula Q N4 hE N4 > Fischl Q > Rosaria E > Eula N4dN3

