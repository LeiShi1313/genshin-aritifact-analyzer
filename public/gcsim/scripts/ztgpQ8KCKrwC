options swap_delay=12 iteration=1000;

# Build assumptions
chasca char lvl=90/90 cons=6 talent=10,10,10;
chasca add weapon="astralvulturescrimsonplumage" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
chasca add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;

xilonen char lvl=90/90 cons=6 talent=10,10,10;
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="ap" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

citlali char lvl=90/90 cons=6 talent=10,10,10;
citlali add weapon="starcallerswatch" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

mavuika char lvl=90/90 cons=6 talent=10,10,10;
mavuika add weapon="tbs" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika swap;         wait(9); # hiding swap cd warning

  mavuika skill[hold=1], dash;
  xilonen skill, attack:2;  pick_up_crystallize("pyro");
  citlali skill, attack;
  mavuika burst, charge:3, charge[final=1], dash;
  chasca skill;
  chasca aim[bullets=2];  print("this aim is: ", 1);  # Triggers C6
  chasca aim;             print("this aim is: ", 2);  # C6 instant shot + C6 Crit buff
  chasca aim[bullets=5];  print("this aim is: ", 3);  # Normal
  chasca aim[bullets=3];  print("this aim is: ", 4);  # Normal
  chasca aim[bullets=2];  print("this aim is: ", 5);  # Triggers C6
  chasca aim;             print("this aim is: ", 6);  # C6 instant shot + C6 Crit buff
  chasca aim[bullets=5];  print("this aim is: ", 7);  # Normal
  chasca aim[bullets=3];  print("this aim is: ", 8);  # Normal
  chasca aim[bullets=2];  print("this aim is: ", 9);  # Triggers C6
  chasca aim;             print("this aim is: ", 10); # C6 instant shot + C6 Crit buff
  chasca aim[bullets=4];  print("this aim is: ", 11); # Normal
}
wait(66); # for the last rot 4bullet shot to hit
//wait(59); # for the last rot Burst to hit
