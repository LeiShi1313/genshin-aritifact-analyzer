skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="finale" refine=5 lvl=90/90;
skirk add set="mh" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
skirk add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*3 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

ayato char lvl=90/90 cons=0 talent=9,9,9;
ayato add weapon="favsword" refine=3 lvl=90/90;
ayato add set="no" count=4;
ayato add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
ayato add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="favoniuslance" refine=3 lvl=90/90;
escoffier add set="scroll" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0;
energy every interval=480,720 amount=1;

let First_Rot_Nuke = true;  # Change this value between true and false.

active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  escoffier skill, burst;
  ayato skill, attack, burst, attack;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,

          attack:2, charge, dash,

          attack:5, dash,
          attack:5, dash,

          attack:2, charge, dash,

          attack:5, dash,
          attack;
  } else {
    skirk skill,
          attack:2, burst,

          attack:5, dash,
          attack:5, dash,
          attack:5, dash,

          attack:2, charge, dash,

          attack:5, dash,
          attack:2;
  }
}

# ~21s rotation
# 1st rotation: Furina ED Q > Escoffier EQ > Ayato E N1 Q N1 > Skirk Q tE N5D N2CD 2[N5D] N2CD N5D N1
# Other rotations: Furina ED Q > Escoffier EQ > Ayato E N1 Q N1 > Skirk tE N2 Q 3[N5D] N2CD N5D N2
