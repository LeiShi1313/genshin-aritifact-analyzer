neuv add weapon="sacjade" refine=1 lvl=90/90;
neuv add set="mh" count=4;
neuv add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
neuv add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*10 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*5 cr=0.0331*3 cd=0.0662*10;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=5 lvl=90/90;
mona add set="cg" count=4;
mona add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacfrags" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*11 er=0.0551*7 em=19.82*8 cr=0.0331*2 cd=0.0662*2;

xl char lvl=90/90 cons=6 talent=9,9,9;
xl add weapon="favlance" refine=5 lvl=90/90;
xl add set="scroll" count=4;
xl add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
xl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mona;

for let i=0; i<4; i=i+1 {
  mona attack, skill;
  neuv skill;
  xl burst, skill, dash;
  mona burst, attack:4;
  sucrose skill, dash, attack;
  neuv charge, skill, charge, burst;
  mona skill, burst, attack;
  xl attack, skill, dash;
  sucrose burst, skill, dash;
  delay(31);
  neuv charge:2;
}
wait(173); # wait for last CA to finish

# 32.5s rotations
# Mona N1 E > Neeuvillette E > Xiangling Q ED > Mona Q N4 > Sucrose ED N1 > Neuvillette C E C Q > Mona E Q N1 > Xiangling N1 ED > Sucrose Q ED > Neuvillette 2[C]
