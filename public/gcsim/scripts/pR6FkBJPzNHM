# Kinich Nahida Yelan Fischl . ~18s Rot. Kinich seeks blindspots. No Kinich short hold is -6K DPS. Codex > Scroll Kinich.

# Team
kinich char lvl=90/90 cons=0 talent=9,9,9;
kinich add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
kinich add set="oc" count=4;
#kinich add set="scroll" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
kinich add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # OC
#kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
#kinich add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.3972 cd=0.3972; # Scroll

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=59.46 cr=0.3641 cd=0.7944; # 3EM
#nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
#nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=158.56 cr=0.0662 cd=0.662; # EDC

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=198.2 cr=0.1986 cd=0.5958;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

fn kinich_combo() {
  kinich skill;
  set_player_pos(0, -3);
  while .kinich.nightsoul.state {
    switch .kinich.nightsoul.points {
      case 20:
        kinich skill[hold=1];
      default:
        if .kinich.blind_spot {
          kinich attack[direction=.kinich.blind_spot];
        } else {
          kinich attack;
        }
    }
  }
}

# Rotation
active kinich; # SS Stacks

for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  #if i > 0 && .nahida.burst.ready && .nahida.energy == .nahida.energymax {
  #  nahida burst, charge;
  #} else {
    nahida charge;
  #}
  
  yelan skill; set_player_pos(0, 0); # toward opponent
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  if .fischl.skill.ready {
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }
  
  kinich_combo();
  if .kinich.burst.ready { #&& .kinich.energy == .kinich.energymax {
    kinich burst;
  }

}

