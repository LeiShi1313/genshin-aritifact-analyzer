clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main 5* set
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9; 
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; 
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=5;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xiangling char lvl=90/90 cons=6 talent=9,9,9; 
xiangling add weapon="kitain" refine=5 lvl=90/90;
xiangling add set="deepwood" count=4;
xiangling add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.4408 em=118.92 cr=0.0662 cd=0.1324;
                                                                                                                                                                        
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active emilie;
for let i=0; i<4; i=i+1 {
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  if .xiangling.burst.ready {
    xiangling burst, skill, attack;
  } else {
    xiangling skill, dash, attack:3;
  }
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde attack; #phys for cd issue
  clorinde burst;
}
