# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Combos
fn sethosCombo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, skill;
}

# Rotation
active sethos;
sethos aim[hold=2];

for let i=0; i<4; i=i+1 {
	# VV, A1, A4
	sucrose attack;
  if .sucrose.skill.ready {
    sucrose skill, dash;
  } else {
    sucrose attack:2;
  }
	
	# Burst every rot is close with Twilight
	tighnari skill, aim;
	if .tighnari.burst.ready {
	  tighnari burst, aim:2;
	} else {
	  tighnari aim:2;
	}
	
  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
	
  # VV, A1, C6
  sucrose attack;
  if .sucrose.skill.ready {
    sucrose skill, dash;
  }
  if .sucrose.burst.ready {
    sucrose burst;
  }

  sethos skill; #aim[hold=2] # High ping only; dodges energy drain
  sethosCombo();
  sethos aim[hold=2];
  
  print("done");
}
