#kazuha add weapon="finale" refine=5 lvl=90/90;
kazuha add set="longnightsoath" count=4;
#kazuha add set="sr" count=4;
kazuha add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Atk/Py/Cr
#kazuha add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Atk/Py/Cd

chevreuse char lvl=90/90 cons=6 talent=9,9,9; 
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="esf" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; 
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
#bennett add weapon="sapwood" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4; # For Furina DMG
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.4959 em=59.46 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active bennett;

for let i=0; i<4; i=i+1 { 
  bennett skill;
  
  xianyun skill, low_plunge, burst;
  
  bennett burst, skill;

  chev burst, skill[hold=1]:2;
  
  xianyun attack:2; wait(20); # reresh VV
  
  kazuha skill, high_plunge[collision=1];
  while .kazuha.status.xianyun-airborne-buff {
    kazuha jump;
    if .airborne {
      kazuha high_plunge[collision=rand()>0.3];
    }
    if .kazuha.status.xianyun-airborne-buff {
      kazuha dash;
    }
  }
  kazuha skill, high_plunge[collision=1];
  #if .kazuha.burst.ready && .kazuha.energy == .kazuha.energymax { # DPS Loss
  #  kazuha burst;
  #}
}

