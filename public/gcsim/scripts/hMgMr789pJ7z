# Rosaria Yelan Furina Mika. ~22s Rot. Rosaria on-field. 2E Yelan. ~65% Cryo Resonance uptime.

# Team
rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="cpike" refine=5 lvl=90/90;
rosaria add set="mh" count=4;
#rosaria add set="bs" count=4;
#rosaria add set="pf" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main 
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662; # Atk Goblet
#rosaria add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; # main
#rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; #Phys Goblet

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.1655 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3641 cd=0.662;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
#mika add set="sodp" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.3972;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active furina;


for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  mika burst;
  
  rosaria skill, burst;
  
  yelan burst, attack, skill;
  
  mika attack, skill;
  
  rosaria attack;
  while !.yelan.skill.ready {
    if .rosaria.skill.ready {
      rosaria skill;
    } else if .rosaria.normal > 3 && .stam > 43 {
      rosaria charge, dash;
    } else {
      rosaria attack;
    }
  }
  
  yelan skill, attack;
  
  while !.furina.burst.ready {
    if .rosaria.skill.ready {
      rosaria skill;
    } else if .rosaria.normal > 3 && .stam > 43 {
      rosaria charge, dash;
    } else {
      rosaria attack;
    }
  }
  
}
