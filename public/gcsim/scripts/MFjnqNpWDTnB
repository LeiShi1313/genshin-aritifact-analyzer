options swap_delay=12 iteration=100;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="eshu" refine=5 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
skirk add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

gorou char lvl=90/90 cons=6 talent=9,10,9;
gorou add weapon="favbow" refine=5 lvl=90/90;
gorou add set="no" count=4;
gorou add stats hp=4780 atk=311 er=0.518 geo%=0.466 cr=0.311;
gorou add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=236.10 def%=0.1239 em=39.63 er=0.1101 cr=0.3305 cd=0.2642;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favoniuslance" refine=5 lvl=90/90;
zhongli add set="tenacity" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; #mainstats
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

albedo char lvl=90/90 cons=0 talent=9,9,9;
albedo add weapon="cinnabar" refine=5 lvl=90/90;
albedo add set="gt" count=4;
#albedo add set="husk" count=4 +params=[stacks=4];
albedo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #mains
albedo add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST enemy
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

let First_Rot_Nuke = false;  # Change this value between true and false.

active zhongli;

for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash, attack;
  if i > 0 && .zhongli.burst.ready {
    zhongli burst;
  }
  if !.zhongli.mods.favnoius-cd {
    zhongli attack;
  }


  gorou skill;
  if .gorou.burst.ready && .skirk.skill.cd {
    gorou burst;
  } else {
    gorou attack;
  }
  if !.gorou.mods.favonius-cd {
    gorou attack;
  }

  albedo attack, skill;
  if i > 0 && .albedo.burst.ready {
    albedo burst;
  }

  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,

          attack:2, charge, dash,

          attack:5, dash,
          attack:5, dash,

          attack:2, charge, dash,

          attack:4;
  } else {
    skirk skill,
          attack, burst,

          attack:5, dash,
          attack:5, dash,

          attack:2, charge, dash,

          attack:5, dash,
          attack:5, dash;
    skirk attack:2;
  }
}
