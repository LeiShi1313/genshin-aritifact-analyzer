sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="evenstar" refine=1 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=118.92 cr=0.3641 cd=0.2648;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

let UseXilonenDash = false;  # change between true and false.

active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  xilonen skill, attack:2;
  if UseXilonenDash == true {
    xilonen dash;   # dash to pick up the shard
  }
  pick_up_crystallize("pyro");
  sucrose swap; wait(23);
  sucrose skill, dash;
  citlali skill, burst, attack;
  mavuika burst;
  wait(18); # to wait Cryo app
  mavuika charge:3, charge[hold=6], charge[final=1], dash;
  mavuika charge:3, charge[hold=6], charge[final=1], dash; # the last Final CA is buffed by Mavuika Q.

  mavuika charge:3;
  if UseXilonenDash == false {   # if you didn't use Xilonen's dash, you need to do extra action to make it 18s rot length
    mavuika charge[final=1];
    delay(5);
  } else {
    mavuika dash;
    delay(9);
  }
}

# Mavuika E > Xilonen E N2 > Sucrose ED > Citlali EQ N1 > Mavuika Q (wait) 2[C3FD] C3F
