options swap_delay=12 iteration=1000;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="finaleofthedeep" refine=5 lvl=90/90;
skirk add set="mh" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
skirk add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;
#skirk add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # Non  freezable enemy

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*8;
#furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*12 cd=0.0662*7; # Non  freezable enemy

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="noblesse" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;
#yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # Non  freezable enemy

diona char lvl=90/90 cons=6 talent=9,9,9; 
diona add weapon="favbow" refine=4 lvl=90/90;
diona add set="scroll" count=4;
diona add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311;
diona add stats def%=0.062*2 def=19.68*2 hp=253.94*6 hp%=0.0496*10 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*2;
#diona add stats def%=0.062*2 def=19.68*2 hp=253.94*5 hp%=0.0496*10 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*2; # Non  freezable enemy


# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

let First_Rot_Nuke = true; # Change this value between true and false.

active furina;

for let i=0; i<4; i=i+1 { 
  furina skill, dash, burst;
  diona skill[hold=1], burst;
  yelan burst, attack, skill, attack;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:2, dash,
          attack:2, charge, dash,
          
          attack:2, dash,
          attack:4, dash,
          attack:2, dash,
          attack:4, dash,
          
          attack:2, charge, dash,
          
          attack:2, dash,
          attack:4, dash,
          attack:2, dash,
          attack:3;
  } else {
    skirk skill,
          attack:2, dash,
          attack:2, dash, 
          attack:2, burst, 
    
          attack:2, dash,
          attack:4, dash,
          attack:2, dash,
          attack:4, dash,
          
          attack:2, charge, dash,
          
          attack:2, dash,
          attack:4, dash,
          attack:2, dash,
          attack:3;
  }
}

# First rot only 
