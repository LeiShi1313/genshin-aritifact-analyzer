options swap_delay=12 iteration=1000;

active mona;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

for let i=0; i<2; i=i+1 {
  mona skill; # for hydro swirl and better energy economy
  sucrose skill;
  xiangling burst, skill, dash;
  mona burst;
  mualani burst;
  mualani skill;
  mualani_combo();
  if .mualani.nightsoul.state {
    mualani skill; # exit the nightsoul state
  }
  while !.element.t0.hydro {
    mualani attack;
  }


  xiangling attack:2;
  while !.xiangling.mods.favonius-cd {
    xiangling attack;
  }
  xiangling skill, dash;
  sucrose skill, dash;
  if .sucrose.skill.ready {
    sucrose skill, attack:2; # N2 to catch anemo particles on-field
  } else {
    sucrose attack;
  }
  sucrose burst;
  mona burst;
  mualani skill;
  mualani_combo();
}

# Mona E >
# Sucrose E > Xiangling QED >        Mona Q > Mualani Q E 3[3-stacked bite] E(cancel) N1(NA till the enemy has hydro arua) >
# Xiangling N2ED > Sucrose ED N1 Q > Mona Q > Mualani   E 3[3-stacked bite] >
