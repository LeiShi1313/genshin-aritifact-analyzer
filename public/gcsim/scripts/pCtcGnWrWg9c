# Rosaria Nahida Xingqiu Kuki. ~21s Rot. Phys Rosaria on-field in Hyperbloom. Kuki or Nahida burst at the end of the rotation based on energy.

# Team - Options ordered by DPS
rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="cpike" refine=5 lvl=90/90;
rosaria add set="pf" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main 
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311 ; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="fopl" count=4;
#kuki add set="gd" count=4;
kuki add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6061 em=118.92 cr=0.2648 cd=0.1986;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active xq; # SS Stacks

for let i=0; i<4; i=i+1 {
  xingqiu skill, dash, burst, attack;
  
  nahida skill, attack, charge; # CA nessesary
  
  kuki skill, attack;
  #if i > 0 && .kuki.burst.ready && .kuki.energy == .kuki.energymax {
  #  kuki burst;
  #}
  
  rosaria burst, attack, skill;
  while .xingqiu.skill.cd > 150 {
    if .rosaria.skill.ready {
      rosaria skill;
    } else if .rosaria.normal > 3 && .stam > 43 {
      rosaria charge, dash;
    } else {
      rosaria attack;
    }
  }
  if .kuki.burst.ready {
    kuki attack, burst;
  } else if .nahida.burst.ready {
    nahida burst;
  }
  
}

