# Dori Xingqiu Yelan Collie. ~25s Rot. Thundering Fury Dori DPS Hyperbloom. Dori leads with her burst supplying energy over the setup period. 2E Collei, 2E Yelan both fresh thier skill between Dori's skill uses.

# Team
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="flameforgedinsight" refine=5 lvl=90/90;
dori add set="tf" count=4;
dori add stats hp=4780 atk=311 em=187 em=187 em=187; #main
dori add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*12 cd=0.0662*8;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="lionsroar" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

collei char lvl=90/90 cons=6 talent=9,9,9;
collei add weapon="favbow" refine=4 lvl=90/90;
collei add set="deepwood" count=4;
collei add stats hp=4780 atk=311 er=0.518 dendro%=0.466 cr=0.311; #main
collei add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active dori;

for let i=0; i<4; i=i+1 {
  dori burst;

  xingqiu skill, dash, burst, attack;

  yelan skill, attack, burst, attack;

  collei skill, attack, burst, attack;

  dori skill, attack:2, dash, attack:2;
  dori skill, attack:2, dash, attack:2;

  yelan skill, attack;

  collei skill, attack;

  dori skill, attack:2, dash, attack:2;
}
