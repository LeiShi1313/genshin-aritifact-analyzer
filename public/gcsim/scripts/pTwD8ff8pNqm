kokomi char lvl=90/90 cons=0 talent=9,9,9;
kokomi add weapon="evenstar" refine=1 lvl=90/90;
kokomi add set="ohc" count=4;
kokomi add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.343;
kokomi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.2976 er=0.1102 em=237.84 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets 
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=3,0 hp=100000000; # 2nd

# Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  
  xingqiu skill, dash, burst, attack;
  
  kokomi skill, attack;
  
  lisa attack:3, dash ,attack:3, dash;
  lisa attack:3, dash, attack:3, dash; 
  lisa attack:3, dash, attack:3, dash; 
  lisa attack:3, dash, attack:3, dash;
  lisa attack:4;
  if.lisa.burst.ready {
    lisa burst;
  }
}
