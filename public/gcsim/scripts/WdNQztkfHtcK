# Sethos Chevreuse Fischl Mavuika. ~16s Rot. Sethos Overload with Mavuika providing significant Overload damage. Sethos uses skill twice per rotation for damage reasons, even if waiting is nessesary.

# Team - Options listed by DPS
sethos char lvl=90/90 cons=6 talent=9,9,9;
sethos add weapon="slingshot" refine=5 lvl=90/90;
sethos add set="wt" count=4;
#sethos add set="gd" count=4;
sethos add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
sethos add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="no" count=4;
#chev add set="sodp" count=4;
chev add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.4634; # NO
#chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
#chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3972 cd=0.3972; # SoDP

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="aquamarine" refine=1 lvl=90/90;
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 em=187 em=187 em=187; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active sethos;
sethos aim[hold=2];

for let i=0; i<4; i=i+1 {
  # Burst as available
  if .chev.sets.no > 4 {
    chev burst, skill[hold=1];
  } else {
    # Use C4 on subsequent rotations when available
    if .chev.burst.ready {
      chev burst, skill[hold=1];
      if i > 0 {
        chev skill[hold=1]:2;
      }
    } else {
      chev attack, skill[hold=1];
    }
  }

  # Alternate burst and skill
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }

  # Burst as available
  if .mav.burst.ready && i == 0 {
    mav burst, skill, dash;
  } else if .mav.burst.ready {
    mav burst, skill, dash, charge, dash;
  } else {
    mav attack, skill;
  }

  sethos skill, burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, skill:1,
         attack:1; # Phys N1
  sethos aim[hold=2]:1;
  sethos attack;
  #sethos aim[hold=1]:1; # Sethos catches his own particles
}
