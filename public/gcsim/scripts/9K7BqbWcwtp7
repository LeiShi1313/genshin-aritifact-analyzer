# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000; # Rear

# Combos
fn sethosCombo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk, 
         skill;
}

# Rotation
#active nahida;

active sethos;
sethos aim[hold=2];

for let i=0; i<4; i=i+1 {
  # Burst in 2nd Rot onward
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  
  if .mav.burst.ready {
    mav burst, skill;
    if i > 0 { # Fill time for sethos skill CD
      mav attack, charge;
    }
  } else {
    mav skill, attack;
  }
  
  if .amy.burst.ready {
    amy attack:2, burst;
  } else {
    amy skill, attack:2;
  }
  
  sethos skill; #aim[hold=2] # High ping only; dodges energy drain
  sethosCombo();
  sethos aim[hold=2]:2;
  sethos attack;
}
