options swap_delay=12 iteration=1000;

# Build assumptions
wrio char lvl=90/90 cons=6 talent=10,10,10;
wrio add weapon="cashflow" refine=5 lvl=90/90;
wrio add set="mh" count=4;
wrio add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
wrio add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

shenhe char lvl=90/90 cons=6 talent=10,10,10;
shenhe add weapon="calamityqueller" refine=5 lvl=90/90;
shenhe add set="sr" count=2;
shenhe add set="scroll" count=2;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.4408 em=39.64 cr=0.1324 cd=0.1324;

kazuha char lvl=90/90 cons=6 talent=10,10,10;
kazuha add weapon="freedomsworn" refine=5 lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187;
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3641 cd=0.5958;

xilonen char lvl=90/90 cons=6 talent=10,10,10; 
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3641 cd=0.5958;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active shenhe;

for let i=0; i<4; i=i+1 {
  shenhe skill[hold=1];
  if is_even(i) {
    shenhe burst;
  }
  xilonen skill, attack:2;
  kazuha skill, high_plunge;
  wrio  skill;
  wrio  attack:5, charge, jump;
  wrio  attack:5, charge, jump;
  wrio  attack:5, charge, dash;
  if is_even(i) && .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio burst;
  }
}

//wait(25); #25f wait for wrio burst to hit at the last rot
