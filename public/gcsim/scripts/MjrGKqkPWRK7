nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*7 atk%=0.0496*6 er=0.0551*3 em=19.82*2 cr=0.0331*12 cd=0.0662*2;

# Protoype Crescent Headshot Conditional
fn lyneyAim() {
  if .lyney.weapon == .keys.weapon.crescent { # Attempts headshots (50%) with Crescent
    lyney aim[hold=2, weakspot=rand()>0.5];
  } else { # Non weakspot opponents
    lyney aim[hold=2];
  }
}

options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active nicole;

for let i = 0; i < 3; i = i + 1 {

  nicole burst, skill;
  durin  burst, skill:2;
  sayu skill[short_hold=1], burst;
  lyney aim[weakspot=1], aim;
  if .lyney.burst.ready {
    lyney burst;
    delay(11);
    lyney skill;
  } else {
    lyney aim;
  }
  lyney aim:2, skill, aim;
}
