#Nahida GT Xingqiu DW has marginally higher simulated DPS than Nahida DW Xingqiu EOSF despite default Nahida action

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="widsith" refine=3 lvl=90/90;
nahida add set="gt" count=4;
#em/dendro/cr has 1% higher simulated DPS than em/em/cr
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="deepwood" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="clam" count=4;
baizhu add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.1324;

kuki char lvl=90/90 cons=6 talent=9,9,9;
#Xiphos r1 has 1% higher simulated DPS than Iron Sting r5
kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="fopl" count=4;
kuki add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324;

options swap_delay=12 iteration=1000 duration=90;
target lvl=100 resist=0.1 radius=1 pos=0,1.5;
energy every interval=480,720 amount=1;

active kuki;
while 1 {
  switch {
    case .kuki.skill.ready:
      kuki skill, attack;
    case .xingqiu.skill.ready:
      xingqiu skill, dash;
    case .xingqiu.burst.ready:
      xingqiu burst, attack;
    case .baizhu.burst.ready:
      baizhu burst, attack;
    case .baizhu.skill.ready:
      baizhu skill, attack;
    case .nahida.burst.ready && !.status.nahida-q:
      nahida burst, attack;
    case .nahida.skill.ready:
      nahida skill, attack;
    case .kuki.burst.ready:
      kuki burst, attack;
    case .nahida.normal == 3:
      nahida charge, dash;
    default:
      nahida attack;
  }
}

