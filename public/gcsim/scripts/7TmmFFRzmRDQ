xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="flowingpurity" refine=5 lvl=90/90;
xianyun add set="no" count=5;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3857 em=39.64 cr=0.0662 cd=0.1986;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=9999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active navia; # prestack SS
for let x = 0; x < 4; x = x + 1 {
  furina skill, dash, burst;
  xilonen skill, attack:2;
  navia burst;
  xianyun skill, low_plunge, burst;
  navia_combo(); # hE 4[JhPD]
  xilonen skill, attack:2;
  navia_combo(); # hE 4[JhPD]
}
