bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408  em=39.64 cr=0.2648 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999; 
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active bennett;

for let i=0; i<6; i=i+1 { # six rotations
  if i {
    clorinde attack;
  }
  bennett skill, burst;
  if .fischl.skill.ready { # fischl burst every other rotation
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  if .chev.burst.ready {
    chev burst, skill[hold=1]:2;
  } else {
    chev attack, skill[hold=1], attack;
  }
  clorinde burst, attack;
  clorinde_combo();

}

