arlecchino char lvl=90/90 cons=2 talent=10,10,9;
arlecchino add weapon="crimsonmoonssemblance" refine=1 lvl=90/90;
arlecchino add set="scrolloftheheroofcindercity" count=1;
arlecchino add set="fragmentofharmonicwhimsy" count=4;
arlecchino add stats def=44 hp=5348 atk=344 atk%=0.711 em=165 cr=0.739 cd=0.816 pyro%=0.466;

nicole char lvl=90/90 cons=2 talent=1,10,1;
nicole add weapon="angelosheptades" refine=1 lvl=90/90;
nicole add set="scrolloftheheroofcindercity" count=1;
nicole add set="celestialgift" count=4;
nicole add stats def%=0.131 def=21 hp=4780 hp%=0.42100000000000004 atk=394 atk%=1.73 er=0.589 cr=0.09300000000000001 cd=0.17099999999999999;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="wanderingevenstar" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats def%=0.124 def=39.36 hp=5287.88 hp%=0.0992 atk=344.08 atk%=0.0992 er=0.1102 em=678.42 cr=0.3972 cd=0.5296;

citlali char lvl=90/90 cons=2 talent=1,9,9;
citlali add weapon="starcallerswatch" refine=1 lvl=90/90;
citlali add set="scrolloftheheroofcindercity" count=4;
citlali add set="celestialgift" count=1;
citlali add stats def%=0.182 hp=6065 hp%=0.047 atk=444 atk%=0.617 er=1.328 em=335.5 cr=0.039;

options iteration=1000  swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1;
active arle;

for let i=0; i<4; i=i+1 {
  arle skill;
  nicole skill, attack;
  sucrose skill, dash;
  if .sucrose.burst.ready {
    sucrose burst;
  } else {
    sucrose attack;
  }
  citlali skill, burst;
  arle charge;
  delay(40);
  arle attack, walk;
  arle attack:3;
  citlali attack:1;
  arle attack, walk,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3;
}
