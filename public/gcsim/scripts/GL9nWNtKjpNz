options iteration=1000 swap_delay=12;

# Build assumptions
dehya char lvl=90/90 cons=6 talent=9,9,9;
dehya add weapon="uomms" refine=5 lvl=90/90;
dehya add set="vg" count=4;
dehya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main stats: ATK% Pyro% CR
dehya add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="sacbow" refine=5 lvl=90/90;
fischl add set="totm" count=4;
fischl add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; # Main stats: ER Electro% CR
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=3 lvl=90/90;
mona add set="gift" count=4;
mona add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; # Main stats: ATK% Hydro% CR
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*10 cd=0.0662*9;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main stats: ATK% Pyro% CD
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*7 er=0.0551*3 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

# Target, Energy and damage taken assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops
hurt every interval=180,300 amount=3500,5500 element=physical; # damage taken assumed every 3-5s

# Rotation assumptions
active dehya;

for let i=0; i<4; i=i+1 {
  dehya skill;
  fischl skill, attack;
  if !i {
    durin skill, burst, attack;
  } else {
    durin skill:2, burst;
  }
  mona attack, burst, attack;
  fischl attack, burst;
  mona attack, skill, attack;
  dehya burst, attack:15, skill;
}

# 20s rotation (Fischl Sac Bow)
# Dehya E > Fischl E N1 > Durin EEQ > Mona N1 Q N1 > Fischl N1 Q > Mona N1 E N1 > Dehya Q N15 E
