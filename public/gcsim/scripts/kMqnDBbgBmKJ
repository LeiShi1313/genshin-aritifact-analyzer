# - Characters

lyney char lvl=90/90 cons=0 talent=9,9,9 ;
lyney add weapon="crescent" refine=5 lvl=90/90;
#lyney add weapon="songofstillness" refine=5 lvl=90/90; # ~5k less dps than crescent with weakspots, ~5k more than crescent without weakspots
lyney add set="marechausseehunter" count=4;
lyney add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
lyney add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90; # alley flash wants >kqm er subs
#bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="no" count=4; # petra isn't great because lyney's abundant dmg%
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# - Options

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

let weak = 1; #replace with 0 if not using crescent

# - Target

target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;

# - Actions

active bennett;

for let i=0; i<4; i=i+1 {
  if i { # not done first rot because no buffs
    lyney aim[weakspot=weak];
  }
  bennett skill, burst;
  xilonen skill, attack:2;

  if .kazuha.burst.ready {
    kazuha burst;
  } else {
    kazuha skill, high_plunge;
  }
  lyney aim[weakspot=weak], aim:2;
  if .lyney.burst.ready {
    lyney burst;
    delay(11); # wait for initial burst hit
    lyney skill;
  } else {
    lyney aim;
  }
  lyney skill;
}

# Lyney "Mono" with 2 shredders and no IR. 15s 4CA rotation
# Rotation: Bennett E Q, Xilonen E N2, Kazuha Q/EhP, Lyney 3C QE/C E C
