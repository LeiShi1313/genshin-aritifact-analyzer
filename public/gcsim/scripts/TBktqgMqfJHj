# Clorinde Nahida Furina Lisa. ~20s Rot. Whhimsy Clorinde Quickbloom with Lisa. Lisa uses hold skill + normal attacks after her burst to fill time. Nahdia builds ER, but cannot burst every rotation reliably.

# Team
clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.1986 cd=0.3972;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

lisa char lvl=90/90 cons=6 talent=9,9,9; 
lisa add weapon="pamber" refine=5 lvl=90/90;
lisa add set="fopl" count=4;
#lisa add set="no" count=4;
#lisa add set="gd" count=4;
lisa add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.3972 cd=0.3972;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

# Clorinde Combo
fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

#Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  nahida skill; 
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida attack, charge;
  }
  
  furina skill, dash, burst;
  
  lisa burst, skill[hold=1], attack:3;
  
  clorinde_combo();
  clorinde burst; # Minor DPS loss
}

