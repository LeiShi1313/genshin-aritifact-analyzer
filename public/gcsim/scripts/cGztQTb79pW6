# Xiao Faruzan double Geo with Chiori. KQMS. Zhongli and Faruzan force Favonius. 12 Plunges. 50% collisions. 

chiori char lvl=90/90 cons=0 talent=9,9,9; 
chiori add weapon="harbingerofdawn" refine=5 lvl=90/90;
chiori add set="goldentroupe" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mainstats
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xiao char lvl=90/90 cons=0 talent=9,9,9;
xiao add weapon="deathmatch" refine=1 lvl=90/90;
xiao add set="longnightsoath" count=4;
xiao add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main 
xiao add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2979 cd=0.662;

faruzan char lvl=90/90 cons=6 talent=9,9,9; 
faruzan add weapon="favbow" refine=3 lvl=90/90;
faruzan add set="noblesseoblige" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

zhongli char lvl=90/90 cons=0 talent=9,9,9; 
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

options swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
active zhongli;

for let i=0; i<4; i=i+1 {
  
  zhongli skill[hold=1], dash; 
  while !.zhongli.mods.favonius-cd {
    zhongli attack; # proc fav
  }

  faruzan burst;
  while !.faruzan.mods.favonius-cd && !.xiao.burst.ready {
    faruzan attack; # proc fav
  }
  
  chiori skill:2;
  
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
  
}
