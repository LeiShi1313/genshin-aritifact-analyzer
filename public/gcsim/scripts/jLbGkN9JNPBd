# Hutao Columbina Fischl Ineffa. ~18s Rot. KQMS KurtC. Hutao LunarOverVape. Hutao 6N3CJ N2CJ. After the first rotation, Hutao uses her burst outside of Parmamita state just to fill time. More Overload DMG than CA damage. Ineffa and Columbina burst in opposite rotations. Fischl alternates skill and burst.

# Team
hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="dbane" refine=3 lvl=90/90;
#hutao add weapon="fjords" refine=1 lvl=90/90;
hutao add set="notsu" count=4;
hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
hutao add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*3 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*3 cr=0.0331*12 cd=0.0662*10; # DBane
#hutao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
#hutao add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*5 cr=0.0331*11 cd=0.0662*10; # Fjords

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="aubade" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*9 cr=0.0331*7 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="sms" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active ineffa;

for let i=0; i < 4; i=i+1 {
  if i > 0 && .ineffa.burst.ready {
    ineffa skill, burst;
  } else if i > 0 {
    ineffa attack, skill;
  } else {
    ineffa skill;
  }

  if .columbina.burst.ready {
    columbina skill, burst;
  } else {
    columbina skill, attack;
  }

  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }

  hutao skill,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:2, charge, dash;
  if i > 0 && .hutao.burst.ready { # Filler
    hutao burst;
  }
}
