# Arlecchino Fischl Durin Columbina 18s rotation (no team healing), artifacts follow KQMS. Fischl alternates E and Q, Arle uses both N2C and N6, with a slightly modified first rotation

options swap_delay=12 iteration=1000;

# Build assumptions
arlecchino char lvl=90/90 cons=0 talent=9,9,9;
arlecchino add weapon="fjords" refine=1 lvl=90/90;
arlecchino add set="fohw" count=4;
arlecchino add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
arlecchino add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90;
fischl add set="sms"count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="moonweaversdawn" refine=2 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="totm" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*8 cr=0.0331*8 cd=0.0662*10;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active fischl;

fischl skill;
for let i=0; i<4; i=i+1 {

  arlecchino skill;

  durin skill, skill, burst;

  columbina skill, attack;

  if (is_even(i)) {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }

  if (i != 0) {
    arlecchino attack:2;
  }
  arlecchino charge,
             attack:2, charge,
             attack:2, charge,
             attack:2, charge,
             attack:2, charge,
             attack:6, attack:2;
  if (i == 0) {
    arlecchino attack;
  }
}

# Opener: Fischl E > Arlecchino E > Durin EEQ > Columbina EN1 > Fischl N2Q > Arlecchino C 4[N2C] N6 N3
# Loop: Arlecchino E > Durin EEQ > Columbina EN1 > Fischl N1E/N2Q > Arlecchino 5[N2C] N6 N2
