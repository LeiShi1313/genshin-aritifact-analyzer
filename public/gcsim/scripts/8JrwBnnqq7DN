# Kaveh Furina Raiden Xianyun. ~22s Rot. Solo Dendro Kaveh Hyperbloom with No ICD plunges for additional Dendro application. Fav Kaveh skills off cd to meet ER needs. 50% Collisions.

# Team - Options ordered by DPS
kaveh char lvl=90/90 cons=6 talent=9,9,9;
kaveh add weapon="favgs" refine=3 lvl=90/90;
kaveh add set="longnightsoath" count=4;
#kaveh add set="mh" count=4;
kaveh add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cr=0.311; #main
kaveh add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # LNO
#kaveh add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
#kaveh add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662; # MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ToM

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="dbane" refine=3 lvl=90/90;
#raiden add set="fopl" count=4;
raiden add set="deepwood" count=4;
raiden add stats hp=4780 atk=311 em=187 em=187 em=187; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.3306 em=118.92 cr=0.0662 cd=0.2648;

xianyun char lvl=90/90 cons=0 talent=9,9,9; 
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4;
#xianyun add set="deepwood" count=4;
#xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active raiden;
raiden skill;

for let x = 0; x < 4; x = x + 1 {  
  furina skill, dash;
  if !.furina.burst.ready {
    furina attack;
  }
  furina burst;
  
  xianyun skill, low_plunge, burst;
  
  kaveh skill, attack, burst;
  # Plunge Combo w/ skill as available
  while .kaveh.status.xianyun-airborne-buff {
    if .kaveh.skill.ready {
      kaveh skill;
    }
    kaveh jump;
    if .airborne {
      kaveh high_plunge[collision=rand()>0.5], dash;
    }
  }
  #Extension
  while .furina.skill.cd > 60 { 
    if .kaveh.skill.ready {
      kaveh skill;
    } else {
      kaveh attack;
    }
  }
  
  raiden attack, skill;
  
  print("done");
}

