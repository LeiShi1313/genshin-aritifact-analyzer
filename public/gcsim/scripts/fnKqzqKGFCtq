options swap_delay=12 iteration=1000;

# Build assumptions
ayaka char lvl=90/90 cons=0 talent=9,9,9;
ayaka add weapon="finale" refine=5 lvl=90/90;
//ayaka add set="bs" count=4;       # if the enemy is Freezable 4BS is better than 4MH
ayaka add set="mh" count=4;
ayaka add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
ayaka add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972;

skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100];
skirk add weapon="moonweaversdawn" refine=2 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="no" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  escoffier skill, burst;
  ayaka skill, dash, attack, burst,
        attack:2, charge, dash,
        attack:2, charge;
  skirk skill[hold=1], burst;
  ayaka dash, attack,
        skill, dash, 
        attack:2, charge, 
        attack:2, charge;
}

# Furina ED N1 Q > Escoffier EQ > Ayaka ED N1 Q N2CD N2C > Skirk hE Q > Ayaka D N1 ED 2[N2C]
