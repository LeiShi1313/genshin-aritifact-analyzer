# ----  Default Enemy
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 pos=0,2.4 radius=2;
target lvl=100 resist=0.1 hp=100000000 pos=0,6.6 radius=2;
energy every interval=480,720 amount=1;

active neuv;
for let i = 0; i < 3; i = i + 1 {
  neuv burst;
  kazuha skill, high_plunge, burst;
  zhongli skill[hold=1], dash, dash, attack;
  for let k=0; k<10; k=k+1 {
    if .gadgets.crystallizeshard.hydro > 0 {
      pick_up_crystallize("hydro");
      break;
    }
    wait(1);
  }
  shenhe attack, skill[hold=1], attack;
  kazuha skill, high_plunge;
  neuv charge, charge, skill;
  kazuha skill, high_plunge, burst;
  zhongli skill[hold=1], dash, dash, attack;
  for let k=0; k<10; k=k+1 {
    if .gadgets.crystallizeshard.hydro > 0 {
      pick_up_crystallize("hydro");
      break;
    }
    wait(1);
  }
  shenhe attack, skill[hold=1], attack;
  kazuha attack, skill, high_plunge;
  neuv charge, skill, charge;
}
wait(173);

