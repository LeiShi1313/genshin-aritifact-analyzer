chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="hamayumi" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="favcodex" refine=3 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
citlali add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*8 em=19.82*2 cr=0.0331*12 cd=0.0662*6;

barbara char lvl=90/90 cons=6 talent=9,9,9;
barbara add weapon="ttds" refine=5 lvl=90/90;
barbara add set="instructor" count=4;
barbara add stats hp=4780 atk=311 hp%=0.466 hp%=0.348 heal=0.268; #main
barbara add stats def%=0.05208*2 def=16.5312*2 hp=213.31*2 hp%=0.041664*2 atk=13.8936*2 atk%=0.041664*2 er=0.046284*2 em=16.6488*2 cr=0.027804*12 cd=0.055608*4;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwoodblade" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*10 cr=0.0331*2 cd=0.0662*6;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active citlali;

for let i=0; i<4; i=i+1 {
  citlali skill, burst, attack;

  bennett skill, burst, attack;

  barbara swap; wait(20);   # Wait for Citlali's Pyro Scroll
  if .barbara.skill.ready { # Attempt to leave Hydro for Hydro Scroll
    barbara attack:2, skill;
  } else {
    barbara attack:2;
  }

  chasca skill;
  set_player_pos(0,-2);  # To simulate that Barbara E ring doesn't apply Hydro to the enemy
  chasca aim:4, aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  }

  bennett skill, attack:2, dash;
  set_player_pos(0,0);
}

# 21s rot
# Citlali EQ N1 > Bennett EQ N1 > Barbara N2 (E) > Chasca E 4[C] C_4b (Q) > Bennett E N2D
