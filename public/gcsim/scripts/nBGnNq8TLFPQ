# Wanderer Ororon Yelan Xingqiu. ~21 Rot. Wanderer Taser with VV Wanderer NA spam. Wanderer ends his field time with Q or lPDN1. 1E Yelan.

# Team
wanderer char lvl=90/90 cons=0 talent=9,9,9; 
wanderer add weapon="widsith" refine=3 lvl=90/90;
wanderer add set="vv" count=4;
wanderer add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
wanderer add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="chainbreaker" refine=5 lvl=90/90;
#ororon add weapon="twilight" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944; # CB
#ororon add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; # main
#ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.1655 cd=0.5958; # FT

yelan char lvl=90/90 cons=0 talent=9,9,9; 
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xingqiu char lvl=90/90 cons=6 talent=9,9,9; 
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="eosf" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active xq;

for let i=0; i<4; i=i+1 { 
  xingqiu skill, dash, burst, attack;
  
  ororon skill, attack, burst, attack;
  
  yelan skill, attack, burst, attack;
  
  wanderer skill, attack;
  while .wanderer.skydweller-points > 3 {
    switch {
      case .wanderer.normal < 3:
        wanderer attack;
      case .wanderer.mods.wanderer-a4:
        wanderer dash;
      default:
        wanderer attack;
    }
  } 
  if .wanderer.burst.ready && .wanderer.energy == .wanderer.energymax {
    wanderer burst, attack;
  } else {
    #wanderer skill;
    wanderer low_plunge, dash, attack;
  }

}
