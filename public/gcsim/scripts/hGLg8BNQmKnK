options swap_delay=12 iteration=1000;

# Build assumptions
kinich char lvl=90/90 cons=6 talent=10,10,10;
kinich add weapon="fangofthemountainking" refine=5 lvl=90/90;
kinich add set="obsidiancodex" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622;
kinich add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

emilie char lvl=90/90 cons=6 talent=10,10,10;
emilie add weapon="lumidouceelegy" refine=5 lvl=90/90;
emilie add set="deepwood" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cr=0.311;
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1653 em=39.64 cr=0.2979 cd=0.7944;

durin char lvl=90/90 cons=6 talent=10,10,10;
durin add weapon="athameartis" refine=5 lvl=90/90;
durin add set="no" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

nicole char lvl=90/90 cons=6 talent=10,10,10;
nicole add weapon="angelosheptades" refine=5 lvl=90/90;
nicole add set="gift" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.1102 em=39.64 cr=0.2979 cd=0.1986;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

fn kinich_combo() {
  kinich skill;

  for let c=0; c<5; c=c+1 {
    kinich attack[direction=1]:2;
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.duration > 12 {
      kinich skill[hold=1];
    }
  }
}

active emilie;
emilie skill;
for let i=0; i<4; i=i+1 {
  nicole skill, attack;
  durin skill, burst, skill;
  emilie burst;
  kinich_combo();
  if .kinich.burst.ready {
    kinich burst;
  } else {
    kinich attack, jump;
  }
}
