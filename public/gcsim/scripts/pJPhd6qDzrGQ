# ----  Default Enemy
options swap_delay=12 debug=true iteration=1000;
target lvl=100 resist=0.1 hp=100000000 pos=0,2.4 radius=2;
#target lvl=100 resist=0.1 hp=100000000 pos=0,6.6 radius=2;
energy every interval=480,720 amount=1;

active neuv;
for let i = 0; i < 3; i = i + 1 {
  neuv burst;
  kazuha skill, high_plunge; #hydro swirl
  kirara burst, skill[short_hold=1];
  xiangling burst, skill, dash;
  neuv charge, charge, skill, attack:3;
  kazuha skill, high_plunge, burst;
  kirara skill[hold=34]; #34frames=hold until 3hits for reliable fav proc
  xiangling skill, dash, attack:3;
  neuv charge, skill, charge;
}
wait(173);

