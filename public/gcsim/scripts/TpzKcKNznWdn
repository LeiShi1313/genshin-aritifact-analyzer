# Amber Furina Bennett Mona. ~21s Rot. Amber Furina with no bunny shots, no delays for Hydro aura. Attempts 50% initial weakspots shot, then 20%.

# Team
amber char lvl=90/90 cons=6 talent=9,9,9;
amber add weapon="songofstillness" refine=5 lvl=90/90;
#amber add weapon="scion" refine=1 lvl=90/90;
#amber add weapon="rangegauge" refine=1 lvl=90/90;
amber add set="mh" count=4;
amber add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
amber add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cd=0.622; #main 
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.4634;

mona char lvl=90/90 cons=0 talent=9,9,9;
mona add weapon="pamber" refine=5 lvl=90/90;
mona add set="ohc" count=4;
#mona add set="sodp" count=4;
mona add stats hp=4780 atk=311 atk%=.466 hydro%=0.466 heal=0.359; #main
mona add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.331;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  
  mona burst;
  
  bennett skill, burst;
  
  amber aim[weakspot=rand()>0.5];
  while .furina.skill.cd > 60 {
    if .amber.burst.ready {
      amber burst;
      mona attack, skill;
    } else if .amber.skill.ready {
      amber skill, dash;
    } else {
      amber aim[weakspot=rand()>0.8];
    }
  }

  bennett skill, attack;
}

