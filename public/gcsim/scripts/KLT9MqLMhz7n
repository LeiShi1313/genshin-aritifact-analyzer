#xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311 ; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.331 cd=0.7282;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,3.4 hp=100000000; # No Contact Rainswords
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Contact Rainswords

#target lvl=100 resist=0.1 radius=1 pos=4,3.4 hp=100000000; # Secondary Target

# Beidou 15% Perfect Counter, 15% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.85 {
    counter = 2;
  } else if counter > 0.75 && counter <= 0.85 {
    counter = 1;
  } else {
    counter = 0;
  }

  return counter;
}

# Rotation
active beidou; # SS stacks

for let x=0; x<4; x=x+1 {
  xingqiu skill, dash, burst, attack;

  beidou skill[counter=rand_counter()], attack, burst;

  fischl attack, skill;

  yoimiya skill, attack:5, dash, attack:5, dash, attack:5;

  beidou skill[counter=rand_counter()];

  fischl attack:2, burst;

  yoimiya skill, attack:5, dash, attack:4, burst;
}
