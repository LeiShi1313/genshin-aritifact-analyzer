xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="ohc" count=4; # Bubbles may miss
xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*6 er=0.0551*9 em=19.82*2 cr=0.0331*2 cd=0.0662*3;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Functions
# Diluc Plunge
fn DilucPlunge() {
  diluc jump;
  if .airborne {
    diluc high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active diluc; # SS stacks

for let r = 0; r < 4; r = r + 1 {
  furina skill, dash, attack, burst;

  kazuha skill, high_plunge;

  xianyun skill, high_plunge, burst;

  kazuha burst;

  diluc skill:2, burst, skill;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc dash;
  DilucPlunge(); diluc skill;
  DilucPlunge(); diluc skill;
  DilucPlunge();
}
