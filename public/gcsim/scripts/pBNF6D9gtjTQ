xiao char lvl=90/90 cons=0 talent=9,9,9;
xiao add weapon="balladofthefjords" refine=1 lvl=90/90;
xiao add set="longnightsoath" count=4;
#xiao add set="sr" count=4;
xiao add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
xiao add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662 ;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="viridescentvenerer" count=5;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=148.86 atk%=0.2976 er=0.6061 em=39.64 cr=0.0662 cd=0.1324 ;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;


options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,3;
energy every interval=480,720 amount=1;

active furina;

let rotations = 4;

for let r = rotations; r > 0; r = r - 1 {

  furina skill, dash, burst;
  
  xianyun skill, low_plunge, burst;
  
  bennett skill, burst, attack;

  // attack[travel=0] to minimize the time during which Furina pets could 
  // apply hydro and prevent Pyro VV.
  // Also more closely mimics in game, because after Bennett N1 connects, 
  // we should be basically melee and the projectile does not travel much
  xianyun attack[travel=0], attack; 

  xiao skill;
  for let h = 8; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
  
  xiao skill;
  
  bennett skill, dash;
  
}