# Ayaka Furina Kaeya Xilonen. ~22s Rot. Ayaka Freeze, no grouping. Ayaka, Kaeya, and Xilonen do 2 skills per rotation, with Xilonen Scrolling both Hydro and Cryo. Xilonen heals the whole team. -5K DPS with Freeze Immnuity & MH.

# Team
ayaka char lvl=90/90 cons=0 talent=9,9,9;
ayaka add weapon="finale" refine=5 lvl=90/90;
ayaka add set="bs" count=4;
#ayaka add set="mh" count=4; # Freeze resist
ayaka add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
ayaka add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

kaeya char lvl=90/90 cons=6 talent=9,9,9;
kaeya add weapon="favsword" refine=3 lvl=90/90;
kaeya add set="no" count=4;
#kaeya add set="bs" count=4;
kaeya add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main 
kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # NO
#kaeya add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main 
#kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # BS

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freeze Immunity

# Rotation
active xilonen; 

#active kaeya; # To scroll Cryo for Ayaka's burst in the first rot; less DPS
#kaeya skill;

for let r=0; r<4; r=r+1 {
  xilonen burst;
  
  furina skill, dash, burst;
  
  xilonen skill, attack:2;
  
  kaeya burst, skill;
  
  ayaka skill, dash, burst, attack:2, charge, dash, attack:2, charge;
  
  kaeya attack, skill;
  
  xilonen skill, attack:2;
  
  ayaka dash, attack:2, charge, skill, dash, attack:2, charge;
}
