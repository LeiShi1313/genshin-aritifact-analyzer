# Bennett Furina Columbina Ineffa. ~22s Rot. Lunar Overvape Bennett with Furina. Columbina prefers to Burst every rotation Pamber for furina's fanfare. Bennett spams N2C and tE off CD. Furina prefers SMS to ToM for Aubade Columbina.
# Note. Bennett: Exaiphanes Blade? Heretic's Molten Blade? Emberwell?

# Team - Options ordered by DPS
bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="wolffang" refine=1 lvl=90/90; # WF > Eshu
#bennett add weapon="umbrella" refine=5 lvl=90/90; # Umbrella > Alleyflash
bennett add set="cw" count=4;
#bennett add set="tf" count=4;
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10; # WF
#bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
#bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # Umbrella

