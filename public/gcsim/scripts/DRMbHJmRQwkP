options swap_delay=12 iteration=1000;

# Build assumptions
raiden char lvl=90/90 cons=6 talent=10,10,10; 
raiden add weapon="staffofthescarletsands" refine=5 lvl=90/90;
raiden add set="gd" count=5;
raiden add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622;
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=6 talent=10,10,10; 
furina add weapon="key" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=6 talent=10,10,10;
nahida add weapon="tfd" refine=5 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=10,10,10;
fischl add weapon="elegy" refine=5 lvl=90/90;
fischl add set="scroll" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;
                                                                                                                                                                                                                                                        
# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active raiden;

raiden skill;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst, attack:2;
  fischl attack, aim[hold=0], burst;
  nahida skill, burst, attack:2, charge, attack:2, charge;
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  if is_even(i) {
    fischl attack, skill;
  }
}
