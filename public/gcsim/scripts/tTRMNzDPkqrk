options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0;
energy every interval=480,720 amount=1;

active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack;
  escoffier attack, skill, attack:3, dash;
  skirk skill[hold=1], burst;
  furina burst;
  escoffier burst;
  ayato skill, attack:14;
  escoffier skill, attack;
  ayato burst;
  skirk skill[hold=1], burst;
  ayato attack, skill, attack:16;
}

