yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="sr" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main 5* set
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# with two targets, EM build on yoi gets stronger.

beidou char lvl=90/90 cons=6 talent=9,9,9;
beidou add weapon="serpentspine" refine=1 lvl=90/90  +params=[stack=5];
beidou add set="emblemofseveredfate" count=4;
beidou add stats hp=4780 atk=311 er=0.518 cd=0.622 electro%=0.466;
beidou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.3857 em=39.64 cr=0.3972 cd=0.331;

fischl char lvl=90/90 cons=6 talent=9,9,9; 
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="fadingtwilight" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; 
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
                                
chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466 ; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.1986;
                                                                                                                                                                        
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
#target lvl=100 resist=0.1 radius=2 pos=4,5 hp=999999999; 
energy every interval=480,720 amount=1;

active beidou;
for let i=0; i<4; i=i+1 {

  let counter_chance = rand();
  
  if counter_chance <= 0.1 {
    beidou skill[counter=2]; # perfect counter having 10% of chance
  } else if counter_chance <= 0.3 {
    beidou skill[counter=1]; # counter having 30% of chance
  } else {
    beidou skill;
  }
  beidou dash, burst, attack:2;

  chevreuse burst, skill[hold=1], attack, dash;
  
  if .fischl.skill.ready {
    fischl attack:3, skill; 
  } else {
    fischl attack:3, burst;
  }
  # Fischl use N3 before oz to ensure chev c6 stacks while waiting for beidou E cooldown
  
  if counter_chance <= 0.1 {
    beidou skill[counter=2]; # perfect counter having 10% of chance
  } else if counter_chance <= 0.3 {
    beidou skill[counter=1]; # counter having 30% of chance
  } else {
    beidou skill;
  }
  
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;

  if i==0 || i==2 {
    yoimiya burst;
  } else {
    yoimiya attack:2; # waiting for beidou Q cooldown
  }
}

# Beidou E dash Q N2 > Chevreuse Q hE N1D > Fischl N3 (E or Q) > Beidou E > Yoi E 3[N5D] N1 > Yoi Q or N2
