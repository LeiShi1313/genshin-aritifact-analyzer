#enemy config
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

#rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  escoffier attack, skill;
  charlotte attack, burst;
  ayato skill, attack:15;
  escoffier attack:2;
  charlotte attack:2, skill;
  ayato attack:2, burst, skill, attack:15;
}

