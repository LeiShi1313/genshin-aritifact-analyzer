# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;
fn rand_counter() {
  let counter = rand();
  if counter > 0.5 {
    counter = 2;
  } else {
    counter = 0;
  }
  
  return counter;
}

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.5,1.4 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=1.5,1.4 hp=100000000; 

#Rotation
active beidou; # SS Stacks

for let i=0; i<5; i=i+1{
  beidou skill[counter=rand_counter()], burst, attack;
  nahida skill, attack, burst;
  kuki skill, attack;
  ayato skill, attack:15;
  nahida skill, attack:2, charge;
  ayato skill, attack:7, burst;
  print("done");
}
