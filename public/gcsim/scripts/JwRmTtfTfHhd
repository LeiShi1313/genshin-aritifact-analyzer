# Sethos Emilie Mavuika Ororon. ~16s Rot. Defenseless Sethos Quickburn. Full EM Ororon & Mavuika & EM goblet Sethos. Emilie and Mavuika burst every other rotation after the first. Sethos does EQ 8EN2W EC, doing more than one aimed shot at the end to fill time for cds isn't worth the energy cost.

# Team
sethos char lvl=90/90 cons=6 talent=9,9,9;
sethos add weapon="slingshot" refine=5 lvl=90/90;
sethos add set="wt" count=4;
sethos add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
sethos add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

mav char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="aquamarine" refine=1 lvl=90/90;
mav add set="deepwood" count=4;
#mav add set="scroll" count=4;
mav add stats hp=4780 atk=311 em=187 em=187 em=187; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=118.92 cr=0.3972 cd=0.1324;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
#ororon add set="deepwood" count=4;
ororon add stats hp=4780 atk=311 em=187 em=187 em=187; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active emilie;
emilie skill;

for let i=0; i<4; i=i+1 {
  if i > 0 && .emilie.burst.ready {
    emilie burst;
  } else if .emilie.skill.ready {
    emilie skill, attack;
  }

  ororon skill, burst;

  if i > 0 && .mav.burst.ready {
    mav skill, burst;
    while .sethos.skill.cd {
      mav charge;
    }
    mav dash;
  } else {
    mav skill, attack;
  }

  sethos skill; # aim[hold=2]; # High ping only
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, skill;
  sethos aim[hold=2]:1;
}
