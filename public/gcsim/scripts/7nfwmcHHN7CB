yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

charlotte char lvl=90/90 cons=6 talent=9,9,9; 
charlotte add weapon="ttds" refine=5 lvl=90/90;
charlotte add set="ohc" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 heal=0.359;
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.551 em=39.64 cr=0.1986 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active furina;
for let x=0; x<4; x=x+1 {
  furina skill, dash, attack, burst;
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  yelan attack, skill, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack;
  }
  charlotte skill[hold=1], burst, attack:2; # catches her own particles
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
}
