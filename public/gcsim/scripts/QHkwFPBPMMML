#ningguang add set="nighttime" count=4;
ningguang add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311;
ningguang add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.2648 cd=0.7944;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
	  pick_up_crystallize("any");
  }
  return _execute_action(char_id, action_id, p);
}


active furina;
for let x=0; x<4; x=x+1 {
 
  furina skill, dash, burst; 
  bennett burst, skill;
  ningguang skill, dash, attack, charge;
  if .chiori.burst.ready {
    chiori burst;
  } 
  chiori skill:2;
  ningguang burst, dash, skill, charge, attack, charge, attack, charge, attack, charge, attack, charge, attack, charge;
  bennett skill, dash;

  
}

# furina EDQ > bennett QE > ningguang ED N1C > Chiori (Q)EE > ninguangg Q D E C 5[N1C] > bennett ED