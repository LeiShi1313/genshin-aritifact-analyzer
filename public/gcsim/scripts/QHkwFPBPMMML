# Ningguang Chiori Furina Bennett. ~21s rot length. Ningguang utilizes C2 to generate particles twice by splitting her field time.


bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=4;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359;
