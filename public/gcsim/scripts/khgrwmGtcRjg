clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finaleofthedeep" refine=5 lvl=90/90;
clorinde add set="tf" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="hakushinring" refine=5 lvl=90/90;
nahida add set="scroll" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=1000 duration=90;
target lvl=100 resist=0.1 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

fn clorinde_combo() {

  clorinde skill;

  while .clorinde.status.clorinde-night-watch {

      if .clorinde.bolratio >= 1 {

          clorinde skill;

      } else {

          clorinde attack;

      }

  }

}

active nahida; 

nahida skill;

while 1 {
  
  clorinde_combo();
  
  if .clorinde.burst.ready {
    
    clorinde burst;

  }

  nahida skill, attack, charge;

  
}