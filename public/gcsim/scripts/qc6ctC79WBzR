# Nahida Xingqiu Kazuha Diona. ~21s Rot. Bloom. Kazuha uses skill as available, Nahida onfield otherwise; her combo can likely be optimized. No burst Nahida. Assumes XQ rainswords contact opponents.

# Team
nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="xiphos" refine=1 lvl=90/90;
xingqiu add set="fopl" count=4;
xingqiu add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xingqiu add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.4408 em=118.92 cr=0.1324 cd=0.1324;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
#kazuha add set="fopl" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

diona char lvl=90/90 cons=6 talent=9,9,9;
diona add weapon="favbow" refine=4 lvl=90/90;
diona add set="no" count=4;
diona add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
diona add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=10;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.3,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=1.3,1.4 hp=100000000;

# Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  nahida skill;
  #if .nahida.burst.ready {
  #  nahida burst;
  #} else {
    nahida attack, charge;
  #}

  xq skill, dash, burst, attack;

  diona skill[hold=1], attack, burst, attack;

  while .xq.mods.xingqiuburst > 60 {
    if .kazuha.skill.ready && .kazuha.swap.ready {
      kazuha attack, skill, high_plunge[collision=rand()>0.5];
    } else if .kazuha.burst.ready && (.kazuha.swap.ready || .kazuha.onfield) {
      kazuha attack, burst;
    } else if .nahida.normal > 2 && .stam > 18 {
      nahida dash;
    } else {
      nahida attack;
    }
  }

}
