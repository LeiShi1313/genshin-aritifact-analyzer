#keqing add set="tf" count=2;keqing add set="glad" count=2;
#keqing add set="gd" count=4;
keqing add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # Electro
#keqing add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # Pyro
