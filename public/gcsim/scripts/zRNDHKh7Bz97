xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.3306 em=39.64 cr=0.3972 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Kaveh Plunge Combo - Adjust the wait (in frames)for Hydro application
fn KavehPlunge() {
  if !.element.t0.hydro {
    #wait(25);
  }
  kaveh jump;
  if .airborne {
    kaveh high_plunge[collision=rand()>0.5];
  }
}

active kaveh; # SS stacks

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;

  xianyun skill, low_plunge, attack, burst;

  bennett skill, burst, attack;

  xianyun attack, attack, charge;

  kaveh swap;
  KavehPlunge(); kaveh dash;
  KavehPlunge(); kaveh dash;
  KavehPlunge(); kaveh dash;
  KavehPlunge(); kaveh dash;
  KavehPlunge(); kaveh dash;
  KavehPlunge(); kaveh dash;
  KavehPlunge(); kaveh dash;
  KavehPlunge(); kaveh attack;
  kaveh skill;

  bennett skill;
}
