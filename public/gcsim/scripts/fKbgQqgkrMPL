# --- Options
options iteration=1000;
energy every interval=480,720 amount=1;

# --- Targets
target lvl=100 resist=0.1 radius=2 pos=0,3 hp=999999999; 

# --- Rotation
active kuki;

for let i=0; i<4; i=i+1 { 
  kuki skill;
  furina skill, burst;
  luminedendro attack, skill, burst, attack;
  cyno burst, attack, skill;
  while .cyno.burst.cd>250{
   if .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}