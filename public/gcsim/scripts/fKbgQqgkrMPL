fn rand_delay(mean, stddev) {
  let del = randnorm() * stddev + mean;
  if del > (mean + mean) {
    del = mean + mean;
  }
  delay(del);
}

let prev_char_id = -1;
let prev_action_id = -1;

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if prev_char_id != char_id && action_id != .action.swap {
    execute_action(char_id, .action.swap, []);
  }
  
  # --- Edit delays here
  if action_id == .action.swap { # Delay before swap
    rand_delay(12, 3);
  } else if prev_action_id == .action.attack && action_id != .action.attack && action_id != .action.charge { # Delay before NA, but not if followed by another NA or CA
    rand_delay(3, 1);
  } else if prev_action_id != .action.attack { # Delay before everything else
    rand_delay(3, 1);
  }

  prev_char_id = char_id;
  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}
# --- This pre-action hook setup adds randomized execution delays for non-bufferable actions (usually 2-4f) and swaps (usually 9-15f)

