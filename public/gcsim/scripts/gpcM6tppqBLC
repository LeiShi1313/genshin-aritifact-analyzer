options swap_delay=12 iteration=1000;

# Build assumptions
chasca char lvl=90/90 cons=6 talent=10,10,10;
chasca add weapon="astralvulturescrimsonplumage" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
chasca add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;

xilonen char lvl=90/90 cons=6 talent=10,10,10; 
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

furina char lvl=90/90 cons=6 talent=10,10,10; 
furina add weapon="favsword" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=10,10,10; 
bennett add weapon="skywardblade" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=178.38 cr=0.0662 cd=0.4634;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active furina;

for let i=0; i<4; i=i+1 {
  if is_even(i) {
    furina skill, dash, burst, attack:2;
  } else {
    furina burst, attack;
  }
  xilonen skill, attack:2;
  bennett skill, burst;
  chasca skill;
  chasca aim[bullets=2];  print("this aim is: ", 1);  # Triggers C6
  chasca aim;             print("this aim is: ", 2);  # C6 instant shot + C6 Crit buff
  chasca aim[bullets=6];  print("this aim is: ", 3);  # Normal
  chasca aim[bullets=5];  print("this aim is: ", 4);  # Normal
  chasca aim[bullets=2];  print("this aim is: ", 5);  # Triggers C6
  chasca aim;             print("this aim is: ", 6);  # C6 instant shot + C6 Crit buff
  chasca aim[bullets=6];  print("this aim is: ", 7);  # Normal
  chasca aim[bullets=5];  print("this aim is: ", 8);  # Normal
  chasca aim[bullets=2];  print("this aim is: ", 9);  # Triggers C6
  chasca aim;             print("this aim is: ", 10); # C6 instant shot + C6 Crit buff
  if is_even(i) {
    chasca burst;
  }


}
wait(23); # for the last rot C6 instant shot to hit
