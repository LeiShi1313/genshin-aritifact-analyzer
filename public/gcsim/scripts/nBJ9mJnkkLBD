# Eula Furina Shenhe Dori. ~21s Rot. Eula manages her ER needs with 3 Favs; Shenhe passes her particles to Eula Before and after Eula's burst; Dori increases her ER and restores some flat energy to Eula after her burst animaton. 78% Base Phys Shred; Shenhe's burst Phys shred expires immeditately after Eula's Lightfall sword drops.

# Team
eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="uomms" refine=5 lvl=90/90;
eula add set="mh" count=4;
#eula add set="pf" count=4;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # MH
#eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main
#eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # PF

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

shenhe char lvl=90/90 cons=0 talent=9,9,9; 
shenhe add weapon="favlance" refine=3 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.2204 em=39.64 cr=0.331 cd=0.662;

dori char lvl=90/90 cons=6 talent=9,9,9; 
dori add weapon="favgs" refine=3 lvl=90/90;
dori add set="ohc" count=4;
#dori add set="sodp" count=4;
dori add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.3972 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active furina;

for let i=0; i<4; i=i+1 { 
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && !.furina.mods.favonius-cd {
    furina attack;
  }
  furina burst;
  
  dori skill, attack:2, burst;
  
  shenhe burst, skill[hold=0];
  
  eula skill;
  if !.eula.burst.ready {
    eula attack;
  }
  eula burst, walk, attack:4, skill[hold=1], walk[f=11], attack:4;
  
  shenhe skill[hold=0];
  while !.shenhe.mods.favonius-cd {
    shenhe attack;
  }
  
  eula attack:2;
}

