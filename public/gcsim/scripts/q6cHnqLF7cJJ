options swap_delay=12 iteration=1000;

neuvillette char lvl=90/90 cons=0 talent=9,9,9 ;
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90 ;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
neuvillette add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.1986 cd=0.662;

albedo char lvl=90/90 cons=0 talent=9,9,9;
albedo add weapon="cinnabarspindle" refine=5 lvl=90/90;
albedo add set="goldentroupe" count=4;
albedo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #mainstats
albedo add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
albedo add stats geo%=0.125; #albedo A1

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="ap" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

active neuvillette;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  neuvillette skill;
  furina skill, attack; # to catch neuv hydro particles
  albedo skill, attack, dash;
  if .zhongli.burst.ready { # to fill the time of neuv E cd use 5star Q animation
    zhongli burst;
  } else if .albedo.burst.ready {
    albedo burst;
  }
  zhongli skill[hold=1], dash;
  let startFrame1 = f();
  while !pick_up_crystallize("hydro") && f() - startFrame1 < 30 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } # until the character pickup the shard, try to force fav proc or wait, up to 30frames
  furina burst;
  neuvillette charge, skill, charge, burst;
  zhongli attack:2, skill, dash;
  let startFrame2 = f();
  while !pick_up_crystallize("hydro") && f() - startFrame2 < 30 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } # until the character pickup the shard, try to force fav proc or wait, up to 30frames
  neuvillette charge, charge;
}

wait(173); #for the last CA

# Neuv E > Furina E N1 > Albedo E N1D > Zhongli Q hED > Furina Q > Neuv C E C Q > Zhongli N2 tE dash > Neuv 2[C]
