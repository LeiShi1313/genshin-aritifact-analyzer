active yae;

#single target
target lvl=100 resist=0.1 hp=9999999999 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
    if !i {
      yae  skill:3;
    } else {
      yae skill, attack, skill, attack, skill; 
    }
    kazuha skill, high_plunge;
    fischl attack, skill;
    nahida skill, attack, burst;
    kazuha burst;
    yae attack, burst, skill, attack, skill, attack, skill;
    kazuha skill, high_plunge;
    fischl attack:2, burst;
    yae attack:2, charge, dash, attack:2, charge, dash;
    kazuha skill, high_plunge;
    yae attack:2, charge, dash, attack:2, charge, dash;
}
