fischl add weapon="thestringless" refine=3 lvl=90/90;
fischl add set="gt" count=5;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="hakushinring" refine=5 lvl=90/90;
nahida add set="gt" count=5;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; # main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3641 cd=0.5958;

options swap_delay=12 iteration=1000;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active fischl;
fischl aim;
for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash, attack;
  let startFrame1 = f();
  while !pick_up_crystallize("electro") && f() - startFrame1 < 30 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } # until the character pickup the shard, try to force fav proc or wait, up to 30frames
  nahida skill, burst;
  fischl attack:2, burst;
  keqing skill, burst, skill,
         attack, charge, 
         attack, charge, 
         attack, skill,
         attack, charge,
         attack, charge,
         attack;
  zhongli skill[hold=1], dash, attack;
  let startFrame2 = f();
  while !pick_up_crystallize("electro") && f() - startFrame2 < 30 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } # until the character pickup the shard, try to force fav proc or wait, up to 30frames
  nahida attack, skill, attack;
  fischl attack, skill;
  keqing skill, burst, skill,
         attack, charge, 
         attack, charge, 
         attack, skill,
         attack, charge,
         attack, charge,
         attack;
}
