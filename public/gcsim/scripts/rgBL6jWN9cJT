# Keqing Nahida Furina Xianyun. ~24s Rot. Keqing Quickbloom Plunge. Xianyun only applies VV in the second half of the rotation. Hold skill aerial plunge not used. 50% Collisons.

# Team
keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="umbrella" refine=5 lvl=90/90;
keqing add set="mh" count=4;
keqing add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=118.92 cr=0.1986 cd=0.4634;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.4408 em=198.2 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Yae Plunge Combo
fn KeqingPlunge() {
  keqing jump;
  if .airborne {
    keqing high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active keqing;

for let x = 0; x < 4; x = x + 1 {
  nahida skill;
  if .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida attack, charge;
  }

  furina skill, dash, attack, burst;

  xianyun skill, low_plunge, burst;

  keq skill:2;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq attack, burst;

  xianyun attack:2; xianyun charge;

  keq skill:2;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq dash;
  KeqingPlunge(); keq attack, charge;
}
