# Keqing Yelan Furina Mika. ~22s Rot. Phys Keqing on-field spamming CA. Keqing bursts after Yelan's burst expires. 2E Yelan. OHC > SODP Mika.

keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="finale" refine=5 lvl=90/90;
#keqing add weapon="rancour" refine=5 lvl=90/90;
keqing add set="mh" count=4;
keqing add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; # main
keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296; # Phys; MH
#keqing add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; # main
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ATK; MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
#mika add set="sodp" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=1523.64 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  yelan skill, burst, attack;
  
  mika burst, attack, skill;
  
  while !.yelan.skill.ready {
    if .status.keqingstiletto && .keq.normal > 1 {
      keq charge;
    } else if .keq.skill.ready && .previous-action != .action.skill {
      keq skill;
    } else if .keq.normal > 1 && .stam > 25 {
      keq charge;
    } else if .keq.normal > 3 && .stam > 18 {
      keq dash;
    } else {
      keq attack;
    }
  }
  
  yelan skill, attack;
  
  while .yelan.mods.yelanburst {
    if .status.keqingstiletto && .keq.normal > 1 {
      keq charge;
    } else if .keq.skill.ready && .previous-action != .action.skill {
      keq skill;
    } else if .keq.normal > 1 && .stam > 25 {
      keq charge;
    } else if .keq.normal > 3 && .stam > 18 {
      keq dash;
    } else {
      keq attack;
    }
  }
  keqing burst; # preserve stamina; SC is expired
}
