# Eula Rosaria Escoffier Xianyun. ~19s Rot. Eula bursts every 3rd rotation; she fills time with NA on non-burst rotations. OHC > VV Xianyun, but bubbles may miss. Escoffier only bursts if available. 50% Collisions.

# Team - Options listed by DPS
eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
eula add set="lno" count=4;
#eula add set="pf" count=4;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
#escoffier add set="tom" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
#xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active eula; # SS Stacks

for let i = 0; i < 4; i = i + 1 {
  if !is_even(i) {
    esco burst;
  }
  escoffier skill;

  xianyun skill, low_plunge, burst;

  eula skill, attack;

  rosaria skill, burst;

  # Minor burst stacking when available
  if .eula.burst.ready && .eula.energy == .eula.energymax  {
    eula burst, walk, attack, skill[hold=1];
  } else { # Fill time for Furina skill CD
    eula skill[hold=1];
  }
  # Plunge spam after RES shred
  while .eula.status.xianyun-airborne-buff {
    eula jump;
    if .airborne {
      eula high_plunge[collision=rand()>0.5];
    }
    if .eula.status.xianyun-airborne-buff { # swap > dash for final plunge
      eula dash;
    }
  }

}
