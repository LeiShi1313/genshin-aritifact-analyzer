# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

#Rotation
active kokomi;

for let i=0; i<4; i=i+1 {
  kokomi skill, dash;
  
  citlali skill, burst;
  
  furina skill, dash, burst;
  
  rosaria skill, burst;
  
  kokomi attack, burst,
        attack:2, dash,
        attack:2, dash,
        attack:2, walk,
        attack:2, dash,
        attack:2, dash,
        attack:2, walk,
        attack:2, dash,
        attack:2, dash,
        attack:2, walk,
        attack:2, dash,
        attack:2; 
        
  rosaria skill;
}
