# Kokomi Furina Rosaria Citlali. ~21s Rot. Kritkomi with MH, Sac Jade, Rosaria A4, & Cryo Resonance. Kokomi leads the rotation with skill and refreshes with burst. 2E Rosaria. Don't play this.

# Team - Options listed by DPS
kokomi char lvl=90/90 cons=0 talent=9,9,9;
kokomi add weapon="sacjade" refine=1 lvl=90/90 +params=[stacks=1];
kokomi add set="mh" count=4;
