# Klee Chevreuse Fischl Yae. ~17s Rot. Klee double Electro Overload. Klee and Chevreuse burst if available. Klee remains on field until Yae's totems expire. Yae does not burst. ToM Yae is pretty close to GT.

# Team - Options listed by DPS
klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
#klee add weapon="flowingpurity" refine=5 lvl=90/90;
#klee add weapon="evenstar" refine=1 lvl=90/90;
klee add set="gd" count=4;
#klee add set="cw" count=4;
#klee add set="fohw" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="dialogues" refine=5 lvl=90/90;
#chevreuse add weapon="deathmatch" refine=1 lvl=90/90;
chevreuse add set="scroll" count=4;
#chevreuse add set="gt" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # DotDS
#chevreuse add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # DM

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gt" count=4;
#yae add set="tom" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.0 hp=100000000;

# Rotation
active yae;

for let i=0; i<4; i=i+1 {
  yae skill:3;

  if .chev.burst.ready && .chev.energy == .chev.energymax {
    chev burst, skill[hold=1]:3;
  } else {
    chev attack, skill[hold=1];
  }
  
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }
  
  klee attack;
  while .status.yae_oldest_totem_expiry {
    switch {
      case .klee.burst.ready && .klee.energy == .klee.energymax:
        if .klee.skill.ready && .klee.sets.cw > 4 {
          klee skill[release=0];
        }
        klee burst;
      case .klee.skill.ready:
        klee skill[bounce=3, mine=8], jump;
      case .stam > 50 && .previous-action == .action.attack:
        klee charge;
      case .previous-action == .action.attack:
        klee walk;
      default:
        klee attack;
    }
  }
  
}
