albedo char lvl=90/90 cons=0 talent=9,9,9;
albedo add weapon="cinnabarspindle" refine=5 lvl=90/90;
albedo add set="gt" count=5;
albedo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; #main
albedo add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1988 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbingerofdawn" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 def%=0.583 cd=0.622 ; # main
chiori add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

sigewinne char lvl=90/90 cons=0 talent=9,9,9;
sigewinne add weapon="sacrificialbow" refine=5 lvl=90/90;
sigewinne add set="ohc" count=4;
sigewinne add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466 ; #main
sigewinne add stats def=39.36 def%=0.124 hp=2031.52 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.1324 ;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=5000000;
energy every interval=480,720 amount=1;

active albedo;
albedo skill;
let sac_proc=0;
while true {

  if .sigewinne.skill.ready && sac_proc==0 {
    // do not proc E twice in a row when sac activates, giving some time for stacks to be used up.
    sigewinne skill,attack:2;
    if .sigewinne.skill.ready {
      sac_proc=1;
    }
  } else if .furina.burst.ready {
    furina burst;
    if .furina.skill.ready {
      furina skill;
    }
  } else if !.furina.status.furina-skill {
    furina skill;
  } else if .chiori.skill.ready {
    // ensures albedo does not refresh his skill every cd
    albedo skill,dash;
    pick_up_crystallize("hydro");
    chiori skill:2;
  }
  else if .sigewinne.burst.ready {
    if .sigewinne.skill.ready && sac_proc==1 {
      sac_proc=0;
      sigewinne skill;
    }
    sigewinne burst;
  } else if .chiori.burst.ready {
    chiori burst;
  }
  else {
    sigewinne attack:2,dash;
    // can do anything, just need to maintain geo resonance.
    pick_up_crystallize("hydro");
  }

}
