# Cyno Nahida Mavuika Kuki. ~22s Rot. Cyno Quickburn with Nahida and Kuki. Everyone but Cyno bursts every other rotation after the first. Mavuika just does QCED. Kuki does more damage built for EDC for Quicken than 3EM for Overload.

# Team - Options listed by DPS
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="fjords" refine=1 lvl=90/90;
cyno add set="ur" count=4;
cyno add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2317 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
#nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="aquamarine" refine=1 lvl=90/90;
#mav add weapon="earthshaker" refine=5 lvl=90/90;
mav add set="scroll" count=4;
mav add stats hp=4780 atk=311 em=187 em=187 em=187; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=118.92 cr=0.3972 cd=0.1324; # 3EM
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # ADC

kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="deepwood" count=4;
#kuki add set="tom" count=4;
kuki add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.1986 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active nahida;
nahida skill;

for let i=0; i<4; i=i+1 {
  # Skip Q on  first rotation, then use as available
  if !is_even(i) {
    nahida skill, attack, burst;
  } else if i > 0 {
    nahida skill, attack, charge;
  }

  kuki skill;
  if !is_even(i) {
    kuki burst;
  }

  if is_even(i) {
    mav burst, charge, skill, dash; # So Cyno can catch particles
  } else {
    mav skill, dash;
  }

  cyno burst, attack:2, skill;
  while .cyno.mods.cyno-q > 260 { # Cyno catches his final skill particles
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}
