kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="fopl" count=5;
kuki add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kuki add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*6 cr=0.0331*8 cd=0.0662*2;

options swap_delay=12 iteration=500;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 hp=10000000 radius=2 pos=2.4,0;
active furina;
 
for let r = 0; r < 5; r = r + 1 {
  furina skill, dash, attack;
  nahida skill, burst;
  furina  burst;
  if .kuki.burst.ready {
    kuki burst, attack;
  }
  alhaitham burst;
  kuki attack, skill;
  alhaitham attack:3, dash,
            attack:3, dash,
            skill,
            attack:3, dash,
            attack:3, charge, dash,
            attack:3, dash,
            attack:3, dash,
            attack:3;
}
