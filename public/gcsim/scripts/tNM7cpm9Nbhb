# Kazuha Faruzan Furina Jean. ~20s Rot. Kazuha-Faruzan Quickswap. Kazuha skills off CD with Faruzan aimed shots in between. Jean C4 is worth ~4K DPS. 100% Collisions.

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="wolffang" refine=1 lvl=90/90;
kazuha add set="mh" count=4;
#kazuha add set="longnightsoath" count=4;
#kazuha add set="vv" count=2; kazuha add set="dpc" count=2;
kazuha add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;
#kazuha add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
#kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1653 em=39.64 cr=0.3972 cd=0.3972; # 2pc2pc

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="songofstillness" refine=5 lvl=90/90;
faruzan add set="mh" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

jean char lvl=90/90 cons=0 talent=9,9,9; 
jean add weapon="favsword" refine=3 lvl=90/90;
jean add set="vv" count=4;
#jean add set="no" count=4;
jean add stats hp=4780 atk=311 atk%=0.466  anemo%=0.466 cr=0.311 ; #main
jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  
  jean burst, skill;
  
  faruzan skill, burst;
  
  kazuha skill, high_plunge[collision=1], burst;
  
  faruzan aim:2, skill;
  
  kazuha skill, high_plunge[collision=1];
  
  jean attack, skill;
  
  faruzan aim:3, skill, aim;
  
  kazuha skill, high_plunge[collision=1];
}

