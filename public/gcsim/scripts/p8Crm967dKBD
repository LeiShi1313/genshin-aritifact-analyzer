options swap_delay=12 iteration=1000;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=0]; # default is 100
skirk add weapon="azurelight" refine=1 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
//skirk add set="mh" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
// Need more CR substats due to Furina + Yelan Hydro app vs Cryo Resonance
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

//skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
//skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 +params=[start_energy=0]; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9 +params=[start_energy=0];
yelan add weapon="favbow" refine=3 lvl=90/90;
yelan add set="no" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

escoffier char lvl=90/90 cons=0 talent=9,9,9 +params=[start_energy=0]; 
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="scroll" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.4408 em=39.64 cr=0.3972 cd=0.2648;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=1; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

active furina;
furina attack, skill, dash; # N1 before ED so that Arkhe attack hits the enemy when Furina is on-field for reliable Favonius proc.
escoffier skill, attack:3;  # Catch her own particles
yelan skill, attack:2, dash, attack:2;  # Catch her own particles
skirk skill,
      attack:5, dash,
      
      attack:2, burst,
      
      attack:5, dash,
      attack:5, dash,
      
      attack:2, charge, dash,
      
      attack:5, dash,
      attack:2;
      
furina swap;
print("Skirk E cd (60 FPS) is ", .skirk.skill.cd);
print("Skirk Q cd (60 FPS) is ", .skirk.burst.cd);
for let i=0; i<4; i=i+1 { 
  furina burst, skill, dash;
  escoffier skill, burst;
  yelan skill, attack, burst, attack;
  skirk skill,
        attack:2, burst,
        
        attack:5, dash,
        attack:5, dash,
        attack:5, dash,
        
        attack:2, charge, dash,
        
        attack:5, dash,
        attack:2;
}

# Furina N1 ED > Escoffier E N3 > Yelan E N2D N2  > Skirk tE N5D N2Q 2[N5D] N2CD N5D N2
# Furina Q  ED > Escoffier EQ   > Yelan E N1 Q N1 > Skirk tE     N2Q 3[N5D] N2CD N5D N2 > repeat
