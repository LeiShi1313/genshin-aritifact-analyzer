options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active noelle; # SS stacks

for let i = 0; i < 4; i = i + 1 {

  durin skill, skill, burst;

  fischl attack:2, skill;

  xilonen skill, attack:2;

  noelle skill, burst, attack:3, dash, attack:3, dash, attack:1;

  fischl attack:2, burst;

  xilonen skill, attack:2;

  noelle attack:3, dash, attack:3, dash, attack:3;

  # Durin EEQ > Fischl N2E > Xilonen EN2 > Noelle EQ 2N3D N1 > Fischl N2Q > Xilonen EN2 > Noelle 2N3D N3
} # Combo variations like N3D N2D N1 into N4D N3D N1 or 2N3D N1 into 2N2D N4 result in a slightly higher sim dps
