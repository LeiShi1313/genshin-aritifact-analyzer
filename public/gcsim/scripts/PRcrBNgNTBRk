options swap_delay=12 iteration=1000;

hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="fjords" refine=1 lvl=90/90;
hutao add set="sr" count=4;
hutao add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 cd=0.622; #main
hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbinger" lvl=90/90 refine=5;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
chiori add stats def%=0.434 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5958;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" lvl=90/90 refine=3;
zhongli add set="totm" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

target lvl=100 resist=0.1 hp=99999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active chiori;
for let r=0; r<4; r=r+1 {
    chiori skill:2;
    zhongli attack, skill[hold=1], jump;
    while !.zhongli.mods.favonius-cd {
      zhongli attack;
    }
    yelan attack, skill, attack, burst, attack;
    while !.yelan.mods.favonius-cd {
      yelan attack;
    }
    hutao skill;
    for let j=0; j<9; j=j+1 {
      hutao attack, charge, jump;
    }
    hutao attack;
    yelan attack:4, attack;
}