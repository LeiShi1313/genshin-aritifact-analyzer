# Raiden Chevreuse Fischl Dehya. ~25s Rot. Raiden-Deyha Overload. Easier rotation: Deyha uses her burst, bookended by Fischl skill and burst every rotation, then Raiden uses her burst. HP and DPS Chev are similar.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="deathmatch" refine=1 lvl=90/90;
#chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="gt" count=4;
#chevreuse add set="scroll" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958; # DM
#chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
#chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Fav

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

dehya char lvl=90/90 cons=0 talent=9,9,9;
dehya add weapon="aquamarine" refine=1 lvl=90/90;
#dehya add weapon="mailedflower" refine=5 lvl=90/90;
dehya add set="scroll" count=4;
#dehya add set="gd" count=4;
dehya add stats hp=4780 atk=311 em=187 em=187 em=187; #main
dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=118.92 cr=0.3972 cd=0.331; # DM Chev
#dehya add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # Fav Chev

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;
#hurt every interval=50,60 amount=1000,3000 element=physical;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i = 0; i < 4; i = i + 1{
  chevreuse burst, skill[hold=1]:3;

  fischl attack, skill;

  dehya skill:1, attack; # E N1 for Fischl C6, funnel particles
  dehya burst, skill:10; # Q Punches
  dehya skill; # E

  fischl attack:2, burst;

  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
}
