options swap_delay=12 iteration=1000;

# Build assumptions
flins char lvl=90/90 cons=0 talent=9,9,9;
flins add weapon="deathmatch" refine=1 lvl=90/90;
flins add set="nightoftheskysunveiling" count=4;
flins add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

