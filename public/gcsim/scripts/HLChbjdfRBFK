sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="evenstar" refine=1 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187;
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.6612 em=118.92 cr=0.0662 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active ineffa;
for let i=0; i<6; i=i+1 {
  ineffa skill;
  if !is_even(i) {
    ineffa burst;
  } else {
    ineffa attack;
  }
  mona attack, burst, attack, skill, attack;
  if i && .sucrose.burst.ready {
    sucrose skill, dash, burst, attack;
  } else {
    sucrose skill, dash, attack;
  }
  flins skill, attack,
        skill, attack, burst,
        attack:4, dash, attack:4, dash, attack:2,
        skill, attack, burst,
        attack:4;
  // C1
  // flins skill, attack,
  //       skill, burst,
  //       attack:4, dash, attack:2,
  //       skill, attack, burst,
  //       attack:4, dash, attack:2,
  //       skill, attack, burst,
  //       attack:2;
}
