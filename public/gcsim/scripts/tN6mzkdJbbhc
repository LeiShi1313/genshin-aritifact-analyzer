# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Functions
fn kinich_combo() { # Kinich N2, wait, shE without seeking blindspots, burst immediately after E lands.
  kinich skill;
  while .kinich.nightsoul.state {
    kinich attack[direction=1]:2;
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.state {
      kinich skill[hold=1];
    }
    if .kinich.burst.ready && .kinich.energy == .kinich.energymax  {
      kinich burst;
    }
  }
}

# Rotation
active kinich; # SS Stacks
#kinich burst;

for let i=0; i<4; i=i+1 {
  escoffier skill;
  if i > 0 && .escoffier.burst.ready {
    escoffier burst;
  } else {
    escoffier attack;
  }

  if is_even(i) {
    nicole burst, skill;
  } else {
    nicole attack, skill;
  }

  durin skill:2, burst;

  kinich_combo();
}
