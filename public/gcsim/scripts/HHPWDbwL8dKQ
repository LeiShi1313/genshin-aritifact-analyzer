# Lisa Nahida Fischl Xilonen. ~24s Rot. Lisa On-Field Aggravate using TF to use lisa's hold skill twice in one rotation. The resulting talent damage doesn't justify the precision required to make proper use of the CDR, none to say of practical issues with 2HE. Moreover, Lisa's energy needs are more than cleared without a 2nd hE. Without 2hE, TF isn't even competitive with other sets, even with tE adjusted combos. Nahida hits the field once. Xilonen bursts every rotation after the first. AP Nahida ~= GT Nahida.

# Team - Options listsed by DPS
lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="widsith" refine=3 lvl=90/90;
lisa add set="tf" count=4;
lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
#nahida add set="ap" count=4; # Scammy
nahida add set="gt" count=4;
#nahida add set="tom" count=4;
#nahida add set="scroll" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;
	
xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active lisa;
lisa attack;

for let i=0; i<4; i=i+1 {
  xilonen skill, attack:2;
  if i > 0 {
    xilonen burst;
  }

  nahida skill, attack;
  if .nahida.sets.ap >= 4 {
    nahida dash; pick_up_crystallize("any");
  }
  nahida burst;
  
  fischl skill, attack:2;
  
  lisa attack, burst;
  lisa skill[hold=1], attack, charge, dash:1, attack:3, charge; # end with 2 Aggravates
  
  xilonen skill, attack:2;
  
  fischl attack:2, burst;
  
  lisa attack:2, dash, attack:1;
  lisa skill[hold=1], attack:2, charge, attack:2;
}

