# Klee Furina Yelan Xianyun. ~20s Rot. Klee Double Hydro Vape Plunge. 8 low plunges canceled by N1C, stamina permitting. Klee uses skill again at the end of the rotation if available. 1E Yelan. Klee prefers MH to LNO, less crits cause ER issues for the team from less sparks. 50% Collisions.

# Team - OPtions listed by DPS
klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="mh" count=4;
#klee add set="longnightsoath" count=4;
#klee add set="sr" count=4;
#klee add set="cw" count=4;
klee add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # MH
#klee add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
#klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # LNO
#klee add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
#klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # SR
#klee add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
#klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # CW

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # ToM

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
#yelan add set="no" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
#xianyun add set="no" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Active
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;

  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  xianyun skill, low_plunge, attack, burst;

  klee attack, skill[bounce=3, mine=8], attack;
  let plunges = 0;
  # 8JPN1(C)
  while .xianyun.status.xianyun-airborne-buff {
    klee jump;
    if .airborne {
      klee low_plunge[collision=rand()>0.5];
      plunges = plunges + 1; print(plunges);
    }
    if .xianyun.status.xianyun-airborne-buff { # No N1(C) for the final plunge
      klee attack;
      if .stam > 50 {
        klee charge;
      }
    }
  }
  # Skill if available on the way out
  if .klee.skill.ready {
    if .previous-action == .action.charge {
      klee dash;
    }
    klee skill[bounce=3, mine=8];
  }
}
