# Cyno Furina Yelan Escoffier. ~22s Rot. Physical Cyno N3CD spam, skilling off CD. 2E Yelan.

# Team
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="cpike" refine=5 lvl=90/90;
cyno add set="mh" count=4;
cyno add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.1986 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 er=0.518 atk%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.2204 em=39.64 cr=0.2317 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Cyno Cpike String
fn CynoCpike() {
  switch {
  case .cyno.skill.ready:
    cyno skill;
  case .cyno.normal > 3 && .stam > 43:
    cyno charge, dash;
  case .cyno.normal > 3 && .stam > 18:
    cyno dash;
  default:
    cyno attack;
  }
}

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  escoffier skill, burst;

  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  while !.yelan.skill.ready {
    CynoCpike();
  }

  yelan attack, skill, attack;

  while .yelan.skill.cd > 360 {
    CynoCpike();
  }
}
