# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;
#hurt every interval=300, 450 amount=1000,3000 element=physical; # More incidental damage

# Targets
target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # deals burning AoE, -SS stacks, +Beidou C4
#target lvl=100 resist=0.1 radius=1 pos=0,4.3 hp=100000000; # secondary

# Beidou 25% Perfect Counter, 25% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.75 {
    counter = 2;
  } else if counter > 0.75 && counter <= 0.5 {
    counter = 1;
  }
  else {
    counter = 0;
  }

  return counter;
}

# Rotation
active beidou; # SS Stacks

fischl attack, skill;

for let i=0; i<4; i=i+1 {
  # Forego burst if energy deficient
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  # Fill time
  if i > 0 {
    bennett attack, charge;
  }
  bennett skill, burst;

  amy attack;
  if .amy.skill.ready {
    amy skill;
  } else {
    amy attack, burst; # Catch Sapwood leaf with phased movement
  }

  # Beidou
  while .beidou.mods.bennett-field || .status.bennettburst {
    switch {
      case .beidou.skill.ready:
        beidou skill[counter=rand_counter()];
      case .beidou.burst.ready:
        beidou burst;
      case .beidou.normal > 2 && .beidou.dash.ready && .stam > 18:
        beidou dash;
      default:
        beidou attack;
    }
  }

  bennett skill, attack; # clear Electro & Energy

  print("done");
}
