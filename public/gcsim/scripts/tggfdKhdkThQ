# Freminet Yae Fischl Bennett. ~19s Rot. Physical Freminet double Electro with Bennett. Fischl alternates skill and burst in Bennett burst. All but the final Shattering Pressure are buffed. C6 Bennett is -4K DPS.

# Team - Options ordered by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#freminet add weapon="snowtombed" refine=5 lvl=90/90;
#freminet add weapon="talkingstick" refine=1 lvl=90/90; freminet add stats atk%=0.16; # mock implementation
#freminet add weapon="tidalshadow" refine=5 lvl=90/90;
