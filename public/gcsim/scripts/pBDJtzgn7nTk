# Team
traveleranemo char lvl=90/90 cons=6 talent=9,9,9; 
traveleranemo add weapon="wolffang" refine=1 lvl=90/90;
traveleranemo add set="vv" count=4;
traveleranemo add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
traveleranemo add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.3972 cd=0.5958;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.0662 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; 

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  bennett skill, burst;
  
  # Burst over skill
  amy attack;
  if .amy.burst.ready && .amy.energy == .amy.energymax {
    amy attack, burst;
  } else {
    amy skill;
  }
  
  # Use AMC hE when available, then on-field Bennett
  while .furina.skill.cd {
    switch {
      case .traveleranemo.skill.ready && .traveleranemo.swap.ready:
        traveleranemo skill[hold=1];
      case .traveleranemo.burst.ready && .traveleranemo.swap.ready && .traveleranemo.energy == .traveleranemo.energymax:
        traveleranemo burst;
      case .bennett.skill.ready && .bennett.swap.ready:
        bennett skill;
      case .bennett.attack.ready && .bennett.onfield:
        bennett attack;
      default:
        traveleranemo attack;
    }
  }

}

