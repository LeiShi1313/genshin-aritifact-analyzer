options swap_delay=12 iteration=100;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="solitude" refine=5 lvl=90/90;
yelan add set="mh" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

sigewinne char lvl=90/90 cons=0 talent=9,9,9; 
sigewinne add weapon="recurve" refine=5 lvl=90/90;
sigewinne add set="ap" count=4;
sigewinne add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466 ; #main
sigewinne add stats def=39.36 def%=0.124 hp=2539.4 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.1324 ;										

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

target lvl=100 resist=0.1 hp=10000000 radius=1 pos=0,2;
energy every interval=480,720 amount=1;

active furina;
for let x=0; x<4; x=x+1 {
  furina skill, dash, burst;
  
  xilonen skill, attack:2;
  
  sigewinne skill, attack, dash; pick_up_crystallize("hydro");
  
  yelan burst, attack:3, skill, attack:4, dash, attack;
  
  xilonen skill, attack:2;
  
  while !.xilonen.mods.favonius-cd {
    xilonen attack;
  }
  sigewinne attack:3, dash; pick_up_crystallize("hydro");
  while .yelan.skill.cd > 5 {
    yelan attack;
  }
  
  yelan skill, attack:4;
}
