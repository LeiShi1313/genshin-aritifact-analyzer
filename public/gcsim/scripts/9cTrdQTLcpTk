# Razor Furina Yelan Mika. ~20s Rot. Superconduct and Mika's C6 cover the duration of Razor's field time. Razor Atk > Phys Goblet. Mika Clam > SoDP > NO.

# Team- Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
#razor add weapon="pride" refine=1 lvl=90/90;
#razor add weapon="wgs" refine=1 lvl=90/90;
razor add weapon="uomms" refine=5 lvl=90/90;
#razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#razor add weapon="tidalshadow" refine=5 lvl=90/90;
razor add set="mh" count=4;
#razor add set="echoes" count=4; #Ping Dependence
#razor add set="pf" count=4;
#razor add set="glad" count=4;
#razor add set="ts" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD + ATK; BIS
#razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2979 cd=0.662; # MH + SS; SS BIS
#razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622 ; #main
#razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD + Phys
#razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2979 cd=0.662; # MH + SS
#razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311 ; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # CR + Phys
#razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311 ; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # CR + ATK

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
#furina add set="totm" count=4;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972; # ToM

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
#mika add set="sodp" count=4;
#mika add set="no" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active furina;
#active razor;
#razor skill, dash; Not Required

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  while !.furina.burst.ready && .furina.energy != .furina.energymax {
    furina attack;
  }
  furina burst;

  mika burst;

  yelan skill, burst, attack;

  #mika burst;
  mika skill, attack;

  # Razor out of burst actions; account for energy deficiency
  while !.razor.mods.razor-q {
    if .razor.skill.ready && .razor.burst.ready  && .razor.energy == .razor.energymax {
      razor skill, dash, attack, burst;
    } else if .razor.burst.ready && .razor.energy == .razor.energymax {
      razor burst;
    } else if .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  # Razor Main DPS window;
  while .razor.mods.razor-q > 400 {
  #while !.furina.skill.ready {
    if .razor.normal > 3 && .razor.skill.ready {
        razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}
