# Bennett Furina Xiangling Rosaria. ~20s Rot. Rosaria Furinational with Bennett funneling Xiangling's burst, then on-field skill spam for the rest of the rotation. Rosaria uses burst after XL burst.

# Team
bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
#bennett add weapon="finale" refine=5 lvl=90/90;
bennett add set="cw" count=4;
#bennett add set="no" count=4;
#bennett add set="scroll" count=4;
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # ToM
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # GT

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="catch" refine=5 lvl=90/90;
xiangling add set="emblem" count=4;
xiangling add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
#rosaria add set="no" count=4;
rosaria add set="scroll" count=4;
#rosaria add set="emblem" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 hp=100000000 pos=0,1.4;
#target lvl=100 resist=0.1 hp=100000000 pos=2,0;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;

  bennett burst, skill;

  xl burst, skill, dash;

  rosaria skill, burst;

  bennett attack:2;
  while .furina.skill.cd > 90 {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }

  rosaria skill;
}
