diluc char lvl=90/90 cons=0 talent=9,9,9;
diluc add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
diluc add set="ur" count=4;
diluc add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
diluc add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=5;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;  

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="viridescentvenerer" count=5;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.6612 em=39.64 cr=0.2648 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="sapwoodblade" refine=5 lvl=90/90 +params=[pickup_delay=240];
bennett add set="noblesse" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2648 cd=0.5296;

options swap_delay=12 iteration=100;
target lvl=100 type=icewindsuite[hp_mult=3.75] radius=2 pos=0,2.4; # 12-3 Icewind Suite (375% HP Multiplier).
active diluc; #SS stacks


for let r = 0; r < 2; r = r + 1 { 

  if r==0 || !.emilie.burst.ready {
  emilie skill, attack;
  } else {
  emilie burst;
  }
  
  bennett skill, burst;
  
  xianyun skill, high_plunge, burst;
  
  diluc skill:3;
  
    for let h=0; h<8; h=h+1 { # 8 plunges -- 66% collision rate 
    diluc dash, jump;
    if .airborne {
      diluc high_plunge[collision=rand()>0.3333];
    }
  }
  
  
}
