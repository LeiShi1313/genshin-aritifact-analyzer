options swap_delay=12 iteration=1000;

# Build assumptions
flins char lvl=90/90 cons=0 talent=9,9,9;
flins add weapon="prospectorsshovel" refine=5 lvl=90/90;
flins add set="nightoftheskysunveiling" count=4;
flins add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="fjords" refine=1 lvl=90/90;
ineffa add set="aubadeofmorningstarandmoon" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="silkenmoonsserenade" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.1655 cd=0.662;
//columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2317 cd=0.662; // Pre-C6 Jahoda

jahoda char lvl=90/90 cons=6 talent=9,9,9;
jahoda add weapon="favbow" refine=4 lvl=90/90;
jahoda add set="vv" count=4;
jahoda add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
jahoda add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active ineffa;
for let i=0; i<6; i=i+1 {
  if !is_even(i) {
    ineffa skill, burst;
    columbina skill, attack;
  } else {
    ineffa skill;
    if i {
      ineffa attack;
      columbina attack;
    }
    columbina skill, burst;
  }

  jahoda skill;

  flins skill, attack,
        skill, attack, burst,
        attack:4, dash, attack:4, dash, attack:2,
        skill, attack, burst,
        attack:2;
  if !is_even(i) {
    flins dash;
  }
  jahoda burst, attack; // Q alone hits the swap cd
}

# Ineffa E  > Columbina N1 E Q > Jahoda E > Flins E N1 E N1 Q 2[N4D] N2 E N1 Q N2  > Jahoda Q N1
# Ineffa EQ > Columbina E N1   > Jahoda E > Flins E N1 E N1 Q 2[N4D] N2 E N1 Q N2D > Jahoda Q N1
