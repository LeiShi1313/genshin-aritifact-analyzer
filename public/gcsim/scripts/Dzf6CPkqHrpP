xiangling add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.331 cd=0.2648 ;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622 ; #main
emilie add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296 ;

options swap_delay=12 debug=true iteration=1000;


active yae;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
 yae skill:3;
for let i=0; i<4; i=i+1 {

  if i {
    yae attack, skill, attack, skill, attack, skill;
  }

  if i {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  xiangling burst, skill, dash;

  fischl skill, attack;

  yae attack:1, charge, dash,
      burst, skill, attack, skill, attack, skill,
      attack:2, charge, dash,
      attack:2, charge, jump,
      attack:1;

  fischl attack:2, burst;

  xiangling skill, attack;

  yae attack:2, charge, jump,
      attack:2, charge, jump;

}
yae attack;
