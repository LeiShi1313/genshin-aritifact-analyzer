# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 hp=100000000 pos=0,2;
#target lvl=100 resist=0.1 hp=100000000 pos=2,0;

# Rotation
active faruzan;

for let i=0; i<4; i=i+1 {
  
  faruzan skill, burst;
  
  bennett burst, skill;
  
  xl burst, skill, dash;
  
  traveleranemo skill[hold=1], burst;

  faruzan aim[weakspot=rand()>0.1]:2, skill, aim[weakspot=rand()>0.1]:2;
  
  bennett skill, attack;
  
  traveleranemo skill[hold=1];
 
  bennett skill;
  
}

