# Varesa Chevreuse Durin Xiangling. ~21s Rot. KQMS KurtC. Varesa Overload with 7 plunges. Scroll Surpases LNO for Team DPS. Durin Feeds Particles to Xiangling.

# Team - OPtions listed by DPS.
varesa char lvl=90/90 cons=0 talent=9,9,9;
varesa add weapon="widsith" refine=3 lvl=90/90;
varesa add set="scroll" count=4;
#varesa add set="lno" count=4;
#varesa add set="tf" count=4;
