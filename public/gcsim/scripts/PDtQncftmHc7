# Noelle Albedo Yelan Furina. ~21s Rotation. AP Noelle dashes to pick up crystallize. 2*E Yelan. MH Noelle option in config. 

noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
noelle add set="ap" count=4;
#noelle add set="mh" count=4;
noelle add stats hp=4780 atk=311 def%=0.583 def%=0.583 cd=0.622 ; #main
noelle add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296 ; # AP
#noelle add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622 ; #main
#noelle add stats def=39.36 def%=0.186 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2979 cd=0.662 ; # Husk

albedo char lvl=90/90 cons=0 talent=9,9,9; 
albedo add weapon="cinnabarspindle" refine=5 lvl=90/90;
albedo add set="gt" count=4;
#albedo add set="husk" count=4;
albedo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
albedo add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9; 
yelan add weapon="favoniuswarbow" refine=3 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662 ;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.640 cr=0.3972 cd=0.6620;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active albedo;

for let x=0; x<4; x=x+1 {
  if x==0 {
    albedo skill;
  } else {
    albedo attack, skill;
  }
  
  furina skill, dash, burst;
  
  yelan burst, attack, skill, attack;
  
  # Noelle burst opening
  noelle skill, attack, burst;
  pick_up_crystallize("hydro");
  # Noelle driving rotation
  while !.yelan.skill.ready {
    if .noelle.normal > 3 {
        noelle dash;
        pick_up_crystallize("hydro");
    } else {
      noelle attack;
    }
  }
  
  # Essential 2nd Yelan E
  yelan skill, attack;
  
  # Cover cooldowns; increase rot DMG
  noelle attack:4;
  pick_up_crystallize("hydro");
  
  # Notation
  # Albedo E/N1E > Furina EDQ > Yelan QN1EN1 > 
  # Noelle EN1Q 2N3D N3 > Yelan EN1 > Noelle N4D
}
