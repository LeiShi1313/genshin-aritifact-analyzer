# Arlecchino Chevreuse Ineffa Bennett. ~16s Rot. Overload Arlecchino w/ a shielder. Arlecchino 3N3C 2N3D N3. Ineffa snapshots Bennett's attack buff to her shield while building EM for significant reaction damage. No burst Chevreuse/Arlecchino/Ineffa.

# Team
arlecchino char lvl=90/90 cons=0 talent=9,9,9;
arlecchino add weapon="deathmatch" refine=1 lvl=90/90;
arlecchino add set="fohw" count=4;
arlecchino add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
arlecchino add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=5 lvl=90/90;
chevreuse add set="scroll" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*5 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*9;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="dbane" refine=3 lvl=90/90;
ineffa add set="tom" count=4;
ineffa add stats hp=4780 atk=311 em=187 em=187 em=187; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*10 cd=0.0662*10;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active arlecchino;

for let i=0; i<4; i=i+1 {
  arlecchino skill, attack;

  bennett skill, dash, burst;

  ineffa attack, skill;

  chevreuse skill[hold=1], attack;

  arlecchino attack, charge,
             attack:3, charge,
             attack:3, charge,
             attack:3, charge,
             attack:3, dash,
             attack:3, dash,
             attack:3;
}
