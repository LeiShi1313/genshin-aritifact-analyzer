target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=100;

#-------------------------------------------- 

active furina;
furina skill, dash, burst;
for let i=0; i<4; i=i+1 {
  if i {
    furina burst, skill, attack;
  }
  lynette burst, attack;
  chev skill[hold=1], burst;
  lynette skill;
  klee attack, burst, walk, attack[travel=6], charge;
  if !i {
    klee attack[travel=6], charge, attack, skill[bounce=3, mine=8], jump;
  }
  klee attack[travel=6], charge, attack, skill[bounce=3, mine=8], jump;
  for let r = 5; r> 0; r = r - 1 {
    klee attack[travel=6], charge, jump; # 5N1C
  }  
  klee attack;
  lynette skill, attack;
}

