#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ATK/Cd

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="hakushin" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.2979 cd=0.331;


# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active dori;
dori skill, attack;

for let i=0; i<4; i=i+1 {
  if i > 0 {
    dori skill, attack:2, dash, attack:2;
  }
  
  sucrose burst, attack;
  
  fischl attack:2, burst;
  
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  
  sucrose attack:2, charge;
  
  dori skill, attack:2, dash, attack:2, burst;
  
  sucrose attack:2, charge, attack, skill, dash, attack;
  
  fischl attack, skill;
  
  nahida attack:2, charge;
  
  dori skill, attack:2, dash, attack:2;
  
  sucrose skill, dash, attack:2, charge, attack:2, charge;
  print("done");
}
