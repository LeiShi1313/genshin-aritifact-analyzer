nahida add stats hp=4780 atk=311 em=186.5 dendro%=0.466 cr=0.311 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=138.74 cr=0.331 cd=0.4634;

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="kitain" refine=5 lvl=90/90;
thoma add set="gd" count=4;
thoma add stats hp=4780 atk=311 em=186.5 em=186.5 em=186.5; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.6612 em=118.92 cr=0.0662 cd=0.1324;

active nahida;
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=3 pos=0, 3.4 hp=100000000;
energy every interval=480,720 amount=1;

for let i = 0; i < 4; i = i + 1 {
  nahida skill, attack, burst;
  kokomi attack, skill;
  thoma skill, attack, burst;
  fischl attack, skill;
  kokomi attack, burst,
    attack:2, walk,
    attack:2, walk,
    attack:2, walk,
    attack:2, walk,
    attack:2, walk,
    attack:2, walk,
    attack:2, walk,
    attack:2, walk,
    attack:2;
  fischl attack:2, burst;
  kokomi attack:2, walk,
    attack:2, walk,
    attack:2, walk,
    attack:2, walk,
    attack:2;
  print("done");
}
