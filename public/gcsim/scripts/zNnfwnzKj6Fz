# Keqing Chevreuse Mavuika Bennett. ~18s Rot. Electro Keqing Overload. Keqing Spams N1C during and out of Bennett burst. Keing leads with EE in the first rotation for Chev A1. DPS Chevreuse bursts every rotation in Bennett Q. C6 Bennett is DPS Neutral; Pyro & Electro Goblet see similar performance.

# Team- Options listsed by DPS
keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="finale" refine=5 lvl=90/90;
keqing add set="fohw" count=4; # Finale
#keqing add set="tf" count=2;keqing add set="glad" count=2;
keqing add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # Electro
#keqing add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # Pyro

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="gt" count=4;
chev add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#mav add weapon="tidalshadow" refine=5 lvl=90/90;
mav add set="scroll" count=4;
mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; 

# Rotation
active mav; # SS Stacks

keqing skill:2; # Chev A1

for let i=0; i<4; i=i+1 {
  bennett skill, burst;
  
  chev burst, skill[hold=1]:2;
  
  if .mav.burst.ready {
    mav burst, skill, dash;
  } else {
    mav attack, skill;
  }
  
  keqing skill, burst, skill,
        attack, charge,
        attack, charge,
        attack, charge,
        attack, charge,
        attack, charge;
  
  bennett skill;
  
  keqing skill:2,
        attack:2, charge;
}
