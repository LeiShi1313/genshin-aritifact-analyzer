xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=99.24 atk%=0.3968 er=0.4959 em=99.1 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 hp=100000000 pos=0,1.4;
#target lvl=100 resist=0.1 hp=100000000 pos=2,0;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  xq skill, dash, burst, attack;
  
  xianyun skill, low_plunge, attack, burst;
  
  candace skill, attack, burst, attack;
  
  furina attack;
  for let p=0; p<8; p=p+1 {
    if .furina.status.xianyun-airborne-buff {
      furina jump;
      if .airborne {
        furina high_plunge[collision=1];
        if p < 8 {
          furina attack;
        }
      }
    }
  }
  
}

