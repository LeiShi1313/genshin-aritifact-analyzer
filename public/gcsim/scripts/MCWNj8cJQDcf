//durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;  // C4 Mona

mona char lvl=90/90 cons=2 talent=9,9,9;
mona add weapon="favcodex" refine=3 lvl=90/90;
mona add set="cg" count=4;
mona add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
mona add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;


# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active arle;
for let i=0; i<4; i=i+1 {

  arlecchino skill;
  durin skill, skill, burst;
  if is_even(i) {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  mona attack, burst, attack, dash, attack;
  arlecchino charge,
             attack;
  mona skill, dash, attack;
  arlecchino attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:2;
}
