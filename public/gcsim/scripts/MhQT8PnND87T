sara add weapon="chainbreaker" refine=5 lvl=90/90;
sara add set="noblesse" count=4;
sara add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

luminepyro char lvl=90/90 cons=6 talent=9,9,9;
luminepyro add weapon="xiphos" refine=1 lvl=90/90;
luminepyro add set="scroll" count=4;
luminepyro add stats hp=4780 atk=311 em=187 em=187 em=187;
luminepyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.331 cd=0.2648;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.1324;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    //} else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
    //  varesa jump;
    //  if .airborne {
    //    varesa high_plunge[collision=1]; # JP
    //  }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

active varesa;

varesa_combo(1);
chevreuse burst, skill[hold=1];
travelerpyro skill, burst;
sara skill, burst;
varesa_combo(2);
sara aim;
varesa_combo(4);

for let i=0; i<3; i=i+1 {
  chevreuse skill[hold=1];
  if .chevreuse.burst.ready {
    chevreuse burst;
  }
  travelerpyro skill, attack, burst;
  sara skill;
  if .sara.burst.ready {
    sara burst;
  } 
  varesa_combo(2);
  sara aim;
  varesa_combo(4);
}

# ~19s rotations
# Rotation 1: Varesa 1 Plunge Combo > Chevreuse Q hE > Pyro Traveler E Q > Sara E Q > Varesa 2 Plunge Combos > Sara C > Varesa 4 Plunge Combos
# Rotation 2+: Chevreuse hE(Q) > Pyro Traveler E N1 Q > Sara E (Q) > Varesa 2 Plunge Combos > Sara C > Varesa 4 Plunge Combos