options swap_delay=12 iteration=1000;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="widsith" refine=5 lvl=90/90;
columbina add set="notsu" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=5 lvl=90/90;
fischl add set="deepwood" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="etherlight" refine=5 lvl=90/90;
lauma add set="sms" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*6 cr=0.0331*8 cd=0.0662*2;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacfrags" refine=5 lvl=90/90;
sucrose add set="ins" count=4;
sucrose add stats hp=3571 atk=232 em=139 em=139 em=187;
sucrose add stats def%=0.052*2 def=16.53*2 hp=213.31*2 hp%=0.0417*2 atk=13.89*2 atk%=0.0417*2 er=0.0463*10 em=16.65*6 cr=0.0278*2 cd=0.0556*2;

active lauma;
target lvl=100 resist=0.1 radius=4 pos=0,4.4 hp=999999999;
energy every interval=480,720 amount=1;

lauma attack;
for let i=0; i<5; i=i+1 {
  if .columbina.burst.ready {
    columbina burst;
  }
  if i == 0 {
    columbina skill, attack;
  } else {
    columbina skill;
  }

  if .fischl.skill.ready{
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }

  if .sucrose.burst.ready {
    sucrose burst;
  }
  if .sucrose.skill.ready {
    sucrose attack, skill, dash, attack;
  } else {
    sucrose attack:2;
  }

  lauma attack, skill[hold=.dew>0], burst;
  columbina attack, charge, dash, charge, dash, charge;

  if .sucrose.skill.ready {
    sucrose attack, skill, dash, attack;
  } else {
    sucrose attack:2;
  }

  columbina attack, charge, dash;

  if .columbina.skill.cd > 270 {
    columbina attack, charge, dash, charge, dash, charge;
  } else {
    columbina charge, dash, charge, charge;
  }
}
columbina dash, attack; // give time for the last CA's damage to land
