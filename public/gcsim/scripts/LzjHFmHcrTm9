# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # 2nd T

# Rotation
active kokomi;

for let i = 0; i < 4; i = i + 1 {
  kokomi skill;
  
  # No burst, the burgeon trigger is off-field
  nahida skill, attack, charge; 
  
  furina skill, dash, burst;
  
  if .mav.burst.ready {
    mav burst, dash, charge, skill, dash;
  } else {
    mav attack, skill;
  }
  
  kokomi attack, burst;
  while .status.kokomiburst {
    if .kokomi.normal > 2 {
      kokomi walk;
    } else {
      kokomi attack;
    }
  }
  
  # Just attempting to trigger Fav
  nahida attack:2, charge; 
  
  # Kokomi and Nahida are similar here
  while .kokomi.skill.cd {
    if .nahida.normal > 2 {
      nahida walk;
    } else {
      nahida attack;
    }
  }
  print("done");
}

