options swap_delay=12 iteration=1000;

# Build assumptions
wanderer char lvl=90/90 cons=6 talent=10,10,10; 
wanderer add weapon="cashflow" refine=5 lvl=90/90;
wanderer add set="mh" count=4;
wanderer add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622;
wanderer add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

faruzan char lvl=90/90 cons=6 talent=10,10,10; 
faruzan add weapon="elegy" refine=5 lvl=90/90 ;
faruzan add set="scroll" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311;
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.2204 em=39.64 cr=0.331 cd=0.7282;

furina char lvl=90/90 cons=6 talent=10,10,10; 
furina add weapon="splendoroftranquilwaters" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=10,10,10;
bennett add weapon="skywardblade" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active faruzan;

for let i = 0; i < 4; i = i + 1  {
  faruzan burst;
  furina skill, dash, burst, attack:2;
  bennett skill, burst;
  wanderer attack, skill;
  while .wanderer.skydweller-points > 12 {
    if .wanderer.normal == 3 && .wanderer.mods.wanderer-a4 {
      wanderer dash;
    } else {
      wanderer attack;
    }
  }
  if .wanderer.burst.ready { 
    wanderer burst;
  }
  if .wanderer.mods.windfavored-state {
    wanderer skill;
  }
  bennett skill;
}
