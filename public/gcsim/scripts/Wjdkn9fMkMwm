#team config

chiori char lvl=90/90 cons=6 talent=9,9,9;
chiori add weapon="uraku" refine=5 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=0];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; # main
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3310 cd=0.7944;

navia char lvl=90/90 cons=6 talent=9,9,9;
navia add weapon="verdict" refine=5 lvl=90/90;
navia add set="nighttime" count=4;
navia add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; # main
navia add stats atk=33.08 atk%=0.1984 hp=507.88 hp%=0.0992 cr=0.3972 cd=0.662 em=39.64 er=0.1102 def=39.36 def%=0.124;

yelan char lvl=90/90 cons=6 talent=9,9,9;
yelan add weapon="aqua" refine=5 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.518 hydro%=0.466 cr=0.311 ; #main
yelan add stats atk=33.08 atk%=0.0992 hp=507.88 hp%=0.0992 cr=0.331 cd=0.5958 em=39.64 er=0.3857 def=39.36 def%=0.124;

furina char lvl=90/90 cons=6 talent=9,9,9;
furina add weapon="splendor" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;


#enemy config

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=90000000;
energy every interval=480,720 amount=1;

active chiori;
chiori skill:2;
#action list
for let x=0; x<4; x=x+1 {
  navia burst;

  furina skill, attack, burst, attack;

  yelan burst;
  yelan attack, skill, attack, skill, attack:2;

  navia skill[hold=1], attack:3, dash;
  navia skill[hold=1], attack:3, dash;

  if .chiori.burst.ready && .chiori.energy == .chiori.energymax {
    chiori burst;
  }
  chiori skill, attack;
  chiori attack:3, dash, attack:3, dash;
  chiori skill:2;
}
