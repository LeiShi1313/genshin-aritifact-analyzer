# Yanfei Furina Yelan Bennett. ~20s Rot. Yanfei double Hydro Vape with 1xE Yelan. Yanfei bursts every other rotation. Yanfei receieves all healing. 1E Bennett.

# Team
yanfei char lvl=90/90 cons=6 talent=9,9,9;
yanfei add weapon="widsith" refine=3 lvl=90/90;
yanfei add set="mh" count=4;
yanfei add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311 ; #main
yanfei add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.2648 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
#furina add set="gt" count=4;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="esf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
#bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.2648 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

#Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
	
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  }
  yelan burst, attack;
  
  bennett burst, skill;
  
  yanfei attack, skill, attack;
  if .yanfei.burst.ready {
    yanfei burst;
  } #else {
    #yanfei charge;
  #}
  while !.furina.skill.ready {
    if .yanfei.skill.ready && .yanfei.mods.yanfei-a1 && .previous-action == .action.attack {
      yanfei skill;
    } else if .yanfei.mods.yanfei-seal && .stam > 25 && .previous-action == .action.attack {
      yanfei charge;
    } else {
      yanfei attack;
    }
  }
	
}

