# - Characters

lyney char lvl=90/90 cons=0 talent=9,9,9;
lyney add weapon="crescent" refine=5 lvl=90/90;
lyney add set="mh" count=4;
lyney add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
lyney add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="ap" count=4;
#bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

zhongli char lvl=90/90 cons=0 talent=9,9,9; 
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
#zhongli add set="ap" count-4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

venti char lvl=90/90 cons=0 talent=9,9,9;
venti add weapon="favbow" refine=4 lvl=90/90;
venti add set="vv" count=4;
venti add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
venti add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

# - Options

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
let weak = 1; # Set to 0 if using weapon other than crescent or if you just don't hit weakspots

# - Targets

target lvl=100 resist=0.1 radius=1.5 pos=0,2.5 hp=9999999;
#target lvl=100 resist=0.1 radius=1.5 pos=2.5,0.5 hp=9999999;

# - Actions

active lyney;

for let i=0; i<5; i=i+1 { 
  lyney aim[weakspot=weak];
  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  bennett skill, burst, dash;
  pick_up_crystallize("pyro");
  venti skill, burst;
  while !.venti.mods.favonius-cd {
    venti attack;
  }
  lyney aim[weakspot=weak], aim, aim, burst;
  delay(11); # Wait for burst initial hit hitmark
  lyney skill, skill;
}
#Lyney Mono with shielding and crowd control: Lyney, Bennett, Zhongli, Venti. Lyney 4CA rotation with Bennett holding petra for better uptime. Venti prefers EM mainstats with more targets.
#Rotation: Lyney C, Zhongli hE D (NA until fav proc), Bennett E Q D (pick up pyro crystal), Venti E Q (NA until fav proc), Lyney 3C Q E E
#Fishing for favonius procs is unnecessary if Bennett and Venti have enough ER to sustain multiple rotations without it.