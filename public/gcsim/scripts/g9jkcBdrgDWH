options iteration=1000 swap_delay=12;                                                                       
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

fn WaitForCryo() {
  let StartFrame = f();
  if !.element.t0.pyro {      # If the enemy aura is not Pyro, wait for Cryo aura (so if its already Pyro you don't wait)
    while !.element.t0.cryo && f() - StartFrame < 120 {   # wait but up to 120f(2s), so you don't wait forever
      wait(1);
    }
  }
}

active mav;


for let i = 0; i < 4; i = i + 1 {
  
  mav skill, attack;
  
  
  xilonen skill, attack:2; pick_up_crystallize("pyro");
  
  if !i {
    citlali skill, attack;
  } else {
    citlali skill, burst, attack;
  }
  
  mav burst;
  WaitForCryo();
  mav charge:3, dash, charge:3; 
  
  clorinde_combo();
  if .clorinde.burst.ready {
    clorinde burst;
  }
  
}

