options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 hp=100000000 radius=1 pos=0,2.4;
energy every interval=480,720 amount=1;

active yae;

for let x = 0; x < 3; x = x + 1 {
  yae skill:3;
  nahida skill, burst;
  furina skill, dash, burst;
  dori skill, burst, attack:2;
  yae attack,
      burst, skill:3,
      attack, charge, dash;
  nahida skill, attack, charge;    
  dori skill, attack;
  yae attack:2, charge, jump;
  nahida skill, attack, charge;
  yae attack:2, charge, jump;
  dori skill, attack;
  print("Rotation Done");
}
yae attack;