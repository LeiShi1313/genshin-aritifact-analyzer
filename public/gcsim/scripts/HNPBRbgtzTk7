# Lynette Emilie Faruzan Bennett. ~20s Rot. Burning on-field Lynette. Emilie burst every other rot. Bennett and Faruzan use skill and aimed shots between Lynette's skill uses. C6 Bennett is -2K DPS.

# Team
lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="finale" refine=5 lvl=90/90;
#lynette add weapon="wolffang" refine=1 lvl=90/90;
lynette add set="ur" count=4;
#lynette add set="mh" count=4;
lynette add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # Finale / UR
#lynette add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622 ; #main
#lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # WF / UR
#lynette add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622 ; #main
#lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # Finale / MH

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622 ; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90;
faruzan add set="deepwood" count=4;
#faruzan add set="ur" count=4;
#faruzan add set="gt" count=4;
#faruzan add set="vv" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active emilie;

for let i = 0; i < 4; i = i + 1 {
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  
  bennett skill, burst;
  
  faruzan skill, burst;
  
  lynette burst, skill, 
  attack:2, charge, 
  attack:2, charge,
  attack;
  
  bennett skill;
  
  faruzan aim:2;
  
  # Catch the tail of Bennett Buff
  lynette skill, attack, charge, # C5 Bennett
  #lynette attack, charge, skill, # C6 Bennett
  attack, charge,
  attack, charge,
  attack, charge;

}

