bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="instructor" count=4;
bennett add stats hp=3571 atk=232 er=0.518 cr=0.232 pyro%=0.348 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.2317 cd=0.4634;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,3;
energy every interval=480,720 amount=1;

active furina;

for let r = 4; r > 0; r = r - 1 {

  if !.bennett.burst.ready {bennett skill;}
  furina skill, burst; 
  bennett skill, burst, attack;
  kazuha skill, high_plunge;
  lyney aim[weakspot=1], aim, aim;
  lyney burst; 
  lyney skill;
  lyney aim, skill, aim[weakspot=1];

}

sleep(9); # Until final aim hitmark