let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
    pick_up_crystallize("any"); # Pick up crystallize before every dash
  }

  return _execute_action(char_id, action_id, p);
}

options swap_delay=12 iteration=1000;

# Build assumptions
navia char lvl=90/90 cons=6 talent=10,10,10;
navia add weapon="verdict" refine=5 lvl=90/90;
navia add set="nighttime" count=5;
navia add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
navia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="splendoroftranquilwaters" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

xilonen char lvl=90/90 cons=6 talent=10,10,10;
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=10,10,10;
bennett add weapon="skywardblade" refine=5 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1655 cd=0.7282;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active navia;

navia burst; # to make 1st navia E to get 6 shrapnel
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst, attack:2;
  xilonen skill, attack:2;
  if i {
    navia burst;
  }
  bennett skill, burst;
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  xilonen skill, attack:2;
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack;
  if .navia.skill.ready {
    navia skill[hold=1], attack; # in the 1st and 4th rot, use another Navia E
  } else {
    navia attack; # otherwise
  }
}
