# Rosaria Furina Fischl Escoffier. ~22s Rotation. Physical Rosaria does N3CD stamina permitting, otherwise does NA spam. Rosaria uses skill 3 times, passing the final skill particles to Furina.

# Team - Options listed by DPS
rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="cpike" refine=5 lvl=90/90;
rosaria add set="mh" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; # main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.4408 em=39.64 cr=0.0993 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active fischl;
fischl skill;

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.burst.ready || !.furina.mods.favonius-cd) {
    furina attack;
  }
  furina burst;

  esco skill, burst;

  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }

  rosaria skill, burst;
  # N3CD combo + skill when available
  let rosariaSkills = 0;
  while rosariaSkills < 2 {
    if .rosaria.skill.ready {
      rosaria skill;
      rosariaSkills = rosariaSkills + 1;
    } else if .rosaria.normal > 3 && .stam > 43 {
      rosaria charge, dash;
    } else {
      rosaria attack;
    }
  } # Ends on 3rd Rosaria skill
}
