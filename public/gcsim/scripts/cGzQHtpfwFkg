baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="hakushin" refine=5 lvl=90/90;
baizhu add set="scroll" count=4;
#baizhu add set="ohc" count=4;
#baizhu add set="sodp" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=237.84 cr=0.0662 cd=0.2648;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  baizhu skill, burst;
  
  sara skill, aim;
  
  amy attack:2, burst;

  sara burst;
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  
  while .baizhu.burst.cd > 40 {
    if .amy.skill.ready {
      amy attack, skill;
    }
    baizhu attack;
  }

}

