clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main 5* set
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="favsword" refine=3 lvl=90/90;
kirara add set="deepwood" count=4;
kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
kirara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="goldentroupe" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.1986 cd=0.7944;

kuki char lvl=90/90 cons=6 talent=9,9,9; # start_hp=5000;
kuki add weapon="xiphos" refine=1 lvl=90/90;
kuki add set="gd" count=4;
kuki add stats hp=4780 atk=311  em=187  em=187  em=187  ; #main
kuki add stats def=39.36 def%=0.124 hp=507.88 hp%=0.5952 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.2648 cd=0.1324 ; # liquid - 10 hp% 4 em 6 cr

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 pos=0,1.4 radius=1;
energy every interval=480,720 amount=1;

let isClorindeSkillOnCD = 0; # When using Kirara burst, rotation will leave ~0.6s on Clorinde E cd

active clorinde;
clorinde burst;
for let i=0; i<5; i=i+1 {
  kirara skill[short_hold=1];
  if .furina.skill.ready {
  furina skill, dash, attack, burst;
  } else {
    furina attack:2, burst;
  }
  if isClorindeSkillOnCD == 0 {
    kuki skill, dash, attack;
  } else {
    kuki skill, dash, attack, burst;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  if .clorinde.burst.ready && .clorinde.energy == .clorinde.energymax {
    isClorindeSkillOnCD = 0;
    clorinde burst;
  } else {
    isClorindeSkillOnCD = 1;
    kirara burst;
  }
}