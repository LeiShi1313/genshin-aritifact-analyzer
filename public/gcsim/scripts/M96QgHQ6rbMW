# Rosaria Furina Yunjin Mika. ~22s Rotation. Physical Rosaria NA spam with rotation utilizing the entire Yunjin Quota.

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="cpike" refine=5 lvl=90/90;
rosaria add set="mh" count=4;
#rosaria add set="bs" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; # main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.4634; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.4634; # ToM

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="footprintoftherainbow" refine=5 lvl=90/90;
yunjin add set="husk" count=4 +params=[stacks=4];
#yunjin add set="no" count=4;
yunjin add stats hp=4780 atk=311 er=0.518 def%=0.583 def%=0.583 ; #main
yunjin add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=158.56 cr=0.0662 cd=0.1324;


mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
#mika add weapon="rightfulreward" refine=5 lvl=90/90;
mika add set="clam" count=4;
#mika add set="sodp" count=4;
#mika add set="no" count=4;
mika add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.331 cd=0.331;


# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;

  mika burst;

  rosaria skill, burst;

  yunjin skill, burst;

  mika skill[hold=1];

  #Exhausts Yunjin quota
  rosaria attack;
  while .rosaria.mods.mika-c6 || .rosaria.mods.yunjin-c6 {
    if .rosaria.skill.ready {
      rosaria skill;
    } else {
      rosaria attack;
    }
  }

# Notation
# Furina EDQ > Mika Q > Rosaria EQ > Yunjin EQ > Mika E
# Rosaria N2 E 2N5 E 2N5
}
