# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active dori; #SS Stacks

for let i=0; i<4; i=i+1 {
  dori skill, burst;
  
  kazuha burst;
  
  fischl attack:2, burst;
  
  nahida skill, attack, burst;
  
  dori skill, attack:2, dash, attack:2;
  
  kazuha skill, high_plunge;
  
  nahida skill, attack, charge;
  
  fischl attack, skill;
  
  dori skill, attack:2, dash, attack:2;
  
  kazuha skill, high_plunge;
  
  dori skill, attack:2, dash, attack:2;
  
  nahida skill, attack, charge;
