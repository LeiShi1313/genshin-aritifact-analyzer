# Heizou Nahida Fischl Beidou. ~24s Rot. Full EM on-field Heizou in 2-target with Beidou, Aggravate swirling and bursting twice per rotation to heal the team. 20% Counter, 20% Perfect Counters.

# Team
heizou char lvl=90/90 cons=6 talent=9,9,9;
heizou add weapon="pamber" refine=5 lvl=90/90;
#heizou add weapon="favcodex" refine=3 lvl=90/90;
heizou add set="vv" count=4;
heizou add stats hp=4780 atk=311 em=187 em=187 em=187; # main
heizou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=118.92 cr=0.3641 cd=0.2648;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
#nahida add weapon="hakushin" refine=5 lvl=90/90;
nahida add set="gt" count=4;
#nahida add set="deepwood" count=4;
#nahida add set="tom" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958; # Evenstar
#nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662; # Hakushin

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

beidou char lvl=90/90 cons=6 talent=9,9,9;
beidou add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
beidou add set="eosf" count=4;
beidou add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
beidou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

# Beidou 20% Perfect Counter, 20% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.80 {
    counter = 2;
  } else if counter > 0.6 && counter <= 0.80 {
    counter = 1;
  }
  else {
    counter = 0;
  }

  return counter;
}

# Rotation
active beidou; # SS Stacks

for let i=0; i<4; i=i+1 {
  fischl skill, attack;

  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }

  beidou skill[counter=rand_counter()], burst;

  heizou attack, charge, burst, skill, attack, charge, attack, charge;

  fischl attack:2, burst;

  nahida skill, attack, charge;

  beidou skill[counter=rand_counter()], attack:2;

  while .fischl.skill.cd > 30 {
    if .heizou.skill.ready && .heizou.declension == 4 {
      heizou skill;
    } else if .heizou.normal > 1 && .heizou.burst.ready && .heizou.declension != 4 {
      heizou burst;
    } else if .heizou.normal > 1 {
      heizou charge;
    } else {
      heizou attack;
    }
  }

}
