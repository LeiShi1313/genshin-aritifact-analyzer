ningguang char lvl=90/90 cons=6 talent=9,9,9;
ningguang add weapon="widsith" refine=3 lvl=90/90;
ningguang add set="nighttime" count=4;
ningguang add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311;
ningguang add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

gorou char lvl=90/90 cons=6 talent=9,9,9;
gorou add weapon="favoniuswarbow" refine=4 lvl=90/90;
gorou add set="no" count=4;
gorou add stats hp=4780 atk=311 def%=0.583 def%=0.583 heal=0.359;
gorou add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.3972;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2648 cd=0.7282;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="cinnabar" refine=5 lvl=90/90;
chiori add set="gt" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=100;
options swap_delay=12;
options duration=90;
energy every interval=480,720 amount=1;

let normal_attack_state = 1;
let c_left = 0;
let c_twirl = 2;
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || action_id == .action.walk {
    pick_up_crystallize("any"); # Pick up crystallize before every dash
  }
  return _execute_action(char_id, action_id, p);
}
# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0;

# Rotation
active furina;
for {
  switch {
    case .furina.skill.ready && .furina.swap.ready:
      furina skill, dash, burst;
    case .gorou.burst.ready && .gorou.swap.ready:
      gorou burst;
    case .chiori.skill.ready && .chiori.swap.ready:
      chiori skill:2;
    case .gorou.skill.ready && .gorou.swap.ready:
      gorou skill, attack;
    case .ningguang.skill.ready && .ningguang.swap.ready:
      ningguang skill, dash;
    case .ningguang.burst.ready && .ningguang.swap.ready:
      ningguang burst, walk;
    case .ningguang.jadeCount == 7 && .ningguang.swap.ready:
      ningguang charge;
    case .ningguang.onfield && .state == normal_attack_state:
      if .ningguang.prevAttack == c_left || .ningguang.prevAttack == c_twirl {
        ningguang charge;
      } else {
        ningguang walk;
      }
    case .chiori.burst.ready && .chiori.swap.ready:
      chiori burst;
    default:
      ningguang attack;
  }
}
