# Neuvillette Lauma Durin Ineffa. ~27s Rot. Neuvillette making a mess of reactions behind a shield. 4 CA Neuvillette. 1tE, 1hE Lauma 2E Light Durin, &  Ineffa alternate skill and burst to fit the rotation. No burst Lauma.

# Team
neuv char lvl=90/90 cons=0 talent=9,9,9;
neuv add weapon="sacjade" refine=1 lvl=90/90;
neuv add set="mh" count=4;
neuv add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
neuv add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*6 cd=0.0662*10;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="evenstar" refine=1 lvl=90/90;
lauma add set="deepwood" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="xiphos" refine=1 lvl=90/90;
durin add set="fopl" count=4;
durin add stats hp=4780 atk=311 em=187 em=187 em=187; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*2 em=19.82*6 cr=0.0331*8 cd=0.0662*2;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="kitain" refine=5 lvl=90/90;
ineffa add set="sms" count=4;
ineffa add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*2 em=19.82*3 cr=0.0331*11 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=0,1.9 hp=999999999;
#target lvl=100 resist=0.1 radius=1.5 pos=0,5 hp=999999999;

# Rotation
active neuv;

for let i=0; i<4; i=i+1 {
  neuv skill;

  ineffa burst;

  lauma skill[hold=.dew>0];

  durin skill, burst, skill;

  neuv charge, burst, skill, charge;

  ineffa skill, attack;

  lauma skill[hold=1];

  durin skill:2;

  neuv charge, charge;
}
wait(173);
