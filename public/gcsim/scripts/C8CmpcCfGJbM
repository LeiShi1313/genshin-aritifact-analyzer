xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="flowingpurity" refine=5 lvl=90/90;
xianyun add set="ohc" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.551 em=39.64 cr=0.0662 cd=0.1324 ;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active faruzan;
for let i=0; i<4; i=i+1 {
  while !.faruzan.mods.favonius-cd && i {
    faruzan attack;
  }
  faruzan burst;

  xianyun skill, low_plunge, burst;

  bennett skill, burst;

  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
}
