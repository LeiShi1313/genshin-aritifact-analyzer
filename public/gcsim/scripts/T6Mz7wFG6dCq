durin char lvl=90/90 cons=0 talent=9,10,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=5 lvl=90/90;
rosaria add set="scroll" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311 ; #main
rosaria add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="ttds" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187; #main
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*6 cr=0.0331*8 cd=0.0662*5;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; # main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*2 cr=0.0331*7 cd=0.0662*10;


options swap_delay=12 iteration=100;
# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

active bennett;
for let i = 0; i < 4; i = i + 1 {
  bennett skill, burst;

  rosaria burst;
  durin skill, attack;
  sucrose attack, charge;
  durin burst;
  rosaria skill;
  sucrose attack, skill, dash;
  if .sucrose.burst.ready {
    sucrose burst;
  }
  durin swap;
  while .rosaria.skill.cd > 40 {
    wait(1);
  }
  rosaria attack, skill;
  while !.rosaria.mods.favonius-cd {
    rosaria attack;
  }
  if .rosaria.energy != .rosaria.energymax {
    wait(89); #Rosaria catches her own particles
  }

}
