# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Pickup Crystallize Function
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.yelan && action_id == .action.skill ) {
    pick_up_crystallize("any");
  }
    
  return _execute_action(char_id, action_id, p);
}

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  xilonen burst;
  
  furina skill, dash, burst;
  
  xilonen skill, attack:2;
  
  yelan burst, attack, skill, attack;
  
  #nilou burst;
  nilou skill, attack:2, burst, attack:1, attack:3, attack:3, attack:3, attack:3;
  
  xilonen skill, attack:2;
  
  yelan skill, attack:4;
}
