options swap_delay=12 iteration=1000;

barbara char lvl=90/90 cons=6 talent=9,9,9;
barbara add weapon="sacrificialfragments" refine=3 lvl=90/90;
barbara add set="ohc" count=4;
barbara add stats hp=4780 atk=311 em=187 em=187 em=187; #main
barbara add stats def%=0.062*2 def=19.68*2 hp=253.94*8 hp%=0.0496*12 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*2 cd=0.0662*2;

nilou char lvl=90/90 cons=0 talent=9,9,9;
nilou add weapon="dockhand" refine=1 lvl=90/90;
nilou add set="tenacityofthemillelith" count=2;
nilou add set="vourukashasglow" count=2;
nilou add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
nilou add stats def%=0.062*2 def=19.68*2 hp=253.94*6 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*12 cr=0.0331*2 cd=0.0662*2;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="favoniuscodex" refine=3 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=561; #main
nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*4 cr=0.0331*12 cd=0.0662*2;

collei char lvl=90/90 cons=6 talent=9,9,9;
collei add weapon="favoniuswarbow" refine=3 lvl=90/90;
collei add set="instructor" count=5;
collei add stats hp=3571 atk=232 em=139.3 em=139.3 cr=0.311;
collei add stats def%=0.0496*2 def=15.744*2 hp=203.152*2 hp%=0.03968*2 atk=13.232*2 atk%=0.03968*2 er=0.04408*2 em=15.856*2 cr=0.02648*10 cd=0.05296*4;

# ----  Default Enemy

active nahida;
# ----  Actions List
target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999;
target lvl=100 resist=0.1 radius=1 pos=2.5,0.5 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  nahida skill, burst, attack;
  barbara attack:2, charge;
  if .barbara.skill.ready {
    barbara skill;
  } else {
    barbara attack;
  }
  nilou skill, attack:2;
  nilou skill;
  collei skill, burst;

  barbara attack:2, charge;
  barbara attack:3;
  barbara attack:2, charge;
  barbara attack:3;
  barbara attack:2, charge;
  if .nilou.burst.ready {
    nilou burst;
  } else {
    barbara attack:2;
  }
}
