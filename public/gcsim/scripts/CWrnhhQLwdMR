xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favlance" refine=3 lvl=90/90;
xiangling add set="scroll" count=2;
xiangling add set="eosf" count=2;
xiangling add stats hp=4780 atk=311 er=0.518 em=187 cr=0.311;
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.331 cd=0.1324;

options swap_delay=12 iteration=1000;

active furina;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  baizhu attack, skill, burst;
  xiangling attack:2, burst, skill, dash;
  mualani skill;
  mualani_combo();
  if .mualani.burst.ready && .mualani.energy == .mualani.energymax {
    mualani burst;
    wait(70);   # wait until the Q hits if the sim ends with Mualani Q.
  } else {
    mualani skill; # exit NS state
    mualani attack:4;
    delay(33);  # wait half a second due to xiangling 20s cd
  }
}


# Furina ED N1 Q > Baizhu N1 EQ > Xiangling N2 Q ED > Mualani E 3[3-stacked bite] ( Q / E N4) >
