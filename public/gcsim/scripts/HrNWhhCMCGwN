clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9; 
fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; 
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9; 
xiangling add weapon="kitain" refine=5 lvl=90/90;
xiangling add set="scroll" count=5;
xiangling add stats hp=4780 atk=311 em=187 pyro%=0.466 em=187; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="dialogues" refine=5 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3986 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.1986 cd=0.331;																							

options iteration=1000 swap_delay=12;                                                                       
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn clorinde_combo() {
    clorinde skill;
    while .clorinde.status.clorinde-night-watch {
        if .clorinde.bolratio >= 1 {
            clorinde skill;
        } else {
            clorinde attack;
        }
    }
}

active fischl;

fischl burst; # open with fischl burst for initial electro application

for let i = 0; i < 5; i = i + 1 {
 
  if i {
    clorinde attack; # clorinde normal attack to fill downtime
  }
  chevreuse burst, skill[hold=1];
  if .xl.burst.ready { # xiangling burst every other rotation
    xiangling burst, skill, dash;
  } else {
    xl attack:2, skill, dash;
  }
  if .fischl.skill.ready { # fischl burst every other rotation
    fischl skill, attack:2;
  } else if i {
    fischl attack:2, burst;
  }
  clorinde_combo();
  clorinde burst;
  
}