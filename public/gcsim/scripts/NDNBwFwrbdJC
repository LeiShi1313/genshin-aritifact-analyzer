# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Xianyun Plunge Combo
fn XianyunPlunge() {
  xianyun jump;
  if .airborne {
    xianyun high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if !.furina.mods.favonius-cd {
    furina attack;
  }
  furina burst;
  
  faruzan skill, burst;
  
  xianyun skill, low_plunge, burst;
  
  kazuha skill, high_plunge[collision=1], burst;
  
  faruzan aim:2, skill;
  
  kazuha skill, high_plunge[collision=1];
  
  XianyunPlunge(); xianyun dash;
  XianyunPlunge();
  
  faruzan aim:2; 
  
  kazuha skill, high_plunge[collision=1];
}
