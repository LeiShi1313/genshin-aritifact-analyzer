# Rotation
active arle;
for let i=0; i<4; i=i+1 {
  
  arle skill;
  bennett skill, burst;
  lynette attack, skill;
  rosaria skill, burst;
  arle  charge[early_cancel=1], dash, 
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack;
  rosaria skill;
  arle  attack:3, dash,
        attack:3, dash,
        attack;
}

