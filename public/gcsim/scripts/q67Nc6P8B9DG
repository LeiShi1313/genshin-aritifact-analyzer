# Ayato Nahida Fischl Kuki. ~25s. Rot. Ayato double Electro Hyperbloom. Kuki uses burst in the 1st half of the rotation and burst in 2nd.

# Team - Options listed by DPS
ayato char lvl=90/90 cons=0 talent=9,9,9;
ayato add weapon="finale" refine=5 lvl=90/90;
#ayato add weapon="lionsroar" refine=3 lvl=90/90;
#ayato add weapon="blacksword" refine=1 lvl=90/90;
ayato add set="glad" count=4;
ayato add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
ayato add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # w/ Others
#ayato add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cd=0.622 ; #main
#ayato add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # w/ Black Sword

nahida char lvl=90/90 cons=0 talent=9,9,9;
