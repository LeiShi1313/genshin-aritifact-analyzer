nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3641 cd=0.7944; # Evenstar
#nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
