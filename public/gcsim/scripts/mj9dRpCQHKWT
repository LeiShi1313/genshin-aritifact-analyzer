nahida add set="tenacity" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=118.92 cr=0.2317 cd=0.5296;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active nahida;

for let i=0; i<4; i=i+1 {
  nahida skill, burst;
  xl burst, skill, dash;
  fischl attack:2, burst;
  keqing skill, burst, skill,
         attack, charge,
         attack, charge,
         attack, charge,
         attack, charge,
         attack, charge,
         skill:2,
         attack, charge,
         attack;
  xl attack:2, skill, dash;
  fischl skill, attack;
  if .keqing.sets.tf >= 4 {
    keqing skill, burst, skill,
           attack, charge,
           attack, charge,
           skill,
           attack, charge;
  } else {
    keqing burst, skill:2,
           attack, charge,
           attack, charge,
           attack, charge,
           attack, charge;
  }
}
