# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active razor; # SS stacks

fischl skill, attack;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;

  bennett skill, burst;

  amy attack;
  if !.amy.skill.ready {
    amy attack, burst;
  } else {
    amy skill;
  }

  razor skill, dash, attack, burst, attack, skill, dash;
  # Razor Main DPS window
  while .razor.infusion.bennett-fire-weapon {
  #while .furina.skill.cd {
    if .razor.normal > 3  && .razor.skill.ready {
       razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }

  bennett skill, dash;
}
