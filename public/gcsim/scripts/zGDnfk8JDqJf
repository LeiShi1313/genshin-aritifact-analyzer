# Ganyu Furina Kazuha Escoffier. ~22s Rot. On-field Freeze DPS Ganyu in 2 Target, featuring stronger grouping. Ganyu does 2 Es per rotation. Assumes freezable enemies. Kazuha does not glide cancel. -6K DPS with Stillness, MH, & Non Freezable Opponents.

# Team - Options Listed by DPS
ganyu char lvl=90/90 cons=0 talent=9,9,9;
ganyu add weapon="crescent" refine=5 lvl=90/90;
#ganyu add weapon="songofstillness" refine=5 lvl=90/90;
ganyu add set="bs" count=4;
#ganyu add set="mh" count=4;
ganyu add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favsword" refine=3 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=118.92 cr=0.3972 cd=0.331;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="no" count=4;
#escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.2755 em=39.64 cr=0.2317 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets, Freezable, In front & Adjacent
target lvl=100 resist=0.1 radius=1.5 pos=1.9,2.4 hp=100000000 freeze_resist=0;
target lvl=100 resist=0.1 radius=1.5 pos=-1.9,2.4 hp=100000000 freeze_resist=0;

# Protoype Crescent Headshot Conditional
fn ganyuAim() {
  if .ganyu.weapon == .keys.weapon.crescent { # Attempts headshots (80%) with Crescent
    ganyu aim[hold=2, weakspot=rand()>0.2];
  } else { # Non weakspot opponents
    ganyu aim[hold=2];
  }
}

# Rotation
active furina;

for let x = 0; x < 4; x = x + 1 {
  furina skill, dash, burst;

  kazuha skill, high_plunge;

  esco skill, burst;

  ganyuAim();
  ganyu skill, burst; # Snapshot Crescent Headshot

  kazuha skill, high_plunge, burst;

  ganyuAim();
  ganyuAim();
  ganyuAim();
  ganyu skill;
  ganyuAim();
}
