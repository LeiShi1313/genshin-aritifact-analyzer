chiori char lvl=90/90 cons=6 talent=10,10,10;
chiori add weapon="urakumisugiri" refine=1 lvl=90/90;
chiori add set="huskofopulentdreams" count=4;
chiori add stats def%=1.131 def=99 hp=4780 hp%=0.057999999999999996 atk=344 atk%=0.09899999999999999 er=0.057999999999999996 cr=0.669 cd=0.8630000000000001 geo%=0.466;

options swap_delay=12 iteration=1000;

active chiori;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  # pick up crystallize after some actions with 50% chance
  if rand() >= 0.5 && (
       action_id == .action.dash
    || char_id == .keys.char.mualani && action_id == .action.walk
    || char_id == .keys.char.xilonen && action_id == .action.skill
  ) {
    pick_up_crystallize("any");
  }
  return _execute_action(char_id, action_id, p);
}

let last_burst = false;
fn mualani_combo() {
  last_burst = false;

  mualani skill;
  for let k = 0; k < 3 && .mualani.nightsoul.state; k = k + 1 {
    if k == 2 && .mualani.burst.ready {
      mualani burst;
      last_burst = true;
      break;
    }
    
    while .mualani.momentum < 3 {
      mualani walk[f=1];
    }
    mualani attack;
  }
  
  if .mualani.nightsoul.state {
    mualani skill;
  }
}

for let i = 0; i < 4; i = i + 1 {
  chiori skill:2;
  mualani attack:3;
  xilonen skill, attack:2;
  
  # up to 3 attacks to use burst
  for let k = 0; k < 3; k = k + 1 {
    if .xiangling.burst.ready {
      xiangling burst;
      break;
    }
    xiangling attack;
  }
  xiangling skill, dash;
  
  if .chiori.skill.ready { # if chiori c6
    chiori skill:2;
  }
  mualani_combo();
}

# count last burst damage
if last_burst {
  wait(12);
}