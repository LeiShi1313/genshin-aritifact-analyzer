# Kaeya Furina Fischl Xianyun. ~20s Rot. Kaeya Phys Plunge with Superconduct. OHC > SoDP but bubbles may miss. 50% Collisions.

# Team - Options listed by DPS
kaeya char lvl=90/90 cons=6 talent=9,9,9;
kaeya add weapon="harbinger" refine=5 lvl=90/90;
#kaeya add weapon="finale" refine=5 lvl=90/90;
kaeya add set="lno" count=4;
kaeya add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # HoD
#kaeya add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main
#kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Finale

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="stillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 cr=0.311 electro%=0.466; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add set="vv" count=4;
xianyun add set="ohc" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3857 em=59.46 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freeze Immunity

# Kaeya Plunge Combo
fn KaeyaPlunge() {
  kaeya jump;
  if .airborne {
    kaeya high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active fischl;
fischl skill;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  #if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  #}
  furina burst;

  xianyun skill, low_plunge, burst;

  if .fischl.skill.ready {
    fischl attack:2, skill;
  } else {
    fischl attack:2, burst;
  }

  kaeya skill, burst;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya skill;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge(); kaeya dash;
  KaeyaPlunge();
  kaeya attack:2, charge;
}
