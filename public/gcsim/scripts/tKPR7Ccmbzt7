let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilonen && action_id == .action.skill ) {
    pick_up_crystallize("any");
  }

  return _execute_action(char_id, action_id, p);
}

xilonen char lvl=100/100 cons=6 talent=10,10,10;
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scrolloftheheroofcindercity" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.062*6 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*8;

chiori char lvl=100/100 cons=6 talent=10,10,10;
chiori add weapon="urakumisugiri" refine=5 lvl=90/90;
