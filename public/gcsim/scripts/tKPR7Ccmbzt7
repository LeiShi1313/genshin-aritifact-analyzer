citlali add weapon="starcallerswatch" refine=5 lvl=90/90;
citlali add set="tenacityofthemillelith" count=4;
citlali add stats hp=4780 atk=311 em=186.5 em=186.5 em=186.5;
citlali add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*12 cd=0.0662*8;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active chiori;

for let i=0; i<3; i=i+1 {

  chiori skill:2;

  furina skill, dash, burst, attack:2;

  xilonen skill, attack:2;

  citlali skill;

  if .chiori.burst.ready {
    chiori skill, attack, burst, attack:3, dash, attack:1;
    for let j=0; j<2; j=j+1{
      chiori skill, attack:3, dash, attack:3, dash, attack:2;
    }
  } else {
    for let j=0; j<3; j=j+1{
      chiori skill, attack:3, dash, attack:3, dash, attack:2;
    }
  }
}
