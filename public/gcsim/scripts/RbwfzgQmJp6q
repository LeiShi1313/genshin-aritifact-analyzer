#enemy config

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
active xilonen;

for let i = 0; i < 4; i = i + 1 {

  if i {

    xilonen skill, attack:2;

  }

  xilonen burst;
  furina skill, dash, burst;
  yelan burst, attack, skill, attack;
  xilonen skill, attack:2;

  # modified combo to keep better uptime

  itto attack, burst[prestack=1],
       attack, skill,
       attack:2, charge:5, dash,
       attack:3, charge:4, skill[travel=0], charge;
       delay(21); #catch ushi particles

}
