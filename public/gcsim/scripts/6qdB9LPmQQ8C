#Random frame delays
fn randy(mean, standardDeviation, min, max, display) {
  let value = randnorm() * standardDeviation + mean;
  if display {
    print("initial roll: ", value);
  }
  if value > max {
    value = max;
  } else if value < min {
    value = min;
  }
  if display {
    print("final delay value: ", value);
  }
  return value;
}

let prev_char_id = -1;
switch {
  case .alhaitham.onfield:
    prev_char_id = .keys.char.alhaitham;
  case .fischl.onfield:
    prev_char_id = .keys.char.fischl;
  case .yae.onfield:
    prev_char_id = .keys.char.yae;
  default:
    prev_char_id = .keys.char.kuki;
} #this switch statement prevents "swap delay" from being added at the start of each iteration when the first action does not actually include an implicit swap
let prev_action_id = -1;

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {

  if prev_char_id != char_id && action_id != .action.swap {
    execute_action(char_id, .action.swap, []);
  }

  if action_id == .action.swap {
    delay(randy(9.5, 1.5, 8, 17, 0)); #SWAP DELAY (frames, including 1f base): mean 10.5 stddev 1.5, bounds: 9-18f
                                                     #corresponding ping (ms): mean 87.5 stddev 12.5, bounds: 75-150ms
    
  } else if prev_action_id == .action.attack && action_id != .action.attack && action_id != .action.charge {
    delay(randy(3, 1, 0, 6, 0)); #NA DELAY (except if next action is NA/CA): mean 3 stddev 1, bounds: 0-6f
    
  } else if prev_action_id != .action.attack {
    delay(randy(3, 1, 0, 6, 0)); #OTHER ACTION DELAY: mean 3 stddev 1, bounds: 0-6f
  }

  prev_char_id = char_id;
  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}

options swap_delay=1 iteration=1000 ignore_burst_energy=false;
target lvl=100 type=dummy radius=1 pos=0,1.5 particle_threshold=520000 particle_drop_count=3; #Energy drops based on 12-3 Icewind Suite

active yae;

#[Alhaitham N1C] > Yae EE [N1] E > Fischl N1 E > Kuki E Dash N1 > Alhaitham E N4CD N3 > Yae [Q] EEE > Fischl N2 Q > Alhaitham Q > Kuki Q > Alhaitham N4CD N3CD N4CD N3

if .yae.weapon == .keys.weapon.hakushinring { 
  alhaitham attack, charge; #allows yae to proc hakushin on her first fieldtime. seems more or less neutral for overall sim dps and is funny and cool
}                           #improves frontloading ability in some ways, but hurts it in others: alhaitham's a1 is still on cd for his first combo

for let r=0; r<3; r=r+1 {
  yae skill:2;
  if .yae.weapon == .keys.weapon.hakushinring {
    yae attack; #guarantee hakushin proc
  }
  yae skill;
  fischl attack, skill;
  kuki skill, dash, attack;
  
  #alhaitham skill[hold=1];
  #if rand() < 1/3 { #1/3 chance to get the short plunge
  #  alhaitham low_plunge[short=1];
  #} else {
  #  alhaitham low_plunge;
  #}
  alhaitham skill;
  alhaitham attack:4, charge, dash,
            attack:3;
  
  yae swap;
  if .yae.burst.ready {
    yae burst;
  }
  for let s=0; s<3; s=s+1 {
    if !.yae.skill.ready {
      yae attack;
    }
    yae skill;
  }
  fischl attack:2;
  while !.fischl.burst.ready {
    fischl attack;
  }
  fischl burst;
  
  alhaitham swap;
  while !.alhaitham.burst.ready {
    alhaitham attack;
  }
  alhaitham burst;
  kuki swap;
  if .kuki.burst.ready {
    kuki burst;
  } else {
    kuki attack:3;
  }
  alhaitham attack:4, charge, dash,
            attack:3, charge, dash,
            attack:4, charge, dash,
            attack:3;
}