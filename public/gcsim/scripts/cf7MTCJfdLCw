# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i = 0; i < 4; i = i + 1 {
  nicole skill, burst;

  mona burst, attack;

  durin skill, burst, skill;
  #durin skill, burst, attack;

  mona attack, skill, attack;

  raiden burst,
         attack:4, dash,
         attack:4, dash,
         attack:4, skill,
         attack:3;
}
