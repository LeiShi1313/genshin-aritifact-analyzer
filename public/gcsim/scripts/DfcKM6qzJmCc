# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000; # Not Bad

# Beidou 20% Perfect Counter, 10% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.80 {
    counter = 2;
  } else if counter > 0.7 && counter <= 0.80 {
    counter = 1;
  }
  else {
    counter = 0;
  }

  return counter;
}

#Rotation
active beidou; # SS Stacks

for let i=0; i<4; i=i+1 {
  fischl attack, skill;

  # Not bursting every rotation is better, despite the low ER req, even with NO
  if .chev.burst.ready {
    chev burst, skill[hold=1]:2;
  } else {
    chev skill[hold=1], attack;
  }

  beidou skill[counter=rand_counter()], burst;

  yoimiya skill, attack:5, dash, attack:5, dash, attack:5;

  fischl attack:2, burst;

  beidou skill[counter=rand_counter()];

  yoimiya skill, attack:5, dash, attack:5, dash, attack:3, burst;
}
