bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

let UseXilonenDash = false;  # change this value between true and false to make Xilonen use dash or not

active arle;

for let i=0; i<4; i=i+1 {
  arle skill;
  bennett skill, burst;
  xilonen skill, attack:2;
  if UseXilonenDash == true {
    xilonen dash;   # dash to pick up the shard
  }
  pick_up_crystallize("pyro");
  citlali skill, burst;
  arle charge[early_cancel=1], dash;
  while !.element.t0.cryo {
    wait(1);
  }
  arle attack:6;
  arle attack:6;
  if UseXilonenDash == true {
    delay(10);   # the timing changes so you need to wait to get melt
  }
  arle attack:3;
}
