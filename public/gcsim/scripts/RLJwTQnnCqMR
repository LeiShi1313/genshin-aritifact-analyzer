# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active arlecchino;

let UseXilonenDash = false;  # change this value between true and false to make Xilonen use dash or not

fn WaitForCryo() {
  let StartFrame = f();
  if !.element.t0.pyro {      # If the enemy aura is not Pyro, wait for Cryo aura (so if its already Pyro you don't wait)
    while !.element.t0.cryo && f() - StartFrame < 120 {   # wait but up to 120f(2s), so you don't wait forever
      wait(1);
    }
  }
}


for let i=0; i<4; i=i+1 {
  if .arle.weapon == .keys.weapon.crimsonmoonssemblance {
    arle charge;
  }
  arle skill;            delay(11);
  bennett skill, burst;
  xilonen skill, attack:2;
  if UseXilonenDash == true {
    xilonen dash;   # dash to pick up the shard
  }
  pick_up_crystallize("pyro");

  if .arle.cons < 2 {
    citlali skill, burst;
  } else {
    citlali attack, skill, burst;
  }

  arle charge[early_cancel=1], dash;  # if Arle is C2+, C2 proc will apply pyro
  // if .arle.cons >= 2 {
  //   wait(47);
  // }
  # Disclaimer
  # Originally, after CA cancel, you need to see Arle C2 proc remove Cryo first and then you need to wait for Citlali's Cryo app before performing NA combo
  # but in this sim, Arle perform N1 immediately without waiting, removing Cryo. And Citlali applies Cryo right after that (0.1seconds) and then C2 proc hits.
  WaitForCryo();
  arle attack:3, dash;
  WaitForCryo();
  arle attack:3, dash;
  WaitForCryo();
  arle attack:3, dash;

  WaitForCryo();
  arle attack:3, dash;
  WaitForCryo();
  arle attack:3, dash;
  WaitForCryo();
  arle attack;
  while .arle.skill.cd > 48 {
    if .arle.normal == 4 {
      arle dash;
    } else {
      arle attack;
    }
  }
  if .arle.weapon != .keys.weapon.crimsonmoonssemblance && .arle.skill.cd > 15 { # Since you don't do CA, use one more NA to reduce E cd
    arle attack;
    print("one more NA");
  }
}

# Arle C¹ E > Bennett EQ > Xilonen E N2 > Citlali (N1)² EQ > Arle CD³ 5[wait N3D] N2 >

# ¹ If Arle is holding her Sig weapon, use CA for the passive.
# ² If Arle is C2+, Use Citlai N1 before or after E to leave Cryo on the enemy before swapping out
# ³ Dash cancel her CA before it hit the enemy to prevent Pyro app.

# In this sim, Arle performs her first N3D immediately but its timing is very sensitive see the comments above and the sim sample
