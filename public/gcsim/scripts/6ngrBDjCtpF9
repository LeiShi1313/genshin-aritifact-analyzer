# Dori Nahida Furina Xianyun. ~22s Rot. Dori Quickbloom Plunge. Dori uses her burst after two plunges. The CD on Dori's skill/infusion is eliminated by ICD-less plunges. Xianyun only applies VV for 6 plunges in the second half of the rotation; very sensitive. 50% Collisons.

# Team
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#dori add weapon="rainslasher" refine=3 lvl=90/90; # Much Worse
dori add set="tf" count=4;
dori add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; # main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.3972 cd=0.662;
#dori add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
#dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Atk/El/Cr; Rainslasher

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.1653 em=138.74 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Dori Plunge Combo
fn DoriPlunge() {
  dori jump;
  if .airborne {
    dori high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active dori; #SS Stacks
#dori skill;

for let i = 0; i < 4; i = i + 1 {
  nahida skill;
  if i > 0 && .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }

  furina skill, dash, attack, burst;

  xianyun skill, low_plunge, burst;

  dori skill;
  DoriPlunge(); dori dash;
  DoriPlunge(); dori attack, burst;

  xianyun attack:2; sleep(20); # VV electro here only

  dori skill, attack;
  DoriPlunge(); dori dash;
  DoriPlunge(); dori dash;
  DoriPlunge();
  dori skill, attack;
  DoriPlunge(); dori dash;
  DoriPlunge(); dori dash;
  DoriPlunge();
}
