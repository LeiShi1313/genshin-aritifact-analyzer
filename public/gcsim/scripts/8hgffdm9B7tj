clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="harbingerofdawn" refine=5 lvl=90/90; 
//R5 Harbinger of Dawn is ~2.3% better than R1 Black Sword, R5 Harbinger of Dawn ≈ R3 Black Sword.
//R1 Absolution is ~21.5% better than R1 Black Sword and ~19.7% better than R5 Harbinger of Dawn.
//100% uptime on HoD passive is realistic due to Clorinde's self healing and mobility which makes her take less total hits than most characters.
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; //main; ER sands is ~2.67% worse than atk sands.
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2979 cd=0.662;

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="mouun" refine=1 lvl=90/90;
sara add set="scroll" count=4;
sara add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311;
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4; //Next best set is Tenacity of the Millelith, which is ~3.8% worse than Days past for Clorinde's DMG. 
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="sapwoodblade" refine=3 lvl=90/90; //Favonius Sword Bennett is ~4% worse team DPS.
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;


 
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn clorcombo() {
	clorinde skill;
	while .clorinde.status.clorinde-night-watch {
		if .clorinde.bolratio >= 1 {
			clorinde skill;
		} else {
			clorinde attack;
		}
	}
}

active sara;

sara skill;
chevreuse burst, skill[hold=1];
bennett burst;
sara burst;
clorcombo();

for let x=0; x<4; x=x+1 {     //4 Rots + Modified opener = 5 rots, clorinde ER reqs go up every rot until they hit about ~141% at 5 rots.
	sara aim;
	chevreuse attack, skill[hold=1];
	clorinde burst;
	bennett skill, burst;
	if .sara.burst.ready {
		sara skill, burst;
	} else { 
		sara attack, skill;
	}
	clorcombo();
}

// Rotation: 
//Sara E > Chevreuse Q hE > Bennett Q > Sara Q > Clorinde E 6[N3E] N1 > 
//Sara C > Chevreuse N1 hE > Clorinde Q > Bennett E Q > Sara N1 E or E Q > Clorinde EE 6[N3e] > Repeat from Sara N1 C
//Passing Sara buff through Chev hE has a ~6f margin of error (at 100 ping, for something like 35 ping it would be closer to 22f margin of error)
//while also being close to a hard requirement due to Clorinde's ER needs.
//I would personally not recommend this team unless you can clear in ~3 rotations or less.
