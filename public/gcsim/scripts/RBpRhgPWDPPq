bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
                                                                                                                                                                                                                                                        
options swap_delay=12 iteration=1000;                                                                        
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active raiden;
raiden skill;
for let i = 0; i < 4; i = i + 1 {
  if .chev.burst.ready {
    chev burst, skill[hold=1], dash;
  } else {
    chev attack, skill[hold=1], attack;
  }
  yoimiya burst;
  bennett burst, skill;
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash;
  raiden burst, attack:4, skill, attack:4;
}
