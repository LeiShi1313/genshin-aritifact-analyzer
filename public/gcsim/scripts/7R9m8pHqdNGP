options swap_delay=12 iteration=1000;

# Build assumptions
neuv char lvl=90/90 cons=0 talent=9,9,9;
neuv add weapon="sacjade" refine=1 lvl=90/90;
neuv add set="mh" count=4;
neuv add stats hp=4780 atk=311 hydro%=0.466 hp%=0.466 cd=0.622;
neuv add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*7 cd=0.0662*10;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 em=187 cd=0.622;
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*3 cr=0.0331*7 cd=0.0662*10;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="etherlightspindlelute" refine=5 lvl=90/90;
lauma add set="deepwoodmemories" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187;
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*6 cr=0.0331*12 cd=0.0662*5;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="kitain" refine=5 lvl=90/90;
ineffa add set="fopl" count=5;
ineffa add stats hp=4780 atk=311 em=187 em=187 em=187;
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*2 em=19.82*6 cr=0.0331*5 cd=0.0662*5;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active lauma;
lauma attack;
for let i=0; i<4; i=i+1 {
  neuv skill, attack;
  columbina skill, attack;
  ineffa attack, skill;
  lauma attack, burst, attack, skill[hold=1];
  columbina attack, burst;
  neuv attack, charge, skill, charge, burst;
  lauma attack, skill[hold=1], attack;
  ineffa burst;
  neuv attack, charge:2;
}
wait(173);
