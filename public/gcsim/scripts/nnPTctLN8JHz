options swap_delay=12 iteration=1000;

# Build assumptions
kamisatoayato char lvl=90/90 cons=0 talent=9,9,9;
kamisatoayato add weapon="blacksword" refine=1 lvl=90/90;
kamisatoayato add set="notsu" count=4;
kamisatoayato add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cd=0.622;
kamisatoayato add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1653 em=39.64 cr=0.3641 cd=0.662;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2317 cd=0.662;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="etherlightspindlelute" refine=5 lvl=90/90;
lauma add set="deepwoodmemories" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187;
lauma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=118.92 cr=0.3641 cd=0.2648;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="kitain" refine=5 lvl=90/90;
ineffa add set="fopl" count=5;
ineffa add stats hp=4780 atk=311 em=187 em=187 em=187;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.1324 cd=0.3972;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active lauma;
lauma attack;
for let i = 0; i < 4; i = i + 1 {
  columbina skill, burst, attack;
  ineffa skill, attack; wait(12);
  lauma attack, skill[hold=1], burst;
  ayato skill, attack:15, burst;
  columbina attack, charge;
  ineffa burst;
  lauma skill[hold=1];
  ayato skill, attack:15;
  columbina attack;
}
