options swap_delay=12 iteration=100 workers=8 ;


ganyu char lvl=90/90 cons=0 talent=9,9,9;
ganyu add weapon="hamayumi" refine=5 lvl=90/90;
ganyu add set="ur" count=4;
ganyu add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311 ; #main
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=5;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

dehya char lvl=90/90 cons=0 talent=9,9,9;
dehya add weapon="sacgs" refine=5 lvl=90/90;
dehya add set="deepwood" count=4;
dehya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2648 cd=0.7282;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwoodblade" refine=5 lvl=90/90 +params=[pickup_delay=250];
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Options
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Adjacent

# Rotation
active emilie;

for let x=0; x<4; x=x+1 {

  if x==0 || !.emilie.burst.ready {
  emilie skill, attack;
  } else {
  emilie burst;
  }

  bennett skill, burst;

  dehya attack, skill;

  ganyu aim:6;
  if !.dehya.mods.sacrificial-cd {
    if .ganyu.burst.ready {
    ganyu skill, burst;
    } else {
    ganyu aim, skill;
    }
  } else {
    ganyu skill;
  }
}
