sigewinne char lvl=90/90 cons=0 talent=9,9,9;
sigewinne add weapon="sequenceofsolitude" refine=5 lvl=90/90;
sigewinne add set="sodp" count=4;
sigewinne add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
sigewinne add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*8;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    //} else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
    //  varesa jump;
    //  if .airborne {
    //    varesa high_plunge[collision=1]; # JP
    //  }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  sigewinne skill, dash;
  ororon burst, skill;
  varesa_combo(7);
}