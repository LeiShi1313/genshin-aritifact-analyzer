# Dehya Emilie Xianyun Bennett. ~20s Rot. Dehya Burning plunge. Deepwood is close to alternative sets for all characters. 50% Collisions.

# Team
dehya char lvl=90/90 cons=0 talent=9,9,9;
dehya add weapon="serpent" refine=1 lvl=90/90;
dehya add set="longnightsoath" count=4;
#dehya add set="ur" count=4;
#dehya add set="deepwood" count=4;
dehya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
#emilie add set="deepwood" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="deepwood" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.551 em=39.64 cr=0.3972 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="deepwood" count=4;
#bennett add set="noblesse" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # deals burning AoE, -SS stacks

# Dehya Plunge Combo
fn DehyaPlunge() {
  dehya jump;
  if .airborne {
    dehya high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active dehya; # SS stacks

for let i=0; i<4; i=i+1 {
  dehya skill;

  if i==0 || !.emilie.burst.ready {
  emilie skill, attack;
  } else {
  emilie burst;
  }

  xianyun skill, high_plunge, attack, burst;

  bennett skill, burst;

  #dehya attack;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya attack;
  DehyaPlunge(); dehya attack;
  DehyaPlunge(); dehya attack;
  DehyaPlunge(); dehya attack;
  DehyaPlunge(); dehya attack;
  DehyaPlunge(); dehya attack;

  bennett skill;
}
