arlecchino skill;

for let i = 0; i < 4; i = i + 1 {
  xilonen burst, skill, attack:2;
  bennett skill, burst;
  if .chiori.burst.ready {
    chiori burst, skill:2;
  }
  else chiori skill:2;
  arlecchino charge,
  attack:3, dash,
  attack:3, dash,
  attack:3, dash,
  attack:3, dash,
  attack:3, dash,
  attack:3, dash,
