mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mavuika; # SS Stacks

for let i=0; i<4; i=i+1 {
  ororon burst, skill;
  chevreuse burst, skill[hold=1];
  mavuika burst, charge, skill, charge, dash;
  keqing skill, burst, skill,
         attack, charge,
         attack, charge,
         attack, charge,
         attack, charge,
         attack, charge,
         attack,
         skill:2,
         attack, charge,
         attack, charge;
}

