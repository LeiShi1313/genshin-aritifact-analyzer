mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;

active mavuika;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

mona attack, dash;
for let i=0; i<6; i=i+1 {
  mavuika burst, charge, skill;
  xilonen skill, attack:2;
  mona burst;
  mualani skill;
  mualani_combo();
  if (i / 3) * 3 == i {
    mualani burst;
    mualani attack;
  } else if .xilonen.burst.ready {
    xilonen burst;
    mona attack, dash;
  } else {
    mona dash, attack:2, charge;
  }
}

# Mona N1D (First rot)
