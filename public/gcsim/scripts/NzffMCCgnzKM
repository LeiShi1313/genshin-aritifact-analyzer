# Cyno Chevreuse Fischl Thoma. ~25s Rot. Cyno Overload with a Thoma built for reaction DMG. Support build Chevreuse bursts every other rotation.

# Team - Options List by DPS
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="deathmatch" refine=1 lvl=90/90;
cyno add set="echoes" count=4;
#cyno add set="glad" count=4;
cyno add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
#chev add weapon="dialogues" refine=5 lvl=90/90;
chev add set="sodp" count=4;
#chev add set="gt" count=4; # Snapshot
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
chev add stats def%=0.124 def=39.36 hp=2031.52 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.1324; # HHC
#chev add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
#chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ADC

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="kitain" refine=5 lvl=90/90;
thoma add set="scroll" count=4;
#thoma add set="no" count=4;
thoma add stats hp=4780 atk=311 em=187 em=187 em=187; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=118.92 cr=0.3641 cd=0.2648;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active fischl;

for let r = 4; r > 0; r = r - 1 {
  fischl skill;

  if .chev.burst.ready && .chev.energy == .chev.energymax {
    chev burst, skill[hold=1]:2;
    if !.chev.mods.favonius-cd {
      chev skill[hold=1];
    }
  } else {
    chev attack, skill[hold=1];
  }
  
  thoma burst, attack, skill;
  
  fischl attack:2, burst;
  
  cyno skill, attack, burst;
  while .fischl.skill.cd > 30 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
    

}

