#C6 Alhaitham Solo but with Cheerleader Kaveh. Simple APL. TTK 12-3 Icewind Suite base stats. Customized random action delays.

alhaitham char lvl=90/90 cons=6 talent=10,10,10;
alhaitham add weapon="pjc" refine=1 lvl=90/90;
alhaitham add set="deepwood" count=4;
alhaitham add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #88.8 [98.8] / 165.0 [235.0] | 133.0 er
alhaitham add stats hp=507.88 atk=33.07 def=39.35 hp%=0.0991 atk%=0.0991 def%=0.1239 em=39.63 er=0.3303 cr=0.3966 cd=0.5284; #4 er, 10 cr, 6 cd distributed rolls (KQMs stats)

kaveh char lvl=80/90 cons=0 talent=4,5,6;
kaveh add weapon="aquamarine" refine=5 lvl=90/90;
kaveh add set="wt" count=2;
kaveh add set="gilded" count=2;
kaveh add stats hp=4780 atk=311 em=186.5 em=186.5 em=186.5; #1100 em (giving 158.4 atk to alhaitham. resonance doesn't exist because it requires a full team)
kaveh add stats hp=3047.28 atk=33.07 def=39.35 hp%=0.3964 atk%=0.0991 def%=0.1239 em=118.89 er=0.1101 cr=0.0661 cd=0.1321; #10 flat hp, 6 hp%, 4 em

options swap_delay=1 iteration=1000;
target lvl=100 type=icewindsuite radius=1 pos=0,1.5;

active alhaitham;

fn doAPL() {
  while true {
    switch {
      case .alhaitham.burst.ready:
        alhaitham burst;
      case .alhaitham.skill.ready && (.alhaitham.energy < 60 || .alhaitham.mirrors == 0):
        alhaitham skill;
      case (.alhaitham.normal > 3) && (.stam > 25):
        alhaitham charge;
      default:
        alhaitham attack;
    }
  }
}

#Random action execution delays
fn randy(mean, standardDeviation, min, max) {
  let value = randnorm() * standardDeviation + mean;
  if value > max {
    value = max;
  } else if value < min {
    value = min;
  }
  return value;
}

let prev_action_id = -1;

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {

  if prev_action_id == .action.attack && action_id != .action.attack && action_id != .action.charge {
    delay(randy(3, 1, 0, 6)); #NA DELAY (except if next action is NA/CA): mean 3 stddev 1, bounds: 0-6f
    
  } else if prev_action_id != .action.attack {
    delay(randy(3, 1, 0, 6)); #OTHER ACTION DELAY: mean 3 stddev 1, bounds: 0-6f
  }

  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}

doAPL();