# Razor Emilie Fischl Xiangling. ~20s Rot. Razor Quickburn with ~15s Field time. Emilie bursts every other rotation. Fischl alternates skill and burst, prioritizing burst. Xiangling goes after Fischl and bursts every other rotation. Razor has the most Overload ownership.

# Team
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#razor add weapon="mailedflower" refine=5 lvl=90/90;
#razor add weapon="aquamarine" refine=1 lvl=90/90;
razor add set="ur" count=4;
#razor add set="gd" count=4;
razor add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # Em/Em/Cd; SS
#razor add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # Em/El/Cd
#razor add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # Em/EL/Cr; MF
#razor add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
#razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.2317 cd=0.7282; # Em/Em/Cr; Aqua

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
#fischl add set="ur" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="kitain" refine=5 lvl=90/90;
xiangling add set="deepwood" count=4;
#xiangling add set="tom" count=4;
xiangling add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.4408 em=118.92 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active razor; # SS Stacks
#razor skill, dash; # Worse

for let i=0; i<4; i=i+1 {
  # Burst in 2nd Rot onward
  if i && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }

  # Burst over skill
  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }

  if .xiangling.burst.ready {
    xiangling burst, skill, dash;
  } else {
    xiangling attack, skill, dash; # N1 for Fischl C6
  }

  razor skill, dash, attack, burst;
  # Razor main DPS window
  while .razor.mods.razor-q > 210 { # End on N2
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  #razor skill, dash; # DPS loss
}
