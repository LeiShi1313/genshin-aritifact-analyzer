chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;																					

options iteration=1000 swap_delay=12;                                                                       
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn clorinde_combo() { 
  clorinde skill;
   while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active yae;

for let i = 0; i < 5; i = i + 1 { # 5 rotations

  yae skill:3;
  if .xl.burst.ready { # xl burst every other rotation
    xl skill, dash, burst;
  } else {
    xl attack:3, skill, dash;
  }
  chevreuse burst, skill[hold=1];
  if !.chev.mods.favonius-cd {
    chev attack;
  }
  clorinde_combo();
  clorinde burst;
  
}
  