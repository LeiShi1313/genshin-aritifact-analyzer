options swap_delay=12 iteration=1000;

neuvillette char lvl=90/90 cons=0 talent=9,9,9 ;
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90 ;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

lisa char lvl=90/90 cons=0 talent=9,9,9;
lisa add weapon="pamber" refine=5 lvl=90/90;
lisa add set="scroll" count=4;
lisa add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.551 em=198.2 cr=0.0662 cd=0.1324;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="favsword" refine=3 lvl=90/90;
lynette add set="vv" count=4;
lynette add stats hp=4780 atk=311 anemo%=0.466 atk%=0.466 cr=0.311 ; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

active neuvillette;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {

    neuvillette skill, dash;
    furina skill, dash, attack;
    lynette burst;
    lisa skill[hold=1], burst;
    lynette skill, attack;
    furina burst;
    neuvillette charge, burst, skill, charge;
    lynette skill;
    neuvillette charge, charge;

 }

 wait(173); #for the last CA

