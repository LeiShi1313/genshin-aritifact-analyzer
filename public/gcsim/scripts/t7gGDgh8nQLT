ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000; # L
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000; # R

# Lanyan Q for Grouping, then Lanyan E off CD with N1 weaving; Sac & Con Compatible
fn lanyanDrivingCombo() {
  switch {
    case .lanyan.normal > 1 && .lanyan.burst.ready && .lanyan.energy == .lanyan.energymax:
      lanyan burst;
    case .lanyan.normal > 1 && .lanyan.skill.ready:
      set_player_pos(0, 0); # toward
      lanyan skill; set_player_pos(0, -3); # away
      lanyan skill;
    case .lanyan.normal > 1 && .previous-action == .action.skill && .stam > 18:
      lanyan dash; set_player_pos(0, 0); # toward
    case .lanyan.normal > 2 && .stam > 18:
      lanyan dash; set_player_pos(0, 0); # toward
    default:
      lanyan attack;
  }
}

# Rotation
active ineffa;

for let i=0; i<4; i=i+1 {
  if i > 0 && .ineffa.burst.ready {
    ineffa skill, burst;
  } else if i > 0 {
    ineffa skill, attack;
  } else {
    ineffa skill;
  }

  if .columbina.burst.ready {
    columbina skill, burst;
  } else {
    columbina attack:0, skill, attack:1;
  }

  durin skill, skill, burst;

  while .ineffa.mods.birgitta > 210 {
    lanyanDrivingCombo();
  }
}
