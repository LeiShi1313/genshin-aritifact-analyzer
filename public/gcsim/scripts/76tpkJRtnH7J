# Characters

klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="mh" count=4;
klee add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=99.1 cr=0.1655 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="no" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.6612 em=39.64 cr=0.2648 cd=0.1324;

# Options

options swap_delay=12 iteration=500;
energy every interval=480,720 amount=1;

# Targets

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

# Actions

active furina;
for let i = 0; i < 4; i = i + 1 {
  if !i {
    furina skill, dash, burst;
  } else {
    furina burst, skill, dash;
  }
  
  xingqiu skill, burst, attack;
  xianyun skill, low_plunge, burst;
  klee attack, skill;
  
  for let p = 4; p > 0; p = p - 1 {
    let col = rand();
    let col2 = rand();
    
    klee attack, charge, jump;
    if .airborne {
      klee low_plunge[collision=rand()>0.5];
    }
    
    klee attack, jump;
    if .airborne {
      klee low_plunge[collision=rand()>0.5];
    }
  }
  
  klee attack, charge, attack, charge, attack;
  if !i {
    furina attack;
  } 
}
wait(30); # So sim doesn't end with final CA mid animation

# Klee plunge vape with Furina, Xingqiu, Xianyun. Klee does not use her burst in order to get 8 buffed plunges. The vast majority of klee's plunges and charged attacks are vaped. 50% collision rate.
# Furina Q E D > Xingqiu E Q N1 > Xianyun E lP Q > Klee N1E 4(N1CJlP + N1JlP) 2N1C N1 > Furina N1
# Last rotation starts with Furina E D Q and omits the Furina N1 at the end