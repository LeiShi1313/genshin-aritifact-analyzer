#nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*14 em=19.82*2 cr=0.0331*6 cd=0.0662*4;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*12 atk%=0.0496*8 er=0.0551*6 em=19.82*2 cr=0.0331*2 cd=0.0662*2;


options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active faruzan;

for let i=0; i<4; i=i+1 {
  faruzan burst;
  while !.faruzan.mods.favonius-cd {
    faruzan attack;
  }
  nicole burst, skill, attack;
  durin skill, burst, skill;
  wanderer attack, skill, attack;
  while .wanderer.skydweller-points > 3 {
    if .wanderer.normal < 3 {
      wanderer attack;
    } else if .wanderer.mods.wanderer-a4 {
      wanderer dash;
    } else if .wanderer.skydweller-points > 2 {
      wanderer charge;
    } else {
      wanderer attack;
    }
  }
  if .wanderer.status.windfavored-state && .wanderer.burst.ready {
    wanderer burst, attack;
  } else if .wanderer.status.windfavored-state && !.wanderer.burst.ready {
    wanderer skill, low_plunge;
  }

}
