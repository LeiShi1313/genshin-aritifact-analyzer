# Dori Emilie Ororon Mavuika. ~20s Rot. Dori Quickburn with long field time Dori & 30% Burning uptime. Full EM Maviuika and Ororon. Emilie & Mavuika burst every other rotation after the first. then Dori stays on field for 3 skill uses, as her C6 infusion downtime is near eliminated with TF.

# Team
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#dori add weapon="mailedflower" refine=5 lvl=90/90;
#dori add weapon="talkingstick" refine=1 lvl=90/90; dori add stats electro%=0.12; # Passive not implemented
dori add set="tf" count=4;
dori add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; #EDCd
#dori add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
#dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; #EDCr; MF/Aqua

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
#emilie add set="deepwood" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="aquamarine" refine=1 lvl=90/90;
mav add set="deepwood" count=4;
#mav add set="scroll" count=4;
mav add stats hp=4780 atk=311 em=187 em=187 em=187; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=118.92 cr=0.3972 cd=0.1986;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
#ororon add set="deepwood" count=4;
ororon add stats hp=4780 atk=311 em=187 em=187 em=187; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active dori; # SS Stacks

for let i=0; i<4; i=i+1 {
  # Burst in 2nd Rot onward
  if i > 0 && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack;
  }

  ororon skill, burst;

  if .mav.burst.ready {
    mav skill, burst, dash;
  } else {
    mav skill, attack;
  }

  dori skill, attack:2, dash, attack:2, burst;
  dori skill, attack:2, dash, attack:2;
  dori skill, attack:2, dash, attack:2;
}
