fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # w/ VH

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662 ;

options swap_delay=12 iteration=1000;
active arlecchino;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

arlecchino skill;

bennett burst;

fischl attack:2, burst;

chevreuse burst, skill[hold=1]:2;

arlecchino charge,
           attack:3, dash,
           attack:3, dash,
           attack:3, dash,
           attack:3, dash,
           attack:3, dash,
           attack:3, dash,
           attack:1;
             
for let i=0; i<3; i=i+1 {
  
  arlecchino skill, attack;
  
  bennett skill, dash, burst;
  
  if .chevreuse.burst.ready{
    chevreuse burst;
  } else {
    chevreuse attack;
  }
  chevreuse skill[hold=1];
  
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  
  arlecchino attack:2, charge,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3;  
}