arlecchino char lvl=90/90 cons=0 talent=9,9,9 ;
arlecchino add weapon="deathmatch" refine=1 lvl=90/90;
arlecchino add set="fohw" count=4;
arlecchino add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
arlecchino add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;																			

chevreuse char lvl=90/90 cons=6 talent=9,9,9; 
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="tom" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944 ;															

