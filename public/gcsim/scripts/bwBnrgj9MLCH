keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="wolffang" refine=1 lvl=90/90;
keqing add set="tf" count=4;
keqing add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

collei char lvl=90/90 cons=6 talent=9,9,9;
collei add weapon="favbow" refine=4 lvl=90/90;
collei add set="ins" count=4;
collei add stats hp=3571 atk=232 atk%=0.348 dendro%=0.3495 cr=0.311; # main
collei add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.333648;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="umbrella" refine=5 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; # main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6061 em=118.92 cr=0.2979 cd=0.1324;

# 12 frame swap delay
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active fischl;

# End simulation after 4 rotations
for let i=0; i<4; i=i+1 {
  if i == 0 {
    fischl burst;
    collei burst;
    kazuha skill, high_plunge;
  } else {
    kazuha skill, high_plunge;
    collei burst;
    fischl attack:2, burst;
    kazuha burst;
  }
  keqing skill, burst, skill,
    attack, charge,
    attack, charge,
    attack, skill;
  keqing attack, charge;
  keqing attack, charge;
  kazuha skill, high_plunge;
  fischl skill, attack;
  collei skill, attack;
  keqing skill, burst, skill,
    attack, charge,
    attack, charge,
    attack, skill;
  keqing attack, charge;
  # No final CA to cut rotation time
  keqing attack;
}

# (1st) Fischl Q > Collei Q > Kazuha E hP > Keqing EQE 2N1C N1E 2N1C > Kazuha E hP > Fischl E N1 > Collei E N1 > Keqing EQE 2N1C N1E N1C N1
# (2nd+) Kazuha E hP > Collei Q > Fischl N2 Q > Kazuha Q > Loop at Keqing first combo
