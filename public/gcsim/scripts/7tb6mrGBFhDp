# Yae Furina Ororon Xianyun. ~22s Rot. Yae Taser Plunge. Xianyun refeshes VV mid rotation. Yae uses burst every other rotation, immediately after all plunges are spent, otherwise she fills time for skill CD. Ororon goes before Furina; Ororon A4 is more important for Furina's Energy. 50% Collisons.

# Team - Options listed by DPS
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="flowingpurity" refine=5 lvl=90/90;
yae add set="mh" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3641 cd=0.331;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.2976 er=0.6612 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

for let x=0; x<4; x=x+1 {
  yae skill:3;

  # Furina's ER is more important
  ororon skill, burst;

  furina skill, dash, burst;

  xianyun skill, low_plunge, burst;

  # 3 High plunges into totem refresh
  for let i=0;i<3;i=i+1 {
    if .xianyun.status.xianyun-airborne-buff {
      yae jump;
      if .airborne {
        yae high_plunge[collision=rand()>0.5], dash;
      }
    } else if .yae.normal > 2 {
      yae dash;
    } else {
      yae attack;
    }
  }
  yae skill:3;

  # VV/Hakushin refresh
  xianyun attack:2, charge;

  # Spend remaining plunges
  while .status.yae_oldest_totem_expiry > 480 {
    if .xianyun.status.xianyun-airborne-buff {
      yae jump;
      if .airborne {
        yae high_plunge[collision=rand()>0.5];
      }
      # Avoid dash canceling final plunge
      if .xianyun.status.xianyun-airborne-buff {
        yae dash;
      }
    # When burst is available, skill cd refresh allows you to start the next rot immediately
    } else if .yae.burst.ready && .yae.energy == .yae.energymax {
      yae burst;
      break;
    # Fill time for skill cd
    } else if .yae.normal > 2 && .stam > 68 {
      yae charge, dash;
    } else if .yae.normal > 2 && .stam > 18 {
      yae dash;
    } else {
      yae attack;
    }
  }

}
