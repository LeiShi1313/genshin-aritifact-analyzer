# Sethos Nahida EMC Fischl. VS ASIMON (Abyss). APL. CAs only, CA lvl 2, then CA lvl 1 at low energy.

# Team
sethos char lvl=90/90 cons=6 talent=9,9,9;
#sethos add weapon="hunterspath" refine=1 lvl=90/90;
sethos add weapon="slingshot" refine=5 lvl=90/90;
sethos add set="wt" count=4;
#sethos add set="tf" count=4;
sethos add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
sethos add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
#nahida add weapon="magicguide" refine=5 lvl=90/90;
nahida add set="scroll" count=4;
#nahida add set="gt" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.1324 cd=0.7944;

aetherelectro char lvl=90/90 cons=6 talent=9,9,9;
aetherelectro add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=120];
#aetherelectro add weapon="favsword" refine=3 lvl=90/90;
aetherelectro add set="ins" count=4;
#aetherelectro add set="exile" count=4;
aetherelectro add stats hp=3571 atk=232 er=0.3885 electro%=0.3495 cr=0.311; #main
aetherelectro add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.333648;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
#options duration=90;
#energy every interval=480,720 amount=1;

# Targets
target lvl=100 radius=1.4 pos=0,2.5 type=algorithmofsemiintransientmatrixofoverseernetwork;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4;

# Rotation
active nahida;
nahida skill; # burst;

for {
  switch {
    case !.fischl.oz && .fischl.burst.ready && .fischl.swap.ready:
      fischl attack:2, burst;
    case !.fischl.oz && .fischl.skill.ready && .fischl.swap.ready:
      fischl attack, skill;
    case .sethos.skill.ready && .sethos.energy < 40 && .sethos.swap.ready:
      sethos skill;
    case .sethos.skill.cd && .sethos.energy > 20 && .sethos.swap.ready:
      sethos aim[hold=2];
    case .aetherelectro.skill.ready && .sethos.energy < .sethos.energymax && .aetherelectro.swap.ready:
      aetherelectro skill[hits=3, amulet_delay=80];
    case .aetherelectro.burst.ready && .aetherelectro.swap.ready:
      aetherelectro burst;
    case .nahida.skill.ready && .nahida.swap.ready && !.debuff.res.t0.nahida-e:
      nahida skill, attack, charge;
    #case .nahida.burst.ready && .nahida.swap.ready:
    #  nahida burst;
    default:
      sethos aim[hold=1];
  }
}

