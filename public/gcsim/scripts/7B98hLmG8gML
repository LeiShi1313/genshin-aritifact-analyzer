# Thoma Chevreuse Fischl Bennett. ~16s Rot. Thoma on-field Overload; Thoma bursts as available.
# Fischl snapshots Bennett's buff. Bennett buffed Chevreuse bursts every other rot.

# Team- Options listsed by DPS
thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="deathmatch" refine=1 lvl=90/90 +params=[stacks=5];
thoma add set="emblem" count=4;
#thoma add set="gd" count=4;
#thoma add set="lw" count=4;
thoma add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
thoma add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD + Pyro

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="gt" count=4;
#chev add set="emblem" count=4;
chev add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # Others

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662; # ADC
#bennett add stats hp=4780 atk=311 er=0.518 em=187 em=187 ; #main
#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=158.56 cr=0.2648 cd=0.1324; # EM

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;
#hurt every interval=50, 70 amount=1000,3000 element=physical; # Aggressive
hurt every interval=300, 450 amount=1000,3000 element=physical;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; 

# Rotation
active bennett;

for let i=0; i<4; i=i+1 {
  bennett skill, burst;
  
  # Prioritize burst
  amy attack;
  if !.amy.skill.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
  
  # Burst+C4 Combo every other rotation
  if .chev.burst.ready {
    chev burst, skill[hold=1]:2;
  } else {
    chev skill[hold=1], attack:1;
  }
  
  # Beidou
  while .thoma.mods.bennett-field || .status.bennettburst { 
    switch {
      case .thoma.skill.ready:
        thoma skill;
      case .thoma.burst.ready:
        thoma burst;
      case .thoma.normal > 4 && .thoma.dash.ready && .stam > 18:
        thoma dash;
      default:
        thoma attack;
    }
  }
  
  print("done");
}
