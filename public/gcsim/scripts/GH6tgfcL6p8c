yaemiko char lvl=90/90 cons=0 talent=9,9,9;
yaemiko add weapon="kagurasverity" refine=1 lvl=90/90;
yaemiko add set="thunderingfury" count=2;
yaemiko add set="shimenawasreminiscence" count=2;
yaemiko add set="thundersoother" count=1;
yaemiko add stats def%=0.182 def=35 hp=5288 hp%=0.057999999999999996 atk=361 atk%=0.81 cr=0.6719999999999999 cd=0.971 electro%=0.466;

fischl char lvl=90/90 cons=6 talent=8,10,9;
fischl add weapon="aquasimulacra" refine=1 lvl=90/90;
fischl add set="noblesseoblige" count=2;
fischl add set="thunderingfury" count=2;
fischl add set="paleflame" count=1;
fischl add stats def%=0.182 hp=4989 hp%=0.134 atk=387 atk%=0.7110000000000001 er=0.057999999999999996 em=19 cr=0.774 cd=0.7230000000000001 electro%=0.466;

sucrose char lvl=90/90 cons=6 talent=1,5,4;
sucrose add weapon="wanderingevenstar" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add set="maidenbeloved" count=1;
sucrose add stats def%=0.051 def=16 hp=5647 hp%=0.105 atk=311 atk%=0.244 er=0.6739999999999999 em=713.5 cr=0.128 cd=0.404;

nahida char lvl=90/90 cons=3 talent=1,7,7;
nahida add weapon="prototypeamber" refine=5 lvl=90/90;
nahida add set="instructor" count=4;
nahida add set="deepwoodmemories" count=1;
nahida add stats def%=0.057999999999999996 def=44 hp=4001 hp%=0.047 atk=269 atk%=0.164 er=0.047 em=221.3 cr=0.49 cd=0.42900000000000005 dendro%=0.466;

options iteration=1000 swap_delay=12 duration=120; # Stop sim after 120s have passed
target lvl=100 resist=.1 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

active yae;

while true {
  
  if .yae.tags.totems == 0 { # Create 3 totems if there are none
    yae skill, skill, skill;
    
  } else if !.fischl.oz && .fischl.skill.ready { # Create Oz with either skill or burst if he is absent
    fischl skill, attack;
    
  } else if !.fischl.oz && .fischl.burst.ready {
    fischl attack:2, burst;
    
  } else if .sucrose.skill.ready && !.yae.status.sucrose-a4 && .element.t0.electro { # Sucrose skill if it is ready, her A4 isn't active, and target has electro aura
    sucrose attack, skill, dash;
    
  } else if .sucrose.burst.ready { # Sucrose burst if ready
    sucrose burst;
    
  } else if !.element.t0.quicken { # Nahida hold skill to initiate quicken
    nahida skill[hold=1];
    
  } else if .nahida.burst.ready { # Nahida burst if ready
    nahida burst;
    
  } else if .status.yae_oldest_totem_expiry < 4 * 60 && .yae.burst.ready && .yae.tags.totems == 3 { # If Yae's oldest totem will expire within 4 seconds and her burst is ready, then burst
    yae burst;
      
  } else if !.nahida.mods.instructor-4pc && .nahida.skill.ready { # If Nahida's instructors has expired, bring her in to refresh it
    nahida skill, attack;
      
  } else if .yae.tags.totems < 3 && .yae.skill.ready { # If a totem expires, refresh it
    yae skill, attack;
      
  } else { # If none of the above, then Yae NA spam like a chad
    yae attack;
  }
  
}