tighnari add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

# ----  Default Enemy
options swap_delay=12 debug=true iteration=100 workers=50 mode=sl;
target lvl=100 resist=0.1 hp=100000000 pos=0,0;
energy every interval=480,720 amount=1;

active yae;

# ----  Next rotations
for let i = 0; i < 4; i = i + 1 {
  yae skill:3, attack;
  zhongli skill[hold=1],dash,attack;
  nahida skill,burst,attack;
  tighnari skill,aim:3,burst;
  if .yae.burst.ready {
    yae burst;
    yae attack, charge, dash;
  } else {
    yae attack:2,charge,dash;
    yae attack:2,charge,dash;
  }
  yae attack:2;
}
