# Kazaha Furina Faruzan Xianyun. ~19s Rot. Whale Kazuha Anemo Plunge. Kazuha EPQEPD 4JPD EPD JP N1C.

# Team - Options listed by DPS
kazuha char lvl=90/90 cons=6 talent=9,9,9;
kazuha add weapon="pjc" refine=1 lvl=90/90;
kazuha add set="lno" count=4;
kazuha add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=3 talent=9,9,9;
furina add weapon="favsword" refine=5 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="elegy" refine=1 lvl=90/90;
faruzan add set="no" count=4;
#faruzan add set="vv" count=4;
#faruzan add set="scroll" count=4;
#faruzan add set="gt" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=2 talent=9,9,9;
xianyun add weapon="crane" refine=1 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4; # Bubbles may miss while airborne
#xianyun add set="sodp" count=4;
#xianyun add set="no" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;

  faruzan skill, burst;

  xianyun skill, low_plunge;
  if !.xianyun.burst.ready  {
    xianyun skill, low_plunge;
  }
  xianyun burst;

  while .xianyun.status.xianyun-airborne-buff {
    if .kazuha.skill.ready && .kazuha.burst.ready {
      kazuha skill, high_plunge[collision=1], burst;
    } else if .kazuha.skill.ready {
      kazuha skill, high_plunge[collision=1];
    } else if .kazuha.infusion.kazuha-c6-infusion && .kazuha.mods.kazuha-c6-dmgup > 10 {
      kazuha jump;
      if .airborne {
        kazuha high_plunge[collision=rand()>0.3];
      }
      if .kazuha.status.xianyun-airborne-buff && .kazuha.mods.kazuha-c6-dmgup > 10 {
        kazuha dash;
      }
    } else {
      wait(1);
    }
  }
  kazuha attack, charge;

}
