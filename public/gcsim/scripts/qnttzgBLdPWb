mika add stats hp=4780 atk=311 hp%=0.466 cryo%=0.466 cr=0.311 ; #main
mika add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;																																																														
									
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active furina;

for let i=0; i<4; i=i+1 { 
  furina skill, dash, burst;
  mika burst;
  rosaria skill;
    while !.rosaria.mods.favonius-cd {
    rosaria attack;
  }
  rosaria burst;
  mika skill, attack;
  eula skill, burst, walk, attack:4, skill[hold=1], walk[f=11], attack:4, dash, attack:2;
  rosaria skill;
    while !.rosaria.mods.favonius-cd {
    rosaria attack;
  }
  eula attack:2;
}

