# Keqing Furina Fischl Mika. ~24 Rot. Phys Keqing does N2C in the first half of the rotation, then N1C. Keqing uses burst as Furina's burst expires to fill time and recover stamina. Fischl uses skill and burst every rotation.

# Team
keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="finale" refine=5 lvl=90/90;
#keqing add weapon="rancour" refine=5 lvl=90/90;
#keqing add weapon="blacksword" refine=1 lvl=90/90;
keqing add set="mh" count=4;
keqing add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296; # Other
#keqing add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.2979 cd=0.4634; # TBS

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=0];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=5 lvl=90/90;
mika add set="clam" count=4;
#mika add set="sodp" count=4;
#mika add set="no" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
mika add stats def%=0.124 def=39.36 hp=1523.64 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.1324;

options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 hp=10000000 radius=2 pos=0,2.4;

# Rotations
active fischl;

for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  
  furina skill, dash, burst;
  
  mika burst, attack, skill[hold=0];
  
  keq skill;
  while .fischl.oz {
    if .keq.normal > 2 && .stam > 25 {
      keq charge;
    } else if .keq.normal > 4 && .stam > 18 {
      keq dash;
    } else {
      keq attack;
    }
  }
  
  fischl attack:2, burst;
  
  keq skill;
  while .furina.skill.cd {
  #while .fischl.skill.cd > 30 {
    if .keq.normal > 1 && .stam > 25 {
      keq charge;
    } else if .keq.normal > 4 && .stam > 18 {
      keq dash;
    } else {
      keq attack;
    }
  }
  keq burst;
  
}

