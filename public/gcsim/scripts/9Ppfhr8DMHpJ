# Bennett Furina Fischl Lanyan. ~20s Rot. Bennett Overvape with SubDPS Lanyan. Lanyan uses skill and burst if available immediately following Bennett's burst, infusing a Pyro shield. Lanyan should swirl Electro for VV after Fischl skill/burst in subsequent rotations, or you can use Lanyan skills after Fischl.

# Team
bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="tf" count=4;
#bennett add set="cw" count=4;
#bennett add set="scroll" count=4;
#bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.1986 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # ToM

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # VH
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Others

lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="sacfrags" refine=5 lvl=90/90;
#lanyan add weapon="widsith" refine=3 lvl=90/90;
lanyan add set="vv" count=4;
lanyan add stats hp=4780 atk=311 em=187 anemo%=0.466 cr=0.311; #main
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # EDC
#lanyan add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
#lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # 3EM

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active fischl;
fischl skill;

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  bennett skill, burst;
  
  # Spend all avaiable skills
  while .lanyan.skill.ready {
    lanyan skill:2;
  }
  if .lanyan.burst.ready {
    lanyan burst;
  }
  
  if .amy.skill.ready {
    amy attack, skill;
  } else {
    amy attack:2, burst;
  }
  
  # Refresh VV
  if i > 0 {
    lanyan attack:2;
  }
  
  bennett skill;
  while .furina.skill.cd {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
}

