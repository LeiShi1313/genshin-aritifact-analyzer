options swap_delay=12 iteration=1000;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="widsith" refine=5 lvl=90/90;
columbina add set="notsu" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*5 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*7 cd=0.0662*10;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="ballad" refine=1 lvl=90/90;
ineffa add set="sms" count=4;
ineffa add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*6 cr=0.0331*6 cd=0.0662*8;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="etherlight" refine=5 lvl=90/90;
lauma add set="gd" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*6 cr=0.0331*10 cd=0.0662*3;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=5 lvl=90/90;
furina add set="deepwoodmemories" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

active lauma;
# ----  Actions List
target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999;
energy every interval=480,720 amount=1;

lauma attack;
for let i=0; i<6; i=i+1 {
  columbina skill, burst;

  if .ineffa.burst.ready {
    ineffa burst;
  }
  ineffa skill;

  if i {
    if .furina.skill.ready {
      furina attack, skill, dash;
    } else {
      furina attack:2;
    }
  } else {
    furina skill, dash;
  }

  lauma attack, skill[hold=.dew>0], burst;

  columbina attack, charge, dash, charge, dash, charge, dash, charge;
  if .furina.skill.ready {
    furina attack, skill, dash;
  } else {
    furina attack:2;
  }
  columbina attack, charge, dash, charge, dash, charge;
}
columbina dash, attack; // give time for the last CA's damage to land
