# Freminet Yelan Furina Xilonen. ~23s Rot. Cryo Freminet Shatter with Xilonen and Yelan using 2Es per rotation. Freminet does a lvl 1 Shattering Pressure before Yelan uses burst and does an abbreviated burst between Yelan skills.

# Team
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="tidalshadow" refine=5 lvl=90/90;
freminet add set="mh" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972; # MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active xilonen;

for let i = 0; i < 4; i = i + 1 {
  xilonen burst;

  furina skill, dash, burst;

  if i > 0 {
    while .freminet.skill.ready || .freminet.mods.freminet-pers-time {
      freminet skill;
    }
  }

  yelan burst, attack, skill, attack;

  xilonen skill, attack:2;

  while .yelan.skill.cd {
    if .freminet.skill.ready {
      freminet skill;
    } else if .freminet.burst.ready {
      freminet burst;
    } else {
      freminet attack;
    }
  }
  while .freminet.mods.freminet-pers-time {
    freminet skill;
  }

  yelan skill, attack;

  xilonen skill, attack:2;
}
