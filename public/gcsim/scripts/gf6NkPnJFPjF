mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="obsidiancodex" count=4;
mavuika add stats hp=4780 atk=311 em=186.5 pyro%=0.466 cd=0.622;
mavuika add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 em=158.52 er=0.1101 cr=0.2644 cd=0.6605;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=186.5 em=186.5;
citlali add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 em=39.63 er=0.5505 cr=0.3635 cd=0.3302;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=237.84 cr=0.0662 cd=0.2648;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favwarbow" refine=4 lvl=90/90;
faruzan add set="vv" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

active mavuika;
options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;


for let i=0;i<4;i=i+1 {
  mavuika skill;

  bennett skill, burst;

  if i && .faruzan.burst.ready && .faruzan.energy == .faruzan.energymax {
    faruzan burst;
  } else {
    faruzan skill, attack;
  }

  citlali skill, burst;

  mavuika burst;
  wait(31);
  mavuika charge:3, charge[hold=6], charge[final=1], dash;
  mavuika charge:3, charge[hold=6], charge[final=1], dash;
  mavuika charge, charge[final=1], dash;
}
