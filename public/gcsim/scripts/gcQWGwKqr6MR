options swap_delay=12 iteration=1000;

# Build assumptions
yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="shime" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
yoimiya add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="risingwinds"count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworneye" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
#chev add weapon="dialogues" refine=5 lvl=90/90;
chev add set="scroll" count=4;
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324;


# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active fischl;

fischl skill, attack;
for let i=0; i<4; i=i+1 {
  chev burst, skill[hold=1]:3;
  nicole skill, burst;
  if is_even(i) {
    fischl burst;
    wait(89);   // wait for Q Animation
  } else {
    fischl attack, skill, attack;
  }
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if is_even(i) {
    yoimiya burst;
  } else {
    yoimiya attack, dash; // wait for 18s cd
  }
}
