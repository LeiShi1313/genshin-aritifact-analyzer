# Noelle Furina Gorou Xianyun. ~20s Rot. Noelle plunge in which Noelle bursts when the previous burst expires. Gorou swaps in to replace his skill.

# Team
noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
noelle add set="longnightsoath" count=4;
#noelle add set="mh" count=4;
noelle add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
noelle add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # LNO
#noelle add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
#noelle add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #mainstats
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

gorou char lvl=90/90 cons=6 talent=9,9,9;
gorou add weapon="favbow" refine=4 lvl=90/90;
gorou add set="exile" count=4;
gorou add stats hp=3571 atk=232 er=0.3885 def%=0.43725 cr=0.311 ; #main
gorou add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.07936 atk=26.464 atk%=0.07936 er=0.4408 em=31.712 cr=0.2648 cd=0.31776 ;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #mainstats
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.6061 em=39.64 cr=0.3972 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active noelle; # SS Stacks

for let i = 0; i < 4; i = i + 1 {

  furina skill, dash, burst;
  while !.furina.mods.favonius-cd {
    furina attack;
  }

  xianyun skill, low_plunge, attack, burst;

  gorou attack, skill, burst;
  while !.gorou.mods.favonius-cd {
    gorou attack;
  }

  noelle swap;
  while .xianyun.status.xianyun-airborne-buff {
    if !.noelle.mods.noelle-burst {
      noelle burst;
    }
    if .gorou.skill.ready {
      gorou attack, skill;
    }
    if .xianyun.status.xianyun-airborne-buff {
      noelle jump;
      if .airborne {
        noelle high_plunge[collision=rand()>0.5], dash;
      }
    }
  }
  while .furina.skill.cd {
    if .noelle.skill.ready {
      noelle skill;
    }
    if .noelle.normal > 3 {
      noelle dash;
    } else {
      noelle attack;
    }
  }
}
