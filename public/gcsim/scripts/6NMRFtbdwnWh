# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=0,1.8 hp=100000000;

# Kazuha TF Rotation
fn TFCombo() {
  # Keep Kazuha skill on CD
  if .kazuha.skill.ready {
    kazuha skill, high_plunge[collision=rand()>0.3];
  } else if .kazuha.burst.ready {
    kazuha attack, burst;
  } else {
    kazuha attack;
  }
}

# Rotation
active yae;

for let i=0; i<4; i=i+1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae attack, skill:3;
  }
  
  bennett skill, burst;
  
  # burst over skill
  amy attack;
  if .amy.burst.ready && .amy.energy == .amy.energymax {
    amy attack:1, burst;
  } else {
    amy skill;
  }
  
  # While OZ is on field
  while .status.bennettburst {
  #while .fischl.oz {
    TFCombo();
  }

  print("done");
}
