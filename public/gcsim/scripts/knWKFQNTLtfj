# Gaming Chongyun (C5)Bennett Xianyun. ~22s Rot. Chongyun melts his Q on Bennett's Q. Xianyun only swirls Pyro at the start of the rotation. Gaming weaves NAs after his skill plunges and burst to apply Cryo. 4 Skill Plunges.

# Team
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="scroll"  count=4;
chongyun add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active gaming; # SS stacks
gaming skill, high_plunge; # VV

for let x = 0; x < 4; x = x + 1 {
  xianyun skill, low_plunge, burst;

  bennett skill, burst;

  chongyun burst, skill;

  gaming skill, high_plunge, attack, burst;
  for let p=0; p<3; p=p+1 {
    while !.element.t0.cryo && .status.chongyunfield {
      gaming attack;
    }
    gaming skill, high_plunge;
  }

  bennett skill;
}
