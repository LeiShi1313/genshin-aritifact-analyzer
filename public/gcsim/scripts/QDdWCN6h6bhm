#kequeen qburn with nahida | 27.1s rotation

keqing char lvl=90/90 cons=6 talent=9,9,9;
keqing add weapon="wolffang" refine=1 lvl=90/90;
keqing add set="ur" count=4;
#keqing add set="tf" count=4;
keqing add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622;
keqing add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="ironsting" refine=5 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 em=187 em=187 em=187;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*2 em=19.82*6 cr=0.0331*8 cd=0.0662*2;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="totm" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*10 cd=0.0662*10;

options iteration=1000 swap_delay=12;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=21370000000;

active nahida;

for let i=0; i<6; i=i+1 {
  if .nahida.burst.ready {
    nahida skill, burst;
  }
  else {
    nahida skill, attack:2;
  }
  durin skill:2, burst;
  fischl attack, skill, attack;
  keqing skill, burst, skill,
         attack, charge,
         attack, charge,
         attack, charge,
         attack, charge,
         attack, charge,
         skill, skill,
         attack, charge,
         attack, charge,
         attack, charge;
  fischl attack:2, burst;
  keqing burst, skill, skill, #skill, burst, skill,
         attack, charge,
         attack, charge, #skill,
         attack, charge,
         attack;
}
