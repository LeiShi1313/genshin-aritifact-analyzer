# Raiden Chevreuse Yae Mavuika. ~24s Rot. Raikou with Mavuika. Mavuika uses burst followed by CAs in the first half of the rotation if Fighting Spirit is available, otherwise Yae fills time with N2CD. Mavuika uses skill before Yae bursts every rotation and refreshes her skill. Raiden takes the field in the rear of the rotation, with Chev A1 covered by Mavuika's skill. 

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9; 
raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="totm" count=4;
#raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5958; # HHC
#chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
#chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.4634; # HHH

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="flowingpurity" refine=5 lvl=90/90;
#yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="fohw" count=4;
#yae add set="gt" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # FP
#yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # Widsith

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#mav add weapon="tidalshadow" refine=5 lvl=90/90;
mav add set="scroll" count=4;
mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; 

# Rotation
active mav; # SS Stacks
#active raiden;

raiden skill;

for let i = 0; i < 4; i = i + 1 {
  yae skill:3;
  
  chev burst, skill[hold=1]:3;
  
  if .mav.burst.ready {
    mav burst,
      charge:2, dash,
      charge:2, dash,
      charge:2, dash,
      charge, charge[final=1], dash, skill, dash;
  } else {
    yae attack:2, charge, dash;
    yae attack:2, charge, dash;
    
    mav attack, skill;
  }
  
  yae burst, attack, skill:3;
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:3;
}

