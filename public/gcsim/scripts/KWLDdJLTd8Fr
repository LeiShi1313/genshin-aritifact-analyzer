# Arlecchino Escoffier Emilie Bennett. ~16s Rot. Arlecchino Burning with Escoffier Melt. Arle N1C 5N3D N3. Escoffier bursts every other rotatation.

# Team - Options listed by DPS
arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
arle add set="ur" count=4;
#arle add set="fohw" count=4;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="fjords" refine=1 lvl=90/90;
#escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="ur" count=4;
#escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Fjords
#escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
#escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.3641 cd=0.662; # DM

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
#emilie add set="deepwood" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
#bennett add set="deepwood" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active arle;

for let i=0; i<4; i=i+1 {
  arle skill;

  bennett skill, burst;

  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  if .esco.burst.ready && i > 0 {
    esco burst, skill;
  } else {
    esco skill, attack;
  }

  arle attack:1, charge[early_cancel=0], dash:0,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3;
}
