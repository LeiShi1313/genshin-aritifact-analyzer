yanfei char lvl=90/90 cons=6 talent=9,9,9;
yanfei add weapon="thewidsith" refine=3 lvl=90/90;
yanfei add set="mh" count=4;
yanfei add stats hp=4780 hp%=0 atk%=0 atk=311 def%=0 em=187 heal=0 phys%=0 er=0 cr=0 pyro%=0.466 cd=0.622;
yanfei add stats def=39.36 def%=0.124 em=79.28 atk=33.08 hp=507.88 hp%= 0.0992 atk%=0.0992 er=0.1102 cr=0.3972 cd=0.662 ;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 hp%=0.466 atk%=0 atk=311 def%=0 em=0 heal=0 phys%=0 er=0 cr=0.311 hydro%=0.466 cd=0;
furina add stats def=39.36 def%=0.124 em=39.64 atk=33.08 hp=507.88 hp%= 0.0992 atk%=0.0992 er=0.2755 cr=0.331 cd=0.7282 ;


xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="viridescentvenerer" count=5;
xianyun add stats hp=4780 hp%=0 atk%=0.932 atk=311 def%=0 em=0 heal=0 phys%=0 er=0.518 cr=0 anemo%=0 cd=0;
xianyun add stats def=39.36 def%=0.124 em=39.64 atk=165.4 hp=507.88 hp%= 0.0992 atk%=0.3968 er=0.4408 cr=0.0662 cd=0.1324 ;


bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 hp%=0 atk%=0.466 atk=311 def%=0 em=0 heal=0 phys%=0 er=0 cr=0.311 pyro%=0.466 cd=0;
bennett add stats def=39.36 def%=0.124 em=39.64 atk=33.08 hp=507.88 hp%= 0.0992 atk%=0.0992 er=0.6612 cr=0.331 cd=0.2648 ;


options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,3;
energy every interval=480,720 amount=1;

active furina;

let rotations = 4;

for let r = rotations; r > 0; r = r - 1 {

  furina attack, skill, dash, burst;

  xianyun skill, low_plunge, burst;

  bennett skill, burst, attack;


  xianyun attack[travel=0]:2, dash;

  yanfei skill;
  for let h = 8; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      wait(30);
      yanfei jump;
      if.airborne{
        yanfei high_plunge[collision=1];
      }
    } else {
      wait(30);
      yanfei jump;
      if.airborne{
        yanfei high_plunge;
      }
    }
  }
  yanfei attack, skill;

  bennett skill;

}
