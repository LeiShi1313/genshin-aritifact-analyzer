# Options
options iteration=1000;
#options iteration=100;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard Energy Assumptions

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Protoype Crescent Headshot Conditional
fn lyneyAim() {
  if .lyney.weapon == .keys.weapon.crescent { # Attempts headshots (50%) with Crescent
    lyney aim[hold=2, weakspot=rand()>0.5];
  } else { # Non weakspot opponents
    lyney aim[hold=2];
  }
}

# Wait for cryo Conditional
fn WaitForCryo() {
  let StartFrame = f();
  if !.element.t0.pyro {      # If the enemy aura is not Pyro, wait for Cryo aura (so if its already Pyro you don't wait)
    while !.element.t0.cryo && f() - StartFrame < 120 {   # wait but up to 120f(2s), so you don't wait forever
      wait(1);
    }
  }
}

active bennett;

for let i=0; i<5; i=i+1 { # Team runs an odd amount of rotations for TTDS to inflate DPS
#for let i=0; i<4; i=i+1 {

  bennett skill, burst;

  xilonen skill, attack:2; pick_up_crystallize("pyro");

  citlali skill, burst;

  lyneyAim();
  WaitForCryo();
  lyneyAim();
  if .lyney.burst.ready {
    WaitForCryo();
    lyney burst; delay(11); # to avoid canceling his burst without dealing damage
    lyney skill;
  } else {
    lyneyAim();
  }
  lyneyAim();
  WaitForCryo();
  lyneyAim();
  WaitForCryo();
  lyney skill;
  lyneyAim();
}
