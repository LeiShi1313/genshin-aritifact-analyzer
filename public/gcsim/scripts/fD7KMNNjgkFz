# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active zhongli;

for let r = 4; r > 0; r = r - 1 {
  zhongli skill[hold=1], dash;
  # Guarantee Fav
  #while !.zhongli.mods.favonius-cd {
  #  zhongli attack;
  #}
  
  xianyun skill, low_plunge, burst;
  
  chiori skill:2;
  
  xiao skill:2, burst;
  for let h = 10; h > 0; h = h - 1 {
      xiao jump, high_plunge[collision=rand()>0.5];
  }
  
  print("done");
}
