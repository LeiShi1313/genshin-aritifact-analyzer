# Razor Nahida Furina Charlotte. ~25s Rotation. Hybrid Razor's damage is split between Dendro, Electro, and Phys. Razor prefers two ATK% mainstats at KQMS. Nahida tries to burst every over rotation. Charlotte uses hold skill.

# Team - Options listed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="risingwinds" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*5 cr=0.0331*11 cd=0.0662*10; # ATK/ATK
#razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*5 cr=0.0331*11 cd=0.0662*10; # ATK/Electro
#razor add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10; # EM/EM
#razor add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*3 em=19.82*2 cr=0.0331*11 cd=0.0662*10; # EM/Electro
#razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622;
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*3 cr=0.0331*11 cd=0.0662*10; # ATK/Phys

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*11 em=19.82*6 cr=0.0331*5 cd=0.0662*6;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # ToM
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
#furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # GT

charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="favcodex" refine=3 lvl=90/90;
charlotte add set="ohc" count=4;
#charlotte add set="no" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
charlotte add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*10 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*6;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active razor; # Serpent Spine stacks
#razor skill, dash; # Sigils for 1st burst

for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }

  furina skill, dash;
  if !.furina.burst.ready {
    furina attack;
  }
  furina burst;

  charlotte skill[hold=1], burst, attack;

  # Razor out of burst actions; account for energy deficiency
  while !.razor.mods.razor-q {
    if .razor.burst.ready && .razor.skill.ready {
      razor skill, dash, attack, burst, attack, skill, dash;
    } else if .razor.burst.ready {
      razor burst;
    } else if .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  # Razor Main DPS window
  while .razor.mods.razor-q > 210 { # 3 skill uses
    if .razor.normal > 3 && .razor.skill.ready {
        razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}
