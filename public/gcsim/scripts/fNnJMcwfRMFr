# Dori Emilie Fischl Durin. ~20s Rot. Dori Quickburn with long field time Dori enabled by TF & 42% Burning uptime. Emilie bursts every other rotation after the first. Fischl alternates skill and burst, then Dori stays on field for 3 skill uses, as her C6 infusion downtime is near eliminated. EM and Talent DMG durin are similar.

# Team - Options listed by DPS
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
dori add set="tf" count=4;
dori add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
dori add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*5 cr=0.0331*12 cd=0.0662*9; # EDC
#dori add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
#dori add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10; #EEC

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
#emilie add set="deepwood" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="lionsroar" refine=3 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*6 em=19.82*2 cr=0.0331*9 cd=0.0662*7;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active dori; # SS Stacks

for let i=0; i<4; i=i+1 {
  # Burst in 2nd Rot onward
  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst, attack:1;
  } else {
    emilie skill, attack:1;
  }

  durin skill:2, burst;

  if .fischl.skill.ready {
    fischl attack:1, skill, attack:1;
  } else {
    fischl attack:2, burst;
  }

  dori skill, attack:2, dash, attack:2, burst; # TF consistency
  dori skill, attack:2, dash, attack:2;
  dori skill, attack:2, dash, attack:2;
}
