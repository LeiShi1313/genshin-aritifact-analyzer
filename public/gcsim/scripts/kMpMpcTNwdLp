#Noelle Zhongli Yelan Furina, AP Zhongli dash to pick up crystallize.

options swap_delay=12 iteration=1000;

noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
noelle add set="mh" count=4;
noelle add stats hp=4780 atk=311 def%=0.583 def%=0.583 cd=0.622;
noelle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.640 cr=0.3310 cd=0.4634;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="ap" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.640 cr=0.3310 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9; 
yelan add weapon="favoniuswarbow" refine=3 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.2204 em=39.640 cr=0.3310 cd=0.6620;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.640 cr=0.3972 cd=0.6620;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active zhongli;
for let x=0; x<4; x=x+1 {
 zhongli skill[hold=1], dash;
  pick_up_crystallize("any");
 while !.zhongli.mods.favonius-cd { zhongli attack; }
 furina  skill, dash, burst;
 yelan   burst, attack, skill, attack;
 noelle  skill, burst;
 noelle  attack:3;
 zhongli attack, dash, attack;
  pick_up_crystallize("any");
 noelle  attack:3, dash;
 noelle  attack:3;
 yelan   skill, attack;
 noelle  attack:4;
}

