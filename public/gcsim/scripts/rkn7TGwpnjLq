# Klee Xingqiu Nahida Baizhu. ~22s Rot. Klee Burgeon with Xingqiu. Klee uses CA with when sparks are avialable and does N1W until Xingqiu's burst expires otherwise. Nahida bursts every other rotation after the first.

# Team
klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="evenstar" refine=1 lvl=90/90;
klee add set="fopl" count=4;
#klee add set="cw" count=4;
klee add stats hp=4780 atk=311 em=187 em=187 em=187; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=118.92 cr=0.3641 cd=0.2648;

xingqiu char lvl=90/90 cons=6 talent=9,9,9; 
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="eosf" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;  
nahida add set="deepwood" count=4;
#nahida add set="scroll" count=4;
#nahida add set="tom" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=59.46 cr=0.3641 cd=0.7944;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="pamber" refine=5 lvl=90/90;
baizhu add set="ohc" count=4;
#baizhu add set="deepwood" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
baizhu add stats def%=0.124 def=39.36 hp=2539.4 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active nahida;

for let i=0; i<4; i=i+1 { 
  nahida skill;
  if i > 0 && .nahida.burst.ready  && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida attack:2;
  }
  
  xingqiu skill, dash, burst, attack;
  
  baizhu skill, attack, burst;
  
  while .xingqiu.mods.xingqiuburst {
    switch {
      case (.previous-action == .action.charge || .previous-action == .action.skill) && .stam > 18:
        klee dash;
      case .klee.skill.ready:
        klee attack, skill[bounce=3, mine=8];
      case .klee.mods.a1-spark && .previous-action == .action.walk:
        klee attack, charge, jump;
      case .previous-action == .action.attack:
        klee walk;
      default:
        klee attack;
    }
  }
  
}
