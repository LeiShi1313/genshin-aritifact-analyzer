# Razor DMC Xingqiu Bennett. ~24s Rotation. Razor Hyperburgeon with C6 Bennett. Razor runs Fav for the team to rotate smoothly. Self-Overloads not implemented.

razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="favgs" refine=3 lvl=90/90;
razor add set="gd" count=4;
razor add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

aetherdendro char lvl=90/90 cons=6 talent=9,9,9;
aetherdendro add weapon="favsword" refine=3 lvl=90/90;
aetherdendro add set="deepwood" count=4;
aetherdendro add stats hp=4780 atk=311 er=0.518 dendro%=0.466 cr=0.311 ; #main
aetherdendro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="ins" count=4; bennett add set="gd" count=1;
bennett add stats hp=3571 atk=232 er=0.3885 em=140.25 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.331 cd=0.2648;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

#Rotation
active razor;
razor skill, dash;

for let i=0; i<4; i=i+1 {
  xingqiu skill, dash, burst, attack;
  
  aetherdendro skill, attack, burst, attack;
  
  bennett skill, attack, burst;
  
  razor skill, dash, attack, burst,
    attack, skill, dash,
    attack:3, dash,
    attack:3, dash,
    attack:3, skill, dash,
    attack:3, dash,
    attack:3, dash,
    attack:2, skill, dash;
    
  print("done");
}

