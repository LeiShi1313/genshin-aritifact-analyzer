target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active navia;
  
  zl skill[hold=1], dash;
  
  navia skill, burst;
  
  yelan skill, burst, attack;
  
  bennett skill, burst, attack;
  
  navia attack, skill, attack:2, dash, attack:2, dash, attack:2;
  
  yelan attack, skill, attack;

  navia attack, skill, attack:2, dash, attack:2, dash, attack:2, skill, attack;
for let i=0; i<2; i=i+1 {
  navia attack;
  if i {
    navia attack;
  }
  zl skill[hold=1], dash;
  while !.zl.mods.favonius-cd {
    zl attack;
  }
  navia burst;
  
  yelan skill, burst, attack;
  if !.yelan.mods.favonius-cd {
    yelan attack;
  }
  
  bennett skill, attack, burst, attack;
  
  navia attack, skill, attack:2, dash, attack:2, dash, attack:3;
  
  yelan skill, attack;
  
  navia attack, skill, attack:2, dash, attack:2;

}
navia skill[hold=1];