options swap_delay=12 iteration=1000;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="widsith" refine=5 lvl=90/90;
columbina add set="notsu" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*3 cr=0.0331*7 cd=0.0662*10;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="ballad" refine=1 lvl=90/90;
ineffa add set="deepwood" count=4;
ineffa add stats hp=4780 atk=311 em=187 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*10 cr=0.0331*9 cd=0.0662*7;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="etherlight" refine=5 lvl=90/90;
lauma add set="sms" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*8 em=19.82*6 cr=0.0331*12 cd=0.0662*2;

jahoda char lvl=90/90 cons=6 talent=9,9,9;
jahoda add weapon="favbow" refine=5 lvl=90/90;
jahoda add set="ins" count=4;
jahoda add stats hp=3571 atk=232 em=139 em=139 cr=0.311; #main
jahoda add stats def%=0.05208*2 def=16.5312*2 hp=213.31*2 hp%=0.041664*2 atk=13.8936*2 atk%=0.041664*2 er=0.046284*6 em=16.6488*2 cr=0.027804*10 cd=0.055608*2;


target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active lauma;

lauma attack;
for let i = 0; i < 6; i = i + 1 {
  if is_even(i) {
    columbina burst;
  }
  columbina skill;

  ineffa skill;

  if .jahoda.burst.ready {
    jahoda burst;
  }
  jahoda skill;

  lauma attack, skill[hold=.dew > 0], burst;

  columbina attack, charge, dash, charge, dash,
            attack, charge, dash, charge;
  jahoda attack:2;
  columbina charge, dash, charge, dash, attack, charge;
}
columbina dash, attack; // give time for the last CA's damage to land
