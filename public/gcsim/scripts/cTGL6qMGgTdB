bennett char lvl=90/90 cons=6 talent=9,9,9 ; 
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; 
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662 ;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mavuika;
  
mavuika skill;
  
for let i=0; i<5; i=i+1 {
  
  if i {
    bennett skill, burst;
  } else {
    bennett burst, skill;
  }
  
  xilonen skill, attack:2;
  rosaria burst, skill, dash; pick_up_crystallize("pyro");
  delay(6);
  mavuika burst, charge:3, charge[hold=8], charge[final=1],
           dash, charge:3, charge[hold=33], charge[final=1];
  mavuika dash, charge, dash;
  rosaria skill;
  mavuika skill[hold=1], charge, dash;

}
