clorinde char lvl=90/90 cons=6 talent=10,10,10;
clorinde add weapon="absolution" refine=5 lvl=90/90;
clorinde add set="echoes" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

ororon char lvl=90/90 cons=6 talent=10,10,10;
ororon add weapon="elegy" refine=5 lvl=90/90;
ororon add set="scroll" count=5;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mavuika char lvl=90/90 cons=6 talent=10,10,10;
mavuika add weapon="tbs" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=10,10,10;
chevreuse add weapon="symphonistofscents" refine=5 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.1324;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active mav;

# opener
ororon skill, burst;
chevreuse burst, skill[hold=1];
mav skill, burst, charge:4, dash; # mav empowered CAs to fill rotation time
clorinde_combo();

for let i = 0; i < 4; i = i + 1 { # 18s rotation

  chevreuse skill[hold=1];
  if .chevreuse.burst.ready {
    chevreuse burst;
  }

  if .clorinde.burst.ready {
    clorinde burst;
  }

  ororon skill, burst;
  mav burst, charge:2, dash, charge:2, dash, charge:2, dash, skill; # mav empowered CAs to fill rotation time
  clorinde_combo();

}
