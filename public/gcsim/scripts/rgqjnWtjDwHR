wrio char lvl=90/90 cons=0 talent=9,9,9;
wrio add weapon="widsith" refine=3 lvl=90/90; 
wrio add set="bs" count=4;
wrio add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
wrio add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="ttds" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.551 em=158.56 cr=0.0662 cd=0.1324;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favlance" refine=3 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.3306 em=39.64 cr=0.331 cd=0.1324;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=5000000; 
active furina;

# Furina EQ/QE > Shenhe hEQ > Xianyun EP Q N1 > Wrio E 4N3CJP N3CD [Q]
# Force Fav Procs
for let i=0; i<4; i=i+1 {
  if !i {
    furina skill, dash, burst;
  } else {
    furina burst, skill, dash;
  }
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  shenhe skill[hold=1], burst;
  while !.shenhe.mods.favonius-cd {
    shenhe attack;
  }
  xianyun skill, low_plunge, burst, attack;
  wrio skill;
  for let n=0; n<4; n=n+1 {
    let col = rand();
    wrio attack:3, charge, jump;
    if .airborne {
      if col > 0.5 {
        wrio high_plunge[collision=1];
      } else {
        wrio high_plunge;
      }
    }
  }
  wrio attack:3, charge, dash;
  if .wrio.burst.ready {
	  wrio burst;
  }
}