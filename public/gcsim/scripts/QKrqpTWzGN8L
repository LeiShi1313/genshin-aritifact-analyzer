# PMC Chevreuse Fischl Ororon. ~16s Rot. PMC double electro on field. PMC uses burst when available to fit the rotation length. PMC uses hE. PMC does N3D as available. PMC want a bit of EM. Chevreuse bursts every rot.

# Team- Options listsed by DPS
aetherpyro char lvl=90/90 cons=6 talent=9,9,9  +params=[base_atk_buff=1, skirk_story_buff=1];
aetherpyro add weapon="finale" refine=5 lvl=90/90;
#aetherpyro add weapon="lionsroar" refine=3 lvl=90/90;
#aetherpyro add weapon="umbrella" refine=5 lvl=90/90;
#aetherpyro add weapon="harbinger" refine=5 lvl=90/90;
aetherpyro add set="oc" count=4;
aetherpyro add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
aetherpyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Finale/LR
#aetherpyro add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#aetherpyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Umbrella
#aetherpyro add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#aetherpyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=178.38 cr=0.2317 cd=0.662; # HoD

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="no" count=4;
#chev add set="sodp" count=4;
#chev add set="emblem" count=4;
chev add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.331; # NO > SODP
#chev add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
#chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282; # Emblem

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="chainbreaker" refine=5 lvl=90/90;
#ororon add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=0];
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2648 cd=0.7282;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; # Far right

# Rotation
active ororon;

for let i=0; i<4; i=i+1 {
  ororon skill, burst;

  # Every other Rotation, Every rotation with NO
  if .chev.burst.ready || .chev.sets.no >= 4 {
    chev burst, skill[hold=1]:2;
  } else {
    chev skill[hold=1], attack;
  }

  if !.amy.skill.ready {
    amy attack:2, burst;
  } else {
    amy attack, skill;
  }

  while .fischl.oz {
    switch {
      case .aetherpyro.skill.ready:
        aetherpyro skill[hold=1], attack:1;
      case .aetherpyro.burst.ready:
        aetherpyro burst;
      #case .aetherpyro.normal > 3 && .stam > 25: # N2C
      #  aetherpyro charge;
      case .aetherpyro.normal > 3 && .aetherpyro.dash.ready && .stam > 18: # N3D
        aetherpyro dash;
      default:
        aetherpyro attack;
    }
  }

  print("done");
}
