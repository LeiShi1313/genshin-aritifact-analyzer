bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*15 em=19.82*2 cr=0.0331*10 cd=0.0662*2;

#This rotation of Lynette Mav Melt requires above KQMS ER, but it's the strongest one known.

options swap_delay=12 iteration=1000;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

energy every interval=480,720 amount=1;

fn mav_dc_cancel(d_travel_f) { # d_travel_f should be 6-24. https://docs.gcsim.app/reference/characters/mavuika#params
  # To prevent Error when Mavuika tries to do D*C without enough NS points, jump instead.
  if d_travel_f < 6 {
    d_travel_f = 6;
  }

  let dash_ns = 10; # 10 consumption on dash use
  let base_cons = 0.9; # 0.9 points
  let base_tick_rate = 6;

  while !.mavuika.dash.ready {
    print("waiting on mavuika dash cd");
    wait(1);
  }

  let d_ticks = d_travel_f / base_tick_rate + 1; # +1 in case you get unlucky with tick timing
  print("Max number of NS ticks during dash: ", d_ticks);
  let ns_consumed = dash_ns + base_cons * d_ticks;
  print("Expected NS consumption: ", ns_consumed);

  if .mavuika.nightsoul.points > ns_consumed || .mavuika.status.mavuika-burst {
    mavuika dash[charge_cancel=1, travel=d_travel_f], charge;
  } else {
    print("current NS points = ", .mavuika.nightsoul.points);
    print("skipping mav d*c, not enough NS points ");
    mavuika jump;
  }
}

set_particle_delay("lynette", 70);

active mavuika;
for let i=0; i<5; i=i+1 {
  if i== 0 {
    mavuika skill[hold=1];
  } else {
    mavuika skill[hold=1];
    mavuika charge;
    mav_dc_cancel(6); mavuika charge;
    mav_dc_cancel(6);
  }
  citlali attack, skill;
  if !.citlali.mods.favonius-cd {
    citlali attack;
  }
  bennett burst;
  if !.citlali.mods.favonius-cd {
    citlali attack;
  }
  citlali burst;
  lynette skill, burst;
  mavuika burst;
  mavuika charge;
  mav_dc_cancel(6); mavuika charge;
  mav_dc_cancel(6); mavuika charge;
  mavuika charge[final=1];
  mav_dc_cancel(6); mavuika charge;
  mav_dc_cancel(6); mavuika charge;
  delay(15);
  mavuika charge[final=1];
  mav_dc_cancel(6);
  if i== 0 {
    mav_dc_cancel(6);
  }
}
#In-game, the rot should be used like so: Mav hE > Citlali E > Bennett Q > Citlali Q > Lynette EQ > Mav Q CdcCdcC F dcCdcC (delay) F dc~CdcF (12s combo)
#contact @enigwa for more information about this team.
