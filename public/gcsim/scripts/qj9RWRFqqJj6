options swap_delay=12 iteration=1000;

kinich char lvl=90/90 cons=0 talent=9,9,9;
kinich add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
kinich add set="obsidiancodex" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622 ; #main
kinich add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*2 cd=0.0662*2;
kinich add stats atk%=0.0496*6 cr=0.0331*6 cd=0.0662*8; # distributed subs

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="sealord" refine=5 lvl=90/90;
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
mavuika add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*2 cd=0.0662*2; # flat subs
mavuika add stats atk%=0.0496*2 cr=0.0331*8 cd=0.0662*10; # distributed subs

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*2 cd=0.0662*2; # flat subs
bennett add stats er=0.0551*8 cr=0.0331*4 cd=0.0662*8; # flat subs
 
lauma char lvl=90/90 cons=0 talent=9,9,9; 
lauma add weapon="ttds" refine=5 lvl=90/90;
lauma add set="deepwood" count=4;
lauma add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*2 cd=0.0662*2; # flat subs
lauma add stats em=19.82*2 cr=0.0331*8 cd=0.0662*10; # distributed subs

active kinich;

target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999; 
energy every interval=480,720 amount=1;

fn kinich_combo(shorthold) {
  if shorthold == true {
    for let c=0; c<5; c=c+1 { 
      kinich attack[direction=1]:2;
      while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
        wait(1);
      }
      if .kinich.nightsoul.state {
        kinich skill[hold=1];
      }
    }
  }
  if shorthold == false {
    kinich attack[direction=1]:1;
    for let c=0; c<4; c=c+1 {
      kinich attack[direction=1]:2;
      while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
        wait(1);
      }
      if .kinich.nightsoul.state {
        kinich skill[hold=0];
      }
    }
  }    
}

lauma attack; # apply Dendro for Scroll

# Scroll only lasts for the first rotation and a half due to uninterrupted Burning uptime, so sim only lasts for 2 rotations.
# 4 rotations is -4–5k dps (87.7k)

for let i=0; i<2; i=i+1{ 
  
  mavuika burst;
  if is_even(i) { # for rotations following ones without Kinich's burst, fills out time to prevent his skill being on cooldown
    mavuika charge; # slight DPS loss (~400) to include with only 2 rotations
  }
  mavuika skill, dash;
  
  bennett burst, skill;
  
  lauma skill[hold=0];
  
  kinich skill;
  kinich_combo(true); # true for shorthold E (5E combo), false for tap E (4E combo). -11k dps (80.8k) with 4E.
  if .kinich.burst.ready {
    kinich burst;
  }
}
