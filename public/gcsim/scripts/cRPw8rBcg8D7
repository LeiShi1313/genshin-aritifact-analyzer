yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="shime" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main 5* set
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yaemiko char lvl=90/90 cons=0 talent=9,9,9;
yaemiko add weapon="thewidsith" refine=3 lvl=90/90;
yaemiko add set="gt" count=5;
yaemiko add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
yaemiko add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.1324 ;

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="favoniuslance" refine=3 lvl=90/90;
thoma add set="no" count=4;
thoma add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active yae;
for let i=0; i<4; i=i+1 {

  if i==0 || i==2 {
    yae skill:3;
    chevreuse burst, skill[hold=1], attack;
    thoma attack, burst, skill, attack;
    yae burst;
  } else {
    chevreuse burst, skill[hold=1]:3;
    thoma attack, burst, skill, attack;
  }
  yae skill:3;
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if i==0 || i==2 {
    yoimiya burst;
  }
}
#Yae 3E > Chev Q hE N1 > Thoma N1 Q E N1 > Yae Q 3E > Yoimiya E 3[N5D] N1 Q >
