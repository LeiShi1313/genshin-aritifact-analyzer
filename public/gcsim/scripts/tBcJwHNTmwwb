# Ganyu Furina Kazuha Charlotte. ~21s Rot. On-field Freeze DPS Ganyu in two target does 2 Es per rotation. Assumes freezable enemies and high ability to headshot.

# Team - Options Listed by DPS
ganyu char lvl=90/90 cons=0 talent=9,9,9;
ganyu add weapon="crescent" refine=5 lvl=90/90;
#ganyu add weapon="songofstillness" refine=5 lvl=90/90;
ganyu add set="bs" count=4;
#ganyu add set="mh" count=4;
ganyu add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.5296; # ToM

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favsword" refine=3 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=118.92 cr=0.3972 cd=0.331;

charlotte char lvl=90/90 cons=6 talent=9,9,9;
charlotte add weapon="ttds" refine=5 lvl=90/90;
#charlotte add weapon="favcodex" refine=5 lvl=90/90;
charlotte add set="no" count=4;
#charlotte add set="scroll" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=1.9,2.4 hp=100000000;
target lvl=100 resist=0.1 radius=1.5 pos=-1.9,2.4 hp=100000000;

# Rotation
active furina;

for let x = 0; x < 4; x = x + 1 {
  furina skill, dash, burst;

  kazuha skill, high_plunge;

  charlotte skill, burst;

  ganyu aim[hold=2, weakspot=rand()>0.2], skill, burst;

  kazuha skill, high_plunge, burst;

  ganyu aim[hold=2, weakspot=rand()>0.2],
        aim[hold=2, weakspot=rand()>0.2],
        aim[hold=2, weakspot=rand()>0.2],
        skill,
        aim[hold=2, weakspot=rand()>0.2];
}
