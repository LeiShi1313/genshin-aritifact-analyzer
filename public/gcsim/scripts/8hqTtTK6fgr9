options swap_delay=12 iteration=1000;

# Build assumptions
ayaka char lvl=90/90 cons=0 talent=9,9,9;
ayaka add weapon="finale" refine=5 lvl=90/90;
//ayaka add set="bs" count=4;       # if the enemy is Freezable 4BS is better than 4MH
ayaka add set="mh" count=4;
ayaka add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
ayaka add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=3 lvl=90/90;
yelan add set="no" count=4;
//yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
//escoffier add set="scroll" count=4;    # 4Scroll has slightly better team DPS
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.3306 em=39.64 cr=0.2317 cd=0.662;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  escoffier skill, burst;
  yelan burst, attack, skill, attack;
  ayaka skill, dash, attack, burst,
        attack:3, charge, dash,
        attack:2, charge,
        attack:2, charge;
  yelan attack, skill, attack;
  ayaka skill, dash,
        attack, charge;
}

# Furina ED Q > Escoffier EQ > Yelan Q N1 E N1 > Ayaka ED N1 Q N3CD 2[N2C] > Yelan N1 E N1 > Ayaka ED N1C
