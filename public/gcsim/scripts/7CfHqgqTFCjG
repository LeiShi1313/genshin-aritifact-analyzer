#Characters
xilonen char lvl=90/90 cons=2 talent=8,10,8;
xilonen add weapon="peakpatrolsong" refine=1 lvl=90/90;
xilonen add set="paleflame" count=1;
xilonen add set="scrolloftheheroofcindercity" count=4;
xilonen add stats def%=0.9909999999999999 def=150 hp=5049 atk=346 atk%=0.152 er=0.985 cr=0.132 cd=0.552 geo%=0.466;

arlecchino char lvl=90/90 cons=6 talent=10,10,10;
arlecchino add weapon="crimsonmoonssemblance" refine=2 lvl=90/90;
arlecchino add set="tenacityofthemillelith" count=1;
arlecchino add set="fragmentofharmonicwhimsy" count=4;
arlecchino add stats def%=0.057999999999999996 def=16 hp=4989 hp%=0.175 atk=330 atk%=0.519 er=0.091 em=118 cr=0.545 cd=1.337 pyro%=0.466;

furina char lvl=90/90 cons=6 talent=7,10,10;
furina add weapon="key" refine=5 lvl=90/90;
furina add set="tenacity" count=4;
furina add set="shimenawasreminiscence" count=1;
furina add stats def=23 hp=6214 hp%=0.933 atk=378 er=0.9590000000000001 cr=0.5449999999999999 cd=0.43500000000000005;

bennett char lvl=90/90 cons=6 talent=3,6,10;
bennett add weapon="freedom" refine=1 lvl=90/90;
bennett add set="noblesseoblige" count=4;
bennett add set="paleflame" count=1;
bennett add stats def=62 hp=6155 hp%=0.5940000000000001 atk=358 atk%=0.16399999999999998 er=1.236 em=42 cr=0.28400000000000003 cd=0.07 phys%=0.583;

#Options
options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active arlecchino;

#Actions
for let i = 0; i < 4; i = i + 1 {
  
  if.arlecchino.skill.ready {
    arlecchino skill;
  }

  furina skill, attack:3, burst;
  bennett skill, burst, attack:1;
  
  if .xilonen.burst.ready {
    xilonen skill, burst, attack:2;
  } else {
    xilonen skill, attack:2;
  }
  
  if .arlecchino.skill.ready {
    arlecchino skill;
  }
  
  if .arlecchino.burst.ready {
    arlecchino burst, skill, charge;
  } else {
    arlecchino charge;
  }
  
  while .furina.fanfare {
    arlecchino attack:3, dash;
  }

}

#Single Target C6 Arle Vape with C6 Furina. 
#N3D Combo during Buff Uptime. 
#C6 Benny Required for Pyro Scrolls Proc  
#~24s rotation