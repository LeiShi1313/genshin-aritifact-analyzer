options swap_delay=12 iteration=1000;


fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="polarstar" refine=5 lvl=90/90;
fischl add set="thundersoother" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;



active fischl;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=2200000;
energy every interval=480,720 amount=1;


while 1 {
  if !.fischl.oz && ( .fischl.skill.ready ||.fischl.burst.ready) {
    if .fischl.skill.ready {
      fischl skill;
    } else {
      fischl burst;
    }
  } else if !.fischl.mods.polar-star-charged {
    fischl aim;
  } else if .fischl.normal == 5 {
    if .stam > 20 {
      fischl dash;
    } else {
      fischl jump;
    }
  } else {
    fischl attack;
  }

}
