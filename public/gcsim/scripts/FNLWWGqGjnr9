escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main 
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*9 er=0.0551*2 em=19.82*2 cr=0.0331*7 cd=0.0662*10;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  mualani skill;
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

active furina;

for let i=0; i<3; i=i+1 {
  furina skill, dash, attack;
  if i {
    furina attack;
    esco attack;
  }
  escoffier skill, burst;
  furina burst, attack;
  skirk skill[hold=1], burst;
  mualani_combo();
  mualani skill, burst;
  
  esco skill, attack:2;
  skirk skill[hold=1], burst;
  mualani_combo();
}

