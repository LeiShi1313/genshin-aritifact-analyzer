xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="ap" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*9 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*7;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mona;

for let i=0; i<3; i=i+1 {

  # BURST PHASE

  mona skill, attack;
 
  xilonen skill, attack:2;
  
  xiangling burst, skill, dash;
  pick_up_crystallize("hydro");
  
  mona burst;
  
  mualani skill,
          walk[f=2], burst,
          walk[f=46], attack,
          walk[f=90], attack,
          skill;
  
  # BITE PHASE
  
  xilonen burst;
  
  mona attack, charge; # Mona must be the one to remove Pyro for 4p Instructor
  
  xilonen skill, attack:2;
  
  xiangling skill, dash, attack;
  pick_up_crystallize("hydro");
  
  mualani skill,
          walk[f=90], attack,
          walk[f=90], attack,
          walk[f=90], attack,
          skill;
  
}

# 15-16s rotations
# Mona E N1 > Xilonen E N2 > Xiangling Q ED > Mona Q > Mualani E Q 2[3-stacked bite]
# Xilonen Q > Mona N1C > Xilonen E N2 > Xiangling ED N1 > Mualani E 3[3-stacked bite]