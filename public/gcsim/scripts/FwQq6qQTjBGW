# Razor Rosaria Fischl (C5)Bennett. ~22s Rot. Phys Razor, though C6 Bennett is actually a DPS gain with Witches Homework. Snapshot Bennett for Rosaria and Fischl. Opening Razor field-time with hEDQ is the same.

# Team
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="risingwinds" count=4;
#razor add set="pf" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10; # RW
