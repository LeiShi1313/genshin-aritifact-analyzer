# Lanyan Faruzan Furina Xianyun. ~19s Rot. Lanyan Anemo Hyperplunge. Lanyan spends skills before plunging. Lanyan uses burst before or after plunging based on availabiliy. MH is very close to LNO. 60% Collisions.

# Team - Options Listed by DPS
lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="widsith" refine=3 lvl=90/90;
lanyan add set="lno" count=4;
#lanyan add set="mh" count=4;
lanyan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311;
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # LNO
#lanyan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311;
#lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.2648 cd=0.7944; # MH

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90;
faruzan add set="scroll" count=4;
#faruzan add set="no" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311;
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add weapon="ttds" refine=5 lvl=90/90;
xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
#xianyun add set="no" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.4408 em=39.64 cr=0.1324 cd=0.1324; # Oathsworn
#xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
#xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.2976 er=0.6612 em=39.64 cr=0.0662 cd=0.1324; # TTDS

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  faruzan burst, skill;
  if .faruzan.weapon == .keys.weapon.favbow && !.faruzan.mods.favonius-cd {
    furina attack;
  }
  
  xianyun skill, low_plunge, burst;
  
  # Not woth building ER
  if .lanyan.burst.ready {
    lanyan burst;
  }
  # Spend all skill charges
  while .lanyan.skill.ready {
    lanyan skill:2;
  }
  # DPC Trigger
  if .lanyan.sets.dpc >= 4 {
    lanyan attack, charge;
  }
  while .lanyan.status.xianyun-airborne-buff {
    lanyan jump;
    if .airborne {
      lanyan high_plunge[collision=rand()>0.4];
    }
    if .lanyan.status.xianyun-airborne-buff {
      lanyan dash;
    }
  }
  # Fill time for CDs
  if .lanyan.burst.ready {
    lanyan burst;
  }
}

