kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; # main
kazuha add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=118.92 er=0.1102 cr=0.331 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="no" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active yelan;

for let r=0; r<4; r=r+1 { # 4 rotations

  yelan skill, burst;
  if .fischl.burst.ready { # fischl burst every other rotation
    fischl attack:2, burst;
  } else {
    fischl attack, skill, attack;
  }
  kazuha skill, high_plunge; # kazuha burst dps loss
  clorinde_combo();
  kazuha skill, high_plunge;
  clorinde burst;

}
