options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn naviaCombo() {
  navia skill;
  for let h =4; h > 0; h = h - 1 {
    navia jump;
    if .airborne {
        navia high_plunge[collision=rand()>0.5], dash;
    }
  }
}

active navia;
for let i = 0; i < 3; i = i + 1 {

  furina skill, dash, burst;
  while .furina.mods.favonius-cd == 0 {
    furina attack;
  }

  xianyun skill, low_plunge, burst;

  if !i {
    navia skill;
  }
  navia burst;

  ningguang skill, dash;

  naviaCombo();

  ningguang burst, walk, skill;

  naviaCombo();
}
navia skill;
