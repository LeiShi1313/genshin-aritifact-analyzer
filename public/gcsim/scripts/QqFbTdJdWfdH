options swap_delay=12 iteration=1000;

# Build assumptions
flins char lvl=90/90 cons=0 talent=9,9,9;
flins add weapon="fjords" refine=1 lvl=90/90;
flins add set="nightoftheskysunveiling" count=4;
flins add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="sms" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="aubadeofmorningstarandmoon" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2317 cd=0.662;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworneye" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active fischl;
for let i=0; i<6; i=i+1 {

  if !is_even(i) {
    fischl attack:2, burst;
    columbina skill, attack;
    nicole skill, burst;
  } else {
    fischl skill;
    if i {
      fischl attack;
    }
    columbina skill, burst;
    nicole skill, burst;
  }

  flins skill, attack,
        skill, attack:3, dash, attack:3, burst,
        attack:3, dash, attack:3,
        skill, attack:3, burst,
        attack:3, dash, attack:2;
  if !is_even(i) {
    flins attack:2;
  }
}

# Fischl E > Columbina E Q  > Nicole EQ > Flins E N1 E N3D N3 Q N3D N3 E N3 Q N3D N2
# Fischl Q > Columbina E N1 > Nicole EQ > Flins E N1 E N3D N3 Q N3D N3 E N3 Q N3D N4
