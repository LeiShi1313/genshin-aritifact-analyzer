#neuvillette 4 hp%, 6cr, 10cdmg
#kazuha subs 4 em, 10 atk%, 4 cr
#baizhu subs 10 hp%, 6 em, 4 hp
#furina subs 8 cr, 10 cdmg, 2 hp%

options swap_delay=12 iteration=1000;

active furina;

target lvl=100 resist=0.1 radius=1 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

for let i=0;i<4;i=i+1 {
  furina skill, dash, attack:2;
  neuvillette burst,skill;
  furina burst;
  if .kazuha.burst.ready {
    kazuha burst;
  } else {
    kazuha skill, high_plunge;
  }
  neuvillette charge,skill;
  kazuha skill, high_plunge;
  neuvillette charge;
  kazuha skill, high_plunge;
}