chevreuse char lvl=90/90 cons=6 talent=9,9,9; 
chevreuse add weapon="dialogues" refine=5 lvl=90/90;
chevreuse add set="scroll" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 hp%=0.466 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296; #subs								

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="goldentroupe" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #mainstats
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
 
yanfei char lvl=90/90 cons=6 talent=9,9,9;
yanfei add weapon="hakushin" refine=5 lvl=90/90;
yanfei add set="gd" count=4;
yanfei add stats hp=4780 atk=311.0 em=187 em=187 em=187;
yanfei add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.0662 cd=0.5296;

options iteration=100 swap_delay=12;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.5;
energy every interval=480,720 amount=1;

active yae;


for let r = 0; r < 4; r = r + 1 {
  if r > 0 && .yae.burst.ready {
    yae burst;
  }
  yae skill:3;
  chev burst, skill[hold=1];
  fischl attack, skill;
  yanfei skill, charge,
         attack:2, burst,
         attack:2, charge,
         attack:2, charge,
         attack:2, charge;
  chev skill[hold=1], attack;
  yae skill, attack, skill:2;
  fischl attack:2, burst;
  yanfei skill, charge,
         attack:2, charge, 
         attack:2, charge,
         attack:2, charge;
  
}
