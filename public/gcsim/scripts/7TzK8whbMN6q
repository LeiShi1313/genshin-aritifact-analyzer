# --- Options
options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# --- Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

# --- Rotation
active xingqiu;

for let i=0; i<4; i=i+1 {
   
    xingqiu attack, skill, dash, burst, attack;
    navia burst;
    bennett attack, burst, skill, dash; 
    xiangling burst, attack, skill, dash, attack;
    navia skill[hold=1], attack:3, dash, attack:2;
    bennett attack, skill, dash;
    navia skill, attack:3, dash, attack;
    bennett skill, dash;
    xiangling attack:2, dash;
}