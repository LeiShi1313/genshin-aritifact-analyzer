options swap_delay=12 iteration=1000;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="widsith" refine=5 lvl=90/90;
columbina add set="notsu" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="ballad" refine=1 lvl=90/90;
ineffa add set="deepwood" count=4;
ineffa add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*8 cr=0.0331*10 cd=0.0662*8;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="etherlight" refine=5 lvl=90/90;
//lauma add set="deepwood" count=4;
lauma add set="sms" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*8 em=19.82*6 cr=0.0331*10 cd=0.0662*4;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=5 lvl=90/90;
mona add set="ins" count=4;
mona add stats hp=3571 atk=232 er=0.387 atk%=0.348 cr=0.311;
mona add stats def%=0.052*2 def=16.53*2 hp=213.31*2 hp%=0.0417*2 atk=13.89*2 atk%=0.0417*2 er=0.0463*2 em=16.65*2 cr=0.0278*8 cd=0.0556*8;

active lauma;
# ----  Actions List
target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999;
energy every interval=480,720 amount=1;

lauma attack;
for let i=0; i<5; i=i+1 {
  if .columbina.burst.ready {
    columbina burst;
  } else {
    columbina dash, attack;
  }

  columbina skill;

  ineffa skill;

  mona skill, burst, attack;

  lauma attack;
  if .dew < 1 {
    lauma skill, burst;
  } else {
    lauma skill[hold=1], burst;
  }

  bina attack, charge, dash, charge, dash, charge;
  mona attack, charge;
  bina attack, charge, dash, charge, dash, charge;
}
columbina attack; // give time for the last CA's damage to land
