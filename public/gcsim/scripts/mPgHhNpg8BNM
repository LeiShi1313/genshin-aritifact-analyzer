chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;																					

options iteration=1000 swap_delay=12;                                                                       
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn clorinde_combo() { 
  clorinde skill;
  if .clorinde.bolratio >= 1 {
    clorinde skill;
    set_player_pos(0, -5); # clorinde uses her skill to lunge into the direction of sara's burst to extend sara's buff duration
    clorinde attack:3, skill;
    set_player_pos(0, 0);
  }
  clorinde attack:3, skill;
  set_player_pos(0, -5); # clorinde uses her skill to lunge into the direction of sara's burst to extend sara's buff duration
  clorinde attack:3, skill;
  set_player_pos(0, 0);
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active sara;

sara skill;
chevreuse burst, skill[hold=1];
xl burst, skill[a4_delay=28], dash; # clorinde uses her skill to lunge onto xiangling's pepper
sara burst;
clorinde_combo();

for let i = 0; i < 2; i = i + 1 { # 4 rotations, broken up for clarity 
  
  #teammates no bursts
  sara aim;
  chevreuse skill[hold=1], attack;
  clorinde burst;
  xl attack:3, skill[a4_delay=18], dash; # clorinde uses her skill to lunge onto xiangling's pepper
  sara skill;
  clorinde_combo();
  
  #teammates bursts
  sara aim;
  chevreuse skill[hold=1], attack;
  clorinde burst;
  sara skill;
  xl burst, skill[a4_delay=53], dash; # clorinde uses her skill to lunge onto xiangling's pepper
  sara burst;
  clorinde_combo();

}
  