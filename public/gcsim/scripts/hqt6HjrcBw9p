# Lisa Furina Ororon Baizhu. ~21s Rot. Lisa-Ororon Hyperbloom. Ororon goes before Furina for higher Electro coverage and energy. Baizhu does 2Es. Baizhu Deepwood > OHC.

# Team
lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="widsith" refine=3 lvl=90/90;
#lisa add weapon="hakushin" refine=5 lvl=90/90;
lisa add set="gd" count=4;
#lisa add set="ts" count=4;
#lisa add set="mh" count=4;
lisa add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296; # GD/TS Widsith
#lisa add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
#lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.331 cd=0.7944; # GD Hakushin
#lisa add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
#lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=59.46 cr=0.2648 cd=0.5958; # MH Widsith
#lisa add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622;
#lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=178.38 cr=0.3972 cd=0.2648; # MH Hakushin

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.331 cd=0.5296;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="deepwood" count=4;
#baizhu add set="ohc" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; # main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=2,0 hp=100000000; # 2nd

# Rotation
active ororon;

for let i=0; i<4; i=i+1 {
  ororon skill, burst;

  furina skill, dash, burst;

  baizhu attack, skill, attack, burst;

  lisa attack, burst, attack, charge, attack:1, charge, attack:1, charge; # Stamina Heavy

  baizhu skill, attack;

  lisa attack, skill[hold=1], charge; # Narrowly catches her particles
}
