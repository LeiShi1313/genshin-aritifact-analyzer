xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack;
  xilonen skill, attack:2;  pick_up_crystallize("hydro");
  furina burst, attack:2;
  citlali skill, attack;
  yelan burst, attack, skill, attack, skill;
  yelan attack:4;
  xilonen skill, attack:2;  pick_up_crystallize("hydro");
  yelan attack:4;
  yelan attack:4;
  yelan attack:4;
  yelan dash, attack:2;
}


