arlecchino char lvl=90/90 cons=0 talent=9,9,9;
arlecchino add weapon="deathmatch" refine=1 lvl=90/90;
arlecchino add set="fohw" count=4;
arlecchino add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
arlecchino add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662 ;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=4 lvl=90/90;
yelan add set="no" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311 ; #main
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958 ;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="thrillingtalesofdragonslayers" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="ins" count=4;
bennett add stats hp=3824 atk=248.8 er=0.518 pyro%=0.3728 cr=0.2488 ; #main
bennett add stats def=33.0624 def%=0.10416 hp=426.6192 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.46284 em=33.2976 cr=0.083412 cd=0.27804 ;


options swap_delay=12 iteration=1000;

active arlecchino;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

arlecchino skill;

for let i=0; i<4; i=i+1 {

  yelan skill;
  if i {
    yelan attack:2;
    if !.yelan.mods.favonius-cd  {
      yelan attack;
    }
  }
  yelan burst;

  bennett burst, skill[hold=1];

  sucrose skill, dash;
  if .sucrose.burst.ready {
    sucrose burst, attack;
  } else {
    sucrose attack;
  }

  arlecchino attack:2, charge,
             attack:4, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash;
  if i {
    arlecchino attack:1;
  }
  arlecchino skill;


}
