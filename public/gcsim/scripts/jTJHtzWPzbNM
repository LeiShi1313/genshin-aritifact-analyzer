zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="ap" count=4;
#zhongli add set="tom" count=4;
#zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311; # main
#zhongli add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # DPS
zhongli add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
zhongli add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296; # Shieldbot

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active razor; # SS Stacks
#razor skill, dash; # Not nessesary

for let i=0; i<4; i=i+1 {
  if .amy.skill.ready && .amy.burst.ready {
    amy attack, skill;
  }

  zhongli skill[hold=1], dash, attack:2;
  # Archaic Petra Action
  if .gadgets.crystallizeshard.electro {
    pick_up_crystallize("electro");
  }

  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }

  if .amy.burst.ready {
    amy attack:2, burst;
  } else {
    amy attack:1, skill;
  }

  # Standard Rotation
  razor skill, dash, attack, burst;
  razor attack:1, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3;

  print("done");
}
