# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Pickup Crystallize Function
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilonen && action_id == .action.skill) {
    pick_up_crystallize("any");
  }

  return _execute_action(char_id, action_id, p);
}

#Rotation
active navia; # SS Stacks

for let i=0; i<4; i=i+1 {
  if .mav.burst.ready { # && i > 0 {
    mav burst, skill, dash;
  } else {
    mav skill, dash;
  }
  if i > 0 {
    mav charge:2, charge[final=1], dash;
  }

  xilonen skill, attack:2; pick_up_crystallize("any");

  navia burst;

  xianyun skill, low_plunge, burst;

  navia skill;
  for let h = 4; h > 0; h = h - 1 {
    navia jump;
    if .airborne {
      navia high_plunge[collision=rand()>0.5];
    }
    if h > 1 {
      navia dash;
    }
  }

  xilonen skill, attack:2;

  navia skill;
  for let h = 4; h > 0; h = h - 1 {
    navia jump;
    if .airborne {
      navia high_plunge[collision=rand()>0.5];
    }
    if h > 1 {
      navia dash;
    }
  }
  if .navia.skill.ready {
    navia skill;
  }
}
