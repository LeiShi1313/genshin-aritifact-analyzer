options swap_delay=12 iteration=1000;

# Build assumptions
durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
//durin add weapon="finale" refine=5 lvl=90/90; // C4 Mona Finale R5
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;
//durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; // C4 Mona Wolffang R1 worse

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.5296;

mona char lvl=90/90 cons=2 talent=9,9,9;
mona add weapon="ttds" refine=5 lvl=90/90;
mona add set="cg" count=5;
mona add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
mona add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favoniussword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active xilonen;
for let i=0; i<4; i=i+1 {
  let StartFrame = f();
  xilonen burst;
  furina skill, dash, burst;
  xilonen skill, attack:2;
  mona burst, attack:2, dash, attack:2, skill, attack;
  durin skill, attack, burst;
  while f() - StartFrame < 900 {
    if .durin.normal == 2 && .stam > 50 {
      durin charge, dash;
    }
    durin attack;
  }
  xilonen skill, attack:2;
  while f() - StartFrame < 1200 {
    if .durin.normal == 2 && .stam > 50 {
      durin charge, dash;
    }
    durin attack;
  }
}
