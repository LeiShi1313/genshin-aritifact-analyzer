# Options
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

# Rotation
active furina;

furina skill, dash, burst;

escoffier skill, burst;

yelan burst, attack, skill, attack;

mualani skill,
          walk[f=91], attack,
          walk[f=91], attack,
          walk[f=01], burst,
          walk[f=40], attack;

yelan skill, attack:5;

for let i = 0; i < 3; i = i + 1 {
  furina skill, dash, attack, burst;

  escoffier skill, burst;

  yelan burst, attack, skill, attack;

  mualani skill,
          walk[f=91], attack,
          walk[f=91], attack,
          walk[f=01], burst,
          walk[f=40], attack;

  yelan skill, attack:5;
}
