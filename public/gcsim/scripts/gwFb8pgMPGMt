# PMC Furina Yelan Xianyun. ~22s Rot. PMC Double Hydro VapePlunge. Leads with hold skill, then 8 low plunges, with burst as available inbetween. 1E Yelan. No Pyro VV. Scroll and LNO lead to the same team DPS. 50% Collisions.

# Team - Options listed by DPS
luminepyro char lvl=90/90 cons=6 talent=9,9,9 +params=[base_atk_buff=1, skirk_story_buff=1];
luminepyro add weapon="harbinger" refine=5 lvl=90/90;
luminepyro add set="lno" count=4;
#luminepyro add set="scroll" count=4;
#luminepyro add set="oc" count=4;
luminepyro add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
luminepyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # LNO/Scroll
#luminepyro add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
#luminepyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # OC

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
#yelan add set="no" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Emblem
#yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282; # NO

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=148.86 atk%=0.3968 er=0.4959 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Active
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;

  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  xianyun skill, low_plunge, attack, burst;

  luminepyro attack, skill[hold=1];
  while .xianyun.status.xianyun-airborne-buff {
    luminepyro jump;
    if .airborne {
      luminepyro low_plunge[collision=rand()>0.5];
      #luminepyro high_plunge[collision=rand()>0.5];
    }
    if .xianyun.status.xianyun-airborne-buff { # no attack for final plunge
      luminepyro attack;
    }
    if .luminepyro.burst.ready {
      luminepyro burst, attack;
    }
  }
}
