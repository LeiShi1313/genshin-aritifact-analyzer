arlecchino char lvl=90/90 cons=0 talent=9,9,9;
arlecchino add weapon="deathmatch" refine=1 lvl=90/90;
arlecchino add set="fohw" count=4;
arlecchino add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
arlecchino add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662 ;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="ap" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311 ; #main
zhongli add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="viridescentvenerer" count=5;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kazuha add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
#bennett add set="ap" count=4;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=0.5 pos=0,1 hp=999999999;
#target lvl=100 resist=0.1 radius=0.5 pos=1.1,1 hp=999999999;
energy every interval=480,720 amount=1;

active arlecchino;
arlecchino skill;

bennett burst;

zhongli skill[hold=1], dash;

pick_up_crystallize("pyro");

kazuha burst;

arlecchino charge,
          attack:3, dash,
          attack:3, dash,
          attack:3, dash,
          attack:3, dash,
          attack:3, dash,
          attack:3, dash, attack, skill, attack;
for let i=0; i<3; i=i+1 {

  if i {
    arlecchino skill, attack;
  }

  if !.bennett.burst.ready {
    bennett skill, burst;
  } else {
    bennett burst;
  }

  zhongli skill[hold=1], dash;

  pick_up_crystallize("pyro");

  if .kazuha.burst.ready{
    kazuha burst;
  } else {
    kazuha skill, high_plunge;
  }

  arlecchino attack:1, charge,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3, dash,
             attack:3;


}
