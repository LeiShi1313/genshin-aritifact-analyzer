yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="mh" count=4;
yoimiya add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1102 em=59.46 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main 
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972;

candace char lvl=90/90 cons=6 talent=9,9,9;
candace add weapon="favlance" refine=3 lvl=90/90;
candace add set="no" count=4; # Eye-watering ER Req with 1 E
#candace add set="emblem" count=4;
candace add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
candace add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.4634;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=5;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.3972 cd=0.4634;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active furina;
furina skill, dash;
for let i = 0; i < 4; i = i + 1 {
  furina burst;
  if i {
    furina skill, dash;
  }
  bennett skill, burst;
  if !.element.t0.pyro && !.element.t0.hydro {
    bennett attack;
  }
  candace skill, burst;
  while !.candace.mods.favonius-cd {
    candace attack;
  }
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack;
  if .yoimiya.burst.ready {
    yoimiya burst;
  } else {
    yoimiya attack:3;
  }
  candace skill, attack;
  while !.candace.mods.favonius-cd {
    candace attack;
  }
  bennett skill, dash;
}
