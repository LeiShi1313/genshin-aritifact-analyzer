options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4 freeze_resist=0;
energy every interval=480,720 amount=1;

active furina;
for let i = 0; i < 1; i = i + 1{
  furina burst,skill;
  shenhe burst,skill;
  jean skill, burst;
  ayaka dash, skill, attack, burst, attack:2, charge;
  jean skill,attack:2;
  shenhe skill,attack:2;
  ayaka dash,attack,charge,skill,attack:2,charge;
  print("rotation done");
}


