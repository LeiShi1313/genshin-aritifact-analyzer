# Raiden Chevreuse Yae Bennett. ~22 & ~18s Rot. Raikou Overload. Yae bursts every other rotation in Bennett's burst; 1/2 or 3/4ths of Raiden's burst catches Bennett's buff.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="deathmatch" refine=1 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="gt" count=4;
chevreuse add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="flowingpurity" refine=5 lvl=90/90; # Whimsy
yae add set="gt" count=4;
#yae add set="tom" count=4;
#yae add set="scroll" count=4;
#yae add set="ts" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
#bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

active raiden;
raiden skill;

for let i = 0; i < 4; i = i + 1 {
  yae skill:3;

  bennett burst, skill;

  chev burst, skill[hold=1]:3;

  if is_even(i) {
    yae burst, skill:3;

    bennett skill; # Refresh Chev A1 RES shred

    raiden burst, attack:4,
           skill, attack:4, # Bennett burst expires
           dash, attack:4, # Maximum Energy Restore
           dash, attack:3; # Raiden burst cd filler

    bennett skill; # Refresh Chev A1 RES shred

    yae attack; # Bennett skill cd
  } else {
    bennett skill; # Refresh Chev A1 RES shred

    raiden burst, attack:4,
           skill, attack:4,
           dash, attack:4, # Maximum Energy Restore
           dash, attack:3; # Bennett burst expires

    bennett skill; # Refresh Chev A1 RES shred
  }
}
