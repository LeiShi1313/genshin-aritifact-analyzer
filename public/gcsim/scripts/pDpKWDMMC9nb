# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets - Hyperbloom Ownership varies with size
target lvl=100 resist=0.1 radius=3 pos=0,3.3 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000;

# Rotation
active lauma;

for let i=0; i<4; i=i+1 {
  lauma skill[hold=.dew>1];

  mona attack, skill, burst, attack;

  if .fischl.skill.ready {
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }

  mona attack:3;

  sethos aim[hold=2], skill, burst,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2;
  if .sethos.sets.dpc >= 4 {
    sethos walk, attack;
  }
  sethos skill;
}
