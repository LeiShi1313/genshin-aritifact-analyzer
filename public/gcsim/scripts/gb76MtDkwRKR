bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesseoblige" count=5;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2648 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active raiden;

raiden skill;
for let i = 0; i < 4; i = i + 1 {
  yae skill:3;
  bennett skill, burst;
  if i==0 || i==2 {
    chevreuse burst, skill[hold=1]:3;
  } else {
    chevreuse burst, skill[hold=1];
    yae burst, skill:3;
    bennett attack, skill; # Refresh Chev A1 res shred
  }
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  if i==1 || i==3 {
    yae attack:3, dash; #just a filler for waiting Raiden Q 18s cd in the next rot.
  }
}

