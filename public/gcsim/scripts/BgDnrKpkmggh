fn randy(mean, standardDeviation, min, max, display) {
  let value = randnorm() * standardDeviation + mean;
  if value > max {
    value = max;
  } else if value < min {
    value = min;
  }
  if display {
    print(value);
  }
  return value;
}


let prev_char_id = -1;
let prev_action_id = -1;


let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  #print(prev_char_id, " ", prev_action_id, " ", char_id, " ", action_id);


  # this next if block handles implict swap or otherwise any pre swap delay specified in this function
  # will not work
  if prev_char_id != char_id && action_id != .action.swap {
    execute_action(char_id, .action.swap, []);
  }


  # this following if block handles conditionally adding in delay depending on
  # what the previous and next action is. in this example, delay is not added between attacks
  # and charge attack following an attack
  # modify these conditions as you see fit
  if action_id == .action.swap {
    # add delay before swap
    delay(randy(9.5, 1.5, 8, 17, 0));
  } else if prev_action_id == .action.attack && action_id != .action.attack && action_id != .action.charge {
    # add delay after attack, but only if not followed by another attack or charge
    delay(randy(3, 1, 0, 6, 0));
  } else if prev_action_id != .action.attack {
    # add delay to everything else
    delay(randy(3, 1, 0, 6, 0));
  }


  # this here tracks the previous character id so that it can be used above
  prev_char_id = char_id;
  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}

fn try_alhaitham_jump_plunge(high, coll) {
  if .alhaitham.mods.xianyun-airborne-buff > 15 {
    alhaitham jump;
    alhaitham_plunge(high, coll);
  } else {
    alhaitham attack, dash;
  }
}

fn alhaitham_plunge(high, coll) {
  if high {
    if rand() < coll {
      alhaitham high_plunge[collision=1];
    } else {
      alhaitham high_plunge;
    }
  } else {
    if rand() < coll {
      alhaitham low_plunge[collision=1];
    } else {
      alhaitham low_plunge;
    }
  }
}

options swap_delay=1 iteration=1000 ignore_burst_energy=false;
target lvl=100 resist=0.1 hp=999999999999 radius=1 pos=0,1.5 particle_threshold=520000 particle_drop_count=3; #Energy drops based on 12-3 Icewind Suite


let highPlunge = false; #false for low plunges, true for high plunges
let collisionRate = 0.25; #25% collision rate

active fischl;

#[Fischl E] > Nahida hE Q > Fischl [N2 Q / N1 E] > Xianyun [N1] E LP Q [N1] > Alhaitham Q (wait for mirrors) 3x[N2JP] E 4x[N2JP]
fischl skill;
for let r=0; r<4; r=r+1 {
  nahida skill[hold=1];
  while !.nahida.burst.ready {
    if .nahida.skill.ready {
      nahida skill;
    } else {
      nahida attack;
    }
  }
  nahida burst;

  fischl swap;
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }

  if (.xianyun.weapon == .keys.weapon.favcodex) {
    xianyun attack;
  }
  xianyun skill, low_plunge;
  while !.xianyun.burst.ready {
    xianyun attack;
  }
  xianyun burst;
  if !.xianyun.mods.favonius-cd && (.xianyun.weapon == .keys.weapon.favcodex) {
    xianyun attack;
  }

  alhaitham swap;
  while !.alhaitham.burst.ready {
    alhaitham attack;
  }
  alhaitham burst;
  while !.alhaitham.mirrors {
    wait(1);
  }
  alhaitham attack:2; try_alhaitham_jump_plunge(highPlunge, collisionRate);
  alhaitham attack:2; try_alhaitham_jump_plunge(highPlunge, collisionRate);
  alhaitham attack:2; try_alhaitham_jump_plunge(highPlunge, collisionRate);
  alhaitham skill,
            attack:2; try_alhaitham_jump_plunge(highPlunge, collisionRate);
  alhaitham attack:2; try_alhaitham_jump_plunge(highPlunge, collisionRate);
  alhaitham attack:2; try_alhaitham_jump_plunge(highPlunge, collisionRate);
  alhaitham attack:2; try_alhaitham_jump_plunge(highPlunge, collisionRate);
}
