yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gt" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.0 hp=100000000;

# Rotation
active yae;

for let i=0; i<4; i=i+1 {

  yae skill:3;

  if .chev.burst.ready && .chev.energy == .chev.energymax {
    chev burst, skill[hold=1]:3;
  } else {
    chev attack, skill[hold=1];
  }
  
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }

  hutao skill,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump,
        attack:3, charge, jump;

  if .hutao.burst.ready && .hutao.energy == .hutao.energymax {
    hutao burst;
  } else { 
    hutao attack:1, charge, jump;
  }
  
}
