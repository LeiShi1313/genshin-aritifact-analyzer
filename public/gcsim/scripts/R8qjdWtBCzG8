bennett add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.370272 em=133.19 cr=0.055608 cd=0.111216;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # 2T

# Beidou 25% Perfect Counter, 25% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.75 {
    counter = 2;
  } else if counter > 0.75 && counter <= 0.5 {
    counter = 1;
  }
  else {
    counter = 0;
  }

  return counter;
}

#Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  nahida skill;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida attack, charge;
  }

  xingqiu skill, dash, burst, attack;

  bennett skill, attack, burst;

  while .beidou.infusion.bennett-fire-weapon || .status.bennettburst {
    switch {
      case .beidou.skill.ready:
        beidou skill[counter=rand_counter()];
      case .beidou.burst.ready && .beidou.energy == .beidou.energymax:
        beidou burst;
      case .beidou.normal > 2 && .beidou.dash.ready && .stam > 18:
        beidou dash;
      default:
        beidou attack;
    }
  }

  print("done");
}
