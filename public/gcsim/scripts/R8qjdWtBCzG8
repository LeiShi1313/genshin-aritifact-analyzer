# Beidou Nahida Xingqiu Bennett. ~22s Rotation. Beidou Burgeon with C6 Bennett in 2T. Beidou C4 is activated by Burgeon, but cannot hit cores, leading to low Hyperbloom count. As CA is not implemented, Beidou does N2D to E (& Q) of CD. 25% perfect counter, 25% counter. Nahida bursts (nearly) every rotation. Self-Overloads not implemented.

# Team
beidou char lvl=90/90 cons=6 talent=9,9,9;
beidou add weapon="favgs" refine=3 lvl=90/90;
beidou add set="fopl" count=4;
#beidou add set="gd" count=4;
#beidou add set="tf" count=4;
beidou add stats hp=4780 atk=311 em=187 em=187 em=187; #main
beidou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # 3EM

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.1655 cd=0.331;

