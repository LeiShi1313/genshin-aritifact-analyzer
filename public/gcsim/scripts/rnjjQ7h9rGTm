clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="blacksword" refine=1 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2979 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="gift" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1982 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="scroll" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active durin;

durin skill:2, burst;
fischl attack, skill, attack;
chevreuse burst, skill[hold=1];
clorinde_combo();
clorinde attack, burst;

let rot = 0;
for let i = 0; i < 5; i = i + 1 {

  if rot == 0 {
    fischl attack:2, burst;
  }

  if is_even(i) {
    chevreuse skill[hold=1], attack;
  } else {
    chevreuse burst, skill[hold=1]:2;
  }

  if rot {
    durin attack;
  }
  durin attack, skill:2, burst;

  if rot == 1 {
    fischl attack:2, burst;
  }
  if rot == 2 {
    fischl attack, skill, attack;
  }

  clorinde_combo();

  if rot == 0 {
    fischl attack, skill, attack;
  }

  clorinde burst;


  rot = rot + 1;
  if rot == 3 {
    rot = 0;
  }
}

# Opener: Durin EEQ > Fischl E > Chevreuse Q hE > Clorinde E combo Q
# Ongoing:
# Fischl Q > Chevreuse (Q) hE (hE) > Durin EEQ >            Clorinde E combo > Fischl E > Clorinde Q
#          > Chevreuse (Q) hE (hE) > Durin EEQ > Fischl Q > Clorinde E combo >            Clorinde Q
#          > Chevreuse (Q) hE (hE) > Durin EEQ > Fischl E > Clorinde E combo >            Clorinde Q
