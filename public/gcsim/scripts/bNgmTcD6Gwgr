options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn clorcombo() {
  while .clorinde.status.clorinde-night-watch {
    switch {
      case .clorinde.bolratio >= 1:
        clorinde skill;
      default:
       clorinde attack;
    }
  }
}

active fish;

for let r=0; r<3; r=r+1 {
 if r {
    fish attack:2;
  }
  fish burst;
  kirara skill[short_hold=1];
  xl skill, dash, burst;
  clorinde skill;
  clorcombo();
  fish attack, skill;
  xl attack:2, skill, dash;
  kirara skill[short_hold=1];
  clorinde skill;
  clorcombo();
}

