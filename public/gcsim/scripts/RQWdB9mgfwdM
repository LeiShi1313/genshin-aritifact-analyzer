options swap_delay=12 iteration=1000;

kaeya char lvl=90/90 cons=6 talent=9,9,9;
kaeya add weapon="moonweaversdawn" refine=1 lvl=90/90;
kaeya add set="blizzard" count=4;
kaeya add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
kaeya add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #mainaaaaaaa
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="solitude" refine=5 lvl=90/90;
yelan add set="mh" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #mainaaaa
yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*7 cd=0.0662*10;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="scroll" count=4;
escoffier add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*2;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  esco skill, attack, burst;
  yelan burst, attack, skill;
  if .yelan.breakthrough {
    yelan aim, attack;
  }
  else {
    yelan attack:2;
  }
  kaeya skill, attack, burst;
  yelan attack:4, dash,
        attack:4;
  kaeya skill, attack;
  wait(9); #adding this to get rid of the yelan skill cooldown warning
  yelan attack:2, skill,
        attack:4, dash,
        attack:2;
}

# Furina E D Q, Esco E N1 Q, Yelan Q N1 E -> Yelan C N1 -> Kaeya E N1 Q -> Yelan N4D N4 -> Kaeya E N1 -> Yelan N2 E N4D N2
#                        Breakthrough on CD: Yelan N2
