# Rosaria Furina Chongyun Escoffier. ~20s Rot. Cryo infused on-field Rosaria w/ Chongyun doing mostly N2CD and skill as available. Rosaria uses skill 3 times, passing the 3rd's particles to Furina. -2K DPS with Freeze immunity and MH

# Team - Options listsed by DPS
rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="prospectorsdrill" refine=1 lvl=90/90;
rosaria add set="bs" count=4;
#rosaria add set="mh" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # BS
#rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
#rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662; # MH, Freeze Immunity

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.5952 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.1324 cd=0.2648; # ToM
#furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.5952 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.1324 cd=0.2648; # GT

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.3857 em=39.64 cr=0.0993 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freeze Immunity

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  esco skill, burst;

  chongyun burst, skill;

  rosaria skill, burst;
  while .furina.skill.cd {
    switch {
      case .rosaria.skill.ready:
        rosaria skill;
      case .rosaria.normal > 2 && .stam > 43:
        rosaria charge, dash;
      case .rosaria.normal > 2 && .stam > 18:
        rosaria dash;
      default:
        rosaria attack;
    }
  }
}
