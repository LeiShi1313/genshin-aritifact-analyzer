options swap_delay=12 iteration=1000;

# Build assumptions
dehya char lvl=90/90 cons=2 talent=9,9,9;
dehya add weapon="uomms" refine=5 lvl=90/90;// +params=[stacks=5];
dehya add set="ur" count=4;
dehya add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622;
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.3857 em=39.64 cr=0.1655 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active dehya;

for let i=0; i<6; i=i+1 {
  dehya skill:2;
  let eq=0;
  if i > 0 && .emilie.burst.ready {
    emilie burst;
    eq=1;
  } else {
    emilie skill, attack;
  }

  nicole burst, skill;
  durin burst;
  durin attack, charge, dash;
  durin attack, charge, dash;
  durin attack, charge, dash;
  durin attack, charge, dash;
  durin attack;
  if eq==0 {
    durin charge, dash; // if Emilie didn't use her Q in this rot
  }
  durin skill:2;

  dehya burst, attack:10;
}

# Dehya 2[E] > Emilie E/Q > Nicole Q E > Durin Q 4[N1CD] N1(CD) 2[E] > Dehya Q N10
