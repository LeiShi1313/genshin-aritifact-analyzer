thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="favlance" refine=3 lvl=90/90;
thoma add set="deepwood" count=5;
thoma add stats hp=4780 atk=311 er=0.518 em=187 cr=0.311 ; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=198.2 cr=0.331 cd=0.2648;

options swap_delay=12 iteration=1000;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active nahida;

for let i=0; i<4; i=i+1 { 
  nahida skill, burst;
  
  thoma skill, attack, burst, attack;
  
  yelan skill;
  if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  cyno burst, attack, skill;
  for let i = 0; i < 6; i=i+1 {
    cyno attack:4, skill;
  }
  
}
