clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="harbinger" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="mouunsmoon" refine=1 lvl=90/90;
sara add set="ap" count=5;
sara add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311 ; #main
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="footprintoftherainbow" refine=5 lvl=90/90;
yunjin add set="husk" count=4;
yunjin add stats hp=4780 atk=311 er=0.518 def%=0.583 def%=0.583; #main
yunjin add stats def%=0.496 def=197.24 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active sara; 

for let r=0; r<2; r=r+1 { # Two 32s rotations (Four 16s rotations)
  
  sara skill, aim;
  wait(12);
  yunjin skill; # yunjin skill to allow for 3 crystallizes in order to stack clorinde A1
  xilonen skill, attack:2;
  yunjin burst;
  sara dash; pick_up_crystallize("electro"); # sara dash to crystallize before using her burst
  sara burst;
  clorinde_combo();
  
  yunjin skill; # yunjin skill to refresh clorinde A1
  sara skill; 
  clorinde burst;
  xilonen skill, attack:2;
  yunjin burst;
  sara aim; pick_up_crystallize("electro"); # sara walks to crystallize during her aimed shot
  clorinde_combo();
  
 }
  
