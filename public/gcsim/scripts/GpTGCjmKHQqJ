# Kinich Furina Xiangling Bennett. 20s rot. Kinich Burst if available. Everyone except Kinich Burst every rot. -4K DPS with no Kinich short hold; 4 cannon shots is consistent even with no short hold. Serpent Spine exceeds Earthshaker, Burgeon count is very low (~4 per rotation).

# Team
kinich char lvl=90/90 cons=0 talent=9,9,9;
kinich add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#kinich add weapon="earthshaker" refine=5 lvl=90/90;
kinich add set="oc" count=4;
#kinich add set="ur" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
kinich add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # OC, SS
