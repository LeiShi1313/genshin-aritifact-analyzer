hutao add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2979 cd=0.662 ;


yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=4 lvl=90/90;
yelan add set="emblemofseveredfate" count=4;
yelan add stats def%=0.124 def=39.36 hp=5287.88 hp%=0.6644 atk=344.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.642 cd=0.7944 hydro%=0.466;

options swap_delay=12 iteration=100;

target lvl=100 resist=0.1 hp=10000000 radius=1 pos=0,2;
energy every interval=480,720 amount=1;

active furina;
for let x=0; x<3; x=x+1 {
    furina skill, burst;
    yelan burst;
    sucrose skill,attack,burst,attack;
    if .sucrose.skill.ready {
    sucrose skill,dash;}
    yelan attack, skill,attack;
    hutao skill,
    attack:2, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge,jump,
    attack:2,charge,jump;
    if .hutao.burst.ready {
    hutao attack,burst;
  } else {
    hutao attack;
  }
    yelan skill, attack;
    sucrose attack;
}
