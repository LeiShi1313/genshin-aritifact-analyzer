# ----  Default Enemy
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

active neuv;
for let i = 0; i < 3; i = i + 1 {
  neuv skill, attack:3, dash, attack; #last N1 applies hydro aura for shenhe's freeze
  shenhe attack, skill[hold=1], attack;
  kirara skill[short_hold=1], burst;
  xiangling burst, skill, dash;
  neuv charge, burst, skill, charge;
  shenhe skill[hold=1], attack:2;
  kirara skill[hold=60];
  xiangling skill, dash, attack:3;
  neuv charge, charge;
}
wait(173);

