lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="hakushinring" refine=5 lvl=90/90;
lisa add set="gd" count=4;
lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="thestringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="archaicpetra" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

tighnari char lvl=90/90 cons=0 talent=9,9,9;
tighnari add weapon="prototypecrescent" refine=5 lvl=90/90;
tighnari add set="deepwoodmemories" count=4;
tighnari add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311;
tighnari add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;

active lisa;



target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
lisa attack;
for let i=0; i<4; i=i+1 {
  zhongli skill[hold=1], dash;
  let startFrame1 = f();
  while !pick_up_crystallize("electro") && f() - startFrame1 < 45 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
   }
  } # until the character pickup the shard, try to force fav proc or wait, up to 45frames
  fischl attack, skill;
  tighnari skill, aim[weakspot=1], aim:2;
  lisa attack, burst, attack:3, skill[hold=1], attack, dash, attack:3;

  zhongli skill[hold=1], dash;
  let startFrame2 = f();
  while !pick_up_crystallize("electro") && f() - startFrame2 < 45 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
   }
  } # until the character pickup the shard, try to force fav proc or wait, up to 45frames
  fischl attack:2, burst;
  tighnari skill, aim[weakspot=1], aim:2, burst;
  lisa attack, dash, attack:3, charge, attack, dash, attack:3;
}
