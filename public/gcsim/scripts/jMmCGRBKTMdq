# Razor Furina Xingqiu Mika. ~23s rotation. Razor stays on field until Xingqiu's burst expires. 2s/5s without Superconduct/Mika's buff. Xingqiu uses burst after Furina. Razor leads with skill when not running an ER weapon. Mika OHC > SODP > NO.

# Team- Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#razor add weapon="tidalshadow" refine=5 lvl=90/90;
#razor add weapon="uomms" refine=5 lvl=90/90;
razor add set="mh" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622 ; #main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.2204 em=39.64 cr=0.2979 cd=0.662; # SS
#razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622 ; #main
#razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # TS
#razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # UOMMS

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ToM

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="no" count=4;
#xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mika char lvl=90/90 cons=6 talent=9,9,9;
mika add weapon="favlance" refine=3 lvl=90/90;
mika add set="clam" count=4;
#mika add set="sodp" count=4;
#mika add set="no" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311 ; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active razor; # SS Stacks
if .razor.weapon != .keys.weapon.uomms || .keys.weapon.pride {
  razor skill, dash;
}

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  xq skill, dash, burst, attack;

  mika burst, attack, skill, attack;

  razor skill, dash, attack, burst;
  while .xq.mods.xingqiuburst {
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}
