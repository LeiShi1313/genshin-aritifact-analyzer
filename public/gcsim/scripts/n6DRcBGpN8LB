options swap_delay=12 iteration=1000;

# Builds
kokomi char lvl=90/90 cons=0 talent=9,9,9;
kokomi add weapon="hakushinring" refine=5 lvl=90/90;
kokomi add set="oceanhuedclam" count=4;
kokomi add stats hp=4780 hp%=0.466 atk=311 heal=0.359 hydro%=0.466; #main
kokomi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.1984 er=0.2204 em=198.2 cr=0.0662 cd=0.1324;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="thestringless" refine=3 lvl=90/90;
fischl add set="tf" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2648 cd=0.7282;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="xiphos" refine=3 lvl=90/90;
lynette add set="vv" count=4;
lynette add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.6612 em=118.92 cr=0.0662 cd=0.1324;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="wanderingevenstar" refine=1 lvl=90/90;
nahida add set="deepwoodmemories" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=118.92 cr=0.2979 cd=0.5296;

# Target and Energy
target lvl=100 resist=0.1 radius=3 pos=0,3.4 hp=999999999;
energy every interval=480,720 amount=1;

# Rotation
active fischl;
fischl skill;

for let i=0; i<4; i=i+1 {
  kokomi attack, skill, attack;
  nahida skill, burst;
  lynette skill, burst;
  fischl attack:2, burst;
  nahida attack:2, skill;
  kokomi burst,
         # 6[N3D] combo
         attack:3, dash,
         attack:3, dash,
         attack:3, dash,
         attack:3, dash,
         attack:3, dash,
         attack:3, dash;
  lynette skill;
  kokomi attack:3, dash,
         attack:2;
         # to fill time for Fischl E CD
  fischl attack, skill;
}

# (Fischl E first rot only) > Kokomi N1 E N1 > Nahida EQ > Lynette EQ > Fischl N2 Q > Nahida N2 E > Kokomi Q 6[N3D] > Lynette E > Kokomi N3D N2 > Fischl N1 E
# For pre-C4 Lynette just drop either the first or second skill
