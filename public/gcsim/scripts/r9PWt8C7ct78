neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacjade" refine=1 lvl=90/90;
neuvillette add set="marechausseehunter" count=5;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1986 cd=0.662;

ororon char lvl=90/90 cons=6 talent=9,9,9; 
ororon add weapon="favbow" refine=3 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="ap" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="favsword" refine=3 lvl=90/90;
lynette add set="viridescentvenerer" count=4;
lynette add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=59.46 cr=0.331 cd=0.5958;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=10000000 radius=1.5 pos=0,2;
//target lvl=100 resist=0.1 hp=10000000 radius=1.5 pos=0,5.2;
energy every interval=480,720 amount=1;

active neuvillette;
for let x=0; x<4; x=x+1 {
  neuvillette skill, attack;
  lynette burst;
  xilonen skill, attack:2;
  if .xilonen.sets.ap >= 4 {
    xilonen dash; pick_up_crystallize("hydro");
  }
  ororon skill, burst;
  while !.ororon.mods.favonius-cd {
    ororon attack;
  }
  lynette skill, attack;
  neuvillette charge, burst, skill, charge;
  lynette attack, skill, dash;
  xilonen skill, attack:2;
  if .xilonen.sets.ap >= 4 {
    xilonen dash; pick_up_crystallize("hydro");
  }
  neuvillette charge, charge;
}
wait(173);
