# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active xinyan; # SS Stacks
raiden skill, attack;

#active raiden;
#raiden skill;

for let i = 0; i < 4; i = i + 1 {
  chevreuse burst, skill[hold=1]:3;
  
  sara skill, aim, attack:1;
  
  xinyan skill, burst, attack:2;
  
  sara attack:1, burst;
  
  raiden burst, attack:4, dash, attack:4, dash, attack:4, dash, attack:4, skill;
}
