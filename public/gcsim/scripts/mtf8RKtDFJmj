# Lynette Faruzan Lanyan Xianyun. ~21s Rot. Lynette Mono Anemo. Lynette may use burst bewteen skills if missed due to ER. Lanyan slightly prefers Widsith for damage over TTDS passing to Lynette or Xianyun. OHC > SoDP Xianyun, but bubbles may miss. 70% collisions.

# Team - Options listed by DPS
lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="harbinger" refine=5 lvl=90/90;
#lynette add weapon="finale" refine=5 lvl=90/90;
lynette add set="lno" count=4;
#lynette add set="mh" count=4;
lynette add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # LNO
#lynette add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
#lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1653 em=39.64 cr=0.2979 cd=0.662; # MH

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90;
faruzan add set="tom" count=4;
#faruzan add set="no" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="widsith" refine=3 lvl=90/90;
#lanyan add weapon="ttds" refine=5 lvl=90/90;
lanyan add set="no" count=4;
#lanyan add set="gt" count=4;
lanyan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Lynette Plunge Combo
fn LynettePlunge() {
  lynette jump;
  if .airborne {
    lynette high_plunge[collision=rand()>0.3];
  }
}

# Rotation
active faruzan;

for let i = 0; i < 4; i = i + 1 {
  faruzan skill, burst;

  while .lanyan.skill.ready {
    lanyan skill:2;
  }
  lanyan burst;

  xianyun skill, low_plunge, burst;

  if .lynette.burst.ready {
    lynette burst;
  }
  lynette skill;
  LynettePlunge(); lynette dash;
  LynettePlunge(); lynette dash;
  LynettePlunge(); lynette dash;
  LynettePlunge(); lynette dash;
  LynettePlunge(); lynette dash;
  LynettePlunge();
  # Close - can be used to fill time
  if .lynette.burst.ready {
    lynette burst;
  }
  # Manage Lynette Skill CD (Anemo resonance cuts it close)
  while .lynette.skill.cd {
    if .lynette.normal > 1 {
      lynette charge;
    } else {
      lynette attack;
    }
  }
  lynette skill;
  LynettePlunge(); lynette dash;
  LynettePlunge();
  lynette attack, charge,
          attack, charge;
}
