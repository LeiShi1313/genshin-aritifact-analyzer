mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=5;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 em=187 em=187 em=187; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn kinich_combo() {
  kinich skill;
  while .kinich.nightsoul.state {
    if .kinich.blind_spot {
      kinich attack[direction=.kinich.blind_spot];
    } else {
      kinich attack;
    }
    while .kinich.nightsoul.state && .kinich.nightsoul.points < 20 && .kinich.nightsoul.points > 15 {
      wait(1);
    }
    if .kinich.nightsoul.state && .kinich.nightsoul.points == 20 {
      kinich skill[hold=1];
    }
  }
}

active kinich; # SS stacks

for let i=0; i<4; i=i+1{ # 4 rotations
  if i && .emilie.burst.ready { # emilie burst every other rotation
    emilie burst;
  } else {
    emilie skill;
  }
  ororon skill, burst;
  mav skill, burst, charge, dash;
  if i { # additional mav CAs from second rotation on;
    mav charge:2, dash;
  }
  kinich_combo();
  if is_even(i) && .kinich.burst.ready { # kinich burst every other rotation
    kinich burst;
  }
}
