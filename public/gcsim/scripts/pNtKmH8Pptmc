kinich char lvl=90/90 cons=0 talent=9,9,9;
kinich add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
kinich add set="ur" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cr=0.311; #main
kinich add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

