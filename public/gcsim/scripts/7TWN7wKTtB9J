#yae add set="gd" count=4;
yae add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
yae add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # Side

# Functions
# Xianyun Plunge Combo
fn XianyunPlunge() {
  xianyun jump;
  if .airborne {
    xianyun high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active yae;

for let i = 0; i < 4; i = i + 1 {
  yae skill:3;

  # Burst every other rotation after the first
  nahida skill;
  if i > 0 && .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida attack, charge;
  }

  fischl attack, skill;

  xianyun skill, low_plunge, attack, burst; # Attack for Fischl C6

    # 3 High plunges into totem refresh
  XianyunPlunge(); xianyun attack;
  XianyunPlunge(); xianyun dash;
  XianyunPlunge(); xianyun dash;
  XianyunPlunge(); xianyun dash;
  XianyunPlunge(); xianyun dash;
  XianyunPlunge(); xianyun dash;
  XianyunPlunge();

  fischl attack:2, burst;

  XianyunPlunge();
  # FIll time for Yae Totems expiring
  while .status.yae_oldest_totem_expiry > 60 {
    if .xianyun.normal > 2 && .stam > 18 {
      xianyun dash;
    } else {
      xianyun attack;
    }
  }

  if .yae.burst.ready && .yae.energy == .yae.energymax {
    yae burst;
  }
}
