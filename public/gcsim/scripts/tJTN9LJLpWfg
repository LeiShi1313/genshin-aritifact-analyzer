mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=118.92 cr=0.3972 cd=0.3972;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

options iteration=1000 swap_delay=12;                                                                       
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn clorinde_combo() { 
  clorinde skill;
   while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active yae;

yae skill:3;
mav attack, skill;
chevreuse burst, skill[hold=1];
mav burst, dash;
clorinde_combo();
yae burst; # yae burst in opener to fill rot time

for let i = 0; i < 4; i = i + 1 { # 4 rotations

  yae skill:3;
  chevreuse burst, skill[hold=1];
  clorinde burst; # funnel particles to clorinde
  if .mav.burst.ready { # mav burst every other rotation
    mav skill, burst, dash;
  } else {
    mav attack, skill;
    clorinde attack;
  }
  clorinde_combo();

}

