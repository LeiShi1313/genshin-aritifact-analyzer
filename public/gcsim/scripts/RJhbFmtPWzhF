arlecchino char lvl=90/90 cons=0 talent=9,9,9;
arlecchino add weapon="deathmatch" refine=1 lvl=90/90;
arlecchino add set="fohw" count=4;
arlecchino add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
arlecchino add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662 ;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="viridescentvenerer" count=5;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kazuha add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favoniussword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972 ;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active arle;

let rotations = 4;

arle skill;

for let r = rotations; r > 0; r = r - 1 {
  
  if .furina.skill.ready { #furina uses skill and burst every other rotation
    furina skill, dash, burst;
  }

  if !.bennett.burst.ready { 
    arlecchino attack:3;
    bennett attack;
  }
  
  bennett burst, skill;
  
  kazuha skill, high_plunge;
  
  if r < rotations { #not in the first rotation
    arlecchino attack;
  }
  
  arle charge, 
       attack:3, dash,
       attack:3, dash,
       attack:3, dash, 
       attack:3, dash,
       attack:3, dash,
       attack:3, skill;

}
