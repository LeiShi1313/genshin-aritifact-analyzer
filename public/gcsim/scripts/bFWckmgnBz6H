kokomi char lvl=90/90 cons=0 talent=9,9,9;
kokomi add weapon="hakushinring" refine=5 lvl=90/90;
kokomi add set="oceanhuedclam" count=4;
kokomi add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 heal=0.359 ; #main
kokomi add stats def=39.36 def%=0.124 hp=507.88 hp%=0.496 atk=33.08 atk%=0.5952 er=0.1102 em=79.28 cr=0.0662 cd=0.1324 ;

target lvl=100 resist=.1 hp=9999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=500;

active furina;
for let x=0; x<4; x=x+1{
  furina skill, dash, burst;
  kokomi attack, skill;
  fischl attack:2, skill;
  xiangling burst, skill, dash;
  kokomi attack:2, burst;
  for let x=0; x<8; x=x+1 {
    kokomi attack:2, dash, walk[f=2];
  }
  kokomi attack:2, dash, attack:2;
  fischl attack:2, burst;
  xiangling attack:2, skill, dash;
  furina attack:2;
  kokomi attack:2, dash,
         attack:2, jump,
         attack:2, dash,
         attack:2, jump,
         attack:2;
}
