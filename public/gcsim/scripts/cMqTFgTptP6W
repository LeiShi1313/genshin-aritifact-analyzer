options swap_delay=12 iteration=1000;

active mavuika;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

energy every interval=480,720 amount=1;

set_swap_icd(24);

for let i=0; i<5; i=i+1 {
  mualani attack:2;
  xilonen skill, attack:2;
  mualani attack:2;
  sucrose skill, dash;
  mavuika burst, attack;
  mualani skill;
  while .mualani.momentum < 3 {
    mualani walk[f=1];
  }
  mualani attack, skill, attack;
  mavuika skill;
  sucrose skill, dash;
  mualani burst[travel=0];
  xilonen attack, skill, attack:2;
  mualani skill;
  for let j=0; j<2; j=j+1 {
    while .mualani.momentum < 3 {
      mualani walk[f=1];
    }
    mualani attack;
  }
  mualani skill;
}
