options swap_delay=12 iteration=1000;

# Build assumptions
columbina char lvl=90/90 cons=6 talent=10,10,10;
columbina add weapon="nocturnescurtaincall" refine=5 lvl=90/90;
columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
columbina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1986 cd=0.7944;

neuv char lvl=90/90 cons=6 talent=10,10,10;
neuv add weapon="tomeoftheeternalflow" refine=5 lvl=90/90;
neuv add set="mh" count=4;
neuv add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
neuv add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2648 cd=0.5296;

ineffa char lvl=90/90 cons=6 talent=10,10,10;
ineffa add weapon="fracturedhalo" refine=5 lvl=90/90;
ineffa add set="aubadeofmorningstarandmoon" count=5;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

lauma char lvl=90/90 cons=6 talent=10,10,10;
lauma add weapon="nightweaverslookingglass" refine=5 lvl=90/90;
lauma add set="deepwoodmemories" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187;
lauma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active neuv;

for let i=0; i<4; i=i+1 {
  neuv skill;
  columbina skill, burst;
  ineffa attack, skill;
  lauma attack, burst, skill[hold=i];
  neuv charge, skill, charge, burst;
  ineffa burst;
  lauma skill[hold=1];
  neuv charge;
}
wait(475); #for the last CA
