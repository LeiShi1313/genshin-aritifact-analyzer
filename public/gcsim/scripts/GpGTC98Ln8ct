# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # 2nd

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  xianyun skill, low_plunge, burst;
  
  xiao skill:2, burst;
  if .xiao.sets.longnightsoath >= 4 || .xiao.sets.dpc >= 4 {
    xiao attack, charge;
  }
  for let h = 8; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=rand()>0.5];
  }
  
  raiden burst, attack:4, skill, attack:4;
}
