# Mavuika Furina Mona Xilonen. ~20s Rot. Mavuika Double Hydro with Mona to buff her initial burst hit. Q 6C2D Mavuika. Q C11D Mavuika is -4K DPS. 1E Xilonen.

# Team
mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#mavuika add weapon="mailedflower" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662; # SS
#mavuika add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
#mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # MF

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mona char lvl=90/90 cons=0 talent=9,9,9;
mona add weapon="ttds" refine=5 lvl=90/90;
mona add set="no" count=4;
mona add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
mona add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1653 em=39.64 cr=0.2648 cd=0.7282;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 heal=0.359; #main
xilonen add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

let Mav6C2D = true;

# Rotation
active mavuika;

for let i = 0; i < 4; i = i + 1 {
  mavuika skill, dash;

  xilonen burst;

  furina skill, dash, attack, burst;

  xilonen skill, attack:2;

  mona skill, burst;


  mavuika burst;
  if Mav6C2D == true {
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
  } else {
    mavuika charge:11, dash;
  }
}
