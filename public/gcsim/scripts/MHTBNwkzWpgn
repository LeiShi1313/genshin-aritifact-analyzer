ororon add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active furina;
for let i=0; i<2; i=i+1 { 
  furina skill, dash, attack, burst, attack;
  ororon skill, burst;
  kazuha skill, high_plunge;
  clorinde_combo();
  kazuha skill, high_plunge;
  clorinde burst;
  
  kazuha burst;
  ororon skill, burst;
  kazuha skill, high_plunge;
  clorinde_combo();
}