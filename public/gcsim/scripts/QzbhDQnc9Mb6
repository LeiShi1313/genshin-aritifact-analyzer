options swap_delay=12 iteration=100;

# Build assumptions
arlecchino char lvl=90/90 cons=0 talent=9,9,9;
arlecchino add weapon="deathmatch" refine=1 lvl=90/90;
arlecchino add set="fohw" count=4;
arlecchino add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
arlecchino add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv"count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187;
kazuha add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*6 cr=0.0331*12 cd=0.0662*6;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=5;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*2;


# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active nicole;
for let i=0; i<6; i=i+1 {

  nicole skill;
  if i {
    nicole burst;
    arlecchino attack:2;
  }
  arlecchino skill;
  durin skill, burst, skill;
  kazuha skill, high_plunge;
  if i {
    arlecchino attack;
  }
  arlecchino attack, charge,
             attack:3, dash,
             attack:3, dash,
             attack:3;
  if .kazuha.burst.ready {
    kazuha burst;
  } else {
    kazuha skill, high_plunge;
  }
  arlecchino attack:3, dash, attack:3;
}
