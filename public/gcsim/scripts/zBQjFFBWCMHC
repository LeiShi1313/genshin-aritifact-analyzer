# EMC Chevreuse Fischl Bennett. ~16s Rot. EMC on-field DPS. Assumes 3 hits from Electro travelers skill; the Thunder amulets are picked up as soon as possible. EMC bursts as available to fit into the rotation length. EMC does N3C. 3EM > EDC EMC. Fischl just before Chevreuse is better for DPS. Chevreuse bursts every other rot, though it may be possible to burst every rot in game if she's consistently catching EMC amulets.

# Team- Options listsed by DPS
aetherelectro char lvl=90/90 cons=6 talent=9,9,9 +params=[base_atk_buff=3];
aetherelectro add weapon="umbrella" refine=5 lvl=90/90;
#aetherelectro add weapon="harbinger" refine=5 lvl=90/90;
#aetherelectro add weapon="wolffang" refine=1 lvl=90/90;
#aetherelectro add weapon="xiphos" refine=1 lvl=90/90;
aetherelectro add set="tf" count=4;
#aetherelectro add set="gd" count=4;
#aetherelectro add set="cw" count=4;
aetherelectro add stats hp=4780 atk=311 em=187 em=187 em=187; #main
aetherelectro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # 3EM
#aetherelectro add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
#aetherelectro add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # EDCr; Pyro
#aetherelectro add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
#aetherelectro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # EDCd; Pyro
#aetherelectro add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#aetherelectro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # EDCd; Electro
#aetherelectro add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
#aetherelectro add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # EDCr; Electro

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="gt" count=4;
#chev add set="sroll" count=4;
#chev add set="emblem" count=4;
chev add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # VHunt
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Others

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
#bennett add set="scroll" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=237.84 cr=0.0662 cd=0.2648;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

# Rotation
active aetherelectro;
aetherelectro skill; # Chev Passive

#active bennett;

for let i=0; i<4; i=i+1 {
  bennett skill, burst;

  # Fischl before Chev is better
  amy attack;
  if !.amy.skill.ready {
    amy attack, burst;
  } else {
    amy skill;
  }

  # Everyother Rotation; can probably be every rotation if you really manipulate EMC skill pickup time
  if .chev.burst.ready {
    chev burst, skill[hold=1]:2;
  } else {
    chev skill[hold=1], attack;
  }

  while .aetherelectro.mods.bennett-field || .status.bennettburst {
    switch {
      case .aetherelectro.skill.ready:
        aetherelectro skill[hits=3, amulet_delay=107];
      case .aetherelectro.burst.ready:
        aetherelectro burst;
      case .aetherelectro.normal > 3 && .stam > 25:
        aetherelectro charge;
      case .aetherelectro.normal > 3 && .aetherelectro.dash.ready && .stam > 18:
        aetherelectro dash;
      default:
        aetherelectro attack;
    }
  }

  print("done");
}
