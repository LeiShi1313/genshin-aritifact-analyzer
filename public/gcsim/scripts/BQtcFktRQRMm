# Kazaha Furina Faruzan Bennett. ~19s Rot. Whale Kazuha Anemo DPS. Kazuha hEP N1Q tEP 3[N1CD] N2 tEP N1CD N1C. C6 Bennett is a 7K DPS loss.

# Team - Options listed by DPS
kazuha char lvl=90/90 cons=6 talent=9,9,9;
kazuha add weapon="pjc" refine=1 lvl=90/90;
#kazuha add weapon="mist" refine=1 lvl=90/90;
kazuha add set="dpc" count=4;
#kazuha add set="lno" count=4;
kazuha add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
kazuha add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # JPC
#kazuha add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
#kazuha add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12; # Mist

furina char lvl=90/90 cons=3 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="elegy" refine=1 lvl=90/90;
#faruzan add set="vv" count=4;
faruzan add set="scroll" count=4;
#faruzan add set="gt" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="mist" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*8 em=19.82*2 cr=0.0331*10 cd=0.0662*8;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  
  faruzan skill, burst;
  
  bennett skill, burst;
  
  kazuha skill[hold=1], high_plunge[collision=1];
  kazuha attack, burst;
  kazuha skill, high_plunge[collision=1];
  kazuha attack, charge, dash;
  kazuha attack, charge, dash;
  kazuha attack, charge, dash;
  kazuha attack:2;
  kazuha skill, high_plunge[collision=1];
  kazuha attack, charge, dash;
  kazuha attack, charge;
}

