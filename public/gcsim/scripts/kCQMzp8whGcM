#KQMS Delay
options iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 hp=1000000000 radius=2 pos=0,2.4;
target lvl=100 resist=0.1 hp=1000000000 radius=2 pos=0,-2.4;

active nahida;
for let x = 5; x; x = x - 1 {
  nahida burst, skill;
  nilou skill, attack:2, skill;
  baizhu burst, skill;
  ayato burst;
  baizhu attack, skill, attack;
  nahida skill, attack, charge;
  ayato skill, attack:13;
  if .nilou.burst.ready {
    nilou burst;
  }
}

