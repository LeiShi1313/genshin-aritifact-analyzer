# ADC
xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="tidalshadow" refine=5 lvl=90/90;
xinyan add set="no" count=4;
xinyan add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=237.84 cr=0.0662 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="dialogues" refine=5 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i = 0; i < 4; i = i + 1 {
  chevreuse burst, skill[hold=1]:2;
  
  xinyan skill, burst;
  
  fischl attack:2, burst;
  
  raiden burst, attack:4, dash, attack:4, skill, attack:4, dash, attack:4;
  
  if i==0 || i==2 {
    fischl attack:3, skill;
  } else {
    fischl attack:4;
  } 
}

