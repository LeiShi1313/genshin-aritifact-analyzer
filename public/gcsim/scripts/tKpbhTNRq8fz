// flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="aubadeofmorningstarandmoon" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

mona char lvl=90/90 cons=2 talent=9,9,9;
mona add weapon="ttds" refine=5 lvl=90/90;
mona add set="sms" count=4;
mona add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
mona add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="ttds" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187;
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.6612 em=118.92 cr=0.0662 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active mona;
mona attack;
for let i=0; i<6; i=i+1 {
  if is_even(i) {
    ineffa skill, attack; wait(12); # Hide swap cd warning
    if i {
      mona dash;
    }
    mona burst, attack, skill, attack;
    sucrose swap; wait(6);  # Hide swap cd warning
    sucrose skill, dash, attack;
  } else {
    ineffa attack, skill, burst, attack;
    sucrose swap;
    if .sucrose.burst.ready {
      sucrose skill, dash, burst, attack;
    } else {
      wait(6);  # Hide swap cd warning
      sucrose skill, dash, attack;
    }
    mona attack, skill;
  }
  flins skill, attack,
        skill, attack, burst,
        attack:4, dash, attack:4, dash, attack:2,
        skill, attack, burst,
        attack:4;
  // C1
  // flins skill, attack,
  //       skill, burst,
  //       attack:4, dash, attack:2,
  //       skill, attack, burst,
  //       attack:4, dash, attack:2,
  //       skill, attack, burst,
  //       attack:2;
}
# Mona N1 Start
# Ineffa E   > Mona D Q N1 E N1  > Sucrose ED N1 > Flins E N1 E N1 Q 2[N4D] N2 E N1 Q N4 >
# Ineffa E Q > Sucrose ED (Q) N1 > Mona N1 E     > Flins E N1 E N1 Q 2[N4D] N2 E N1 Q N4 >
