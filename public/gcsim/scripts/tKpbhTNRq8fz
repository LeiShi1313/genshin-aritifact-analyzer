options swap_delay=12 iteration=1000;

# Build assumptions
flins char lvl=90/90 cons=0 talent=9,9,9;
flins add weapon="prospectorsshovel" refine=5 lvl=90/90;
flins add set="nightoftheskysunveiling" count=4;
flins add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

