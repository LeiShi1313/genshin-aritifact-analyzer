mavuika add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

options swap_delay=12 iteration=1000;

active mav;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=1; # standard ST target     # freeze_resist=1 for enemies NOT Freezableenergy every interval=480,720 amount=1;

fn mualani_combo1() {
  #doing 1[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<1; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

fn mualani_combo3() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}


for let i=0; i<6; i=i+1 {

  mavuika burst, charge:2, dash, charge:2, dash, charge:2, dash, skill;



  if .verdant-dew == 3 {
    lauma attack;
    lauma skill[hold=1];
  } else {
    lauma skill, attack;
  }

  esco skill;

  mualani skill;
  if .mualani.burst.ready {
    mualani_combo1();
    mualani walk[f=1], burst[travel=2];
    mualani_combo1();
  } else {
    mualani_combo3();
  }

}
