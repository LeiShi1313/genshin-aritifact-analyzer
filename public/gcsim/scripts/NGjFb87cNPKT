kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.2755 em=118.92 cr=0.0662 cd=0.331;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

active furina;

for let i=0; i<4; i=i+1 {
  if i == 0 {
    furina skill, dash, burst;
  } else {
    furina burst;
    # while !.furina.skill.ready {
    #   furina attack;
    # }
    furina skill, dash;
  }
  dori skill, burst, attack;

  kazuha skill, high_plunge, burst;

  mizuki skill, burst;
  while .mizuki.status.dreamdrifter-state {
    wait(1);
  }
  mizuki attack;
  kazuha skill, high_plunge;
}
