chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="hamayumi" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="ttds" refine=5 lvl=90/90;
mualani add set="instructor" count=4;
mualani add stats hp=4780 atk=311 em=187 hydro%=0.348 cd=0.464; #main
mualani add stats def%=0.05208*2 def=16.5312*2 hp=213.31*2 hp%=0.041664*2 atk=13.8936*2 atk%=0.041664*2 er=0.046284*2 em=16.6488*10 cr=0.027804*6 cd=0.055608*2;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; #main
ororon add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=2;
bennett add set="eosf" count=2;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*12 cr=0.0331*2 cd=0.0662*4;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active ororon;

for let i=0; i<4; i=i+1 {
  ororon burst, skill;
  bennett skill, burst;
  mualani skill, attack, skill, attack;
  chasca skill, aim:4;
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca skill, burst;
  } else {
    chasca aim[bullets=4];
  }
}
wait(82); # wait for aim[bullets=4] hits the enemy at the last rot

# 16s rot
# Ororon Q E > Bennett EQ > Mualani E N1 E N1 (instant bite in Skill form followed by an N1 outside of Skill) > Chasca E 4[C] Q/C_4b
