# Freminet Furina Jean Chongyun. ~22s Rot. E-Spam Cryo Freminet w/ Chongyun. Makes use of Chongyun C2 CDR.

# Team- Options listsed by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="tidalshadow" refine=5 lvl=90/90;
#freminet add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
freminet add set="mh" count=4; # Marginally Better
#freminet add set="bs" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622 ; #main
freminet add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662; # TSr5
#freminet add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622 ; #main
#freminet add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # SSr1

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="favoniussword" refine=3 lvl=90/90;
jean add set="viridescentvenerer" count=4;
jean add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311; #main
jean add stats def%=0.1240 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3964 er=0.4408 em=39.64 cr=0.331 cd=0.1324;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
#chongyun add weapon="sacgs" refine=3 lvl=90/90;
chongyun add set="noblesseoblige" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311 ; #main
chongyun add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active chongyun;

#Fav GS Rotation
for let i=0; i<4; i=i+1 {
  chongyun burst,skill;

  furina skill, dash, burst;

  jean attack, skill, burst;

  freminet attack;
  freminet skill,burst,skill;
  freminet skill:2,attack:1;
  freminet skill:2,attack:1;
  freminet skill:2,attack:2;
  freminet skill:2,attack:2;
  freminet skill:2;
}
