#cit mav mona

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="evenstar" refine=1 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=158.56 cr=0.331 cd=0.2648;

chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="chainbreaker" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
chasca add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;

mona char lvl=90/90 cons=0 talent=9,9,9;
mona add weapon="ttds" refine=5 lvl=90/90;
mona add set="instructor" count=4;
mona add stats hp=3571 atk=232 atk%=0.348 hydro%=0.348 cr=0.311;
mona add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.555408 em=33.2976 cr=0.055608 cd=0.222432;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="mailedflower" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mavuika;

for let i = 0; i < 2; i = i + 1 {
  if i==0 {
    mavuika skill;
  } else {
    mavuika skill[hold=1], charge;
  }
  citlali skill, burst;
  mona attack, burst;
  mavuika burst;
  wait(21);
  mavuika charge;
  mona skill, attack;
  chasca skill, burst, aim:3;

  mavuika skill[hold=1], charge;
  citlali skill, burst;
  mona attack, dash;
  mavuika burst, charge;
  mona skill, attack;
  chasca skill, aim:4;
}
wait(125);
