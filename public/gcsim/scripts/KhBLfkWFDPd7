mualani char lvl=90/90 cons=2 talent=9,9,9; #Rotation based on C2 Mualani
mualani add weapon="surfsup" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=5;
mualani add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
mualani add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacrificialfragments" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*2 em=19.82*6 cr=0.0331*8 cd=0.0662*2;

aetherpyro char lvl=90/90 cons=6 talent=9,9,9;
aetherpyro add weapon="favsword" refine=5 lvl=90/90;
aetherpyro add set="scroll" count=4;
aetherpyro add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
aetherpyro add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

mona char lvl=90/90 cons=4 talent=9,9,9; #C2 is ~10% dps loss, C1 is ~16% dps loss
mona add weapon="favcodex" refine=5 lvl=90/90;
mona add set="cg" count=5; #Rotation is based on cg set
#mona add set="instructor" count=5; #For instructor rot is different (check last comment). You need at least 116 er Mualani for this set
mona add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;


options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;


fn mualani_nX_func(attacks_number) {
  while .mualani.nightsoul.state {
    for let k=0; k<attacks_number; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

active mona;

for let i=0; i<4; i=i+1 {

  #instructor rot is commented and cg lines marked as #cg so you need to remove them if testing instructor
  mona skill; wait(120); mona burst, attack:2; #cg
  #aetherpyro burst;
  #mona burst, attack:2;
  sucrose skill, dash;
  aetherpyro skill, attack:1;
  mualani skill;
  mualani_nX_func(1);
  mualani skill, burst[travel=0];
  mona attack:1, charge;
  if .sucrose.skill.ready {
    sucrose skill, dash;
  } else {
    sucrose attack, dash;
  }
  aetherpyro burst; #cg
  #aetherpyro attack:2;
  mualani skill;
  mualani_nX_func(2);
}

#Rotation: Mona E(wait for 2 skill hits) Q N2 > Sucrose E D > PMC E N1 > Mualani E N1 E Q > Mona N1 C > Sucrose E D > PMC Q > Mualani E N2
#For instructor: PMC Q > Mona Q N2 > Sucrose E D > PMC E N1 > Mualani E N1 E Q > Mona N1 C > Sucrose E D > PMC N2 > Mualani E N2
