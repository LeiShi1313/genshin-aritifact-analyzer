options swap_delay=12 iteration=1000;

# Build assumptions
varesa char lvl=90/90 cons=6 talent=10,10,10;
varesa add weapon="vividnotions" refine=5 lvl=90/90;
varesa add set="lno" count=4;
varesa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
varesa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mavuika char lvl=90/90 cons=6 talent=10,10,10;
mavuika add weapon="athousandblazingsuns" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

ororon char lvl=90/90 cons=6 talent=10,10,10;
ororon add weapon="elegy" refine=5 lvl=90/90;
ororon add set="scroll" count=5;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=10,10,10;
chevreuse add weapon="symphonistofscents" refine=5 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    //} else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
    //  varesa jump;
    //  if .airborne {
    //    varesa high_plunge[collision=1]; # JP
    //  }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

active ororon;

for let i=0; i<4; i=i+1 {
  ororon skill, burst;
  if !i {
    chev burst, skill[hold=1];  # 1st rot
  } else {
    chev skill[hold=1];
    if .chev.burst.ready {
      chev burst;
    } else {
      chev attack;
    }
  }
  mavuika skill, burst, charge:2, dash, charge:2, dash;
  varesa_combo(5);
}

# Ororon E Q > Chev Q hE  > Mavuika tE Q 2[C2D] > Varesa 5[Plunge Combos]
# Ororon E Q > Chev hE N1 > Mavuika tE Q 2[C2D] > Varesa 5[Plunge Combos]
# Ororon E Q > Chev hE Q  > Mavuika tE Q 2[C2D] > Varesa 5[Plunge Combos]
# Ororon E Q > Chev hE N1 > Mavuika tE Q 2[C2D] > Varesa 5[Plunge Combos]
