options swap_delay=12 iteration=1000 workers=8;

yoimiya char lvl=90/90 cons=6 talent=9,9,9;
yoimiya add weapon="tpulse" refine=1 lvl=90/90;
yoimiya add set="echoesofanoffering" count=4;
yoimiya add stats hp=4780 atk=311 atk%=.466 pyro%=0.466 cr=0.311; #main 5* set
yoimiya add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;			
																										


target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active yoimiya;
yoimiya burst;
for let x=0; x<4; x=x+1 {

if .yoimiya.burst.ready {
    yoimiya burst;
  }
  
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack:5, dash;

if .yoimiya.burst.ready {
    yoimiya burst;
  }
  
  while !.yoimiya.skill.ready {
    yoimiya attack;
  } 

}