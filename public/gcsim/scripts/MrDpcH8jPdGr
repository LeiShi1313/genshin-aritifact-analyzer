# Yae Furina Kazuha Xianyun. ~22s Rot. Yae Taser plunge with grouping. Kazuha takes one Starwicker plunge. Xianyun refeshes VV/Hakushin mid rotation. Yae bursts every other rotation immediately after all plunges are spent, otherwise she fills time for the next rotation. 50% Collisons.

# Team - Options listed by DPS
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="flowingpurity" refine=5 lvl=90/90;
yae add set="mh" count=4;
#yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662; # Widsith
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662; # Purity

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
#furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # ToM
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # GT

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
#kazuha add set="gd" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.2755 em=118.92 cr=0.0662 cd=0.331;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.3306 em=118.92 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

for let i=0; i<4; i=i+1 {
  yae skill:3;

  furina skill, dash;
  # Attack with fav if off CD or burst deficient
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  xianyun skill, low_plunge, burst;

  # Kazuha wastes one buffed plunge
  kazuha skill, high_plunge, burst;

  # 3 High plunges into totem refresh
  for let i=0;i<3;i=i+1 {
    if .xianyun.status.xianyun-airborne-buff {
      yae jump;
      if .airborne {
        yae high_plunge[collision=rand()>0.5], dash;
      }
    } else if .yae.normal > 2 {
      yae dash;
    } else {
      yae attack;
    }
  }
  yae skill:3;

  # VV + Hakushin, Kazuha here wastes another plunge
  xianyun attack:2; sleep(20); # for CD warning

  # Spend remaining plunges
  while .xianyun.status.xianyun-airborne-buff || .status.yae_oldest_totem_expiry > 330 {
    if .xianyun.status.xianyun-airborne-buff {
      yae jump;
      if .airborne {
        yae high_plunge[collision=rand()>0.5];
      }
      # Avoid dash canceling final plunge
      if .xianyun.status.xianyun-airborne-buff {
        yae dash;
      }
    # When burst is available, skill cd refresh allows you to start the next rot immediately
    } else if .yae.burst.ready && .yae.energy == .yae.energymax {
      yae burst;
          kazuha skill, high_plunge;
      break;
    # More energy and A4 refesh
    } else if .kazuha.skill.ready {
      kazuha skill, high_plunge;
    # Fill time until Yae skills ready
    } else if .yae.normal > 2 && .stam > 50 {
      yae charge;
    } else if .yae.normal > 3 && .stam > 18 {
      yae dash;
    } else {
      yae attack;
    }
  }

}
