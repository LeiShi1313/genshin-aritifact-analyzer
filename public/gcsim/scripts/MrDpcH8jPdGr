# Yae Furina Kazuha Xianyun. ~22s Rot. KQMS KurtC. Yae Taser plunge with grouping. Kazuha takes one Starwicker plunge. Xianyun refeshes VV/Hakushin mid rotation. Yae bursts every other rotation immediately after all plunges are spent. 50% Collisons.

# Team - Options listed by DPS
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="mh" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
yae add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*10 cd=0.0662*11; # ToM
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*10 cd=0.0662*11; # GT

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
#kazuha add set="gd" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*5 em=19.82*6 cr=0.0331*2 cd=0.0662*5;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4;
#xianyun add set="no" count=4;
#xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*6 er=0.0551*7 em=19.82*5 cr=0.0331*2 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

# Functions
# Yae Plunge Combo
fn YaePlunge() {
  yae jump;
  if .airborne {
    yae high_plunge[collision=rand()>0.5];
  }
}

for let i=0; i<4; i=i+1 {
  yae skill:3;

  furina skill, dash;
  # Attack with fav if off CD or burst deficient
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  xianyun skill, low_plunge, burst;

  # Kazuha wastes one buffed plunge
  kazuha skill, high_plunge, burst;

  YaePlunge(); yae dash;
  YaePlunge(); yae dash;
  YaePlunge(); yae skill;

  # VV + Hakushin, Kazuha here wastes another plunge
  xianyun attack:2; sleep(20); # for CD warning

  # Spend remaining plunges
  YaePlunge(); yae dash;
  YaePlunge(); yae dash;
  YaePlunge(); yae dash;
  YaePlunge();
  # When burst is available
  if .yae.burst.ready && .yae.energy == .yae.energymax {
    yae burst;

    kazuha skill, high_plunge;
  } else if .kazuha.skill.ready {
    kazuha skill, high_plunge;
  }
}
