# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active columbina;

for let i=0; i<5; i=i+1 {
  if i > 0 && .columbina.weapon == .keys.weapon.pamber {
    columbina skill, burst;
  } else {
    columbina skill, attack;
  }

  mona burst, attack;

  if is_even(i) {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }

  mona attack, skill, attack;

  hutao skill,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump;

  #Columbina just loiters for CD
}
