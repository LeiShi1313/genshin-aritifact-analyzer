# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active amy;

for let i=0; i<4; i=i+1 {
  amy attack, skill;

  diona skill[hold=1], burst;

  nahida skill, attack, burst;

  haitham skill[hold=1], low_plunge[short=1], attack:3, dash, attack:3, dash, attack:2;

  amy attack:2, burst;

  haitham burst;

  nahida attack, skill, charge;

  haitham attack:3, dash, attack:3, charge, attack:3, dash, attack:3, dash, attack:3, charge;
}
