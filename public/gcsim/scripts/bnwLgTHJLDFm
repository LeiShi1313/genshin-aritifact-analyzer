options swap_delay=12 iteration=100;

noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
noelle add set="husk" count=4;
noelle add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
noelle add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

albedo char lvl=90/90 cons=0 talent=9,9,9;
albedo add weapon="cinnabarspindle" refine=5 lvl=90/90;
albedo add set="goldentroupe" count=4;
albedo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #mainstats
albedo add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
albedo add stats geo%=0.125; #passive

gorou char lvl=90/90 cons=6 talent=9,9,9;
gorou add weapon="favoniuswarbow" refine=5 lvl=90/90;
gorou add set="theexile" count=4;
gorou add stats hp=3571 atk=232 er=0.3885 geo%=0.3495 cr=0.311; #main
gorou add stats def=33.0624 def%=0.10416 hp=426.6192 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.277704 em=33.2976 cr=0.333648 cd=0.444864; # 0.84x modifier

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbingerofdawn" refine=5 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622 ; # main
chiori add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

##Default Enemy

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active gorou;

for let i=0; i<4; i=i+1 {
  gorou skill, burst;
  while !.gorou.mods.favonius-cd { # Cleans up energy warning
    gorou attack;
  }
  albedo attack, skill;
  chiori burst, skill, skill;
  noelle skill, burst, attack:3, dash, attack:3;
  gorou skill, attack;
  noelle attack:3, dash, attack:3, dash, attack:3;
}
