# Clorinde Nahida Fischl Mona. ~17s Rot. KQMS KurtC. Clorinde Hex Quickbloom (barely). Mona hits the field twice. Clorinde bursts every rotation. Burstless Nahida.

# Team - Options listed by DPS
clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
clorinde add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="tom" count=4;
#nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=3 lvl=90/90;
#mona add weapon="pamber" refine=5 lvl=90/90;
mona add set="cg" count=4;
mona add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets - Hyperbloom Ownership varies with size
#target lvl=100 resist=0.1 radius=3 pos=0,3.3 hp=100000000;
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000;

# Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  if i == 0 {
    nahida skill;
  } else {
    nahida skill, attack, charge;
  }

  mona dash:1, burst, attack;

  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }

  mona attack, skill, attack;

  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  clorinde burst;
}
