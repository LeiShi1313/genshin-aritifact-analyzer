# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

active razor; # Serpent Spine Stacks

# Rotation
for let i=0; i<4; i=i+1 {
  if .amy.burst.ready && .amy.skill.ready {
    amy attack, skill;
  }
  
  nahida skill, attack;
  if .nahida.burst.ready {
    nahida burst;
  }
  nahida attack;
  
  yaoyao skill;
	
  if .amy.burst.ready {
    amy attack:2, burst;
  } else {
    amy attack:1, skill;
  }
  
  # TF Rotation 
  razor skill, dash, attack, burst;
  razor attack, skill, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:3;
  
  # GD Combo
  #razor skill, dash, attack, burst,
  #attack:3, skill, dash,
  #attack:3, dash,
  #attack:3, dash,
  #attack:3, skill, dash,
  #attack:3, dash,
  #attack:3, dash,
  #attack:3, skill, dash,
  #attack:2;
}
