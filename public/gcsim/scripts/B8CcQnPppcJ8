# Cyno Nahida Fischl Xianyun. ~25s Rot. Cyno Aggraplunge, taking advantage of 6M Plunge AoE in Cyno's burst. Cyno plunges in-between skill uses off CD. Plunges must be canceled with N1. 50% Collisions.

# Team
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="deathmatch" refine=1 lvl=90/90;
#cyno add weapon="fjords" refine=1 lvl=90/90;
cyno add set="tf" count=4;
#cyno add set="ts" count=4; # slightly worse
cyno add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="scroll" count=4;
#nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.551 em=198.2 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl skill;
  
  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst;
  } else {
    nahida charge;
  }
  
  xianyun attack, skill, low_plunge, burst; # attack 1st for Reliable VV before TKP
  
  fischl attack:2, burst;
  
  let plunges = 0;
  cyno skill, burst, attack, skill; # More comfy
  #cyno burst, skill;
  while .fischl.skill.cd > 30 {
    if .cyno.skill.ready { # && .cyno.mods.cyno-a1 { # For TS
      cyno skill;
    } else if .cyno.status.xianyun-airborne-buff {
      cyno jump;
      if .airborne {
        cyno low_plunge[collision=rand()>0.5], attack;
        plunges = plunges + 1; print(plunges);
      }
    } else if .cyno.normal == 4 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
  
}
