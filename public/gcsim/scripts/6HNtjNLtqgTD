options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn sethos_combo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack; // Last n1 is physical
}

active fischl; 

fischl burst;
kirara skill[hold=10];
sucrose skill, dash, burst;
sethos skill;
sethos_combo(); 
for let r=0; r<3; r=r+1 {
  sucrose attack, charge;
  sethos aim[hold=2];
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  kirara skill[hold=10];
  if .sucrose.burst.ready {
    sucrose skill, dash, burst;
  } else {
    sucrose skill, dash, attack;
  }
  sethos skill;
  sethos_combo();
}
