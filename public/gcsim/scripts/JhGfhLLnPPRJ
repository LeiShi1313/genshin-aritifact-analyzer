options swap_delay=12 iteration=1000;

# Build assumptions
mualani char lvl=90/90 cons=6 talent=10,10,10;
mualani add weapon="surfsup" refine=5 lvl=90/90;
mualani add set="obsidiancodex" count=5;
mualani add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
mualani add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;

citlali char lvl=90/90 cons=6 talent=10,10,10;
citlali add weapon="starcallerswatch" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

mavuika char lvl=90/90 cons=6 talent=10,10,10;
mavuika add weapon="tbs" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

xilonen char lvl=90/90 cons=6 talent=10,10,10;
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="ins" count=4;
xilonen add stats hp=3571 atk=232 def%=0.583 def%=0.43725 def%=0.43725;
xilonen add stats def%=0.31248 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.111216;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active mualani;

fn mualani_combo() {
  #doing 4[3-stacked bite] for C2+
  while .mualani.nightsoul.state {
    for let k=0; k<4; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

mualani attack;
citlali jump, skill;
xilonen skill, attack:2;
mavuika skill, burst, charge, dash;
mualani skill;
mualani_combo();
mualani burst;

mualani attack;
citlali jump, skill;
xilonen skill, attack:2;
mavuika skill, burst, charge:3, dash;
mualani skill;
mualani_combo();
mualani skill;

mualani attack, charge;   # added one CA for timing stuff
citlali jump, skill;
xilonen skill, attack:2;
mavuika dash; # for Cryo aura timing
mavuika skill, burst, charge, dash;
mualani skill;
mualani_combo();
mualani burst;

mualani attack;
citlali jump, skill;
xilonen skill, attack:2;
mavuika skill, burst, dash;
mualani skill;
mualani_combo();
mualani skill;
mualani attack:3, charge; # since you've skipped 3CAs on Mavuika


# Mualani N1  > Citlali J E > Xilonen E N2 > Mavuika   E Q C1D > Mualani E 4[3-stacked bite] Q >
# Mualani N1  > Citlali J E > Xilonen E N2 > Mavuika   E Q C3D > Mualani E 4[3-stacked bite] E(exit) >
# Mualani N1C > Citlali J E > Xilonen E N2 > Mavuika D E Q C1D > Mualani E 4[3-stacked bite] Q >
# Mualani N1  > Citlali J E > Xilonen E N2 > Mavuika   E Q D   > Mualani E 4[3-stacked bite] E(exit) N3C




