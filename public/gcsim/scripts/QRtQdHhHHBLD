
lyney char lvl=90/90 cons=0 talent=9,9,9;
lyney add weapon="crescent" refine=5 lvl=90/90;
lyney add set="mh" count=4;
lyney add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
lyney add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;nahida char lvl=90/90 cons=0 talent=9,9,9;

nahida add weapon="prototypeamber" refine=5 lvl=90/90;
nahida add set="totm" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.1655 cd=0.331;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favsword" refine=3 lvl=90/90;
kazuha add set="vv" count=5;
kazuha add stats hp=4780 atk=311 er=0.518 em=187 em=187 ; #main
kazuha add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90 +params=[pickup_delay=280];
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;


options swap_delay=12 iteration=1000;


active lyney;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  lyney aim[weakspot=1];

  nahida skill, burst;

  kazuha skill, high_plunge;

  bennett skill, burst;

  kazuha burst;

   lyney aim[weakspot=1], aim, aim[weakspot=1];
  if .lyney.burst.ready {
    lyney burst;
    delay(15); # just so he doesn't cancel his own burst before it deals damage
    lyney skill;
  }
  else {
    lyney aim, aim[weakspot=1];
  }

  lyney skill;

  kazuha skill, high_plunge;

  bennett skill;

}
