# Alhaitham Bennett Fischl Dori. ~20s Rot. Long field time Alhaitham Quicken. Alhaitham burst catch Benentt's buff; Fischl deploys Oz during Alhaitham's burst window, alternating skill and burst.

# Team
alhaitham char lvl=90/90 cons=0 talent=9,9,9;
alhaitham add weapon="harbinger" refine=5 lvl=90/90;
#alhaitham add weapon="wolffang" refine=1 lvl=90/90;
alhaitham add set="gd" count=4;
alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944; # HoD
#alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
#alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958; # WF

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=120];
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=237.84 cr=0.0662 cd=0.2648;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="favgs" refine=3 lvl=90/90;
dori add set="deepwood" count=4;
dori add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.331 cd=0.2648; # Scroll

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active fischl;
fischl skill;

for let i=0; i<4; i=i+1 {
  dori skill, burst;

  bennett skill, burst;

  haitham burst;

  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }

  # Optimized-ish combo for 20s rot
  alhaitham attack:3, dash,
            attack:3, charge, dash,
            attack:3, charge, dash,
            attack:1, skill[hold=1], low_plunge[short=1];
  alhaitham attack:4, charge, dash,
            attack:4;
}
