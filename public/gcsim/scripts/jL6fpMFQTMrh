# Lynette Faruzan Durin Nicole. Lynette Anemo DPS w/ Hex. Lynette uses 2 skills per rotation, w/ Faruzan refreshing VV before each use.

# Team - OPtions lisetd by DPS
lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="finale" refine=5 lvl=90/90;
lynette add set="mh" count=4;
lynette add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
lynette add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # Finale
