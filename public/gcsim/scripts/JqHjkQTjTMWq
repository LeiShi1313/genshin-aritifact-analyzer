xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;


# Target
target lvl=100 resist=.1 radius=2 pos=0,2.4 hp=999999999999;
energy every interval=480,720 amount=1;

# Rotation
active bennett;

for let i = 0; i < 4; i = i + 1 {
  
  bennett burst, skill;
  xiangling burst, skill, dash;
  faruzan skill, burst;
  lynette burst, skill, 
          attack:2, charge, 
          attack:2, charge,
          attack:2, charge,
          attack:2, charge;
  bennett skill;
  faruzan skill, aim;
  lynette skill, attack, charge;
}

# Bennett QE > Xiangling Q ED > Faruzan EQ > Lynette Q E 4[N2C] > Bennett E > Faruzan E C > Lynette E N1C