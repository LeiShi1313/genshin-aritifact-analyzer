# Yoimiya Emilie Fischl Mavuika. ~18s Rot. Yoimiya Burningload. Emilie & Yoimiya burst every other rot. Yoimiya does a few extra normal attacks when she doesn't burst just for fighting spirit generation. Fischl alternates skill/burst. Near 0 Quicken uptime. Full EM Fischl Preffered.

# Team - Options listed by DPS
yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="ur" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="deepwood" count=4;
fischl add stats hp=4780 atk=311 em=187 em=187 em=187; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.2204 em=118.92 cr=0.3641 cd=0.331;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="earthshaker" refine=5 lvl=90/90;
mav add set="scroll" count=4;
#mav add set="deepwood" count=4;
#mav add set="oc" count=4;
#mav add set="ur" count=4;
mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Scroll
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # OC

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active emilie;
emilie skill;

for let i = 0; i < 4; i = i + 1 {
  if i > 0 && .emilie.burst.ready {
    emilie burst;
  } else if .emilie.skill.ready {
    emilie skill, attack;
  }
  
  if .mav.burst.ready && i > 0 {
    mav burst, skill, charge:2, dash;
  } else {
    mav attack, skill;
  }
  
  amy attack;
  if .amy.skill.ready {
    amy skill;
  } else {
    amy attack, burst;
  }
  
  yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack:2;
  if .yoimiya.burst.ready && .yoimiya.energy == .yoimiya.energymax && i > 0 {
    yoimiya burst;
  } else {
    yoimiya attack:2; # Needed for fighting spirit generation
  }
}
