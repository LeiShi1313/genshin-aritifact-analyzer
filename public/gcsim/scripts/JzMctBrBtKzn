emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=5;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=50000000;
energy every interval=480,720 amount=1;

active emilie;
for let i=0; i<5; i=i+1 {
  if .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  bennett burst, skill;
  xiangling burst, skill;
  ayaka dash,attack,skill,burst;
  ayaka dash,attack:3,charge;
  ayaka dash,attack:3,charge;
  bennett skill;
  xiangling attack:2;
  while !.xl.mods.favonius-cd {
    xl attack;
  }
  ayaka skill,dash,attack:3,charge;
}
