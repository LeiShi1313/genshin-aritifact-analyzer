# Klee Furina Emilie Baizhu. ~20s Rot. Klee Burngeon with Emilie. Klee bursts every rot when available. Emilie bursts every rotation after the first. Similar damage from Klee, Emilie, and Furina.

# Team
klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="mh" count=4;
#klee add set="ur" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.2648 cd=0.7944; # MH
#klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
#klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.2979 cd=0.7282; # UR

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # ToM

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
#emilie add set="deepwood" count=4;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1653 em=39.64 cr=0.3972 cd=0.5296;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
#baizhu add set="ohc" count=4;
baizhu add set="deepwood" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.331 cd=0.5958;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
#active klee;
#klee skill[bounce=3, mine=8];

active emilie;

for let i=0; i<4; i=i+1 { 
  if i > 0 {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  baizhu skill, attack, burst;
  
  while .furina.skill.cd > 120 {
    switch {
      case .klee.burst.ready && .klee.energy == .klee.energymax && .previous-action == .action.attack:
        klee burst;
      case (.previous-action == .action.charge || .previous-action == .action.skill) && .stam > 18:
        klee dash;
      case .klee.skill.ready:
        klee attack, skill[bounce=3, mine=8];
      case .klee.mods.a1-spark && .previous-action == .action.walk:
        klee attack, charge, jump;
      case .stam > 50 && .previous-action == .action.walk:
        klee attack, charge, jump;
      case .previous-action == .action.attack:
        klee walk;
      default:
        klee attack;
    }
  }
  
}
