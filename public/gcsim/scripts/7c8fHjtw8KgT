bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active navia; # SS Stacks

for let i=0; i<4; i=i+1 {
  navia burst;
  luminepyro skill, burst;
  xilonen skill, attack:2; pick_up_crystallize("pyro");
  bennett skill, burst;
  navia skill[hold=1], attack:3, dash, attack:2;
  xilonen skill, attack:2; pick_up_crystallize("pyro");
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
}

# ~19s rotations
