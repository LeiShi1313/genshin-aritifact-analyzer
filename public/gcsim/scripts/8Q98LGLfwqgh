# Team
varesa char lvl=90/90 cons=0 talent=9,9,9;
varesa add weapon="widsith" refine=3 lvl=90/90;
varesa add set="tf" count=4;
varesa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
varesa add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="hakushin" refine=5 lvl=90/90;
nahida add set="ap" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 em=187; #main
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    //} else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
    //  varesa jump;
    //  if .airborne {
    //    varesa high_plunge[collision=1]; # JP
    //  }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

# Rotation
active varesa;

varesa attack;

xilonen skill, attack:2;

nahida skill, attack, dash; pick_up_crystallize("any");

fischl attack:2, skill;

varesa_combo(2);
varesa attack;
varesa_combo(2);
  
for let i=0; i<3; i=i+1 {
  
  xilonen skill, attack:2;
  
  nahida skill, attack, dash; pick_up_crystallize("any");
  
  fischl attack:2, burst;
  
  varesa_combo(2);
  varesa attack;
  varesa_combo(2);
  varesa attack;
  
  xilonen skill, attack:2;
  
  nahida skill, attack, dash; pick_up_crystallize("any");
  
  fischl attack, skill;
  
  varesa_combo(2);
  varesa attack;
  varesa_combo(2);
  
}

# ~13s rotations
# Fischl E rotation: Varesa N1 > Xilonen E N2 > Nahida E N1D > Fischl N2/N1 E > Varesa 2 Plunge Combos > Varesa N1 > Varesa 2 Plunge Combos
# Fischl Q rotation: Xilonen E N2 > Nahida E N1D > Fischl N2 Q > Varesa 2 Plunge Combos > Varesa N1 > Varesa 2 Plunge Combos