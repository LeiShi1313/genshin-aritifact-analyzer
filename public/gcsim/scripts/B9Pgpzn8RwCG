#Sucrose Ororon Fischl Xingqiu, APL. Sucrose as driver when no skills or bursts are available.

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="hakushin" refine=5 lvl=90/90;
sucrose add set="vv" count=5;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187; #main
sucrose add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324 ;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="chainbreaker" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 +params=[stacks=10] lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
#xingqiu add weapon="wolffang" refine=1 lvl=90/90;
xingqiu add weapon="lionsroar" refine=3 lvl=90/90;
xingqiu add set="no" count=4;
xingqiu add stats hp=4780 atk=311 er=0.518 cr=0.311 hydro%=0.466; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282 ;

# Options
options swap_delay=12 iteration=1000 duration=120;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4;

active fischl;

for {
  switch {
    #fischl
    case .fischl.skill.ready:
      fischl skill, attack;
    case .fischl.burst.ready && !.fischl.oz:
      fischl attack:2, burst;

    #xingqiu
    case .xingqiu.burst.ready && .xingqiu.skill.ready:
      xingqiu skill, dash, burst, attack;

    #ororon
    case .ororon.skill.ready:
      ororon skill, attack:2;
    case .ororon.burst.ready:
      ororon burst, attack;

    #sucrose
    case .sucrose.burst.ready:
      if .sucrose.skill.ready {
        sucrose skill, dash, burst, attack;
      } else {
        sucrose burst, attack;
      }
    case .sucrose.skill.ready:
      sucrose skill, dash, attack;

    #scurose drive
    case .sucrose.normal == 3:
      sucrose walk;
    default:
      sucrose attack;
  }
}
