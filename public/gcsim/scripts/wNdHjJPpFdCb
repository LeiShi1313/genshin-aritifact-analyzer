options swap_delay=12 iteration=1000;

# Build assumptions
neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacjade" refine=1 lvl=90/90;
neuvillette add set="marechausseehunter" count=5;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.4464 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.1986 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="goldentroupe" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
//furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3641 cd=0.662;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="pamber" refine=5 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 er=0.518 em=187 em=187;
sucrose add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=158.56 cr=0.2648 cd=0.1324;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="moonweaversdawn" refine=2 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active neuv;
for let i=0; i<4; i=i+1 {
  neuvillette skill;
  furina attack:2, skill, dash;
  sucrose attack, burst;
  durin skill, attack, burst;
  sucrose swap;   wait(6);  # Hide swap cd warning
  sucrose attack, skill, dash;
  furina burst;
  neuvillette charge, skill, charge, burst;
  durin skill, attack;
  sucrose attack, skill, dash;
  neuvillette charge:2;
}
wait(173); #for the last CA
