# Razor Fischl Kazuha Kirara. ~25s Rot. Razor Aggravate with grouping, C4 Kirara provides enough Dendro to cover the length of the rotation.

# Team
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="ts" count=4;
#razor add set="tf" count=4;
#razor add set="pf" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ATK/Electro; PF/TS
#razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main 
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ATK/ATK; PF
#razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622 ; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ATK/Phys; Echoes

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187;
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6061 em=118.92 cr=0.2979 cd=0.1324;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="favsword" refine=3 lvl=90/90+params=[pickup_delay=120]; # to Fischl
kirara add set="ins" count=4; kirara add set="gd" count=1; # Circlet
#kirara add set="no" count=4;
kirara add stats hp=3571 atk=232 hp%=0.3495 hp%=0.3495 cr=0.311 ; #main
kirara add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.15872 atk=26.464 atk%=0.07936 er=0.4408 em=31.712 cr=0.2648 cd=0.10592; # Ins
#kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
#kirara add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.1324 ; # NO

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active razor; # SS stacks

for let i=0; i<4; i=i+1 {
	fischl attack, skill;
	
	kazuha skill, high_plunge, burst;
	
	kirara skill[hold=1], burst, attack;
	
	fischl attack:2, burst;
	
	kazuha skill, high_plunge;
	
	razor skill, dash, attack, burst, attack, skill, dash;
    while .fischl.skill.cd > 60 {
	  if .razor.normal > 3 && .razor.skill.ready {
       razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}
