#team config

itto char lvl=90/90 cons=0 talent=9,9,9;
itto add weapon="serpentspine" refine=1 lvl=90/90; #navia gets serpent prestack
itto add set="husk" count=4 +params=[stacks=4];
itto add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #mainstats
itto add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2753 em=39.64 cr=0.331 cd=0.7282;

navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="nighttimewhispers" count=4;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; #mainstats
navia add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.1986 cd=0.7944 ;

noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="serpentspine" refine=1 lvl=90/90; #navia gets serpent prestack
noelle add set="marechausseehunter" count=4;
noelle add stats hp=4780 atk=311 def%=0.583 def%=0.583 cd=0.622; #mainstats
noelle add stats def=39.36 def%=0.372 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.2979 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="goldentroupe" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #mainstats
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

#enemy config

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
active furina;

#action list

for let i = 0; i < 3; i = i + 1{

  furina attack, skill;
  navia burst;
  if .navia.skill.ready {navia skill;}
  if .navia.skill.ready {navia skill;}
  itto attack, burst[prestack=1],
       attack, skill, attack:2, charge:5,
       attack:4, charge:5, skill, charge;

  furina skill, burst;

  noelle skill, attack, burst, attack:3,dash;
  pick_up_crystallize("any");
  if.navia.skill.ready {navia skill[hold=1];}
  noelle attack:3,dash;
  pick_up_crystallize("any");
  if.navia.skill.ready {navia skill[hold=1];}
  noelle attack:3,dash;
  pick_up_crystallize("any");
  if.navia.skill.ready {navia skill[hold=1];}
  noelle attack:3,dash;
  pick_up_crystallize("any");
}
