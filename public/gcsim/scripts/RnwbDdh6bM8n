# - Characters

klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="mh" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311 ; #main
klee add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.2204 em=39.64 cr=0.2648 cd=0.7944 ;																																																			

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9; 
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="esf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

# Options

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# Targets

target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999; 

# Actions

active klee;
klee attack; # allows pyro scroll 1st rot

for let i = 0; i < 5; i = i + 1 {
  
  xilonen skill, attack:2, burst;
  furina skill, dash,  burst;
  yelan burst, attack;
  if i && .yelan.breakthrough {
    yelan aim;
  } else if i {
    yelan attack:2;
  }
  xilonen skill, attack:2;
  yelan skill, attack;
  
  klee attack, burst, walk,
       attack[travel=6], charge, 
       attack[travel=6], charge;
  if !i {
    klee attack, skill[bounce=3, mine=8], jump;
  }
  klee attack[travel=6], charge,
       attack, skill[bounce=3, mine=8], jump;
  if i {
    klee attack[travel=6], charge;
  }
  klee attack[travel=6], charge, 
       attack[travel=6], charge,
       attack;
  
  yelan skill, attack:2;
  
}

# Klee 2Hydro Vape with Xilonen. Klee does 5N1C first rot and 6N1C after, vaping ~75% of her CAs. Yelan 2E and Xilo burst + 2E rotation makes ER reqs relatively low. Pyro scroll on 1st rotation only.
# Rotation: [Klee N1], Xilonen EN2 Q, Furina EDQ, Yelan QN1 {aim or N2}, Xilonen EN2, Yelan EN2, Klee combo, Yelan EN2 
# 1st rot Klee combo: N1QW, 2(N1C), N1EJ, N1C, N1EJ, 2(N1C), N1
# Further rots Klee combo: N1QW, 3(N1C), N1EJ, 3(N1C), N1
# [first rot only], {rots > 1 only}