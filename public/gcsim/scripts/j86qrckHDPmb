# Build assumptions
flins char lvl=90/90 cons=1 talent=9,9,9;
flins add weapon="bloodsoakedruins" refine=1 lvl=90/90;
flins add set="nightoftheskysunveiling" count=4;
flins add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
flins add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="fracturedhalo" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacrificialfragments" refine=3 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ;
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*6 cr=0.0331*7 cd=0.0662*3;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="sms" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

options swap_delay=12 iteration=1000;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

active ineffa;

for let i=0; i<4; i=i+1 {
  ineffa skill;
  if .ineffa.burst.ready {
    ineffa burst;
  } else {
    ineffa attack;
  }
  if .furina.skill.ready {
    furina skill, dash, attack;
  }

  sucrose attack, skill, dash;

  flins skill, attack:2;
  flins skill, burst, attack:4, dash, attack:3;
  flins skill, burst, attack:4, dash, attack:2;
  flins skill, burst, attack:4;
  if .sucrose.burst.ready {
    sucrose burst;
  } else {
    sucrose skill;
  }
}
#got the combo from kqm
