options swap_delay=12 iteration=1000;

xilonen char lvl=90/90 cons=4 talent=9,9,9;
xilonen add weapon="peakpatrolsong" refine=1 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 er=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.3972;

chiori char lvl=90/90 cons=4 talent=9,9,9;
chiori add weapon="urakumisugiri" refine=1 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; # main
chiori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

klee char lvl=90/90 cons=4 talent=9,9,9;
klee add weapon="eternalflow" refine=1 lvl=90/90;
klee add set="mh" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311 ; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.2648 cd=0.7944;

furina char lvl=90/90 cons=4 talent=9,9,9;
furina add weapon="key" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 er=0.518 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Target
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

# Rotation
active furina;
for let i=0; i<2; i=i+1 {

  furina skill, dash, burst;
  xilonen burst, skill, attack:2;

  if .chiori.burst.ready {
    chiori burst, skill:2;
  } else {
    chiori skill:2;
    klee attack:2, jump;
  }
  klee attack, charge, burst, walk;
  klee attack[travel=6], charge, attack[travel=6], charge;
  klee attack, skill[bounce=3, mine=8], jump, attack[travel=6], charge;

 if .klee.skill.ready {
      klee attack, skill[bounce=3, mine=8], jump;
    } else {
      klee attack[travel=6], charge;
    }
  klee attack[travel=6], charge, attack[travel=6], charge;
  klee attack, walk, attack;

}

