#builds
furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="archaicpetra" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="wolffang" refine=1 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
chiori add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="ohc" count=4;
bennett add stats hp=4780 atk=311 er=.518 hp%=0.466 heal=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.2648;

#configuration
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

#rotation
active furina;
for let x=0; x<4; x=x+1 {
  if .furina.skill.ready {
    furina skill, dash;
  }
  else {
    furina attack:3, skill, dash;
  }
  zhongli skill[hold=1],dash;
  while !pick_up_crystallize("hydro") {
    wait(1);
  }
   if !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  furina burst;
  bennett burst, skill;
  chiori attack, skill:2;
  bennett attack, skill;
  furina attack:3;
  chiori attack:2, charge;
  if .chiori.burst.ready {
    chiori burst;
  }
  zhongli attack, burst;
  while !pick_up_crystallize("hydro") {
    wait(1);
  }
  chiori attack:2, charge;
  bennett attack, skill;
}
