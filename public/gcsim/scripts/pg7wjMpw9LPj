#cit mav shenhe


escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="chainbreaker" refine=5 lvl=90/90;
chasca add set="oc" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*5 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
#bennett add set="scroll" count=2;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*10 cd=0.0662*6;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 freeze_resist=0 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active furina;
for let i = 0; i < 4; i = i + 1 {
  if is_even(i){
    furina skill, dash;
  } else {
    furina burst;
  }

  if !is_even(i){
    escoffier burst, skill;
  } else {
    escoffier skill, attack;
  }
  
  bennett skill, burst, attack;
  
  chasca skill;
  if is_even(i){
    chasca aim:4;#, aim[bullets=4];
  } else {
    chasca burst, aim:4;
  }
}
wait(125);
