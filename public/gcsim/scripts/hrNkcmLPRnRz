# Ganyu Furina Rosaria Escofier. ~21s Rot. Freeze DPS Ganyu does 4x L2 CA with Fav Rosaria using skill off CD to generate particles. Rosaria passes particles to Furina at the end. Freeze Immunity is -4K DPS.

# Team - Options Listed by DPS
ganyu char lvl=90/90 cons=0 talent=9,9,9;
ganyu add weapon="stillness" refine=5 lvl=90/90;
#ganyu add weapon="crescent" refine=5 lvl=90/90; # No snapshot 1st rot
ganyu add set="bs" count=4; # Better with Freezable
#ganyu add set="mh" count=4;
ganyu add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
ganyu add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*5 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*8 cd=0.0662*9;

rosaria char lvl=90/90 cons=0 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*10 er=0.0551*3 em=19.82*2 cr=0.0331*5 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets, Freezable, 1 Foward, 1 Right
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0; # 1 for Freeze Immunity
#target lvl=100 resist=0.1 radius=1 pos=2.4,0 hp=100000000 freeze_resist=0; # 1 for Freeze Immunity

# Protoype Crescent Headshot Conditional
fn ganyuAim() {
  if .ganyu.weapon == .keys.weapon.crescent { # Attempts headshots (80%) with Crescent
    ganyu aim[hold=2, weakspot=rand()>0.2];
  } else { # Non weakspot opponents
    ganyu aim[hold=2];
  }
}

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;

  escoffier skill, burst;

  rosaria skill, burst;

  ganyu skill, burst;
  ganyuAim();

  rosaria skill;

  ganyuAim();
  ganyuAim();
  ganyuAim();

  ganyu skill;
  rosaria skill;
}
