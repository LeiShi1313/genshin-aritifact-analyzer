ayato char lvl=90/90 cons=0 talent=9,9,9;
ayato add weapon="finaleofthedeep" refine=5 lvl=90/90;
ayato add set="mh" count=4;
ayato add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cd=0.622; #main
ayato add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main 
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

sigewinne char lvl=90/90 cons=0 talent=9,9,9;
sigewinne add weapon="favbow" refine=4 lvl=90/90;
sigewinne add set="clam" count=4;
sigewinne add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main	
sigewinne add stats def%=0.062*2 def=19.68*2 hp=253.94*8 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*2;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main 
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

#enemy config
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

#rotation
active escoffier;

for let i = 0; i < 4; i = i + 1 {
  escoffier skill, attack;
  furina skill, dash, burst;
  sigewinne attack, skill;
  ayato skill, attack:15, burst;
  if .escoffier.burst.ready {
    escoffier burst;
    ayato attack:2;
  } else {
    sigewinne burst;
  }
  ayato skill, attack:15;
}

# ~24s rotation
# If Escoffier Q is not available: Escoffier E N1 > Furina ED Q > Sigewinne N1 E > Ayato E N15 Q > Sigewinne Q > Ayato E N15
# If Escoffier Q is available: Escoffier E N1 > Furina ED Q > Sigewinne N1 E > Ayato E N15 Q > Escoffier Q > Ayato N2 E N15