# Diluc Furina Xianyun Bennett. 4 Rot; same-ish rotation as the 81k sim, removes HP based energy drops, travel=0 NA on Xianyun, and the waiting for Hydro aura. 50% plunge collisions.

diluc char lvl=90/90 cons=0 talent=9,9,9;
diluc add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
diluc add set="lno" count=4;
#diluc add set="cw" count=4;
diluc add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
diluc add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="vv" count=5;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.6612 em=39.64 cr=0.2648 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 cr=0.311 pyro%=0.466 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

options swap_delay=12 iteration=1000;
target lvl=100 type=dummy radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active diluc; #SS stacks

for let r = 0; r < 4; r = r + 1 { 
  furina skill, dash, burst;
  
  xianyun skill, low_plunge, burst;
  
  bennett burst, skill, attack;

  xianyun attack:3, charge;
  
  for let h=0; h<1; h=h+1 { # 1 plunge
    diluc dash, jump;
    if .airborne {
      diluc high_plunge[collision=rand()>0.5], dash, skill:3;
    }
  }
  for let h=0; h<7; h=h+1 { # 7 plunges
    diluc dash, jump;
    if .airborne {
      diluc high_plunge[collision=rand()>0.5];
    }
  }
  
}
