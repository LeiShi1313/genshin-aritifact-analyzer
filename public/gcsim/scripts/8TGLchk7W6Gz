# Gaming Xiangling Bennett Xilonen. ~20s Rot. Gaming Monopyro with 7 plunges. Bennett funnels Xiangling and Gaming. No burst Xilonen.

# Builds
gaming char lvl=90/90 cons=6 talent=9,9,9; 
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="catch" refine=5 lvl=90/90;
xiangling add set="emblem" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active gaming; #SS stacks
gaming skill, low_plunge;

for let i=0; i<4; i=i+1 {
  xilonen skill, attack:2;
  
  bennett burst, skill;
  
  xiangling burst, skill, dash;
  
  bennett skill;
  
  gaming burst, attack:2,
         skill, low_plunge;
  wait(40);
  gaming skill, low_plunge;
  wait(40);
  gaming skill, low_plunge;
  wait(40);
  gaming skill, low_plunge;
  wait(40);
  gaming skill, low_plunge,
         skill, low_plunge,
         skill, low_plunge;
  gaming dash, attack;
  
  xilonen attack;
}

