# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Keqing Plunge Combo
fn KeqingPlunge() {
  keqing jump;
  if .airborne {
    keqing high_plunge[collision=rand()>0.5];
  }
}

active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  
  xianyun skill, low_plunge, attack, burst;
  
  bennett skill, burst;
  
  keqing skill:2, attack; # Overload
  KeqingPlunge(); keqing dash;
  KeqingPlunge(); keqing dash;
  KeqingPlunge(); keqing dash; 
  KeqingPlunge(); keqing dash; 
  KeqingPlunge(); keqing dash;
  KeqingPlunge(); keqing skill, dash;
  KeqingPlunge(); keqing skill; 
  KeqingPlunge(); #keqing attack;

  bennett skill;
}
