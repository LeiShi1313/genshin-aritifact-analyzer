options swap_delay=12 iteration=1000;

# Build assumptions
ganyu char lvl=90/90 cons=0 talent=9,9,9; 
ganyu add weapon="songofstillness" refine=5 lvl=90/90;
ganyu add set="bs" count=5;
ganyu add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="wavebreakersfin" refine=1 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.2755 em=39.64 cr=0.2979 cd=0.5296;

layla char lvl=90/90 cons=6 talent=9,9,9;
layla add weapon="wolffang" refine=1 lvl=90/90;
layla add set="totm" count=4;
layla add stats hp=4780 atk=311 hp%=0.466 cryo%=0.466 cd=0.622;
layla add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active shenhe;

for let i=0; i<4; i=i+1 {
  if is_even(i) {
    shenhe burst;
  } else {
    ganyu aim;
  }
  escoffier skill, attack, burst;
  layla burst, skill;
  shenhe attack, skill[hold=1];
  ganyu skill, burst, aim:3;
}
wait(27); # for the last CA hit
