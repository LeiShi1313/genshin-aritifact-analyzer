charlotte char lvl=90/90 cons=6 talent=9,9,9; 
charlotte add weapon="favcodex" refine=3 lvl=90/90;
charlotte add set="ohc" count=4;
charlotte add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
charlotte add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.4634;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active razor; # SS Stacks
#razor skill, dash;
  
for let i=0; i<4; i=i+1 {
  # Optional
  if i == 0 {
    amy attack:1, skill;
  }

  furina skill, dash;
  while !.furina.burst.ready {
    furina attack;
  }
  furina burst;
  
  charlotte skill, burst, attack;
  
  if .amy.skill.ready { 
    amy attack:1, skill; 
  } else { 
    amy attack:2, burst; 
  }
  
  razor skill, dash, attack, burst,
        attack:3, skill, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, skill, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3;
}

