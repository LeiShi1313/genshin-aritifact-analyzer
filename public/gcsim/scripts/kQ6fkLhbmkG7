options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

# Pickup Crystallize Function
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.chiori && action_id == .action.skill ) || ( char_id == .keys.char.xilonen && action_id == .action.skill ) {
    pick_up_crystallize("any");
  }

  return _execute_action(char_id, action_id, p);
}

fn freminetCombo(){
  freminet skill, dash;
  freminet burst, skill;
  freminet skill:2, attack:2;
  freminet skill:2, attack:2;
  freminet skill:2, attack:2;
  freminet skill:2;
}

active freminet;
freminet skill;

for let i=0; i<4; i=i+1{
  xilonen burst;

  furina skill, dash, burst;

  xilonen skill, attack:2;

  if .chiori.burst.ready{
    chiori burst;
  }
  chiori skill:2;

  # First Rotation Only
  if !i{
    freminet skill;
  }
  freminetCombo();
}
