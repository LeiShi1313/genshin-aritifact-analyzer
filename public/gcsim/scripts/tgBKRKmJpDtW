# Xinyan Chevreuse Fischl Bennett. ~18s Rot. Xinyan uses NAs, in practice you should book trick + spin while shield is up.

# Team
xinyan char lvl=90/90 cons=6 talent=9,9,9;
#xinyan add weapon="redhorn" refine=1 lvl=90/90;
xinyan add weapon="serpent" refine=1 lvl=90/90 +params=[stack=5];
#xinyan add weapon="talkingstick" refine=1 lvl=90/90; xinyan add stats atk%=0.16;
xinyan add set="echoes" count=4; # No CA
#xinyan add set="glad" count=4; # No CA
#xinyan add set="lw" count=4;
#xinyan add set="cw" count=2;xinyan add set="mh" count=2;
#xinyan add set="tom" count=4; # Sus
#xinyan add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
#xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # Redhorn
xinyan add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # SS
#xinyan add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3641 cd=0.662; # TS

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="eosf" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="vhunt" refine=1 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Strigless
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662; # VHunt

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active xinyan; # SS Stacks

for let r = 4; r > 0; r = r - 1 {
  bennett skill, burst;

  fischl attack:1;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }

  chevreuse burst, skill[hold=1]:3;

  xinyan swap;
  # In real gameplay, E > CA > Q on shield break > CA
  while .xinyan.infusion.bennett-fire-weapon || .status.bennettburst {
    if .xinyan.skill.ready {
      xinyan skill;
    } else if .xinyan.burst.ready {
      xinyan burst;
    } else if .xinyan.normal > 2 && .stam > 18 {
      xinyan dash;
    } else {
      xinyan attack;
    }
  }

}
