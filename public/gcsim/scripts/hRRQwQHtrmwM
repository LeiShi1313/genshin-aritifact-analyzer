# Barbara Xiangling Mavuika Xianyun. ~20s Rot. Barbara Vape plunge with no Hydro VV. Mavuika tries to Vape her burst. Barbara can N1 cancel plunges at the start of the rotation without flipping the aura.

# Team
barbara char lvl=90/90 cons=6 talent=9,9,9;
barbara add weapon="widsith" refine=3 lvl=90/90;
barbara add set="longnightsoath" count=4;
#barbara add set="lw" count=4;
#barbara add set="nymph" count=2;barbara add set="hod" count=2;
#barbara add set="nymph" count=4;
barbara add stats hp=4780 atk=311 em=186.5 hydro%=0.466 cr=0.311;
barbara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favlance" refine=3 lvl=90/90;
xiangling add set="emblem" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#mav add weapon="tidalshadow" refine=5 lvl=90/90;
mav add set="scroll" count=4;
#mav add set="oc" count=4;
#mav add set="gt" count=4;
mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Scroll; SS
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # OC; Other
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # OC; SS

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="sodp" count=4;
#xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.4959 em=39.64 cr=0.3972 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active mav; # SS Stacks

for let i=0; i<4; i=i+1 {
  xianyun skill, low_plunge, attack, burst;

  barbara attack, charge;

  if .mav.burst.ready && i > 0 {
    mav burst, skill, dash;
  } else if .mav.skill.ready {
    mav skill, dash;
  }

  xl burst, skill, dash;

  # N1 cancel after plunge for the first 4 plunges, then dash cancel
  let j=0;
  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.status.xianyun-airborne-buff {
      barbara jump;
      if .airborne {
        barbara high_plunge[collision=rand()>0.5];
        j = j + 1;
      }
      if j < 4 {
        barbara attack;
      } else if j == 8 {
        barbara attack;
      } else {
        barbara dash;
      }
    }
  }
  barbara attack:3;

}
