# Yae Emilie Fischl Mavuika. ~25s Rot. On-field Yae Quickburn. Mavuika does Q 2[C2FD] E under Electro aura before Yae uses burst every rotation. Even with this, some Emilie L2 case uptime is sacrificed so DM is near even with UR. After Fischl refreshes her burst, Yae does N2CJ.

# Team - Options listed by DPS
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="solarpearl" refine=1 lvl=90/90;
yae add set="ur" count=4;
#yae add set="gd" count=4;
yae add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # CR
#yae add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # CD

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
#emilie add set="deepwood" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
#fischl add set="ur" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="aquamarine" refine=1 lvl=90/90;
#mavuika add weapon="mailedflower" refine=5 lvl=90/90;
mavuika add set="scroll" count=4;
#mavuika add set="deepwood" count=4;
mavuika add stats hp=4780 atk=311 em=187 em=187 em=187; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=118.92 cr=0.3972 cd=0.1324; # 3EM
#mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
#mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5456 er=0.1102 em=198.2 cr=0.1655 cd=0.1324; # EDC

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

for let i = 0; i < 4; i = i + 1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae attack, skill, attack, skill, attack, skill;
  }

  # It barely matters if you use burst in Rot 1
  if .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie attack, skill;
  }

  fischl skill, attack;

  if .mav.burst.ready {
    mav burst,
        charge:2, charge[final=1], dash,
        charge:2, charge[final=1], dash,
        skill, dash;
  } else {
    mav dash, skill;
    yae attack:2, charge, jump;
    yae attack:2, charge, jump;
  }

  yae attack, burst, skill:3;

  fischl attack:2, burst;

  yae attack:2, charge, jump;
  yae attack:2, charge, jump;
  yae attack:2, charge, dash;
  yae attack:2;
}
