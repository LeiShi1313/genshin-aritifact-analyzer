# (C6)Deyha (C1)Emilie Durin Nicole. ~18s Rot. Deyha Hex Burning. Assumes Proximity Burning damage.

# Team
dehya char lvl=90/90 cons=6 talent=9,9,9;
dehya add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
dehya add set="ur" count=4;
dehya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
dehya add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*12 cd=0.0662*9;

emilie char lvl=90/90 cons=1 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*6 er=0.0551*9 em=19.82*2 cr=0.0331*2 cd=0.0662*3;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # Small Size enables Proximity Burning Damage.

# Rotation
active dehya;

for let i=0; i<6; i=i+1 {
  dehya skill;

  if i > 0 && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill;
  }

  nicole burst, skill;

  durin burst, attack, skill:2, attack;

  dehya burst, attack:15;
}

# 20s rotations
# Dehya E > Emilie E/Q > Nicole Q E > Durin Q N1 2[E] N1 > Dehya Q N15
