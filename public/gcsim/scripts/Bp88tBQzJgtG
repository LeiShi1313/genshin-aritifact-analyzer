fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9; 
nahida add weapon="evenstar" refine=1 lvl=90/90;
#nahida add weapon="hakushin" refine=5 lvl=90/90; # performs similarly
nahida add set="ap" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; # main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn sethos_combo() {
  sethos skill, burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2;
  sethos aim[hold=2];
}

active sethos; 
sethos aim[hold=1]; #apply electro for crystallize;
xilonen skill, attack:2;
nahida skill, dash; pick_up_crystallize("electro");
fischl attack:2, burst;
sethos_combo();
  
for let r=0; r<5; r=r+1 { # 5 rotations (in addition to modified opening rotation)
  xilonen skill, attack:2;
  if .nahida.burst.ready {
    nahida skill, burst, dash; pick_up_crystallize("electro");
  } else {
    nahida attack, charge, dash, attack, charge, skill, dash; pick_up_crystallize("electro");
  }
  if .fischl.skill.ready {
    fischl attack, skill, attack;
  } else {
    fischl attack:2, burst; 
  }
  sethos_combo();
}

# Sethos "Combo":
# Sethos E Q 8N2w N2 CA

# First Rotation:
# Sethos CA ► Xilonen E N2 ► Nahida Ed ► Fischl N2 Q ► Sethos "Combo"
# Following Rotations: 
# Xilonen E N2 ► Nahida (E Qd / N1 CAd N1 CA Ed) ► Fishcl (N1 E N1 / N2 Q) ► Sethos combo
