options swap_delay=12 iteration=1000;

# Build assumptions
yaemiko char lvl=90/90 cons=6 talent=10,10,10;
yaemiko add weapon="kagurasverity" refine=5 lvl=90/90;
yaemiko add set="mh" count=5;
