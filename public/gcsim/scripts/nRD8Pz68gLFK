# Chevreuse Xiangling Fischl Bennett. ~15s Rot. CW Chevreuse on-field DPS. Fischl/Xiangling snapshot Bennett's buff. Xiangling Bursts every other rotation.

# Options ordered by DPS
chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="deathmatch" refine=1 lvl=90/90;
chev add set="cw" count=4;
chev add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622 ; #main
chev add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;
#chev add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622 ; #main
#chev add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; #+1CD -1ER

xiangling char lvl=90/90 cons=6 talent=9,9,9; 
xiangling add weapon="deathmatch" refine=1 lvl=90/90;
xiangling add set="emblem" count=4;
#xiangling add set="cw" count=2; xiangling add set="sr" count=2;
#xiangling add set="cw" count=2; xiangling add set="no" count=2;
xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
xiangling add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
#fischl add weapon="viridescenthunt" refine=1 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="twilight" refine=5 lvl=90/90;
fischl add set="gt" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # w/ others
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # w/ VH

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
#bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2317 cd=0.662;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662 ;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active bennett;

for let i=0; i<2; i=i+1 {  
  bennett burst, skill;
  
  xiangling burst, skill, dash;
  
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  
  bennett attack, skill;
  
  chev burst, skill[hold=1],
      skill[hold=1],
      skill[hold=1],
      attack, charge, dash,
      attack, charge, dash,
      attack, charge, dash,
      attack, charge, dash;
  
  bennett skill, burst;
  
  xiangling skill, dash;
  
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  
  bennett attack, skill;

  chev attack:2, burst, attack, skill[hold=1],
      skill[hold=1],
      attack, charge, dash,
      attack, charge, dash,
      attack, charge, dash,
      attack, charge, dash,
      attack;
}
