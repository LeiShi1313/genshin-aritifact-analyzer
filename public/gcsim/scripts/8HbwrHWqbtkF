# Raiden (C6)Dehya Chevreuse Bennett. ~20s Rot. Full length Dehya burst. Raiden does not catch Bennett burst buff. Chev Bursts in Bennett Q.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9; 
raiden add weapon="catch" refine=5 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311 ; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.4959 em=39.64 cr=0.1324 cd=0.662;

dehya char lvl=90/90 cons=6 talent=9,9,9;
dehya add weapon="akuoumaru" refine=1 lvl=90/90;
#dehya add weapon="tidalshadow" refine=5 lvl=90/90;
dehya add set="mh" count=4;
#dehya add set="vg" count=4;
#dehya add set="emblem" count=4;
dehya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main 5* set
dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # MH
#dehya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
#dehya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # VG/EoSF

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="gt" count=4;
chev add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;
#hurt every interval=50, 70 amount=1000,3000 element=physical; # Aggressive
hurt every interval=300, 450 amount=1000,3000 element=physical;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active raiden;
raiden skill;

for let i = 0; i < 4; i = i + 1 {
  bennett burst, skill;
  chevreuse burst, skill[hold=1]:3;
  dehya burst, skill:16;
  raiden burst, attack:4, skill, attack:4;
}

