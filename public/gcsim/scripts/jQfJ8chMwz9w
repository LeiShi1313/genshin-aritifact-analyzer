# Razor Chevreuse Xiangling Bennett. ~20s Rot. EM Razor Overload. Chevreuse and Xiangling burst every rotation in Bennett Q, Chevreuse funnels particles to Xiangling. Razor Self-Aura not implemented. 

# Team- Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="favgs" refine=3 lvl=90/90;
razor add set="gd" count=4;
razor add stats hp=4780 atk=311 em=187 em=187 em=187; #main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # 3EM
#razor add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
#razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # EEC

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="gt" count=4;
#chev add set="emblem" count=4;
chev add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9; 
xiangling add weapon="catch" refine=5 lvl=90/90;
xiangling add set="emblem" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
#bennett add set="scroll" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944; # Crit
#bennett add stats hp=3571 atk=232 er=0.518 em=187 em=187; #main
#bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=158.56 cr=0.331 cd=0.1986; # EM; Likely better with self-Overloads

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; 

# Rotation
active razor; # SS stacks
razor skill, dash; # Chev A1

for let i=0; i<4; i=i+1 {
  if .bennett.burst.ready && .bennett.energy == .bennett.energymax {
    bennett burst, skill;
  } else {
    bennett skill, burst;
  }
  
  chev burst, skill[hold=1]:2;
  if !.chev.mods.favonius-cd {
    chev skill[hold=1];
  }
  
  xl burst, skill[a4_delay=60], dash;
  
  # Razor out of burst actions; account for CD
  while !.razor.mods.razor-q {
    if .razor.burst.ready && .razor.skill.ready {
      razor skill, dash, attack, burst;
    } else if .razor.burst.ready {
      razor burst;
    } else if .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  # Razor Main DPS window 
  #while .razor.infusion.bennett-fire-weapon { 
  while .razor.mods.razor-q > 330 { # Fixed Rot
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
}
