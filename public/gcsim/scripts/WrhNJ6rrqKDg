fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="thestringless" refine=3 lvl=90/90;
fischl add set="goldentroupe" count=4;
fischl add stats def%=0.124 def=39.36 hp=5287.88 hp%=0.0992 atk=344.08 atk%=0.0992 er=0.1102 em=266.28 cr=0.642 cd=0.7944 electro%=0.466;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphosmoonlight" refine=1 lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats def%=0.124 def=39.36 hp=5287.88 hp%=0.0992 atk=344.08 atk%=0.0992 er=0.4408 em=679.92 cr=0.2317 cd=0.4634;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="favoniussword" refine=3 lvl=90/90;
#kirara add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=210]; # 210f makes clorinde pickup the leaf when she enters the field in the first rot, it becomes inconsistent after
kirara add set="totm" count=4; # 5star set effect doesn't matter here
kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
kirara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finaleofthedeep" refine=5 lvl=90/90;
clorinde add set="tf" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main 5* set
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

options iteration=100 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

energy every interval=480,720 amount=1;

fn clorinde_combo() {

  clorinde skill;

  while .clorinde.status.clorinde-night-watch {
    
    if .clorinde.bolratio >= 1 {

      clorinde skill;

    } else {

      clorinde attack;

    }

  }

}

active fischl; 

for let r=0; r<4; r=r+1 { # 4 rotations 

  if r>0 {

    kazuha skill, high_plunge; # swirl to refresh VV and kazuha A4 for fischl/oz snapshot  

    fischl attack;

  }

  fischl burst;

  kirara skill,burst;

  kazuha burst; # kazuha burst for first clorinde combo ensures fischl/oz snapshot of his A4 for second clorinde combo

  clorinde_combo();

  fischl attack, skill;

  kazuha skill, high_plunge;

  clorinde_combo();

}