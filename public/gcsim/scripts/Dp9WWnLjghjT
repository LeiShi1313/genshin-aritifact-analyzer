options swap_delay=12 iteration=1000;

arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
arle add set="fohw" count=4;
arle add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; # main
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favoniuslance" refine=5 lvl=90/90;
rosaria add set="scroll" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="wanderingevenstar" refine=1 lvl=90/90;
sucrose add set="viridescentvenerer" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active arle;

fn sucr_combo() {
  arle charge[early_cancel=1], dash;
  wait(20);
  arle attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash;
  wait(5);
  arle attack:2;
}

fn base_combo() {
  arle charge[early_cancel=1], dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash;
  delay(22);
  arle attack;
  rosaria skill;
  arle attack:2, dash,
       attack:2, dash,
       attack:3;
}

for let i=0; i<6; i=i+1 {
  let q_was = false;
  
  arle skill;
  bennett skill, burst;
  sucrose attack, skill;
  if .sucrose.burst.ready {
    sucrose burst;
    q_was = true;
  }
  rosaria skill, burst, dash;
  
  if q_was {
    sucr_combo();
  } else {
    base_combo();
  }
}