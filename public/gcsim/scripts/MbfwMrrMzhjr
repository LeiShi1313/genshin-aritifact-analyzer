# Gaming Furina Emilie Bennett. ~21s Rot. Gaming Burning with Furina Vape. Gaming juggles Manchai, catching him in midair and filling time on the ground with infused normal attacks. Bennett passes particles to Gaming. Deepwood Emilie narrowly edges out UR thanks to Burgeon.

# Team - Options listed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="ur" count=4;
#gaming add set="mh" count=4;
#gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Other
#gaming add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # MH

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
#furina add set="deepwood" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="deepwood" count=4;
#emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
#bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.3972 cd=0.3972;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=3 pos=0,3.4 hp=100000000; # Adjacent

# Rotation
active gaming; #SS Stacks

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;

  if i > 0 && .emilie.burst.ready && .emilie.energy == .emilie.energymax {
    emilie burst;
  } else {
    emilie skill, attack;
  }

  bennett burst, skill;

  gaming burst, attack:2;
  for let i=0; i<6; i=i+1 {
    gaming skill, high_plunge, attack:1;
  }
  gaming skill, high_plunge, dash;
}
