# --- Pre-action hook setup

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
  pick_up_crystallize("any"); # Pick up crystallize before every dash
  }

  return _execute_action(char_id, action_id, p);
}

# --- Team
navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="nighttimewhispers" count=5;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311 ; #main
navia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="cinnabarspindle" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; # main
chiori add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add set="clam" count=5;
xianyun add weapon="ttds" refine=5 lvl=90/90;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# --- Options
options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

# --- Targets
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;

# --- Rotation
active navia;

for let x = 0; x < 4; x = x + 1 {
  navia burst;
  chiori skill:2;
  furina skill, dash, burst;

  while !.furina.mods.favonius-cd {
    furina attack;
  }

  xianyun skill, low_plunge, burst;
  pick_up_crystallize("any");
  navia skill[hold=1];

  for let h = 4; h > 0; h = h - 1 {
    let col = rand();
    navia jump;
    if .airborne {
      if col > 0.5 {
        navia high_plunge[collision=1], dash;
      } else {
        navia high_plunge, dash;
      }
    }
  }

  furina attack:2, dash; # To feed fav particles to navia
  navia skill[hold=1];

  for let h = 4; h > 0; h = h - 1 {
    let col = rand();
    navia jump;
    if .airborne {
      if col > 0.5 {
        navia high_plunge[collision=1], dash;
      } else {
        navia high_plunge, dash;
      }
    }
  }

  if .chiori.burst.ready {
    chiori burst;
  } else {
    navia attack:2;
  }
}
