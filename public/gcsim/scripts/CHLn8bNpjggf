# Raiden Furina Nahida Sigewinne. ~21s Rot. EM Raiden Hyperbloom with on-field Raiden. Given the low ER req and dead space, Sigewinne uses her burst every rotation.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="fjords" refine=1 lvl=90/90;
#raiden add weapon="dbane" refine=3 lvl=90/90;
raiden add set="fopl" count=4;
#raiden add set="gd" count=4;
raiden add stats hp=4780 atk=311 em=187 em=187 em=187; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.1324 cd=0.3972; # Fjords
#raiden add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324; # Dbane

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3641 cd=0.7282;

sigewinne char lvl=90/90 cons=0 talent=9,9,9;
sigewinne add weapon="favbow" refine=4 lvl=90/90;
sigewinne add set="ohc" count=4;
#sigewinne add set="tom" count=4;
sigewinne add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
sigewinne add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  nahida skill, burst, charge;

  furina skill, dash, burst;

  sigewinne skill, attack;

  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;

  sigewinne burst;
}
