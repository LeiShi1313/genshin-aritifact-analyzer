# Kokomi Nahida Yelan Raiden. ~22s Rot. Kokomi on-field Hyperbloom. Kokomi's skill heals over the setup period and is freshed with her burst. Kokomi's burst is wrapped by Yelan skill uses.

# Team
kokomi char lvl=90/90 cons=0 talent=9,9,9;
kokomi add weapon="pamber" refine=5 lvl=90/90;
kokomi add set="ohc" count=4;
kokomi add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 heal=0.359; # main
kokomi add stats def%=0.124 def=39.36 hp=1015.76 hp%=0.496 atk=33.08 atk%=0.5952 er=0.1102 em=39.64 cr=0.0662 cd=0.1324;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="favcodex" refine=3 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="dbane" refine=3 lvl=90/90;
raiden add set="fopl" count=4;
raiden add stats hp=4780 atk=311 em=187 em=187 em=187; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.3306 em=118.92 cr=0.0662 cd=0.2648;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # 2nd T

# Rotation
active kokomi;

for let i=0; i<4; i=i+1 {
  kokomi skill;

  raiden attack, skill;

  yelan burst, attack;

  nahida skill, attack, charge;

  yelan attack, skill, attack;

  kokomi burst;
  kokomi attack:2, walk;
  kokomi attack:2, walk;
  kokomi attack:2, walk;
  kokomi attack:2, walk;
  kokomi attack:2, walk;
  kokomi attack:2, walk;
  kokomi attack:2, walk;
  kokomi attack:2, walk;
  kokomi attack:2, walk;
  kokomi attack:2, walk;

  # Catch own particles
  yelan attack:1, skill, attack:4;

  nahida skill, attack:2, charge;

  kokomi attack:2;
  print("done");
}
