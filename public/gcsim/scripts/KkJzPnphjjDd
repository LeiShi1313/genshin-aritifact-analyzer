# Yae Chevreuse Mavuika Bennett. ~16s Rot. On-field Yae Overload. Mavuika funnels skill particles into DPS Chevreuse who only does Q 2hE for rotation length reasons. 

# Team - Options listed by DPS
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="flowingpurity" refine=5 lvl=90/90;
#yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="fohw" count=4; # With FP
#yae add set="gt" count=4;
#yae add set="tom" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="deathmatch" refine=1 lvl=90/90;
chevreuse add set="gt" count=4;
#chevreuse add set="emblem" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Other
#chevreuse add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3641 cd=0.4634; # Emblem

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
mav add set="scroll" count=4;
mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2648 cd=0.7282;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active mav; # SS Stacks

for let i=0; i<4; i=i+1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae skill, attack, skill, attack, skill;
  }
  
  bennett burst, skill;
  
  if .mav.burst.ready {
    mav burst, skill, dash;
  } else {
    mav attack, skill;
  }
  
  chev burst, skill[hold=1]:2; # Always two for rotation length
  
  bennett skill;
  
  yae attack:2, charge, dash;
  yae attack:2, charge, dash;
  if .yae.burst.ready {
    yae burst;
  } else {
    yae attack:2, dash, attack;
  }
  
  bennett skill, attack:1;
  
  yae attack:1;
}
