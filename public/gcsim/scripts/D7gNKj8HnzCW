active wrio;
target lvl=100 resist=0.1 hp=999999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

for let x=0; x<4; x=x+1 {
  furina attack, skill, burst;
  shenhe skill[hold=1], attack, burst;
  charlotte skill, burst, attack; # N1 to catch her particles during her on-field
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready {
    wrio burst;
  } else {
    wrio charge, jump, attack;
  }
}
