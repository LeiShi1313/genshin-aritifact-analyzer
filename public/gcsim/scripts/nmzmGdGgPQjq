# Xianyun Faruzan Fischl Bennett. ~24s Rot. Xianyun Plunge. Xianyun uses lvl 3 twice per rotation under Bennett's buff. Fischl uses skill and burst every rotation, with burst under Bennett's buff. 50% Collisions.

# Team
xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="flowingpurity" refine=5 lvl=90/90;
#xianyun add weapon="widsith" refine=3 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="longnightsoath" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90;
faruzan add set="scroll" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=0];
#fischl add weapon="vhunt" refine=1 lvl=90/90;
#fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="gt" count=4;
#fischl add set="tom" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2648 cd=0.7282; # Other
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
#fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.4634; # VH

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=237.84 cr=0.1324 cd=0.5296;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl attack, skill;

  faruzan skill, burst;

  bennett skill, burst;

  xianyun skill:3, high_plunge, burst;

  amy attack:2, burst;

  # Xianyun plunge
  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.skill.ready {
      xianyun skill:3, high_plunge;
    } else if .xianyun.status.xianyun-airborne-buff {
      xianyun jump;
      if .airborne {
        xianyun high_plunge[collision=rand()>0.5];
      }
      if .xianyun.status.xianyun-airborne-buff {
        xianyun dash;
      }
    }
  }

  faruzan skill, aim:2;

  # Xianun N2D
  while .fischl.skill.cd > 30 {
    if .xianyun.normal > 2 {
      xianyun dash;
    } else {
      xianyun attack;
    }
  }
}
