yoimiya char lvl=90/90 cons=1 talent=9,9,9;
yoimiya add weapon="rust" refine=5 lvl=90/90;
yoimiya add set="echoes" count=4;
yoimiya add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
yoimiya add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=5 lvl=90/90;
yelan add set="no" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311 ; #main
yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="lionsroar" refine=5 lvl=90/90;
durin add set="risingwinds" count=5;
durin add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311 ; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*3 cr=0.0331*10 cd=0.0662*12;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="sacbow" refine=5 lvl=90/90;
fischl add set="gift" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*8 cd=0.0662*12;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

active amy;
for let i=0; i<4; i=i+1 {
  if i {
    if .yoimiya.burst.ready {
      yoimiya burst;
    } else {
      yoimiya attack:3;
    }
  }
  amy skill, attack;
  yelan skill, attack, burst, attack;
  durin skill:2, burst;
  amy attack:2, burst;
  yoimiya attack, skill,
    attack:5, dash,
    attack:5, dash,
    attack:5, dash,
    attack:1;
}
