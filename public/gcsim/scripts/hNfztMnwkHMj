options swap_delay=12 iteration=1000;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="finale" refine=5 lvl=90/90;
skirk add set="deepgalleries" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="favcodex" refine=3 lvl=90/90;
mualani add set="scroll" count=4;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
mualani add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mona char lvl=90/90 cons=0 talent=9,9,9;
mona add weapon="ttds" refine=5 lvl=90/90;
mona add set="no" count=4;
mona add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
mona add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="tom" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.3972 cd=0.2648;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

let First_Rot_Nuke = true;  # Change this value between true and false.

active escoffier;

for let i=0; i<4; i=i+1 {
  escoffier skill, attack, burst;
  while !.escoffier.mods.favonius-cd {
    escoffier attack;
  }
  mualani skill, attack, skill, attack:2;
  mona burst, skill;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack:5, dash,

          attack:2, charge, dash,

          attack:5, dash,
          attack:5, dash,

          attack:2, charge, dash,

          attack:4;
    skirk attack; # Phys
  } else {
    skirk skill,
          attack, burst,

          attack:5, dash,
          attack:5, dash,

          attack:2, charge, dash,

          attack:5, dash,
          attack:5, dash;
    skirk attack:2; # Phys
  }
}
