# Raiden Furina Xilonen Xianyun. ~20s Rot. Raiden Xianyun Taser. Raiden doesn't benefit from Xianyun's plunge buff; this isn't recommeneded. Xilonen can plunge once or twice.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9; 
raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3641 cd=0.4634;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
#xilonen add weapon="harbinger" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9; 
xianyun add weapon="hakushin" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.2755 em=237.84 cr=0.0662 cd=0.331;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Raiden Plunge Combo
fn RaidenPlunge() {
  raiden jump;
  if .airborne {
    raiden high_plunge[collision=rand()>0.5];
  }
}

# Xilonen Plunge Combo
fn XilonenPlunge() {
  xilonen jump;
  if .airborne {
    xilonen high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 { 
  furina skill, dash, burst;
  
  xianyun skill, low_plunge, attack, burst;
  
  # JhPN1 & N2 are similar
  xilonen skill;
  XilonenPlunge(); xilonen attack:1;
  #xilonen attack:2;
  
  raiden burst;
  RaidenPlunge(); raiden attack;
  RaidenPlunge(); raiden attack;
  RaidenPlunge(); raiden attack;
  RaidenPlunge(); raiden attack;
  RaidenPlunge(); raiden attack, skill;
  
  xilonen skill;
  #XilonenPlunge(); xilonen attack:1;
  xilonen attack:2;
  xilonen burst; # Fill time
  
  print("done");
}
