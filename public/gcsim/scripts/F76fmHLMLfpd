# Mavuika Chevreuse Ororon Fischl. ~18s Rot. Mavuika Double Electro Overload. Mav Q 4C2FD 1CF; 14CD is -7K DPS. Healer Chevreuse. 

# Team
mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#mavuika add weapon="tidalshadow" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # SS
#mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # TS

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.2648;

ororon char lvl=90/90 cons=6 talent=9,9,9; 
ororon add weapon="chainbreaker" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9; 
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="tom" count=4;
#fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; 
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

let C2F = true;

# Rotation
active mavuika; # SS Stacks

for let i=0; i<4; i=i+1 {
  mavuika skill;

  ororon skill, burst;
  
  if .chev.burst.ready {
    chev burst, skill[hold=1]:3;
  } else {
    chev skill[hold=1], burst;
  }
  
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst; 
  }
  
  if C2F == true { # 4C2FD 1CF
    mavuika burst, 
      charge:2, charge[final=1], dash, 
      charge:2, charge[final=1], dash,
      charge:2, charge[final=1], dash, 
      charge:2, charge[final=1], dash,
      charge:1, charge[final=1];
  } else { # C13FD
    # Easy combo, just book and hold CA, 4 CA after burst expiry
    mavuika burst, 
      charge:14, dash; 
  }
  
}
