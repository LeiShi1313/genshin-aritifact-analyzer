options swap_delay=12 iteration=1000;

# Build assumptions
neuvillette char lvl=90/90 cons=6 talent=10,10,10;
neuvillette add weapon="tomeoftheeternalflow" refine=5 lvl=90/90 ;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2648 cd=0.7944;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="splendoroftranquilwaters" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=6 talent=10,10,10;
kazuha add weapon="freedomsworn" refine=5 lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187;
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

zhongli char lvl=90/90 cons=6 talent=10,10,10;
zhongli add weapon="favlance" refine=5 lvl=90/90;
zhongli add set="ap" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311;
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active neuvillette;

for let i=0; i<4; i=i+1 {
  neuvillette skill;
  furina skill, dash, attack;
  zhongli skill[hold=1], dash, attack;
  if !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  while !pick_up_crystallize("hydro") {
    wait(1);
  }
  if is_even(i) {
    kazuha burst;
  } else {
    kazuha skill, high_plunge;
  }
  furina burst;
  neuvillette charge, burst;
  kazuha skill, high_plunge;
  neuvillette skill, charge;
}
wait(715); #for the last CA
