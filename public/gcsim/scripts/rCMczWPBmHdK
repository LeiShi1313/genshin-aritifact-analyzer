# Razor Furina Rosaria Xianyun. ~20s Rot. Razor Phys Plunge. Razor uses skill off CD while plunging and does not burst. Rosaria passes particles to Furina at the end of the rotation. OHC > SoDP Xianyun, but bubbles may miss. In practice, you may Dragonstrike accidentally for an unbuffed 9th plunge. 50% Collisions. 

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#razor add weapon="fruitfulhook" refine=1 lvl=90/90;
razor add set="lno" count=4;
#razor add set="pf" count=4;
#razor add set="mh" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Other
#razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # MH

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
