yelan add weapon="favoniuswarbow" refine=4 lvl=90/90;
yelan add set="emblemofseveredfate" count=4;
yelan add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311 ; #main
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active zhongli;
for let x=0; x<4; x=x+1 {
  zhongli skill[hold=1], dash;
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  navia burst;
  yelan skill, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack;
  }
  if .fischl.skill.ready {
    fischl attack, skill, dash;
  } else {
    fischl attack:2, burst; pick_up_crystallize("any");
  }
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2, dash;     print(.navia.shrapnel);
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
}

