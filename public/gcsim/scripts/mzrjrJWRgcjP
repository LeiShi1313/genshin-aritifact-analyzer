rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="deathmatch" refine=1 lvl=90/90;
rosaria add set="ur" count=4;
rosaria add stats hp=4780 atk=311 em=187 cryo%=0.466 cd=0.622;
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3641 cd=0.5958;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="deepwood" count=4;
bennett add stats hp=4780 atk=311 er=0.518 em=187 em=187;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=158.56 cr=0.2648 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622;
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
active rosaria;

# Furina ED Q > Bennett EQ / QE N1* > Emilie E/Q > Rosaria E N1 Q N2CD 2[N1CD] N2E N2CD N2 > Bennett E N1
# *do EQ first rotation, then QE N1 to heal himself
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  if i { # bennett doesn't heal himself first rotation
    bennett burst, skill, attack;
  } else {
    bennett skill, burst;
  }
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack:2;
  }
  rosaria skill, attack, burst,
      attack:2, charge, dash,
      attack:1, charge, dash,
      attack:1, charge, dash,
      attack:2, skill,
      attack:2, charge, dash, attack:2;
  bennett skill, attack;
}
