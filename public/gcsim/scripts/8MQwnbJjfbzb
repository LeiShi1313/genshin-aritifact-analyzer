options swap_delay=12 iteration=1000;

neuvillette char lvl=90/90 cons=0 talent=9,9,9 ;
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90 ;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.1655 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.2648 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="favcodex" refine=3 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.2755 em=39.64 cr=0.2317 cd=0.662;

active neuvillette;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  neuvillette skill;
  furina attack, skill, dash, attack;
  citlali skill, attack;
  escoffier skill, burst;
  furina burst, attack:2;
  neuvillette attack, charge, skill, charge, burst;
  citlali attack:2;
  if !.citlali.mods.favonius-cd {
    citlali dash, attack;
  }
  neuvillette charge, charge;
}
wait(173); #for the last CA
