# Eula Furina Raiden Xianyun. ~20s Rot. Eula Phys Plunge. Eula bursts every 2nd-3rd Rotation, with Raiden skill providing burst damage bonus. TTFS Xianyun is close.

# Team
eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
eula add set="longnightsoath" count=4;
#eula add set="mh" count=4;
#eula add set="pf" count=4;
#eula add set="pf" count=2;eula add set="bsc" count=2;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Other
#eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # MH

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="favlance" refine=3 lvl=90/90;
raiden add set="tom" count=4;
raiden add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=237.84 cr=0.331 cd=0.1324;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add weapon="ttds" refine=5 lvl=90/90;
#xianyun add set="ohc" count=4; # Bubbles may miss
xianyun add set="vv" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.2755 em=99.1 cr=0.0662 cd=0.1324; # Oathsworn
#xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
#xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324; # TTDS

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active eula; # SS stacks

for let x = 0; x < 4; x = x + 1 {
  raiden skill, attack;
  if !.raiden.mods.favonius-cd {
    raiden attack;
  }
  
  furina skill, dash, attack, burst;
  
  xianyun skill, low_plunge, burst;
  
  # Minor burst stacking when available
  if .eula.burst.ready && .eula.energy == .eula.energymax  {
    eula skill, burst, walk, attack, skill[hold=1];
  } else { # Fill time for Furina skill CD
    eula skill, attack:4, skill[hold=1];
  }
  # Plunge spam after RES shred
  while .eula.status.xianyun-airborne-buff {
    eula jump;
    if .airborne {
      eula high_plunge[collision=rand()>0.5];
    }
    if .eula.status.xianyun-airborne-buff { # swap > dash for final plunge
      eula dash;
    }
  }
}
