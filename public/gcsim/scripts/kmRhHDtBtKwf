options swap_delay=12 iteration=1000;

# Build assumptions
skirk char lvl=90/90 cons=0 talent=9,9,9 +params=[start_serpents_subtlety=100]; # default is 100
skirk add weapon="eshu" refine=5 lvl=90/90;
//skirk add set="finaleofthedeepgalleries" count=4;
skirk add set="mh" count=4;
// skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
// skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
skirk add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

dahlia char lvl=90/90 cons=6 talent=9,9,9;
dahlia add weapon="favsword" refine=3 lvl=90/90;
dahlia add set="no" count=4;
dahlia add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
dahlia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

citlali char lvl=90/90 cons=0 talent=9,9,9; 
citlali add weapon="pamber" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 heal=0.358;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999 freeze_resist=0; # standard ST target     # freeze_resist=1 for enemies NOT Freezable
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

let First_Rot_Nuke = true;  # Change this value between true and false.

active furina;

for let i=0; i<4; i=i+1 { 
  furina skill, dash, attack, burst;
  citlali skill, burst;
  dahlia skill, attack, burst;
  if i == 0 && First_Rot_Nuke == true {
    skirk burst;
    skirk skill,
          attack, charge, dash,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5;
  } else {
    skirk skill,
          attack, burst,
          
          attack:5, dash,
          attack:5, dash,
          attack:5, dash,
          
          attack:2, charge, dash,
          
          attack:5, dash,
          attack:5;
  }
}

