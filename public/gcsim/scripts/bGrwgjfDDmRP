#Eula Raiden Furina Mika, ~25s rotation. KQMS. Eula does Q N3 hE N4 N2 to utilize Mika atk spd. E at the end for more particles. Eula has 133% ER.
options swap_delay=12 iteration=1000;

eula char lvl=90/90 cons=6 talent=10,10,10;
eula add weapon="sobp" refine=5 lvl=90/90;
eula add set="mh" count=4;
eula add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622 ; #main
eula add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

raiden char lvl=90/90 cons=6 talent=10,10,10;
raiden add weapon="favspear" refine=5 lvl=90/90;
raiden add set="tom" count=4;
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311 ; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="splendor" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.1986 cd=0.7944;

mika char lvl=90/90 cons=6 talent=10,10,10;
mika add weapon="symphonist" refine=5 lvl=90/90;
mika add set="no" count=4;
#mika add set="sodp" count=4;
mika add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311;
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;

active raiden;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

raiden skill;
for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  mika burst, skill;
  eula skill;
  if i != 0 {
    eula attack:2; # wait energy from mika
  }
  eula burst, walk, attack:3, skill[hold=1], walk[f=11], attack:4, dash, attack:2, skill;
  raiden burst, attack:4, skill, attack:4, dash, attack:4;
}
