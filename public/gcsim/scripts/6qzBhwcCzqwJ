#nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.1655 cd=0.7282; # EDC/MagicGuide

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets - Hyperbloom Ownership varies with size
#target lvl=100 resist=0.1 radius=3 pos=0,3.3 hp=100000000;
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000;

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl attack, skill;

  nahida skill, attack, burst;

  xingqiu skill, dash, burst, attack;

  dori skill, attack:2, dash, attack:2, burst;

  while .xingqiu.skill.cd {
    if !.amy.oz && .amy.burst.ready {
      amy attack:2, burst;
    } if .dori.skill.ready {
      dori skill;
    } else if .dori.normal > 2 {
      dori dash;
    } else if .dori.infusion.dori-c6 {
      dori attack:1;
    } else if .nahida.skill.ready {
      nahida skill;
    } else {
      nahida attack:1, charge;
    }
  }

}
