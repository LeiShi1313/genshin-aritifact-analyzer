# Gaming Citlali Bennett Xilonen. ~20s Rot. Gaming Melt Plunge with 7/7 Plunges melted. Gaming juggles Man Chai, using burst into skill + plunge and waiting on the ground before catching Man Chai mid descent. Citlali refreshes Cryo with NA for the final Melt plunge. Give up on Instructors Diona. Chev and Diona C6 are worth ~10K each.

# Team - Options listed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
#citlali add weapon="evenstar" refine=1 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; 
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

diona char lvl=90/90 cons=6 talent=9,9,9; 
diona add weapon="favbow" refine=4 lvl=90/90;
diona add set="sodp" count=4;
#diona add set="ins" count=4;
diona add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
diona add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944; # SoDP
#diona add stats hp=3571 atk=232 er=0.518 hp%=0.3495 cr=0.23325; #main
#diona add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.185136 em=33.2976 cr=0.27804 cd=0.222432; # Ins

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Adjacent

# Rotation
active gaming; #SS Stacks

for let i=0; i<4; i=i+1 {
  diona skill[hold=1], burst;
  
  chev skill[hold=1], burst;
  
  citlali skill, burst;

  gaming burst;
  let plungeCount = 0;
  for let j = 0; j < 5; j = j + 1 {
    sleep(45); # Cacth Manchai during descent
    gaming skill, high_plunge;
    plungeCount = plungeCount + 1; print(plungeCount);
  }
  sleep(30); # Catch Manchai during descent
  gaming skill, high_plunge;
  plungeCount = plungeCount + 1; print(plungeCount);
  
  citlali attack:2;
  
  gaming skill, high_plunge; 
  plungeCount = plungeCount + 1; print(plungeCount); # Melted
}
