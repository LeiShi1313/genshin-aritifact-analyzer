fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;


options swap_delay=12 iteration=1000;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active fischl;
for let i=0; i<4; i=i+1 {
  fischl attack;
  if !.fischl.skill.ready {
    fischl attack;
  }
  fischl skill;
  xingqiu burst, attack;
  bennett skill, attack, burst;
  xiangling attack, burst, attack, skill, dash;
  bennett attack, skill;
  xingqiu skill, dash, attack:2;
  fischl attack:2, burst;
  bennett attack:2, skill;
  xingqiu attack:2;
  bennett attack:5, skill;
  xiangling attack:2, skill, dash, attack;
  bennett attack:2, skill;
  xiangling attack:3;
  fischl swap;
}
