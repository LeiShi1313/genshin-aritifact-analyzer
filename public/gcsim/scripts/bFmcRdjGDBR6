xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.331 cd=0.2648;
																
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=1000;
#-------------------------------------------- 
#action list:
active furina;
for let i = 0; i < 6; i = i + 1 {
  if !i {
    furina skill, dash, burst;
  } else {
    furina attack, burst, skill, dash;
  }
  yelan burst, attack;
  xianyun skill, low_plunge, attack, burst;
  if !.xianyun.mods.favonius-cd {
    xianyun attack;
  }
  yelan attack, skill, attack;
  yoimiya skill, 
          attack:5, dash, 
          attack:5, dash, 
          attack:5;
  yelan skill, attack:3, dash;
}
