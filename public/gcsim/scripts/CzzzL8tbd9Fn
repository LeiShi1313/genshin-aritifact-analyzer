# Razor Furina Chongyun Jean. 20s Rotation. Meme Team. Razor's Cryo Infusion expires halfway through burst.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
#razor add weapon="tidalshadow" refine=1 lvl=90/90;
razor add set="mh" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favoniusgreatsword" refine=3 lvl=90/90;
chongyun add set="noblesseoblige" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311 ; #main
chongyun add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="favoniussword" refine=3 lvl=90/90;
jean add set="viridescentvenerer" count=4;
jean add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311 ; #main
jean add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5456 er=0.2755 em=39.64 cr=0.331 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active razor;
razor skill, dash; # Ensures max sigils for 1st rotation burst

for let i=0; i<4; i=i+1 {
  chongyun burst, skill;
  furina burst, skill, dash;
  jean skill, burst;

  # Razor out of burst actions; account for energy deficiency
  while !.razor.mods.razor-q {
    # When burst is ready
    if .razor.burst.ready {
      if .razor.skill.ready {
        razor skill, dash, attack, burst;
      } else {
        razor burst;
      }
    } else {
    # When burst is not ready
      if .razor.skill.ready {
        razor skill, dash, attack:1;
      } else {
      # When neither burst or skill is ready
        if .razor.normal > 3 {
          if .razor.skill.ready {
            razor skill, dash;
          } else {
            razor dash;
          }
        } else {
          razor attack;
        }
      }
    }
  }
  # Upon bursting
  while .razor.mods.razor-q {
    if .razor.normal > 3 {
      if .razor.skill.ready {
        razor skill, dash;
        if .furina.skill.ready {
          break;
        }
      } else {
        razor dash;
      }
    } else {
      razor attack;
    }
  }
  # Notation
  # Chongyun QE > Furina QED > Jean EQ >
  # Razor EDN1Q N3ED N3D N3D N3ED N3D N3D N3ED
}
