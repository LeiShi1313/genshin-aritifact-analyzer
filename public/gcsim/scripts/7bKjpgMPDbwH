xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="evenstar" refine=1 lvl=90/90;
#xianyun add weapon="magicguide" refine=5 lvl=90/90;
#xianyun add weapon="sacfrags" refine=3 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2317 cd=0.1986; # 3EM

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=-1.6,1.8 hp=100000000;
target lvl=100 resist=0.1 radius=1.5 pos=1.6,1.8 hp=100000000;

# Rotation
active fischl;
fischl skill;

for let i=0; i<4; i=i+1 {
  # No attack in first rot
  if .fischl.skill.cd <= 30 {
    fischl attack, skill;
  }

  # Q Consumes too much FT
  nahida skill;
  #if .nahida.burst.ready {
  #  nahida burst;
  #} else {
    nahida attack;
  #}

  while .xianyun.skill.ready {
    xianyun skill, low_plunge;
  }
  xianyun attack, burst; # N1 wanted for (Fischl C6)

  while .fischl.skill.cd >= 30 {
    switch {
      # Fischl Oz uptime
      case !.amy.oz && .amy.burst.ready:
        amy attack:2, burst;
      # Covers Kazuha & Sac & C1
      case .kazuha.skill.ready && .kazuha.swap.ready:
        kazuha skill, high_plunge[collision=rand()>0.2];
      case .kazuha.burst.ready && .kazuha.skill.cd  && .kazuha.swap.ready:
        kazuha burst;
      # VV refresh with TF
      case .kazuha.sets.tf == 4 && .status.vvelectro:
        xianyun attack;
      # Kazuha C6
      case .kazuha.infusion.kazuha-c6-infusion && .previous-action == .action.low_plunge:
        kazuha attack;
      case .kazuha.infusion.kazuha-c6-infusion && .xianyun.status.xianyun-airborne-buff:
        kazuha jump;
        if .airborne {
          kazuha low_plunge[collision=rand()>0.5];
        }
      case .kazuha.infusion.kazuha-c6-infusion && .kazuha.normal > 1 && .stam > 25:
        kazuha charge;
      case .kazuha.infusion.kazuha-c6-infusion:
        kazuha attack;
      # Xianyun Swirl
      case .xianyun.onfield && .previous-action == .action.low_plunge:
        xianyun attack;
      case .xianyun.weapon == .keys.weapon.sacfrags && .xianyun.skill.ready && .xianyun.swap.ready:
        xianyun skill, low_plunge;
      case .xianyun.status.xianyun-airborne-buff && .xianyun.swap.ready:
        xianyun jump;
        if .airborne {
          xianyun low_plunge[collision=rand()>0.5];
        }
      # Defaults
      #case .kazuha.sets.tf == 4:
      #  kazuha attack;
      default:
        xianyun attack;
    }
  }
  # Questionable TF Value vs Rotation Extension
  #if .kazuha.skill.ready {
  #  kazuha skill, high_plunge[collision=rand()>0.2];
  #}
  print("done");
}
