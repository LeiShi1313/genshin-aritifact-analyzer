# Kazuha Furina Fischl Xianyun. ~25s Rot. APL. (TF) Kazuha Aggravate in 2T. Kazuha uses burst off CD after skill, Xianyun uses burst once per rotation, Nahida does not burst. Xianyun plunges when Kazuha's Anemo plunges are not available. Note that in situations in which this team is ideal, Sac Sword and Vhunt offer additional value. Accomodates Kazuha constellations. 80% Collisions from Kazuha Skill, 50% From Starwicker plunges.

# Team - Option Listed by DPS
kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
#kazuha add weapon="sacsword" refine=5 lvl=90/90;
#kazuha add weapon="ironsting" refine=5 lvl=90/90;
kazuha add set="tf" count=4;
#kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324; # 3EM; Xiphos
#kazuha add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
#kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=198.2 cr=0.0662 cd=0.2648; # EDC; Xiphos
#kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; # 3EM; Sac
