alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; #2 em, 8 cr, 10 cd

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999;
energy every interval=480,720 amount=1;

active raiden;

raiden skill;

for let i=0; i<4; i=i+1 {
  fischl attack, skill;
  baizhu skill, burst, attack;
  alhaitham skill[hold=1], low_plunge,
            attack:3, charge, dash,
            attack:3, charge, burst;
  fischl attack:2, burst;
  baizhu attack:2, skill;
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  print ("done");
}
