arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
arle add set="ur" count=5;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ;
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=5;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

yanfei char lvl=90/90 cons=6 talent=9,9,9;
yanfei add weapon="prototypeamber" refine=5 lvl=90/90;
yanfei add set="noblesse" count=4;
yanfei add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466 ; #main
yanfei add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=237.84 cr=0.331 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active arle;
arle skill;
for let i = 0; i < 4; i = i + 1 {
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill, attack;
  }
  furina skill, dash, attack;
  if ( i / 2 ) * 2 != i {
    furina burst;
  } else {
    yanfei attack:2, charge;
  }
  yanfei skill, attack, burst, attack;
  arle charge,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3,
       skill;
  if ( i / 2 ) * 2 != i {
    arle burst, skill;
  } else {
    yanfei attack:3, charge;
  }
}
