sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacrificialfragments" refine=3 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187; #main
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*12 em=19.82*6 cr=0.0331*2 cd=0.0662*2;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.062*5 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

travelerpyro char lvl=90/90 cons=6 talent=9,9,9;
travelerpyro add weapon="sacsword" refine=5 lvl=90/90;
travelerpyro add set="archaicpetra" count=4;
travelerpyro add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
travelerpyro add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*7 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*11;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mualani;

for let i=0; i<3; i=i+1 {

  # 3 BITE PHASE
  if i { # Fill downtime while waiting for Pyro Traveler's E CD
    mualani attack:3, charge;
  }
  mualani attack;
  xilonen skill, attack:2;
  while !.xilonen.mods.favonius-cd {
    xilonen attack;
  }
  sucrose skill, jump;
  if .sucrose.skill.ready {
    sucrose skill, jump;
  }
  travelerpyro burst, dash, skill;
  pick_up_crystallize("hydro");
  mualani skill,
          walk[f=90], attack,
          walk[f=90], attack,
          walk[f=90], attack,
          skill;

  # BURST PHASE
  xilo burst;
  mualani attack, charge;
  xilonen skill, attack:2;
  while !.xilonen.mods.favonius-cd {
    xilonen attack;
  }
  sucrose skill, dash, burst;
  travelerpyro dash, skill;
  pick_up_crystallize("hydro");
  mualani skill;
  if .mualani.burst.ready {
    mualani walk[f=2], burst,
            walk[f=46], attack;
  } else { # Fallback for giga unlucky sim scenarios but it rarely happens
    mualani walk[f=90], attack,
            walk[f=90], attack;
  }
  mualani walk[f=90], attack,
          skill;

}

# 16-18s rotations (Varying based on Sac Procs)
#             Mualani (N3C) N1 > Xilonen E N2 (NX) > Sucrose EJ (EJ) > Pyro Traveler QD tE > Mualani E 3[3-stacked bite]
# Xilonen Q > Mualani N1C      > Xilonen E N2 (NX) > Sucrose EDQ     > Pyro Traveler D tE  > Mualani E Q 2[3-stacked bite]
