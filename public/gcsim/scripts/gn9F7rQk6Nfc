options swap_delay=12 iteration=300;

lynette char lvl=90/90 cons=6 talent=9,9,9;
lynette add weapon="amenoma" refine=5 lvl=90/90;
lynette add set="viridescentvenerer" count=5;
lynette add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="lionsroar" refine=3 lvl=90/90;
keqing add set="thunderingfury" count=5;
keqing add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
keqing add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # sub

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="sapwood" refine=5 lvl=90/90+params=[pickup_delay=280];
kirara add set="no" count=4;
kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466 ; #main
kirara add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3310 cd=0.1986;	

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active fischl;
fischl burst; #start with fischl burst before the cyclic rotation

for let i=0; i<4; i=i+1 { 
  
  if .fischl.burst.ready{
  
  fischl attack:2, burst;
  }    
  
  kirara skill, burst;
  
  lynette skill, burst, attack;
  
  keqing skill, burst, skill,
         attack, charge,
         attack, skill,
         attack, charge;
         delay(9); #simulator requires delay for fischl's A4 ICD, unlikely to be needed with human play
  keqing attack, charge;

  # part 2 of rotation starts here, no bursts from lynette or kirara.         
 
  fischl attack:2, skill;
   
  kirara skill, attack;
 
  lynette skill, attack;
 
  keqing skill, burst, skill,
         attack, charge,
         attack, skill,
         attack, charge;
         delay(9);
  keqing attack, charge;

}
