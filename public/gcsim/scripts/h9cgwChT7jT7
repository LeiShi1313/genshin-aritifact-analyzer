yaemiko char lvl=90/90 cons=0 talent=9,9,9;
yaemiko add weapon="widsith" refine=3 lvl=90/90;
yaemiko add set="gd" count=4;
yae add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311 ; #main
yae add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944 ;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add set="deepwood" count=4;
#baizhu add set="clam" count=4;#very similar
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359 ; #main
baizhu add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.3972 cd=0.1324 ;

options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active yae;

for let x = 0; x < 3; x = x + 1 {
  if x==0 {
    yae skill:3;
  } else {
    yae  skill, attack, skill, attack, skill;
  }

  furina skill, dash, attack;

  kazuha skill, high_plunge, burst;

  furina burst;

  baizhu skill, burst, attack;

  kazuha skill, high_plunge;

  yae attack;# charge, dash;

  if .yae.burst.ready {
    yae burst;
  } else {
    yae charge, dash;
  }
  yae skill:2, attack, skill,
      attack, charge, dash;
  kazuha skill, high_plunge;

  baizhu skill, attack;

  yae attack:2, charge, dash,
      attack:2, charge, dash,
      attack;


  print("Rotation Done");
}
