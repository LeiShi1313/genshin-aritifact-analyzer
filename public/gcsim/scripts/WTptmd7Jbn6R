# Columbina Furina Zhongli Xilonen. ~20s Rot. On field Columbina DPS Lunar Crystallize. Columbina takes the field to drive Lunar Crystallize with Zhongli's Pillar resonances and deals the plurality of the DPS. Zhongli has time and energy to burst every rotation, at a DPS gain.

# Team
columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="notsu" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*12 cr=0.0331*3 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="deathmatch" refine=1 lvl=90/90;
zhongli add set="sms" count=4;
zhongli add stats hp=4780 atk=311 em=187 geo%=0.466 cd=0.622;
zhongli add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.062*5 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active zhongli;
zhongli skill[hold=1];

for let i=0; i<4; i=i+1 {
  columbina skill, burst;

  xilonen skill, attack:2;
  xilonen burst;

  furina skill, dash, attack:0, burst;

  if i == 0 {
    columbina attack:4;
  }

  zhongli skill[hold=1], burst;

  columbina attack:3;

  xilonen skill, attack:2;

  columbina attack:3, dash;
  columbina attack:3, dash;
  columbina attack:3;
}
