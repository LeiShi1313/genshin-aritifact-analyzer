# Arlecchino Emilie Lanyan Bennett. ~16s Rot. Arlecchino Burning with Emilie. Arlecchino 5N3D N3. Lanyan's shield buffed by Bennett, No Lanyan Burst.

# Team - Options listed by DPS
arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="deathmatch" refine=1 lvl=90/90;
arle add set="ur" count=4;
#arle add set="fohw" count=4;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; 
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
#emilie add set="deepwood" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="ttds" refine=5 lvl=90/90;
#lanyan add weapon="evenstar" refine=1 lvl=90/90;
lanyan add set="vv" count=4;
lanyan add stats hp=4780 atk=311 em=187 anemo%=0.466 cr=0.311; #main
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # TTDS
#lanyan add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944; # Evenstar

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2317 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1; # KQM Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; # 2T

# Rotation
active arle;

for let i = 0; i < 4; i = i + 1 {
  arle skill;
  
  bennett swap;   delay(12);  # wait for Arle E particles before Q cast
  bennett skill, burst;
  
  if i > 0 && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  
  lanyan attack, skill:2;
  
  arle charge, 
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3, dash,
       attack:3;
}
