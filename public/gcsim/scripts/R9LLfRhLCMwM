eula char lvl=90/90 cons=0 talent=9,9,9;
eula add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
eula add set="longnightsoath" count=4;
#eula add set="shime" count=4;
eula add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
eula add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.551 em=198.2 cr=0.0662 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favoniussword" refine=3 lvl=90/90;
bennett add set="instructor" count=4;
bennett add stats hp=3571 atk=232 er=0.387 pyro%=0.3495 cr=0.311; #main
bennett add stats def=33.0624 def%=0.10416 hp=426.6192 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.667296; # 0.84x modifier

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,3;

active eula;
for let r = 0; r < 4; r = r + 1 {
  furina skill, dash, burst;
  xianyun skill, low_plunge, burst;
  bennett burst, skill, attack;
  xianyun attack:2;
  wait(20); # Squash swap cooldown warning
  eula skill;
  for let h = 0; h < 4; h = h + 1 {
    eula jump;
    if .airborne {
      eula high_plunge[collision=rand()>0.5], dash;
    }
  }

  eula skill[hold=1];
  for let h = 0; h < 4; h = h + 1 {
    eula jump;
    if .airborne {
      eula high_plunge[collision=rand()>0.5], dash;
    }
  }
  eula attack:2;
  bennett skill, attack:2;
}
