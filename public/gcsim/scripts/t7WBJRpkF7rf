# Hutao Chevreuse Fischl Nicole. ~17s Rot. KQMS KurtC. HuTao Hex Overload. Hutao E N3CJ 5N2CJ N2C(DQ/JN2CJ). Hutao bursts if available. DPS Chevreuse is better.

# Team - Options listed by DPS
hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="deathmatch" refine=1 lvl=90/90;
hutao add set="mh" count=4;
#hutao add set="sr" count=4;
hutao add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 cd=0.622; #main
hutao add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*9 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*7 cd=0.0662*10; # MH
#hutao add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 cr=0.311; #main
#hutao add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*7 cd=0.0662*12; # SR

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="deathmatch" refine=1 lvl=90/90;
chevreuse add set="emblem" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622; #main
chevreuse add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*10 cd=0.0662*9;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*11 em=19.82*2 cr=0.0331*8 cd=0.0662*5;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.0 hp=100000000;

# Rotation
active nicole;

for let i=0; i<4; i=i+1 {
  nicole burst, skill;

  fischl attack;
  if is_even(i) {
    fischl skill;
  } else {
    fischl attack, burst;
  }

  chev burst, skill[hold=1]:3;

  hutao skill,
    attack:3, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge;
  if .hutao.burst.ready {
    hutao dash, burst;
  } else {
    hutao jump, attack:2, charge, jump;
  }
}
