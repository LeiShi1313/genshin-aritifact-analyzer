options swap_delay=12 iteration=1000;

neuvillette char lvl=90/90 cons=6 talent=10,10,10 ;
neuvillette add weapon="tomeoftheeternalflow" refine=5 lvl=90/90 ;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
neuvillette add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2648 cd=0.7944;

furina char lvl=90/90 cons=6 talent=10,10,10 ;
furina add weapon="splendoroftranquilwaters" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

zhongli char lvl=90/90 cons=6 talent=10,10,10;
zhongli add weapon="homa" refine=5 lvl=90/90;
zhongli add set="ap" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311 ; #main
zhongli add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

kazuha char lvl=90/90 cons=6 talent=10,10,10;
kazuha add weapon="freedomsworn" refine=5 lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kazuha add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.2979 cd=0.1986;

active neuvillette;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;


for let i=0; i<4; i=i+1 {

    neuvillette skill;
    furina skill, dash;
    zhongli attack, skill[hold=1], dash, attack;

    while !pick_up_crystallize("hydro") {
      wait(1);
    }

    furina attack, burst, attack;

    if .kazuha.burst.ready {
      kazuha burst;
    } else {
      kazuha skill, high_plunge;
    }

    neuvillette charge, skill, charge, burst;
    kazuha skill, high_plunge;

    neuvillette charge[ticks=16];

}

 wait(310); #for the last CA
