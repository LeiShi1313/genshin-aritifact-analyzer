# Cyno Mavuika Fischl Kirara. ~25s Rot. Cyno Quickburn with Kirara C4 providing Dendro into Cyno's burst uptime while full EM Mauvika owns most Overloads. Mavuika bursts every rotation.

# Team - Options listed by DPS
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="deathmatch" refine=1 lvl=90/90;
#cyno add weapon="fjords" refine=1 lvl=90/90;
cyno add set="ur" count=4;
