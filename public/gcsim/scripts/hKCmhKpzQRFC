options swap_delay=12 iteration=500 ;

active kuki;

kuki skill;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=10000000;

energy every interval=480,720 amount=1;
for let i = 0; i<4; i=i+1 {

 furina skill, dash, burst;

 if i{ kuki skill;}

  yelan burst, attack;

 if i {furina attack:2;}#swap to furina to directly heal her past first rotation

 if .kuki.burst.ready {kuki burst; }
 else yelan attack;

  yelan attack, skill, attack;

  hutao skill,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:2, charge, jump, attack;

  yelan skill, attack:2;

  if !i {furina attack:2;}#furina's e won't be off cd first rotation due to it being shorter so fill downtime

}
