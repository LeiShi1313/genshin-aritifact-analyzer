options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

active raiden;
  raiden skill;
for let rot=0; rot<4; rot=rot+1 {
  nahida attack, skill, burst;
  bennett skill, burst;
  fischl attack:2;
  while !.fischl.burst.ready { # Improves dps of some very unlucky iterations
  fischl attack;
  }
  fischl burst;
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4, dash;
  bennett skill, dash, attack:2;
  if .fischl.skill.ready {
  fischl attack, skill;
  }
}
