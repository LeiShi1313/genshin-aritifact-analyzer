# Team 
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
freminet add set="longnightsoath" count=4;
freminet add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
freminet add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="thrillingtalesofdragonslayers" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
citlali add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.2317 cd=0.7282;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="favoniussword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Freminet Plunge Combo
fn FreminetPlunge() {
  freminet jump;
  if .airborne {
    freminet high_plunge[collision=rand()>0.5];
  }
}

fn FreminetLowPlunge() {
  freminet jump;
  if .airborne {
    freminet low_plunge[collision=rand()>0.5];
  }
}

# Rotation
active freminet; # SS Stacks

for let i = 0; i < 4; i = i + 1 {
  
  if i {
    bennett skill;
    while !.bennett.mods.favonius-cd {
      bennett attack;
    }
  }
  
  xianyun skill, low_plunge, burst;
  
  bennett skill, dash, burst;
  
  xianyun swap;
  delay(47); # Just so you don't lose VV uptime trying to switch out due to swap CD    
  xianyun attack;
  
  citlali skill, burst;
  
  freminet swap;
  
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  delay(8);
  FreminetPlunge(); freminet skill;
  FreminetPlunge(); freminet dash; 
  delay(15); 
  FreminetPlunge(); freminet dash;
  delay(8);
  FreminetPlunge(); freminet skill;
  FreminetLowPlunge(); freminet dash;
  FreminetLowPlunge(); freminet dash;
  
}
