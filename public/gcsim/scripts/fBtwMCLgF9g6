options swap_delay=12 iteration=1000;

# Build assumptions
varesa char lvl=90/90 cons=6 talent=10,10,10;
varesa add weapon="vividnotions" refine=5 lvl=90/90;
varesa add set="lno" count=4;
varesa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311;
varesa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="fs" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.1986 cd=0.7944;

xianyun char lvl=90/90 cons=6 talent=10,10,10;
xianyun add weapon="crane" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.4408 em=39.64 cr=0.1324 cd=0.1324;

xilonen char lvl=90/90 cons=6 talent=10,10,10;
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

fn varesa_combo(amt) {
  for let j = 0; j < amt; j = j + 1 {
    if .varesa.skill.ready {
      varesa skill, attack, high_plunge[collision=1]; # ECP
    // } else if .xianyun.status.xianyun-airborne-buff { # Uncomment if using Xianyun
    //   varesa jump;
    //   if .airborne {
    //     varesa high_plunge[collision=1]; # JP
    //   }
    } else {
      varesa charge, high_plunge[collision=1]; # CP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

fn varesa_combo_xianyun(amt) {
  for let j = 0; j < amt; j = j + 1 {
    varesa jump;
    if .airborne {
      varesa high_plunge[collision=1]; # JP
    }
    if .varesa.energy >= 30 && .varesa.status.apex-drive {
      varesa burst;
    }
  }
}

active varesa;
for let i=0; i<4; i=i+1 {
  if !.element.t0.electro {
    varesa attack;
  }
  xilonen skill, attack:2;
  furina skill, dash, burst, attack:2;
  varesa swap; wait(38);	# wait a bit due to swap cd, and do N1 swap
  varesa attack;
  xianyun attack, skill, low_plunge, burst;
  varesa_combo(1);
  if !.element.t0.electro {
    varesa attack;
  }
  xilonen skill, attack:2;	# Refresh
  varesa_combo_xianyun(3);
  varesa_combo(1);
}

# (Varesa N1) > Xilonen E N2 > Furina ED Q N2 > Varesa N1 > Xianyun N1 EPQ > Varesa 1[Plunge Combos] (N1) > Xilonen E N2 > Varesa 3[Xianyun Plunge Combos] 1[Plunge Combos]
