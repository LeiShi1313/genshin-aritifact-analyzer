# Gaming Furina Xilonen Chevreuse. ~20s Rot. Gaming does 7 E plunges. Xilonen's Scroll buffs Pyro nearly every rotation with Chevreuse, who can overwhelms Hydro aura. Xilonen's burst is not optimal vs funneling particles to Furina. Scroll covers 6 plunges while Xilonen's RES shred covers all of Gaming's Field time.

# Team
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="vh" count=4;
#gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
#furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.331 cd=0.2648; # Festering

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; #main
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active gaming; # SS stacks

furina skill, dash; # Improved DPS even with lower Scroll consistency

for let i = 0; i < 4; i = i + 1 {
  chev burst;
  #chev attack; # Not optimal vs reliably funnnling Fav particles
  chev skill[hold=1];

  xilonen skill, attack:2;
  #xilonen burst; # Not optimal vs funnnling Fav particles

  if .furina.skill.ready {
    furina skill, dash;
  }
  furina burst;

  gaming burst;
  for let j = 0; j < 6; j = j + 1 {
    sleep(45);
    gaming skill, high_plunge;
  }
  sleep(30); # For Energy ICD
  gaming skill, high_plunge;
}
