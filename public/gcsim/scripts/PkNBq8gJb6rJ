# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

# Rotation
active mav; # SS Stacks
raiden skill, attack;

#active raiden; Tidal Shadow Mav
#raiden skill;

for let i = 0; i < 4; i = i + 1 {
  yae skill:3;

  mav skill, dash;

  chev burst, skill[hold=1]:3;

  if .mav.burst.ready {
    mav burst,
        charge:2, dash,
        charge:2, dash,
        charge:2, dash,
        charge:2, dash,
        charge:2, dash,
        charge:2, dash;

    raiden skill, attack;
  } else {
    yae burst, skill:3;

    raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:3;
  }
}
