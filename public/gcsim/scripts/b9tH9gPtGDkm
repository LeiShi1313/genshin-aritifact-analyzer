# Gaming Citlali Escoffier Chevreuse. ~19s Rot. Gaming Melt Plunge free from circles. 7/7 Plunges melted. Gaming juggles Man Chai, using burst into skill + plunge and waiting on the ground before catching Man Chai mid descent. Escoffier uses burst every other rotation past the first.

# Team - Options listed by DPS
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=99.1 cr=0.331 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
#citlali add weapon="evenstar" refine=1 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=198.2 cr=0.0662 cd=0.2648; # TTDS
#citlali add stats hp=4780 atk=311 em=187 em=187 em=187;
#citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324; # Evenstar

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.4634;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="tom" count=4;
#escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Adjacent

# Rotation
active gaming; #SS Stacks

for let i=0; i<4; i=i+1 {
  if i > 0 && .esco.burst.ready && .esco.energy == .esco.energymax {
    esco burst;
  }
  esco skill;

  chev skill[hold=1], attack, burst;

  citlali skill, burst;

  gaming burst;
  let plungeCount = 0;
  for let j = 0; j < 6; j = j + 1 {
    sleep(45); # lower for a Bennett buffed 6th plunge
    gaming skill, high_plunge; # Cacth Manchai during descent
    plungeCount = plungeCount + 1; print(plungeCount);
  }
  sleep(30); # needed for particle ICD.
  gaming skill, high_plunge, dash; print(plungeCount + 1);
}
