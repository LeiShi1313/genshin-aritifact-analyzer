bennett char lvl=90/90 cons=6 talent=9,9,9 ;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

let UseXilonenDash = false;  # change this value between true and false to make Xilonen use dash or not

active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  bennett skill, burst;
  xilonen skill, attack:2;
  if UseXilonenDash == true {
    xilonen dash;   # dash to pick up the shard
  }
  pick_up_crystallize("pyro");
  citlali skill, burst, attack:2;
  mavuika burst;
  mavuika jump; delay(4);
  mavuika charge:8;          # Mavuika Q buff state ends after 8th CA
  mavuika charge, charge[final=1], dash;
  if UseXilonenDash == false {   # if you didn't use Xilonen's dash, you need to do extra action to make it 18s rot length
    delay(16);
  }
}

# Mavuika E > Bennett EQ > Xilonen E N2 > Citlali EQ N2 > Mavuika Q J C8 C1FD
