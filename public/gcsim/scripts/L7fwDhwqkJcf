options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
active navia;

for let x = 0; x < 4; x = x + 1 {

  if x {
    navia attack:1;
  }

  furina skill, dash, burst;

  xilonen skill, attack:2; pick_up_crystallize("any");
   if x {
    xilonen burst;
  }

  navia burst;

  xianyun skill, low_plunge, burst;

  navia skill;

  for let h = 4; h > 0; h = h - 1 {
    let col = rand();
    navia jump;
    if .airborne {
      if col > 0.5 {
        navia high_plunge[collision=1], dash;
      } else {
        navia high_plunge, dash;
      }
    }
  }

  xilonen skill, attack:2; pick_up_crystallize("any");

  navia skill;
  for let h = 4; h > 0; h = h - 1 {
    let col = rand();
    navia jump;
    if .airborne {
      if col > 0.5 {
        navia high_plunge[collision=1], dash;
      } else {
        navia high_plunge, dash;
      }
    }
  }
  if .navia.skill.ready {
    navia skill;
  }
}
