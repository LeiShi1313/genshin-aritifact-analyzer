active neuvillette;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {

    neuvillette skill;
    furina skill, dash, burst;
    zhongli skill[hold=1], dash;
        
    while !pick_up_crystallize("hydro") {
      wait(1);
    }
    
    sayu skill,burst;
    neuvillette charge, burst, skill, charge;
    zhongli skill[hold=1], dash;
            
    while !pick_up_crystallize("hydro") {
      wait(1);
    }
    sayu attack,skill;
    neuvillette charge, charge;

}

  wait(173); #for the last CA