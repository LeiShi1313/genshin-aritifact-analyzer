# Keqing Yelan Furina Baizhu. ~22s Rot. Hyperbloom Keqing on-field spams electro CAs while weaving N1. You can burst with Keqing bursts after Yelan's burst expires to regen stamina. 2E Yelan.

# Team
keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="finale" refine=5 lvl=90/90;
#keqing add weapon="theblacksword" refine=1 lvl=90/90;
#keqing add weapon="umbrella" refine=5 lvl=90/90;
#keqing add weapon="lionsroar" refine=3 lvl=90/90;
#keqing add weapon="harbinger" refine=5 lvl=90/90;
keqing add set="mh" count=4;
keqing add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; # main
keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.3972 cd=0.2648; # Finale
#keqing add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; # main
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=198.2 cr=0.2979 cd=0.1324; # Umbrella
#keqing add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; # main
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.3972 cd=0.2648; # LR
#keqing add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; # main
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=198.2 cr=0.0662 cd=0.2648; # TBS
#keqing add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; # main
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=198.2 cr=0.1986 cd=0.1324; # Harbinger

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="pamber" refine=5 lvl=90/90;
baizhu add set="ohc" count=4;
#baizhu add set="sodp" count=4;
#baizhu add set="scroll" count=4;
#baizhu add set="deepwood" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  baizhu skill, burst;

  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  while !.yelan.skill.ready {
    if .keq.skill.ready && .previous-action != .action.skill {
      keq skill;
    } else if .keq.normal > 1 && .stam > 25 {
      keq charge;
    } else if .keq.normal > 3 && .stam > 18 {
      keq dash;
    } else {
      keq attack;
    }
  }

  # You'll likely stilleto over Yelan
  yelan attack, skill, attack;

  while .yelan.mods.yelanburst {
    if .keq.skill.ready && .previous-action != .action.skill {
      keq skill;
    } else if .keq.normal > 1 && .stam > 25 {
      keq charge;
    } else if .keq.normal > 3 && .stam > 18 {
      keq dash;
    } else {
      keq attack;
    }
  }
  #keqing burst; # Preserve stamina
}
