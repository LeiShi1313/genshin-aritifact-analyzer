# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active mavuika; # SS Stacks

for let i=0; i<4; i=i+1 {
  mavuika skill;
  
  bennett attack:2, skill, burst;
  
  citlali skill, burst;
  
  ayaka skill, attack, burst;
  
  mavuika burst,
          charge, dash, attack,
          charge, dash, attack,
          charge, dash, attack,
          charge:2, charge[final=1], dash,
          charge:2, dash,
          charge:2, dash;
}

