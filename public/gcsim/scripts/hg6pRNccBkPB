# Kaeya Furina Shenhe Escoffier. ~20s Rot. Triple Cryo Freeze on-field Kaeya. 2E Shenhe. Kaeya uses skill off CD. Freeze immunity chages ER requirements thanks to Kaeya A4.

# Team
kaeya char lvl=90/90 cons=6 talent=9,9,9;
kaeya add weapon="moonweaversdawn" refine=2 lvl=90/90;
#kaeya add weapon="finale" refine=5 lvl=90/90; # Bad F2P Weapon options again
#kaeya add weapon="wolffang" refine=1 lvl=90/90;
kaeya add set="bs" count=4;
kaeya add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Finale
#kaeya add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
#kaeya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=49.62 atk%=0.496 er=0.1102 em=39.64 cr=0.1655 cd=0.662; # WF

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favspear" refine=3 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.4959 em=39.64 cr=0.3972 cd=0.1324;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.2755 em=39.64 cr=0.2317 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freezable

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  esco skill, burst;

  shenhe skill, burst;

  kaeya skill, burst;

  kaeya attack;
  while .shenhe.skill.cd {
    switch {
      case .kaeya.skill.ready:
        kaeya skill, dash;
      case .kaeya.normal > 3 && .stam > 25:
        kaeya charge;
      case .kaeya.normal > 3 && .stam > 18:
        kaeya dash;
      default:
        kaeya attack;
    }
  }

  shenhe skill, attack;

  while .furina.skill.cd {
    switch {
      case .kaeya.skill.ready:
        kaeya skill, dash;
      case .kaeya.normal > 3 && .stam > 25:
        kaeya charge;
      case .kaeya.normal > 3 && .stam > 18:
        kaeya dash;
      default:
        kaeya attack;
    }
  }
}
