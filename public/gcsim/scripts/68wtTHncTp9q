# Navia Furina Yelan Escoffier. ~22s Rot. Navia Double Hydro with Escoffier. Navia does 2[E3N2D] between 2 Yelan skills. Navia bursts every rotation mid rotaion. The shatters can cause a deffiency in Crystalize shards in some cases, but freeze immunity decreases DPS due to lost Shatters. A 3rd Navia skill is used overy other rotation.

# Team
navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="nighttime" count=4;
#navia add set="ap" count=4;
navia add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
navia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.2204 em=39.64 cr=0.1655 cd=0.4634;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Inserts pick_up_crystallize("any") after dashes, Yelan E, and Xilonen E
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.yelan && action_id == .action.skill ) {
    pick_up_crystallize("any");
  }

  return _execute_action(char_id, action_id, p);
}

# Navia Skill Hold Conditional
fn naviaSkill() {
  if .navia.shrapnel >=3 { # check current shrapnel stacks. if 3-6 stakcs, use tap E, otherwise hold E
    navia skill;
  } else {
    navia skill[hold=1];
  }
}

#Rotation
active navia; # SS Stacks

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  esco skill, burst;

  navia burst;

  yelan burst, attack, skill, attack;

  naviaSkill();
  navia attack:2, dash, attack:2, dash, attack:2;
  navia skill, attack:2, dash, attack:2, dash, attack:2;

  yelan attack, skill, attack:2;

  if is_even(i) {
    navia skill, attack:2;
  } else {
    yelan attack:2;
  }
}
