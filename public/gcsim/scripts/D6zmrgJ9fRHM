emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="evenstar" refine=1 lvl=90/90;
#yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="deepwood" count=4;
#yae add set="totm" count=4;
#yae add set="gt" count=4;
#yae add set="gd" count=4;
