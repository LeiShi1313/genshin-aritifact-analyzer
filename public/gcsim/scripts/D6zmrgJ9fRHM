bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=155]; # 1st Razor Dash
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662; # ATK
#bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359 ; #main
#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.1324 ; # Heals

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000; # deals burning AoE, enables MH, -SS stacks

# Rotation
active razor; # SS Stacks
#razor skill, dash;

for let i=0; i<4; i=i+1 {
  yae skill:3;
  
  # Forego burst if energy deficient
  if i && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie attack, skill;
  }
  
  bennett skill, burst;
  
  razor skill, dash, attack, burst; #attack:1, skill, dash;
  # Razor main DPS window 
  while .razor.infusion.bennett-fire-weapon { 
    if .razor.normal > 3 {
      if .razor.skill.ready {
        razor skill, dash;
      } else {
        razor dash;
      }
    } else {
      razor attack;
    }
  }
  
  bennett skill;
  
  print("done");
}
