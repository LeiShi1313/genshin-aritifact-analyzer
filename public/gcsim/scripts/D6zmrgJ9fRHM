# Razor Emilie Yae Bennett. ~22s Rotation. Razor Quickload w/ 61/56% Burning/Quicken uptime. SS may be inconsistent. No burst, EM support Yae. Self-Overloads not implemented.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5]; # Inconsistent
#razor add weapon="talkingstick" refine=1 lvl=90/90; # Passive not implemented
#razor add weapon="mailedflower" refine=5 lvl=90/90; # AoE OL DMG
razor add set="ur" count=4; # General
razor add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622 ; #main
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=59.46 cr=0.3972 cd=0.662; # EM/El
