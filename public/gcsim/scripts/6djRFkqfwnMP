#team config

itto char lvl=90/90 cons=0 talent=9,9,9;
itto add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
itto add set="marechausseehunter" count=4;
itto add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mainstats
itto add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.1324 cd=0.662;

ningguang char lvl=90/90 cons=6 talent=9,9,9;
ningguang add weapon="prototypeamber" refine=5 lvl=90/90;
ningguang add set="songofdayspast" count=4;
ningguang add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359; #mainstats
ningguang add stats def%=0.496 def=39.36 hp=2539.4 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

gorou char lvl=90/90 cons=6 talent=9,9,9;
gorou add weapon="favoniuswarbow" refine=4 lvl=90/90;
gorou add set="exile" count=4; 
gorou add stats hp=3571 atk=232 er=0.387 def%=0.435 cr=0.311; #mainstats
gorou add stats def%=0.124 def=31.48 hp=406.3 hp%=0.0794 atk=26.46 atk%=0.0794 er=0.3086 em=31.72 cr=0.265 cd=0.1324;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #mainstats
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1324 cd=0.7944;

#enemy config

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
active furina;

#action list 
       
for let i = 0; i < 4; i = i + 1 {

  furina skill, dash, burst;
  ningguang burst, skill; 
  gorou attack:2, burst, skill;

  if i == 0 {
  
  #"C0 1PS" combo
  itto attack, burst[prestack=1],
       attack, skill,
       attack:2, charge:5,
       attack:4, charge:5, skill[travel=0], charge;
       sleep(21); #catch ushi particles
         
  } else {
  
  #"C0 2PS" combo
  itto attack, burst[prestack=1],
       attack, skill, charge:4,
       attack:3, charge:4,
       attack:3, skill, charge:4;      
       
  }
}

