mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active mavuika;

fn naviaskill() {
  if .navia.shrapnel == 6 { # check current shrapnel stacks. if 6 stacks, use tap E, otherwise hold E
    navia skill;
  } else {
    navia skill[hold=1];
  }
}

for let i=0; i<4; i=i+1 {
  mavuika skill, attack;
  furina skill, dash, attack;
  xilonen skill, attack:2;
  navia burst;
  furina burst, attack;
  mavuika burst, charge, dash;                      print(.navia.shrapnel);
  naviaskill();
  navia attack:2, dash, attack:2, dash, attack:2;   print(.navia.shrapnel);
  xilonen skill, attack:2;                          print(.navia.shrapnel);
  naviaskill();
  navia attack:3, dash;                             print(.navia.shrapnel);
  if i == 0 || i == 3 {
    naviaskill();
  } else {
    navia attack:2;
  }
}

# Mavuika E > Furina ED > Xilonen E N2 > Navia Q > Furina Q N1 > Mavuika Q CD > Navia E N2D N2D N2 > Xilo E N2 > Navia E N3D (E or N2)
