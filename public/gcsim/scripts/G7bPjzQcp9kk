#chevreuse add set="gt" count=4;
#chevreuse add set="cw" count=4; #I mean.... she uses skill twice?
#chevreuse add set="tenacityofthemillelith" count=2; chevreuse add set="vourukashasglow" count=2; #to increase chev buff, not worth it at this investment level
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622;
