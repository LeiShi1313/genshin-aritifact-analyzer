chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.0662 cd=0.1324;

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="mouun" refine=1 lvl=90/90;
#sara add weapon="fadingtwilight" refine=5 lvl=90/90; #if you use either ER weapon, ER sands is unecessary and EM sands is strongest via overload procs
#sara add weapon="favbow" refine=3 lvl=90/90;
