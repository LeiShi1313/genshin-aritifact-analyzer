let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.yelan && action_id == .action.skill ) || ( char_id == .keys.char.noelle && action_id == .action.attack ) {
    pick_up_crystallize("any");#pick up all the crystals mhm
  }

  return _execute_action(char_id, action_id, p);
}


options swap_delay=12 iteration=100;

navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=2];
navia add set="nighttime" count=4;
navia add stats hp=4780 atk=311 atk%=.466 geo%=0.466 cr=0.311 ; #main
navia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
noelle add set="husk" count=4;
noelle add stats hp=4780 atk=311 er=0.518 geo%=0.466 cd=0.622 ; #main
noelle add stats def%=0.186 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworneye" refine=5 lvl=90/90;
xianyun add set="clam" count=5;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active noelle; ## SS stacks
for let i = 0 ; i < 4; i = i + 1 {
  furina skill, dash, burst;
  while !.furina.mods.favonius-cd {
    furina attack;
  }

  if i == 0 {
    navia skill;
  }
  if .navia.burst.ready && .navia.energy == .navia.energymax {
    navia burst;
  }

  xianyun skill, low_plunge; pick_up_crystallize("any");
  xianyun burst;

  navia attack, skill;

  noelle burst;
  if .noelle.skill.ready {
    noelle skill;
  }
  for let h = 0; h < 4; h = h + 1 {
    noelle jump;
    if .airborne {
      noelle high_plunge[collision=rand()>0.5], dash;
    }
  }

  furina attack:2;
  while !.furina.mods.favonius-cd {
    furina attack;
  }

  navia skill, attack;
  for let h = 0; h < 4; h = h + 1 {
    noelle jump;
    if .airborne {
      noelle high_plunge[collision=rand()>0.5], dash;
    }
  }
}
