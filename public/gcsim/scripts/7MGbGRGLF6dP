chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="songofstillness" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622;
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

jean char lvl=90/90 cons=4 talent=9,9,9;
jean add weapon="favsword" refine=3 lvl=90/90;
jean add set="sodp" count=5;
jean add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311;
jean add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="ttds" refine=5 lvl=90/90;
lanyan add set="no" count=4;
lanyan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311;
lanyan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favwarbow" refine=4 lvl=90/90;
faruzan add set="totm" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*11;



options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;


active chasca;

for let i=0; i<4; i=i+1 {
  faruzan skill, aim, burst;
  jean skill, burst;
  lanyan burst, skill, attack;
  chasca skill,
         aim:4,
         aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  }
}
wait(61); #waiting for chasca burst to do damage before sim ends
