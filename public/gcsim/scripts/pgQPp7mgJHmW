#enemy config
target lvl=100 resist=0.1 radius=1 pos=1.05,1.2 hp=999999999;
target lvl=100 resist=0.1 radius=1 pos=-1.05,1.2 hp=999999999;
energy every interval=480,720 amount=1;

#sim config
options swap_delay=12 iteration=500;
active bennett;

for let i=0; i<4; i=i+1 {
 bennett skill, burst;
 if .fischl.skill.ready {
        fischl skill;
    } else {
        fischl burst;
    }
 beidou skill [counter=1], burst;
 itto attack, burst[prestack=1];
           itto attack:3, skill, charge:5;
           itto attack:4, charge:5;
           itto skill;
}
