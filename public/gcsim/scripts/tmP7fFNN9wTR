#bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

fn KazuPlunge(){
  kazuha jump;
  if .airborne {
    kazuha high_plunge[collision=rand()>0.5];
  }
}

active bennett;

for let i=0; i<4; i=i+1 {

  bennett skill;
  while !.bennett.mods.favonius-cd {
    bennett attack;
  }

  xianyun skill, low_plunge, burst;

  citlali skill, burst;

  kazuha skill, high_plunge[collision=1], burst;

  bennett skill, burst;

  kazuha skill, high_plunge[collision=1];
  KazuPlunge(); kazuha dash;
  KazuPlunge(); kazuha dash;
  KazuPlunge(); kazuha dash;
  KazuPlunge();
  kazuha skill, high_plunge[collision=1];
  KazuPlunge();

}
