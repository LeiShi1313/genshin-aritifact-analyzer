mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="sacrificialjade" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=4;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
mualani add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*10 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*2 cd=0.0662*10;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacrificialfragments" refine=3 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187; #main
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*12 em=19.82*6 cr=0.0331*2 cd=0.0662*2;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.062*5 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

travelerpyro char lvl=90/90 cons=6 talent=9,9,9;
travelerpyro add weapon="favoniussword" refine=3 lvl=90/90;
travelerpyro add set="archaicpetra" count=4;
travelerpyro add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
travelerpyro add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*11;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active mualani;

mualani attack;

for let i=0; i<5; i=i+1 {
  
  xilonen skill, attack:2;
  
  if is_even(i) {
    
    # BURST PHASE
    sucrose skill, dash, burst;
    travelerpyro dash, skill;
    pick_up_crystallize("hydro");
    mualani skill,
            walk[f=2], burst,
            walk[f=46], attack,
            walk[f=90], attack,
            skill; # Exit nightsoul
            
    if i == 4 {
      break; # No need to do stall phase at last rotation
    }
  
    # Stall phase - Xilonen Burst
    mualani attack:2;
    xilonen attack, burst;
    mualani attack:2, charge;
    
  } else {
    
    # 3 BITE PHASE
    sucrose skill, dash;
    if .sucrose.skill.ready {
      sucrose skill;
    } else {
      sucrose attack;
    }
    
    travelerpyro dash, skill;
    pick_up_crystallize("hydro");
    mualani skill,
            walk[f=90], attack,
            walk[f=90], attack,
            walk[f=90], attack,
            skill; # Exit nightsoul

    # Stall phase - Pyro MC Burst
    mualani attack;
    travelerpyro burst, attack:2;
    sucrose attack:3;
    mualani attack, charge;
    
  }
  
}

# ~18s rotations
# (Mualani N1) > Xilonen E N2 > Sucrose EDQ     > Pyro Traveler D tE > Mualani E Q 2[3-stacked bite] > (Mualani N2 > Xilonen N1 Q > Mualani N2C)
#                Xilonen E N2 > Sucrose ED E/N1 > Pyro Traveler D tE > Mualani E   3[3-stacked bite] > (Mualani N1 > Pyro Traveler Q N2 > Sucrose N3 > Mualani N1C)