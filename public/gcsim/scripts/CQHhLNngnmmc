# Lisa Xingqiu DMC Yaoyao. ~21s Rot. Simple Lisa Hyperbloom. Combo may have room for optimzation. Yaoyao does not burst.

lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="favcodex" refine=3 lvl=90/90; # Better than fruit
lisa add set="fopl" count=4;
#lisa add set="gd" count=4;
lisa add stats hp=4780 atk=311 em=187 em=187 em=187;
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.3972 cd=0.2648;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="emblem" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

aetherdendro char lvl=90/90 cons=6 talent=9,9,9;
aetherdendro add weapon="favsword" refine=3 lvl=90/90;
aetherdendro add set="deepwood" count=4;
aetherdendro add stats hp=4780 atk=311 er=0.518 dendro%=0.466 cr=0.311; #main
aetherdendro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yaoyao char lvl=90/90 cons=6 talent=9,9,9;
yaoyao add weapon="favlance" refine=3 lvl=90/90;
yaoyao add set="scroll" count=4;
#yaoyao add set="ins" count=4;
yaoyao add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
yaoyao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
#yaoyao add stats hp=3571 atk=232 hp%=0.348 hp%=0.348 cr=0.311;
#yaoyao add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.333648;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=2,0 hp=100000000; # 2nd

# Rotation
active xq;

for let i=0; i<4; i=i+1 {
  xingqiu skill, dash, burst, attack;

  aetherdendro skill, attack, burst, attack;

  yaoyao attack, skill;

  lisa attack, burst;
  lisa attack:3, dash, attack:3, dash;
  lisa attack:3, dash, attack:3, dash;
  lisa attack:3, dash, attack:3, dash;
  lisa attack:2, skill[hold=1], attack:3;
}
