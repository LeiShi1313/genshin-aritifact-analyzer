# Dori Furina Yelan Nahida. ~20s Rot. Dori on Field Hyperbloom without TF, Nahida swaps in to N1C when Dori's C6 infusion is down. Dori uses her burst alongside her infusion.

# Team - Options listsed by DPS
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="flameforgedinsight" refine=5 lvl=90/90;
dori add set="fopl" count=4;
#dori add set="tf" count=4;
dori add stats hp=4780 atk=311 em=187 em=187 em=187; #main
dori add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*6 cr=0.0331*12 cd=0.0662*6;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
#furina add weapon="harbinger" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*2 cr=0.0331*12 cd=0.0662*5;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*3 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; # main
nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*2 cr=0.0331*8 cd=0.0662*6;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active dori;

for let i=0; i<4; i=i+1 {
  #dori burst;

  furina skill, dash;
  if !.furina.burst.ready {
    furina attack;
  }
  furina burst;

  nahida skill;
  if .nahida.burst.ready {
    nahida burst;
  } else {
    nahida attack;
  }

  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;

  dori skill, attack:2, dash, attack:2, burst;

  while !.furina.skill.ready {
    if .dori.skill.ready {
      dori skill;
    } else if .dori.normal > 2 {
      dori dash;
    } else if .dori.infusion.dori-c6 {
      dori attack:1;
    } else {
      nahida attack, charge;
    }
  }
}
