# Cyno Chevreuse Fischl Xiangling. ~25s Rot. "King of Hell" Cyno Overload with Fischl using skill & burst every rotation. Glad is within 1% of Echoes and ping independent. NO > SoDP Chevreuse.

# Team
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="deathmatch" refine=1 lvl=90/90;
#cyno add set="echoes" count=4; # Ping dependence
cyno add set="glad" count=4;
cyno add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622;
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.3972 cd=0.2648; # Fav XL
#chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
#chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.3972 cd=0.1324; # Kitain XL

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xiangling char lvl=90/90 cons=6 talent=9,9,9; 
xiangling add weapon="favlance" refine=3 lvl=90/90;
#xiangling add weapon="kitain" refine=5 lvl=90/90;
xiangling add set="scroll" count=4;
xiangling add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=138.74 cr=0.331 cd=0.1324; # Fav
#xiangling add stats hp=4780 atk=311 er=0.518 em=187 cr=0.311; #main
#xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=198.2 cr=0.1655 cd=0.5958; # Kitain

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active fischl;

active fischl;
for let i = 0; i < 4; i = i + 1 {
  fischl attack, skill;
  
  chevreuse burst, skill[hold=1]:2;
  if !.chev.mods.favonius-cd {
    chev skill[hold=1];
  }
  
  xl burst, attack, skill, dash;
  if !.xl.mods.favonius-cd {
    xl attack;
  }
  
  fischl attack:2, burst;
  
  cyno skill, burst;
  while .fischl.skill.cd > 30 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}

