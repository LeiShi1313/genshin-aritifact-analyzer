# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;
#hurt every interval=50, 70 amount=1000,3000 element=physical; # Aggressive
hurt every interval=300, 450 amount=1000,3000 element=physical;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; 

# Beidou 20% Perfect Counter, 20% 1 Hit Counter
fn rand_counter() {
  let counter = rand();
  if counter > 0.75 {
    counter = 2;
  } else if counter > 0.75 && counter <= 0.5 {
    counter = 1;
  } 
  else {
    counter = 0;
  }
  
  return counter;
}

# Rotation
active beidou; # SS stacks
beidou skill; # Chev A1

for let i=0; i<4; i=i+1 {
  bennett skill, burst;
  
  # Burst+C4 Combo every other rotation
  if .chev.burst.ready {
    chev burst, skill[hold=1]:2;
  } else {
    chev skill[hold=1], attack:1;
  }
  
  # Prioritize burst
  amy attack;
  if !.amy.skill.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
  
  # Beidou
  while .beidou.mods.bennett-field || .status.bennettburst { 
    switch {
      case .beidou.skill.ready:
        beidou skill[counter=rand_counter()];
      case .beidou.burst.ready:
        beidou burst;
      case .beidou.normal > 2 && .beidou.dash.ready && .stam > 18:
        beidou dash;
      default:
        beidou attack;
    }
  }
  
  print("done");
}
