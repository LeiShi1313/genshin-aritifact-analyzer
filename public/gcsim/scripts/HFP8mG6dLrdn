# Xianyun Faruzan Durin Nicole. ~19s Rot. Xianyun Plunge. Xianyun uses skill 3x before her burst. Fav Xianyun is ideal for team ER. 50% Collisions.

# Team
xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="lno" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=4 lvl=90/90;
faruzan add set="vv" count=4;
#faruzan add set="tom" count=4;
#faruzan add set="no" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
#nicole add weapon="ttds" refine=5 lvl=90/90; # Causes Xianyun energy issues
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311  atk%=0.466 atk%=0.466 atk%=0.466; #main
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*9 cd=0.0662*3; # Oathsworn
#nicole add stats hp=4780 atk=311  atk%=0.466 atk%=0.466 atk%=0.466; #main
#nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*8 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*2 cd=0.0662*2; # TTDS

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active durin;

for let i=0; i<4; i=i+1 {
  nicole skill, burst;

  durin skill:2, burst;

  faruzan skill, burst;

  if .xianyun.skill.ready {
    xianyun skill:3, high_plunge, attack;
  }
  xianyun burst;
  while .xianyun.status.xianyun-airborne-buff {
    if .xianyun.skill.ready {
      xianyun skill:3, high_plunge;
    } else if .xianyun.status.xianyun-airborne-buff {
      xianyun jump;
      if .airborne {
        xianyun high_plunge[collision=rand()>0.5], dash;
      }
    }
  }

}
