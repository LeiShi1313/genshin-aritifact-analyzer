neuvillette char lvl=90/90 cons=0 talent=9,9,9 +params=[start_hp=35000]; 
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90 ;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
neuvillette add stats hp%=0.496 hp=507.88 atk%=0.0992 atk=33.08 def%=0.124 def=39.36 em=39.64 cr=0.1986 cd=0.662 er=0.1102;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="favoniusgreatsword" refine=3 lvl=90/90;
mavuika add set="ap" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
mavuika add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.1984 def=39.35 def%=0.1239 em=39.64 er=0.1101 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favoniussword" refine=3 lvl=90/90;
kazuha add set="viridescentvenerer" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187;
kazuha add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

active neuvillette;
for let i=0; i<3; i=i+1 {
  neuv skill;
  if !i {
    xilonen skill, attack:2;
  } else {
    xilonen skill, dash, attack:3; 
  }
  kazuha skill, high_plunge;
  mavuika burst, skill; pick_up_crystallize("hydro");
  kazuha burst;
  neuv charge, dash;
  kazuha skill[glide_cancel=1];
  wait(55);
  neuv skill, charge, burst;
  
  xilonen skill, attack:2;
  kazuha skill, high_plunge;
  mavuika burst, skill; pick_up_crystallize("hydro");
  kazuha burst;
  neuv charge, dash;
  kazuha skill, high_plunge;
  wait(60);
  neuv charge;
}
wait(173);
