zhongli add set="wandererstroupe" count=1; 
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311; 
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3310 cd=0.7944;

						
options swap_delay=12 iteration=1000 duration=85;
target lvl=100 resist=0.1 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

active furina;
for {
  switch 1 {
    case .furina.skill.ready:
      furina skill, dash;
    case .furina.burst.ready:
      furina burst;
    case .zhongli.skill.ready:
      zhongli skill[hold=1], dash;
    case .nahida.skill.ready:
      nahida skill;
    case .nahida.burst.ready:
      nahida burst;
    case .raiden.skill.ready:
      raiden skill;
    default:
      sleep(1);
  }
}