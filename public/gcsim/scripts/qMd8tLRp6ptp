sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="fruitoffulfillment" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=5;
sucrose add stats def%=0.124 def=39.36 hp=5287.88 hp%=0.0992 atk=344.08 atk%=0.0992 er=0.6612 em=679.92 cr=0.1986 cd=0.2648;

keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="harbinger" refine=5 lvl=90/90;
keqing add set="thunderingfury" count=5;
keqing add stats def%=0.124 def=39.36 hp=5287.88 hp%=0.0992 atk=344.08 atk%=0.6644 er=0.1102 em=39.64 cr=0.3972 cd=1.284 electro%=0.466;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="thestringless" refine=3 lvl=90/90;
fischl add set="goldentroupe" count=4;
fischl add stats def%=0.124 def=39.36 hp=5287.88 hp%=0.0992 atk=344.08 atk%=0.6644 er=0.1102 em=39.64 cr=0.642 cd=0.7944 electro%=0.466;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="hakushin" refine=5 lvl=90/90;
nahida add set="instructor" count=4;
nahida add stats hp=3571 atk=232 em=140.25 dendro%=0.466 cr=0.23325; #main
nahida add stats def=33.0624 def%=0.10416 hp=426.6192 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=99.8928 cr=0.250236 cd=0.611688; # 0.84x modifier

options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active fischl;
fischl aim; # This aim is to proc nahida's instructor and hakushin

for let i=0; i<4; i=i+1 { # 4 rotations
  nahida skill, burst, attack;

  if i {
    fischl attack:2;
  } else {
    nahida attack;
  }

  fischl burst;
  sucrose attack;

  while !.element.t0.electro {
    sucrose attack;
  }

  sucrose skill, dash, burst;
  keqing skill, burst, skill,
    attack, charge,
    attack, charge,
    attack, skill;
  delay(9);
  keqing attack, charge;
  delay(5);
  keqing attack, charge;

  nahida attack:2, skill;
  fischl attack, skill;

  while !.element.t0.electro {
    sucrose attack;
  }

  sucrose skill, dash, attack;
  keqing skill, burst, skill,
    attack, charge,
    attack, charge,
    attack, skill;
  delay(9);
  keqing attack, charge;
  delay(5);
  keqing attack, charge;
}

# 1st half  --- Nahida EQ 1N > Fischl 2NQ > Sucrose (N1) ED Q > Keqing EQE 2N1C N1E 2N1C
# 2nd half --- Nahida 2N E > Fischl 1N E > Sucrose (N1) ED N1 > Keqing EQE 2N1C N1E 2N1C

# Delays are used to optimize Fischl A4 ICD
