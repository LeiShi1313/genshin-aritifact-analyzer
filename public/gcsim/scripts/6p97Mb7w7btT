bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=79.28 cr=0.2979 cd=0.7944;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=100;

active furina;
for let i=0; i<4; i=i+1 {
  furina attack, burst, skill, attack;
  bennett burst, skill;
  if !.element.t0.pyro {
    bennett attack;
  }
  lynette skill, attack, burst;
  yoi skill, attack:5, dash,
             attack:5, dash,
             attack:5, dash,
             attack:2;
  lynette skill, attack;
}



