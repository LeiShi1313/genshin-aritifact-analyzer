# Dori Nahida Fischl Durin. ~20s Rot. TF Dori Quickburn. Fischl alternates skill and burst, then Dori stays on field for 2 skill uses before Nahida refreshes her skill. Nahida doesn't burst in the 1st rotation.

# Team - Options Listed by DPS
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#dori add weapon="mailedflower" refine=5 lvl=90/90;
dori add set="tf" count=4;
dori add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
dori add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10; # SS
#dori add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
#dori add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12; # MF

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="tom" count=4;
#nahida add set="ur" count=4;
#nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*10 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
#fischl add set="cg" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="lionsroar" refine=3 lvl=90/90;
#durin add weapon="xiphos" refine=3 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*6 em=19.82*2 cr=0.0331*10 cd=0.0662*8; # LR
#durin add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*2 em=19.82*6 cr=0.0331*8 cd=0.0662*2; # Xiphos

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active dori; # SS Stacks

nahida skill, burst;

for let i=0; i<4; i=i+1 {
  if i > 0 && .nahida.burst.ready {
    nahida burst, charge;
  } else if i > 0 {
    nahida skill, attack, charge;
  }

  durin skill:2, burst;

  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }

  dori skill, attack:2, dash, attack:2, burst;
  dori skill, attack:2, dash, attack:2;

  nahida skill, attack, charge;

  dori skill, attack:2, dash, attack:2;
}
