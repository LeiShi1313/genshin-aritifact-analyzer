#40s of Arlecchino Mualani Fischl Durin with personal investment. Dual carry Alrecchino and Mualani with Mualani vaping one burst and three chomps, which requires really specific timing. See config comments for details

arlecchino char lvl=90/90 cons=1 talent=10,6,6;
arlecchino add weapon="primordialjadewingedspear" refine=2 lvl=90/90;
arlecchino add set="gladiatorsfinale" count=4;
arlecchino add stats def%=0.255 def=35 hp=4780 atk=395 atk%=0.953 cr=0.718 cd=0.762 pyro%=0.466;

durin char lvl=90/90 cons=2 talent=9,10,10;
durin add weapon="lionsroar" refine=5 lvl=90/90;
durin add set="celestialgift" count=4;
durin add stats def%=0.124 hp=4780 hp%=0.099 atk=343 atk%=1.13 er=0.33 em=79 cr=0.681 cd=0.707;

fischl char lvl=90/90 cons=6 talent=6,10,9;
fischl add weapon="alleyhunter" refine=5 lvl=90/90;
fischl add set="goldentroupe" count=4;
fischl add stats def=19 hp=5706 atk=311 atk%=0.623 er=0.168 em=79 cr=0.591 cd=1.204 electro%=0.466;

mualani char lvl=90/90 cons=0 talent=1,10,10;
mualani add weapon="thewidsith" refine=5 lvl=90/90;
mualani add set="obsidiancodex" count=4;
mualani add stats def%=0.051 def=83 hp=5079 hp%=1.049 atk=311 er=0.057999999999999996 em=159 cr=0.35800000000000004 cd=1.018 hydro%=0.466;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active fischl;

  fischl skill;
  arle skill;
  durin skill, skill, burst;
  mualani burst; #70f travel time. below 69f it won't vape
  arlecchino charge, attack:2, charge, attack;
  mualani skill, walk[f=90], attack, skill;
  fischl attack, burst;
  arlecchino attack:3, dash, attack:3, dash, attack:4;

  #42f delay
  arle skill;
  durin attack, skill, skill, burst;
  mualani skill, walk[f=99], attack, skill; #walk for at least 9 frames after 3rd stack obtained
  fischl attack, skill;
  arle charge;
  arle attack:3, dash, attack:3;
  #57f delay
  mualani skill, walk[f=90], attack, skill;
  arle attack:3, dash, attack:5;


# Fischl E > Arle E > Durin EEQ > Mua Q (no collision) > Arle C N2C N1 > Mua E N1 E > Fischl N1Q > Arle N3D N3D N4 >
# > Arle E > Durin N1EEQ > Mua E (+9f walk) N1 E > Fischl N1E > Arle C > Arle N3D N3 > Mua E N1 E > Arle N3D N5
