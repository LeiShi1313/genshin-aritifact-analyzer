options swap_delay=12 iteration=100;

# Build assumptions
ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*7 cr=0.0331*3 cd=0.0662*10;

mona char lvl=90/90 cons=6 talent=9,9,9;
mona add weapon="hakushin" refine=5 lvl=90/90;
mona add set="notsu" count=4;
mona add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*2 cr=0.0331*12 cd=0.0662*9;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="evenstar" refine=1 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187;
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

active bina;

for let i=0; i<8; i=i+1 {
  if i && .columbina.burst.ready {
    columbina burst;
  }
  columbina skill;

  ineffa skill;
  if i && .ineffa.burst.ready {
    ineffa burst;
  }

  mona burst, attack, skill;

  sucrose skill, dash, attack;

  if .sucrose.burst.ready {
    sucrose burst;
  }

  mona charge, jump,
       charge, jump,
       charge, jump,
       charge;

  if .sucrose.skill.ready {
    sucrose attack, skill, jump;
  } else {
    sucrose attack:2, walk,
            attack:2;
  }

  mona attack:4;
}
