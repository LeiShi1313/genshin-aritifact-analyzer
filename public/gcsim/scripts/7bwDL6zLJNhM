# Mavuika Rosaria Layla Xilonen. ~18s Rot. Mavuika double Cryo Melt. Mavuika Q 6[C2D], Q C13 is -3K DPS. Mavuika does a few NA before burst to better align her burst CD.

# Team
mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="mailedflower" refine=5 lvl=90/90;
#mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # MF
#mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=178.38 cr=0.0662 cd=0.662; # SS, Caps CR

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311;
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

layla char lvl=90/90 cons=6 talent=9,9,9;
layla add weapon="harbinger" refine=5 lvl=90/90;
layla add set="totm" count=4;
layla add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cd=0.622;
layla add stats def%=0.124 def=39.36 hp=507.88 hp%=0.5456 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.1986;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

let Mav6C2D = true;

# Rotation
active mavuika; # SS Stacks

for let i=0; i<4; i=i+1 {
  mav skill;
  
  xilonen skill, attack:2;
  
  layla skill, burst;
  
  rosa skill, burst;
  
  if .mavuika.burst.cd {
    mavuika attack:2;
  }
  mavuika burst;
  if Mav6C2D == true {
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
  } else {
    mavuika charge:11, dash;
  }
}  
