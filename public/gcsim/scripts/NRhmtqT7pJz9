xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.2976 er=0.6612 em=39.64 cr=0.0662 cd=0.1324;


options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;


# Take crystals for geo resonance
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.xilo && action_id == .action.skill ) {
    pick_up_crystallize("any");
  }
  return _execute_action(char_id, action_id, p);
}


active noelle; # ss stacks
for let i = 0; i < 4; i = i + 1 {

  furina skill, dash, burst;
  xianyun skill, low_plunge, burst;
  xilonen skill, attack:2;

  noelle burst;
  while .xianyun.status.xianyun-airborne-buff {
    noelle jump;
    if .airborne {
      noelle high_plunge[collision = rand() > 0.33], dash;    # Noelle can do collision plunge more simply
    }
  }

  if .xianyun.cons > 0 {        #Additional E for energy if Xianyun has a constellation 1+
    xianyun skill, low_plunge;
  }

  xilonen skill, attack:2;

  if .noelle.skill.ready {      #Filling the time until E Furina CD
    noelle skill;
  }
  if .xianyun.cons > 0 {
    noelle attack:2;
  } else {
    noelle attack:3;
  }
}
