# Escoffier Furina Chongyun Shenhe. ~20s Rot. Escoffier Shatter plunge w/ Chongyun. Escoffier doesn't Dash/N1 cancel her plunges. Chongyun passes particles to Xianyun, who can optionally use TTDS. -4k DPS with freeze immunity.

# Team - Options listsed by DPS
escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
#escoffier add weapon="lithicspear" refine=1 lvl=90/90;
escoffier add set="lno" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # DM
#escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
#escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Lithic

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.5952 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.1986 cd=0.2648;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
#xianyun add weapon="ttds" refine=5 lvl=90/90; # Similar, with bad energy worst cases
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.2755 em=99.1 cr=0.0662 cd=0.1324; # Oathsworn
#xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
#xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324; # TTDS

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freeze Immunity

# Rotation
active esco;
esco skill;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  chongyun burst, skill;

  xianyun skill, low_plunge, burst;

  # Plunge combo
  while .esco.status.xianyun-airborne-buff {
    esco jump;
    if .airborne {
      esco high_plunge[collision=rand()>0.5];
    }

  }

  if .esco.burst.ready {
    esco burst;
  }
  esco skill;

}
