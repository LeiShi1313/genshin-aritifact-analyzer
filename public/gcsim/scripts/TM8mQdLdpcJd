# Freminet Furina Chongyun Xianyun. ~20s Rot. Freminet Shatterplunge with Sac GS Chongyun.
# Cryo Swirl is consistent, Hydro Swirl is inconsistent.
# Executes lvl 1 Shattering Pressure combos after plunging. 50% Collisions.

# Team - Options ordered by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#freminet add weapon="tidalshadow" refine=5 lvl=90/90; # Don't
freminet add set="longnightsoath" count=4;
#freminet add set="sr" count=4;
#freminet add set="bs" count=4;
#freminet add set="mh" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # SR/LNO
#freminet add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622 ; #main
#freminet add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # BS/MH

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.3972 cd=0.1986;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="sacgs" refine=5 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311 ; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="sr" count=2; xianyun add set="glad" count=2;
#xianyun add set="ohc" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Freminet Plunge Combo
fn FreminetPlunge() {
  freminet jump;
  if .airborne {
    freminet high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active freminet; # SS stacks

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if !.furina.burst.ready {
    furina attack;
  }
  furina burst;

  chongyun burst, skill;
  # Sac GS extension
  if .chongyun.skill.ready {
    chongyun skill;
  }

  xianyun skill, low_plunge, burst;
  #xianyun skill, low_plunge, burst, attack; # Not worth trying Hydro swirl

  freminet skill:2;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet attack;
  FreminetPlunge(); freminet skill:2;
  # Cryo Shattering Pressure combo
  while .furina.skill.cd {
    if .freminet.skill.ready {
      freminet skill;
    } else if .freminet.burst.ready {
      freminet burst;
    } else {
      freminet attack;
    }
  }
  # Use final skill
  if .freminet.mods.freminet-pers-time {
    freminet skill;
  }

  print("done");
}
