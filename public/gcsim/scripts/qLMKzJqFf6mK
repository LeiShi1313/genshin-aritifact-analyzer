kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="sapwood" refine=5 lvl=90/90+params=[pickup_delay=255];
kirara add set="instructor" count=4;								
kirara add stats hp=3571 atk=232 hp%=0.3495 dendro%=0.466 hp%=0.3495 ; #main
kirara add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.07936 atk=26.464 atk%=0.07936 er=0.35264 em=31.712 cr=0.31776 cd=0.31776 ;																			

options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active yae;

for let i=0; i<3; i=i+1 {
  if !i {
    yae skill:3;
  } else {
    yae attack, skill, attack, skill, attack, skill;
  }
  fischl attack, skill;
  kirara skill, attack;
  sucrose skill, dash, burst, attack;
  yae attack, charge, dash, burst, skill, skill, attack, skill;
  sucrose attack, charge;
  kirara skill, attack;
  fischl attack:2, burst;
  yae attack, charge, dash, attack;
  sucrose attack, skill, jump, attack:3;
  yae attack, charge, dash, attack;
  kirara burst;
  yae attack, charge, dash, attack;
}
yae attack;

# 1st half --- Fischl Q > kirara EQ > Sucrose (N1) ED Q > Keqing EQE 2N1C N1E 2N1C
# 2nd half --- Fischl E N1 > kirara E N1 > Sucrose (N1) ED N1 > Keqing EQE 2N1C N1E 2N1C