# Dori Furina Ororon Kazuha. ~22s Rot. Dororon Taser in 2 Target with Kazuha E as available. All members have meaningful damage share.

# Team- Options listsed by DPS
dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
#dori add weapon="favgs" refine=3 lvl=90/90;
dori add set="ohc" count=4;
#dori add set="tf" count=4;
dori add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; 
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="chainbreaker" refine=5 lvl=90/90;
#ororon add weapon="songofstillness" refine=5 lvl=90/90;
#ororon add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9; 
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5456 er=0.4959 em=118.92 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  dori burst;
  
  furina skill, dash, burst;
  
  ororon skill, burst;
  
  kazuha skill, high_plunge;
  
  dori skill, attack:2, dash, attack:2;
  
  while .furina.skill.cd {
    if .kazuha.burst.ready && !.dori.infusion.dori-c6 {
      kazuha burst;
    } else if .kazuha.skill.ready && !.dori.infusion.dori-c6 {
      kazuha skill, high_plunge;
    } else if .dori.skill.ready {
      dori skill;
    } else if .dori.normal > 2 {
      dori dash;
    } else {
      dori attack;
    }
  }

}

