# Razor Chevreuse Fischl Bennett. ~16 Rot; Razor only bursts every other rotation. Pyro Infused Razor still deals reasonable damage. DPS Chevreuse uses Q3E in Bennett Q if possible. Self overloads not implemented. 

# Team- Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="echoes" count=4; # Ping
#razor add set="glad" count=4;
#razor add set="cw" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
#chev add set="scroll" count=4;
chev add set="gt" count=4;
#chev add set="emblem" count=4;
chev add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="stillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # VH
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Others

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
#bennett add weapon="sapwood" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; 

# Rotation
active razor; # SS stacks
razor skill, dash; # Sigils, C4, Bennett energy

for let i=0; i<4; i=i+1 {
  if .bennett.burst.ready {
    bennett burst;
  } else {
    bennett skill, burst;
  }
  
  if !.amy.skill.ready {
    amy attack:2, burst;
  } else {
    amy attack, skill;
  }
  
  # Burst+C4 Combo every other rotation
  if .chev.burst.ready {
    chev burst, skill[hold=1]:3;
  } else {
    chev attack:1, skill[hold=1];
  }
  
  # Razor only enters Q every other rotation, otherwise E
  while !.razor.mods.razor-q && is_even(i) {
    if .razor.burst.ready && .razor.skill.ready {
      razor skill, dash, burst;
    } else if .razor.burst.ready && is_even(i) {
      razor burst;
    } else {
      razor skill;
    }
  }
  # Razor main DPS combo 
  while .razor.infusion.bennett-fire-weapon || .status.bennettburst { 
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}
