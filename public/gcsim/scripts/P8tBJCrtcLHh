options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 hp=1000000000 radius=2 pos=0,2.4;

active itto; # SS stacks

for let i = 0; i < 4; i = i + 1 {

   if i && .emilie.burst.ready {
    emilie burst, attack;
 } else {
    emilie skill, attack;
 }
    dehya skill:2;
    gorou skill, attack, burst;
    itto attack, burst[prestack=1],
         attack, skill,
         attack:2, charge:5,
         attack:4, charge:5, skill[travel=0], charge;
         sleep(21); #catch ushi particles

}
