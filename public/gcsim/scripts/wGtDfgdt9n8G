# Razor Nahida Fischl Chevreuse. ~21s Rot. KQMS KurtC. Aggravate Triple Hex Razor. Razor EDN1Q N1ED. Burstless Nahida. Fischl alternates skill and burst after Chevreuse. Chevreuse is just here for her C6 Electro Damage buff & Sustain.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="risingwinds" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="tom" count=4;
#nahida add set="gt" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*10 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="jadevista" refine=1 lvl=90/90;
#fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add set="cg" count=4;
fischl add set="gt" count=4;
#fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
#fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12; # Other
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10; # VH

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="scroll" count=4;
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chev add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*8 cr=0.0331*12 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

# Rotation
active razor; # SS stacks
razor skill, dash;

for let i=0; i<4; i=i+1 {
  # Burst as available, Pass particles to Lisa
  if i == 0 {
    chev burst, skill[hold=1]:2;
  } else {
    chev attack:2, skill[hold=1], attack:1;
  }

  nahida skill, attack, charge;

  if .amy.skill.ready {
    amy attack, skill;
  } else {
    amy attack:2, burst;
  }

  razor skill, dash, attack, burst, attack, skill, dash;
  # Razor Main DPS window
  while .razor.mods.razor-q > 200 { # Ends on N3ED with N1ED
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
}
