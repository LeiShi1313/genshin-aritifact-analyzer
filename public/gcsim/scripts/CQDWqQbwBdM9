# - Characters

venti char lvl=90/90 cons=1 talent=9,9,9 ;
venti add weapon="aqua" refine=1 lvl=90/90;
venti add set="mh" count=4;
venti add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cr=0.311; #main
venti add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.2648 cd=0.7944;


furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.4634;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="totm" count=4;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 heal=0.368; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.3641 cd=0.331;

# - Options

options swap_delay=12 debug=true iteration=1000;
energy every interval=480,720 amount=1;
let weak = 0; # Set this to the percentage of aimed shots that hit a weak spot

# - Targets

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;


# - Actions

active zhongli;

for let i=0; i<5; i=i+1 {
  zhongli skill[hold=1], dash;
  furina skill, dash, burst;
  bennett skill, burst;
  venti skill, burst,
    aim[hold=0, weakspot=rand()<weak]:12, # 12 CAs
    skill,
    aim[hold=0, weakspot=rand()<weak]:16, # 16 CAs
    skill;
}

# C1R1 "Machine Gun" Venti: Venti, Furina, Zhongli, Bennett. Venti does 3 skills and 28 phys CAs per rotation. An ATK% goblet on Venti is equal to a phys one with high cons on venti and furina.
# Aqua R1 > Harp R1 > FGM R1 > Polar R1 > TP R1 > Crescent R5 > Amos R1
# Zhongli hE D, Furina E D Q, Bennett E Q, Venti EQ 12CA E 16CA E
