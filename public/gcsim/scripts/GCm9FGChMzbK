# Clorinde Emilie Thoma Bennett. 18s rot. Emilie & Clorinde Q when available (in alternate rotations), on Bennett Q. EM sands on Clorinde, for Aggravate and Overloaded.

clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="calamityofeshu" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main 5* set
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

emilie char lvl=90/90 cons=0 talent=9,9,9;
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="favoniuslance" refine=3 lvl=90/90;
thoma add set="deepwood" count=4;
thoma add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.331 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.1324;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active thoma;
for let i=0; i<4; i=i+1 {
  thoma skill, attack, burst, attack;
  if !.thoma.mods.favonius-cd {
    thoma attack;
  }

  bennett skill, burst;

  if i && .emilie.burst.ready {
    emilie burst, attack;
  } else {
    emilie attack, skill;
  }

  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  if .clorinde.burst.ready && .clorinde.energy == .clorinde.energymax {
    clorinde burst;
  } else {
    clorinde attack;
  }

  bennett skill;
}
