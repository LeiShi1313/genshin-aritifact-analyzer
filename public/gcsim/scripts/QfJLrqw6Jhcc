# Alhaitham Emilie Bennett Xianyun. ~20s Rot. Alhaitham Burning Plunge. AlHaitham does JPN1 in Bennett burst and uses burst as aailable when mirrors drop below 3. 60% Collisions.

# Team - Options ordered by DPS
haitham char lvl=90/90 cons=0 talent=9,9,9;
haitham add weapon="harbinger" refine=5 lvl=90/90;
haitham add set="ur" count=4;
#haitham add set="longnightsoath" count=4;
haitham add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cr=0.311;
haitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

emilie char lvl=90/90 cons=0 talent=9,9,9; 
emilie add weapon="deathmatch" refine=1 lvl=90/90;
emilie add set="ur" count=4;
#emilie add set="deepwood" count=4;
emilie add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
emilie add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

bennett char lvl=90/90 cons=6 talent=9,9,9;
#bennett add weapon="alleyflash" refine=1 lvl=90/90; # Impossible ER
bennett add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=120];
bennett add set="no" count=4;
#bennett add set="deepwood" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="deepwood" count=4;
#xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="no" count=4;
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.551 em=39.64 cr=0.3972 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active emilie;
#bennett skill;

for let i=0; i<4; i=i+1 {
  if i > 0 && .emilie.burst.ready {
    emilie burst;
  } else {
    emilie skill;
  }
  
  xianyun attack, skill, low_plunge, attack, burst;
  
  bennett skill, burst;
  
  haitham skill[hold=1], low_plunge[short=1], attack;
  # Plunge Combo w/ skill as available
  while .haitham.status.xianyun-airborne-buff {
    if .haitham.mirrors < 3 && .haitham.burst.ready {
      haitham burst;
    } else {
      haitham jump;
      if .airborne {
        haitham high_plunge[collision=rand()>0.4];
      } 
      haitham attack:1;
    }
  }
  if .haitham.burst.ready {
    haitham burst;
  }
  
  bennett skill;
  
  print("done");
}
