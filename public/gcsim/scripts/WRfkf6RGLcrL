# Lisa Kazuha Xiangling Bennett. ~20s Rot. Lisa Overload in 2 Target, with Bennett & Kazuha on field maintaining Pyro Aura. Lesser performance in ST.

# Options ordered by DPS
lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="fruit" refine=5 lvl=90/90;
lisa add set="gd" count=4;
#lisa add set="scroll" count=4;
lisa add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.2755 em=158.56 cr=0.0662 cd=0.1986;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favsword" refine=3 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

xiangling char lvl=90/90 cons=6 talent=9,9,9; 
xiangling add weapon="catch" refine=5 lvl=90/90;
xiangling add set="emblem" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.2648 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
#bennett add set="scroll" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

# Rotation
active lisa;

for let i=0; i<4; i=i+1 {
  if i > 0 {
    lisa attack;
  }
  lisa skill[hold=1], burst; sleep(20); # Waiting for partcles is similar
  
  bennett skill, burst;
  
  kazuha skill, high_plunge, burst;
  
  xiangling burst, skill, dash;
  
  #bennett skill;
  while .bennett.burst.cd {
    if .kazuha.skill.ready {
      kazuha skill, high_plunge;
    } else if .bennett.skill.ready && .bennett.swap.ready {
      bennett skill;
    } else if .kazuha.onfield {
      kazuha attack;
    } else {
      bennett attack;
    }
  }
  
}
