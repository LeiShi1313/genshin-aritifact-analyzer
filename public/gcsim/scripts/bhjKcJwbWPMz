//Mualani Candace Sucrose Mavuika, ~18s rot with Mav burst each rot (causes small delays). Needs non-c6 Candace. Evenstar Sucrose can opt to skip the final N1E for similar dps to Sac. Sucrose has time to pyro vv every 2 rots

mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="sacrificialjade" refine=1 lvl=90/90;
mualani add set="obsidiancodex" count=4;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
mualani add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*7 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*9 cr=0.0331*2 cd=0.0662*10;

candace char lvl=90/90 cons=5 talent=9,9,9;
candace add weapon="favlance" refine=3 lvl=90/90;
candace add set="scroll" count=2;
candace add set="emblem" count=2;
candace add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
candace add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*10 cd=0.0662*2;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="sacfrags" refine=3 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=186.5 em=186.5 em=186.5; #main
sucrose add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*2 em=19.82*6 cr=0.0331*8 cd=0.0662*2;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*6;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  mualani skill;
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 { # 3 bites
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

active mavuika; # SS Stacks

for let i=0; i<3; i=i+1 {
  if (i==0) {
    candace skill, burst;
  } else {
    candace skill, burst, attack:2;
  }

  if .sucrose.skill.ready { //backup to avoid bad rng
    sucrose skill;
  } else {
    sucrose attack:2;
  }

  mavuika burst, charge, skill, dash;
  mualani_combo();
  mualani burst;

  mualani attack;

  if .sucrose.skill.ready { //backup to avoid bad rng
    sucrose skill;
  } else {
    sucrose attack:2;
  }

  candace attack, skill, burst;

  mavuika burst, charge, skill, dash;
  mualani_combo();
  mualani skill;

  //pyro vv
  if .sucrose.skill.ready {
    sucrose attack, skill;
  } else {
    sucrose attack, charge;
  }
}


# Candace EQ(N2) > Sucrose E > Mavuika Q CED > Mualani E 3[3-stacked bite] Q N1 >
# > Sucrose E > Candace N1EQ > Mavuika Q CED > Mualani E 3[3-stacked bite] E N1 > Sucrose N1C / Sucrose N1E*
# *requires sac frags to be worth
