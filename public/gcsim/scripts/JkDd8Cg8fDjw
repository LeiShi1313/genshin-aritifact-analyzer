# Xianyun Furina Yae Fischl. ~26s Rot. Plunge Xianyun Tazer. Xianyun E off cd for better rotation. ADC > 3EM. No burst Yae.

# Team - Options listed by DPS
xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="flowingpurity" refine=5 lvl=90/90;
#xianyun add weapon="evenstar" refine=1 lvl=90/90;
#xianyun add weapon="sacfrags" refine=3 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;
#xianyun add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324; # 3EM;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="flowingpurity" refine=5 lvl=90/90;
yae add set="gt" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

fn xianyunCombo() {
  # Xianyun skills off CD
  if .xianyun.skill.ready {
    xianyun skill, low_plunge;
  } else if .xianyun.status.xianyun-airborne-buff {
    # Xianyun plunge combo
    xianyun jump;
    if .airborne {
      xianyun low_plunge[collision=rand()>0.5], attack;
    }
  } else {
    # Driving NA combo
    if .xianyun.normal > 2 && .xianyun.dash.ready {
      xianyun dash;
    } else {
      xianyun attack;
    }
  }
}

# Rotation
active yae;

for let i=0; i<4; i=i+1 {
  yae skill:3;

  fischl attack, skill;

  furina skill, dash, burst;

  xianyun skill, low_plunge, burst;

  for let h = 0; h < 3; h = h + 1 {
    if .xianyun.skill.ready {
      xianyun skill, low_plunge;
    } else if .xianyun.status.xianyun-airborne-buff {
      # Xianyun plunge combo
      xianyun jump;
      if .airborne {
        xianyun low_plunge[collision=rand()>0.5], attack;
      }
    }
  }

  fischl attack:2, burst;

  yae skill:3;

  while .fischl.oz {
    xianyunCombo();
  }

  print("done");
}
