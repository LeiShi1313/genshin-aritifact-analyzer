fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="viridescentvenerer" count=5;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="favoniussword" refine=3 lvl=90/90;
// kirara add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=210]; # 210f makes clorinde pickup the leaf when she enters the field in the first rot, it becomes inconsistent after
kirara add set="scroll" count=4;
kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
kirara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.5958;

// kirara add set="ins" count=4;    #4ins build
// kirara add stats hp=3571 atk=232 hp%=0.3495 hp%=0.3495 cr=0.311 ; #main
// kirara add stats def=33.0624 def%=0.10416 hp=426.6192 hp%=0.333312 atk=27.7872 atk%=0.083328 er=0.370272 em=33.2976 cr=0.055608 cd=0.111216;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active fischl;
for let i=0; i<6; i=i+1 {
  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  kirara skill[short_hold=1]; # shE for better shield and energy economy
  if !.kirara.mods.favonius-cd && .kirara.weapon == .keys.weapon.favoniussword {
    kirara attack;
  }
  if ( i / 2 ) * 2 == i {
    kazuha burst;
  } else {
    kazuha skill, high_plunge;
  }
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
  kazuha skill, high_plunge;
  clorinde burst;
}
