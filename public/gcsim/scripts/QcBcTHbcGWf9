clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="blacksword" refine=1 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="sacbow" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="lionsroar" refine=5 lvl=90/90;
durin add set="gift" count=5;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
durin add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1982 er=0.1102 em=39.64 cr=0.3331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=5 lvl=90/90;
chevreuse add set="scroll" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;

options iteration=1000 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
    clorinde skill;
    while .clorinde.status.clorinde-night-watch {
        if .clorinde.bolratio >= 1 {
            clorinde skill;
        } else {
            clorinde attack;
        }
    }
}

active fischl;

fischl skill;
durin skill:2, burst;
chevreuse burst, skill[hold=1];
fischl attack:2, burst;
clorinde_combo();
clorinde attack, burst;

for let i=0; i<4; i=i+1 {

  if .chevreuse.burst.ready {
    chevreuse burst, skill[hold=1];
  } else {
    chevreuse skill[hold=1], attack:2;
  }
  fischl skill, attack;
  durin  attack, skill:2, burst;
  fischl attack:2, burst;
  clorinde_combo();
  clorinde burst;

}
