# Yae Chevreuse Fischl Bennett. ~16s Rot. An easier on-field Yae Rotation. Bennett funnels DPS Chevreuse and bookends Chev A1 RES shred for on-field Yae. Fischl alternate skill and burst just after Chevreuse.

# Team Options listed by DPS
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
#yae add weapon="flowingpurity" refine=5 lvl=90/90;
yae add set="ts" count=4;
#yae add set="gt" count=4;
#yae add set="tom" count=4;
#yae add set="fohw" count=4; # With FP
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Widsith

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="catch" refine=5 lvl=90/90;
#chevreuse add weapon="deathmatch" refine=1 lvl=90/90;
chevreuse add set="no" count=4;
#chevreuse add set="emblem" count=4;
#chevreuse add set="sodp" count=4;
#chevreuse add set="gt" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Catch
#chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622; #main
#chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3641 cd=0.3972; # DM
#chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622; #main
#chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296; # DM Emblem

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="stillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # VH
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Others

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
#bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 em=187 em=187 em=187; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.331 cd=0.1324; # 3EM


# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

for let i=0; i<5; i=i+1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae skill, attack, skill, attack, skill;
  }

  bennett burst, skill;

  chev burst, skill[hold=1];

  if .fischl.skill.ready {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }

  bennett skill, attack;

  yae attack:2, charge, dash;
  yae attack:2, charge, dash;
  if .yae.burst.ready {
    yae burst;
  } else {
    yae attack:2, dash, attack;
  }

  bennett skill, attack;

  yae attack;
}
