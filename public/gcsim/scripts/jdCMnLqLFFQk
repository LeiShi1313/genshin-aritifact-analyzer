options iteration=1000 swap_delay=12;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favoniussword" refine=3 lvl=90/90;
xingqiu add set="no" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 cr=0.311 hydro%=0.466;
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="harbingerofdawn" refine=5 lvl=90/90;
bennett add set="mh" count=5;
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.2648 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.2755 em=99.1 cr=0.0662 cd=0.1324;

active furina;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  xingqiu skill, dash, burst, attack;
  xianyun skill, low_plunge, attack, burst;
  bennett burst, attack, skill;
  for let j=0; j < 8; j = j + 1 {
    // > 15 covers cases where the xianyun Q buff expires 
    // in between when the conditional check occurs
    // and when the jump executes
    if .bennett.mods.xianyun-airborne-buff.duration > 15 {
      bennett jump;
      if .airborne {
        bennett high_plunge, attack; 
      } else {
        bennett attack;
      }
      if .bennett.skill.ready { #&& .element.t0.hydro {
        bennett skill;
      }
    }
  }
}

