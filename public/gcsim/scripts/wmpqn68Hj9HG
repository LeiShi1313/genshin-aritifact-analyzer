chiori char lvl=90/90 cons=6 talent=10,10,10;
chiori add weapon="urakumisugiri" refine=1 lvl=90/90;
chiori add set="huskofopulentdreams" count=4;
chiori add stats def%=1.153 def=122 hp=4780 hp%=0.057999999999999996 atk=344 atk%=0.040999999999999995 er=0.057999999999999996 cr=0.6380000000000001 cd=0.9249999999999999 geo%=0.466;

furina char lvl=90/90 cons=0 talent=1,9,9;
furina add weapon="favoniussword" refine=5 lvl=90/90;
furina add set="goldentroupe" count=4;
furina add stats def%=0.066 def=23 hp=6513 hp%=1.276 atk=311 atk%=0.040999999999999995 er=0.21999999999999997 cr=0.439 cd=1.064;

gorou char lvl=80/90 cons=6 talent=1,9,1;
gorou add weapon="favoniuswarbow" refine=5 lvl=90/90;
gorou add set="scrolloftheheroofcindercity" count=4;
gorou add stats def%=0.30599999999999994 def=37 hp=5826 hp%=0.15100000000000002 atk=340 atk%=0.040999999999999995 er=0.926 em=49 cr=0.279 cd=0.124 geo%=0.466;

kokomi char lvl=90/90 cons=6 talent=10,10,10;
kokomi add weapon="everlastingmoonglow" refine=1 lvl=90/90;
kokomi add set="oceanhuedclam" count=4;
kokomi add stats def%=0.262 def=60 hp=6573 hp%=1.347 atk=349 atk%=0.14 er=0.24 cr=0.07 cd=0.078 heal=0.359 hydro%=0.466;

options swap_delay=12 iteration=1000;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active chiori;

for let i = 0; i < 4; i = i + 1 {
  chiori skill:2;
  furina attack, skill, dash, burst;
  kokomi attack;
  if .kokomi.burst.ready {
    kokomi burst;
  }
  kokomi skill;
  gorou attack, skill, dash, burst;
  wait(30);
  for let combo = 0; combo < 3; combo = combo + 1 {
    chiori skill, attack;
    while !.chiori.skill.ready {
      if .chiori.burst.ready {
        chiori burst;
      }
      # N3D
      if .chiori.normal == 4 {
        chiori dash;
      } else {
        chiori attack;
      }
    }
  }
}
