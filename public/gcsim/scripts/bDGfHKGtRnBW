xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Freminet Plunge Combo
fn FreminetPlunge() {
  freminet jump;
  if .airborne {
    freminet high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active freminet; # SS Stacks

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if !.furina.burst.ready {
    furina attack;
  }
  furina burst;
  
  esco skill;
  if i > 0 && .esco.burst.ready {
    esco burst;
  }
  
  xianyun skill, low_plunge, burst;
  
  freminet skill, attack; 
    FreminetPlunge(); freminet attack;
    FreminetPlunge(); freminet attack;
    FreminetPlunge(); freminet attack;
    FreminetPlunge(); freminet dash;
    FreminetPlunge(); freminet dash;
    FreminetPlunge(); freminet dash;
    FreminetPlunge(); freminet skill;
    FreminetPlunge(); #freminet dash;
  
  print("done");
}
