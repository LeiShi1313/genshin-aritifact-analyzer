  if i == 0 {
    neuvillette burst;
  }
  else {
    neuvillette burst, attack;
  }
  xilonen skill, attack:2;
  kazuha skill, high_plunge;
  xiangling burst, attack, skill, dash;
  pick_up_crystallize("hydro");
