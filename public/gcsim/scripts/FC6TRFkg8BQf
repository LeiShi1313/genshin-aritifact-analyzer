neuvillette char lvl=90/90 cons=0 talent=9,9,9;
neuvillette add weapon="sacjade" refine=1 lvl=90/90;
neuvillette add set="marechausseehunter" count=5;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
neuvillette add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*10 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*6 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="wolffang" refine=1 lvl=90/90;
furina add set="goldentroupe" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*4 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

aetherpyro char lvl=90/90 cons=6 talent=9,9,9;
aetherpyro add weapon="favoniussword" refine=3 lvl=90/90;
aetherpyro add set="scroll" count=4;
aetherpyro add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
aetherpyro add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*6 cr=0.0331*10 cd=0.0662*3;

jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="favoniussword" refine=3 lvl=90/90;
jean add set="viridescentvenerer" count=4;
jean add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311 ; #main
jean add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*7 em=19.82*2 cr=0.0331*10 cd=0.0662*6;

target lvl=100 resist=0.1 hp=10000000 radius=2 pos=0,2.4;
options swap_delay=12;
energy every interval=480,720 amount=1;

active neuvillette;
for let x=0; x<4; x=x+1 {
  neuvillette skill;
  furina attack, skill, dash, attack:2;
  if .aetherpyro.burst.ready{
    aetherpyro burst, skill[hold=1];
  }
  else{
    aetherpyro skill[hold=1], attack;
  }
  furina burst;
  jean skill, burst;
  neuvillette charge, skill, charge, burst;
  jean skill, attack;
  neuvillette charge:2;
}
wait(173);
