# Ayaka Furina Rosaria Xianyun. ~22s Rot. Ayaka Cryo Plunge. 6 Plunges(one phys), canceled with N1 to avoid the slow jumps from special dash. Xianyun does not refresh the Cryo VV; damage is frontloaded damage and Shatter may make it annoying anyway.

# Team - Options listed by DPS
ayaka char lvl=90/90 cons=0 talent=9,9,9;
ayaka add weapon="finale" refine=5 lvl=90/90;
ayaka add set="bs" count=4;
#ayaka add set="mh" count=4;
ayaka add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
ayaka add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3641 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="ttds" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3306 em=79.28 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freeze Immunity

# Ayaka Plunge Combo
fn AyakaPlunge() {
  ayaka jump;
  if .airborne {
    ayaka high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd && !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  rosaria skill, burst;

  xianyun skill, low_plunge, burst;

  ayaka skill, dash;
  if .ayaka.burst.ready {
    ayaka attack;
  }
  ayaka burst; # It isn't worth waiting for Finale BOL to clear
  AyakaPlunge(); ayaka attack;
  AyakaPlunge();

  rosaria skill;

  ayaka dash;
  AyakaPlunge(); ayaka attack;
  AyakaPlunge(); ayaka attack;
  AyakaPlunge();

  ayaka skill;
  # Phys plunge is better for rotation time here, just catch those particles
  AyakaPlunge(); ayaka attack:2;
}
