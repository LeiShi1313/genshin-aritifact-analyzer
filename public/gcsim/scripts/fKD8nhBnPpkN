# Warning - Different duration time can change DPS, likely a ~5-10k range
options swap_delay=12 iteration=1000 duration=90;

# Build assumptions
arlecchino char lvl=90/90 cons=0 talent=9,9,9;
arlecchino add weapon="deathmatch" refine=1 lvl=90/90;
arlecchino add set="fohw" count=4;
arlecchino add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
arlecchino add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="thestringless" refine=3 lvl=90/90;
fischl add set="totm" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*12;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="dialoguesofthedesertsages" refine=5 lvl=90/90;
chev add set="no" count=4;
chev add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 hp%=0.466; #main
chev add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*11 cd=0.0662*5;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active fischl;

let arleTimer = 0; # Tracking how long ago Arlecchino cast her E
let checkArleTimer = 1; # Determining whether Arlecchino did cast her E

while 1 {
  switch {
    case .fischl.skill.ready:
      fischl skill, attack;
    case .fischl.burst.ready && !.fischl.oz:
      fischl attack:2, burst;
    case .arlecchino.skill.ready:
      arlecchino skill;
      arleTimer = f();
      checkArleTimer = 1;
    case .durin.skill.ready && .durin.energy >= 40:
      if .chevreuse.burst.ready {
        chevreuse burst;
      }
      chevreuse skill[hold=1];
      durin burst, skill:2;
    default:
      if f() - arleTimer >= 270 && checkArleTimer == 1 {
        arlecchino attack:2, charge;
        checkArleTimer = 0;
      }
      arlecchino attack:3, dash;
  }
}

# Fischl E ready? -> Fischl E N1
# Fischl Q ready + Oz not on the field? -> Fischl N2 Q

# Arlecchino E read? -> Arlecchino E

# Durin E ready + Energy >= 40? Chevreuse Q/N1 hE > Durin QEE

# Arlecchino ~5s since E? -> Arlecchino N2C (or N1C)
# Default -> Arlecchino N3D
