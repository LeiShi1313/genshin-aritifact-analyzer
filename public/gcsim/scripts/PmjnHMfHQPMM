amber char lvl=90/90 cons=1 talent=9,9,9;
amber add weapon="sharpshootersoath" refine=5 lvl=90/90;
amber add set="wanderers" count=4;
amber add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
//amber add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; //substats for lower weakspot accuracy(39,7% cr)
amber add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=237.84 cr=0.0662 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="fleuvecendreferryman" refine=5 lvl=90/90;
furina add set="goldentroupe" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main 
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2979 cd=0.4634;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=3 lvl=90/90;
bennett add set="songofdayspast" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.1986 cd=0.5296;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favoniuslance" refine=5 lvl=90/90;
rosaria add set="eosf" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311 ; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=100000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=10;

active rosaria;

//rotation start(4 rotation cycles by default)
for let i = 0; i <4; i = i + 1 {
  rosaria skill;
  furina  burst, skill, dash;
  bennett burst, skill;
  
  //default rotation
  if .amber.burst.ready {
   amber attack, skill, dash, burst;
   rosaria skill, burst;
   
   //number of CAs fired
   for let x = 0; x< 6; x=x+1 {
     //weakspot accuracy(ex: weak > 0.3 = 70% accuracy)
     let weak = rand();
     if weak > 0.0 {
      amber aim[weakspot=1];
    }
     else {
      amber aim;
    }
   }
  }
  //failsafe rotation for when Amber has energy issues
  else {
   amber attack, skill;
   print("Warning! Amber has energy issues!");
   rosaria skill, burst;
   
   //number of CAs fired
   for let x = 0; x< 7; x=x+1 {
     //weakspot accuracy(ex: weak > 0.3 = 70% accuracy)
     let weak = rand();
     if weak > 0.0 {
       amber aim[weakspot=1];
     }
     else {
       amber aim;
     }
   }
  }
  print("end");
}

