#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Xilonen Plunge Combo
fn XilonenPlunge() {
  xilonen jump;
  if .airborne {
    xilonen high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active furina;
 
for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, attack, burst;
  
  xianyun skill, low_plunge, burst;
  
  gorou attack, skill;
  if .gorou.burst.ready {
    gorou burst;
  }
  
  xilonen skill; pick_up_crystallize("any");
  XilonenPlunge(); xilonen attack;
  XilonenPlunge(); xilonen attack;
  XilonenPlunge(); xilonen attack;
  XilonenPlunge(); xilonen attack;
  XilonenPlunge(); xilonen attack;
  XilonenPlunge(); xilonen attack; # Final Geo Plunge with C0
  XilonenPlunge(); 
  if .xilonen.cons >= 1 {
    xilonen attack;
    if .xilonen.burst.ready {
      xilonen burst;
    }
  } else {
    if .xilonen.burst.ready {
      xilonen burst;
    } else {
      xilonen attack; XilonenPlunge();
    }
  }
}
