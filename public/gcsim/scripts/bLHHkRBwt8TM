     nahida skill, burst;
     furina skill, burst;
  if .fischl.burst.ready {
    fischl attack, burst;
  } else {
    fischl skill, attack:2;
  }
    kaveh skill, burst, attack:4, attack:4, skill, attack:4, attack:4, skill;
}

