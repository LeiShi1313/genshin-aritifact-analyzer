bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2317 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active navia;
for let i=0; i<4; i=i+1 {
  if .navia.burst.ready {
    navia burst;
    emilie attack, skill;
  } else if .emilie.burst.ready {
    emilie burst, attack;
  } else {
    emilie attack, skill;
    chiori burst;
  }
  chiori skill:2;
  bennett skill, burst;
  navia skill[hold=1], attack:3, dash, attack:2;
  bennett skill, attack:2, dash; #catches his own particles
  navia skill[hold=1], attack:2, dash, attack:2;
}
