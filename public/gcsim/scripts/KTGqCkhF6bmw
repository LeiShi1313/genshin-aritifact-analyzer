bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662 ;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="thecatch" refine=5 lvl=90/90;
xiangling add set="emblemofseveredfate" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active luminegeo;

for let i=0; i<4; i=i+1 {
  luminegeo burst, skill[short_hold=1], attack;
  if !.luminegeo.mods.favonius-cd {
    luminegeo attack;
  }
  navia burst;
  bennett burst, skill;
  xiangling burst, skill, dash;
  navia skill[hold=1], attack:3, dash, attack:2;
  luminegeo skill[short_hold=1], attack:2;
  navia skill[hold=1], attack:3, dash, attack:2;
  if .navia.skill.ready {
    navia skill[hold=1];
  }
  bennett skill, dash;
}
