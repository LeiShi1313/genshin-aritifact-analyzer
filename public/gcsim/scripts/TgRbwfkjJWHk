raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="dragonsbane" refine=3 lvl=90/90;
raiden add set="fopl" count=4;
raiden add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.3306 em=118.92 cr=0.0662 cd=0.2648;

kokomi char lvl=90/90 cons=0 talent=9,9,9;
#BotBB >= PA
kokomi add weapon="balladoftheboundlessblue" refine=5 lvl=90/90;
kokomi add set="clam" count=4;
kokomi add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 heal=0.359 ; #main
kokomi add stats def%=0.124 def=39.36 hp=1015.76 hp%=0.496 atk=33.08 atk%=0.5952 er=0.1102 em=39.64 cr=0.0662 cd=0.1324;
#substats: hp: 2 hp%: 8 atk%: 10

nahida char lvl=90/90 cons=0 talent=9,9,9;
#FoF >= PA = Fav
nahida add weapon="fruitoffulfillment" refine=5 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 er=0.518 dendro%=0.466 cr=0.311 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=237.84 cr=0.0662 cd=0.5958;
#substats: er: 2 em: 10 cr: 1 cd: 7

furina char lvl=90/90 cons=0 talent=9,9,9;
#FD > Pipe
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;							
furina add stats hp=4780 atk=311 cd=0.622 hp%=0.466 hp%=0.466 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;
#substats: er: 2 cr: 10 cd: 8

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active raiden;
# ----  Actions List
raiden skill;
for let x=0; x<4; x=x+1 {
  nahida skill, burst, attack;
  kokomi attack:2, skill, attack:2, dash, walk[f=2];
  furina skill, burst, attack:2;
  raiden skill, attack;
  kokomi attack, burst;
  while .kokomi.skill.cd > 165 {
    kokomi attack:2, dash, walk[f=2];
  }
}

