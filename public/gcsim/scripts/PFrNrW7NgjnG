# Raiden Chevreuse Mavuika Bennett. ~16 Rots. Raiden Mavuika Overload, in which Raiden and Mavuika burst in alternate rotations to compensate for the lack of Resolve/Fighting spirit generation. Q 6[C2D] Mavuika/Q N4E 3N4D Raiden. ToM Raiden is slightly better.

# Team - Options listed by DPS
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
#raiden add set="tom" count=4;
raiden add set="emblem" count=4;
#raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cd=0.622; #main
#raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662; # ToM
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Emblem

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="deathmatch" refine=1 lvl=90/90;
chevreuse add set="gt" count=4;
#chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3641 cd=0.4634;

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="oc" count=4;
#mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # OC
#mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Scroll

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active mav; # SS Stacks, other weapons are eh...
raiden skill, attack;

for let i = 0; i < 4; i = i + 1 {
  bennett skill, burst;

  if is_even(i) && .mav.burst.ready {
    mav skill, attack;

    chevreuse burst, skill[hold=1]:3;

    mav burst;
    mav charge:2, dash;
    mav charge:2, dash;
    mav charge:2, dash;
    mav charge:2, dash;
    mav charge:2, dash;
    mav charge:2, dash;

    raiden skill, attack;
  } else {
    mav skill, attack;

    chevreuse burst, skill[hold=1]:3;

    raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
  }
}
