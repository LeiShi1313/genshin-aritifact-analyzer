# Freminet Fischl Yelan Zhongli. ~20s Rot. Shielded Phys Freminet on-field. Yelan loses few dice procs. 1E Yelan. Configurable chance for Zhongli's pillar to break on cast.

freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
freminet add set="pf" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="tom" count=4;
#zhongli add set="scroll" count=4;
#zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311; # main
#zhongli add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # DPS
zhongli add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Shieldbot

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active freminet; # SS stacks

for let i=0; i<4; i=i+1 {
  # Chance for Zhongli pillar to break on cast; 0 for no break;
  if rand() > 0 {
    zhongli skill[hold=1], dash;
  } else {
    zhongli skill[hold_nostele=1], dash;
  }
  # Guarantee Fav
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }

  amy attack;
  if .amy.burst.ready && .amy.energy == .amy.energymax {
    amy attack:1, burst;
  } else {
    amy skill;
  }

  yelan skill, burst, attack;

  freminet skill, attack, burst,
           attack:2, skill, skill,
           attack:2, skill, attack, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
           attack:2, skill, attack, skill,
           attack:2, skill;

}
