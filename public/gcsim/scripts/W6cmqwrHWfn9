cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="fjords" refine=1 lvl=90/90;
cyno add set="mh" count=4;
cyno add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=118.92 cr=0.2648 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=3 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="sodp" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359;
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.3972 cd=0.1324;

options swap_delay=12 iteration=500;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, attack;
  ororon burst;
  furina burst;
  baizhu skill, burst;
  ororon skill, attack:2;
  cyno skill, burst;
  while .cyno.mods.cyno-q > 300 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 5 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}
