bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="wolffang" refine=1 lvl=90/90;
bennett add set="thunderingfury" count=4;
bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622;
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662 ;

fischl char lvl=90/90 cons=6 talent=9,9,9;
#fischl add weapon="alleyhunter" refine=1 +params=[stacks=10] lvl=90/90;
fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="widsith" refine=3 lvl=90/90;
lisa add set="no" count=4;
lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="wavebreakersfin" refine=1 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options mode=sl debug=true iteration=100 duration=126 workers=50 mode=sl swap_delay=12;

target lvl=100 resist=0.1 hp = 999999999;
energy every interval=480,720 amount=1;

active fischl;

for let x = 0; x < 5; x = x + 1 {
  fischl attack;
  while .fischl.skill.cd {
    sleep(1);
  }
  fischl skill, attack;
  lisa attack, skill[hold=1];
  bennett skill;
  lisa attack, burst;
  chevreuse skill[hold=1], attack, burst;
  bennett skill, burst;
  fischl attack:2, burst;
  while .bennett.mods.bennett-field {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
}
