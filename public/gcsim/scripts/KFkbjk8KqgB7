chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=1015.76 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.1324 ;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active raiden;

raiden skill;
for let i = 0; i < 4; i = i + 1 {
  chevreuse burst;
  if i==0 {
    chevreuse skill[hold=1];
  } else {
    chevreuse attack;
  }
  sara skill, aim, attack;
  xiangling burst, skill, dash;
  sara burst;
  raiden burst,
         attack:3, charge, dash,
         attack:3, charge, dash,
         attack:3, charge, dash,
         attack:1, charge, dash,
         skill;
  chevreuse skill[hold=1], attack, dash; # not only for xiangling, this makes raiden reaches the third C6 stack earlier
  xiangling attack:2, dash; # catch chev particles and her C6 stack, also making 20s rot
}

