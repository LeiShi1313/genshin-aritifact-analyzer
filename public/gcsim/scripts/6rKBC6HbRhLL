options swap_delay=12 iteration=1000;

# Build assumptions
ganyu char lvl=90/90 cons=0 talent=9,9,9; 
ganyu add weapon="songofstillness" refine=5 lvl=90/90;
ganyu add set="mh" count=5;
ganyu add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622 ; #main
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="favlance" refine=3 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

mualani char lvl=90/90 cons=0 talent=9,9,9;
mualani add weapon="ttds" refine=5 lvl=90/90;
mualani add set="scroll" count=5;
mualani add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
mualani add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active ganyu;

for let i=0; i<4; i=i+1 {
  ganyu skill;
  furina skill, dash, attack, burst;
  escoffier skill, attack, burst;
  mualani skill, attack;
  ganyu attack:2, aim, skill, burst, aim:4;
}
wait(27); # for the last CA hit

# Ganyu E > Furina ED N1 Q > Escoffier E N1 Q > Mualani E N1 > Ganyu C EQ 4[C]
