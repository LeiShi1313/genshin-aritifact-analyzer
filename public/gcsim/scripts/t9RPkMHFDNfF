# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

active furina;


for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  ororon skill, burst;
  mav burst, skill;
  mizuki charge, skill;
  while .mizuki.status.dreamdrifter-state {
    if .mizuki.burst.ready {
      mizuki burst;
    } else {
      wait(1);
    }
  }
  mizuki attack, dash, attack, charge;
}
