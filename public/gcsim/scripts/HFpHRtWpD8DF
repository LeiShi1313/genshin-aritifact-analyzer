# Keqing Furina Nahida Xilonen. ~23s Rot. Keqing Quickbloom with N1C spam. 2E Xilonen creates both Electro and Hydro Crystallize, with the Electro Scroll refresh in the middle of Keqing's field time. Nahida bursts every rotation.

# Team
keqing char lvl=90/90 cons=0 talent=10,10,10;
keqing add weapon="umbrella" refine=5 lvl=90/90;
#keqing add weapon="wolffang" refine=1 lvl=90/90;
keqing add set="mh" count=4;
keqing add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622;
keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Umbrella
#keqing add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622;
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=198.2 cr=0.1986 cd=0.662; # WF

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.1986 cd=0.3972;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.62 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.3972;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active keqing;
keqing skill:1;

xilonen skill, attack:2;
  
for let i=0; i<4; i=i+1 {
  xilonen burst;

  nahida skill, attack, burst;
  
  furina skill, dash, burst;
  
  xilonen skill, attack:2;
  
  keqing skill, burst, skill;
  keqing attack, charge,
         attack, charge,
         attack, charge,
         attack, charge,
         attack, charge;
  #keqing skill:2; # Similar
  
  xilonen skill, attack:2;
  
  keqing skill:2;
  keqing attack, charge,
         attack, charge,
         attack, charge,
         attack, charge;
}
