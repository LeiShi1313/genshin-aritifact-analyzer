# Characters
lyney char lvl=90/90 cons=0 talent=9,9,9;
lyney add weapon="songofstillness" refine=5 lvl=90/90;
lyney add set="mh" count=4;
lyney add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
lyney add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yaoyao char lvl=90/90 cons=6 talent=9,9,9;
yaoyao add weapon="blacktassel" refine=5 lvl=90/90;
yaoyao add set="clam" count=2;
yaoyao add set="maiden" count=2;
yaoyao add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359; #main
yaoyao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=237.84 cr=0.0662 cd=0.1324;


# Options
options swap_delay=12 iteration=1000 duration=120;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4;

# Actions
active yaoyao;
for {
  switch {
    case .yaoyao.skill.cd < 110: # swaps to yaoyao when her skill is almost ready so the cd doesn't expire while lyney is in the middle of a ca
      yaoyao skill, attack;
    case .lyney.burst.ready && .lyney.propSurplusStacks > 1: # ensures 2 mare stacks on burst first rotation
      lyney burst;
      delay(11); # wait for initial burst hitmark
      lyney skill;
    case .lyney.propSurplusStacks == 5 &&.lyney.skill.ready: # only use skill with 5 prop surplus stacks
      lyney skill;
    default: # lyney ca for the majority of the time
      lyney aim; 
  }
}
# APL Lyney + Yaoyao duo: "Solo" Lyney with skill bot Yaoyao to enable his A1 and MH. 