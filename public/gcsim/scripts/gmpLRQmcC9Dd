#  Ayato Furina Yunjin Xilonen. ~25s Rot. Ayato does a physical NA at the end of his first skill and cuts his second skill short. Ayato prefers crit weapons. Yunjin dashes to pick up Crystalize shards for AP. Damage build Xilonen is more damage.

# Team
ayato char lvl=90/90 cons=0 talent=9,9,9;
ayato add weapon="blacksword" refine=1 lvl=90/90;
#ayato add weapon="finale" refine=5 lvl=90/90;
#ayato add weapon="sturdybone" refine=1 lvl=90/90;
ayato add set="mh" count=4;
ayato add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cd=0.622 ; #main
ayato add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="footprintoftherainbow" refine=5 lvl=90/90;
yunjin add set="ap" count=4;
yunjin add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583 ; #main
yunjin add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.558 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.4634; # Damage
#xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 heal=0.359;
#xilonen add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944; # Heals

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,3 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3,0 hp=100000000;

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  xilonen burst;

  furina skill, dash, burst;

  xilonen skill, attack:2;

  yunjin skill;
  # Archaic Petra action
  yunjin dash; pick_up_crystallize("any");
  yunjin burst;

  ayato skill, attack:18;

  xilonen skill, attack:2;

  yunjin skill;
  # Archaic Petra action
  yunjin dash; pick_up_crystallize("any");

  ayato burst, skill, attack:11;
}
