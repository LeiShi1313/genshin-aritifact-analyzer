options swap_delay=12 iteration=1000;

# Build assumptions
arle char lvl=90/90 cons=6 talent=10,10,10;
arle add weapon="sss" refine=5 lvl=90/90;
arle add set="fohw" count=4;
arle add stats hp=4780 atk=311 em=187 em=187 cd=0.622;
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

