mavuika add weapon="tbs" refine=5 lvl=90/90;
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 atk%=0.466 cd=0.622;
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active arlecchino;

fn WaitForCryo() {
  let StartFrame = f();
  if !.element.t0.pyro {      # If the enemy aura is not Pyro, wait for Cryo aura (so if its already Pyro you don't wait)
    while !.element.t0.cryo && f() - StartFrame < 120 {   # wait but up to 120f(2s), so you don't wait forever
      wait(1);
    }
  }
}

let sss = true; # choose "true" if your gameplay is great enough to ensure Arle to come back in 5 seconds to see her E tick damage when Arle is on-field

for let i = 0; i < 4; i = i + 1 {
  let StartFrame = f();
  if .arle.weapon == .keys.weapon.crimsonmoonssemblance {
    arle charge;
  }
  arlecchino skill;
  if .arle.weapon == .keys.weapon.crimsonmoonssemblance {
    arle attack;
  }
  xilonen skill, attack:2; pick_up_crystallize("pyro");
  citlali dash, skill;
  mavuika burst;
  if sss == false {
    delay(2);       # delay makes Arle E tick damage happens when she is off-field. # You must come back to Arlecchino in 5 seconds from her E to see this on-field
  }
  arle swap;
  arle charge[early_cancel=1], dash;
  wait(47); # wait for C2 to hit after CA dash cancel before checking the aura for starting NA chain

  WaitForCryo();
  arle attack:3, dash;
  WaitForCryo();
  arle attack:2, dash;
  WaitForCryo();
  arle attack:3, dash;
  WaitForCryo();
  arle attack:3;
  if i<3 {
    arle dash;
    WaitForCryo();
    arle attack:3, dash;
    WaitForCryo();
    arle attack;
    if f()-StartFrame < 1080 {  # for Mavuika Q 18s cd
      print("loremipsum");
      arle attack:2, dash;
    }
  } else {
    arle burst;
  }
}

# Signature weapon rotation
# Arle C¹ E N1¹ > Xilonen E N2 > Citlali D E > Mavuika Q > Arle CD² wait N3D wait N2D 3[wait N3D] wait N1 or N3D >
# Arle C¹ E N1¹ > Xilonen E N2 > Citlali D E > Mavuika Q > Arle CD² wait N3D wait N2D 2[wait N3D] Q (last rot)

# ¹ If Arle is holding her Sig weapon, use CA for the passive, and put N1 after E
# ² Dash cancel her CA before it hit the enemy to prevent Pyro app.
# at the last rot N3D N1 or 2[N3D] is replaced with her Q.
