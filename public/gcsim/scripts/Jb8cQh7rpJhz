  arlecchino skill;
  yelan skill, burst;
  bennett attack, burst;
  kazuha skill, high_plunge;
  arlecchino attack:3, charge,
             attack:3, charge,
             attack:3, charge,
             attack:3, charge,
             attack:3, charge,
             attack:3, dash, attack;


for let i=0; i<3; i=i+1 {
  arlecchino skill;
  bennett skill;
  yelan skill;
  if !.yelan.mods.favonius-cd  {
    yelan attack;
  }
  yelan burst;
  bennett attack, burst;
  kazuha skill, high_plunge;
  arlecchino attack:3, charge;
  wait(30);
  arle
             attack:3, charge;
  wait(20);
  arle
             attack:3, charge,
             attack:3, charge,
             attack:3, charge,
             attack:2;


