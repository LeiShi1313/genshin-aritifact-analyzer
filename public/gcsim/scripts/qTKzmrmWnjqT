wanderer char lvl=90/90 cons=0 talent=9,9,9;
wanderer add weapon="widsith" refine=3 lvl=90/90;
wanderer add set="vv" count=4;
wanderer add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
wanderer add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*7 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*9;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favwarbow" refine=4 lvl=90/90;
faruzan add set="sms" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*7 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*9;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="gd" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*2 em=19.82*3 cr=0.0331*12 cd=0.0662*10;
# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

active ineffa;

for let i=0; i<10; i=i+1 {
  if (i==0) {
    ineffa skill;
  } else {
    if .ineffa.burst.ready {
      ineffa burst;
    } else {
      ineffa skill, attack;
    }
  }
  faruzan skill, burst;
  while !.faruzan.mods.favonius-cd {
    faruzan attack;
  }
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;


  wanderer attack, skill, attack;
  while .wanderer.skydweller-points > 3 {
    if .wanderer.normal < 3 {
      wanderer attack;
    } else if .wanderer.mods.wanderer-a4 {
      wanderer dash;
    } else if .wanderer.skydweller-points > 2 {
      wanderer charge;
    } else {
      wanderer attack;
    }
  }
  if .wanderer.status.windfavored-state && .wanderer.burst.ready {
    wanderer burst, attack;
  } else if .wanderer.status.windfavored-state && !.wanderer.burst.ready {
    wanderer skill, low_plunge;
  }
}
