# AlHaitham Ineffa Xingqiu Nahida. ~20s Rot. AlHaitham Hyperbloom with Ineffa. Essentially zero Lunarcharge. Xingqiu uses skill between Alhaitham mirror refresh.

# Team
alhaitham char lvl=90/90 cons=0 talent=9,9,9;
alhaitham add weapon="harbinger" refine=5 lvl=90/90;
alhaitham add set="gd" count=4;
alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
alhaitham add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="fjords" refine=1 lvl=90/90;
ineffa add set="fopl" count=4;
#ineffa add set="gd" count=4;
ineffa add stats hp=4780 atk=311 em=187 em=187 em=187; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*11 er=0.0551*2 em=19.82*6 cr=0.0331*2 cd=0.0662*9;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="sms" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*2 cr=0.0331*10 cd=0.0662*7;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 em=187; #main
nahida add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*8 cr=0.0331*7 cd=0.0662*9;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active nahida;

for let i = 0; i < 5; i = i + 1 {
  if i > 0 {
    nahida burst, skill;
  } else {
    nahida skill;
  }

  xingqiu burst, attack;

  alhaitham burst, attack;

  ineffa skill;

  alhaitham attack:3, dash,
            attack:3, dash,
            attack:3, dash,
            attack:3;

  xingqiu attack, skill, dash, attack;

  alhaitham skill[hold=1], low_plunge[short=1],
           attack:3, dash,
           attack:3, dash,
           attack:3, dash;
}
