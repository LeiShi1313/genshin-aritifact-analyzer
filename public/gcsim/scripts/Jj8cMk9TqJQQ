yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gt" count=4;
#yae add set="tf" count=2;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
yae add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="no" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466 ; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.2648;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="kitain" refine=5 lvl=90/90;
xiangling add set="gd" count=5;
#xiangling add set="eosf" count=5;
xiangling add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.1986 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active fischl;
for let i = 0; i < 4; i = i + 1 {
  fischl skill, attack;
  yae attack, skill:3, attack:2;
  chevreuse burst, skill[hold=1]:2;
  xiangling attack:2, skill, dash, burst; # weave some NAs to get chev healing and particles (1 chev-C6 stack)
  yae attack:3;                           # get chev healing (1 stack)
  fischl attack:2, burst;
  yae attack:2, charge, dash,
      burst, skill:3,                     # get chev healing during burst animation (3 stacks total)
      attack:2, charge, dash;
  xiangling skill, attack:2;
  while !.fischl.skill.ready {
    if .yae.normal == 3 && .stam > 100 {
      yae charge, dash;
    } else {
      yae attack;
    }
  }
}

# Fischl E N1 > Yae N1 3[E] N2 > Chev Q 2[hE] > XL N2 E dash Q > Yae N3 >
# Fischl N2 Q > Yae N2CD Q 3[E] N2CD > XL E N2 > Yae 2[N2CD] N2
