# Clorinde Lauma Xingqiu Ineffa. ~25s Rot. Shielded Thundering Fury Clorinde Quickbloom. Lauma's burst is just barely a dps loss with etherlight. Ineffa uses skill and burst every rotation.

# Team - Options listed by DPS
clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="eshu" refine=5 lvl=90/90;
clorinde add set="tf" count=4;
clorinde add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
clorinde add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="evenstar" refine=1 lvl=90/90;
lauma add set="deepwood" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*12;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="favsword" refine=3 lvl=90/90;
xingqiu add set="sms" count=4;
xingqiu add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; #main
xingqiu add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="fjords" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
#ineffa add set="gd" count=4;
#ineffa add set="totm" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

# Rotation
active lauma;

for let i=0; i<4; i=i+1 {
  if i > 0 {
    lauma attack;
  }
  lauma skill[hold=.dew>1];

  xq skill, dash, burst, attack;

  ineffa attack, skill;

  clorinde_combo();

  lauma attack, skill[hold=1];

  ineffa burst;

  clorinde_combo();
  #clorinde burst;
}
