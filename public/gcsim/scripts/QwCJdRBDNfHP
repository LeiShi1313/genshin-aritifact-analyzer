options iteration=1000 swap_delay=12;

wrio char lvl=90/90 cons=0 talent=9,9,9;
wrio add weapon="widsith" refine=3 lvl=90/90; 
wrio add set="mh" count=4;
wrio add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
wrio add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

yunjin char lvl=90/90 cons=6 talent=9,9,9;
yunjin add weapon="footprintoftherainbow" refine=5 lvl=90/90;
#yunjin add set="ap" count=4;
yunjin add set="no" count=4;
yunjin add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583 ; #main
yunjin add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.1986;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;


active wrio;
target lvl=100 resist=0.1 hp=999999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

wrio attack;
for let x=0; x<4; x=x+1 {
  xilonen skill, attack:2, burst;
  furina attack, skill, burst;
  yunjin skill, burst;
  if .yunjin.sets.ap >= 4 {
    yunjin dash; pick_up_crystallize("cryo"); # for 4AP
  } else {
    yunjin dash; pick_up_crystallize("any"); # for Geo Resonance
  }
  xilonen skill, attack:2;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump;
  if .wrio.burst.ready {
    wrio burst;
  } else {
    wrio attack:3;
  }
}
