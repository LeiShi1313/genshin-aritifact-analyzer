# Xinyan Rosaria Fischl Xianyun. ~18s Rot. Xinyan Phys Plunge. Xinyan uses burst every other rotation before plunging. OHC > SoDP Xianyun, but bubbles may miss. 50% Collisions. 

# Team - Options listsed by DPS
xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#xinyan add weapon="fruitfulhook" refine=1 lvl=90/90;
xinyan add set="lno" count=4;
#xinyan add set="pf" count=4;
xinyan add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="tom" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9; 
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=148.86 atk%=0.3968 er=0.4959 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active xinyan; # SS Stacks

for let i = 0; i < 4; i = i + 1 {
  if .amy.skill.ready { 
    amy attack:1, skill; # skill; 
  } else { 
    amy attack:2, burst; 
  }
  
  xianyun skill, low_plunge, burst;
  
  rosaria skill, burst;
  
  xinyan skill;
  if .xinyan.burst.ready {
    xinyan burst;
  }
  while .xinyan.status.xianyun-airborne-buff {
    xinyan jump;
    if .airborne {
      xinyan high_plunge[collision=rand()>0.5];
    }
    if .xinyan.status.xianyun-airborne-buff {
      xinyan dash;
    }
  }
  
  rosaria skill;
}
