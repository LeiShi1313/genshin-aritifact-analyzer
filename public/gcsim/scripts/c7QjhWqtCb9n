# Diluc Nahida Furina Kokomi. ~20s Rot. Diluc Burgeon in 2 target. CW >= FoPL in ST. Nahida does not burst. Kokomi refeshes burst before Diluc does a second combo; Infusion Retained.

# Team 
diluc char lvl=90/90 cons=0 talent=9,9,9;
diluc add weapon="mailedflower" refine=5 lvl=90/90;
#diluc add weapon="aquamarine" refine=1 lvl=90/90;
diluc add set="fopl" count=4;
#diluc add set="cw" count=4;
#diluc add set="gd" count=4;
diluc add stats hp=4780 atk=311 em=187 em=187 em=187; #main
diluc add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1653 em=118.92 cr=0.2317 cd=0.4634;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
