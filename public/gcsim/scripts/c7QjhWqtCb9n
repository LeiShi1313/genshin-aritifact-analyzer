kokomi add stats def%=0.124 def=39.36 hp=507.88 hp%=0.496 atk=33.08 atk%=0.3968 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000;
target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000;

#Rotation
active nahida;

for let i=0; i<4; i=i+1 {
  nahida skill, attack, charge;
  
  furina skill, dash, attack;
  
  kokomi skill, attack;
  
  diluc skill, burst, attack, skill, attack:2, skill, attack;
  
  kokomi attack, burst, attack;

  diluc attack, skill, attack:2, skill, attack:2, skill; # Infusion Retained
}

