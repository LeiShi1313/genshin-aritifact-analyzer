# Keqing Furina Fischl Xilonen. ~25s Rot. Keqing Taser. Keqing bursts twice per rotation between Oz and Scroll refreshes.

# Team - Options Listed By DPS
keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="finale" refine=5 lvl=90/90;
#keqing add weapon="lionsroar" refine=3 lvl=90/90;
keqing add set="mh" count=4;
#keqing add set="ts" count=4;
keqing add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # CD; MH
#keqing add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#keqing add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # CR; TS

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ToM

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=0]; # Leading slot
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.496 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.5296;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  if i > 0 {
      fischl attack;
  }
  fischl skill;
  
  xilonen skill; pick_up_crystallize("any");
  xilonen attack:2, burst;
  
  furina skill, dash, burst;
  
  keqing skill, burst, skill;
  keqing attack, charge,
         attack, charge,
         attack, charge;
  
  fischl attack:2, burst;

  xilonen skill, attack:2; pick_up_crystallize("any");
  
  while .fischl.skill.cd > 30 {
  #while .fischl.oz {
    if .keq.burst.ready {
      keq burst;
    } else if .keq.skill.ready {
      keq skill;
    } else if .keq.normal > 1 && .stam > 25 {
      keq charge;
    } else if .keq.normal > 3 && .stam > 18 {
      keq dash;
    } else {
      keq attack;
    }
  }
}
