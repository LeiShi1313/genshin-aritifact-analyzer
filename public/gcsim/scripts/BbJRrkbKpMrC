xl char lvl=90/90 cons=6 talent=9,9,9;
xl add weapon="deathmatch" refine=1 lvl=90/90;
xl add set="esf" count=4;
xl add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
xl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972  cd=0.662;

chevreuse char lvl=90/90 cons=6 talent=9,9,9; 
chevreuse add weapon="deathmatch" refine=1 lvl=90/90;
chevreuse add set="lw" count=4;
chevreuse add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622 ; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3972 cd=0.5296;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="no" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 type=aeonblightdrake[hp_mult=3.00] radius=2 pos=0,3;

active bennett;

for {
 switch {
 case .bennett.burst.ready && .bennett.swap.ready:
  bennett burst;
 case .bennett.skill.ready && .bennett.swap.ready:
  bennett skill;
 case .xiangling.burst.ready && .xl.mods.bennett-field:
  xl burst;
 case .xiangling.skill.ready:
  xl skill, dash;
 case .fischl.skill.ready && !.fischl.oz:
  fischl attack, skill;
 case .fischl.burst.ready && !.fischl.oz:
  fischl attack:2, burst;
 case .chev.burst.ready:
  chev burst;
 case .chev.skill.ready:
  chev skill[hold=1];
 case .xl.onfield:
  xl attack;
 case .chev.onfield:
  chev attack;
 case .bennett.onfield:
  bennett attack;
 case .fischl.onfield:
  fischl attack;
 
  }
}

