# Cyno DMC Fischl Xilonen. ~25s Rot. TF Cyno Aggravate with multiwave Dendro. Xilonen creates a Crystalize for AP DMC to pickup. Fischl uses skill and burst every rotation. Xilonen bursts every rotation.

# Team
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="deathmatch" refine=1 lvl=90/90;
cyno add set="glad" count=4;
cyno add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #mainstats
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

aetherdendro char lvl=90/90 cons=6 talent=9,9,9;
aetherdendro add weapon="favsword" refine=3 lvl=90/90; # +params=[pickup_delay=200];
aetherdendro add set="ap" count=4;
#aetherdendro add set="no" count=4;
aetherdendro add stats hp=4780 atk=311 er=0.518 dendro%=0.466 cr=0.311; #main
aetherdendro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=99.1 cr=0.331 cd=0.331;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #mainstats
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl skill, attack;

  if i > 0 {
    xilonen burst;
  }
  xilonen skill, attack:2;

  aetherdendro attack, skill, burst;
  # AP action
  if .aetherdendro.sets.ap {
    aetherdendro dash;
    pick_up_crystallize("electro");
  }

  fischl attack:2, burst;

  cyno burst, attack:2, skill;
  while .fischl.skill.cd > 30 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }
}
