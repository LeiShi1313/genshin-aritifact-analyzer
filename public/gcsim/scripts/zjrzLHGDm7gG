options swap_delay=12 iteration=1000;

# Build assumptions
chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="chainbreaker" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*3 cr=0.0331*7 cd=0.0662*10;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="fjords" refine=1 lvl=90/90;
ineffa add set="totm" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*2 em=19.82*5 cr=0.0331*10 cd=0.0662*10;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=3 lvl=90/90;
mona add set="no" count=4;
mona add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*10 cd=0.0662*9;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*4 cr=0.0331*12 cd=0.0662*6;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active ineffa;

for let i=0; i<6; i=i+1 {
  ineffa skill;
  if i && .ineffa.burst.ready {
    ineffa burst;
  }

  if !i {
    durin skill, burst, attack;
  } else {
    durin skill:2, burst;
  }

  mona attack, burst, attack:3, skill, attack;

  chasca skill, aim:4;
  if is_even(i) {
    chasca burst;
  } else {
    chasca aim[bullets=4];
  }
}

# ~20s rotations
# Ineffa E (Q) > Durin EQN1/EEQ > Mona N1 Q N3 E N1 > Chasca E 4[C] Q/C_4b
