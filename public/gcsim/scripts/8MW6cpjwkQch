# Yae Fischl Kazuha Baizhu. ~25s Rot. Yae Aggravate with Baizhu. Yae bursts every rotation before refreshing skill. Kazuha skill and burst are separated. Not hyperoptimized.

# Team
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="gd" count=4;
#yae add set="gt" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; # main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; # main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

baizhu char lvl=90/90 cons=6 talent=9,9,9;
baizhu add weapon="hakushin" refine=5 lvl=90/90;
baizhu add set="ins" count=4;
baizhu add stats hp=3571 atk=232 er=0.3885 hp%=0.466 hp%=0.3495; #main
baizhu add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.23142 em=33.2976 cr=0.27804 cd=0.166824;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active yae;

for let i=0; i<4; i=i+1 {
  if i == 0 {
    yae skill:3;
  } else {
    yae skill, attack, skill, attack, skill;
  }

  kazuha skill, high_plunge;

  fischl attack, skill;

  baizhu skill, burst;

  kazuha attack, burst;

  yae attack:2, charge, dash;
  yae burst, skill, attack, skill, skill;

  kazuha skill, high_plunge;

  fischl attack:2, burst;

  baizhu skill, attack;

  yae attack:2, charge, dash;
  yae attack:2;

  kazuha skill, high_plunge;

  yae attack:1, charge, dash;
  yae attack:2, charge, dash;
}
