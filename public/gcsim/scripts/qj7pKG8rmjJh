clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="theblacksword" refine=1 lvl=90/90;
clorinde add set="echoes" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
clorinde add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

mavuika char lvl=90/90 cons=1 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="scroll" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;		

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="fadingtwilight" refine=5 lvl=90/90;
sara add set="no" count=5;
sara add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

options iteration=1000 swap_delay=12;                                                                       
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn clorinde_combo_opener() { 
  clorinde skill, attack:3, skill;
  set_player_pos(0, -5); # clorinde lunge into sara burst
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
      set_player_pos(0, 0);
    } else {
      clorinde attack;
    }
  }
}

fn clorinde_combo_rotation() { 
  clorinde skill, attack, skill; # adjustment due to chev healing
  set_player_pos(0, -5); # clorinde lunge into sara burst
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
      set_player_pos(0, 0);
    } else {
      clorinde attack;
    }
  }
}


active mavuika; # SS stacks

sara skill;
mav attack, skill; # mav NA to wait for electro aura so mav can trigger scroll
chevreuse burst, skill[hold=1];
mav burst, charge:2, dash, charge, dash; # mav CAs to fill rot time
sara burst;
clorinde_combo_opener();

for let i = 0; i < 4; i = i + 1 {
  
  sara aim; # sara aimed shot through chev skill funnels maximum particles to clorinde
  chevreuse attack, skill[hold=1], attack; # weave NAs for fighting spirit
  clorinde burst;
  mav skill, burst, charge, dash, charge, dash; # mav CAs to fill rot time
  if .sara.burst.ready {
    sara skill, burst;
  } else {
    sara attack, skill, attack; # weave NAs for fighting spirit
  }
  clorinde_combo_rotation();
  
}

