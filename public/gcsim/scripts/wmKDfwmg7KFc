#fischl add set="tf" count=2;
#fischl add set="glad" count=2;


active faruzan;
for let x = 0; x < 4; x = x + 1  {

faruzan attack, burst, skill;
bennett skill, burst;
if .fischl.skill.ready {
  fischl skill, attack;
} else {
  fischl attack, burst;
}
wanderer attack, skill;
  while .wanderer.skydweller-points > 3 {
    if .wanderer.normal < 3 {
      wanderer attack;
    } else if .wanderer.mods.wanderer-a4 {
      wanderer dash;
    } else if .wanderer.skydweller-points > 9 {
      wanderer charge;
    } else {
      break;
    }
  }
  if .wanderer.burst.ready {
  wanderer skill, burst, attack;
  } else {
  wanderer skill;
}
}
