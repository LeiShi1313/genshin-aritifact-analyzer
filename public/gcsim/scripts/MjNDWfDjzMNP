# - Characters

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="harbinger" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

sigewinne char lvl=90/90 cons=0 talent=9,9,9; 
sigewinne add weapon="sacbow" refine=3 lvl=90/90;
#sigewinne add weapon="favbow" refine=4 lvl=90/90; # ~1k less team dps than r3 sac
sigewinne add set="ohc" count=4;
sigewinne add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
sigewinne add stats def%=0.124 def=39.36 hp=1015.76 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.3972;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbinger" refine=5 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=4];
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #main
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

# Options

options swap_delay=12 iteration=1000 duration=120;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4;

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
  	pick_up_crystallize("hydro"); # Pick up crystallize before every dash
  }
  return _execute_action(char_id, action_id, p);
}

# Actions

active furina;

for {
  switch {
    case .furina.skill.ready && (.furina.onfield || .furina.swap.ready):
      furina skill, dash;
    case .furina.burst.ready && (.furina.onfield || .furina.swap.ready):
      furina burst;
    case .furina.onfield && !.xilo.swap.ready: #furina na during swap cd
      furina attack;
    case .chiori.burst.ready && .chiori.swap.ready && .furina.fanfare > 200 && .debuff.res.t0.xilonen-e-shred-hydro && .debuff.res.t0.geo-res: #only use chiori burst when buffed
      chiori burst;
    case .chiori.skill.ready && (.chiori.onfield || .chiori.swap.ready):
      chiori skill:2;
    case .chiori.onfield && !.xilo.swap.ready: #chiori na during swap cd
      chiori attack;
    case .xilo.burst.ready && .xilo.onfield:
      xilonen burst;
    case .xilo.skill.ready && (.xilo.swap.ready || .xilo.onfield): 
      xilonen skill, attack:2;
    case .sigewinne.skill.ready && .sigewinne.swap.ready && !.sigewinne.tags.sigewinne-convalescence: #only use skill once stacks are consumed
      sigewinne skill, dash;
    case .sigewinne.burst.ready && (.sigewinne.onfield || .sigewinne.swap.ready): #attack before burst to proc chiori a1
      sigewinne attack, burst;
    case .sigewinne.weapon != .keys.weapon.favbow && !.xilo.swap.ready: # sigewinne na during swap cd
      sigewinne attack;
    case .sigewinne.weapon == .keys.weapon.favbow && !.sigewinne.mods.favonius-cd && (.sigewinne.onfield || .sigewinne.swap.ready): #feed fav particles to furina
      while !.sigewinne.mods.favonius-cd {
        sigewinne attack;
      }
      furina attack;
    case !.xilo.mods.favonius-cd && (.xilo.onfield || .xilo.swap.ready): #feed fav particles to furina
      while !.xilo.mods.favonius-cd {
        xilo attack;
      }
      furina attack;
    case !.debuff.res.t0.geo-res && .xilo.onfield: #pick up crystallize shards for geo resonance
      xilonen dash;
    default: 
      xilonen attack;
  }
}

# APL Furina & Chiori Quickswap team with Sigewinne and Xilonen. Crystallize shards are picked up for geo resonance. Xilonen feeds fav particles to furina. Sigewinne can also use fav bow.