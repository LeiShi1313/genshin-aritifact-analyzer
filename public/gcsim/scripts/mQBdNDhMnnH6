options swap_delay=12 iteration=1000;

# Build assumptions
wrio char lvl=90/90 cons=6 talent=10,10,10;
wrio add weapon="cashflow" refine=5 lvl=90/90;
wrio add set="mh" count=4;
wrio add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
wrio add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

shenhe char lvl=90/90 cons=6 talent=10,10,10;
shenhe add weapon="calamityqueller" refine=5 lvl=90/90;
//shenhe add set="no" count=4;
shenhe add set="glad" count=2;
shenhe add set="sr" count=2;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.3306 em=39.64 cr=0.0662 cd=0.3972;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="favsword" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=6 talent=10,10,10;
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst, attack;
  shenhe skill[hold=1];
  if is_even(i) {
    shenhe burst;
  }
  xilonen skill, attack:2;
  wrio  skill;
  wrio  attack:5, charge, jump;
  wrio  attack:5, charge, jump;
  wrio  attack:5, charge;
  if is_even(i)  {
    wrio dash;
    wrio attack:3;
    wrio burst;
  } else {
    wrio jump;
    wrio attack:5, charge;
  }
}
//wait(25); #25f wait for wrio burst to hit at the last rot
