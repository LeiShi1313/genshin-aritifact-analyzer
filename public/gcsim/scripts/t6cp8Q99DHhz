lynette add weapon="wolffang" refine=1 lvl=90/90;
lynette add set="vv" count=4;
lynette add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; # main
lynette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90; 
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; # main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.4634;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active furina;

for let r=0; r<2; r=r+1 {

  # first rotation
  furina skill, dash, burst;
  ororon skill, burst;
  lynette skill, attack;
  clorinde_combo();
  clorinde burst;

  # second rotation
  lynette skill, burst;
  ororon skill, burst;
  lynette skill, attack;
  clorinde_combo();
  clorinde burst;

}

