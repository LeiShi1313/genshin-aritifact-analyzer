prune char lvl=90/90 cons=6 talent=9,9,9;
prune add weapon="oathsworn" refine=5 lvl=90/90;
prune add set="no" count=4;
prune add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
prune add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*8 cd=0.0662*2;

options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active durin;
for let i=0; i<4; i=i+1 {
  if i {
    durin skill:2, burst;
  } else {
    durin skill, burst, skill;
  }
  prune skill, burst;
  faru burst, skill, aim;
  ifa skill;
  while .ifa.nightsoul.points > 10 {
    ifa charge;
  }
  ifa burst;
}
