let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
  pick_up_crystallize("any"); # Pick up crystallize before every dash
  }

  return _execute_action(char_id, action_id, p);
}

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="splendor" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311;
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

navia char lvl=90/90 cons=6 talent=10,10,10;
navia add weapon="verdict" refine=5 lvl=90/90;
navia add set="nighttime" count=4;
navia add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; # main
navia add stats atk=33.08 atk%=0.248 hp=507.88 hp%=0.0992 cr=0.3641 cd=0.662 em=39.64 er=0.1102 def=39.36 def%=0.124;

chiori char lvl=90/90 cons=6 talent=10,10,10;
chiori add weapon="uraku" refine=5 lvl=90/90;
chiori add set="mh" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 def%=0.583 cd=0.622;
chiori add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=.1102 em=39.64 cr=0.3972 cd=0.662;

gorou char lvl=90/90 cons=6 talent=10,10,10;
gorou add weapon="elegy" refine=5 lvl=90/90;
gorou add set="noblesse" count=5;
gorou add stats hp=4780 atk=311 er=0.518 geo%=0.466 cr=0.311; #mainstats
gorou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

#configuration
options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

#rotation
active chiori;
chiori skill:2;
for let x=0; x<4; x=x+1 {
gorou skill, attack;
furina skill, dash, attack, burst, attack;
navia skill, dash;
chiori skill:2;
gorou burst;
chiori attack, burst, attack:2, skill:2;
gorou skill, attack;
navia burst, skill;
chiori attack, skill, attack:3, dash, attack:3, dash, attack:3, skill:2;

}
