energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active dehya;

for let i=0; i<2; i=i+1 { 
  # First rotation (no Albedo burst)
  dehya  skill, attack;
  albedo skill, attack;
  nahida skill, burst;
  kokomi skill, attack;
  dehya  burst, attack:10;
  kokomi burst, attack:3, dash, attack:3, dash, attack:3, dash, attack:3;
  
  # Second rotation (no Nahida burst)
  dehya  skill, attack;
  nahida skill, attack;
  albedo burst, skill;
  kokomi skill, attack;
  dehya  burst, attack:10;
  kokomi burst, attack:3, dash, attack:3, dash, attack:3, dash, attack:3;
}

