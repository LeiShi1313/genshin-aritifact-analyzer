options swap_delay=12 iteration=1000;

# Build assumptions
wrio char lvl=90/90 cons=6 talent=10,10,10;
wrio add weapon="cashflow" refine=5 lvl=90/90;
wrio add set="mh" count=4;
wrio add stats hp=4780 atk=311 em=187 atk%=0.466 cd=0.622;
wrio add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=138.74 cr=0.2979 cd=0.662;

xilonen char lvl=90/90 cons=6 talent=10,10,10; 
xilonen add weapon="peakpatrolsong" refine=5 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583;
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

xiangling char lvl=90/90 cons=6 talent=10,10,10;
xiangling add weapon="favlance" refine=5 lvl=90/90;
xiangling add set="scroll" count=2;
xiangling add set="eosf" count=2;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.331 cd=0.4634;

bennett char lvl=90/90 cons=6 talent=10,10,10;
bennett add weapon="skywardblade" refine=5 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=79.28 cr=0.2317 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active wrio;

let N1E_tech = false;  # change between true and false to make Wrio use N1E tech or not

wrio attack;
for let i=0; i<4; i=i+1 {
  xilonen skill, attack:2;
  bennett attack:2, burst, skill;
  xiangling burst, skill, dash;
  if N1E_tech == false {
    wrio  skill;
    wrio  attack:5, charge, jump;
  } else {
    wrio  attack, skill;
    wrio  attack:4, charge, jump;
  }
  wrio  attack:5, charge, jump;
  wrio  attack:5, charge;
  if .wrio.burst.ready && .wrio.energy == .wrio.energymax  {
    wrio dash;
    wrio burst;
    wrio attack:3, charge; # leave cryo with N1 and spend some time for xiangling 20s cd
  } else {
    wrio jump;
    wrio attack:5, charge;
  }
}
