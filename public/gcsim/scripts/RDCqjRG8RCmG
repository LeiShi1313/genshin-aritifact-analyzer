# Raiden Sara Kazuha Baizhu. ~20s Rot. Raiden Aggravate with Baizhu. Sara buffs herself, Kazuha, and Raiden. Kazuha uses E twice.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9; 
raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="twilight" refine=5 lvl=90/90;
sara add set="no" count=4;
sara add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="ohc" count=4;
baizhu add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.331 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.3 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  kazuha skill, high_plunge;
  
  baizhu skill, attack, burst;
  
  sara skill, aim, attack;
  
  kazuha skill, high_plunge, burst;
  
  sara burst;
  
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
}
