# Klee Furina Xilonen Xianyun. ~24s Rot. Klee Plunge, Furina Vape; Hydro VV only, Inconsistent Pyro Scroll after the first Rot. Xilonen does 2Es after the first rotation, Xianyun uses her triple jump to fill time. Klee bursts as available and does CAs between plunges, stamina permitting; meaningful affect on team energy. 50% Collisions.

# Team - Options listed by DPS
klee char lvl=90/90 cons=0 talent=9,9,9;
klee add weapon="widsith" refine=3 lvl=90/90;
klee add set="mh" count=4;
klee add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
klee add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2317 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.5958;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311;
xilonen add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.2976 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active klee;
klee skill[bounce=3, mine=8];

for let i=0; i<4; i=i+1 {
  if i > 0 {
  #if i > -1 { # close
    xilonen skill, attack:2;
  }

  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;

  xianyun skill:3, low_plunge, attack, burst;

  xilonen skill, attack:2;

  if .klee.skill.ready {
    klee skill[bounce=3, mine=8];
  }
  if .klee.burst.ready {
    klee burst;
  }
  while .xianyun.status.xianyun-airborne-buff {
    if .klee.status.xianyun-airborne-buff {
      klee jump;
      if .airborne{
        klee high_plunge[collision=rand()>0.5];
      }
    }
    # Klee CA Optimzation
    if .klee.status.a1-spark {
      klee attack;
      klee charge;
    } else if .stam > 50 {
      klee attack;
      klee charge;
    } else {
      klee attack;
    }
  }

}
