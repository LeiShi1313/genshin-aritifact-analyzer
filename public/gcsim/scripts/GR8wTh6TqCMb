options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=999999999; 
energy every interval=480,720 amount=1;
#hurt every interval=300, 450 amount=1000,3000 element=physical;  # For R1 or VG Dehya
set_particle_delay("chevreuse", 80);                              # Dehya is always able to catch within swap cd

active dehya;

dehya skill;

for let x = 0; x < 5; x = x + 1{
	fischl attack:2, burst;
  chevreuse attack, skill[hold=1], walk, attack;
  dehya attack, skill;
  yae attack, skill, attack, skill, attack, skill, attack;
	dehya burst, skill:10;
	fischl skill, attack;
	yae burst, attack:2, skill, attack, skill, attack, skill, attack;
  chevreuse burst, attack, skill[hold=1], walk;
  dehya skill, attack;
	yae attack:2, dash, attack:2;
}

