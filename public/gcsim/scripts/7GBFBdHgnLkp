# Xianyun Nahida Furina Fischl. 26s Rot. Xianyun Salad, using low plunges with Xianyun's burst to Swirl more frequently.

# Team - Options listed by DPS
xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="evenstar" refine=1 lvl=90/90;
#xianyun add weapon="sacfrags" refine=3 lvl=90/90;
#xianyun add weapon="flowingpurity" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324; # 3EM;
#xianyun add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
#xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.1655 cd=0.5958; #ADC;

nahida char lvl=90/90 cons=0 talent=9,9,9; 
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=118.92 cr=0.2648 cd=0.5958;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.5958;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2.6 pos=0,3.0 hp=100000000; # 3EM Xianyun; Fischl Triggers minimal HB
#target lvl=100 resist=0.1 radius=2.2 pos=0,2.5 hp=100000000; # ADC Xianyun; Fischl Triggers some HB

#Rotation
active fischl;
fischl skill;

for let i=0; i<4; i=i+1 {
  if i > 0 {
    fischl attack, skill;
  }
  
  furina skill, dash, burst;
  
  nahida skill, attack, burst;
  
  while .fischl.oz {
    if .xianyun.skill.ready && .xianyun.burst.ready && .xianyun.energy == .xianyun.energymax {
      xianyun skill, low_plunge[collision=rand()>0.5], burst, attack;
    }
    # Driving plunge combo
    if .xianyun.status.xianyun-airborne-buff {
      xianyun jump;
      if .airborne {
        xianyun low_plunge[collision=rand()>0.5], attack;
      }
    }
    # Avoids spending skill during burst
    if .xianyun.skill.ready && !.xianyun.status.xianyun-airborne-buff {
        xianyun skill, low_plunge[collision=rand()>0.5];
    } else {
    # Driving NA Combo
      if .xianyun.normal > 2 {
        xianyun dash;
      } else {
        xianyun attack;
      }
    }
  }
  
  fischl attack:2, burst;
  
  while .fischl.oz {
    # Driving plunge combo
    if .xianyun.status.xianyun-airborne-buff {
      xianyun jump;
      if .airborne {
        xianyun low_plunge[collision=rand()>0.5], attack;
      }
    }
    # Avoids spending skill during burst
    if .xianyun.skill.ready && !.xianyun.status.xianyun-airborne-buff {
        xianyun skill, low_plunge[collision=rand()>0.5];
    } else {
    # Driving NA Combo
      if .xianyun.normal > 2 {
        xianyun dash;
      } else {
        xianyun attack;
      }
    }
  }
  
  print("done");
}

