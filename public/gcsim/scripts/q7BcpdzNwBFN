# PMC Chevreuse Ororon Bennett. ~18s Rot. PMC on-field DPS, uses burst when available. PMC uses hE. PMC does N2C/N3D as available. Chevreuse bursts every other rot. Ororon does more damage on full EM.

# Team- Options listsed by DPS
aetherpyro char lvl=90/90 cons=6 talent=9,9,9  +params=[base_atk_buff=1, skirk_story_buff=1];
aetherpyro add weapon="harbinger" refine=5 lvl=90/90;
#aetherpyro add weapon="lionsroar" refine=3 lvl=90/90;
#aetherpyro add weapon="finale" refine=5 lvl=90/90;
aetherpyro add set="oc" count=4;
#aetherpyro add set="scroll" count=4; # Cannot proc reliably
aetherpyro add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
aetherpyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.2204 em=39.64 cr=0.2648 cd=0.662; # HoD
#aetherpyro add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#aetherpyro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # Finale

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="gt" count=4;
#chev add set="emblem" count=4;
chev add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="stringless" refine=3 lvl=90/90; # Stringless > Ode > CB
#ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 er=0.518 em=187 em=187; # main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=158.56 cr=0.331 cd=0.1986; # Stingless
#ororon add stats hp=4780 atk=311 em=187 em=187 em=187; # main
#ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=118.92 cr=0.3972 cd=0.331; # Fav

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2648 cd=0.7282;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000; # Far right

# Rotation
active ororon;

for let i=0; i<4; i=i+1 {
  ororon skill, burst;
  
  bennett skill, burst;
  
  # Every other Rotation
  if .chev.burst.ready {
    chev burst, skill[hold=1]:2;
  } else {
    chev skill[hold=1], attack;
  }
  
  while .aetherpyro.mods.bennett-field || .status.bennettburst { 
    switch {
      case .aetherpyro.skill.ready:
        aetherpyro skill[hold=0], attack, charge;
      case .aetherpyro.burst.ready: # Significantly better after skill (+ Bennett Buff applied)
        aetherpyro burst;
      case .aetherpyro.normal > 2 && .stam > 25: # N2C
        aetherpyro charge;
      case .aetherpyro.normal > 3 && .aetherpyro.dash.ready && .stam > 18: # N3D
        aetherpyro dash;
      default:
        aetherpyro attack;
    }
  }
  
  print("done");
}

