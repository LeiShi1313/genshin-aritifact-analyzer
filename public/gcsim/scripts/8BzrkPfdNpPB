#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

#Rotation
active shenhe;

for let x = 0; x < 4; x = x + 1 {
  shenhe skill, burst;

  bennett burst, skill;

  xiangling burst, skill, dash, attack;

  bennett skill;

  chongyun burst, skill;

  shenhe skill, attack; # attack is ussually Cryo

  bennett attack, skill;

  chongyun attack:4, dash, # Bennett burst expires before N4
    attack:4;
}
