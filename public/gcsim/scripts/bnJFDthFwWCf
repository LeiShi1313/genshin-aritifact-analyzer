options iteration=1000 swap_delay=12;

wrio char lvl=90/90 cons=0 talent=9,9,9;
wrio add weapon="widsith" refine=3 lvl=90/90; 
wrio add set="mh" count=4;
wrio add stats hp=4780 atk=311 atk%=.466 cryo%=0.466 cd=0.622;
wrio add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

layla char lvl=90/90 cons=6 talent=9,9,9;
layla add weapon="harbingerofdawn" refine=5 lvl=90/90;
layla add set="totm" count=4;
layla add stats hp=4780 atk=311 hp%=0.466 cryo%=0.466 cd=0.622;
layla add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

traveleranemo char lvl=90/90 cons=6 talent=9,9,9 +params=[base_atk_buff=1];
traveleranemo add weapon="wolffang" refine=1 lvl=90/90;
traveleranemo add set="vv" count=4;
traveleranemo add stats hp=4780 atk=311 er=.518 cryo%=0.466 cd=0.622; #main
traveleranemo add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2979 cd=0.4634;
																																											
shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favlance" refine=3  lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466 ; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.1324;


active layla;
target lvl=100 resist=0.1 hp=999999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;
 
for let x=0; x<4; x=x+1 {
  layla burst, skill;  
  traveleranemo skill[hold=1];
  if .traveleranemo.burst.ready{
    traveleranemo burst;
  }
  shenhe skill[hold=1];
  if .shenhe.burst.ready{
    shenhe burst;
  }
  wrio skill,
       attack:3, charge, dash,
       attack:3, charge, dash,
       attack:3, charge, dash,
       attack:3, charge, jump,
       attack:3, charge, jump;
  if .wrio.burst.ready {
    wrio burst;
  } else {
    wrio attack;
  }
}

