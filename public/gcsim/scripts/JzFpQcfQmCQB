# Kinich Ororon Tighari Kirara. ~21s Rot. Triple Dendro Spread. Kinich seeks blindspots. No Kinich Short Hold E is -2K DPS. Kinich bursts every other rotation. Ororon provides enough quicken to last throught to Tighnari's field time.

# Team
kinich char lvl=90/90 cons=0 talent=9,9,9;
kinich add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
kinich add set="oc" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
kinich add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662;

ororon char lvl=90/90 cons=6 talent=9,9,9; 
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
ororon add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

tighnari char lvl=90/90 cons=0 talent=9,9,9;
tighnari add weapon="ode" refine=5 lvl=90/90;
#tighnari add weapon="slingshot" refine=5 lvl=90/90;
tighnari add set="no" count=4;
#tighnari add set="gd" count=4;
#tighnari add set="wt" count=4;
tighnari add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
tighnari add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;
#tighnari add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622; #main
#tighnari add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # Slingshot

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="favsword" refine=3 lvl=90/90;
kirara add set="deepwood" count=4;
#kirara add set="no" count=4;
kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
kirara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

fn kinich_combo() {
  kinich skill;
  while .kinich.nightsoul.state {
    switch .kinich.nightsoul.points {
      case 20:
        kinich skill[hold=1];
      default:
        if .kinich.blind_spot {
          kinich attack[direction=.kinich.blind_spot];
        } else {
          kinich attack;
        }
    }
  }
}

#Rotation
active kinich; # SS stacks

for let i = 0; i < 4; i = i + 1 {
  kirara skill[short_hold=1];
  if .kirara.burst.ready {
    kirara burst;
  } else {
    if !.kirara.mods.favonius-cd {
      kirara attack;
    }
  }
  
  ororon skill, burst, attack;
  
  kinich_combo();
  if .kinich.burst.ready {
    kinich burst;
  }
  
	tighnari skill, aim;
	if .tighnari.burst.ready {
	  tighnari burst, aim:2;
	} else {
	  tighnari aim:2;
	}
  
}

