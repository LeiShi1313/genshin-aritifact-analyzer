# Raiden Columbina Durin Mona. ~19s Rot. Raiden Lunarcharge with Durin Overvape from off-field. Raiden Q 2N4D N4E N3. Raiden/Columbina SMS/Aubade > Emblem/SMS. Pamber Mona instead of columbina is slightly worse. Dark Durin exceeds light Durin by ~1K DPS.

# Team - Options listed by DPS
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="sms" count=4;
#raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="pamber" refine=5 lvl=90/90;
#columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="aubade" count=4;
#columbina add set="sms" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*9 er=0.0551*2 em=19.82*2 cr=0.0331*7 cd=0.0662*10;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="ttds" refine=5 lvl=90/90;
#mona add weapon="pamber" refine=5 lvl=90/90;
mona add set="cg" count=4;
mona add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i = 0; i < 4; i = i + 1 {
  if .columbina.burst.ready { # || .columbina.weapon == .keys.weapon.pamber { # DPS loss, suprisingly
    columbina skill, burst;
  } else if i > 0 {
    columbina skill, attack, charge;
  } else {
    columbina skill, attack;
  }

  mona burst, attack;

  durin skill, burst, attack;
  #durin skill, burst, skill;

  mona attack, skill, attack;

  raiden burst,
         attack:4, dash,
         attack:4, dash,
         attack:4, skill,
         attack:3;
}
