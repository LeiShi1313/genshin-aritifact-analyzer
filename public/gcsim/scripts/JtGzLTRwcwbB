#Noelle Yelan Furina Chiori, APL version. Noelle has main DPS of team.

options swap_delay=12 iteration=1000;

noelle char lvl=90/90 cons=6 talent=9,9,9;
noelle add set="mh" count=4;
noelle add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
noelle add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
noelle add stats def%=0.4340 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2979 cd=0.6620;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favoniuswarbow" refine=3 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.640 cr=0.3972 cd=0.6620;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="cinnabarspindle" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=4999999;
energy every interval=480,720 amount=1;

active furina;
let rotation = 0;
for {
  switch {
    case .furina.burst.ready && .furina.skill.ready && .furina.swap.ready:
      furina skill, dash, burst;
      pick_up_crystallize("any");
      if rotation { furina attack; }

    case .yelan.burst.ready && .yelan.swap.ready:
      yelan burst, attack;
    case .yelan.skill.ready && .yelan.swap.ready:
      yelan skill, attack;
      pick_up_crystallize("any");

    case .chiori.skill.ready && .chiori.swap.ready:
      chiori skill:2;

    case .noelle.skill.ready && .noelle.swap.ready:
      noelle skill;
      if .noelle.status.noelle-burst { noelle attack:2; }

    case .noelle.burst.ready && .noelle.swap.ready && !.noelle.status.noelle-burst:
      noelle burst;
      noelle attack:2;
      rotation = rotation + 1;

    case .noelle.normal == 4:
      noelle dash;
      pick_up_crystallize("any");
    case .noelle.status.noelle-burst:
      noelle attack;

    case .noelle.onfield:
      noelle attack;
    case .yelan.onfield:
      yelan  attack;
    case .chiori.onfield:
      chiori attack;
    case .furina.onfield:
      furina attack;
  }
}

