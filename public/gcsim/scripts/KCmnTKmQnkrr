# Freminet Furina Yelan Dori. ~22s Rot. Phys Freminet on-field with Fav Dori comfortably batterying the team. Yelan loses few dice procs.

# Team
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="tidalshadow" refine=5 lvl=90/90;
#freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5]; # PF
freminet add set="mh" count=4;
#freminet add set="pf" count=4; # SSr1
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # TS + MH
#freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622 ; #main
#freminet add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # SS + MH
#freminet add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622 ; #main
#freminet add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.1102 em=39.64 cr=0.2648 cd=0.662; # SS + MH; ATK Cup

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
#furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90; # over Slingshot + Furina ER
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

dori char lvl=90/90 cons=6 talent=9,9,9; 
dori add weapon="favgs" refine=3 lvl=90/90;
dori add set="ohc" count=4;
#dori add set="sodp" count=4;
#dori add set="no" count=4;
dori add stats hp=4780 atk=311 er=0.518 em=187 heal=0.359; #main
dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=198.2 cr=0.3972 cd=0.1324; # ErEmHb
#dori add stats hp=4780 atk=311 er=0.518 hp%=0.466 heal=0.359; #main
#dori add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.2204 em=138.74 cr=0.3972 cd=0.1324; # ErHpHb

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  dori burst, skill, attack;
  
  if .yelan.burst.ready {
    yelan burst, attack, skill;
  } else {
    yelan skill, burst, attack;
  }
           
  freminet skill, attack, burst,
           attack:2, skill, skill,
           attack:2, skill, attack, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
           attack:2, skill, attack, skill,
           attack:2, skill;
  
# Notation
# Furina EDQ > Dori QEN1 > Yelan QN1E/EQN1 
# Freminet EN1QN2E EN2E 2[N1EN2E]
}
