fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Vhunt
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Others

candace char lvl=90/90 cons=6 talent=9,9,9;
candace add weapon="favlance" refine=3 lvl=90/90;
candace add set="no" count=4;
#candace add set="emblem" count=4;
candace add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311 ; #main
candace add stats def=39.36 def%=0.124 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.331 cd=0.1324; # Hydro Goblet
#candace add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
#candace add stats def=39.36 def%=0.124 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.331 cd=0.1324; # Hp Goblet

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active fischl;
fischl skill, attack;

for let i=0; i<4; i=i+1 {
	furina skill, dash, burst;
	
	candace attack, skill, burst;
	
	bennett burst, attack, skill;
	
	if .fischl.burst.ready {
	  fischl attack:2, burst;
	} else {
	  fischl attack, skill;
	}
	
	bennett attack;
	while .status.bennettburst {
      if .bennett.skill.ready {
        bennett skill;
      } else {
        bennett attack;
      }
	}
	bennett attack:3, skill;
	
	print("done");
}
