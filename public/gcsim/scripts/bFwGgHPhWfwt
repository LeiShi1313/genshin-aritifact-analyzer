# Escoffier Furina Chongyun Shenhe. ~20s Rot. Cryo infused on-field Escoffier w/ Chongyun. 2E Shenhe. -3K DPS with Freeze immunity and MH on Escoffier.

# Team - Options listsed by DPS
escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="lithicspear" refine=1 lvl=90/90;
#escoffier add weapon="prospectorsdrill" refine=1 lvl=90/90;
escoffier add set="bs" count=4;
#escoffier add set="mh" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.1102 em=39.64 cr=0.1986 cd=0.662; # BS & MH

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.5952 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.1655 cd=0.1986;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favlance" refine=3 lvl=90/90;
shenhe add set="sr" count=2;shenhe add set="ur" count=2;
#shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.6061 em=39.64 cr=0.3972 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=0;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1; # Freeze Immunity

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;

  esco skill, burst;

  shenhe skill, burst;

  chongyun burst, skill;

  while .shenhe.skill.cd {
    switch {
      case .esco.normal > 2 && .stam > 43:
        esco charge, dash;
      case .esco.normal > 2 && .stam > 18:
        esco dash;
      default:
        esco attack;
    }
  }

  shenhe skill, attack;

  while .furina.skill.cd {
    switch {
      case .esco.normal > 1 && .stam > 25:
        esco charge;
      case .esco.normal > 3 && .stam > 18:
        esco dash;
      default:
        esco attack;
    }
  }

}
