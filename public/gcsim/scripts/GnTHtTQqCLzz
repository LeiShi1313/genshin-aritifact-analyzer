# ----  Default Enemy
options swap_delay=12 debug=true iteration=1000;
target lvl=100 resist=0.1 hp=100000000 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

active neuv;
for let i = 0; i < 4; i = i + 1 {
  neuv skill;
  if .kazuha.burst.ready {
  kazuha burst;
  } else {
  kazuha skill, high_plunge;
  }
  zhongli skill[hold=1], dash, attack;
  while !pick_up_crystallize("any") {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  }
  
  while !.zhongli.mods.favonius-cd { 
    zhongli attack;
  }
  yelan burst, attack, skill;
  neuv attack, charge, burst, skill, charge;
  kazuha attack, skill, high_plunge;
  yelan attack, skill, attack;  
  neuv charge, charge;
}
wait(173);

#Neuv E > Kazuha Q if possible otherwise tEP > ZL hE dash to get shard, N1 > YL Q N1 E > Neuv N1 C Q E C > KZ N1 tEP > YL N1 E N1 > Neuv 2C