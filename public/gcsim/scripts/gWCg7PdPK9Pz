nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="favcodex" refine=5 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2648 cd=0.1324 ;

options swap_delay=12 iteration=1000;

active nahida;
target lvl=100 resist=0.1 hp=999999999 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {
  nahida burst, skill;

  yelan burst, attack, skill, attack;

  mavuika burst, attack, skill;

  mualani skill,
          walk[f=91], attack,
          walk[f=91], attack,
          walk[f=91], attack;

  if i == 3 {
    yelan skill; #can do this every rotation with C1 Yelan, or on final rotation of fight.
  } else {
    if i == 0 {
      yelan attack:3;
    }
  }

  if .mualani.burst.ready {
    mualani burst;
  }

}
