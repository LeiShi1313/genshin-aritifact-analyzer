# Characters
luminepyro char lvl=90/90 cons=6 talent=9,9,9;
luminepyro add weapon="finaleofthedeep" refine=5 lvl=90/90;
luminepyro add set="thunderingfury" count=4;
luminepyro add stats hp=4780 atk=311 em=186.5 pyro%=0.466 cr=0.311;
luminepyro add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 em=79.26 er=0.1101 cr=0.3305 cd=0.7926;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="no" count=4;
chev add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
chev add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.1487 def=39.35 def%=0.1239 em=39.63 er=0.3303 cr=0.2644 cd=0.7266;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.1982 def=39.35 def%=0.1239 em=39.63 er=0.1101 cr=0.3305 cd=0.7926;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="chainbreaker" refine=5 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
ororon add stats hp=507.88 hp%=0.0991 atk=33.07 atk%=0.0991 def=39.35 def%=0.1239 em=39.63 er=0.3303 cr=0.2644 cd=0.7926;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Target
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active ororon;

for let i=0; i<4; i=i+1 {
  ororon skill, burst;

  chev burst, skill[hold=1]:2;

  if !.fischl.skill.ready {
    fischl attack:2, burst;
  }
  else {
    fischl attack, skill;
  }

  luminepyro skill;
  for let i=0; i<2; i=i+1 {
    if .luminepyro.burst.ready{
      luminepyro burst;
    }
    luminepyro attack:2, charge, attack:3, charge;
  }
}

# Rotation 15.5s
# Ororon EQ > Chevreuse Q EE > Fischl N1 Q/E > PMC EQ 2[N2C N3C]
