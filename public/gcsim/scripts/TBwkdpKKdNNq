xiangling add set="scroll" count=5;
xiangling add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=118.92 cr=0.331 cd=0.5296;

chevreuse char lvl=90/90 cons=6 talent=9,9,9;
chevreuse add weapon="favoniuslance" refine=3 lvl=90/90;
chevreuse add set="sodp" count=4;
chevreuse add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466 ; #main
chevreuse add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662 ;

options iteration=100 swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active raiden;

raiden skill;
for let i = 0; i < 3; i = i + 1 {
  chevreuse burst, skill[hold=1];
  if i {
    chevreuse skill[hold=1]:2;
    xiangling attack:3, dash;
  }
  sara skill, burst;
  xiangling burst, skill, dash;
  sara aim;
  raiden burst,
         attack:4, skill,
         attack:4, dash,
         attack:4, dash,
         attack:4;
}
