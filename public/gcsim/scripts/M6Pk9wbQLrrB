#Kazuha burst every other rotation.
#Yelan MH is slightly better than EOSF, HP and Hydro goblets are about equal,
#Furina HP goblet is slightly better, pipe is about 2% worse than festering

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="recurvebow" refine=5 lvl=90/90;
yelan add set="mh" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3641 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="ironsting" refine=5 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 def%=0.583 cr=0.311; #main
xilonen add stats def%=0.434 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.331 cd=0.2648;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active furina;

let odd = true;
for let i = 0; i < 5; i = i + 1 {
  furina skill, dash, burst;
  xilonen burst, skill, attack:2;
  while .xilonen.weapon == .keys.weapon.favsword && .xilonen.mods.favonius-cd == 0 {
    xilonen attack;
  }
  if odd {
    kazuha burst;
  } else {
    kazuha skill, high_plunge;
  }
  yelan burst, attack, skill, attack:4, dash, attack:4, dash, attack:4;
  kazuha attack, skill, high_plunge;
  yelan attack:4, skill, attack:4;
  odd = !odd;
}
