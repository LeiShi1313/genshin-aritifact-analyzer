options swap_delay=12 iteration=100;

# Build
neuvillette char lvl=90/90 cons=0 talent=9,9,9 +params=[start_hp=35000]; 
neuvillette add weapon="sacrificialjade" refine=1 lvl=90/90 ;
neuvillette add set="mh" count=4;
neuvillette add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
neuvillette add stats def%=0.124 def=39.36 hp=507.88 hp%=0.4464 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.1986 cd=0.662;

kazuha char lvl=90/90 cons=0 talent=9,9,9; 
kazuha add weapon="xiphos" refine=1 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=118.92 cr=0.2648 cd=0.1324;

zhongli char lvl=90/90 cons=0 talent=9,9,9; 
zhongli add weapon="favoniuslance" refine=3 lvl=90/90;
zhongli add set="ins" count=4;
zhongli add stats hp=3571 atk=232 hp%=0.3495 hp%=0.3495 cr=0.311; #main
zhongli add stats def=31.488 def%=0.0992 hp=406.304 hp%=0.23808 atk=26.464 atk%=0.07936 er=0.08816 em=31.712 cr=0.2648 cd=0.10592 ;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="ap" count=5;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Target
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

# Rotation
active neuvillette;
for let i=0; i<4; i=i+1 {
  neuv skill, attack;
  zhongli skill[hold=1], dash, attack;
  kaz skill, high_plunge;
  xiangling burst, skill, dash;
  pick_up_crystallize("hydro");
  neuvillette charge, burst, skill, charge;
  kaz skill, high_plunge, burst;
  zl attack, skill;
  xiangling attack:2, skill, dash;
  pick_up_crystallize("hydro");
  neuvillette charge, charge;
}
wait(173);