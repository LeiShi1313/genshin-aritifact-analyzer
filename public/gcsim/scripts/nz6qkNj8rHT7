xianyun char lvl=90/90 cons=2 talent=9,9,9;
xianyun add weapon="oathsworneye" refine=5 lvl=90/90;
xianyun add set="no" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*6 er=0.0551*5 em=19.82*2 cr=0.0331*7 cd=0.0662*2;


# Team

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active durin;
for let i=0; i<5; i=i+1 {
  durin skill:2, burst;
  xianyun skill, low_plunge;

  if !.xianyun.burst.ready  {
    xianyun skill, low_plunge;
  }
  xianyun burst;
  nicole skill, attack;
  xiao skill:2;
  if .xiao.skill.ready && !.xiao.burst.ready {
    xiao skill;
  }
  xiao burst;
  for let h = 10; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=1];
  }

}
