options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

neuv char lvl=90/90 cons=0 talent=9,9,9;
neuv add weapon="sacjade" refine=1 lvl=90/90;
neuv add set="mh" count=4;
neuv add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622;
neuv add stats def=39.36 def%=0.124 hp=507.88 hp%=0.496 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.1986 cd=0.662 ;

xilo char lvl=90/90 cons=0 talent=9,9,9;
xilo add weapon="favsword" refine=3 lvl=90/90;
xilo add set="scroll" count=4;
xilo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilo add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="wanderingevenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=186.5 em=186.5 em=186.5;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xl char lvl=90/90 cons=6 talent=9,9,9;
xl add weapon="favlance" refine=3 lvl=90/90;
xl add set="ap" count=4;
xl add stats hp=4780 atk=311 em=187 em=187 cr=0.311;
xl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.4959 em=39.64 cr=0.331 cd=0.2648;

active neuv;
for let i=0; i<4; i=i+1 {
  neuv skill;
  if i && !.element.t0.hydro {
    sleep(24);
    while !.element.t0.hydro {
      neuv attack; # wait for skill to hit, then NA until enemy has hydro aura
    }
  }
  xilo skill, attack:2;
  nahida skill,burst;
  xl burst, skill, dash; pick_up_crystallize("hydro");
  neuv charge, burst, skill, charge;
  xilo skill, attack:2;
  xl attack:2,skill, dash; pick_up_crystallize("any");
  neuv charge:2;
}
sleep(173); # wait for last CA to finish
