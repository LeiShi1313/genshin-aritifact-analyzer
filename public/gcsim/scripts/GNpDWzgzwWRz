#alhaitham add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*8 cr=0.0331*8 cd=0.0662*10; # WF

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*11 em=19.82*2 cr=0.0331*11 cd=0.0662*4;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
#ororon add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 em=187 em=187 cr=0.311; # main
ororon add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*8 cr=0.0331*10 cd=0.0662*8;

dori char lvl=90/90 cons=6 talent=9,9,9;
dori add weapon="flameforgedinsight" refine=5 lvl=90/90;
dori add set="deepwood" count=4;
dori add stats hp=4780 atk=311 em=187 em=187 em=187; #main
dori add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*6 cr=0.0331*8 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

# Rotation
active furina;

for let r = 0; r < 4; r = r + 1 {
  ororon burst, skill;

  furina skill, dash, burst;

  dori skill, burst;

  alhaitham burst;
  alhaitham attack:3, dash,
            attack:3, charge, dash,
            attack:3, charge, dash,
            attack:1, skill[hold=1], low_plunge[short=1];
  alhaitham attack:4, charge, dash,
            attack:4;
}
