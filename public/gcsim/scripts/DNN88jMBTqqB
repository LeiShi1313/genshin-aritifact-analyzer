raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="emblemofseveredfate" count=5;
raiden add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622 ; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=999999999;
energy every interval=480,720 amount=1;
hurt every interval=50,60 amount=1000,3000 element=physical;
set_particle_delay("chevreuse", 80);                            # Dehya is always able to catch within swap cd

active raiden;

raiden skill;

for let x = 0; x < 4; x = x + 1{
    dehya skill;
  fischl attack, skill;
    chevreuse attack, skill[hold=1], walk, attack;
    dehya attack, skill, burst, skill:10;
  fischl attack:2, burst;
    raiden burst, attack:3, charge, attack:3, charge, attack:3, charge, attack:2, skill;
    chevreuse burst, attack, skill[hold=1], walk;
    dehya attack;
}
