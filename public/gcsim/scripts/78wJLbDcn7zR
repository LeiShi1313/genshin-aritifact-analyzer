gaming char lvl=90/90 cons=6 talent=9,9,9; 
gaming add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=5;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9 ; 
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cr=0.311 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;

xianyun char lvl=90/90 cons=0 talent=9,9,9; 
xianyun add weapon="oathsworneye" refine=5 lvl=90/90;
xianyun add set="vv" count=5;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;


options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active furina;
for let x = 0; x < 4; x = x + 1 {
  furina skill, dash, burst;
  while !.furina.mods.favonius-cd {
    furina attack;
  }
  bennett skill, burst;
  if !.element.t0.pyro {
    bennett attack; # if the aura isn't pyro after EQ do 1 pyro normal attack
  }
  xianyun attack[travel=0], skill, low_plunge, burst; # N1 to swirl pyro right after swapping in
  gaming skill, high_plunge, burst;
  for let p=0; p<3; p=p+1 {
    if .gaming.status.xianyun-airborne-buff {
      gaming jump;
      if .airborne {
        let col = rand();
        if col > 0.5 {
          gaming high_plunge[collision=1];
        } else {
          gaming high_plunge;
        }
      }
    }
    gaming skill, high_plunge;
  }
  bennett skill, attack, dash;
}

# Furina E dash Q > Bennett E Q (N1) > Xianyun N1 E lP Q > Gaming EP Q 3[JHP EP] > bennett E N1 dash
