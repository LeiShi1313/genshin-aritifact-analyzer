# Freminet Escoffier Chongyun Xianyun. ~18s Rot. Freminet Cryo Plunge. Chongyun uses Skill just before Xianyun and the Cryo infusion lasts for all 8 plunges. Xianyun VV also lasts for all 8 plunges. 50% Collisions.

# Team
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#freminet add weapon="fruitfulhook" refine=1 lvl=90/90;
freminet add set="lno" count=4; # Everything else sucks
freminet add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=3 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
#xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.3857 em=59.46 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Freminet Plunge Combo
fn FreminetPlunge() {
  freminet jump;
  if .airborne {
    freminet high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active freminet; # SS Stacks
#freminet skill; # Grimheart stack

for let i = 0; i < 4; i = i + 1 {
  if i > 0 && .esco.burst.ready && .esco.energy == .esco.energymax {
    esco burst;
  }
  esco skill;

  chongyun burst, skill;

  xianyun skill, low_plunge, burst; # N1 Needed for Cryo VV

  freminet skill:2;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet dash; # Chongyun A4 Drop
  FreminetPlunge(); freminet dash;
  FreminetPlunge(); freminet skill:2;
  if i > 0 && .freminet.burst.ready {
    freminet burst;
  }
}
