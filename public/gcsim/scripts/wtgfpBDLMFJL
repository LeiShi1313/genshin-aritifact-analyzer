fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

sara char lvl=90/90 cons=6 talent=9,9,9;
sara add weapon="fadingtwilight" refine=5 lvl=90/90;
sara add set="no" count=5;
sara add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
sara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

tighnari char lvl=90/90 cons=0 talent=9,9,9;
tighnari add weapon="slingshot" refine=5 lvl=90/90;
tighnari add set="deepwood" count=4;
tighnari add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622;
tighnari add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

# ----  Default Enemy


active sara;
# ----  Actions List


target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999; 
energy every interval=480,720 amount=1;

sara skill;

for let i=0; i<5; i=i+1 {
  sucrose burst, attack:2;
  if .sara.skill.ready {
  sara skill;
  }
  sara burst;
  fischl attack:2, burst;
  sara aim;
  tighnari skill, aim, burst, aim:2;
  sucrose attack:2, charge, attack:2, skill, dash, attack, charge;
  sara skill;
  fischl attack, skill;
  sara aim;
  tighnari skill, aim:3;
  sucrose attack, skill, dash, attack:2, charge, attack, dash, attack:2, charge;
}
