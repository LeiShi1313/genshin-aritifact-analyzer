
options swap_delay=12 iteration=1000;



albedo char lvl=90/90 cons=0 talent=9,9,9;
albedo add weapon="cinnabarspindle" refine=5 lvl=90/90;
albedo add set="gt" count=5;
albedo add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #mainstats
albedo add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="wolffang" refine=1 lvl=90/90;
chiori add set="goldentroupe" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622; #mainstats
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="noblesseoblige" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.1324 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.3310 cd=0.662;



target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active albedo;
for let x=0; x<4; x=x+1 {
   albedo skill,attack;
   chiori skill:2;
   bennett skill,burst;
   bennett dash;

   pick_up_crystallize("any");

   fischl attack;
   if .fischl.burst.ready {
     fischl attack,burst;
   } else {
     fischl skill;
   }

   bennett attack:2,skill,attack:3;

   if .chiori.burst.ready {
     chiori burst;
   } else {
     chiori attack:3;
   }
   chiori attack:3,dash;
   pick_up_crystallize("any");

   bennett skill, attack:3;
   chiori attack:3;
}
