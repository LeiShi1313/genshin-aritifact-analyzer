#KQMS Delay
options iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active faruzan;
for let i=0; i<4; i=i+1 {
  faruzan burst;
  while !.faruzan.mods.favonius-cd && !.xianyun.burst.ready {
    faruzan attack;
  }
  xianyun skill, low_plunge, burst;
  jean burst, skill;
  while !.jean.mods.favonius-cd && !.xiao.burst.ready {
    jean attack;
  }
  xiao skill:2, burst;
  for let h = 12; h > 0; h = h - 1 {
    let col = rand();
    if col > 0.5 {
      xiao jump, high_plunge[collision=1];
    } else {
      xiao jump, high_plunge;
    }
  }
}
