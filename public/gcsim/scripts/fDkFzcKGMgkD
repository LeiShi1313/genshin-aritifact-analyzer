# Razor Rosaria Fischl Xianyun. ~18s Rot. Razor Phys Plunge. Razor uses skill off CD while plunging and bursts when availble for IR and C6 Crit. OHC > SoDP Xianyun, but bubbles may miss. Razor uses burst when ready just to fill rotation time. 50% Collisions.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#razor add weapon="fruitfulhook" refine=1 lvl=90/90;
razor add set="lno" count=4; # LNO > PF
#razor add set="risingwinds" count=4; # RW > MH
razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # LNO
#razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*9 er=0.0551*2 em=19.82*2 cr=0.0331*7 cd=0.0662*10; # RW

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main # Yes, this was slightly better than a CD Circlet
rosaria add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*5 em=19.82*11 cr=0.0331*10 cd=0.0662*2;

