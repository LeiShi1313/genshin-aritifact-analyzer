xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active razor; # SS Stacks

# Razor Plunge Combo
fn RazorPlunge() {
  razor jump;
  if .airborne {
    razor high_plunge[collision=rand()>0.5];
  }
}

for let x = 0; x < 4; x = x + 1 {
  xianyun skill, low_plunge, burst;
  
  if .amy.skill.ready { 
    amy attack:1, skill; 
  } else { 
    amy attack:2, burst; 
  }
  
  rosaria skill, burst;
  
  razor skill;
  RazorPlunge(); razor dash;
  RazorPlunge(); razor dash;
  RazorPlunge(); razor dash;
  RazorPlunge(); razor dash;
  RazorPlunge(); razor skill;
  RazorPlunge(); razor dash;
  RazorPlunge(); razor dash;
  RazorPlunge();
  if x > 0 && .razor.burst.ready {
    razor attack, burst;
  } else {
    razor attack:2;
  }
}
