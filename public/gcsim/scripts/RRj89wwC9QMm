clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
clorinde add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=39.64 er=0.2204 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main
fischl add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=79.28 er=0.1102 cr=0.331 cd=0.7944;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="hakushinring" refine=5 lvl=90/90;
sucrose add set="viridescentvenerer" count=5;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187 ; #main
sucrose add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.6612 em=118.92 cr=0.0662 cd=0.1324 ;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="favsword" refine=3 lvl=90/90;
kirara add set="scroll" count=4;
kirara add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; # main
kirara add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=79.28 er=0.1102 cr=0.331 cd=0.7944;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
        clorinde skill;
    } else {
        clorinde attack;
    }
  }
}

active fischl;

# opening rotation skips clorinde burst
fischl burst;
kirara skill, attack;
sucrose skill, dash, burst, attack;
clorinde_combo();

for let r=0; r<4; r=r+1 { # 4 rotations (in addition to modified opening rotation)

  sucrose attack, charge; # swap in sucrose to refresh VV and hakushin ring buff
  clorinde burst;
  if .kirara.burst.ready { # kirara burst every other rotation
    kirara skill, burst;
  } else {
    kirara skill, attack;
  }
  if .fischl.burst.ready { # fischl burst every other rotation
    fischl attack:2, burst;
  } else {
    fischl attack, skill, attack;
  }
  if .sucrose.burst.ready { # sucrose burst when available
    sucrose skill, dash, burst, attack;
  } else {
    sucrose skill, dash, attack;
  }
  clorinde_combo();

}
