options swap_delay=12 iteration=500 ;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=10000000; 
energy every interval=480,720 amount=1;

active furina;	
for let i = 0; i<4; i=i+1 { 
 furina skill, dash, burst; 
 diona skill[hold=1], burst; 
 yelan burst, attack;
 if i {
   diona attack:4; #swap back to diona to directly heal her past first rotation and proc fav more reliably
 }
 yelan attack, skill;
 hutao skill,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:1, charge, jump,
       attack:2, charge, jump, attack; 
 yelan skill, attack:2;
 if !i {
   furina attack:3; #fill downtime on first rotation
 }	
}


