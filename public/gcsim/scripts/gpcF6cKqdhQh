# Team
kinich char lvl=90/90 cons=0 talent=9,9,9;
kinich add weapon="favgs" refine=3 lvl=90/90;
kinich add set="deepwood" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cr=0.311; #main
kinich add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="widsith" refine=3 lvl=90/90;
// columbina add weapon="dawningfrost" refine=1 lvl=90/90;
columbina add set="notsu" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="xiphos" refine=1 lvl=90/90;
durin add set="sms" count=4;
durin add stats hp=4780 atk=311 em=187 em=187 em=187; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*5 em=19.82*6 cr=0.0331*12 cd=0.0662*2;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="etherlight" refine=5 lvl=90/90;
lauma add set="gd" count=2;
lauma add set="wt" count=2;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187;
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*6 cr=0.0331*9 cd=0.0662*3;

# Options
options iteration=100;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation

active lauma;
lauma attack:2; # Dendro app at the start

for let i=0; i<4; i=i+1 {
  if .bina.burst.ready{
    bina skill, attack, burst;
  } else{
    bina skill, attack;
  }
  lauma attack, skill[hold=.dew], burst;
  durin skill, burst, skill;
  kinich skill;
  for let j=0; j < 1; {
    if .kinich.nightsoul.points == 20 {
      kinich skill[hold=1];
      j = j + 1;
    }
    kinich attack;
  }
  kinich burst;
  bina attack, charge, dash, charge, dash,
       attack, charge, dash, charge;//, dash, charge;
}
bina dash, attack;
