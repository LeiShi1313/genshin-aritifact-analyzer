mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="ap" count=4;
mavuika add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.3972 cd=0.4634;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn mualani_combo() {
  mualani skill;
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 { # 3 bites
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
  break;
  }
}

active mavuika;

for let i=0; i<3; i=i+1 {
  candace skill, burst;
  xilonen skill, attack:2;
  mavuika burst, skill, dash; pick_up_crystallize("hydro");
  mualani_combo();
  mualani burst;

  candace attack:2, skill;
  xilonen skill, attack:2;
  mavuika skill[hold=1], attack:2, dash; pick_up_crystallize("hydro");
  mualani_combo();
  mualani skill;
}
