# Ganyu Furina Venti Escoffier. ~21s Rot. On-field Freeze DPS Ganyu in 2 target. 2 E Ganyu skills per rotation. Assumes freezable enemies and high ability to headshot; -3K DPS with Stillness. Venti always absorbs Cryo, and leads to low ER reqs for the Cryo units.

# Team
ganyu char lvl=90/90 cons=0 talent=9,9,9; 
ganyu add weapon="crescent" refine=5 lvl=90/90;
#ganyu add weapon="songofstillness" refine=5 lvl=90/90;
ganyu add set="bs" count=4;
#ganyu add set="mh" count=4;
ganyu add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.2648 cd=0.4634; # ToM
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.2648 cd=0.4634; # GT

venti char lvl=90/90 cons=0 talent=9,9,9; 
venti add weapon="favbow" refine=4 lvl=90/90;
venti add set="vv" count=4;
venti add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
venti add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.331 cd=0.2648;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
#escoffier add set="no" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets, Freezable, In front & Adjacent
target lvl=100 resist=0.1 radius=1.0 pos=1.4,2.4 hp=100000000 freeze_resist=0;
target lvl=100 resist=0.1 radius=1.0 pos=-1.4,2.4 hp=100000000 freeze_resist=0;

# Protoype Crescent Headshot Conditional
fn ganyuAim() {
  if .ganyu.weapon == .keys.weapon.crescent { # Attempts headshots (80%) with Crescent
    ganyu aim[hold=2, weakspot=rand()>0.2];
  } else { # Non weakspot opponents
    ganyu aim[hold=2];
  }
}

# Rotation
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  esco skill, burst;
	
  ganyuAim();
  ganyu burst, skill; # Snapshot Crescent Headshot
	
  venti skill, burst;
	
  ganyuAim();
  ganyuAim();
  ganyuAim();
  ganyuAim();
  ganyu skill;

  venti skill, attack; # N1 Nessesary for fast swap
}

