# Kazuha Mavuika Bennett Xianyun. ~18s Rot. Mono Pyro Plunge with grouping. Skill plunges bookend Kazuha's field time. Kazuha's burst is DPS neutral. Xianyun freshes VV after Mavuika uses burst; she catches Bennett's particles. OC Mavuika performs similarly. 100% collisions for E plunges, 70% for starwicker plunges.

# Option - Options listed by DPS
kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="harbinger" refine=5 lvl=90/90;
#kazuha add weapon="wolffang" refine=1 lvl=90/90;
#kazuha add weapon="lionsroar" refine=3 lvl=90/90;
#kazuha add weapon="finale" refine=5 lvl=90/90;
kazuha add set="longnightsoath" count=4;
#kazuha add set="sr" count=4;
kazuha add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; #ADCr
#kazuha add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ADCd

mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#mavuika add weapon="tidalshadow" refine=5 lvl=90/90;
mavuika add set="gt" count=4;
