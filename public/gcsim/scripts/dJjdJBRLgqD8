skirk char lvl=90/90 cons=6 talent=10,10,10;
skirk add weapon="azurelight" refine=5 lvl=90/90;
skirk add set="finaleofthedeepgalleries" count=4;
skirk add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
skirk add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*12;

escoffier char lvl=90/90 cons=6 talent=10,10,10;
escoffier add weapon="symphonistofscents" refine=5 lvl=90/90;
escoffier add set="tom" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*8 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

furina char lvl=90/90 cons=6 talent=10,10,10;
furina add weapon="freedomsworn" refine=5 lvl=90/90;
furina add set="scroll" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cd=0.622;
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*11 cd=0.0662*5;

shenhe char lvl=90/90 cons=6 talent=10,10,10;
shenhe add weapon="engulfinglightning" refine=5 lvl=90/90;
shenhe add set="noblesse" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
shenhe add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*8 atk%=0.0496*6 er=0.0551*12 em=19.82*2 cr=0.0331*2 cd=0.0662*2;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
active furina;

for let r=0; r<4; r=r+1 {
  furina skill, dash, attack:2, burst;
  escoffier skill, burst;
  shenhe skill[hold=1], burst;
  if r == 0 {
    skirk burst,         
        skill, 
        attack:2, dash,
        attack:2, charge, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash, 
        attack:2, charge, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3;
    furina swap;
    wait(1339-f());
  } else {
    skirk skill, 
        attack:2, burst,
        attack:2, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:2, charge, dash,
        attack:3, dash,
        attack:3, dash,
        attack:2;
  }
}
