bennett add stats def%=0.10416 def=33.0624 hp=3997.6192 hp%=0.083328 atk=259.7872 atk%=0.0834272 er=0.9808399999999999 em=33.2976 cr=0.45568200000000003 cd=0.444864 pyro%=0.3495;
options swap_delay=12 iteration=1000 ;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=9999999;
energy every interval=480,720 amount=1;

active yelan;
for let i = 0; i<3; i=i+1 {
  yelan skill, attack, burst, attack;
  while !.yelan.mods.favonius-cd {
    yelan attack;
  }
  bennett burst, skill[hold=1];
  sucrose skill, attack;
  hutao skill,
        attack:2, charge, jump,
        attack:2, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump,
        attack:1, charge, jump;
  bennett skill;
  print ("done");
}