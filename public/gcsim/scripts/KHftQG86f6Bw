# Chongyun Escoffier Shenhe Xianyun. ~20s Rot. Chongyun Mono Cryo Plunge. 1E Shenhe. Escoffier bursts as available after the first rotation. Xianyun refreshes VV after Chongyun completes plunging. 50% Collisions.

# Team - Options Listed by DPS
chongyun char lvl=90/90 cons=0 talent=9,9,9;
chongyun add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#chongyun add weapon="fruitfulhook" refine=1 lvl=90/90;
chongyun add set="lno" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.1102 em=39.64 cr=0.2317 cd=0.662;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favspear" refine=3 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.551 em=39.64 cr=0.331 cd=0.1324;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active chongyun; # SS Stacks

for let i = 0; i < 4; i = i + 1 {
  if i > 0 && .esco.burst.ready {
    esco burst;
  }
  esco skill;
  
  shenhe burst, skill[hold=1];
  
  xianyun skill, low_plunge, burst;
  
  if .chongyun.burst.ready {
    chongyun burst;
  }
  while .chongyun.skill.ready {
    chongyun skill;
  }
  # Plunge until expiry
  while .chongyun.status.xianyun-airborne-buff {
    chongyun jump;
    if .airborne {
      chongyun high_plunge[collision=rand()>0.5];
    }
    if .chongyun.status.xianyun-airborne-buff { # no dash for final plunge
      chongyun dash;
    }
  }
  
  xianyun attack:2;
  
  if .chongyun.burst.ready {
    chongyun burst;
  } else {
    chongyun attack:2;
  }
}
