# Rosaria Yelan Furina Kuki. ~22s Rot. Physical Rosaria on-field with Superconduct support Kuki.

# Options ordered by DPS
rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="cpike" refine=5 lvl=90/90;
rosaria add set="mh" count=4;
#rosaria add set="bs" count=4;
#rosaria add set="pf" count=4;
rosaria add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
rosaria add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # Atk Goblet
#rosaria add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; # main
#rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; #Phys Goblet

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="slingshot" refine=5 lvl=90/90;
yelan add set="eosf" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.2648 cd=0.5296 ;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662 ;

kuki char lvl=90/90 cons=6 talent=9,9,9;
kuki add weapon="favoniussword" refine=3 lvl=90/90;
kuki add set="ohc" count=4;
#kuki add set="sodp" count=4;
#kuki add set="tom" count=4;
kuki add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kuki add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.1324; #3EM
#kuki add stats hp=4780 atk=311 em=187 em=187 heal=0.359 ; #main
#kuki add stats def=39.36 def%=0.124 hp=507.88 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.3972 cd=0.1324; #EMEMHB
#kuki add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 heal=0.359; #main
#kuki add stats def=39.36 def%=0.124 hp=507.88 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.1324; #HPHPHB


# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active furina;
furina skill, dash, burst;

for let i=0; i<4; i=i+1 {
  if i > 0 {
    furina burst, attack, skill, dash;
  }

  kuki skill, attack;

  while !.rosaria.skill.ready {
    rosaria attack;
  }
  rosaria skill, burst;

  yelan skill, burst, attack;

  rosaria attack; # Skill as Available for Cpike passive
  while !.yelan.skill.ready {
    if .rosaria.skill.ready {
      rosaria skill;
    } else if .rosaria.normal > 3 {
      if .stam > 25 {
        rosaria charge, dash;
      }
    } else {
      rosaria attack;
    }
  }

  # Essential!
  yelan skill, attack;

  while !.furina.skill.ready {
    if .rosaria.skill.ready {
      rosaria skill;
    } else if .rosaria.normal > 3 {
      if .stam > 25 {
        rosaria charge, dash;
      }
    } else {
      rosaria attack;
    }
  }

# Notation
# Furina EDQ/QN1ED > Kuki EN1 > Rosaria EQ > Yelan EQN1
# Rosaria N3 E N3CD N3CD N3 > Yelan EN1 > Rosaria E N1
}
