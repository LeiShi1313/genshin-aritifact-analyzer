# ----  Default Enemy
options swap_delay=12 debug=true iteration=1000;
target lvl=100 resist=0.1 hp=100000000 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

active neuv;
for let i = 0; i < 3; i = i + 1 {
  neuv skill, attack:3;
  kazuha skill, high_plunge, burst;
  diona burst, skill[hold=1];
  xiangling burst, skill, dash;
  kazuha skill, high_plunge;
  neuv charge, burst, skill, charge;
  kazuha skill, high_plunge;
  xiangling skill, dash, attack;
  diona attack:2, skill;
  neuv charge:2;
}
wait(173);

