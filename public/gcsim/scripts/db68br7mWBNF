options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,3;
energy every interval=480,720 amount=1;

active furina;

# Nahida E N2 [Q] > Furina E [N#] Q > Xianyun EP Q > Yae EEE > Xianyun N3 > Yae 8[JP] [Q]
for let r = 0; r < 4; r = r + 1 {
    nahida skill, attack:2;
    if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
        nahida dash, burst;
    }
    furina skill, dash;
    while !.furina.burst.ready {
        furina attack;
    }
    furina burst;
    xianyun skill, low_plunge, burst;
    yae skill:3;
    xianyun attack:3;
    for let h = 0; h < 8; h = h + 1 {
        # 50% collision
        let coll = rand();
        if coll > 0.5 {
            yae jump, high_plunge[collision=1], dash ;
        } else {
            yae jump, high_plunge, dash;
        }
    }
    if .yae.burst.ready && .yae.energy == .yae.energymax {
        yae burst, skill:3;
    }
}
