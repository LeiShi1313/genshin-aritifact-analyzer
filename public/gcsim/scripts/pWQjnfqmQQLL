options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=9999999999;
energy every interval=480,720 amount=1;
active arlecchino;
for let i=0; i<4; i=i+1 {
  arle charge,skill;
  if i {
    arle attack;
  }
  bennett skill, burst;
  xilonen skill, attack:2;
  kaeya skill, dash; pick_up_crystallize("pyro");
  kaeya burst;
  arle  charge[early_cancel=1], dash;
  while !.element.t0.cryo {
    for let r = 0; r <50; r= r+1{
      if !.element.t0.cryo {
        wait(1);
      } else {
        break;
      }
    }
  }
  arle  attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, dash,
        attack:3, jump,
        attack:3;


}
