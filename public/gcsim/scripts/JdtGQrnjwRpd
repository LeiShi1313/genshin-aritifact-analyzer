xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="sodp" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.3972 cd=0.1324;

wriothesley char lvl=90/90 cons=0 talent=9,9,9;
wriothesley add weapon="thewidsith" refine=3 lvl=90/90;
wriothesley add set="marechausseehunter" count=4;
wriothesley add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311; #main
wriothesley add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.2648 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favoniuslance" refine=3 lvl=90/90;
xiangling add set="emblemofseveredfate" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;


options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
active xianyun;


for let i=0; i<4; i=i+1 {

  xianyun attack, skill, high_plunge, burst;
  if !.xianyun.mods.favonius-cd {
    xianyun attack;
  }
  while !.bennett.burst.ready {
    bennett attack;
  }
  bennett burst,skill;
  while !.xiangling.burst.ready {
    xiangling attack;
  }
  xiangling burst, attack, skill;

  wriothesley skill;
  for let p=0; p<2; p=p+1 {
    wriothesley attack:3, charge, jump;
    if .airborne {
      wriothesley high_plunge;
    } else {
      wriothesley attack, charge;
      break;
    }

    wriothesley dash, jump;
    if .airborne {
      wriothesley high_plunge;
    } else {
      wriothesley attack, charge;
      break;
    }
  }

  wriothesley attack:3, charge, jump;
  if .airborne {
    wriothesley high_plunge;
  } else {
    wriothesley attack, charge;
    break;
  }

  if .wriothesley.burst.ready {
    wriothesley burst;
  }
  bennett skill;
  xiangling attack:3;
}
