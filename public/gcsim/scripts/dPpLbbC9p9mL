furina add stats hp=4780 atk=311 er=0.518 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3641 cd=0.5958;

shenhe char lvl=90/90 cons=6 talent=9,9,9;
shenhe add weapon="favspear" refine=3 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.6061 em=39.64 cr=0.331 cd=0.1324;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.4408 em=39.64 cr=0.2317 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active freminet; # SS Stacks

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  esco skill, burst;
  
  shenhe skill[hold=1], burst;
  
  freminet skill, burst, skill;
  freminet skill:2, attack:2;
  freminet skill:2, attack:2;
  freminet skill:2, attack:2;
  freminet skill:2, attack:2;
  freminet skill:2;
}
