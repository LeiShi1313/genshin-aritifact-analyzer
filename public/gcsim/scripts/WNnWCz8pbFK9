options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 radius=3 pos=0,3.4 hp=999999999999;
energy every interval=480,720 amount=1;

active mavuika;

mona attack, skill;

for let i = 0; i < 6; i = i + 1 {
  nicole skill, burst;
  xilonen skill, attack:2;
  mona burst, attack;
  mavuika burst, charge, skill;
  mona charge;
  xilonen attack:1, skill, attack:2;
  mona charge, jump,
         charge, jump,
         charge, jump,
         charge, attack;
  mona attack, skill, attack;

}
