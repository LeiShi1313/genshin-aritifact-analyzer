# Bennett Durin Nicole Xianyun. ~20s Rot. Bennett Mono Pyro plunge with VV Xianyun. LNO > CW Bennett. Xianyun refreshes VV after Bennett finishes plunging. 50% Collisons.

# Team
bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="harbinger" refine=5 lvl=90/90;
bennett add set="lno" count=4;
#bennett add set="cw" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*10 atk%=0.0496*6 er=0.0551*8 em=19.82*2 cr=0.0331*2 cd=0.0662*4;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*9 em=19.82*2 cr=0.0331*12 cd=0.0662*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=1 pos=0,1.3 hp=100000000;

# Rotation
active nicole;

for let i = 0; i < 4; i = i + 1 {
  nicole burst, skill;

  durin skill, burst, skill;

  xianyun skill, high_plunge, burst;

  bennett burst, skill;
  while .bennett.status.xianyun-airborne-buff {
    bennett jump;
    if .airborne {
      bennett high_plunge[collision=rand()>0.4];
    }
    if .bennett.skill.ready {
      bennett skill;
    } else if .xianyun.status.xianyun-airborne-buff {
      bennett dash;
    }
  }

  xianyun attack:2, charge;

  while .status.bennettburst > 120 {
    if .bennett.skill.ready {
      bennett skill;
    } else if .bennett.normal > 2 {
      bennett charge, dash;
    } else {
      bennett attack;
    }
  }
}
