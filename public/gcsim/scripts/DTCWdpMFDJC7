# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1.5 pos=0,1.8 hp=100000000;

# Rotation
active xq;

for let i=0; i<4; i=i+1 { 
  xingqiu skill, dash, burst, attack;
  
  lanyan attack:2;
  
  yelan burst, attack;
  
  lanyan skill:2, attack;
  
  yelan attack, skill, attack;
  
  hutao skill,
    attack:2, charge, dash,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump,
    attack:1, charge, jump, 
    attack:1;
    
  yelan skill, attack;
  
  if .lanyan.burst.ready && .lanyan.energy == .lanyan.energymax {
    lanyan burst;
  } else {
    lanyan attack:1;
  }
}

