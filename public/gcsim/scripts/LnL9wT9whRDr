# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,3 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3,0 hp=100000000; 

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 { 
	yae skill:3;
	
	xilonen skill, attack:2, burst;
	
	furina skill, dash, burst;
	
	yae attack:2;
	yae burst, skill:3;
	
	xilonen skill, attack:2;
	
	raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;
	
	print("done");
}

