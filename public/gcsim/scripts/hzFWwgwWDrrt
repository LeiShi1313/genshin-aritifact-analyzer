gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=5;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
gaming add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.3972 cd=0.1324;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="favoniuscodex" refine=3 lvl=90/90;
sucrose add set="no" count=4;
sucrose add stats hp=4780 atk=311 er=0.518 em=187 cr=0.311 ; #main
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=118.92 cr=0.331 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="ins" count=4;
bennett add stats hp=3571 atk=232 em=187 pyro%=0.3495 cr=0.23325 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6061 em=39.64 cr=0.2317 cd=0.5296;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=1 pos=0,1.4;
target lvl=100 resist=.1 hp=10000000 radius=1 pos=0,6;
energy every interval=480,720 amount=1;

active gaming;

let rotations = 3;

for let r = rotations; r > 0; r = r - 1 {

  furina skill, dash;
  while !.furina.burst.ready {
    furina attack;
  }
  furina burst;


  while !.bennett.burst.ready {
    bennett attack;
  }
  bennett burst, skill;

  sucrose skill, burst, attack:2;

  while !.gaming.burst.ready {
    gaming attack;
  }
  gaming burst;

  gaming skill;
  sleep(45);
  gaming high_plunge;

  for let j = 0; j < 7; j = j + 1 {

    gaming skill;
    sleep(20);
    gaming high_plunge;


  }

  gaming dash;

}
