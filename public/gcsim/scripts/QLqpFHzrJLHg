options swap_delay=12 iteration=100;

# Build assumptions
kinich char lvl=90/90 cons=0 talent=9,9,9;
kinich add weapon="earthshaker" refine=5 lvl=90/90 +params=[stacks=5];
kinich add set="oc" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
kinich add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=5 lvl=90/90;
mona add set="cg" count=4;
mona add stats hp=4780 atk=311 er=0.518 atk%=0.466 cr=0.311;
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*6 em=19.82*2 cr=0.0331*10 cd=0.0662*10;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="deepwood" count=5;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622;
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*9 er=0.0551*5 em=19.82*2 cr=0.0331*12 cd=0.0662*2;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*2 cr=0.0331*7 cd=0.0662*10;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions

fn kinich_combo() {
  kinich skill;
  for let c=0; c<5; c=c+1 {
    for let a=0; a<2; a=a+1 {
      if .kinich.blind_spot {
        kinich attack[direction=.kinich.blind_spot];
       } else {
        kinich attack;
      }
    }
    while .kinich.nightsoul.points < 20 && .kinich.nightsoul.state {
      wait(1);
    }
    if .kinich.nightsoul.state {
      kinich skill[hold=1];
    }
  }
}
active mona;

for let i=0; i<4; i=i+1 {
  mona attack, skill, attack:2;
  durin skill:2, burst;
  bennett skill, burst;
  mona burst, attack;
  kinich_combo();
  if .kinich.burst.ready && .kinich.energy == .kinich.energymax {
    kinich burst;
  }
}
