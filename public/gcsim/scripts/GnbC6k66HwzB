# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

let Mav6C2DC2 = true;

# Rotation
active mavuika;

for let i=0; i<4; i=i+1 {
  mavuika skill;
  
  xilonen skill, attack:2; pick_up_crystallize("any");
  
  citlali skill, burst;
  
  rosaria skill, attack, burst; # N1 Needed to kill frames & align Cryo app
  
  mavuika burst;
  if Mav6C2DC2 == true {
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2, dash;
    mavuika charge:2;
  } else {
    mavuika charge:13, dash;
  }
}
