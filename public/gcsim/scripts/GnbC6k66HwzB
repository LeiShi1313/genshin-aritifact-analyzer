citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 em=187; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=118.92 cr=0.3641 cd=0.3972;

