chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="hamayumi" refine=5 lvl=90/90;
chasca add set="obsidiancodex" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
chasca add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662;

layla char lvl=90/90 cons=6 talent=9,9,9;
layla add weapon="favsword" refine=3 lvl=90/90;
layla add set="totm" count=4;
layla add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311;
layla add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282;

barbara char lvl=90/90 cons=6 talent=9,9,9;
barbara add weapon="ttds" refine=5 lvl=90/90;
barbara add set="instructor" count=4;
barbara add stats hp=4780 atk=311 hp%=0.466 hp%=0.348 heal=0.268;
barbara add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.333648 cd=0.222432;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=59.46 cr=0.1986 cd=0.662;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 


active layla;

for let i=0; i<4; i=i+1 {
  layla burst, attack, skill, attack;
  bennett skill, burst, attack;
  
  barbara swap; wait(27); # remove swap cd warning
  
  if .barbara.skill.ready {
    barbara attack:2, skill;
  } else {
    barbara attack:2;
  }
  
  chasca skill;
  set_player_pos(0,-2);  # to simulate that Barbara E ring doesn't apply Hydro to the enemy.
  chasca aim:4;
  chasca aim[bullets=4];
  if .chasca.burst.ready && .chasca.energy == .chasca.energymax {
    chasca burst;
  } else {
    bennett attack:2;
  }
  bennett skill, attack:2, dash;
  set_player_pos(0,0);
}

# ~20s rot
# Layla Q N1 E N1 > Bennett EQ N1 > Barbara N2 (E) > Chasca E 4[C] C_4b (Q) > Bennett E N2D