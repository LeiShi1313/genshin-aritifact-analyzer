options iteration=1000 swap_delay=12;

# Build assumptions
dehya char lvl=90/90 cons=6 talent=9,9,9;
dehya add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
dehya add set="vg" count=4;
dehya add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main stats: ATK% Pyro% CD
dehya add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="sacbow" refine=5 lvl=90/90;
fischl add set="gift" count=4;
fischl add stats hp=4780 atk=311 er=0.518 electro%=0.466 cr=0.311; # Main stats: ER Electro% CR
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main stats: ATK% Pyro% CD
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main stats: ATK% Pyro% CR
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*9 em=19.82*2 cr=0.0331*7 cd=0.0662*10;

# Target, Energy and damage taken assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops
hurt every interval=180,300 amount=3500,5500 element=physical; # damage taken assumed every 3-5s

# Rotation assumptions
active dehya; # SS Stacks

for let i=0; i<4; i=i+1 {
  dehya skill;
  fischl skill, attack;
  if !i {
    durin skill, burst, attack;
  } else {
    durin skill:2, burst;
  }
  bennett skill, burst;
  fischl attack:2, burst;
  dehya burst, attack:15;
  bennett skill;
  dehya attack, skill;
}

# 20s rotation (Fischl Sac Bow)
# Dehya E > Fischl E N1 > Durin EEQ > Bennett EQ > Fischl N2 Q > Dehya Q N15 > Bennett E > Dehya N1 E
