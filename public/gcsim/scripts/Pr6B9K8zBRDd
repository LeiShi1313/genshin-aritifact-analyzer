# Kaveh Nahida Fischl Xianyun. ~20s Rot. Kaveh Spread plunge with Kaveh skilling as available for energy. Kaveh NAs until is skill ready after plunges are spent. Fischl alternate skill and burst. OHC > SoDP/NO, but bubbles may miss. 50% collisions.

# Team - Options listed by DPS
kaveh char lvl=90/90 cons=6 talent=9,9,9;
kaveh add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#kaveh add weapon="fruitfulhook" refine=1 lvl=90/90;
kaveh add set="longnightsoath" count=4;
#kaveh add set="deepwood" count=4;
kaveh add stats hp=4780 atk=311 er=0.518 dendro%=0.466 cd=0.622; #main
kaveh add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
#nahida add set="gt" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="chainbreaker" refine=5 lvl=90/90;
fischl add set="scroll" count=4;
#fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="ohc" count=4; # Bubbles may miss
#xianyun add set="sodp" count=4;
#xianyun add set="no" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466;
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=132.32 atk%=0.3968 er=0.551 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 
  
# Rotation
active kaveh; # SS Stacks

for let i = 0; i < 4; i = i + 1 {
  if .amy.skill.ready && .amy.burst.ready {
    amy attack:1, skill;
  }
  
  nahida skill, attack;
  if .nahida.burst.ready && .nahida.energy == .nahida.energymax {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  xianyun skill, low_plunge, burst;
  
  if .fischl.burst.ready {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  
  kaveh skill, burst, attack;
  # Plunge Combo w/ skill as available
  while .kaveh.status.xianyun-airborne-buff {
    if .kaveh.skill.ready {
      kaveh skill;
    }
    kaveh jump;
    if .airborne {
      kaveh high_plunge[collision=rand()>0.5], dash;
    }
  }
  while !.kaveh.skill.ready {
    if .kaveh.normal > 4 {
      kaveh walk;
    } else {
      kaveh attack;
    }
  }
  kaveh skill;
}

