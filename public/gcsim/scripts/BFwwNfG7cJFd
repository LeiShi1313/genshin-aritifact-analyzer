# Razor Nahida Fischl Escoffier. ~21s Rotation. Razor Hybrid Aggravate, leans toward Phys. Nahida's uses burst only when ready after the first rotation. Fischl uses both skill and burst in the first rot, then alternates afterward. Escoffier bursts every other rotation.

# Team- Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#razor add set="echoes" count=4;
razor add set="pf" count=4; 
#razor add set="gd" count=4;
#razor add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
#razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # APC; Echoes
razor add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main 
razor add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # AAC; PF
#razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ADC; PF
#razor add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
#razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # EDC; Not Rec

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="tom" count=4;
#nahida add set="gt" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.331 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

escoffier char lvl=90/90 cons=0 talent=9,9,9; 
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1653 em=39.64 cr=0.3641 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active razor; # SS Stacks
#razor skill, dash; # Not nessesary for energy

for let i=0; i<4; i=i+1 {
  if i == 0 {
    amy attack, skill;
  }
  
  nahida skill, attack;
  if i > 0 && .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  esco skill;
  if .esco.burst.ready {
  esco burst;
  }
  
  if .amy.burst.ready {
    amy attack:2, burst;
  } else {
    amy attack:1, skill;
  }
  
  # Standard Rotation
  razor skill, dash, attack, burst;
  # Razor main DPS window 
  while .razor.mods.razor-q > 210 { # Just before 3rd skill is off CD
    if .razor.normal > 3 && .razor.skill.ready {
      razor skill, dash;
    } else if .razor.normal > 3 {
      razor dash;
    } else {
      razor attack;
    }
  }
  
  print("done");
}
