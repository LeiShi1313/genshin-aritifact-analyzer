# Cyno Nahida Fischl Thoma. ~24s Rot. Cyno Quickburn with UR, featuring Nahida and an EM build Thoma. Nahida skips Q on first rotation, then bursts as available.

# Team - Options listed by DPS
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="deathmatch" refine=1 lvl=90/90;
#cyno add weapon="fjords" refine=1 lvl=90/90;
cyno add set="ur" count=4;
cyno add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #mainstats
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="gt" count=4;
#nahida add set="deepwood" count=4;
#nahida add set="tom" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; #main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=118.92 cr=0.2648 cd=0.5296;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #mainstats
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

thoma char lvl=90/90 cons=6 talent=9,9,9;
thoma add weapon="moonpiercer" refine=5 lvl=90/90+params=[pickup_delay=270]; # to Cyno
thoma add set="scroll" count=4;
#thoma add set="deepwood" count=4;
#thoma add set="no" count=4;
thoma add stats hp=4780 atk=311 er=0.518 em=187 em=187 ; #main
thoma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3968 er=0.551 em=158.56 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 

# Rotation
active fischl;

for let i=0; i<4; i=i+1 { 
  fischl skill, attack;
  
  # Skip Q on  first rotation, then use as available 
  nahida skill, attack;
  if i > 0 && .nahida.burst.ready {
    nahida burst, charge;
  } else {
    nahida charge;
  }
  
  thoma skill, burst;
  
  fischl attack:2, burst;
  
  cyno skill, burst;
  while .fischl.skill.cd > 30 {
    if .cyno.mods.cyno-a1 && .cyno.skill.ready {
      cyno skill;
    } else if .cyno.normal == 4 && .stam > 20 {
      cyno dash;
    } else {
      cyno attack;
    }
  }

}

