# Jean Candace Yelan Furina. ~22s rotation. On field Hydro Jean. 2xE Yelan E.

# Options listed by DPS
jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="finaleofthedeep" refine=5 lvl=90/90;
#jean add weapon="wolffang" refine=1 lvl=90/90;
#jean add weapon="harbingerofdawn" refine=5 lvl=90/90;
#jean add weapon="blacksword" refine=1 lvl=90/90;
jean add set="vv" count=4;
jean add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cr=0.311; # w/ Finale
jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; #Hydro Goblet, CR Circlet
#jean add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
#jean add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; #Attack Goblet
#jean add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 cd=0.622; #main
#jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; #Hydro Goblet

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
#furina add weapon="harbinger" refine=5 lvl=90/90;
furina add set="goldentroupe" count=5;							
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=3 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

candace char lvl=90/90 cons=6 talent=9,9,9;
candace add weapon="favlance" refine=3 lvl=90/90;
candace add set="emblem" count=4;
#candace add set="no" count=4;
candace add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
candace add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst;
  
  jean skill, burst;
  
  yelan skill, burst, attack;

  candace skill, burst, attack;
  
  while !.yelan.skill.ready {
    if .jean.skill.ready {
      jean skill;
    } else {
      if .jean.normal > 3 {
        jean dash;
      } else {
        jean attack;
      }
    }
  } 
  
  yelan skill, attack;
  
  jean skill;
  jean attack:3, dash;
  jean attack:3, dash;
  jean attack:1;
  
  candace attack, skill;
  
  # Notation
  # Furina EDQ > Jean EQ > Yelan EQN1 > Candace EQN1 >
  # Jean E 3N3 N2 > Yelan EN1 > Jean E 2N3 N1 > Candace N1E
}

