# Yae Furina Fischl Xianyun. ~24s Rot. Yae Taser Plunge. Xianyun refeshes VV after Fischl uses burst. Yae may want to drop weaving N1 between plunges/skills to ensure she reaches 8 plunges per rotation. Yae uses bust skill immediately after all plunges spent when available(usually). 50% Collisons.

# Team
yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="flowingpurity" refine=5 lvl=90/90;
yae add set="mh" count=4;
yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
yae add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.3641 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="tom" count=4;
#furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.331;
#furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.3472 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.331; # GT

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=0]; # Leading party
#fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="hakushin" refine=5 lvl=90/90;
#xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=82.7 atk%=0.2976 er=0.4959 em=158.56 cr=0.0662 cd=0.1324;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active fischl;

for let x=0; x<4; x=x+1 {
  fischl attack, skill;

  furina skill, dash, burst;

  yae skill:3;

  xianyun skill, low_plunge, burst;

  for let i=0;i<3;i=i+1 {
  #while .fischl.oz {
    if .xianyun.status.xianyun-airborne-buff {
      yae jump;
      if .airborne {
        yae high_plunge[collision=rand()>0.5], attack;
      }
    } else if .yae.normal > 2 {
      yae dash;
    } else {
      yae attack;
    }
  }

  fischl attack:2, burst;

  yae attack, skill, attack, skill, attack, skill; # tight, drop attacks for more consistent 8 plunges

  xianyun attack:2; sleep(20); # for CD warning

  while .fischl.skill.cd > 30 {
  #while .fischl.oz {
    if .xianyun.status.xianyun-airborne-buff {
      yae jump;
      if .airborne {
        yae high_plunge[collision=rand()>0.5], dash;
      }
    } else if .yae.burst.ready {
      yae burst;
    } else if .yae.normal > 3 && .stam > 50 { # Ideally unused
      yae charge;
    } else if .yae.normal > 3 && .stam > 18 {
      yae dash;
    } else {
      yae attack;
    }
  }
}
