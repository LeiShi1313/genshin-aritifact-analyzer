options swap_delay=12 iteration=1000;

# Build assumptions
flins char lvl=90/90 cons=1 talent=9,9,9;
flins add weapon="bloodsoakedruins" refine=1 lvl=90/90;
flins add set="nightoftheskysunveiling" count=4;
flins add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

//flins char lvl=90/90 cons=1 talent=9,9,9;
//flins add weapon="deathmatch" refine=1 lvl=90/90;
//flins add set="nightoftheskysunveiling" count=4;
//flins add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
// Fav Aino
//flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.3306 em=39.64 cr=0.2648 cd=0.662;
// Aquamarine Aino
//flins add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.3857 em=39.64 cr=0.2648 cd=0.662;

ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ineffa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

aino char lvl=90/90 cons=6 talent=9,9,9;
aino add weapon="aquamarine" refine=1 lvl=90/90;
aino add set="silkenmoonsserenade" count=4;
aino add stats hp=4780 atk=311 er=0.518 em=187 em=187;
aino add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=158.56 cr=0.2648 cd=0.1324;

sucrose char lvl=90/90 cons=6 talent=9,9,9;
sucrose add weapon="evenstar" refine=1 lvl=90/90;
sucrose add set="vv" count=4;
sucrose add stats hp=4780 atk=311 em=187 em=187 em=187;
sucrose add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=118.92 cr=0.2317 cd=0.1986;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active ineffa;
for let i=0; i<6; i=i+1 {
  ineffa skill;
  if !is_even(i) {
    ineffa burst;
  } else {
    ineffa attack;
  }
  aino skill, burst;
  if .sucrose.burst.ready {
    sucrose burst;
  } else {
    sucrose swap; wait(6);  # Hide swap cd warning
  }
  sucrose skill, dash, attack;
  flins skill, attack, skill, burst, attack:4, dash, attack:2, skill, attack, burst, attack:4, dash, attack:2, skill, attack, burst, attack;
  # Go back to Sucrose to Refresh 4pc VV
  if i==1 {
    sucrose skill, dash, attack;
  } else {
    sucrose attack, charge;
  }
}
