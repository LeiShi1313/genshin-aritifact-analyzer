# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Sethos combo also works with DPC
fn sethosCombo() {
  if .sethos.skill.ready {
    sethos skill;
  }
  sethos burst;
  while .sethos.mods.sethos-burst {
    if .sethos.normal > 2 {
      sethos walk;
    } else {
      sethos attack;
    }
  }
}

# Rotation
active fischl;
fischl skill;

for let i=0; i<4; i=i+1 {
  nahida skill, attack;
  if i > 0 && .nahida.burst.ready {
    nahida burst;
  } else {
    nahida charge;
  }
  
  sara skill, burst;
	
  amy attack;
  if .amy.burst.ready {
    amy attack, burst;
  } else {
    amy skill;
  }
	
  sara aim;
  
  sethosCombo();
  sethos skill;
  sethos aim[hold=2]:2;
  
  nahida attack:1, charge, dash;
  nahida attack:1, charge, dash;
  nahida attack:1, charge, dash;
  
  print("done");
}
