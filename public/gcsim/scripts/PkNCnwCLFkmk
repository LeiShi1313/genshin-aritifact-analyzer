# Gaming Furina Nicole Mona. ~20s Rot. Gaming Hex Vaporize. Gaming does Q7EP with a grounded delay before every skill, intended to catch Man Chai while descending. Mona has 2 Field times. Near 100% Vape consistency.

# Team
gaming char lvl=90/90 cons=6 talent=9,9,9;
gaming add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
gaming add set="cw" count=4;
#gaming add set="vh" count=4;
gaming add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622 ; #main
gaming add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*10 cd=0.0662*10;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
furina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*3 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

nicole char lvl=90/90 cons=0 talent=9,9,9;
nicole add weapon="oathsworn" refine=5 lvl=90/90;
nicole add set="no" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
nicole add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*4 em=19.82*9 cr=0.0331*9 cd=0.0662*2;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="pamber" refine=5 lvl=90/90;
mona add set="cg" count=4;
mona add stats hp=4780 atk=311 atk%=0.466 hydro%=0.466 heal=0.359; #main
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*12;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active gaming; # SS stacks

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;

  mona burst, attack;

  nicole skill, burst;

  mona attack, skill, attack;

  gaming burst;
  for let j = 0; j < 7; j = j + 1 {
    sleep(45);
    gaming skill, high_plunge;
  }
}
