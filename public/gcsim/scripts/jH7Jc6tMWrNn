xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="ins" count=4;
xilonen add stats hp=3571 atk=232 def%=0.43725 def%=0.43725 cr=0.311;
xilonen add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.27804 cd=0.333648;

options swap_delay=12 iteration=1000;

active mavuika;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; 
energy every interval=480,720 amount=1;

fn mualani_combo() {
  #doing 3[3-stacked bite]
  while .mualani.nightsoul.state {
    for let k=0; k<3; k=k+1 {
      while .mualani.momentum < 3 {
        mualani walk[f=1];
      }
      mualani attack;
    }
    break;
  }
}

mualani attack:2;
for let i=0; i<4; i=i+1 {
  if is_even(i) {
    mavuika burst, charge, dash, skill;
    emilie skill, attack;
  } else {
    mavuika skill, attack;
    emilie burst;
  }
  xilonen skill, attack:2;
  mualani skill;
  mualani_combo();
  if is_even(i) {
    mualani burst;
    xilonen burst;
  }
}

# Mavuika Q CD E > Emilie E > Xilonen E N2 > Mualani E 3[3-stacked bite] Q > Xilonen Q >
# Mavuika      E > Emilie Q > Xilonen E N2 > Mualani E 3[3-stacked bite]   >
