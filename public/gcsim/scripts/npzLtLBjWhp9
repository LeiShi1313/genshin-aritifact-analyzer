  while .furina.skill.cd > 10 {
    furina attack;
  }
  furina skill, dash, burst;

  xilonen skill, attack:2;
  pick_up_crystallize("any");

  sigewinne skill, dash[pickup_droplets=2];
  
  navia burst, dash, skill, attack:2, dash, attack:2, dash, attack:3;

  xilonen skill, attack:2;
  pick_up_crystallize("any");

  navia skill, attack:2, dash, attack:2, dash, attack:2;
  if i == 0 || i == 3 {
    navia skill, attack;
  }
}