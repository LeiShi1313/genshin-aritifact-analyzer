# Chongyun Xiangling Mavuika Xianyun. ~20s Rot. Chongyun double Pyro Melt Plunge. Mavuika passes particles to Xiangling. 50% Collisions. Not heavily optimized.

# Team - Options Listed by DPS
chongyun char lvl=90/90 cons=0 talent=9,9,9;
chongyun add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#chongyun add weapon="fruitfulhook" refine=1 lvl=90/90;
chongyun add set="lno" count=4;
#chongyun add set="lw" count=4;
chongyun add stats hp=4780 atk=311 em=187 cryo%=0.466 cd=0.622; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favlance" refine=3 lvl=90/90;
xiangling add set="emblem" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.331 cd=0.662;

mav char lvl=90/90 cons=0 talent=9,9,9;
mav add weapon="tidalshadow" refine=5 lvl=90/90;
mav add set="scroll" count=4;
#mav add set="oc" count=4;
#mav add set="gt" count=4;
mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;
#mav add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#mav add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.3972 cd=0.5958; # OC

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active chongyun; # SS Stacks
chongyun burst;

for let i = 0; i < 4; i = i + 1 {
  xianyun skill, low_plunge, burst; 
  
  if .chongyun.burst.ready {
    chongyun burst;
  }
  
  if .mav.burst.ready && i > 0 {
    mav burst, skill, dash;
  } else if .mav.skill.ready {
    mav skill, dash;
  }
  
  xl burst, skill, dash;
 
  chongyun skill;
  # Plunge until expiry
  while .chongyun.status.xianyun-airborne-buff {
    chongyun jump;
    if .airborne {
      chongyun high_plunge[collision=rand()>0.5];
    }
    if .chongyun.status.xianyun-airborne-buff { # no dash for final plunge
      chongyun dash;
    }
  }

  xl attack:4, dash, attack:2;
}

