# Hutao Chevreuse Fischl Bennett. ~17s Rot. Hutao Chevreuse Fischl Bennett. Hu Tao overload with Chevreuse. Hutao E N3CJ 5N2CJ N3C(JQ/JN3CJ). Hutao bursts if available.

# Team
hutao char lvl=90/90 cons=0 talent=9,9,9;
hutao add weapon="deathmatch" refine=1 lvl=90/90;
hutao add set="mh" count=4;
#hutao add set="sr" count=4;
hutao add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 cd=0.622; #main
hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.4464 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.2317 cd=0.662; # MH
#hutao add stats hp=4780 atk=311 hp%=0.466 pyro%=0.466 cd=0.622; #main
#hutao add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # SR

chevreuse char lvl=90/90 cons=6 talent=9,9,9; 
chevreuse add weapon="favlance" refine=3 lvl=90/90;
chevreuse add set="emblem" count=4;
chevreuse add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
chevreuse add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="songofstillness" refine=5 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3857 em=39.64 cr=0.2317 cd=0.7944;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.0 hp=100000000;

# Rotation
active fischl;
fischl aim;

for let i=0; i<4; i=i+1 {
  bennett skill, burst;

  chev burst, skill[hold=1]:2;
  
  fischl attack;
  if .fischl.skill.ready {
    fischl skill;
  } else {
    fischl attack, burst;
  }
  
  hutao skill,
    attack:3, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge, jump,
    attack:2, charge;
  if .hutao.burst.ready {
    hutao burst;
  } else {
    hutao jump, attack:3, charge, jump;
  }
}

