options swap_delay=12 iteration=1000;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="thecatch" refine=5 lvl=90/90;
xiangling add set="emblemofseveredfate" count=5;
xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.33 cd=0.7944;

kuki char lvl=90/90 cons=6 talent=9,9,9 start_hp=1;
kuki add weapon="ironsting" refine=5 lvl=90/90;
kuki add set="gildeddreams" count=4;
kuki add stats hp=4780 atk=311 em=561 ; #main
kuki add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favoniussword" refine=3 lvl=90/90;
kazuha add set="viridescentvenerer" count=5;
kazuha add stats hp=4780 atk=311 em=561; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesseoblige" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=999999999;
target lvl=100 resist=0.1 radius=1 pos=3,1.4 hp=999999999;
energy every interval=480,720 amount=1;

active kuki;
for let i=0; i<4; i=i+1 {
   kuki skill;
   bennett burst;
   bennett skill;
   kazuha skill,high_plunge,burst;
   if .xiangling.burst.cd < 90
   {
     xiangling burst;
   }
   else
   {
     xiangling attack:2;
   }

   xiangling skill;
   bennett attack:2,skill;
   if .xiangling.burst.cd < 90
   {
     xiangling burst;
   }
   else
   {
     xiangling attack:3;
   }

   kazuha attack,skill,high_plunge;
   bennett attack:2,skill;
   xiangling attack:2;
}
