# Sethos Durin Fischl Kirara. ~18s Rot. KQMS KurtC. Sethos Quickburn sustained by Kirara C6. Sethos uses burst followed by 2 fully charged aimed shots. Full EM Durin with Xiphos is only very slightly behind. Kirara builds full HP.

# Team
sethos char lvl=90/90 cons=6 talent=9,9,9;
sethos add weapon="slingshot" refine=5 lvl=90/90;
sethos add set="gd" count=4;
#sethos add set="wt" count=4;
sethos add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
sethos add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="lionsroar" refine=3 lvl=90/90;
#durin add weapon="xiphos" refine=1 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*9 em=19.82*2 cr=0.0331*8 cd=0.0662*6; # LR
#durin add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*5 em=19.82*2 cr=0.0331*9 cd=0.0662*2; # Xiphos

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="sapwood" refine=5 lvl=90/90+params=[pickup_delay=215]; # During 1st Sethos walk
kirara add set="ins" count=4;
kirara add stats hp=3571 atk=232 hp%=0.466 hp%=0.3495 hp%=0.3495; #main
kirara add stats def%=0.05208*2 def=16.5312*2 hp=213.31*2 hp%=0.041664*2 atk=13.8936*2 atk%=0.041664*2 er=0.046284*2 em=16.6488*12 cr=0.027804*4 cd=0.055608*2;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=-1.2,1.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=1 pos=1.2,1.4 hp=100000000; # Rear

active durin;

for let i=0; i<4; i=i+1 {
  durin skill:2, burst;

  if is_even(i) {
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }

  kirara skill[short_hold=1];

  sethos skill, burst,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         skill;

  sethos aim[hold=2]:2;

  if .kirara.burst.ready {
    kirara burst;
  }
}
