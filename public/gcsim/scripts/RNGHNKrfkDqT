#bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; #ATK/CR
bennett add stats hp=4780 atk=311 em=187 em=187 em=187; #main
bennett add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296; #3EM

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="deathmatch" refine=1 lvl=90/90;
chev add set="gt" count=4;
#chev add set="emblem" count=4;
chev add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622; #main
chev add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
#fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="stillness" refine=5 lvl=90/90;
#fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=5;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # VH
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#fischl add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Others

lisa char lvl=90/90 cons=6 talent=9,9,9;
lisa add weapon="widsith" refine=3 lvl=90/90;
#lisa add weapon="flowingpurity" refine=5 lvl=90/90;
#lisa add weapon="hakushin" refine=5 lvl=90/90;
#lisa add weapon="ttds" refine=5 lvl=90/90;
lisa add set="scroll" count=4;
lisa add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
lisa add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active lisa;
lisa attack; # Chev A1

for let i=0; i<4; i=i+1 {
  bennett burst, skill;
  
  chevreuse burst, skill[hold=1]:3; # 3 is always ideal
  
  if .lisa.burst.ready {
    lisa burst;
  }
  
  if .fischl.skill.ready {
    fischl attack:1, skill;
  } else {
    fischl attack:2, burst;
  }
  
  bennett skill, attack;
  while !.bennett.burst.ready {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  
  print("done");
}


