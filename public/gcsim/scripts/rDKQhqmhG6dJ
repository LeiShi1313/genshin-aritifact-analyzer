clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; # main
clorinde add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=39.64 er=0.2204 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; # main
fischl add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=79.28 er=0.1102 cr=0.331 cd=0.7944;

heizou char lvl=90/90 cons=6 talent=9,9,9;
heizou add weapon="hakushin" refine=5 lvl=90/90;
heizou add set="vv" count=4;
heizou add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; # main
heizou add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="evenstar" refine=1 lvl=90/90;
nahida add set="totm" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; # main
nahida add stats hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 def=39.36 def%=0.124 em=118.92 er=0.1102 cr=0.2979 cd=0.7282;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active fischl;

fischl burst;
heizou skill;
nahida skill, attack;
clorinde_combo();
heizou attack; # swirl refresh VV and hakushin ring
clorinde burst;

for let r=0; r<4; r=r+1 { # 4 rotations

  nahida skill;
  if .fischl.burst.ready { # fischl burst every other rotation
    fischl attack:2, burst;
  } else {
    fischl attack, skill, attack;
  }
  heizou attack, charge, skill;
  clorinde_combo();
  heizou attack; # swirl refresh VV and hakushin ring
  clorinde burst;

}
