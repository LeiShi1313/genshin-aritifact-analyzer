#keqing 48 cost with lvl 100 all characters and 30 fluid subs

keq char lvl=100/100 cons=6 talent=10,10,10;
keq add weapon="mist" refine=5 lvl=90/90;
keq add set="no" count=4;
keq add stats hp=4780 atk=311 atk%=.466 electro%=0.466 cr=0.311; #main
keq add stats def%=0.062*1 def=19.68*1 hp=253.94*1 hp%=0.0496*1 atk=16.54*1 atk%=0.0496*6 er=0.0551*1 em=19.82*1 cr=0.0331*12 cd=0.0662*15;

xilo char lvl=100/100 cons=6 talent=10,10,10;
xilo add weapon="pps" refine=5 lvl=90/90;
xilo add set="sothocc" count=4;
xilo add stats hp=4780 atk=311 def%=0.583 def%=0.583 def%=0.583; #main
xilo add stats def%=0.062*6 def=19.68*1 hp=253.94*1 hp%=0.0496*1 atk=16.54*1 atk%=0.0496*1 er=0.0551*1 em=19.82*1 cr=0.0331*15 cd=0.0662*12;

nicole char lvl=100/100 cons=6 talent=10,10,10;
nicole add weapon="angelos" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
nicole add stats def%=0.062*1 def=19.68*1 hp=253.94*1 hp%=0.0496*1 atk=16.54*12 atk%=0.0496*6 er=0.0551*1 em=19.82*1 cr=0.0331*12 cd=0.0662*6;

durin char lvl=100/100 cons=6 talent=10,10,10;
durin add weapon="athame" refine=5 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*1 def=19.68*1 hp=253.94*1 hp%=0.0496*1 atk=16.54*1 atk%=0.0496*8 er=0.0551*1 em=19.82*1 cr=0.0331*13 cd=0.0662*12;


options iteration=10000 swap_delay=12;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=21370000000;

active nicole;
for let i = 0; i < 6; i = i + 1 { # 6 rotations
  nicole skill; wait(18);
  durin skill:2, burst;
  xilo skill, attack:2;
  keq skill, burst, skill,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge;
  xilo skill, attack:2;
  keq skill, burst, skill,
      attack, charge,
      attack, charge,
      attack, charge;
}
