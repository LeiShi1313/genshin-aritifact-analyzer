options swap_delay=12 iteration=100;
target lvl=100 resist=.1 radius=3 pos=0,3.4 hp=999999999999;
energy every interval=480,720 amount=1;

active mona;

mona skill;

for let i = 0; i < 4; i = i + 1 {
  nicole attack, skill, attack;
  durin skill:2, burst;
  neuv skill, charge[ticks=2], jump;
  mona burst, attack;
  nicole burst, attack;
  mona charge;
  mona charge; delay(13);
  mona charge; delay(15);
  mona charge; delay(15);
  mona charge, skill, attack;

}
