bennett add stats hp=4780 atk=311 em=187 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2317 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active gaming;
for let r=0; r<4; r=r+1{
  xingqiu skill, dash, burst, attack;
  furina skill, dash, attack, burst;
  bennett attack, burst, skill, attack;
  gaming burst, attack:2;
  for let i=0; i<6; i=i+1 {
    gaming skill, low_plunge, attack;
  }
  gaming skill, high_plunge, dash;
}

