navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="nighttimewhispers" count=4;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cd=0.622; #main
navia add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*4 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

aethergeo char lvl=90/90 cons=6 talent=9,9,9;
aethergeo add weapon="favoniussword" refine=3 lvl=90/90;
aethergeo add set="scroll" count=4;
aethergeo add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; #main
aethergeo add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*6 cd=0.0662*10;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
fischl add set="goldentroupe" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

options swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active navia; # SS Stacks

for let i=0; i<4; i=i+1 {
  navia burst;
  bennett skill, burst;
  fischl attack;
  if .fischl.burst.ready {
    fischl attack, burst; pick_up_crystallize("any");
  } else {
    fischl skill;
  }
  aethergeo burst, skill[short_hold=1];
  navia skill[hold=1], attack:3, dash, attack:2;
  bennett skill, dash; pick_up_crystallize("any");
  aethergeo skill[short_hold=1], dash; pick_up_crystallize("any");
  navia skill[hold=1], attack;
}