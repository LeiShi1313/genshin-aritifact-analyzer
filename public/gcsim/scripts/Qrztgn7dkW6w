furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="wanderingevenstar" refine=1 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187; # main
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=118.92 cr=0.2979 cd=0.662;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active fischl;
for let i=0; i<4; i=i+1 {

  if i == 0 {
    fischl burst;
  } else {
    fischl attack:2, burst;
  }

  nahida skill, attack, charge, burst;
  furina skill, dash, burst;
  nahida skill, attack, charge;
  dori skill, attack:2, dash, attack:2, burst;

  fischl attack, skill, dash;

  dori skill, attack:2, dash, attack:2;
  nahida skill, attack, charge;
  dori skill, attack:2, dash, attack:2;

  print("rotation done");
}
