options iteration=1000 swap_delay=12;

ganyu char lvl=90/90 cons=0 talent=9,9,9;
ganyu add weapon="chainbreaker" refine=5 lvl=90/90;
ganyu add set="wt" count=4;
ganyu add stats hp=4780 atk=311 em=187 cryo%=0.466 cr=0.311; #main
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.331 cd=0.7944;

jean char lvl=90/90 cons=0 talent=9,9,9;
jean add weapon="favsword" refine=3 lvl=90/90;
jean add set="vv" count=4;
jean add stats hp=4780 atk=311 em=187 em=187 cr=0.311; #main
jean add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=158.56 cr=0.331 cd=0.4634;

xilonen char lvl=90/90 cons=0 talent=9,9,9;
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311;
xilonen add stats def%=0.31 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7282;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="ap" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=99.1 cr=0.2979 cd=0.7944;

options swap_delay=12;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active ganyu;
for let r = 0; r < 5; r = r + 1 {
  ganyu skill, burst;
  xilonen skill, attack:2;
  while .xilonen.weapon == .keys.weapon.favsword && .xilonen.mods.favonius-cd == 0 {
    xilonen attack;
  }
  bennett skill, burst, dash;
  pick_up_crystallize("cryo");
  jean skill, burst;
  while .jean.weapon == .keys.weapon.favsword && .jean.mods.favonius-cd == 0 {
    jean attack;
  }
  ganyu aim:1, skill, aim:4;
  xilonen skill, attack:2;
  while .xilonen.weapon == .keys.weapon.favsword && .xilonen.mods.favonius-cd == 0 {
    xilonen attack;
  }
  bennett skill, dash;
  jean skill;
  while .jean.weapon == .keys.weapon.favsword && .jean.mods.favonius-cd == 0 {
    jean attack;
  }
}
