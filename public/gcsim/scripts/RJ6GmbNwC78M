# Keqing Furina Rosaria Xianyun. ~20s Rot. Keqing Phys Plunge. Keqing does not burst and uses EN1C off cd. LNO>MH>PF Keqing. Hold skill aerial plunge not implemented. 50% Collisions.

# Team - Options ordered by DPS
keqing char lvl=90/90 cons=0 talent=9,9,9;
keqing add weapon="harbinger" refine=5 lvl=90/90;
#keqing add weapon="rancour" refine=5 lvl=90/90;
