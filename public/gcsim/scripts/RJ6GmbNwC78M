xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466 ; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=165.4 atk%=0.3968 er=0.4408 em=39.64 cr=0.0662 cd=0.1324;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Keqing Plunge Combo
fn KeqingPlunge() {
  keqing jump;
  if .airborne {
    keqing high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active furina;

for let x = 0; x < 4; x = x + 1 {
  furina skill, dash;
  if .furina.weapon == .keys.weapon.favsword && (!.furina.mods.favonius-cd || !.furina.burst.ready) {
    furina attack;
  }
  furina burst;
  
  xianyun skill, low_plunge, burst;
  
  rosaria skill, burst;
  
  # Gain buffs/SC
  keq skill;
  keqing attack, charge;
  # Plunge
  while .keqing.status.xianyun-airborne-buff {
    if .previous-action == .action.skill {
      keqing attack, charge;
    } else {
      KeqingPlunge();
      if .keqing.skill.ready {
        keqing skill;
      } else if !.keqing.status.xianyun-airborne-buff { # Xianyun-q expiration
        rosaria swap;
      } else {
        keqing dash;
      }
    }
  }
  
  rosaria skill;
  print("done");
}

