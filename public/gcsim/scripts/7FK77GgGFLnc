#rotation
active furina;

for let i = 0; i < 4; i = i + 1 {
  furina skill, dash, burst;
  escoffier skill, burst;
  ayato skill, attack:15, burst;
  citlali skill, burst, attack;
  ayato attack, skill, attack:15;
}

