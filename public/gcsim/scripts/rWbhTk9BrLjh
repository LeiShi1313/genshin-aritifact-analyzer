options swap_delay=1 iteration=1000 ignore_burst_energy=false;
target lvl=100 hp=99999999 resist=0.1 radius=1 pos=0,1.5 particle_threshold=520000 particle_drop_count=3;
#target lvl=100 hp=99999999 resist=0.1 radius=2 pos=0,2.5 particle_threshold=520000 particle_drop_count=3;

active kirara;
let shieldEarlier = true; #set to false for different rotation order around kirara shield (see notes below)

fn doActionList() {
  
  #Base: Kirara [E/short hE] > Sara E CA > Fischl N1 E > Sara Q > Alhaitham hE LP N2CD N3C > Kirara E Q > Sara E > Fischl N2 Q > Alhaitham Q > Sara CA > Alhaitham N4CD N4CD N3
  for let r=0; r<3; r=r+1 {
    kirara skill[short_hold=r>0]; #tap on 1st rotation, short hold later
    sara skill, aim;
    fischl attack, skill;
    sara burst; #6 Stormcluster hits per burst with radius=1, 12 with radius=2 (can be further played around with)
    alhaitham skill[hold=1], low_plunge[short=rand()<1/3], #1/3 chance to successfully short plunge
              attack:2, charge, dash,
              attack:3, charge;
    if shieldEarlier == true {
      kirara skill, burst; #Shield stacks, but expires ~2-3s before Alhaitham's 2nd combo is over. May have slightly lower dps (100ish?)
    }
    sara skill;
    fischl attack:2, burst;
    if shieldEarlier == false {
      kirara skill, burst; #Shield basically fully covers Alhaitham's 2nd combo, but doesn't stack, and doesn't cover Fischl's part immediately before this.
    }
    alhaitham burst;
    sara aim;
    alhaitham attack:4, charge, dash,
              attack:4, charge, dash,
              attack:3;
  }
}

#Random action delays, and implied attacks while an attempted burst is not ready
fn randy(mean, standardDeviation, min, max, display) {
  let value = randnorm() * standardDeviation + mean;
  if value > max {
    value = max;
  } else if value < min {
    value = min;
  }
  if display {
    print(value);
  }
  return value;
}

let prev_char_id = -1;
switch {
  case .alhaitham.onfield:
    prev_char_id = .keys.char.alhaitham;
  case .sara.onfield:
    prev_char_id = .keys.char.sara;
  case .fischl.onfield:
    prev_char_id = .keys.char.fischl;
  default:
    prev_char_id = .keys.char.kirara;
} #this switch statement prevents "swap delay" from being added at the start of each iteration when the first action is not actually a swap
let prev_action_id = -1;

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {

  if prev_char_id != char_id && action_id != .action.swap {
    execute_action(char_id, .action.swap, []);
  }
  
  if action_id == .action.burst {
    while .alhaitham.onfield && !.alhaitham.burst.ready {
      alhaitham attack;
    }
    while .sara.onfield && !.sara.burst.ready {
      sara attack;
    }
    while .fischl.onfield && !.fischl.burst.ready {
      fischl attack;
    }
    while .kirara.onfield && !.kirara.burst.ready {
      kirara attack;
    }
  }

  if action_id == .action.swap {
    delay(randy(9.5, 1.5, 8, 17, 0)); #SWAP DELAY (frames, including 1f base): mean 10.5 stddev 1.5, bounds: 9-18f
                                                     #corresponding ping (ms): mean 87.5 stddev 12.5, bounds: 75-150ms
    
  } else if prev_action_id == .action.attack && action_id != .action.attack && action_id != .action.charge {
    delay(randy(3, 1, 0, 6, 0)); #NA DELAY (except if next action is NA/CA): mean 3 stddev 1, bounds: 0-6f
    
  } else if prev_action_id != .action.attack {
    delay(randy(3, 1, 0, 6, 0)); #OTHER ACTION DELAY: mean 3 stddev 1, bounds: 0-6f
  }

  prev_char_id = char_id;
  prev_action_id = action_id;
  return _execute_action(char_id, action_id, p);
}

doActionList();