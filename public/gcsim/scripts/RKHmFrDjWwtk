# Ningguang Fischl Bennett Chiori. ~18s Rot. Ninguang does N1 ED N2C Q ED N3C N1C (N1C), rotation is reasonable on stamina even when opponent is not point blank. Bennett wants fav to meet ER reqs here.

# Team - Options listed by DPS
ningguang char lvl=90/90 cons=6 talent=9,9,9;
ningguang add weapon="widsith" refine=3 lvl=90/90;
ningguang add set="nighttime" count=4;
ningguang add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311;
ningguang add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="alleyhunter" refine=1 lvl=90/90 +params=[stacks=10];
#fischl add weapon="vhunt" refine=1 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944; # AH
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
#fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; # VH

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbinger" refine=5 lvl=90/90;
chiori add set="husk" count=4 +params=[stacks=4];
#chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.622;
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favsword" refine=3 lvl=90/90; # Better than doing more E with a Sapwood/AF
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Pick up Crystallize actions
let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash || ( char_id == .keys.char.fischl && action_id == .action.burst ) || ( char_id == .keys.char.chiori && action_id == .action.skill ) || ( char_id == .keys.char.ningguang && action_id == .action.walk ) {
    pick_up_crystallize("any"); # Pick up crystallize before every dash, and mavuika CA, and chiori skill
  }

  return _execute_action(char_id, action_id, p);
}

#Rotation
active chiori; # SS Stacks

for let i = 0; i < 4; i = i + 1 {
  chiori skill:2;
  
  bennett skill, burst;
  
  if .fischl.skill.ready{
    fischl attack, skill;
  } else {
    fischl attack:2, burst;
  }
  
  ningguang attack, skill, dash, 
            attack, walk, 
            attack, 
            charge;
  ningguang burst, skill, dash, 
            charge,
            attack, walk, 
            attack, walk, 
            attack, 
            charge,
            attack,
            charge; 
            
  if .chiori.burst.ready {
    chiori burst;
  } else {
    ningguang attack, charge;
  }
  
}
