wanderer char lvl=90/90 cons=0 talent=9,9,9;
wanderer add weapon="thewidsith" refine=3 lvl=90/90;
wanderer add set="dpc" count=4;
wanderer add stats hp=4780 atk=311 atk%=0.466 cr=0.311 anemo%=0.466 ; #main
wanderer add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="favbow" refine=3 lvl=90/90;
faruzan add set="noblesse" count=4;
faruzan add stats hp=4780 atk=311 er=0.518 anemo%=0.466 cr=0.311 ; #main
faruzan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favoniuslance" lvl=90/90 refine=3;
zhongli add set="totm" count=5;
zhongli add stats hp=4780 atk=311 hp%=0.466 geo%=0.466 cr=0.311; #main
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add set="husk" count=4;
chiori add weapon="harbingerofdawn" refine=5 lvl=90/90;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
chiori add stats hp=507.88 atk=33.07 def=39.35 hp%=0.0991 atk%=0.0991 def%=0.4956 em=39.63 er=0.1101 cr=0.23135 cd=0.72655;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 hp=1000000000 pos=0,2.4 radius=2;
energy every interval=480,720 amount=1;

active zhongli;

for let i = 0; i < 4; i = i + 1 {
  zhongli skill[hold=1];
  while !.zhongli.mods.favonius-cd {
    zhongli attack;
  }
  while !.faruzan.mods.favonius-cd && !.faruzan.burst.ready {
    faruzan attack;
  }
  faruzan burst;
  if .chiori.burst.ready {
    chiori burst;
  }
  chiori skill:2;
  wanderer charge, skill;
  while .wanderer.skydweller-points > 3 {
    switch {
      case .wanderer.normal < 3:
        wanderer attack;
      case .wanderer.mods.wanderer-a4:
        wanderer dash;
      default:
        wanderer charge;
    }
  }
  if .wanderer.burst.ready {
    wanderer burst;
  } else {
    wanderer skill;
  }
}
