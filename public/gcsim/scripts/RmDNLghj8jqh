
options swap_delay=12 iteration=1000;

# Build assumptions
ayaka char lvl=90/90 cons=6 talent=10,10,10;
ayaka add weapon="mistsplitterreforged" refine=5 lvl=90/90;
ayaka add set="mh" count=4;
ayaka add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
ayaka add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958;

citlali char lvl=90/90 cons=6 talent=10,10,10; 
citlali add weapon="starcallerswatch" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 em=187 em=187 em=187;
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

furina char lvl=90/90 cons=6 talent=10,10,10; 
furina add weapon="splendoroftranquilwaters" refine=5 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311;
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1488 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.1655 cd=0.7944;

escoffier char lvl=90/90 cons=6 talent=10,10,10;
escoffier add weapon="symphonistofscents" refine=5 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active furina;

for let i=0; i<4; i=i+1 {
  furina skill, dash, burst, attack;
  citlali skill, attack;
  ayaka dash, attack;
  escoffier burst, skill;
  ayaka skill, dash, attack, burst,
        attack, charge, dash,
        attack:2, charge,
        attack:2, charge;
  ayaka skill, dash, attack:3, charge;
        
}

