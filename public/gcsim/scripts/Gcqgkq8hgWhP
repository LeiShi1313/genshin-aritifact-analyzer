# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=1 pos=0,1.4 hp=100000000; # Front
#target lvl=100 resist=0.1 radius=1 pos=0,3.5 hp=100000000; # Rear

# Combos
fn sethosCombo() {
  sethos burst;
  sethos attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, walk,
         attack:2, skill;
}

# Rotation
active nahida;
nahida skill;

for let i=0; i<4; i=i+1 {
  # Skip Q on  first rotation, then use as available
  if !is_even(i) {
    nahida skill, attack, burst, charge;
  } else if i > 0 {
    nahida skill, attack:2, charge;
  }

  kuki skill, attack;
  if i > 0 && .kuki.burst.ready  {
    kuki burst;
  }

  if i > 0 && .mav.burst.ready {
    mav burst, skill;
    if i > 1 { # Fill time for sethos skill CD
      while .sethos.skill.cd {
        mav charge;
      }
      mav dash;
    }
  } else {
    mav skill, attack;
  }

  sethos skill; #aim[hold=2] # High ping only; dodges energy drain
  sethosCombo();
  sethos aim[hold=2]:1;
  sethos aim[hold=1]:1;
}
