# Sethos Nahida Mavuika Kuki. ~16 Rot. Sethos Quickburn. Mavuika, Kuki and Nahida burst every other rotation and fill time for Sethos skill CD. Full EM and Quicken Kuki result in similar overall DPS.

# Team- Options listed by DPS
sethos char lvl=90/90 cons=6 talent=9,9,9;
sethos add weapon="slingshot" refine=5 lvl=90/90;
sethos add set="wt" count=4;
#sethos add set="tf" count=4;
sethos add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
sethos add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.3972 cd=0.3972; # EEC
#sethos add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #main
