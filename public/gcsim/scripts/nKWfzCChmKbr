ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="deathmatch" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10;

aino char lvl=90/90 cons=6 talent=9,9,9;
aino add weapon="favgs" refine=5 lvl=90/90;
aino add set="no" count=4;
#aino add set="no" count=4;
aino add stats hp=4780 atk=311 em=187 hydro%=0.466 cr=0.311; #main
aino add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12;

# Options
target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999;
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=100;

# Rotation
active ineffa;

for let i=0; i<6; i=i+1 {

  if i==0 {
    ineffa skill;
  } else if .ineffa.burst.ready {
    ineffa skill, burst;
  } else {
    ineffa attack, skill;
  }

  yelan skill, burst, attack:2;

  aino skill, burst;

  hutao skill,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash,
  attack:2, charge, dash;
  if .hutao.burst.ready {
    hutao attack, burst;
  } else {
    tao attack:2, charge, dash;
  }
}
