options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active navia; ## SS Stacks
navia burst; # start with Navia Burst in the first rot
for let i=0; i<4; i=i+1 {
  furina skill, dash, attack, burst;
  xilonen skill, burst, attack:2;
  bennett skill, burst;
  if i {
    navia burst; # use Navia Burst here, except in the first rot
  }
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  if i == 0 || i == 3 {
    navia skill[hold=1], attack:2;
  }
}
