# --- Pre-action hook setup

let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
  pick_up_crystallize("any"); # Pick up crystallize before every dash
  }

  return _execute_action(char_id, action_id, p);
}

options swap_delay=12 iteration=1000;

# --- Team
navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="nighttimewhispers" count=5;
navia add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311 ; #main
navia add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

furina char lvl=90/90 cons=0 talent=9,9,9 ;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def=39.36 def%=0.124 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662 ;

sigewinne char lvl=90/90 cons=0 talent=9,9,9;
sigewinne add weapon="favoniuswarbow" refine=3 lvl=90/90;
sigewinne add set="ohc" count=4;
sigewinne add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
sigewinne add stats def=39.36 def%=0.124 hp=2031.52 hp%=0.3968 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.1324 ;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="cinnabarspindle" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311 ; # main
chiori add stats def%=0.248 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;


target lvl=100 resist=.1 hp=1000000000 radius=2 pos=0,2.4;
energy every interval=480,720 amount=1;

active navia;

for let x = 0; x < 5; x = x + 1 {
  navia burst;
  sigewinne attack:2,skill;
  furina burst,skill;
  chiori skill:2;
  navia skill[hold=1], attack:3, dash, attack:2;
  navia skill[hold=1], attack:3, dash, attack:2;
  if .chiori.burst.ready && (.chiori.energy == .chiori.energymax) {
    chiori burst;
  } else {
    chiori attack:2;
  }

  if .navia.skill.ready {
    navia skill[hold=1],attack:3,dash;
  }

  navia attack:3;
}
