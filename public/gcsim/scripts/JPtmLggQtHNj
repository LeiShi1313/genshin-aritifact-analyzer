# Razor Chevreuse Yae Durin. ~22s Rot. KQMS KurtC. Razor Overload. Razor does ~79% Electro DMG. Depsite the low Overload ownership, Evenstar Yae edges out Widsith. Chevreuse Doesn't burst past the 1st rotation.

# Team - Options listsed by DPS
razor char lvl=90/90 cons=6 talent=9,9,9;
razor add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
razor add set="risingwinds" count=4;
razor add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
razor add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*5 er=0.0551*2 em=19.82*2 cr=0.0331*11 cd=0.0662*10;

chev char lvl=90/90 cons=6 talent=9,9,9;
chev add weapon="favlance" refine=3 lvl=90/90;
chev add set="scroll" count=4;
#chev add set="sodp" count=4;
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
chev add stats def%=0.062*2 def=19.68*2 hp=253.94*8 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*2;

yae char lvl=90/90 cons=0 talent=9,9,9;
yae add weapon="evenstar" refine=1 lvl=90/90;
#yae add weapon="widsith" refine=3 lvl=90/90;
yae add set="totm" count=4;
#yae add set="gt" count=4;
yae add stats hp=4780 atk=311 em=187 em=187 em=187; #main
yae add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*12; # Support
#yae add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
#yae add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*10 cd=0.0662*12; # DPS

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="wolffang" refine=1 lvl=90/90;
durin add set="gift" count=4;
#durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # CG
#durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
#durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*3 er=0.0551*3 em=19.82*2 cr=0.0331*12 cd=0.0662*10; # RW

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,6.6 hp=100000000;

# Rotation
active razor; # SS stacks
#razor skill, dash; # Unnessesary

for let i=0; i<4; i=i+1 {
  yae skill:3;

  # Burst in 1st rot, Pass Fav proc to Bennett
  if i == 0 {
    chev burst, skill[hold=1]:1;
  } else {
    chev attack, skill[hold=1];
  }

  durin skill:2, burst;

  razor skill, dash, attack:1, burst;
  razor attack:0, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
  razor attack:3, dash;
  razor attack:3, dash;
  razor attack:3, skill, dash;
}
