# Raiden Tighnari Fischl Baizhu. ~20s Rot. Raiden Tighnari Quicken with Baizhu. Tighnari tries to use his skill & burst every rotation. Fischl uses burst every rotation and skill if available.

# Team
raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="emblem" count=4;
raiden add stats hp=4780 atk=311 er=0.518 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

tighnari char lvl=90/90 cons=0 talent=9,9,9;
tighnari add weapon="slingshot" refine=5 lvl=90/90;
#tighnari add weapon="ode" refine=5 lvl=90/90;
tighnari add set="deepwood" count=4;
#tighnari add set="scroll" count=4;
#tighnari add set="gd" count=4;
#tighnari add set="wt" count=4;
tighnari add stats hp=4780 atk=311 em=187 dendro%=0.466 cd=0.622;
tighnari add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 em=187 electro%=0.466 cr=0.311; #main
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # EM sands
#fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311 ; #main
#fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944; # Atk Sands

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="hakushin" refine=5 lvl=90/90;
baizhu add set="scroll" count=4;
#baizhu add set="ohc" count=4;
#baizhu add set="deepwood" count=4;
#baizhu add set="sodp" count=4;
baizhu add stats hp=4780 atk=311 er=0.518 hp%=0.466 hp%=0.466; #main
baizhu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1653 em=99.1 cr=0.3972 cd=0.5296;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active raiden;
raiden skill;

for let i=0; i<4; i=i+1 {
  baizhu skill, burst;

  if .amy.skill.ready {
    amy attack, skill;
  }

  while !.tighnari.skill.cd || .tighnari.mods.vijnanasuffusion {
    if .tighnari.skill.ready {
      tighnari skill;
    } else if .tighnari.burst.ready && .previous-action == .action.aim {
      tighnari burst;
    } else if .tighnari.mods.vijnanasuffusion {
      tighnari aim;
    }
  }

  amy attack:2, burst;

  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:4;

  while .baizhu.burst.cd > 40 {
    if .tighnari.skill.ready {
      tighnari skill;
    } else if .tighnari.burst.ready && .previous-action == .action.aim {
      tighnari burst;
    } else if .tighnari.mods.vijnanasuffusion {
      tighnari aim;
    } else if .amy.skill.ready {
      amy attack, skill;
    } else {
      baizhu attack;
    }
  }

}
