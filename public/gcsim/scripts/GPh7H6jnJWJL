#enemy config

options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;
active furina;

#action list

  for let i=0; i<4; i=i+1 {

  furina skill, dash, burst;
  bennett burst, attack, skill;
  if .fischl.burst.ready && .fischl.energy == .fischl.energy.max {
    fischl attack:2, burst;
  } else {
    fischl attack, skill;
  }
  kazuha burst, skill, high_plunge;
  bennett skill;
  while .bennett.burst.cd {
    if .bennett.skill.ready {
      bennett skill;
    } else {
      bennett attack;
    }
  }
  kaz skill, high_plunge;




  }
