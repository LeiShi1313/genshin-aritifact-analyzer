#Double carry Quicken: Alhaitham hE LP combo and 2-Mirror Burst, full Raiden combo (~25s rot). Low ER Raiden (energy not needed); ToTM is higher DPS than EoSF and the Shield Strength is useful. DMG Build Kirara. KurtC

raiden char lvl=90/90 cons=0 talent=9,9,9;
raiden add weapon="deathmatch" refine=1 lvl=90/90;
raiden add set="totm" count=4;
#raiden add set="eosf" count=4;
raiden add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
raiden add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662; #2 er, 10 cr, 8 cd

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="thestringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main (em sands slightly worse)
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; #2 atk%, 8 cr, 10 cd

kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="sapwood" refine=5 lvl=90/90 +params=[pickup_delay=360]; #leaf is typically picked up by alhaitham but timing is inconsistent
#kirara add weapon="harbingerofdawn" refine=5 lvl=90/90;
kirara add set="deepwood" count=4;
kirara add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cr=0.311; #main (dmg build)
kirara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; #2 atk%, 8 cr, 10 cd

#kirara add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main (shield build)
#kirara add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.7944; #10 cr, 10 cd

alhaitham char lvl=90/90 cons=0 talent=9,9,9;
alhaitham add weapon="harbingerofdawn" refine=5 lvl=90/90;
alhaitham add set="gd" count=4;
alhaitham add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311; #main
alhaitham add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.26 cr=0.331 cd=0.7944; #2 em, 8 cr, 10 cd

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999;
energy every interval=480,720 amount=1;

active raiden;

raiden skill;

#[Raiden E] > Kirara short hE N1 > Fischl N1 E > Alhaitham hE LP N1CD N3CD N3C Q > Kirara E Q > Fischl N2 Q > Raiden Q N4E N4D N4D N3
for let i=0; i<4; i=i+1 {
  kirara skill[short_hold=1], attack;
  fischl attack, skill;
  alhaitham skill[hold=1], low_plunge,
            attack:1, charge, dash,
            attack:3, charge, dash,
            attack:3, charge, burst;
  kirara skill, burst;
  fischl attack:2, burst;
  raiden burst, attack:4, skill, attack:4, dash, attack:4, dash, attack:3;
  print ("done");
}
