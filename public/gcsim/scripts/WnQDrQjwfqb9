# Kazuha Emilie Faruzan Bennett. ~19s Rot. Triple Anemo Quickswap with Fav Bennett. 3 Kazuha skills off CD with Faruzan aimed shots & Lanyan E in between. 1E Bennett. Not heavily optimized.

# Team - Options listed by DPS
kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="wolffang" refine=1 lvl=90/90;
#kazuha add weapon="finale" refine=5 lvl=90/90;
#kazuha add weapon="isshin" refine=5 lvl=90/90;
kazuha add set="lno" count=4;
kazuha add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cd=0.622; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.3972 cd=0.5958; # WF
#kazuha add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
#kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.331 cd=0.7282; # Finale

lanyan char lvl=90/90 cons=6 talent=9,9,9;
lanyan add weapon="sacfrags" refine=5 lvl=90/90;
#lanyan add weapon="widsith" refine=3 lvl=90/90;
lanyan add set="gt" count=4;
lanyan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
lanyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

faruzan char lvl=90/90 cons=6 talent=9,9,9;
faruzan add weapon="twilight" refine=5 lvl=90/90;
faruzan add set="gt" count=4;
faruzan add stats hp=4780 atk=311 atk%=0.466 anemo%=0.466 cr=0.311; #main
faruzan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="favsword" refine=3 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.331 cd=0.5296;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active bennett;

for let i = 0; i < 4; i = i + 1 {
  bennett skill, burst;

  faruzan skill, burst;

  kazuha skill, high_plunge[collision=1], burst;

  faruzan aim:2, skill;

  kazuha skill, high_plunge[collision=1];

  lanyan skill:2;

  faruzan aim:2, skill; # Bennett Q expiry

  kazuha skill, high_plunge[collision=1]; # Bennett catches particles to meet ER req

  lanyan skill:2;

  faruzan aim:1;
}
