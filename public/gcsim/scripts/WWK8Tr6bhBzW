#overload high invest

keq char lvl=100/100 cons=6 talent=10,10,10;
keq add weapon="mist" refine=5 lvl=90/90;
keq add set="risingwinds" count=4;
keq add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #main
keq add stats def%=0.062*1 def=19.68*1 hp=253.94*1 hp%=0.0496*1 atk=16.54*1 atk%=0.0496*6 er=0.0551*1 em=19.82*1 cr=0.0331*12 cd=0.0662*15;

durin char lvl=100/100 cons=6 talent=10,10,10;
durin add weapon="athame" refine=5 lvl=90/90;
durin add set="risingwinds" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
durin add stats def%=0.062*1 def=19.68*1 hp=253.94*1 hp%=0.0496*1 atk=16.54*1 atk%=0.0496*8 er=0.0551*1 em=19.82*1 cr=0.0331*13 cd=0.0662*12;

nicole char lvl=100/100 cons=6 talent=10,10,10;
nicole add weapon="heptades" refine=5 lvl=90/90;
nicole add set="cg" count=4;
nicole add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
nicole add stats def%=0.062*1 def=19.68*1 hp=253.94*1 hp%=0.0496*1 atk=16.54*1 atk%=0.0496*6 er=0.0551*7 em=19.82*1 cr=0.0331*13 cd=0.0662*7;

chev char lvl=100/100 cons=6 talent=10,10,10;
chev add weapon="symphonist" refine=5 lvl=90/90;
chev add set="no" count=4;
chev add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
chev add stats def%=0.062*1 def=19.68*1 hp=253.94*2 hp%=0.0496*9 atk=16.54*1 atk%=0.0496*1 er=0.0551*14 em=19.82*1 cr=0.0331*8 cd=0.0662*2;


options iteration=10000 swap_delay=12;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=21370000000;

active keq;

keq skill;

for let i=0; i<6; i=i+1 {
  nicole burst, skill;

  chev burst, skill[hold=1];

  durin burst, skill:2;

  keq skill, burst, skill,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      attack, charge,
      skill, skill,
      attack, charge,
      attack, charge,
      attack, charge;
}
