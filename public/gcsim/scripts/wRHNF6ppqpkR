options swap_delay=12 iteration=1000;

# Build assumptions
nilou char lvl=90/90 cons=0 talent=9,9,9;
nilou add weapon="thedockhandsassistant" refine=1 lvl=90/90;
nilou add set="totm" count=2;
nilou add set="vg" count=2;
nilou add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466;
nilou add stats def%=0.124 def=39.36 hp=2031.52 hp%=0.2976 atk=33.08 atk%=0.0992 er=0.1102 em=237.84 cr=0.0662 cd=0.1324;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="xiphos" refine=1 lvl=90/90;
xingqiu add set="fopl" count=4;
xingqiu add stats hp=4780 atk=311 em=187 em=187 em=187;
xingqiu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.551 em=118.92 cr=0.0662 cd=0.1324;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="blackmarrowlantern" refine=5 lvl=90/90;
lauma add set="sms" count=5;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187;
lauma add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="pamber" refine=5 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 em=187 em=187;
nahida add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3641 cd=0.7282;

# Target and Energy assumptions
//target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
target lvl=100 resist=0.1 radius=2 pos=0,3 hp=999999999;
target lvl=100 resist=0.1 radius=2 pos=3.2,0 hp=999999999;
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active nahida;
for let i=0; i<4; i=i+1 {
  nahida attack, skill;
  nilou skill, attack:2, skill;
  nahida burst;
  xingqiu skill, dash, burst;
  lauma attack, skill[hold=1], burst;

  lauma attack:3, dash;
  lauma attack:3, dash;
  lauma attack:3, dash;
  lauma attack:3, dash;
  lauma attack:3, dash;

  nahida skill, attack;     wait(10); # hiding swap cd warning

  lauma skill[hold=1];
  lauma attack:3, dash;
  if .nilou.burst.ready {
    nilou burst;
  } else {
    lauma attack:3, dash;
  }
}

# Nahida N1 E > Nilou E N2 E > Nahida Q > Xingqiu ED Q > Lauma N1 hE Q 5[N3D] > Nahida E N1 > Lauma hE N3D > ( Nilou Q / Lauma N3D ) >
