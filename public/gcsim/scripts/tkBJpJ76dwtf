#esco ororon shenhe

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*7 er=0.0551*2 em=19.82*2 cr=0.0331*9 cd=0.0662*10;

chasca char lvl=90/90 cons=0 talent=9,9,9;
chasca add weapon="scion" refine=1 lvl=90/90;
chasca add set="vv" count=4;
chasca add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622;
chasca add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

ororon char lvl=90/90 cons=6 talent=9,9,9;
ororon add weapon="favbow" refine=4 lvl=90/90;
ororon add set="scroll" count=4;
ororon add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311;
ororon add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="wavebreaker" refine=1 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466;
shenhe add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*5 em=19.82*2 cr=0.0331*10 cd=0.0662*7;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active escoffier;
for let i = 0; i < 4; i = i + 1 {
  escoffier skill;

  shenhe skill[hold=1];
  if is_even(i) {
    shenhe burst;
  }

  ororon attack, skill, burst;

  chasca skill;
  if .chasca.burst.ready {
    chasca burst, aim:4;
  } else{
    chasca aim:4, aim[bullets=4];
  }
}
wait(84);
