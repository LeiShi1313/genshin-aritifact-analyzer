# swappable with sodp, vv

																
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=9000000;
energy every interval=480,720 amount=1;
options swap_delay=12 iteration=1000;

#-------------------------------------------- 

#action list: furina EQ > xianyun E lP Q > faruzan Q > heizou N1C Q E 8JhP N1C E

active furina;

for let r=0; r<5; r=r+1 {
  furina skill, dash, burst;
  xianyun skill, low_plunge, burst;
  faruzan burst;
  heizou attack, charge, burst, skill;
  for let p=0; p<8; p=p+1 {
    if .heizou.status.xianyun-airborne-buff {
      heizou jump;
    }
    if .airborne {
      heizou high_plunge[collision=1], dash;
    }
  }
  heizou attack, charge, skill;
}