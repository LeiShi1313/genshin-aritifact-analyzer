# - Characters

lyney char lvl=90/90 cons=0 talent=9,9,9;
lyney add weapon="crescent" refine=5 lvl=90/90;
lyney add set="mh" count=4;
lyney add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cd=0.622; #main
lyney add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

bennett char lvl=90/90 cons=6 talent=9,9,9; 
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2755 em=39.64 cr=0.2979 cd=0.7944;

venti char lvl=90/90 cons=0 talent=9,9,9;
venti add weapon="favbow" refine=4 lvl=90/90;
venti add set="vv" count=4;
venti add stats hp=4780 atk=311 em=187 em=187 cr=0.311;#main
venti add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=158.56 cr=0.331 cd=0.5296;

kazuha char lvl=90/90 cons=0 talent=9,9,9;
kazuha add weapon="favsword" refine=3 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 em=187; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=118.92 cr=0.3972 cd=0.1324;

# - Options

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;
let weak = 1; # Set to 0 if using weapon other than crescent or if you just don't hit weakspots

# - Targets

target lvl=100 resist=0.1 radius=1.5 pos=0,2.5 hp=9999999;
target lvl=100 resist=0.1 radius=1.5 pos=2.5,0.5 hp=9999999;

# - Actions

active lyney;

for let i=0; i<5; i=i+1 { 
  lyney aim[weakspot=weak];
  kazuha skill, high_plunge, burst;
  while !.kazuha.mods.favonius-cd {
    kazuha attack;
  }
  bennett burst, skill;
  venti skill, burst;
  while !.venti.mods.favonius-cd {
    venti attack;
  }
  lyney aim[weakspot=weak], aim, burst;
  delay(11); #wait for lyney burst initial hit
  lyney skill, skill;
}
# Lyney with double anemo in 2T: Lyney, Bennett, Venti, Kazuha. Lyney 3CA Rotation with Venti burst snapshotting Bennett buff.
# Lyney C, Kazuha E hP Q (NA until fav proc), Bennett Q E, Venti E Q (NA until fav proc), Lyney 2C Q E E
