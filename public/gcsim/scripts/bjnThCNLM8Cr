zhongli char lvl=90/90 cons=6 talent=10,10,10 +params=[start_hp=1];
zhongli add weapon="favoniuslance" refine=5 lvl=90/90;
zhongli add set="ap" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311 ; #main
zhongli add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;



options swap_delay=12 iteration=100;



active furina;
target lvl=100 resist=0.1 radius=2 pos=0,2.5 hp=999999999;
energy every interval=480,720 amount=1;

for let i=0; i<4; i=i+1 {

  furina skill, burst, attack;
  yelan burst, attack;
  if .kazuha.burst.ready {
    kazuha burst;
  } else {
    kazuha skill,high_plunge;
  }
  kazuha attack;
  furina attack, charge, attack, attack, charge;
  zhongli skill[hold=1], dash;
  kazuha skill, high_plunge;
  yelan attack, skill, attack, skill, attack:2, dash;
  yelan attack:4, dash, attack:4, dash;
}
