# Clorinde Durin Fischl Yae. ~16s Rot. Clorinde Triple Electro Overload. Clorinde bursts every rotation. Yae bursts whenever available. Talent DMG slightly over Full EM Durin.

# Team
clorinde char lvl=90/90 cons=0 talent=9,9,9;
clorinde add weapon="finale" refine=5 lvl=90/90;
clorinde add set="fohw" count=4;
clorinde add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
clorinde add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

durin char lvl=90/90 cons=0 talent=9,9,9;
durin add weapon="lionsroar" refine=3 lvl=90/90;
#durin add weapon="xiphos" refine=1 lvl=90/90;
durin add set="cg" count=4;
durin add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; #main
durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*6 em=19.82*2 cr=0.0331*10 cd=0.0662*8; # LR
#durin add stats hp=4780 atk=311 em=187 em=187 em=187; #main
#durin add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*12 em=19.82*6 cr=0.0331*2 cd=0.0662*2; # Xiphos

fischl char lvl=90/90 cons=6 talent=9,9,9;
