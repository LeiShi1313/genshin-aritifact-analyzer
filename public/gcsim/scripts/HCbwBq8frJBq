# Diluc plunge. 2 Rots. Hyperoptimized delay timings to try and have Diluc Vape as much as possible. Close to 100% Vape in 1st rot. Vape% decreases more and more on subsequent rots. 100% Collisions.

diluc char lvl=90/90 cons=0 talent=9,9,9;
diluc add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
diluc add set="mh" count=4;
diluc add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
diluc add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=198.2 cr=0.0662 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favoniussword" refine=3 lvl=90/90;
furina add set="totm" count=4;
furina add stats hp=4780 atk=311 er=0.518 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="oathsworn" refine=5 lvl=90/90;
xianyun add set="viridescentvenerer" count=5;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.6612 em=39.64 cr=0.2648 cd=0.1324;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="favoniussword" refine=3 lvl=90/90;
bennett add set="instructor" count=4;
bennett add stats hp=3571 atk=232 er=0.518 cr=0.232 pyro%=0.348; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=.1 hp=10000000 radius=2 pos=0,3;
energy every interval=480,720 amount=1;

active diluc; # SS Stacks

for let r = 0; r < 2; r = r + 1 {

  furina skill, dash, burst;

  xianyun skill, low_plunge, burst;

  bennett burst, skill, attack;

  xianyun attack[travel=0]:2;

  diluc swap;
  for let h = 0; h < 8; h = h + 1 {
    if h == 1 && (r == 0 || r == 1) {
      delay(51);
    }
    if r == 1 {
      switch h {
      case 5:
        delay(85);
      case 6:
        delay(35);
      }
    }

    diluc dash, jump;
    if .airborne {
      diluc high_plunge[collision=1];
    }

  }
  diluc skill:2;

  bennett skill, dash;

}
