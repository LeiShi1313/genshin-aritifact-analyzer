# Cyno DMC Fischl Zhongli. ~25s Rot. TF Cyno Aggravate with an AP ZL shield to focus on the combo.

# Team
cyno char lvl=90/90 cons=0 talent=9,9,9;
cyno add weapon="deathmatch" refine=1 lvl=90/90;
cyno add set="tf" count=4;
cyno add stats hp=4780 atk=311 em=187 electro%=0.466 cd=0.622; #mainstats
cyno add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

travelerdendro char lvl=90/90 cons=6 talent=9,9,9;
travelerdendro add weapon="favsword" refine=3 lvl=90/90; # +params=[pickup_delay=200];
travelerdendro add set="no" count=4;
travelerdendro add stats hp=4780 atk=311 er=0.518 dendro%=0.466 cr=0.311; #main
travelerdendro add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.331 cd=0.3972;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; #mainstats
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

zhongli char lvl=90/90 cons=0 talent=9,9,9;
zhongli add weapon="favlance" refine=3 lvl=90/90;
zhongli add set="ap" count=4;
zhongli add stats hp=4780 atk=311 atk%=0.466 geo%=0.466 cr=0.311; #mainstats
zhongli add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

# Rotation
active fischl;

for let i=0; i<4; i=i+1 {
  fischl skill, attack;

  zhongli attack, skill[hold=1], dash;
  let startFrame = f();
  while !pick_up_crystallize("electro") && f() - startFrame < 45 {
    if !.zhongli.mods.favonius-cd {
      zhongli attack;
    } else {
      wait(1);
    }
  } # until the character pickup the shard, try to force fav proc or wait, up to 45frames

  travelerdendro attack, skill, burst;

  fischl attack:2, burst;

  cyno burst, attack:2, skill;
  while .fischl.skill.cd > 30 {
    if .cyno.normal == 5 {
      cyno skill;
    } else {
      cyno attack;
    }
  }
}
