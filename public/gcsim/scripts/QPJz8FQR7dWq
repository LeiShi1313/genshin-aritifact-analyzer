#action list 

for let i = 0; i < 3; i = i + 1 {
  nahida skill, burst;
  
  if.kuki.burst.ready {kuki burst;}
  
  yelan skill, burst, attack;
 
  while !.yelan.mods.favonius-cd {
  yelan attack;}
 
  alhaitham burst;
  
  kuki attack,skill;
  
  alhaitham attack:3, dash,
            attack:3, skill,
            attack:3, dash,
            attack:3, charge,
            attack:3, dash,
            attack:3, dash,
            attack:3;  
   
}
nahida skill;#let haitham's mirror hit    
