# Kazuha Furina Chongyun Xianyun. ~20s Rot. Whale Kazuha Freeze Shatterplunge. 50% collisions.

# Team - Options ordered by DPS
kazuha char lvl=90/90 cons=6 talent=9,9,9;
kazuha add weapon="pjc" refine=5 lvl=90/90;
kazuha add set="vv" count=4;
kazuha add stats hp=4780 atk=311 em=187 em=187 cd=0.622; #main
kazuha add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=6 talent=9,9,9;
furina add weapon="splendor" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.2979 cd=0.331;

chongyun char lvl=90/90 cons=6 talent=9,9,9;
chongyun add weapon="favgs" refine=5 lvl=90/90;
chongyun add set="no" count=4;
chongyun add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cr=0.311; #main
chongyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

xianyun char lvl=90/90 cons=6 talent=9,9,9;
xianyun add weapon="crane" refine=5 lvl=90/90;
xianyun add set="ohc" count=4;
#xianyun add set="sr" count=2; xianyun add set="glad" count=2;
xianyun add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;


# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000;

# Rotation
active furina;

for let x = 0; x < 4; x = x + 1 {
  furina skill, dash, burst;

  chongyun burst, skill;

  xianyun skill, low_plunge;
  if !.xianyun.burst.ready && .xianyun.skill.ready {
    xianyun skill, low_plunge, burst;
  }
  xianyun burst;

  # Double swirl
  kazuha attack, skill[hold=1], high_plunge[collision=rand()>0.5];
  # Plunge combo
  while .kazuha.status.xianyun-airborne-buff {
    if .kazuha.skill.ready {
      kazuha skill, high_plunge[collision=rand()>0.5];
    } else if .kazuha.burst.ready {
      kazuha burst;
    } else {
      kazuha jump;
      if .airborne {
        kazuha high_plunge[collision=rand()>0.5], dash;
      }
    }
  }
  # Extension
  while !.furina.skill.ready {
    if .kazuha.skill.ready {
      kazuha skill, high_plunge[collision=rand()>0.5];
    } else {
      kazuha attack;
    }
  }

  print("done");
}
