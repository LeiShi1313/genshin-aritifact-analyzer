let _execute_action = execute_action;
fn execute_action(char_id number, action_id number, p map) {
  if action_id == .action.dash {
  pick_up_crystallize("any"); # Pick up crystallize before every dash
  }

  return _execute_action(char_id, action_id, p);
}

options swap_delay=12 iteration=1000;

navia char lvl=90/90 cons=0 talent=9,9,9;
navia add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
navia add set="nighttime" count=4;
navia add stats hp=4780 atk=311 atk%=.466 geo%=0.466 cr=0.311 ; #main
navia add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="favlance" refine=3 lvl=90/90;
xiangling add set="tom" count=4;
xiangling add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311 ; #main
xiangling add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944 ;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

chiori char lvl=90/90 cons=0 talent=9,9,9;
chiori add weapon="harbinger" refine=5 lvl=90/90;
chiori add set="gt" count=4;
chiori add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cd=0.62 ; # main
chiori add stats def=39.36 def%=0.248 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active bennett;
for let x=0; x<4; x=x+1 {
  bennett skill, burst;
  if.navia.burst.ready{
    navia burst;
  }
  if.xiangling.burst.ready{
    xiangling burst, skill, dash;
  } else {
    xiangling attack, skill, dash, attack;
  }
  while !.xl.mods.favonius-cd {
    xl attack;
  }
  if!.chiori.skill.ready&&.chiori.burst.ready{
    chiori burst;
  } else {
    chiori attack;
  }
  chiori skill:2;
  if.navia.burst.ready{
    navia burst;
  }
  navia skill[hold=1], attack:3, dash, attack:2;
  if.navia.burst.ready{
    navia burst;
  }
  navia skill[hold=1], attack:3, dash, attack:2;
  if.navia.skill.ready {
    navia skill[hold=1], attack:3, dash, attack:2;# can extend fieldtime first rotation
  }

}

