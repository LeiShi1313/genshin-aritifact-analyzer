options swap_delay=12 iteration=1000;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="widsith" refine=5 lvl=90/90;
columbina add set="notsu" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*2 cr=0.0331*8 cd=0.0662*10;


ineffa char lvl=90/90 cons=0 talent=9,9,9;
ineffa add weapon="ballad" refine=1 lvl=90/90;
ineffa add set="aubade" count=4;
ineffa add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cd=0.622; #main
ineffa add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

lauma char lvl=90/90 cons=0 talent=9,9,9;
lauma add weapon="etherlight" refine=5 lvl=90/90;
lauma add set="sms" count=4;
// lauma add set="sms" count=4;
lauma add stats hp=4780 atk=311 em=187 em=187 em=187; #main
lauma add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*12 em=19.82*6 cr=0.0331*8 cd=0.0662*2;

aino char lvl=90/90 cons=6 talent=9,9,9;
aino add weapon="favoniusgreatsword" refine=5 lvl=90/90;
aino add set="deepwood" count=4;
aino add stats hp=4780 atk=311 em=187 em=187 cr=0.311;
aino add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*3 em=19.82*3 cr=0.0331*10 cd=0.0662*12;

active lauma;
# ----  Actions List
target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999;
energy every interval=480,720 amount=1;

lauma attack;
for let i=0; i<6; i=i+1 {
  if i == 0 {
    columbina attack, skill, burst;
  } else {
    columbina skill, charge;
    if .columbina.burst.ready {
      columbina burst;
    }
  }


  if .ineffa.burst.ready {
    ineffa burst;
  }
  ineffa skill;
  aino burst, skill;

  lauma skill[hold=.dew>0], burst;
  columbina attack, charge, dash, charge, dash,
            attack, charge, dash, charge, dash,
            charge, dash, attack, charge;
}
columbina dash, attack; // give time for the last CA's damage to land
