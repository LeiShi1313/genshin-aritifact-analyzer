dehya char lvl=90/90 cons=6 talent=9,9,9;
dehya add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=1]; # 1 pre-stack
dehya add set="vg" count=4;
dehya add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
dehya add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*7 em=19.82*2 cr=0.0331*12 cd=0.0662*7;

fischl char lvl=90/90 cons=6 talent=9,9,9;
fischl add weapon="vhunt" refine=1 lvl=90/90;
fischl add set="sms" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cd=0.622; #main
fischl add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

mona char lvl=90/90 cons=4 talent=9,9,9;
mona add weapon="favcodex" refine=5 lvl=90/90;
mona add set="cg" count=4;
mona add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 cr=0.311; #main
mona add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*10 cd=0.0662*12;

columbina char lvl=90/90 cons=0 talent=9,9,9;
columbina add weapon="sacjade" refine=1 lvl=90/90;
columbina add set="totm" count=4;
columbina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
columbina add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*8 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*6 cr=0.0331*4 cd=0.0662*10;

options iteration=1000 swap_delay=12;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
hurt every interval=180,300 amount=3500,5500 element=physical; # damage taken assumed every 3-5s

active dehya;

for let i=0; i<6; i=i+1 {
  dehya skill;
  bina skill;
  if .bina.burst.ready {
    bina burst;
  } else {
    bina attack;
  }
  mona burst, attack;
  if .fischl.skill.ready {
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }
  mona attack, skill, attack;
  dehya attack, burst, attack:15;
  mona attack:3;
}

# 20s rotation
# Dehya E > Columbina E Q/N1 > Mona Q N1 > Fischl E N1 / N2 Q > Mona N1 E N1 > Dehya N1 Q N15 > Mona N3
