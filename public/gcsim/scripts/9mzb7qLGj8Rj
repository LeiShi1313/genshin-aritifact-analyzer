# Arlechinno Yelan Fischl Xilonen. ~18s Rot. Arlecchino Overvape with N5D. Scroll can land one of the three if Xilonen before Yelan.

# Team
arle char lvl=90/90 cons=0 talent=9,9,9;
arle add weapon="fjords" refine=1 lvl=90/90;
arle add set="fohw" count=4;
arle add stats hp=4780 atk=311 atk%=0.466 pyro%=0.466 cr=0.311; 
arle add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.1102 em=39.64 cr=0.2979 cd=0.7944;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.4660 cr=0.311;
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=39.64 cr=0.331 cd=0.662;

fischl char lvl=90/90 cons=6 talent=9,9,9; 
fischl add weapon="chainbreaker" refine=5 lvl=90/90;
#fischl add weapon="stringless" refine=3 lvl=90/90;
fischl add set="gt" count=4;
#fischl add set="tom" count=4;
fischl add stats hp=4780 atk=311 atk%=0.466 electro%=0.466 cr=0.311; 
fischl add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944;

xilonen char lvl=90/90 cons=0 talent=9,9,9; 
xilonen add weapon="favsword" refine=3 lvl=90/90;
xilonen add set="scroll" count=4;
xilonen add stats hp=4780 atk=311 def%=0.583 geo%=0.466 cr=0.311; #main
xilonen add stats def%=0.372 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.662;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active arle;

for let i = 0; i < 4; i = i + 1 {
  arle skill;
  
  xilonen skill, attack:2;
  
  yelan skill;
  if !.yelan.burst.ready && .yelan.breakthrough {
    yelan aim;
  } else if !.yelan.burst.ready {
    yelan attack;
  }
  yelan burst, attack;
  
  if .fischl.skill.ready {
    fischl skill, attack;
  } else {
    fischl attack:2, burst;
  }
  
  arle attack, charge, 
       attack:5, dash, 
       attack:5, dash,
       attack:5, dash,
       attack:2, charge;
}

