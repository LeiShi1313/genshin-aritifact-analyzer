#main
razor add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=79.28 cr=0.331 cd=0.662 ;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="festeringdesire" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

kukishinobu char lvl=90/90 cons=6 talent=9,9,9;
kukishinobu add weapon="xiphos" refine=1 lvl=90/90;
kukishinobu add set="fopl" count=4;
kukishinobu add stats hp=4780 atk=311 em=187 em=187 em=187 ;
#main
kukishinobu add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=118.92 cr=0.3972 cd=0.5296 ;

nahida char lvl=90/90 cons=0 talent=9,9,9;
nahida add weapon="thewidsith" refine=3 lvl=90/90;
nahida add set="deepwood" count=4;
nahida add stats hp=4780 atk=311 em=187 dendro%=0.466 cr=0.311 ;
#main
nahida add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.331 cd=0.7944 ;

options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;


active nahida;
for let i=0; i<4; i=i + 1 {
nahida burst, skill;
if i {nahida attack, charge;}

furina skill, dash, burst;

kuki skill, attack;

razor burst;
while .razor.mods.razor-q > 43 {
    if .razor.normal > 3 {
      if .razor.skill.ready {
        razor skill, dash;
      } else {
        razor dash;
      }
    } else {
      razor attack;
    }
  }

kuki skill, dash, attack, burst;

nahida attack, skill,
       attack, charge,
       attack:3, charge, dash,
       attack:3, charge,
       attack;
}
