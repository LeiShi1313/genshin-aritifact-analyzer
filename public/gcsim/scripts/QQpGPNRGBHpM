# Freminet Xinyan Rosaria Bennett. ~21s Rot. Xinyan and Rosaria provide RES shred for Physical Freminet. Xinyan shield pulses enable Rosaria to melt nearly everything. C6 Bennett is ~2k DPS loss.

# Team
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
#freminet add weapon="tidalshadow" refine=5 lvl=90/90;
freminet add set="pf" count=4;
#freminet add set="lw" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

xinyan char lvl=90/90 cons=6 talent=9,9,9;
xinyan add weapon="favgs" refine=3 lvl=90/90;
xinyan add set="emblem" count=4;
#xinyan add set="tom" count=4;
#xinyan add set="scroll" count=4;
xinyan add stats hp=4780 atk=311 atk%=0.466 phys%=0.583 cd=0.622 ; #main
xinyan add stats def=39.36 def%=0.124 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.496 er=0.2755 em=39.64 cr=0.0993 cd=0.662 ; # DMG
#xinyan add stats hp=4780 atk=311 def%=0.583 def%=0.583 def=0.583;
#xinyan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4408 em=39.64 cr=0.3972 cd=0.3972; # Shields

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="catch" refine=5 lvl=90/90;
rosaria add set="emblem" count=4;
rosaria add stats hp=4780 atk=311 em=187 cryo%=0.466 cd=0.622;
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662; # Catch

bennett char lvl=90/90 cons=5 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90 +params=[pickup_delay=120]; # to Rosaria
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.1986 cd=0.662;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

#Rotation
active freminet; # SS Stacks

for let x = 0; x < 4; x = x + 1 {
  bennett skill, burst;

  rosaria skill, burst;

  xinyan skill, burst;

  freminet skill, burst,
         attack:2, skill, skill,
         attack:2, skill, attack, skill,  #First skill for 4 stack Pers, 2nd skill starts Pers Time
         attack:2, skill, attack, skill,
         attack:2, skill;
}
