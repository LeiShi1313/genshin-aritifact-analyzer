wrio char lvl=90/90 cons=0 talent=9,9,9;
wrio add weapon="widsith" refine=3 lvl=90/90;
wrio add set="mh" count=4;
wrio add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
wrio add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.1102 em=79.28 cr=0.3972 cd=0.662;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favlance" refine=3 lvl=90/90;
rosaria add set="no" count=4;
rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=79.28 cr=0.331 cd=0.662;

xiangling char lvl=90/90 cons=6 talent=9,9,9;
xiangling add weapon="catch" refine=5 lvl=90/90;
xiangling add set="eosf" count=4;
xiangling add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cd=0.622; #main
xiangling add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=39.64 cr=0.3641 cd=0.331;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="sapwood" refine=1 lvl=90/90;
bennett add set="scroll" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.551 em=79.28 cr=0.0662 cd=0.7944;

options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=50000000;
energy every interval=480,720 amount=1;

active bennett;
for let i=0; i<4; i=i+1 {
  bennett skill;
  xiangling swap; wait(55);
  rosaria skill, burst;
  bennett burst, skill;
  xiangling burst, skill;
  wrio skill,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3, charge, jump,
       attack:3;
  if .wrio.burst.ready  {
    wrio burst;
  } else {
    wrio charge;
  }
}
