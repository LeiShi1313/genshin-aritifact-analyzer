# Nilou Kinich Baizhu Xingqiu. 23s~ rotation. Kinich onfield against 2 targets. Accounts for E movement typically forcing Kinich out of the range of Xingqiu's melee rainswords. Perfect rainsword uptime on both opponents results in + 12K Team DPS.

nilou char lvl=90/90 cons=0 talent=9,9,9;
nilou add weapon="dockhand" refine=1 lvl=90/90;
nilou add set="tom" count=2;
nilou add set="vg" count=2;
nilou add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 hp%=0.466; #main
nilou add stats def%=0.062*2 def=19.68*2 hp=253.94*10 hp%=0.0496*6 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*10 cr=0.0331*2 cd=0.0662*2;

kinich char lvl=90/90 cons=0 talent=9,9,9;
kinich add weapon="tidalshadow" refine=5 lvl=90/90;
kinich add set="oc" count=4;
kinich add stats hp=4780 atk=311 atk%=0.466 dendro%=0.466 cd=0.622; #main
kinich add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*4 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*10;

baizhu char lvl=90/90 cons=0 talent=9,9,9;
baizhu add weapon="favcodex" refine=3 lvl=90/90;
baizhu add set="deepwood" count=4;
baizhu add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 er=0.518 ;#main
baizhu add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*12 cr=0.0331*12 cd=0.0662*2;

xingqiu char lvl=90/90 cons=6 talent=9,9,9;
xingqiu add weapon="xiphos" refine=1 lvl=90/90;
xingqiu add set="fopl" count=4;
xingqiu add stats hp=4780 atk=311 em=187 em=187 em=187; #main
xingqiu add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*12 er=0.0551*7 em=19.82*6 cr=0.0331*2 cd=0.0662*3;

# ----  Options
options swap_delay=12 iteration=1000;

# ----  Default Enemy Both in Melee Range of XQ rainswords
target lvl=100 resist=0.1 radius=1 pos=0,1.5 hp=999999999; # Front
target lvl=100 resist=0.1 radius=1 pos=1.5,0 hp=999999999; # Right

energy every interval=480,720 amount=1;

fn kinich_combo() {
  kinich skill;
  while .kinich.nightsoul.state {
    if .kinich.blind_spot {
      kinich attack[direction=.kinich.blind_spot];
    } else {
      kinich attack;
    }
    while .kinich.nightsoul.state && .kinich.nightsoul.points < 20 && .kinich.nightsoul.points > 18 {
      wait(1);
    }
    if .kinich.nightsoul.state && .kinich.nightsoul.points == 20 {
      kinich skill[hold=1];
    }
    set_player_pos(0, -3); # move away from target 1
  }
}

# ----  Actions List
active nilou;

for let i=0; i<4; i=i+1 {
  nilou skill, attack:2, skill;

  xingqiu skill, dash, burst, attack;

  baizhu burst, skill, attack:2;

  kinich_combo();

  baizhu skill, attack:2, charge, dash;
  set_player_pos(0, 0); # move toward target 1
  baizhu attack:2, charge;
}
