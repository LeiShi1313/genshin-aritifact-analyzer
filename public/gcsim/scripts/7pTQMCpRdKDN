prune char lvl=90/90 cons=6 talent=9,9,9;
prune add weapon="oathsworneye" refine=5 lvl=90/90;
prune add set="noblesse" count=4;
prune add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
prune add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*6 er=0.0551*2 em=19.82*2 cr=0.0331*12 cd=0.0662*8;

options swap_delay=12 iteration=100;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

active faruzan;
for let i=0; i<4; i=i+1 {

  faruzan burst;
  if !.faruzan.mods.favonius-cd && !.xiao.burst.ready {
    faruzan attack;
  }

  durin skill, burst, skill;

  prune burst, skill;

  xiao skill:2;
  if .xiao.skill.ready && !.xiao.burst.ready {
    xiao skill;
  }
  xiao burst;
  for let h = 12; h > 0; h = h - 1 {
    xiao jump, high_plunge[collision=1];
  }
}
