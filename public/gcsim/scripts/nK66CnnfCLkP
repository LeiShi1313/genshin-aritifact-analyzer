bennett add weapon="thealleyflash" refine=1 lvl=90/90;
bennett add set="noblesse" count=5;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311 ; #main
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.4959 em=39.64 cr=0.2317 cd=0.662;

options swap_delay=12 iteration=1000;
energy every interval=480,720 amount=1;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;

active navia; ## SS Stacks
for let i=0; i<4; i=i+1 {
  xilonen burst;
  furina skill, dash, attack, burst;
  xilonen skill, attack:2;
  if .navia.energy != .navia.energymax {  # if the energy is not full yet, N1 to wait Xilonen particles
    navia attack;
  }
  navia burst;
  bennett skill, burst;
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  navia skill[hold=1], attack:2, dash, attack:2, dash, attack:2;
  if i == 0 || i == 3 {
    navia skill[hold=1], attack:2;
  }
}

