# Dehya Bennett Citlali Xianyun. 21s Rot. Dehya Melt Plunge with VV. 6 Melted Plunges. Citlali uses her N1 to re-establish Cryo in case Dehya's Skill was still active. Deyha uses her Skill at the start of the rotation, as it's worthwhile for Energy and is timed to not steal Melts. 50% Collisions.

# Team
dehya char lvl=90/90 cons=0 talent=9,9,9;
dehya add weapon="serpentspine" refine=1 lvl=90/90 +params=[stacks=5];
dehya add set="lno" count=4;
dehya add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
dehya add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*2 em=19.82*4 cr=0.0331*12 cd=0.0662*10;

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311; #main
bennett add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*8 em=19.82*2 cr=0.0331*7 cd=0.0662*11;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 em=187 em=187; #main
citlali add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*2 er=0.0551*10 em=19.82*2 cr=0.0331*11 cd=0.0662*5;

xianyun char lvl=90/90 cons=0 talent=9,9,9;
xianyun add weapon="favcodex" refine=3 lvl=90/90;
xianyun add set="vv" count=4;
xianyun add stats hp=4780 atk=311 er=0.518 atk%=0.466 atk%=0.466; #main
xianyun add stats def%=0.062*2 def=19.68*2 hp=253.94*2 hp%=0.0496*2 atk=16.54*2 atk%=0.0496*8 er=0.0551*6 em=19.82*2 cr=0.0331*12 cd=0.0662*2;

# Options
options swap_delay=12 iteration=1000;
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
energy every interval=480,720 amount=1;

# Dehya Plunge Combo
fn DehyaPlunge() {
  dehya jump;
  if .airborne {
    dehya high_plunge[collision=rand()>0.5];
  }
}

# Rotation
active dehya; # SS stacks

dehya skill;
for let i=0; i<4; i=i+1 {
  xianyun attack, skill, low_plunge, attack, burst;

  bennett skill, burst, attack;

  xianyun attack:3;

  citlali skill, burst, attack;

  DehyaPlunge();
  DehyaPlunge();
  DehyaPlunge();
  DehyaPlunge(); dehya dash; wait(43);
  DehyaPlunge(); dehya dash;
  DehyaPlunge(); dehya dash;
  dehya skill;

  bennett skill;
}

# 21s rotation (6 Plunges)
# (Dehya E) > Xianyun N1 EP N1 Q > Bennett EQ N1 > Xianyun N3 > Citlali EQ N1 > Dehya 3[JP] JPD (wait) 2[JPD] E > Bennett E
