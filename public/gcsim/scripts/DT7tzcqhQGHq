kirara char lvl=90/90 cons=6 talent=9,9,9;
kirara add weapon="sapwood" refine=5 lvl=90/90+params=[pickup_delay=80];
kirara add set="instructor" count=4;
kirara add stats hp=3571 atk=232 atk%=0.3495 dendro%=0.466 cr=0.23325 ; #main
kirara add stats def=33.0624 def%=0.10416 hp=426.6192 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.092568 em=33.2976 cr=0.222432 cd=0.444864;

options iteration=1000 swap_delay=12;

target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;
energy every interval=480,720 amount=1;

fn clorinde_combo() {
  clorinde skill;
  while .clorinde.status.clorinde-night-watch {
    if .clorinde.bolratio >= 1 {
      clorinde skill;
    } else {
      clorinde attack;
    }
  }
}

active fischl; 

for let r=0; r<4; r=r+1 { # 4 rotations 
  if r>0 {
    kazuha skill, high_plunge; # swirl to refresh VV and kazuha A4 for fischl/oz snapshot  
    fischl attack;
  }
  fischl burst;
  kirara skill;
  kazuha burst; # kazuha burst for first clorinde combo ensures fischl/oz snapshot of his A4 for second clorinde combo
  clorinde_combo();
  kirara skill;
  fischl attack, skill;
  kazuha skill, high_plunge;
  clorinde_combo();
}