# Yoimiya Furina Yelan Mika. ~21s Rot. Yoimiya with a few extra attacks with Mika's attack speed buff. SoDP > OHC Mika.

# Team- Options listsed by DPS
yoimiya char lvl=90/90 cons=0 talent=9,9,9;
yoimiya add weapon="rust" refine=3 lvl=90/90;
yoimiya add set="mh" count=4;
yoimiya add stats hp=4780 atk=311 atk%=0.466 em=187 cd=0.622; #main 5* set
yoimiya add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cr=0.311; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.331 cd=0.7944;

mika char lvl=90/90 cons=6 talent=9,9,9; 
mika add weapon="favspear" refine=3 lvl=90/90;
mika add set="sodp" count=4;
#mika add set="clam" count=4;
mika add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cr=0.311 ; #main
mika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.6612 em=39.64 cr=0.331 cd=0.2648;


# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=3.4,0 hp=100000000; 

# Rotation
active furina;

for let x=0; x<4; x=x+1 {
  furina skill, dash, burst;
  
  yelan burst, attack;
  
  mika burst, attack, skill;
  
  yelan attack, skill;
  
  #yoimiya skill, attack:5, dash, attack:5, dash, attack:5, dash, attack:4;
  yoimiya skill, attack:5, attack:5, attack:5, attack:3; # No dash
  
  yelan attack, skill, attack:2;
  
  if .yoimiya.burst.ready {
    yoimiya burst;
  } else {
    if .yelan.breakthrough {
      yelan aim[hold=1];
      
      furina attack, dash; # filling time for cds.
    } else {
      yelan attack;
    }
  }
  
  print("done");
}
