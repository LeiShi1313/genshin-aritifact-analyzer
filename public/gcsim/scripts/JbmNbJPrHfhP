options swap_delay=12 iteration=1000;

# Build assumptions
ganyu char lvl=90/90 cons=0 talent=9,9,9;
ganyu add weapon="songofstillness" refine=5 lvl=90/90;
ganyu add set="mh" count=5;
ganyu add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622 ; #main
ganyu add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1488 er=0.1653 em=39.64 cr=0.3972 cd=0.662;

shenhe char lvl=90/90 cons=0 talent=9,9,9;
shenhe add weapon="favoniuslance" refine=3 lvl=90/90;
shenhe add set="no" count=4;
shenhe add stats hp=4780 atk=311 atk%=0.466 atk%=0.466 atk%=0.466; #main
shenhe add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.2976 er=0.1102 em=39.64 cr=0.3972 cd=0.5296;

furina char lvl=90/90 cons=0 talent=9,9,9;
furina add weapon="favsword" refine=3 lvl=90/90;
furina add set="totm" count=5;
furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622 ; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.248 atk=33.08 atk%=0.0992 er=0.1653 em=39.64 cr=0.3972 cd=0.5296;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622;
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.2204 em=39.64 cr=0.2317 cd=0.662;

# Target and Energy assumptions
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999; # standard ST target
energy every interval=480,720 amount=1; # standard Energy drops

# Rotation assumptions
active ganyu;

for let x=0; x<4;x=x+1 {
  ganyu skill;
  furina skill, dash, attack, burst;
  escoffier skill, burst;
  shenhe skill, burst;
  ganyu aim, skill, burst, aim:2;
  shenhe skill, attack:3;
  ganyu aim;
}
wait(27); # for the last CA hit

# Ganyu E > Furina ED N1 Q > Escoffier EQ > Shenhe tEQ > Ganyu C EQ 2[C] > Shenhe tE N3 > Ganyu C
