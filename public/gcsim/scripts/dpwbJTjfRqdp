# Freminet Furian Yelan Escoffier. ~23s Rot. Cryo Shatter Freminet with Escoffier. 2E Yelan. Freminet does a lvl 1 Shattering Pressure before Yelan uses burst and does an abbreviated burst between Yelan skills. Yelan's burst lasts into Furina's skill in the next rotation.

# Team - Options ordered by DPS
freminet char lvl=90/90 cons=6 talent=9,9,9;
freminet add weapon="uomms" refine=5 lvl=90/90;
#freminet add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
freminet add set="mh" count=4;
#freminet add set="gt" count=4;
freminet add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.3472 er=0.1102 em=39.64 cr=0.2979 cd=0.662; # UOMMS
#freminet add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
#freminet add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.4464 er=0.3857 em=39.64 cr=0.0662 cd=0.662; # SS

furina char lvl=90/90 cons=0 talent=9,9,9; 
furina add weapon="festering" refine=5 lvl=90/90;
furina add set="gt" count=4;
#furina add set="tom" count=4;
furina add stats hp=4780 atk=311 hp%=0.466 hp%=0.466 cd=0.622; #main
furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # GT
#furina add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
#furina add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662; # ToM

yelan char lvl=90/90 cons=0 talent=9,9,9;
yelan add weapon="favbow" refine=4 lvl=90/90;
yelan add set="emblem" count=4;
yelan add stats hp=4780 atk=311 hp%=0.466 hydro%=0.466 cd=0.622; #main
yelan add stats def%=0.124 def=39.36 hp=507.88 hp%=0.1984 atk=33.08 atk%=0.0992 er=0.1102 em=39.64 cr=0.3972 cd=0.662;

escoffier char lvl=90/90 cons=0 talent=9,9,9;
escoffier add weapon="deathmatch" refine=1 lvl=90/90;
escoffier add set="gt" count=4;
escoffier add stats hp=4780 atk=311 atk%=0.466 cryo%=0.466 cd=0.622; #main
escoffier add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.248 er=0.551 em=39.64 cr=0.1324 cd=0.5958;

# Options
options iteration=1000; 
options swap_delay=12;
energy every interval=480,720 amount=1;

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;
#target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000 freeze_resist=1;

# Rotation
active furina;
#active freminet; # with SS

for let i=0; i<4; i=i+1 {
  furina skill, dash;
  if .yelan.mods.yelanburst {
    furina attack;
  }
  furina burst;
  
  esco skill, burst;
  
  if i > 0 {
    while .freminet.skill.ready || .freminet.mods.freminet-pers-time {
      freminet skill;
    }
  }
  
  yelan burst, attack, skill, attack;

  while .yelan.skill.cd {
    if .freminet.skill.ready {
      freminet skill;
    } else if .freminet.burst.ready {
      freminet burst;
    } else {
      freminet attack;
    }
  }
  while .freminet.mods.freminet-pers-time {
    freminet skill;
  }
  
  yelan attack, skill, attack; 
}
