# Mavuika Citlali Rosaria Bennett. ~18s Rot. Mavuika double Cryo Melt. Mavuika Q 6[C2D]. Rosaria goes after Citlali, no TTDS to Mavuika. Emblem + Scroll Bennett + NO Rosaria leads to fewer worst case energy misses, but slightly lower overall DPS.

# Team - Options listed by DPS
mavuika char lvl=90/90 cons=0 talent=9,9,9;
mavuika add weapon="serpent" refine=1 lvl=90/90 +params=[stacks=5];
mavuika add set="oc" count=4;
mavuika add stats hp=4780 atk=311 em=187 pyro%=0.466 cd=0.622; #main
mavuika add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.5952 er=0.1102 em=79.28 cr=0.0662 cd=0.662;

citlali char lvl=90/90 cons=0 talent=9,9,9;
citlali add weapon="evenstar" refine=1 lvl=90/90;
#citlali add weapon="ttds" refine=5 lvl=90/90;
citlali add set="scroll" count=4;
citlali add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
citlali add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.3306 em=237.84 cr=0.0993 cd=0.4634;

rosaria char lvl=90/90 cons=6 talent=9,9,9;
rosaria add weapon="favspear" refine=3 lvl=90/90;
rosaria add set="ins" count=4;
#rosaria add set="no" count=4;
rosaria add stats hp=3571 atk=232 er=0.3885 cryo%=0.3495 cr=0.311;
rosaria add stats def%=0.10416 def=33.0624 hp=426.619 hp%=0.083328 atk=27.7872 atk%=0.083328 er=0.277704 em=33.2976 cr=0.27804 cd=0.111216; # Ins
#rosaria add stats hp=4780 atk=311 er=0.518 cryo%=0.466 cr=0.311; #main
#rosaria add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.1984 er=0.1102 em=39.64 cr=0.331 cd=0.7944; # Emblem, NO is similar.

bennett char lvl=90/90 cons=6 talent=9,9,9;
bennett add weapon="alleyflash" refine=1 lvl=90/90;
bennett add set="no" count=4;
#bennett add set="emblem" count=2;bennett add set="scroll" count=2; # Also reasonable for worst cases
bennett add stats hp=4780 atk=311 er=0.518 pyro%=0.466 cr=0.311;
bennett add stats def%=0.124 def=39.36 hp=507.88 hp%=0.0992 atk=33.08 atk%=0.0992 er=0.2204 em=39.64 cr=0.331 cd=0.7944;

# Options
options iteration=1000;
options swap_delay=12;
energy every interval=480,720 amount=1; # Standard

# Targets
target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=100000000;

# Rotation
active mavuika; # SS Stacks

for let i=0; i<4; i=i+1 {
  mavuika skill;

  bennett skill, burst;

  citlali skill, burst;

  rosaria skill, attack, burst;

  mavuika burst;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
  mavuika charge:2, dash;
}
