# Rotation
active neuvillette;
for let i=0; i<4; i=i+1 {
  neuv skill;
  lynette skill, burst;
  fischl attack:2, burst;
  xiangling burst, attack, skill, dash, attack;
  neuvillette attack, charge, burst, skill, charge;
  lynette skill, attack;
  fischl attack, skill;
  xiangling skill, dash, attack;
  neuvillette charge, charge;
}
wait(173);
